  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com data:; img-src 'self' data: blob: https://zwnmulmnvopclzcvytce.supabase.co; connect-src 'self' https://zwnmulmnvopclzcvytce.supabase.co wss://zwnmulmnvopclzcvytce.supabase.co https://www.googleapis.com; frame-src 'self' https://www.loom.com https://www.youtube-nocookie.com https://player.vimeo.com https://docs.google.com https://drive.google.com https://zwnmulmnvopclzcvytce.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
