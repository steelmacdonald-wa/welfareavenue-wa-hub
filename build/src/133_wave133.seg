    + '.w133i{width:17px;height:17px;flex:none;display:inline-block;vertical-align:middle;}'
    + '#orgchart .card.w133old{display:none !important;}'
    + '#w133{display:flex;flex-direction:column;gap:14px;max-width:1240px;width:100%;box-sizing:border-box;min-width:0;}'
    /* the bar */
    + '#w133 .w133bar{display:flex;gap:10px;align-items:center;flex-wrap:wrap;}'
    + '#w133 .w133stats{font-size:13px;color:var(--wa-muted,#5c6b66);flex:1 1 260px;min-width:0;}'
    + '#w133 .w133stats b{color:' + GREEN + ';}'
    + '#w133 .w133q{position:relative;flex:0 1 240px;min-width:170px;}'
    + '#w133 .w133q .w133i{position:absolute;left:11px;top:50%;transform:translateY(-50%);color:var(--wa-muted,#5c6b66);width:16px;height:16px;pointer-events:none;}'
    + '#w133 .w133q input{width:100%;box-sizing:border-box;padding:9px 12px 9px 34px !important;border:1px solid rgba(16,63,57,.16);border-radius:12px;font-family:' + BODY + ';font-size:13.5px;background:var(--wa-card,#fff);}'
    + '#w133 .w133tog{display:inline-flex;align-items:center;gap:7px;font-size:13px;font-weight:600;cursor:pointer;user-select:none;}'
    + '#w133 .w133tog input{width:17px;height:17px;accent-color:' + GREEN + ';margin:0;}'
    + '#w133 .w133btn,#w133sheet .w133btn{display:inline-flex;align-items:center;gap:7px;border:none;border-radius:11px;padding:9px 13px;font-family:' + BODY + ';font-size:13px;font-weight:700;cursor:pointer;background:rgba(16,63,57,.08);color:' + GREEN + ';white-space:nowrap;}'
    + '#w133 .w133btn:hover,#w133sheet .w133btn:hover{background:rgba(16,63,57,.14);}'
    + '#w133 .w133btn.pri,#w133sheet .w133btn.pri{background:' + GREEN + ';color:' + CREAM + ';}'
