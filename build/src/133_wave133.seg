    + '#w133 .w133exec .w133row{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:10px;}'
    + '#w133 .w133exec .w133c{padding:12px 14px;background:rgba(16,63,57,.04);}'
    + '#w133 .w133exec .w133c b{font-size:15.5px;}'
    + '#w133 .w133grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:14px;align-items:start;}'
    + '#w133 .w133team{background:var(--wa-card,#fff);border-radius:18px;box-shadow:' + SH1 + ';padding:12px 12px 14px;border-top:4px solid var(--tc,' + GREEN + ');min-width:0;}'
