    + '.w131chip.hand{background:rgba(220,165,39,.16);}'
    + '.w131chip.gone{background:rgba(179,64,47,.08);color:' + FLAG + ';}'
    + '.w131empty{font-size:13.5px;color:var(--wa-muted,#797773);padding:14px 18px;margin:0;line-height:1.5;}'
    + '.w131foot{font-size:12.5px;color:var(--wa-muted,#797773);margin:6px 2px 0;line-height:1.5;}'
    /* the sheet */
