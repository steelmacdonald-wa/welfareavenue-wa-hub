    + '.w131btn.danger:hover{background:rgba(179,64,47,.07);box-shadow:none;}'
    + '.w131btn.danger.solid{background:' + FLAG + ';color:' + CREAM + ' !important;border-color:' + FLAG + ';}'
    + '.w131btn.sm{font-size:12.5px;padding:7px 11px;border-radius:9px;}'
