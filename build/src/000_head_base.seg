<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
  :root {
    /* Welfare Avenue palette (swap these for the official brand hex if different) */
    --wa-ink: #103F39;
    --wa-green: #103F39;
    --wa-green-soft: #103F39;
    --wa-gold: #DCA527;
    --wa-gold-soft: #F5E1B5;
    --wa-paper: #F4F2EA;
    --wa-card: #FFFAF2;
    --wa-line: #DEE0D8;
    --wa-text: #1F201E;
    --wa-muted: #797773;
    --wa-flag: #b3402f;

    /* department colour chips */
    --c-opsmtl: #103F39;
    --c-opsto: #3a6ea5;
    --c-mkt: #6F64AB;
    --c-fund: #c87a2f;
    --c-grants: #b8902f;
    --c-hr: #b3402f;
    --c-board: #4a4f57;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    background: var(--wa-paper);
    color: var(--wa-text);
    line-height: 1.55;
    font-size: 15px;
  }

  a { color: var(--wa-green); }

  /* ---------- Header ---------- */
  header.wa-header {
    background: linear-gradient(135deg, var(--wa-ink), var(--wa-green));
    color: #FFFAF2;
    padding: 26px 24px 22px;
  }
  .wa-wrap { max-width: 1080px; margin: 0 auto; }
  .wa-brandrow { display: flex; align-items: center; gap: 14px; }
  .wa-logo {
    width: 46px; height: 46px; border-radius: 11px;
    background: var(--wa-gold);
    display: flex; align-items: center; justify-content: center;
    color: var(--wa-ink); font-weight: 800; font-size: 20px; letter-spacing: -1px;
    flex: 0 0 auto;
  }
  .wa-brandrow h1 { font-size: 19px; margin: 0; font-weight: 700; letter-spacing: .2px; }
  .wa-brandrow .sub { font-size: 13px; opacity: .82; margin-top: 2px; }
  .wa-meta {
    margin-top: 16px; display: flex; flex-wrap: wrap; gap: 10px 22px;
    font-size: 12.5px; opacity: .9;
  }
  .wa-meta b { font-weight: 600; }
  .wa-legend { margin-top: 10px; font-size: 12.5px; opacity: .9; }
  .flag { color: var(--wa-gold-soft); font-weight: 700; }

  /* identity + status pills */
  .wa-toolbar {
    background: var(--wa-ink); color: #ECEBE3;
    font-size: 12.5px; padding: 8px 24px;
  }
  .wa-toolbar .wa-wrap { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; justify-content: space-between; }
  .pill { display: inline-flex; align-items: center; gap: 7px; }
  .dot { width: 9px; height: 9px; border-radius: 50%; background: #9aa; }
  .dot.ok { background: #57c98b; }
  .dot.local { background: var(--wa-gold); }
  .who-btn {
    background: rgba(255,250,242,.12); color: #FFFAF2; border: 1px solid rgba(255,250,242,.25);
    border-radius: 20px; padding: 3px 12px; cursor: pointer; font-size: 12.5px;
  }
  .who-btn:hover { background: rgba(255,250,242,.22); }

  /* ---------- Nav ---------- */
  nav.wa-nav {
    position: sticky; top: 0; z-index: 20;
    background: var(--wa-card); border-bottom: 1px solid var(--wa-line);
    box-shadow: 0 1px 6px rgba(0,0,0,.04);
  }
  nav.wa-nav .wa-wrap { display: flex; flex-wrap: wrap; gap: 2px; }
  .tab {
    border: none; background: none; cursor: pointer;
    padding: 13px 14px; font-size: 13.5px; font-weight: 600; color: var(--wa-muted);
    border-bottom: 3px solid transparent;
  }
  .tab:hover { color: var(--wa-text); }
  .tab.active { color: var(--wa-green); border-bottom-color: var(--wa-green); }

  /* ---------- Main ---------- */
  main { max-width: 1080px; margin: 0 auto; padding: 26px 24px 80px; }
  .panel { display: none; }
  .panel.active { display: block; animation: fade .25s ease; }
  @keyframes fade { from { opacity: 0; transform: translateY(4px);} to {opacity:1; transform:none;} }

  .setup-banner {
    background: var(--wa-gold-soft); border: 1px solid var(--wa-gold);
    color: #6a4d12; border-radius: 10px; padding: 12px 16px; margin-bottom: 22px;
    font-size: 13.5px;
  }
  .setup-banner b { color: #5a3f0a; }

  .card {
    background: var(--wa-card); border: 1px solid var(--wa-line);
    border-radius: 14px; padding: 20px 22px; margin-bottom: 20px;
    box-shadow: 0 1px 3px rgba(16,63,57,.04);
  }
  .card > h2 { margin: 0 0 4px; font-size: 18px; color: var(--wa-ink); }
  .card .read {
    font-size: 13.5px; color: var(--wa-muted); margin: 0 0 16px;
    border-left: 3px solid var(--wa-gold); padding-left: 12px;
  }
  h3.block { font-size: 12px; text-transform: uppercase; letter-spacing: .9px; color: var(--wa-muted); margin: 18px 0 8px; }

  .deptchip {
    display: inline-block; font-size: 11px; font-weight: 700; color: #FFFAF2;
    padding: 2px 9px; border-radius: 20px; vertical-align: middle; margin-left: 8px;
  }

  /* decision / open-item checklist */
  ul.checklist { list-style: none; margin: 0; padding: 0; }
  ul.checklist li {
    display: flex; gap: 12px; align-items: flex-start;
    padding: 11px 4px; border-bottom: 1px solid var(--wa-line);
  }
  ul.checklist li:last-child { border-bottom: none; }
  ul.checklist input[type=checkbox] {
    width: 19px; height: 19px; margin-top: 2px; accent-color: var(--wa-green); cursor: pointer; flex: 0 0 auto;
  }
  .ci-body { flex: 1; }
  .ci-title { font-weight: 600; }
  .ci-sub { font-size: 12.5px; color: var(--wa-muted); margin-top: 2px; }
  li.done .ci-title { text-decoration: line-through; color: var(--wa-muted); }
  .ci-meta { font-size: 11.5px; color: var(--wa-green-soft); margin-top: 3px; font-style: italic; }
  .area-tag {
    font-size: 11px; font-weight: 700; padding: 1px 8px; border-radius: 12px;
    background: #eef3f0; color: var(--wa-green); margin-left: 6px; white-space: nowrap;
  }

  /* department theming + new blocks */
  .tabdot { display: inline-block; width: 8px; height: 8px; border-radius: 2px; margin-right: 6px; vertical-align: middle; }
  .dept-card { border-top: 5px solid var(--wa-green); }
  .progress-box {
    background: #F4F2EA; border-left: 4px solid var(--wa-gold);
    border-radius: 8px; padding: 11px 15px; margin: 6px 0 16px;
  }
  .progress-box p { margin: 5px 0 0; font-size: 13.5px; }
  ul.prio { list-style: none; margin: 0 0 6px; padding: 0; }
  ul.prio li {
    padding: 9px 13px; margin-bottom: 7px; border-radius: 8px;
    background: #fdf3ee; border: 1px solid #f0d4c2; font-size: 13.5px; font-weight: 600;
    display: flex; gap: 9px; align-items: baseline;
  }
  ul.prio li::before { content: "\2605"; color: var(--wa-flag); flex: 0 0 auto; }
  .subsection {
    border: 1px solid var(--wa-line); border-radius: 11px; padding: 13px 17px; margin: 12px 0;
    border-left: 5px solid var(--sc, #999); background: #FFFAF2;
  }
  .subhead { font-size: 14.5px; font-weight: 700; margin: 0 0 3px; color: var(--sc, #333); }
  .sub-sum { font-size: 13px; color: var(--wa-muted); margin: 0 0 10px; }
  .subsection ul.checklist li { padding: 9px 2px; }
  .add-row { margin: 14px 0 4px; }
  .btn.mini { padding: 6px 12px; font-size: 12.5px; }
  .reassign-btn { background: none; border: none; color: var(--wa-green); font-size: 11.5px; cursor: pointer; text-decoration: underline; padding: 0 0 0 4px; }
  .reassign-btn:hover { color: var(--wa-green-soft); }
  details.completed { margin: 14px 0 4px; border-top: 1px dashed var(--wa-line); padding-top: 10px; }
  details.completed summary { cursor: pointer; font-size: 12px; font-weight: 700; color: var(--wa-muted); text-transform: uppercase; letter-spacing: .7px; list-style: revert; }
  details.completed summary:hover { color: var(--wa-text); }
  details.completed ul.checklist { margin-top: 8px; }
  .dash { margin: 8px 0 10px; }
  .dash-row { display: flex; align-items: center; gap: 12px; margin-bottom: 9px; font-size: 12.5px; }
  .dash-label { width: 150px; flex: 0 0 auto; }
  .dash-bar-wrap { flex: 1; background: #eef1ee; border-radius: 6px; min-height: 22px; display: flex; align-items: center; }
  .dash-bar { min-width: 30px; padding: 3px 9px; color: #FFFAF2; font-weight: 700; border-radius: 6px; white-space: nowrap; font-size: 12px; }
  .dash-none { color: var(--wa-muted); font-size: 11.5px; padding-left: 8px; }
  .dash-nums { width: 130px; flex: 0 0 auto; color: var(--wa-muted); text-align: right; }
  @media (max-width: 640px) { .dash-label { width: 96px; } .dash-nums { display: none; } }

  table.wa-tbl { width: 100%; border-collapse: collapse; font-size: 13.5px; margin-top: 4px; }
  table.wa-tbl th, table.wa-tbl td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--wa-line); vertical-align: top; }
  table.wa-tbl th { font-size: 11.5px; text-transform: uppercase; letter-spacing: .5px; color: var(--wa-muted); }
  table.wa-tbl tr:last-child td { border-bottom: none; }

  .updates li { margin-bottom: 9px; }
  .updates .u-date { font-weight: 700; color: var(--wa-green); }

  .team-tags { display: flex; flex-wrap: wrap; gap: 7px; }
  .team-tag { background: #eef3f0; border: 1px solid var(--wa-line); border-radius: 8px; padding: 5px 10px; font-size: 12.5px; }
  .team-tag b { color: var(--wa-ink); }

  /* ---------- Transcripts ---------- */
  .tx-controls { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin-bottom: 18px; }
  select, input[type=text], input[type=date], textarea {
    font: inherit; padding: 9px 11px; border: 1px solid var(--wa-line); border-radius: 9px; background: #FFFAF2; color: var(--wa-text);
  }
  textarea { width: 100%; min-height: 150px; resize: vertical; }
  .btn {
    background: var(--wa-green); color: #FFFAF2; border: none; border-radius: 9px;
    padding: 10px 18px; font-weight: 600; cursor: pointer; font-size: 14px;
  }
  .btn:hover { background: var(--wa-green-soft); }
  .btn.ghost { background: #FFFAF2; color: var(--wa-green); border: 1px solid var(--wa-green); }
  .btn:disabled { opacity: .5; cursor: not-allowed; }

  .tx-form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px; }
  .tx-form-grid .full { grid-column: 1 / -1; }
  @media (max-width: 640px) { .tx-form-grid { grid-template-columns: 1fr; } }

  .tx-item { border: 1px solid var(--wa-line); border-radius: 12px; margin-bottom: 12px; background: #FFFAF2; overflow: hidden; }
  .tx-head { display: flex; gap: 12px; align-items: center; padding: 13px 16px; cursor: pointer; }
  .tx-head:hover { background: #F4F2EA; }
  .tx-head .tx-title { font-weight: 600; flex: 1; }
  .tx-head .tx-date { font-size: 12.5px; color: var(--wa-muted); }
  .tx-body { padding: 0 16px 16px; display: none; white-space: pre-wrap; font-size: 13.5px; color: #333; border-top: 1px solid var(--wa-line); padding-top: 14px; }
  .tx-item.open .tx-body { display: block; }
  .tx-empty { color: var(--wa-muted); font-size: 13.5px; padding: 18px 4px; }

  .footer { max-width: 1080px; margin: 0 auto; padding: 20px 24px 50px; font-size: 12px; color: var(--wa-muted); }
  .toast {
    position: fixed; bottom: 22px; left: 50%; transform: translateX(-50%);
    background: var(--wa-ink); color: #FFFAF2; padding: 11px 20px; border-radius: 24px;
    font-size: 13.5px; opacity: 0; pointer-events: none; transition: opacity .25s; z-index: 50;
  }
  .toast.show { opacity: 1; }

  /* access gate */
  .gate {
    position: fixed; inset: 0; z-index: 100;
    background: linear-gradient(135deg, var(--wa-ink), var(--wa-green));
    display: none; align-items: center; justify-content: center; padding: 24px;
  }
  .gate-card {
    background: var(--wa-card); border-radius: 16px; padding: 34px 30px; width: 100%; max-width: 360px;
    text-align: center; box-shadow: 0 18px 50px rgba(0,0,0,.3);
  }
  .gate-card .wa-logo { margin: 0 auto 14px; }
  .gate-card h2 { margin: 0 0 4px; color: var(--wa-ink); font-size: 20px; }
  .gate-card p { margin: 0 0 18px; font-size: 13.5px; color: var(--wa-muted); }
  .gate-card input { width: 100%; margin-bottom: 12px; text-align: center; font-size: 15px; }
  .gate-card .btn { width: 100%; }
  .gate-err { color: var(--wa-flag); font-size: 12.5px; margin-top: 10px; min-height: 16px; }

  /* ================= v2 additions ================= */

  /* sign-in gate */
  .btn-google {
    display: flex; align-items: center; justify-content: center; gap: 10px;
    width: 100%; background: #FFFAF2; color: #3c4043; border: 1px solid #dadce0;
    border-radius: 9px; padding: 11px 16px; font-weight: 600; font-size: 14.5px; cursor: pointer;
  }
  .btn-google:hover { background: #F4F2EA; }
  .gate-foot { font-size: 11.5px; color: var(--wa-muted); margin: 16px 0 0; }
  .gate-note { font-size: 12px; color: #8a6414; background: #fdf0d4; border-radius: 8px; padding: 8px 10px; margin-top: 12px; display: none; text-align: left; }

  /* board (sanitized) mode */
  .board-note {
    background: #fdf3ee; border-bottom: 1px solid #f0d4c2; color: #7a4326;
    font-size: 12.5px; padding: 8px 24px; text-align: center;
  }

  /* department banner photos */
  .dept-banner { position: relative; height: 175px; margin: -20px -22px 18px; border-radius: 13px 13px 0 0; overflow: hidden; background: var(--wa-ink); }
  .dept-banner img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .dept-banner .shade { position: absolute; inset: 0; background: linear-gradient(165deg, rgba(16,63,57,.78) 0%, rgba(16,63,57,.38) 55%, rgba(16,63,57,.22) 100%); }
  .dept-banner h2 { position: absolute; left: 22px; right: 22px; bottom: 12px; margin: 0; color: #FFFAF2; font-size: 20px; text-shadow: 0 1px 10px rgba(0,0,0,.45); }
  .dept-banner .deptchip { box-shadow: 0 1px 6px rgba(0,0,0,.3); }

  /* meeting chip band */
  .meet-band { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 16px; }
  .info-chip {
    display: inline-flex; align-items: center; gap: 8px; background: #eef3f0;
    border: 1px solid var(--wa-line); border-radius: 20px; padding: 5px 13px;
    font-size: 12.5px; color: var(--wa-ink);
  }
  .info-chip b { font-weight: 700; }
  .info-chip a { font-weight: 600; }
  .info-chip .ic { color: var(--wa-green); font-size: 13px; }

  /* task metadata */
  .due-badge { font-size: 11px; font-weight: 700; border-radius: 10px; padding: 1px 8px; background: #eef1ee; color: var(--wa-muted); white-space: nowrap; margin-left: 6px; }
  .due-badge.amber { background: #fdf0d4; color: #8a6414; border: 1px solid #ecd9a0; }
  .due-badge.red { background: #fbe3de; color: #8f2a1c; border: 1px solid #eebbb0; }
  .as-chip { display: inline-block; font-size: 11px; font-weight: 600; background: #e7efe9; color: var(--wa-green); border-radius: 10px; padding: 1px 8px; margin: 3px 4px 0 0; }
  .cat-tag { display: inline-block; font-size: 10.5px; font-weight: 700; color: #FFFAF2; border-radius: 10px; padding: 1px 8px; margin-left: 6px; vertical-align: middle; white-space: nowrap; }
  .lock-tag { font-size: 10.5px; color: var(--wa-muted); border: 1px dashed var(--wa-line); border-radius: 10px; padding: 0 7px; margin-left: 6px; white-space: nowrap; }
  .edit-btn { background: none; border: none; color: var(--wa-green); font-size: 11.5px; cursor: pointer; text-decoration: underline; padding: 0 0 0 4px; }
  .edit-btn:hover { color: var(--wa-green-soft); }

  /* what's new strip */
  .whatsnew { background: var(--wa-card); border: 1px solid var(--wa-line); border-radius: 12px; padding: 12px 16px 8px; margin-bottom: 22px; }
  .whatsnew h3 { margin: 0 0 8px; font-size: 12px; text-transform: uppercase; letter-spacing: .8px; color: var(--wa-muted); }
  .wn-list { display: flex; gap: 10px; overflow-x: auto; padding-bottom: 8px; }
  .wn-item { flex: 0 0 auto; width: 265px; background: #F4F2EA; border: 1px solid var(--wa-line); border-radius: 10px; padding: 9px 12px; font-size: 12.5px; cursor: pointer; }
  .wn-item:hover { border-color: var(--wa-green-soft); }
  .wn-dept { font-weight: 700; font-size: 11px; margin-bottom: 2px; }
  .wn-text { color: var(--wa-text); max-height: 57px; overflow: hidden; }
  .wn-when { font-size: 11px; color: var(--wa-muted); margin-top: 4px; }
  .wn-new { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--wa-gold); margin-right: 6px; }

  /* toolbar search */
  .search-wrap { position: relative; flex: 1; min-width: 150px; max-width: 340px; }
  .search-wrap input { width: 100%; padding: 6px 11px; border-radius: 18px; border: 1px solid rgba(255,250,242,.25); background: rgba(255,250,242,.12); color: #FFFAF2; font-size: 12.5px; }
  .search-wrap input::placeholder { color: #b9c6c0; }
  .search-pop { position: absolute; top: 115%; left: 0; right: 0; background: #FFFAF2; color: var(--wa-text); border: 1px solid var(--wa-line); border-radius: 10px; box-shadow: 0 12px 34px rgba(0,0,0,.18); max-height: 350px; overflow: auto; z-index: 80; }
  .search-pop .sr { padding: 9px 13px; border-bottom: 1px solid var(--wa-line); cursor: pointer; font-size: 13px; }
  .search-pop .sr:last-child { border-bottom: none; }
  .search-pop .sr:hover { background: #F4F2EA; }
  .sr-type { font-size: 10px; font-weight: 700; color: var(--wa-muted); text-transform: uppercase; letter-spacing: .5px; margin-right: 6px; }

  /* modal */
  .modal-back { position: fixed; inset: 0; background: rgba(16,63,57,.5); z-index: 90; display: flex; align-items: center; justify-content: center; padding: 18px; }
  .modal { background: #FFFAF2; border-radius: 14px; max-width: 540px; width: 100%; max-height: 92vh; overflow: auto; padding: 24px; box-shadow: 0 18px 60px rgba(0,0,0,.3); }
  .modal h3 { margin: 0 0 6px; color: var(--wa-ink); font-size: 18px; }
  .modal .m-sub { font-size: 12.5px; color: var(--wa-muted); margin: 0 0 14px; }
  .modal label { font-size: 12px; color: var(--wa-muted); display: block; margin: 12px 0 4px; font-weight: 600; }
  .modal input[type=text], .modal input[type=date], .modal input[type=url], .modal select, .modal textarea { width: 100%; }
  .modal textarea { min-height: 70px; }
  .m-foot { display: flex; gap: 10px; justify-content: flex-end; margin-top: 20px; }
  .m-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .picker-chips { display: flex; flex-wrap: wrap; gap: 6px; margin: 8px 0 2px; min-height: 10px; }
  .picker-chips .as-chip { cursor: pointer; font-size: 12px; padding: 4px 11px; }
  .picker-chips .as-chip:hover { background: #f6e3e0; color: var(--wa-flag); }

  /* filters */
  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 16px; align-items: center; }
  .fchip { border: 1px solid var(--wa-line); background: #FFFAF2; border-radius: 18px; padding: 5px 13px; font-size: 12px; font-weight: 600; color: var(--wa-muted); cursor: pointer; }
  .fchip.on { background: var(--wa-green); border-color: var(--wa-green); color: #FFFAF2; }

  /* transcript status */
  .tx-status { font-size: 11px; font-weight: 700; border-radius: 10px; padding: 2px 9px; white-space: nowrap; }
  .tx-status.proc { background: #fdf0d4; color: #8a6414; }
  .tx-status.done { background: #e2f0e7; color: #103F39; }
  .tx-status.fail { background: #fbe3de; color: #8f2a1c; }
  .tx-status.none { background: #eef1ee; color: var(--wa-muted); }
  .tx-sum { font-size: 12px; color: var(--wa-muted); padding: 0 16px 10px; font-style: italic; }
  .tx-actions { display: flex; gap: 8px; align-items: center; padding: 0 16px 13px; }

  /* deep link highlight */
  .pulse { animation: pulseHi 2.6s ease; }
  @keyframes pulseHi { 0% { box-shadow: 0 0 0 4px var(--wa-gold); } 100% { box-shadow: 0 0 0 0 transparent; } }

  /* needs-me and activity */
  .nm-group { margin-bottom: 6px; }
  .act-old { color: #8f2a1c; }
  .act-new { color: #103F39; }
  .act-cell-what { max-width: 420px; }

  /* mobile pass */
  @media (max-width: 720px) {
    nav.wa-nav .wa-wrap { flex-wrap: nowrap; overflow-x: auto; -webkit-overflow-scrolling: touch; scrollbar-width: none; }
    nav.wa-nav .wa-wrap::-webkit-scrollbar { display: none; }
    .tab { padding: 13px 11px; white-space: nowrap; font-size: 13px; }
    main { padding: 16px 13px 80px; }
    .card { padding: 15px 15px; }
    .dept-banner { margin: -15px -15px 14px; height: 130px; }
    .dept-banner h2 { left: 15px; bottom: 10px; font-size: 17px; }
    ul.checklist input[type=checkbox] { width: 22px; height: 22px; }
    .btn.mini { padding: 9px 14px; }
    .reassign-btn, .edit-btn { padding: 6px 4px; }
    .modal { padding: 17px; }
    .m-row { grid-template-columns: 1fr; }
    .wa-toolbar .wa-wrap { gap: 8px; }
    .search-wrap { order: 5; flex-basis: 100%; max-width: none; }
    .wn-item { width: 230px; }
    header.wa-header { padding: 20px 16px 16px; }
    .wa-meta { display: none; }
  }
</style>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link id="w117fonts" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Space+Grotesk:wght@400;500;700&display=swap">
<style id="wa110veilcss">
  /* WA v110 boot veil (restyled by wave117, 25/09/26): the static page used to
     paint before the waves restyled it. Until the last wave flags
     html.wa-ready, everything but the veil is hidden; a 9s failsafe in
     wave110 reveals the page no matter what. wave117 fills the veil with the
     brand: the wordmark with the E that moves as the loader, and a fun fact
     about Welfare Avenue that rotates while the hub boots. */
  html:not(.wa-ready) body > *:not(#wa110veil) { visibility: hidden !important; }
  #wa110veil { position: fixed; inset: 0; background: #103F39; display: flex; align-items: center; justify-content: center; z-index: 99999; transition: opacity .45s ease; overflow: hidden; font-family: 'Space Grotesk','Helvetica Neue',Arial,sans-serif; color: #FFFAF2; }
  html.wa-ready #wa110veil { opacity: 0; pointer-events: none; }
  #wa110veil .w117blob { position: absolute; left: -16vw; top: -28vh; width: 58vw; height: 62vh; border-radius: 50%; background: radial-gradient(closest-side, rgba(111,100,171,.96), rgba(111,100,171,.78) 52%, rgba(111,100,171,0) 100%); filter: blur(1.5px); pointer-events: none; }
  #wa110veil .w117doo { position: absolute; pointer-events: none; opacity: 0; animation: w117fade .9s ease .25s forwards; }
  #wa110veil .w117star { right: 5vw; top: 7vh; width: min(150px, 15vw); }
  #wa110veil .w117flow { left: 4vw; bottom: 5vh; width: min(150px, 15vw); }
  #wa110veil .w117heart { right: 6vw; bottom: 6vh; width: min(150px, 15vw); }
  #wa110veil .w117c { position: relative; text-align: center; padding: 0 24px; max-width: 600px; }
  #wa110veil .w117wm { width: min(440px, 74vw); height: auto; display: block; margin: 0 auto; color: #FFFAF2; overflow: visible; }
  #wa110veil .w117wm .bar { transform-box: fill-box; transform-origin: left center; animation: w117bar 1.7s cubic-bezier(.65,0,.35,1) infinite; }
  #wa110veil .w117wm .bar.b2 { animation-delay: .16s; }
  #wa110veil .w117wm .bar.b3 { animation-delay: .32s; }
  @keyframes w117bar { 0% { transform: scaleX(.16); } 42% { transform: scaleX(1); } 68% { transform: scaleX(1); } 100% { transform: scaleX(.16); } }
  #wa110veil .w117ov { margin: 36px 0 8px; font-size: 11px; font-weight: 700; letter-spacing: 2.4px; text-transform: uppercase; color: #DCA527; }
  #wa110veil .w117fact { font-size: 16px; line-height: 1.5; min-height: 3.1em; color: rgba(255,250,242,.92); transition: opacity .35s ease, transform .35s ease; }
  #wa110veil .w117fact.out { opacity: 0; transform: translateY(4px); }
  @keyframes w117fade { to { opacity: 1; } }
  @media (max-width: 600px) { #wa110veil .w117doo { width: 22vw; } #wa110veil .w117heart { display: none; } #wa110veil .w117fact { font-size: 14.5px; } }
  @media (prefers-reduced-motion: reduce) { #wa110veil .w117wm .bar { animation: none; transform: none; } #wa110veil .w117doo { animation: none; opacity: 1; } }
</style>
</head>
<body>
