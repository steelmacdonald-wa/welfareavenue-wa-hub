<script>/* the loading screen: fun facts, and (wave149) the week's lines and shout-outs cached after sign-in; shown only while this browser holds a Hub sign-in. The news banner moved to Home in wave151. */(function(){var F=["Welfare Avenue began as a small group of students with one goal: serve our neighbours through Sunday servings.", "We serve in two cities: bi-weekly servings in Montreal and monthly servings in Toronto.", "More than 3,000 holiday gifts have been delivered to neighbours since our founding.", "Food is our starting point. The meal builds trust; the larger goal is connection, dignity and reintegration.", "Our four pillars: dismantling social isolation, dignified resource distribution, integrating the care ecosystem and food security mobilization.", "We say people we serve, community and support. Never beneficiaries, never the homeless.", "Youth-powered, and open to volunteers and partners of every generation.", "Our five brand colours have names: Dignity, Community, Ground, Possibility and Action.", "The E in AVENUE is drawn as a pathway: three bars that extend forward. That is the E that moves.", "Our doodles are hand-drawn on purpose. Imperfect lines keep the brand human.", "Every September, Rally Paper sends four charity teams racing across Montreal for 36 hours. A canoe race, a mud pit and, one year, a horse.", "Our vision: a world without poverty, where community engagement is a central value from a young age.", "Together we move forward: every act of kindness creates a path.", "The hub turns meeting notes into tasks, goals and decisions automatically, so everyone can see how the work moves."];var el=document.getElementById("w117fact");if(!el)return;var ov=el.previousElementSibling&&el.previousElementSibling.className==="w117ov"?el.previousElementSibling:null;var L={milestone:"Milestone",shout:"Shout-out",lesson:"Lesson learned",learning:"Learning",fact:"Did you know"};var P={fact:F.slice()},DAY=864e5;var c=null;try{var raw=localStorage.getItem("wa149reel");if(raw){var v=JSON.parse(raw);if(v&&v.at&&Date.now()-v.at<14*DAY){if(localStorage.getItem("sb-zwnmulmnvopclzcvytce-auth-token"))c=v;}else localStorage.removeItem("wa149reel");}localStorage.removeItem("wa116s");}catch(e){c=null;}if(c){(c.lines||[]).forEach(function(x){if(x&&x.t&&(x.k==="milestone"||x.k==="lesson"||x.k==="learning")){(P[x.k]=P[x.k]||[]).push(String(x.t));}});if(c.shouts&&c.shouts.length)P.shout=c.shouts.slice(0,12).map(String);}function sh(a){for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t;}return a;}var K=sh(["milestone","shout","lesson","learning","fact"].filter(function(k){return P[k]&&P[k].length;}));K.forEach(function(k){sh(P[k]);});var mix=[],pos={},more=true;while(more&&mix.length<40){more=false;K.forEach(function(k){var n=pos[k]||0;if(n<P[k].length){mix.push([k,P[k][n]]);pos[k]=n+1;more=true;}});}var i=0;function show(){var x=mix[i%mix.length];el.textContent=x[1];if(ov)ov.textContent=L[x[0]];}function wait(){var x=mix[i%mix.length];return Math.max(3200,Math.min(6500,2000+x[1].length*30));}function live(){return!document.documentElement.classList.contains("wa-ready")&&document.body.contains(el);}show();(function tick(){setTimeout(function(){if(!live())return;el.classList.add("out");setTimeout(function(){i++;show();el.classList.remove("out");tick();},360);},wait());})();})();</script>
<div id="gate" class="gate">
  <div class="gate-card">
    <div class="wa-logo">WA</div>
    <h2>Welfare Avenue</h2>
    <p id="gateMsg">The Welfare Avenue Hub. Sign in with your Welfare Avenue Google account.</p>
    <button class="btn-google" id="gateGoogleBtn">
      <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
      Sign in with Google
    </button>
    <div class="gate-err" id="gateErr"></div>
    <div id="gateAlt" style="display:none; margin-top:6px;">
      <button class="btn ghost" id="gateSignOutBtn" style="width:100%;">Sign out and try another account</button>
    </div>
    <div class="gate-note" id="gateFileNote">This page is being opened as a local file, so Google sign-in cannot redirect back. Open the hosted link instead (see GO-LIVE.md in the project folder).</div>
    <p class="gate-foot">Staff sign in with a welfareavenue.com account. Board members: access is by invitation, ask Steel or Suhaib to add your email.</p>
  </div>
</div>

<header class="wa-header">
  <div class="wa-wrap">
    <div class="wa-brandrow">
      <div class="wa-logo">WA</div>
      <div>
        <h1>Welfare Avenue &middot; Hub</h1>
        <div class="sub">Living status tracker and transcript archive for Steel &amp; Suhaib, Co-Executive Directors</div>
      </div>
    </div>
    <div class="wa-meta">
      <span><b>Feed:</b> transcripts are processed automatically and each department page updates itself</span>
      <span><b>Layout:</b> categorized by department</span>
    </div>
    <div class="wa-legend"><span class="flag">&#9873;</span> = needs an executive decision &nbsp;&middot;&nbsp; "Read" = a short morale and energy take</div>
  </div>
</header>

<div class="wa-toolbar">
  <div class="wa-wrap">
    <span class="pill"><span id="cloudDot" class="dot"></span><span id="cloudStatus">Connecting...</span></span>
    <span class="search-wrap" id="searchWrap" style="display:none;">
      <input type="search" id="globalSearch" placeholder="Search everything: tasks, people, goals, meetings..." autocomplete="off" />
      <div id="searchResults" class="search-pop" style="display:none;"></div>
    </span>
    <button id="needsMeBtn" class="who-btn" style="display:none;">&#9873; Needs me</button>
    <span class="pill">Signed in: <b id="whoName" style="color:#FFFAF2;">...</b>
      <button id="signOutBtn" class="who-btn">Sign out</button>
    </span>
  </div>
</div>

<div id="boardNote" class="board-note" style="display:none;">Board view: read only. Confidential operational items are not shown.</div>

<nav class="wa-nav">
  <div class="wa-wrap" id="tabBar">
    <button class="tab active" data-tab="overview"><span class="tabdot" style="background:#DCA527"></span>Open Decisions</button>
    <button class="tab" data-tab="dashboard"><span class="tabdot" style="background:#103F39"></span>Dashboard</button>
    <button class="tab" data-tab="opsmtl"><span class="tabdot" style="background:#103F39"></span>Operations Montreal</button>
    <button class="tab" data-tab="opsto"><span class="tabdot" style="background:#3a6ea5"></span>Operations Toronto</button>
    <button class="tab" data-tab="marketing"><span class="tabdot" style="background:#6F64AB"></span>Marketing, Branding &amp; Web</button>
    <button class="tab" data-tab="fundraising"><span class="tabdot" style="background:#c87a2f"></span>Fundraising &amp; Grants</button>
    <button class="tab" data-tab="hr"><span class="tabdot" style="background:#b3402f"></span>Human Resources</button>
    <button class="tab" data-tab="board"><span class="tabdot" style="background:#4a4f57"></span>Board &amp; Governance</button>
    <button class="tab" data-tab="transcripts" id="txTabBtn"><span class="tabdot" style="background:#797773"></span>Transcript Archive</button>
    <button class="tab" data-tab="activity" id="actTabBtn"><span class="tabdot" style="background:#797773"></span>Activity</button>
  </div>
</nav>

<main>
  <div id="whatsNew" class="whatsnew" style="display:none;"></div>

  <!-- ============ OVERVIEW / OPEN DECISIONS ============ -->
  <section id="overview" class="panel active">
    <div class="card">
      <h2>&#9873; Open decisions</h2>
      <p class="read">The shortlist of calls that need you or Suhaib. Every item carries a reason category and a one line rationale. Check an item when it is decided: you will be asked to record what was decided.</p>
      <div class="filters" id="decFilters"></div>
      <ul class="checklist" id="decisionList"></ul>
      <div class="add-row"><button class="btn ghost mini" id="addDecisionBtn">+ Add decision</button></div>
      <details class="completed" id="decDoneWrap">
        <summary id="decDoneSummary">Decided (0)</summary>
        <ul class="checklist" id="decisionDoneList"></ul>
      </details>
    </div>
  </section>

  <!-- ============ DASHBOARD ============ -->
  <section id="dashboard" class="panel"></section>

  <!-- ============ DEPARTMENTS ============ -->
  <section id="opsmtl" class="panel"></section>
  <section id="opsto" class="panel"></section>
  <section id="marketing" class="panel"></section>
  <section id="fundraising" class="panel"></section>
  <section id="hr" class="panel"></section>
  <section id="board" class="panel"></section>

  <!-- ============ NEEDS ME (from the toolbar toggle) ============ -->
  <section id="needsme" class="panel"></section>

  <!-- ============ ACTIVITY / CHANGE LOG ============ -->
  <section id="activity" class="panel"></section>

  <!-- ============ TRANSCRIPTS ============ -->
  <section id="transcripts" class="panel">
    <div class="card">
      <h2>Add a transcript</h2>
      <p class="read">Paste a meeting transcript, tag the department, and save. The AI processes it automatically: the department page updates itself within a few minutes and a summary posts to #exec-dashboard in Slack. Meetings recorded on the Hub’s Loom account (hub@welfareavenue.com) come in by themselves on Monday, Wednesday and Friday mornings, so there is no need to paste those.</p>
      <div class="tx-form-grid">
        <div>
          <label style="font-size:12.5px;color:var(--wa-muted);">Department</label><br/>
          <select id="txDept" style="width:100%;margin-top:4px;">
            <option value="opsmtl">Operations Montreal</option>
            <option value="opsto">Operations Toronto</option>
            <option value="marketing">Marketing, Branding &amp; Web</option>
            <option value="fundraising">Fundraising</option>
            <option value="hr">Human Resources</option>
            <option value="board">Board &amp; Governance</option>
          </select>
        </div>
        <div>
          <label style="font-size:12.5px;color:var(--wa-muted);">Meeting date</label><br/>
          <input type="date" id="txDate" style="width:100%;margin-top:4px;" />
        </div>
        <div class="full">
          <label style="font-size:12.5px;color:var(--wa-muted);">Title</label><br/>
          <input type="text" id="txTitle" placeholder="e.g. Weekly Fundraising Meeting" style="width:100%;margin-top:4px;" />
        </div>
        <div class="full">
          <label style="font-size:12.5px;color:var(--wa-muted);">Source link (Drive, Loom, or Otter, optional)</label><br/>
          <input type="url" id="txSource" placeholder="https://..." style="width:100%;margin-top:4px;" />
        </div>
        <div class="full">
          <label style="font-size:12.5px;color:var(--wa-muted);">Transcript or summary</label><br/>
          <textarea id="txBody" placeholder="Paste the transcript text here..."></textarea>
        </div>
      </div>
      <button class="btn" id="txSave">Save and process</button>
    </div>

    <div class="card">
      <h2>Archive</h2>
      <div class="tx-controls">
        <select id="txFilter">
          <option value="">All departments</option>
          <option value="Operations Montreal">Operations Montreal</option>
          <option value="Operations Toronto">Operations Toronto</option>
          <option value="Marketing, Branding &amp; Web">Marketing, Branding &amp; Web</option>
          <option value="Fundraising">Fundraising</option>
          <option value="Finance">Finance</option>
          <option value="Human Resources">Human Resources</option>
          <option value="Board &amp; Governance">Board &amp; Governance</option>
        </select>
        <input type="text" id="txSearch" placeholder="Search titles..." style="flex:1;min-width:180px;" />
      </div>
      <div id="txList"></div>
    </div>
  </section>
</main>

<div class="footer">
  The Welfare Avenue Hub, the whole team's workspace. Meetings become tasks, goals and decisions automatically, so everyone can see how the work moves. Sign-in is restricted to Welfare Avenue accounts and invited board viewers.
</div>

<div class="toast" id="toast"></div>
<div id="modalBack" class="modal-back" style="display:none;"><div class="modal" id="modalBox"></div></div>

<script>
/* =====================================================================
   WELFARE AVENUE HUB - single-file build, compacted 06/08/26 (Phase 0)
   =====================================================================
   ARCHITECTURE
   - One HTML file: head + CSS, static panels, then this script.
   - Base app (boot, auth gate, loaders, panels) followed by feature
     waves v2..v75 in load order. Waves wrap or replace earlier
     functions; LOAD ORDER IS BEHAVIOUR - never reorder sections.
   - Superseded bodies are stubbed with a 'superseded' comment where
     a later wave reset the binding without capturing the original.
   - Source of truth: the segmented source tree + assembler (build.sh)
     kept alongside the deploy pipeline; the deployed file is
     assembled from src/*.seg in MANIFEST order.
   - PROTECTED (never modify): process-transcript edge fn,
     apply_transcript_result RPC, the transcript insert trigger.
   SECTION INDEX (wave - one line each)
   WA v2 UI enhancements (injected 22/07/26)
   WA v3 UI enhancements (injected 22/07/26)
   WA v4 UI enhancements (injected 22/07/26)
   WA v5 UI enhancements (injected 22/07/26)
   WA v6 UI enhancements (23/07/26)
   WA v7 UI enhancements (23/07/26)
   WA v8 UI enhancements (25/07/26)
   WA v9 UI enhancements (25/07/26)
   WA v10 UI enhancements (25/07/26)
   WA v11 UI enhancements (25/07/26)
   WA v12 UI enhancements (25/07/26)
   WA v13 UI enhancements (25/07/26)
   WA v14 UI enhancements (25/07/26)
   WA v15 UI enhancements (25/07/26)
   WA v16 UI enhancements (26/07/26)
   WA v17 UI enhancements (26/07/26)
   WA v18 UI enhancements (26/07/26)
   WA v19 UI enhancements (27/07/26)
   WA v20 UI enhancements (27/07/26)
   WA v21 department pages (27/07/26)
   WA v22 finances and budgeting (27/07/26)
   WA v23 volunteer texting (27/07/26)
   WA v24 navigation embedding and SOP master editing (27/07/26)
   WA v25 master SOP structural editing (29/07/26)
   WA v26 volunteering usability wave (29/07/26)
   WA v27 projects and goals flow (29/07/26)
   WA v28 one people table everywhere (29/07/26)
   WA v29 goals reorganization (29/07/26)
   WA v30 quarters ahead, suggested goals, organizational tier (29/07/26)
   WA v31 confirmations, templates, event summary, recipes, requests
   WA v32 assignee dropdowns on the master SOP
   WA v33 event plans, driver itineraries, person pages, Quo replies
   WA v34 goals explainer, cleaner header, dashboard feel
   WA v35 the soft dashboard look
   WA v36 Training and onboarding
   WA v37 onboarding, live from the master
   WA v38 chat actions you confirm
   WA v39 department pages, reordered and polished
   WA v40 roles, permissions, and the admin panel
   WA v41 the department dropdown returns
   WA v42 one navigation
   WA v43 buttons, dedupe, and page help
   WA v44 the training centre
   WA v45 the onboarding SOP doc is HR-only
   WA v46 the HR centre
   WA v47 HR views, recruitment depth, SOP roles, agenda groups
   WA v48 visible dropdown buttons
   WA v49 the recruitment playbook
   WA v50 requests suggested from meetings
   WA v51 comments on every task
   WA v52 projects, due dates, and hours move to HR
   WA v53 agendas: only yours, and purpose-driven drafting
   WA v54 hours: editable minimums, board exempt, tasks per week
   WA v55 the Hours tab becomes Commitment
   WA v56 gather hours on demand
   WA v57 bulk training assignment + folded onboarding subtasks
   WA v58 training page order + quiet completed onboardings
   WA v59 roles on the steps themselves
   WA v60 visual page help
   WA v61 deep page guides
   WA v62 leadership and confidential meetings
   WA v63 editable inventory + sharing with volunteer leaders
   WA v64 tasks route to the owner's department
   WA v65 leadership meetings, upload preview, goal wins, mentions,
   WA v66 leadership meetings can be open to everyone
   WA v67 the training catalog becomes a browsable library
   WA v68 the Goals page becomes Strategy: four tabs
   WA v69 the Strategy map learns rollups and focus
   WA v70 projects show who is working in them
   WA v71 department tasks split into workstream tabs
   WA v72 people management from the Admin page + ClickUp cleanup
   WA v73 the navigation slims down (all six proposals approved)
   WA v74 My page rebuilt: one clean scan path
   WA v75 the assistant steps forward (06/08/26)
   ===================================================================== */
/* =====================================================================
   DATA  (mirrored from the Executive Status Tracker, 27 Apr to 22 Jun 2026)
   ===================================================================== */

const AREA_COLORS = {
  "Ops MTL": "#103F39", "Ops TO": "#3a6ea5", "Marketing": "#6F64AB",
  "Fundraising": "#c87a2f", "Grants": "#b8902f", "HR": "#b3402f", "Board": "#4a4f57"
};

const DECISIONS = [
