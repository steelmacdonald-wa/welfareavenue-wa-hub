/* =====================================================================
   WA v276 Team availability: when can we meet? (02/11/26)
   =====================================================================
   Steel (02/11/26, spec docs/superpowers/specs/2026-11-02-team-availability-design.md): every team member enters a
   typical week of meeting availability from a Home pop-up; each team's Agenda tab shows the overlay so a leader can
   propose a slot in one click.

   - Home pop-up (#w276pop): "Your availability for <team> meetings", once per page load, for the first team
     wa_avail_due() returns, never over another window (otherOpen, the wave272 list plus #w276pop). Valid from, a
     drag-to-paint weekday grid (Monday to Sunday, 08:00 to 22:00 in 30-minute cells from app_config avail_*), a live
     hour count, the fixed note under the minimum (Save stays enabled), Save and Ask me later (a 3-day snooze).
   - Agenda tab (#team/<code>/agenda): "When can we meet?" above the agenda tool (#w276panel before #w116agHost): the
     heat map (a cell's shade = available / members with a grid; hover or tap lists names), the best slots (top three
     windows of at least 60 minutes by headcount, then fewest calendar clashes) with Propose for managers, "k of n
     entered", My availability, and Ask the team for managers.
   - Slots are weekday * 1440 + minute of the day, weekday 0 = Monday (Toronto wall time). Every read and write goes
     through the wa_avail_* RPCs (build/wa276_avail.sql); notify v18 sends meet_propose and meet_avail_ask.
   window.w276: paintAgenda, openPop, best (the pure ranking), slot, unslot, hours. */
(function () {
  'use strict';
  if (window.__wa276) return; window.__wa276 = true;

  var DAYS = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
  var DAYS_SHORT = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
  var W276 = {
    cfg: { start: 480, end: 1320, cellMin: 30, minHours: 10 },
    cfgLoaded: null,     /* the app_config read, once */
    popped: false,       /* the Home pop-up opens at most once per page load */
    agenda: { dept: null, tok: 0, view: null },
    DAYS: DAYS, DAYS_SHORT: DAYS_SHORT
  };

  function E(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
  function say(m) { try { if (typeof toast === 'function') toast(m); } catch (e) { /* fine */ } }
  function isoToday() { var d = new Date(); return d.getFullYear() + '-' + ('0' + (d.getMonth() + 1)).slice(-2) + '-' + ('0' + d.getDate()).slice(-2); }
  function myEmail() { try { return String((typeof USER !== 'undefined' && USER && USER.email) || '').toLowerCase(); } catch (e) { return ''; } }
  function teamLabel(code) {
    try { var T = window.WA_TEAMS; if (T && T.labels && T.labels[code]) return T.labels[code]; } catch (e) { /* fine */ }
    try { if (typeof DEPT_LABEL !== 'undefined' && DEPT_LABEL[code]) return DEPT_LABEL[code]; } catch (e) { /* fine */ }
    return String(code || '');
  }
  function onHome() { var h = String(location.hash || ''); return !h || h === '#' || /^#mypage(\/|$)/.test(h); }

  /* ---------- the pure helpers (test/w276pure.test.mjs) ---------- */
  function slot(di, min) { return Number(di) * 1440 + Number(min); }
  function unslot(n) { n = Number(n); return { di: Math.floor(n / 1440), min: n % 1440 }; }
  function uniq(slots) { var seen = {}, out = []; (slots || []).forEach(function (s) { s = Number(s); if (isFinite(s) && !seen[s]) { seen[s] = 1; out.push(s); } }); return out.sort(function (a, b) { return a - b; }); }
  function hours(slots, cellMin) { return uniq(slots).length * (Number(cellMin) || 30) / 60; }
  function hoursText(h) { var r = Math.round(h * 10) / 10; return (r === 1 ? '1 hour' : String(r) + ' hours'); }
  /* 17:00 -> "5:00 p.m." */
  function clock(min) {
    min = Number(min) % 1440; var h = Math.floor(min / 60), m = min % 60;
    return (h % 12 || 12) + ':' + ('0' + m).slice(-2) + ' ' + (h < 12 ? 'a.m.' : 'p.m.');
  }
  function clockHour(min) { var h = Math.floor((Number(min) % 1440) / 60); return (h % 12 || 12) + ' ' + (h < 12 ? 'a.m.' : 'p.m.'); }
  /* {di, start, end} -> "Tuesday 5:00 p.m. to 6:30 p.m." (no full stop: notify ends the sentence) */
  function windowLabel(w) { return DAYS[w.di] + ' ' + clock(w.start) + ' to ' + clock(w.end); }

  /* The best windows: for each starting cell, grow the window a cell at a time while someone stays available for all
     of it; each time the group shrinks (or the run ends) and the window is at least 60 minutes, it is a candidate with
     that group. Ranked by headcount, then fewest calendar clashes (the sum over the team's clashes inside the window),
     then the longer window, then the earlier one; the top three that do not overlap win.
     members: [{email, name, slots}], clashes: [{email, slot}] -> [{di, start, end, who:[emails], names, n, clash}] */
  function best(members, cellMin, clashes) {
    cellMin = Number(cellMin) || 30;
    var need = Math.max(1, Math.ceil(60 / cellMin));
    var list = (members || []).filter(function (m) { return m && (m.slots || []).length; });
    var by = {}, cl = {};
    list.forEach(function (m, i) { uniq(m.slots).forEach(function (s) { (by[s] = by[s] || []).push(i); }); });
    (clashes || []).forEach(function (c) { var s = Number(c && c.slot); if (isFinite(s)) cl[s] = (cl[s] || 0) + 1; });
    var cands = [];
    Object.keys(by).map(Number).sort(function (a, b) { return a - b; }).forEach(function (s0) {
      var di = Math.floor(s0 / 1440), who = by[s0].slice(), len = 1, clash = cl[s0] || 0, s = s0;
      for (;;) {
        var nx = s + cellMin;
        var nxWho = (Math.floor(nx / 1440) === di && by[nx]) ? who.filter(function (i) { return by[nx].indexOf(i) >= 0; }) : [];
        if (len >= need && nxWho.length < who.length) {
          cands.push({ di: di, start: s0 % 1440, end: s0 % 1440 + len * cellMin, idx: who.slice(), n: who.length, clash: clash, len: len });
        }
        if (!nxWho.length) break;
        who = nxWho; s = nx; len++; clash += cl[s] || 0;
      }
    });
    cands.sort(function (a, b) { return (b.n - a.n) || (a.clash - b.clash) || (b.len - a.len) || ((a.di * 1440 + a.start) - (b.di * 1440 + b.start)); });
    var out = [];
    for (var k = 0; k < cands.length && out.length < 3; k++) {
      var c = cands[k];
      if (out.some(function (o) { return o.di === c.di && o.start < c.end && c.start < o.end; })) continue;
      out.push({
        di: c.di, start: c.start, end: c.end, n: c.n, clash: c.clash,
        who: c.idx.map(function (i) { return String(list[i].email || '').toLowerCase(); }),
        names: c.idx.map(function (i) { return list[i].name || list[i].email || ''; })
      });
    }
    return out;
  }

  /* ---------- wave272's otherOpen, copied, plus this wave's pop-up ---------- */
  function otherOpen() {
    if (!document.documentElement.classList.contains('wa-ready')) return true;
    if (document.getElementById('w272back') || document.getElementById('w213pop') || document.getElementById('w262new') || document.getElementById('w276pop')) return true;
    var vis = function (el) { if (!el) return false; var c = getComputedStyle(el); return c.display !== 'none' && c.visibility !== 'hidden' && el.getBoundingClientRect().width > 0; };
    if (vis(document.getElementById('w238loop')) || vis(document.getElementById('w177pop')) || vis(document.getElementById('w227'))) return true;
    if (document.querySelector('.w122tp')) return true;
    return Array.prototype.some.call(document.querySelectorAll('[aria-modal="true"]'), vis);
  }

  /* ---------- app_config avail_* (read once; the defaults stand when a key is missing) ---------- */
  function loadCfg() {
    if (W276.cfgLoaded) return W276.cfgLoaded;
    W276.cfgLoaded = (async function () {
      try {
        var r = await db.from('app_config').select('key, value').in('key', ['avail_grid_start', 'avail_grid_end', 'avail_cell_min', 'avail_min_hours']);
        var map = { avail_grid_start: 'start', avail_grid_end: 'end', avail_cell_min: 'cellMin', avail_min_hours: 'minHours' };
        ((r && r.data) || []).forEach(function (x) { var n = Number(x.value); if (map[x.key] && isFinite(n) && n >= 0 && (n > 0 || x.key === 'avail_grid_start' || x.key === 'avail_min_hours')) W276.cfg[map[x.key]] = n; });
      } catch (e) { /* the defaults stand */ }
      return W276.cfg;
    })();
    return W276.cfgLoaded;
  }
  /* wa_avail_team carries the same settings: the server's copy wins for that team */
  function cfgFrom(t) {
    var c = W276.cfg, o = { start: c.start, end: c.end, cellMin: c.cellMin, minHours: c.minHours };
    if (t) {
      if (isFinite(Number(t.start)) && t.start != null) o.start = Number(t.start);
      if (isFinite(Number(t.end)) && Number(t.end) > 0) o.end = Number(t.end);
      if (isFinite(Number(t.cell_min)) && Number(t.cell_min) > 0) o.cellMin = Number(t.cell_min);
      if (isFinite(Number(t.min_hours)) && t.min_hours != null) o.minHours = Number(t.min_hours);
    }
    return o;
  }
  function rpcData(r) { if (r && r.error) throw r.error; return r ? r.data : null; }

  /* ---------- the weekday grid ----------
     Ported from the paint grid on the onboarding page (build/o/index.html wireGrid): a mouse drags a rectangle of cells
     (the first cell decides add or remove); touch and keyboard use click, so a finger can still scroll the grid and the
     page. Columns are Monday to Sunday, rows run from start to end in cellMin steps.
     opts: {start, end, cellMin, slots, clashes, readOnly, onChange(slots), heat(slot) -> {alpha, title, x}, onCell(slot, el)}
     Returns {get, set, destroy}. */
  function grid(host, opts) {
    opts = opts || {};
    var start = Number(opts.start), end = Number(opts.end), step = Number(opts.cellMin) || 30;
    if (!isFinite(start)) start = 480;
    if (!isFinite(end) || end <= start) end = 1320;
    var rows = [];
    for (var m = start; m + step <= end; m += step) rows.push(m);
    var sel = {}; uniq(opts.slots).forEach(function (s) { sel[s] = 1; });
    var clash = {}; (opts.clashes || []).forEach(function (s) { clash[Number(s)] = 1; });
    var ro = !!opts.readOnly;

    var h = '<div class="w276g' + (ro ? ' w276ro' : '') + '" role="group" aria-label="' + (ro ? 'Team availability by weekday' : 'Your typical week') + '">'
      + '<div class="w276tc" aria-hidden="true"><div class="w276dh"></div>'
      + rows.map(function (r) { return '<div class="w276tl">' + (r % 60 === 0 ? E(clockHour(r)) : '') + '</div>'; }).join('') + '</div>';
    DAYS.forEach(function (d, di) {
      h += '<div class="w276day"><div class="w276dh" aria-hidden="true">' + DAYS_SHORT[di] + '</div>';
      rows.forEach(function (r, ri) {
        var s = slot(di, r), x = !!clash[s], ht = ro && opts.heat ? (opts.heat(s) || {}) : null;
        var title = ht ? ht.title : (x ? 'Usually in a meeting' : '');
        h += '<button type="button" class="w276c' + ((x || (ht && ht.x)) ? ' w276x' : '') + (r % 60 === 0 ? ' w276hr' : '') + '" data-di="' + di + '" data-min="' + r + '" data-r="' + ri + '"'
          + (ro ? '' : ' aria-pressed="' + (sel[s] ? 'true' : 'false') + '"')
          + ' aria-label="' + E(DAYS[di] + ' ' + clock(r) + (ht && ht.title ? ', ' + ht.title : '')) + '"'
          + (title ? ' title="' + E(title) + '"' : '') + '>'
          + (ht ? '<span class="w276h" style="opacity:' + Math.max(0, Math.min(1, Number(ht.alpha) || 0)).toFixed(3) + '"></span>' : '')
          + '</button>';
      });
      h += '</div>';
    });
    h += '</div>';
    var wrap = document.createElement('div'); wrap.className = 'w276gw'; wrap.innerHTML = h;
    host.innerHTML = ''; host.appendChild(wrap);
    var g = wrap.firstChild;

    function list() { return Object.keys(sel).map(Number).sort(function (a, b) { return a - b; }); }
    function paint() {
      if (ro) return;
      Array.prototype.forEach.call(g.querySelectorAll('.w276c'), function (c) {
        var on = sel[slot(c.getAttribute('data-di'), c.getAttribute('data-min'))] ? 'true' : 'false';
        if (c.getAttribute('aria-pressed') !== on) c.setAttribute('aria-pressed', on);
      });
    }
    function changed() { paint(); if (typeof opts.onChange === 'function') { try { opts.onChange(list()); } catch (e) { console.warn('wave276 grid', e); } } }
    function at(el) {
      var c = el && el.closest ? el.closest('.w276c') : null;
      if (!c || !g.contains(c)) return null;
      return { el: c, di: Number(c.getAttribute('data-di')), r: Number(c.getAttribute('data-r')), s: slot(c.getAttribute('data-di'), c.getAttribute('data-min')) };
    }

    var drag = null, swallow = false, unwire = function () {};
    if (ro) {
      g.addEventListener('click', function (e) { var c = at(e.target); if (c && typeof opts.onCell === 'function') opts.onCell(c.s, c.el); });
    } else {
      var applyRect = function (c) {
        var a = drag.a, d0 = Math.min(a.di, c.di), d1 = Math.max(a.di, c.di), r0 = Math.min(a.r, c.r), r1 = Math.max(a.r, c.r);
        var next = {}; Object.keys(drag.base).forEach(function (k) { next[k] = 1; });
        for (var di = d0; di <= d1; di++) for (var ri = r0; ri <= r1; ri++) {
          var s = slot(di, rows[ri]);
          if (drag.add) next[s] = 1; else delete next[s];
        }
        sel = next; changed();
      };
      g.addEventListener('pointerdown', function (e) {
        if (e.pointerType !== 'mouse' || e.button !== 0) return;
        var c = at(e.target); if (!c) return;
        swallow = true;
        var base = {}; Object.keys(sel).forEach(function (k) { base[k] = 1; });
        drag = { a: c, base: base, add: !sel[c.s] };
        applyRect(c);
        e.preventDefault();
      });
      var move = function (e) {
        if (!drag) return;
        var c = at(document.elementFromPoint(e.clientX, e.clientY));
        if (c) applyRect(c);
      };
      var up = function () { if (drag) drag = null; setTimeout(function () { swallow = false; }, 0); };
      window.addEventListener('pointermove', move);
      window.addEventListener('pointerup', up);
      window.addEventListener('pointercancel', up);
      unwire = function () { window.removeEventListener('pointermove', move); window.removeEventListener('pointerup', up); window.removeEventListener('pointercancel', up); };
      g.addEventListener('click', function (e) {
        if (swallow) return;
        var c = at(e.target); if (!c) return;
        if (sel[c.s]) delete sel[c.s]; else sel[c.s] = 1;
        changed();
      });
    }
    return {
      get: list,
      set: function (slots) { sel = {}; uniq(slots).forEach(function (s) { sel[s] = 1; }); changed(); },
      destroy: function () { unwire(); unwire = function () {}; if (wrap.parentNode) wrap.parentNode.removeChild(wrap); }
    };
  }
  W276.grid = grid;

  /* ---------- the pop-up: your availability for a team ----------
     A centred card (a bottom sheet under 700px) in wave177's style. due is the wa_avail_due() row when Home asks, or null
     when the person opened it themselves (My availability on the Agenda tab): then the second button is Cancel and no
     snooze is written. Escape and a click on the scrim do what the second button does. */
  var NOTE1 = 'Thanks for adding your availability. Could you add a little more? We ask for at least {m} hours so your manager has room to find a time that works for the whole team.';
  var NOTE2 = "If your week is tight, that's fine. Even an extra hour or two near the times you already picked helps, since the next person can plan around them.";
  var P = { dept: null, due: null, g: null, from: null, cfg: null, busy: false };

  function closePop() {
    var bk = document.getElementById('w276back');
    if (P.g) { P.g.destroy(); P.g = null; }
    document.removeEventListener('keydown', escPop, true);
    if (bk) bk.remove();
    var f = P.from; P.from = null;
    if (f && f.isConnected && f.focus) { try { f.focus({ preventScroll: true }); } catch (e) { /* fine */ } }
  }
  function escPop(e) { if (e.key === 'Escape' && document.getElementById('w276pop')) { e.stopPropagation(); e.preventDefault(); later(); } }
  function later() {
    if (P.busy) return;
    var dept = P.dept, due = P.due;
    closePop();
    if (due && dept) {
      Promise.resolve().then(function () { return db.rpc('wa_avail_snooze', { p_dept: dept }); })
        .then(function (r) { if (r && r.error) console.warn('wave276 snooze', r.error); }, function (e) { console.warn('wave276 snooze', e); });
    }
  }
  function syncHours(slots) {
    var c = P.cfg, hrs = hours(slots, c.cellMin);
    var n = document.getElementById('w276hours'); if (n) n.textContent = hoursText(hrs) + ' selected';
    var note = document.getElementById('w276note'); if (note) note.hidden = !(c.minHours > 0 && hrs < c.minHours);
  }
  function popErr(msg) { var e = document.getElementById('w276err'); if (e) { e.textContent = msg || ''; e.hidden = !msg; } }
  async function save() {
    if (P.busy || !P.g) return;
    var dept = P.dept, slots = P.g.get(), fromEl = document.getElementById('w276from');
    var from = (fromEl && /^\d{4}-\d{2}-\d{2}$/.test(fromEl.value)) ? fromEl.value : isoToday();
    var btn = document.getElementById('w276save');
    P.busy = true; if (btn) { btn.disabled = true; btn.textContent = 'Saving...'; } popErr('');
    try {
      rpcData(await db.rpc('wa_avail_save', { p_dept: dept, p_from: from, p_slots: slots }));
      P.busy = false;
      closePop();
      say('Thanks. Your availability for ' + teamLabel(dept) + ' is saved.');
      if (W276.agenda.dept === dept && document.getElementById('w276panel')) paintAgenda(dept);
    } catch (e) {
      P.busy = false;
      if (btn) { btn.disabled = false; btn.textContent = 'Save'; }
      popErr('That did not save. Check your connection and try again.');
      console.warn('wave276 save', e);
    }
  }

  async function openPop(dept, due) {
    if (!dept || document.getElementById('w276pop')) return;
    var opener = document.activeElement;
    await loadCfg();
    if (document.getElementById('w276pop')) return;
    var mine = null, team = null, me = myEmail();
    try { mine = rpcData(await db.rpc('wa_avail_mine', { p_dept: dept })); } catch (e) { mine = null; }
    try { team = rpcData(await db.rpc('wa_avail_team', { p_dept: dept })); } catch (e) { team = null; }   /* members see their team; clashes are optional */
    if (document.getElementById('w276pop')) return;
    P.dept = dept; P.due = due || null; P.from = opener; P.busy = false; P.cfg = cfgFrom(team);
    var clashes = ((team && team.clashes) || []).filter(function (c) { return String(c.email || '').toLowerCase() === me; }).map(function (c) { return Number(c.slot); });
    var slots = (mine && mine.slots) || [];
    var lbl = teamLabel(dept);
    var bk = document.createElement('div'); bk.id = 'w276back';
    bk.innerHTML = '<div id="w276pop" role="dialog" aria-modal="true" aria-labelledby="w276title" aria-describedby="w276lead">'
      + '<button type="button" class="x" aria-label="Close" data-w276="later">&times;</button>'
      + '<p class="k">' + E(lbl) + '</p>'
      + '<h2 id="w276title" tabindex="-1">Your availability for ' + E(lbl) + ' meetings</h2>'
      + '<p class="lead" id="w276lead">Mark the times you are usually free in a typical week. Drag across cells to mark several at once, or tap one at a time.</p>'
      + '<div class="from"><label for="w276from">Valid from</label><input type="date" id="w276from" value="' + E(isoToday()) + '" aria-describedby="w276fromh"><p id="w276fromh" class="help">Pick the date your week changes, for example the first day of term.</p></div>'
      + (clashes.length ? '<p class="legend"><span class="sw"></span>Usually in a meeting (from your Hub calendar)</p>' : '')
      + '<div id="w276grid"></div>'
      + '<p id="w276hours" aria-live="polite"></p>'
      + '<div id="w276note" hidden><p>' + E(NOTE1.replace('{m}', String(P.cfg.minHours))) + '</p><p>' + E(NOTE2) + '</p></div>'
      + '<p id="w276err" role="alert" hidden></p>'
      + '<div class="row"><button type="button" class="yes" id="w276save" data-w276="save">Save</button>'
      + '<button type="button" class="no" id="w276later" data-w276="later">' + (P.due ? 'Ask me later' : 'Cancel') + '</button></div>'
      + '</div>';
    document.body.appendChild(bk);
    P.g = grid(document.getElementById('w276grid'), { start: P.cfg.start, end: P.cfg.end, cellMin: P.cfg.cellMin, slots: slots, clashes: clashes, onChange: syncHours });
    syncHours(P.g.get());
    bk.addEventListener('click', function (e) {
      if (e.target === bk) { later(); return; }
      var t = e.target.closest && e.target.closest('[data-w276]'); if (!t) return;
      if (t.getAttribute('data-w276') === 'save') save(); else later();
    });
    document.addEventListener('keydown', escPop, true);
    var t = document.getElementById('w276title'); if (t) { try { t.focus({ preventScroll: true }); } catch (e) { /* fine */ } }
    if (P.due) W276.popped = true;
  }
  W276.openPop = openPop;

  /* Home asks: once per page load, for the first team wa_avail_due() returns, never over another window (it waits
     and looks again a few times, so a pop-up that opened first can finish). */
  var AUTO = { timer: null, tries: 0, due: null };
  function autoPop(delay) {
    clearTimeout(AUTO.timer);
    if (W276.popped) return;
    AUTO.timer = setTimeout(async function () {
      if (W276.popped || !onHome()) return;
      try { if (typeof MODE !== 'undefined' && MODE !== 'staff' && MODE !== 'board') return; } catch (e) { return; }
      if (otherOpen()) { if (AUTO.tries++ < 20) autoPop(document.documentElement.classList.contains('wa-ready') ? 5000 : 1000); return; }
      try {
        if (!AUTO.due) AUTO.due = Promise.resolve(db.rpc('wa_avail_due')).then(rpcData);
        var rows = await AUTO.due;
        if (!rows || !rows.length) { W276.popped = true; return; }
        if (W276.popped || !onHome() || otherOpen()) { if (!W276.popped && onHome() && AUTO.tries++ < 20) autoPop(5000); return; }
        W276.popped = true;
        await openPop(rows[0].department, rows[0]);
      } catch (e) { AUTO.due = null; console.warn('wave276 due', e); }
    }, delay == null ? 1500 : delay);
  }

  /* ---------- the Agenda tab: When can we meet? ----------
     #w276panel sits right before #w116agHost (wave116's mountAgenda). The heat map shades each cell by the share of
     members with a grid who are free then (members with no grid are "not yet entered", never shaded as busy); tapping a
     cell or hovering it lists the names. Managers (wa_avail_team.can_manage) get Propose on each best slot, the names of
     who is outstanding, and Ask the team. A paint for one team that resolves after a newer paint started is dropped. */
  function heatOf(t) {
    var members = (t && t.members) || [], n = members.length, by = {}, cl = {};
    members.forEach(function (m, i) { uniq(m.slots).forEach(function (s) { (by[s] = by[s] || []).push(i); }); });
    ((t && t.clashes) || []).forEach(function (c) { var s = Number(c.slot); cl[s] = (cl[s] || 0) + 1; });
    function name(m) { return m.name || m.email || ''; }
    return function (s) {
      if (!n) return { alpha: 0, title: 'No one has entered a week yet' };
      var free = by[s] || [], yes = free.map(function (i) { return name(members[i]); });
      var no = members.filter(function (m, i) { return free.indexOf(i) < 0; }).map(name);
      var title = (yes.length ? 'Free: ' + yes.join(', ') + '.' : 'No one is free.') + (no.length ? ' Not free: ' + no.join(', ') + '.' : '');
      if (cl[s]) title += ' ' + (cl[s] === 1 ? '1 person is' : cl[s] + ' people are') + ' usually in a meeting.';
      return { alpha: free.length / n, title: title, x: !!cl[s] };
    };
  }

  function closeProp() {
    var bk = document.getElementById('w276pback'); if (!bk) return;
    bk.remove(); document.removeEventListener('keydown', escProp, true);
    var f = W276.propFrom; W276.propFrom = null;
    if (f && f.isConnected && f.focus) { try { f.focus({ preventScroll: true }); } catch (e) { /* fine */ } }
  }
  function escProp(e) { if (e.key === 'Escape') { e.stopPropagation(); e.preventDefault(); closeProp(); } }
  function propose(dept, t, w, from) {
    closeProp(); W276.propFrom = from || document.activeElement;
    var members = (t && t.members) || [], missing = (t && t.missing) || [];
    var cant = members.filter(function (m) { return w.who.indexOf(String(m.email || '').toLowerCase()) < 0; }).map(function (m) { return m.name || m.email; });
    var label = windowLabel(w);
    var bk = document.createElement('div'); bk.id = 'w276pback';
    bk.innerHTML = '<div id="w276prop" role="dialog" aria-modal="true" aria-labelledby="w276ptitle">'
      + '<button type="button" class="x" aria-label="Close" data-w276p="cancel">&times;</button>'
      + '<p class="k">' + E(teamLabel(dept)) + '</p>'
      + '<h2 id="w276ptitle" tabindex="-1">Propose this meeting time?</h2>'
      + '<p class="slot">' + E(label) + '</p>'
      + '<p><b>Can make it (' + w.names.length + '):</b> ' + E(w.names.join(', ') || 'No one') + '</p>'
      + '<p><b>Cannot make it (' + cant.length + '):</b> ' + E(cant.join(', ') || 'No one') + '</p>'
      + (missing.length ? '<p><b>Not yet entered (' + missing.length + '):</b> ' + E(missing.map(function (m) { return m.name || m.email; }).join(', ')) + '</p>' : '')
      + '<p class="help">Everyone else on the team gets a message in the Hub and on Slack. Nothing is added to the calendar.</p>'
      + '<p id="w276perr" role="alert" hidden></p>'
      + '<div class="row"><button type="button" class="yes" id="w276psend" data-w276p="send">Propose this time</button><button type="button" class="no" data-w276p="cancel">Cancel</button></div>'
      + '</div>';
    document.body.appendChild(bk);
    bk.addEventListener('click', async function (e) {
      if (e.target === bk) { closeProp(); return; }
      var b = e.target.closest && e.target.closest('[data-w276p]'); if (!b) return;
      if (b.getAttribute('data-w276p') !== 'send') { closeProp(); return; }
      if (b.disabled) return;
      b.disabled = true; b.textContent = 'Sending...';
      try {
        var r = await db.functions.invoke('notify', { body: { event: 'meet_propose', dept: dept, slot_label: label, who_can: w.names.length, who_cant: cant.length } });
        if (r && r.error) throw r.error;
        closeProp();
        say('Sent. The team knows you proposed ' + label + '.');
      } catch (err) {
        b.disabled = false; b.textContent = 'Propose this time';
        var pe = document.getElementById('w276perr'); if (pe) { pe.textContent = 'That did not send. Try again in a moment.'; pe.hidden = false; }
        console.warn('wave276 propose', err);
      }
    });
    document.addEventListener('keydown', escProp, true);
    var h = document.getElementById('w276ptitle'); if (h) { try { h.focus({ preventScroll: true }); } catch (e) { /* fine */ } }
  }

  async function askTeam(dept, btn) {
    if (btn) { btn.disabled = true; btn.textContent = 'Asking...'; }
    try {
      var r = rpcData(await db.rpc('wa_avail_ask_set', { p_dept: dept, p_date: isoToday(), p_note: null }));
      var n = ((r && r.missing) || []).length;
      var s = await db.functions.invoke('notify', { body: { event: 'meet_avail_ask', dept: dept } });
      if (s && s.error) throw s.error;
      say(n ? 'Asked. ' + (n === 1 ? '1 person' : n + ' people') + ' will get a message to add their week.' : 'Asked. Everyone on the team has an up to date week.');
      if (W276.agenda.dept === dept) paintAgenda(dept);
    } catch (e) {
      if (btn) { btn.disabled = false; btn.textContent = 'Ask the team'; }
      say('That did not go through. Try again in a moment.');
      console.warn('wave276 ask', e);
    }
  }

  async function paintAgenda(dept) {
    var A = W276.agenda, tok = ++A.tok;
    A.dept = dept; A.busy = dept;
    try { await paintTeam(dept, tok); } finally { if (tok === A.tok) A.busy = null; }
  }
  async function paintTeam(dept, tok) {
    var A = W276.agenda;
    await loadCfg();
    var t = null;
    try { t = rpcData(await db.rpc('wa_avail_team', { p_dept: dept })); } catch (e) { t = null; console.warn('wave276 team', e); }
    if (tok !== A.tok) return;
    var host = document.getElementById('w116agHost');
    var panel = document.getElementById('w276panel');
    if (!host || !t) { if (panel) { if (A.view) { A.view.destroy(); A.view = null; } panel.remove(); } return; }
    if (!panel) { panel = document.createElement('section'); panel.id = 'w276panel'; panel.setAttribute('aria-labelledby', 'w276ph'); }
    if (panel.parentNode !== host.parentNode || panel.nextElementSibling !== host) host.parentNode.insertBefore(panel, host);
    if (A.view) { A.view.destroy(); A.view = null; }
    panel.setAttribute('data-dept', dept);
    var c = cfgFrom(t), members = t.members || [], missing = t.missing || [], can = !!t.can_manage;
    var k = members.length, n = members.length + missing.length;
    var wins = best(members, c.cellMin, t.clashes || []);
    var status = k + ' of ' + n + ' entered' + (missing.length ? ', ' + missing.length + ' outstanding' : '');
    panel.innerHTML = '<div class="hd"><h3 id="w276ph"><span class="k">' + E(teamLabel(dept)) + '</span>When can we meet?</h3>'
      + '<div class="acts"><button type="button" class="b2" id="w276mine">My availability</button>'
      + (can ? '<button type="button" class="b1" id="w276ask">Ask the team</button>' : '') + '</div></div>'
      + (can && missing.length
        ? '<p class="st"><button type="button" class="lk" id="w276st" aria-expanded="false" aria-controls="w276miss">' + E(status) + '</button></p>'
          + '<p id="w276miss" hidden>Not yet entered: ' + E(missing.map(function (m) { return m.name || m.email; }).join(', ')) + '</p>'
        : '<p class="st">' + E(status) + '</p>')
      + '<div class="body"><div class="map"><p class="help">Darker means more of the team is free. Tap or point at a time to see who.</p><div id="w276heat"></div><p id="w276cell" aria-live="polite"></p></div>'
      + '<div class="side"><h4>Best slots</h4><ol id="w276best">'
      + wins.map(function (w, i) {
        return '<li><span class="w">' + E(windowLabel(w)) + '</span><span class="n">' + w.n + ' of ' + k + ' can make it' + (w.clash ? ', clashes with ' + (w.clash === 1 ? '1 regular meeting' : w.clash + ' regular meetings') : '') + '</span>'
          + (can ? '<button type="button" class="b1" data-w276best="' + i + '">Propose</button>' : '') + '</li>';
      }).join('') + '</ol>'
      + (wins.length ? '' : '<p class="help">' + (k ? 'No hour yet when the same people are free for 60 minutes in a row. As more people add their week, times show here.' : 'Times show here once people add their week.') + '</p>')
      + '</div></div>';
    var heat = heatOf(t);
    A.view = grid(document.getElementById('w276heat'), {
      start: c.start, end: c.end, cellMin: c.cellMin, readOnly: true, heat: heat,
      onCell: function (s, el) { var u = unslot(s), o = document.getElementById('w276cell'); if (o) o.textContent = DAYS[u.di] + ' ' + clock(u.min) + ': ' + heat(s).title; }
    });
    panel.querySelector('#w276mine').addEventListener('click', function () { openPop(dept, null); });
    var ask = panel.querySelector('#w276ask'); if (ask) ask.addEventListener('click', function () { askTeam(dept, ask); });
    var st = panel.querySelector('#w276st');
    if (st) st.addEventListener('click', function () {
      var m = document.getElementById('w276miss'); if (!m) return;
      m.hidden = !m.hidden; st.setAttribute('aria-expanded', String(!m.hidden));
    });
    panel.querySelector('#w276best').addEventListener('click', function (e) {
      var b = e.target.closest && e.target.closest('[data-w276best]'); if (!b) return;
      var w = wins[Number(b.getAttribute('data-w276best'))]; if (w) propose(dept, t, w, b);
    });
  }
  W276.paintAgenda = paintAgenda;

  /* ---------- styles (the Hub's colour tokens from 000_head_base) ---------- */
  var HEADF = "'Barlow Condensed','Arial Narrow','Helvetica Neue',Arial,sans-serif";
  var css = ''
    /* the grid */
    + '.w276gw{overflow-x:auto;-webkit-overflow-scrolling:touch;max-width:100%;margin:6px 0 4px;}'
    + '.w276g{display:grid;grid-template-columns:52px repeat(7,minmax(36px,1fr));gap:0 3px;min-width:318px;user-select:none;-webkit-user-select:none;}'
    + '.w276tc,.w276day{display:flex;flex-direction:column;}'
    + '.w276dh{height:22px;font-size:11.5px;font-weight:700;color:var(--wa-green);text-align:center;line-height:22px;}'
    + '.w276tl{height:16px;margin-top:2px;font-size:10.5px;color:var(--wa-muted);text-align:right;padding-right:6px;line-height:12px;white-space:nowrap;}'
    + '.w276c{position:relative;display:block;height:16px;margin:2px 0 0;padding:0;border:1px solid var(--wa-line);border-radius:4px;background:var(--wa-card);cursor:pointer;overflow:hidden;font:inherit;touch-action:manipulation;}'
    + '.w276c.w276hr{margin-top:3px;}'
    + '.w276c:hover{border-color:var(--wa-green);}'
    + '.w276c:focus-visible{outline:2px solid var(--wa-gold);outline-offset:1px;}'
    + '.w276c[aria-pressed="true"]{background:var(--wa-green);border-color:var(--wa-green);}'
    + '.w276c.w276x{background-image:repeating-linear-gradient(135deg,var(--wa-gold-soft) 0 4px,transparent 4px 8px);}'
    + '.w276c.w276x[aria-pressed="true"]{background-image:repeating-linear-gradient(135deg,var(--wa-gold) 0 3px,transparent 3px 8px);}'
    + '.w276ro .w276c{cursor:help;}'
    + '.w276ro .w276c .w276h{position:absolute;inset:0;background:var(--wa-green);pointer-events:none;}'
    + '.w276ro .w276c.w276x::after{content:"";position:absolute;left:0;right:0;bottom:0;height:3px;background:var(--wa-gold);pointer-events:none;}'
    /* the pop-up, wave177's look: a centred card, a bottom sheet under 700px */
    + '#w276back,#w276pback{position:fixed;inset:0;z-index:2147482990;display:flex;align-items:center;justify-content:center;padding:16px;background:rgba(16,32,30,.48);}'
    + '#w276pop,#w276prop{position:relative;width:min(640px,100%);max-height:calc(100vh - 32px);overflow:auto;box-sizing:border-box;border-radius:20px;background:var(--wa-card);border-top:6px solid var(--wa-gold);padding:22px 22px 18px;color:var(--wa-text);box-shadow:0 24px 60px rgba(0,0,0,.28);}'
    + '#w276prop{width:min(480px,100%);}'
    + '#w276pop [hidden],#w276prop [hidden],#w276panel [hidden]{display:none !important;}'
    + '#w276pop .x,#w276prop .x{position:absolute;top:10px;right:10px;width:34px;height:34px;border-radius:50%;border:0;background:transparent;color:var(--wa-muted);font-size:22px;line-height:1;cursor:pointer;padding:0;}'
    + '#w276pop .x:hover,#w276prop .x:hover{background:var(--wa-paper);}'
    + '#w276pop .k,#w276prop .k,#w276panel .k{display:block;font-size:11px;letter-spacing:1.6px;text-transform:uppercase;color:var(--wa-green);font-weight:800;margin:0 36px 0 0;}'
    + '#w276pop h2,#w276prop h2{font-family:' + HEADF + ';font-size:28px;line-height:1.08;margin:4px 36px 6px 0;color:var(--wa-green);text-transform:uppercase;letter-spacing:.3px;outline:none;}'
    + '#w276pop .lead{margin:0 0 12px;font-size:14px;}'
    + '#w276pop .from{margin:0 0 8px;}'
    + '#w276pop .from label{display:block;font-weight:700;font-size:13px;margin:0 0 4px;}'
    + '#w276pop .from input{font:inherit;font-size:14px;padding:7px 10px;border:1px solid var(--wa-line);border-radius:10px;background:var(--wa-card);color:var(--wa-text);}'
    + '#w276pop .help,#w276prop .help,#w276panel .help{font-size:12.5px;color:var(--wa-muted);margin:4px 0 0;line-height:1.45;}'
    + '#w276pop .legend{font-size:12.5px;color:var(--wa-muted);margin:8px 0 0;display:flex;align-items:center;gap:6px;}'
    + '#w276pop .legend .sw{display:inline-block;width:18px;height:12px;border:1px solid var(--wa-line);border-radius:3px;background-image:repeating-linear-gradient(135deg,var(--wa-gold-soft) 0 4px,transparent 4px 8px);}'
    + '#w276hours{font-weight:700;font-size:14px;margin:8px 0 0;color:var(--wa-green);}'
    + '#w276note{margin:8px 0 0;padding:10px 12px;border-radius:12px;background:var(--wa-paper);font-size:13.5px;line-height:1.45;}'
    + '#w276note p{margin:0;}#w276note p + p{margin-top:6px;}'
    + '#w276err,#w276perr{font-size:12.5px;color:var(--wa-flag);margin:10px 0 0;}'
    + '#w276pop .row,#w276prop .row{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-top:14px;}'
    + '#w276pop .row button,#w276prop .row button{border:0;border-radius:999px;padding:11px 20px;font-weight:700;font-size:14px;font-family:inherit;cursor:pointer;flex:1 1 160px;}'
    + '#w276pop button.yes,#w276prop button.yes{background:var(--wa-green);color:var(--wa-card);}'
    + '#w276pop button.no,#w276prop button.no{background:transparent;color:var(--wa-green);border:1.5px solid var(--wa-line);}'
    + '#w276pop button[disabled],#w276prop button[disabled]{opacity:.55;cursor:default;}'
    + '#w276prop .slot{font-weight:700;font-size:16px;margin:4px 0 10px;}'
    + '#w276prop p{margin:0 0 6px;font-size:14px;line-height:1.45;}'
    + '@media (max-width:700px){'
    + '#w276back,#w276pback{align-items:flex-end;padding:0;}'
    + '#w276pop,#w276prop{width:100%;max-height:92vh;border-radius:20px 20px 0 0;padding:20px 16px calc(18px + env(safe-area-inset-bottom));}'
    + '#w276pop h2,#w276prop h2{font-size:24px;}'
    + '}'
    /* the Agenda panel */
    + '#w276panel{background:var(--wa-card);border:1px solid var(--wa-line);border-radius:16px;padding:16px 18px;margin:0 0 16px;color:var(--wa-text);}'
    + '#w276panel .hd{display:flex;flex-wrap:wrap;gap:10px;align-items:flex-end;justify-content:space-between;}'
    + '#w276panel h3{font-family:' + HEADF + ';font-size:24px;line-height:1.1;margin:0;color:var(--wa-green);text-transform:uppercase;letter-spacing:.3px;}'
    + '#w276panel .acts{display:flex;gap:8px;flex-wrap:wrap;}'
    + '#w276panel .b1,#w276panel .b2{border-radius:999px;padding:8px 16px;font-weight:700;font-size:13px;font-family:inherit;cursor:pointer;}'
    + '#w276panel .b1{background:var(--wa-green);color:var(--wa-card);border:0;}'
    + '#w276panel .b2{background:transparent;color:var(--wa-green);border:1.5px solid var(--wa-line);}'
    + '#w276panel button[disabled]{opacity:.55;cursor:default;}'
    + '#w276panel .st{margin:6px 0 0;font-size:13px;color:var(--wa-muted);}'
    + '#w276panel .lk{border:0;background:none;padding:0;font:inherit;color:var(--wa-green);text-decoration:underline;cursor:pointer;}'
    + '#w276miss{margin:4px 0 0;font-size:13px;}'
    + '#w276panel .body{display:flex;flex-wrap:wrap;gap:18px;margin-top:10px;}'
    + '#w276panel .map{flex:2 1 360px;min-width:0;}'
    + '#w276panel .side{flex:1 1 220px;min-width:0;}'
    + '#w276panel h4{margin:0 0 6px;font-size:12px;letter-spacing:1.2px;text-transform:uppercase;color:var(--wa-green);}'
    + '#w276cell{font-size:13px;margin:4px 0 0;min-height:1.2em;}'
    + '#w276best{list-style:none;margin:0;padding:0;}'
    + '#w276best li{display:flex;flex-wrap:wrap;align-items:center;gap:4px 10px;padding:10px 0;border-top:1px solid var(--wa-line);}'
    + '#w276best li:first-child{border-top:0;padding-top:2px;}'
    + '#w276best .w{font-weight:700;font-size:14px;flex:1 1 100%;}'
    + '#w276best .n{font-size:12.5px;color:var(--wa-muted);flex:1 1 auto;}';
  if (!document.getElementById('w276css')) {
    var st276 = document.createElement('style'); st276.id = 'w276css'; st276.textContent = css; document.head.appendChild(st276);
  }

  /* ---------- the Agenda route: #team/<code>/agenda ----------
     wave116's mountAgenda is private, so this looks for #w116agHost after each route (every 300 ms, 10 times) and
     paints when the panel is missing, sits elsewhere, or shows another team (a leader of two teams moving between
     them without a reload). */
  var ROUTE = { timer: null, tries: 0, code: null };
  function agendaCode() { var m = /^#team\/([a-z]+)\/agenda/.exec(String(location.hash || '')); return m ? m[1] : null; }
  function look() {
    var code = agendaCode();
    if (!code || code !== ROUTE.code) return;
    var host = document.getElementById('w116agHost'), panel = document.getElementById('w276panel');
    var good = host && panel && panel.getAttribute('data-dept') === code && panel.nextElementSibling === host;
    if (host && !good && W276.agenda.busy !== code) paintAgenda(code);
    if (ROUTE.tries++ < 10) ROUTE.timer = setTimeout(look, 300);
  }
  function routeAgenda() {
    clearTimeout(ROUTE.timer);
    ROUTE.code = agendaCode(); ROUTE.tries = 0;
    if (!ROUTE.code) { W276.agenda.dept = null; W276.agenda.tok++; W276.agenda.busy = null; return; }
    look();
  }

  /* ---------- wiring ---------- */
  if (typeof startApp === 'function') {
    var __sa276 = startApp;
    startApp = async function () {
      var r = await __sa276.apply(this, arguments);
      try { loadCfg(); autoPop(1500); routeAgenda(); } catch (e) { console.warn('wave276 boot', e); }
      return r;
    };
  }
  if (typeof renderMyPage === 'function') {
    var __rm276 = renderMyPage;
    renderMyPage = async function () {
      var r = await __rm276.apply(this, arguments);
      try { autoPop(1500); } catch (e) { console.warn('wave276 home', e); }
      return r;
    };
  }
  if (typeof window.w116Route === 'function') {
    var __wr276 = window.w116Route;
    window.w116Route = function () { var r = __wr276.apply(this, arguments); try { routeAgenda(); } catch (e) { /* fine */ } return r; };
  }
  window.addEventListener('hashchange', function () {
    try { routeAgenda(); if (onHome()) autoPop(1500); } catch (e) { console.warn('wave276 route', e); }
  });

  /* ---------- test hook ---------- */
  window.w276 = { paintAgenda: paintAgenda, openPop: openPop, best: best, slot: slot, unslot: unslot, hours: hours, windowLabel: windowLabel, closePop: closePop, state: function () { return W276; } };
})();
