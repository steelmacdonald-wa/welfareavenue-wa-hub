  /* ---------- the Board overview: the last meeting and each director ---------- */
  function boardState() { try { return window.w126 && typeof w126.state === 'function' ? w126.state() : null; } catch (e) { return null; } }
  function paintBoard() {
    var gov = document.getElementById('w126gov'); if (!gov) return;
    if (!M.ok) { (M.busy || load()).then(function () { if (M.ok) paintBoard(); }); return; }
    var now = Date.now();
    var boards = M.meetings.filter(function (m) { return m.kind === 'board' && m.scheduled_start && t(m.scheduled_start) <= now; }).sort(function (a, b) { return t(b.scheduled_start) - t(a.scheduled_start); });
    if (!boards.length) return;
    /* the last meeting: its cell in the meetings card */
    var B = boardState(), bm = (B && B.data && B.data.meetings) || [];
    var last = bm.filter(function (x) { return x.meets_at && x.kind !== 'strategy' && t(x.meets_at) < now && x.status !== 'cancelled'; }).sort(function (a, b) { return t(b.meets_at) - t(a.meets_at); })[0];
    var cell = gov.querySelector('.w126meet > div:nth-child(3)');
