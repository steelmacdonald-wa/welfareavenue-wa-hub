      var txt = row ? (row.held ? row.expected_came_n + ' of ' + row.expected_n + ' directors came' : 'No call found on Meet') : '';
      var span = cell.querySelector('.w144att');
      if (!span) { span = document.createElement('span'); span.className = 'w144att'; cell.appendChild(span); }
      if (span.textContent !== txt) span.textContent = txt;
      span.hidden = !txt;
    }
    /* each director: board meetings in the last twelve months */
    var yr = boards.filter(function (m) { return m.held && t(m.scheduled_start) > now - 365 * 86400000; });
    gov.querySelectorAll('.w126dir[data-w126dir]').forEach(function (card) {
      var id = card.getAttribute('data-w126dir'), c = 0, n = 0;
      yr.forEach(function (m) { rowsOf(m).forEach(function (r) { if (String(r.director_id) === String(id) && r.expected) { n++; if (r.came) c++; } }); });
      var ft = card.querySelector('.ft'); if (!ft) return;
      var txt = n ? 'Board meetings: ' + c + ' of ' + n : '';
      var span = ft.querySelector('.w144b');
      if (!span) { span = document.createElement('span'); span.className = 'w144b'; span.title = 'Board meetings with a call on Meet in the last twelve months'; ft.appendChild(span); }
      if (span.textContent !== txt) span.textContent = txt;
      span.hidden = !n;
    });
  }

  /* ---------- wiring ---------- */
  function paintAll() { try { paintTeam(); } catch (e) { /* fine */ } try { paintHR(); } catch (e) { /* fine */ } try { paintBoard(); } catch (e) { /* fine */ } }
  var obs = {};
  function watch(id, fn, test) {
    var sec = document.getElementById(id); if (!sec || obs[id]) return;
    var pending = false;
    obs[id] = new MutationObserver(function () { if (pending || !test()) return; pending = true; setTimeout(function () { pending = false; if (test()) fn(); }, 40); });
    obs[id].observe(sec, { childList: true, subtree: true });
