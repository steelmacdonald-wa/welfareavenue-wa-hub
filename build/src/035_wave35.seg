/* =====================================================================
   WA v35 the soft dashboard look
   (29/07/26)
   The aesthetic pass, modeled on the reference Steel shared: a light
   neutral canvas with floating white rounded cards, a pill navigation
   bar where the active page is a filled chip, the Inter typeface, soft
   layered shadows instead of hard borders, pill buttons, calm inputs,
   and a stat strip on the home page (open tasks, finished this fiscal
   year, upcoming serving events, volunteers on file). Welfare Avenue
   greens and gold stay; the clutter goes.
   ===================================================================== */

(function () {
  if (document.getElementById('wa35css')) return;
  var st = document.createElement('style');
  st.id = 'wa35css';
  st.textContent = '' +
    '@import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap");' +
    /* canvas and type */
    'body{background:#edefee;font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;font-size:14.5px;-webkit-font-smoothing:antialiased;}' +
    'h1,h2,h3,h4{letter-spacing:-.01em;}' +
    /* floating white header bar */
    'header.wa-header{background:#FFFAF2;color:var(--wa-ink);max-width:1096px;margin:14px auto 0;border-radius:22px;padding:12px 22px 10px;box-shadow:0 1px 2px rgba(16,63,57,.03),0 12px 32px -22px rgba(16,63,57,.16);}' +
    'header.wa-header .sub{color:var(--wa-muted);opacity:1;}' +
    '.wa-brandrow h1{font-size:17px;font-weight:800;}' +
    '.wa-logo.w31img img{height:40px;}' +
    /* toolbar as a quiet strip of white pills */
    '.wa-toolbar{background:transparent;color:var(--wa-muted);max-width:1120px;margin:0 auto;padding:8px 12px 0;}' +
    '.wa-toolbar .who-btn,.wa-toolbar button{background:#FFFAF2;color:var(--wa-ink);border:1px solid #e6e8e7;border-radius:999px;box-shadow:0 1px 2px rgba(16,63,57,.03);}' +
    '#globalSearch{background:#FFFAF2;border:1px solid #e6e8e7;border-radius:999px;padding:5px 15px;min-width:230px;}' +
    '.search-pop{border-radius:16px;border:none;box-shadow:0 18px 50px -12px rgba(16,63,57,.28);}' +
    /* floating sticky pill nav */
    'nav.wa-nav{position:sticky;top:10px;z-index:60;background:transparent;border-bottom:none;-webkit-backdrop-filter:none;backdrop-filter:none;max-width:1120px;margin:8px auto 4px;padding:0 12px;}' +
    'nav.wa-nav .wa-wrap{background:#FFFAF2;border-radius:26px;padding:6px 8px;gap:1px;box-shadow:0 1px 2px rgba(16,63,57,.04),0 14px 36px -24px rgba(16,63,57,.22);display:flex;flex-wrap:wrap;align-items:center;}' +
    '.tab{padding:8px 14px;border-radius:999px;border-bottom:none;margin:1px;font-weight:600;font-size:13px;color:var(--wa-muted);text-transform:none;letter-spacing:.1px;}' +
    '.tab:hover{background:rgba(16,63,57,.06);color:var(--wa-ink);}' +
    '.tab.active{background:var(--wa-green);color:#FFFAF2;border-bottom:none;box-shadow:0 6px 16px -8px rgba(16,63,57,.55);}' +
    '.tab.active .tabdot{outline:2px solid rgba(255,250,242,.55);}' +
    '@media (max-width:760px){nav.wa-nav .wa-wrap{flex-wrap:nowrap;overflow-x:auto;scrollbar-width:none;}nav.wa-nav .wa-wrap::-webkit-scrollbar{display:none;}.tab{flex:0 0 auto;}}' +
    /* cards float, borders go */
    'main{max-width:1120px;padding:20px 12px 90px;}' +
    '.card{border:none;border-radius:22px;padding:22px 24px;box-shadow:0 1px 2px rgba(16,63,57,.02),0 16px 40px -28px rgba(16,63,57,.2);}' +
    '.card .read{border-left:none;padding-left:0;}' +
    '.whatsnew{border:none;border-radius:22px;box-shadow:0 1px 2px rgba(16,63,57,.02),0 16px 40px -28px rgba(16,63,57,.2);}' +
    '.dept-card,.gl-grid > div{border-radius:18px;}' +
    /* pills and controls */
    '.btn{border-radius:999px;font-weight:600;}' +
    '.btn.ghost{background:#FFFAF2;border:1px solid #e6e8e7;}' +
    'input,select,textarea{background:#f4f6f5;border:1px solid transparent;border-radius:12px;transition:border-color .15s,background .15s;}' +
    'input:focus,select:focus,textarea:focus{background:#FFFAF2;border-color:var(--wa-green-soft);outline:none;}' +
    '.fchip{border-radius:999px;background:#f1f3f2;border:1px solid transparent;}' +
    '.fchip.on{background:var(--wa-green);color:#FFFAF2;}' +
    '.vl-in{background:#f4f6f5;}' +
    /* tables breathe */
    '.wa-tbl thead th{border-bottom:1px solid #eef0ef;}' +
    '.wa-tbl td{border-bottom:1px solid #F4F2EA;}' +
    '.vl-tblwrap{border:none;border-radius:16px;}' +
    /* modals match */
    '.modal{border-radius:22px;box-shadow:0 30px 90px -20px rgba(16,63,57,.45);padding:26px;}' +
    '.modal-back{background:rgba(16,63,57,.35);-webkit-backdrop-filter:blur(3px);backdrop-filter:blur(3px);}' +
    '.gate-card{border-radius:24px;}' +
    /* home stat strip */
    '.w35stats{display:flex;gap:14px;flex-wrap:wrap;margin:0 0 18px;}' +
    '.w35stat{flex:1;min-width:160px;background:#FFFAF2;border-radius:20px;padding:15px 19px;box-shadow:0 1px 2px rgba(16,63,57,.02),0 16px 40px -28px rgba(16,63,57,.2);}' +
    '.w35stat b{display:block;font-size:26px;font-weight:800;color:var(--wa-ink);line-height:1.15;}' +
    '.w35stat span{font-size:12px;color:var(--wa-muted);font-weight:500;}' +
    '.w35stat.acc{background:linear-gradient(135deg,var(--wa-green),var(--wa-green-soft));}' +
    '.w35stat.acc b,.w35stat.acc span{color:#FFFAF2;}';
  document.head.appendChild(st);
})();

/* ---------- the home stat strip ---------- */
async function wa35Stats() {
  var panel = document.getElementById('overview');
  if (!panel || document.getElementById('w35stats')) return;
  function fy() {
    var now = new Date();
    var y = now.getMonth() + 1 >= 10 ? now.getFullYear() : now.getFullYear() - 1;
    return y + '-10-01';
  }
  var today = new Date().toISOString().slice(0, 10);
  try {
    var qs = await Promise.all([
      db.from('dept_tasks').select('id', { count: 'exact', head: true }).eq('done', false),
      db.from('dept_tasks').select('id', { count: 'exact', head: true }).eq('done', true).gte('closed_at', fy()),
      db.from('volunteer_events').select('id', { count: 'exact', head: true }).eq('status', 'planned').gte('event_date', today),
      db.from('volunteer_people').select('id', { count: 'exact', head: true })
    ]);
    var n = qs.map(function (r) { return (r && r.count) || 0; });
    var fyLabel = 'FY' + (Number(fy().slice(0, 4)) + 1);
    var div = document.createElement('div');
    div.className = 'w35stats';
    div.id = 'w35stats';
    div.innerHTML = ''
      + '<div class="w35stat acc"><b>' + n[0] + '</b><span>open tasks across the organization</span></div>'
      + '<div class="w35stat"><b>' + n[1] + '</b><span>finished so far in ' + fyLabel + '</span></div>'
      + '<div class="w35stat"><b>' + n[2] + '</b><span>upcoming serving events planned</span></div>'
      + '<div class="w35stat"><b>' + n[3] + '</b><span>volunteers on file</span></div>';
    panel.insertBefore(div, panel.firstChild);
  } catch (e) { /* non-fatal */ }
}

(function () {
  var __sa35 = startApp;
  startApp = async function () {
    await __sa35();
    try { wa35Stats(); } catch (e) { /* non-fatal */ }
  };
})();
