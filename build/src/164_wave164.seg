/* =====================================================================
   WA v164 Finance on its own (29/09/26)
   =====================================================================
   Steel (29/09/26), on the Finance app's Trends page: "It's a little repetitive here and still shows fundraising and
   finance being togther. these should be seperate". Earlier the same day: "for the Hub Inbox, all finance related
   emails like invoices, receipts, reimbursements should go straight to the finance slack channel not fundraising",
   and "accounting-finance is the private channel" (he added the Hub's Slack app to it).

   Where each change lives (the older waves hold their own pages; this segment draws what is new on the Finance page):
   - The team is Fundraising (001 wave116a, the base, 038, 110, 116, 118, 124, 127, 131, 140, 122's tours): Grants,
     Event fundraising and Donor relations. Finance is not a Fundraising sub-team any more: it has its own key
     ('finance', label Finance, its own gold) with no team page, like the executive team. #team/finance opens the
     Finance app's Tasks.
   - The Finance app (153): its own gold instead of Fundraising's orange; Tasks after the Overview; no group heading
     that repeats the app's name (the HR centre too); on a computer the rail is the menu, so the page's own tab strip
     (and the HR centre's) is hidden, the HR centre's counts moving into the rail; inside any app the crumb is hidden
     (the app bar is the crumb).
   - Requests (123): Finance receives requests (T.inbox: the seven teams plus Finance), reimbursements and purchase
     orders go to Finance (wa164_finance_own), its channel is #accounting-finance, its team inbox card is on the Finance
     Overview (drawn here).
   - The Hub inbox page (116h): money emails are Finance's; Filing to a team offers Finance.
   - The Finance page (22, 24, 93, 94): the Fundraising page no longer links to it; Tasks is a section of its own
     (94); the fold on the Overview lists the money work on other teams' boards, without grants and donors (93); a
     meeting tagged Finance files under Finance.
   - Here: the page's title follows the section (Finance on the Overview, then Tasks, Trends, Money map, Budget,
     Transactions, each with a line saying what it holds), the Tasks section draws the task board for Finance
     (w116Board, department finance), and the Overview shows Finance's team inbox (requests and the emails the Hub
     inbox filed for Finance).
   ===================================================================== */
(function () {
  if (window.__wa164) return; window.__wa164 = true;
  var F = { drawn: 0, board: 0, inbox: 0, titled: '', sec: null };
  /* the time frame does not apply to the task board */
  if (!document.getElementById('wa164css')) { var st = document.createElement('style'); st.id = 'wa164css'; st.textContent = '#finances.w164t #w92pills,#finances.w164t .w92note{display:none !important;}#finances #w164inbox{margin:14px 0 18px;}'; document.head.appendChild(st); }
  function staffOk() { try { return typeof isStaff === 'function' && isStaff(); } catch (e) { return false; } }
  function panel() { return document.getElementById('finances'); }
  function shell(id) { return document.querySelector('#finances .w94sec[data-w94sec="' + id + '"]'); }
  function curSec() {
    var t = document.querySelector('#finances .w94tab.on');
    if (t) return t.getAttribute('data-w94tab');
    try { return window.w94Cur ? window.w94Cur() : 'overview'; } catch (e) { return 'overview'; }
  }

  /* ---------- the title follows the section (the app bar says Finance, the rail says where) ---------- */
  var SECT = {
    overview: ['Overview', 'The year so far: what came in, what went out, how healthy the numbers are, and the finance work in flight.'],
    tasks: ['Tasks', 'Finance\u2019s own board: bills to pay, receipts to file, reimbursements to approve. Invoices and receipts sent to hub@ land here, and #accounting-finance hears about each one.'],
    trends: ['Trends', 'Income against spending month by month, the net position over the year, and each fiscal year side by side.'],
    money: ['Money map', 'Where the money comes from and where it goes: by category, by merchant and by team.'],
    budget: ['Budget', 'Each line of the budget against what was actually spent.'],
    txns: ['Transactions', 'Every transaction in the ledger, the ones waiting for a review, and the imported statements.']
  };
  function retitle(id) {
    var m = document.querySelector('#finances > .w118mast'); if (!m) return;
    var t = SECT[id] || SECT.overview;
    var h = m.querySelector('h1'), p = m.querySelector(':scope > p');
    if (h && h.textContent !== t[0]) h.textContent = t[0];
    if (p && p.textContent !== t[1]) p.textContent = t[1];
    F.titled = id;
    try { if (panel() && panel().classList.contains('active')) document.title = (id === 'overview' ? 'Finance' : t[0] + ' \u00b7 Finance') + ' \u00b7 Welfare Avenue Hub'; } catch (e) { /* fine */ }
  }

  /* ---------- Tasks: Finance's own board (department finance) ---------- */
  function drawTasks() {
    var sec = shell('tasks'); if (!sec) return;
    var slot = sec.querySelector(':scope > #w164board');
    if (!slot) { slot = document.createElement('div'); slot.id = 'w164board'; sec.appendChild(slot); }
    if (!staffOk()) { slot.innerHTML = '<p class="w116empty">Finance\u2019s tasks are for the team.</p>'; return; }
    if (!window.w116Board || !window.w116Board.render) { slot.innerHTML = '<p class="w116empty">The task board is loading\u2026</p>'; return; }
    try { window.w116Board.render(slot, { dept: 'finance', board: null, ws: null }); F.board++; }
    catch (e) { slot.innerHTML = '<p class="w116empty">The board did not load. Refresh the page to try again.</p>'; }
  }

  /* ---------- the Overview: Finance's team inbox (requests to Finance, emails the Hub inbox filed for Finance) ---------- */
  var inboxBusy = false;
  function drawInbox(force) {
    var ov = shell('overview'), W = window.w123;
    if (!ov || !W || !W.cardHtml || !staffOk()) return;
    var cur = document.getElementById('w164inbox');
    var ver = (W.ver ? W.ver() : 0) + '|' + (W.loaded && W.loaded() ? 1 : 0);
    if (cur && !force && ov.contains(cur) && cur.getAttribute('data-w164v') === ver) return;
    if (inboxBusy) return;
    inboxBusy = true;
    try {
      var html = String(W.cardHtml('finance') || '').replace('id="w123tcard"', 'id="w164inbox" data-w164v="' + ver + '"');
      if (cur) cur.remove();
      var kp = ov.querySelector(':scope > .fin-kpis');
      if (kp) kp.insertAdjacentHTML('afterend', html); else ov.insertAdjacentHTML('afterbegin', html);
      F.inbox++;
    } finally { inboxBusy = false; }
    if (W.loaded && !W.loaded() && W.load && !F.loading) {
      F.loading = true;
      Promise.resolve(W.load()).then(function () { F.loading = false; drawInbox(true); }, function () { F.loading = false; });
    }
  }

  /* ---------- one pass over the page ---------- */
  function sync(id) {
    var p = panel(); if (!p) return;
    id = id || curSec();
    p.classList.toggle('w164t', id === 'tasks');
    retitle(id);
    if (id === 'tasks') drawTasks();
    if (id === 'overview' || !document.getElementById('w164inbox')) drawInbox(false);
    F.sec = id; F.drawn++;
  }

  /* ---------- wiring ---------- */
  document.addEventListener('wa94show', function (ev) { try { sync(ev && ev.detail && ev.detail.id); } catch (e) { /* fine */ } });
  /* the Finance page redraws itself when its data changes (wave22's waFinRender, wrapped by 90 to 94): draw again after it */
  if (typeof waFinRender === 'function') {
    var __fr164 = waFinRender;
    waFinRender = function () {
      var r = __fr164.apply(this, arguments);
      try { setTimeout(function () { watch(); sync(); }, 0); } catch (e) { /* fine */ }
      return r;
    };
  }
  if (typeof showPanel === 'function') {
    var __sp164 = showPanel;
    showPanel = function (id) {
      var r = __sp164.apply(this, arguments);
      try { if (id === 'finances') setTimeout(function () { sync(); }, 30); } catch (e) { /* fine */ }
      return r;
    };
  }
  /* wave118 puts the masthead back with its default words when the page is drawn again, and copies wave85's line into it:
     keep the section's title and line (the masthead itself is watched; a new masthead is picked up from the page) */
  function check() {
    var m = document.querySelector('#finances > .w118mast'); if (!m) return;
    var h = m.querySelector('h1'), q = m.querySelector(':scope > p'), id = curSec(), t = SECT[id] || SECT.overview;
    if ((h && h.textContent !== t[0]) || (q && q.textContent !== t[1])) retitle(id);
  }
  function watchMast() {
    var m = document.querySelector('#finances > .w118mast'); if (!m || m.__w164obs) return;
    m.__w164obs = true;
    try { new MutationObserver(function () { check(); }).observe(m, { childList: true, subtree: true, characterData: true }); } catch (e) { /* fine */ }
  }
  function watch() {
    var p = panel(); if (!p) return;
    watchMast();
    if (p.__w164obs) return;
    p.__w164obs = true;
    try { new MutationObserver(function () { watchMast(); check(); }).observe(p, { childList: true }); } catch (e) { /* fine */ }
  }
  if (typeof startApp === 'function') {
    var __sa164 = startApp;
    startApp = async function () {
      var r = await __sa164.apply(this, arguments);
      try { watch(); if (panel() && panel().classList.contains('active')) sync(); } catch (e) { /* fine */ }
      return r;
    };
  }

  /* ---------- test hook ---------- */
  window.w164 = { state: function () { return F; }, sync: sync, retitle: retitle, tasks: drawTasks, inbox: drawInbox, sect: SECT };
})();
