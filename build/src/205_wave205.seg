      + '.w205glance tr{border-top:1px solid rgba(16,63,57,.1);padding:8px 0;}'
      + '.w205glance td{border:0;padding:3px 14px;}'
      + '.w205glance td[data-l]:before{content:attr(data-l) ": ";font-size:11px;font-weight:700;color:' + MUTED + ';text-transform:uppercase;letter-spacing:.8px;}'
      + '.w205mast .w205pres{margin-left:0;width:100%;}'
      + '.w205ghd .side{gap:6px;}'
      + '.w205rm{opacity:1;}'
      + '#w205drawer{width:100vw;}'
      + '}';
    document.head.appendChild(css);
  }

  /* ---------- loading ---------- */
  function q(p) { return Promise.resolve(p).then(function (r) { return r || { data: null }; }, function (e) { return { data: null, error: e }; }); }
  function isActiveOrg(g) { return g && g.department === 'org' && !g.retired_at && g.number != null; }
  function loadAll(force) {
    if (S.loading && !force) return S.loading;
    if (S.loaded && !force) return Promise.resolve();
    if (typeof db === 'undefined' || !db) return Promise.resolve();
    S.loading = Promise.all([
      q(db.from('goals').select('*').order('number', { ascending: true })),
      q(db.from('goal_owners').select('*').order('sort')),
      q(db.from('goal_milestones').select('*').order('sort')),
      q(db.from('goal_paths').select('*').order('sort')),
      q(db.from('projects').select('id,name,department,status,goal_id,milestone_id,checkpoint_id,leads,parent_id,workstream,banked_at').order('sort')),
      q(db.from('strategy_plan').select('*')),
      q(db.from('strategy_docs').select('*').order('sort')),
      q(db.from('goal_comments').select('*').order('created_at', { ascending: true })),
      q(db.from('goal_wins').select('id,goal_id')),
      q(db.from('charitable_activities').select('*').order('sort')),
      q(db.from('goal_activities').select('*').order('sort')),
      q(db.from('goal_year_targets').select('*').order('sort')),
      q(db.from('goal_checkpoints').select('*').order('quarter'))
    ]).then(function (r) {
      var all = (r[0].data || []);
      S.err = r[0].error ? (r[0].error.message || String(r[0].error)) : null;
      S.goals = all.filter(isActiveOrg).sort(function (a, b) { return (a.number || 99) - (b.number || 99); });
      S.retired = all.filter(function (g) { return !!g.retired_at; });
      S.allGoals = all;
      S.owners = (r[1].data || []).filter(function (o) { return !o.removed_at; });
      S.milestones = (r[2].data || []).filter(function (m) { return !m.archived_at; });
      S.paths = (r[3].data || []).filter(function (p) { return !p.archived_at; });
      S.projects = (r[4].data || []).filter(function (p) { return !p.banked_at; });
      S.plan = {}; (r[5].data || []).forEach(function (x) { S.plan[x.key] = x.value; });
      S.docs = (r[6].data || []).filter(function (d) { return !d.archived_at; });
      S.comments = r[7].data || [];
      S.wins = {}; (r[8].data || []).forEach(function (w) { S.wins[w.goal_id] = (S.wins[w.goal_id] || 0) + 1; });
      S.acts = r[9].data || []; S.gacts = (r[10].data || []).filter(function (a) { return !a.archived_at; });
      S.targets = (r[11].data || []).filter(function (t) { return !t.archived_at; }); S.checkpoints = (r[12].data || []).filter(function (c) { return !c.archived_at; });
      S.goals.forEach(baseGoal); S.milestones.forEach(function (m) { baseRow('milestone', m, ['body', 'status', 'fy']); }); S.paths.forEach(function (p) { baseRow('path', p, ['body']); });
      ['activity', 'target', 'checkpoint'].forEach(function (e) { ENTS[e].list().forEach(function (row) { baseRow(e, row, ENTS[e].fields); }); });
      S.loaded = Date.now(); S.loading = null;
    });
    return S.loading;
  }
  var GOAL_FIELDS = ['title', 'detail', 'why', 'measure', 'baseline', 'target_fy29', 'target_fy31', 'status', 'due_date', 'activities_note'];
  /* every kind of row the page edits: its list in S and the fields autosave sends (wave207 adds activity, target, checkpoint) */
  var ENTS = {
    goal: { list: function () { return S.goals; }, fields: GOAL_FIELDS },
    milestone: { list: function () { return S.milestones; }, fields: ['body', 'status', 'fy'] },
    path: { list: function () { return S.paths; }, fields: ['body'] },
    activity: { list: function () { return S.gacts; }, fields: ['reason'] },
    target: { list: function () { return S.targets; }, fields: ['body', 'owners'] },
    checkpoint: { list: function () { return S.checkpoints; }, fields: ['body', 'status', 'due_date'] }
  };
  function key(e, id, f) { return e + ':' + id + ':' + f; }
  function baseGoal(g) { baseRow('goal', g, GOAL_FIELDS); }
  function baseRow(e, row, fields) { fields.forEach(function (f) { var k = key(e, row.id, f); if (!S.dirty[k]) S.base[k] = str(row[f]); }); }
  function goalOf(e, id) {
    if (e === 'goal') return byId(S.goals, id);
    var row = rowOf(e, id);
    return row ? byId(S.goals, row.goal_id) : null;
  }
  function rowOf(e, id) { return ENTS[e] ? byId(ENTS[e].list(), id) : null; }
  function msOf(gid) { return S.milestones.filter(function (m) { return String(m.goal_id) === String(gid); }).sort(function (a, b) { return (a.fy < b.fy ? -1 : a.fy > b.fy ? 1 : 0) || (a.sort - b.sort) || (a.id - b.id); }); }
  function pathsOf(gid) { return S.paths.filter(function (p) { return String(p.goal_id) === String(gid); }).sort(function (a, b) { return (a.sort - b.sort) || (a.id - b.id); }); }
  function ownersOf(gid) { return S.owners.filter(function (o) { return String(o.goal_id) === String(gid); }).sort(function (a, b) { return (b.is_lead ? 1 : 0) - (a.is_lead ? 1 : 0) || (a.sort - b.sort); }); }
  function projOf(gid) { return S.projects.filter(function (p) { return String(p.goal_id) === String(gid); }); }
  function commentsOf(gid, mid) { return S.comments.filter(function (c) { return String(c.goal_id) === String(gid) && (mid === undefined || String(c.milestone_id || '') === String(mid || '')); }); }
  function progress(gid) {
    var ms = msOf(gid).filter(function (m) { return m.fy !== 'FY30' && m.fy !== 'FY31'; });
    var done = ms.filter(function (m) { return m.status === 'done'; }).length;
    var y = currentFy(), yr = ms.filter(function (m) { return m.fy === y; }), yd = yr.filter(function (m) { return m.status === 'done'; }).length;
    return { total: ms.length, done: done, pct: ms.length ? Math.round(done / ms.length * 100) : 0, fy: y, yTotal: yr.length, yDone: yd };
  }
  function currentFy() { var d = new Date(), y = d.getFullYear() + (d.getMonth() >= 9 ? 1 : 0); return 'FY' + String(y).slice(2); }   /* the fiscal year starts October 1 */
  function rpc(fn, args) {
    return Promise.resolve(db.rpc(fn, args)).then(function (r) {
      if (r && r.error) throw new Error(r.error.message || String(r.error));
      return r ? r.data : null;
    });
  }
  function errText(e) { var m = String((e && e.message) || e || 'Something went wrong'); return m.replace(/^Error:\s*/, ''); }

  /* ---------- autosave: one field at a time, debounced, with the per-field check ---------- */
  function fieldEl(k) { return document.querySelector('#w205 [data-w205k="' + k + '"]') || document.querySelector('#w205drawer [data-w205k="' + k + '"]'); }
  function parseKey(k) { var p = k.split(':'); return { e: p[0], id: p[1], f: p.slice(2).join(':') }; }
  function schedule(k, ms) {
    clearTimeout(S.timers[k]);
    S.timers[k] = setTimeout(function () { save(k); }, ms == null ? SAVE_MS : ms);
    savedState(k);
  }
  function flushAll() { Object.keys(S.timers).forEach(function (k) { if (S.dirty[k]) { clearTimeout(S.timers[k]); save(k); } }); }
  function save(k) {
    var el = fieldEl(k), P = parseKey(k);
    if (!el) { delete S.dirty[k]; return Promise.resolve(); }
    if (S.conflict[k]) return Promise.resolve();   /* waits for the person to choose */
    if (S.inflight[k]) { S.inflight[k].again = true; return S.inflight[k].p; }
    var val = el.value, old = S.base[k] == null ? '' : S.base[k];
    if (val === old) { delete S.dirty[k]; savedState(k); return Promise.resolve(); }
    var rec = { again: false };
    rec.p = rpc('strategy_save', { p_entity: P.e, p_id: Number(P.id), p_field: P.f, p_value: val, p_old: old }).then(function (res) {
      delete S.inflight[k];
      if (res && res.conflict) {
        S.conflict[k] = { current: str(res.current), by: res.by || nameOf(res.by_email) || 'Someone', at: res.at, mine: val };
        S.base[k] = str(res.current);
        paintConflict(k); savedState(k);
        return;
      }
      if (!res || res.ok === false) throw new Error((res && res.error) || 'Not saved');
      S.base[k] = val; delete S.errors[k];
      var row = rowOf(P.e, P.id); if (row) { row[P.f] = P.f === 'due_date' ? (val || null) : val; row.updated_by = myEmail(); }
      S.savedAt[goalKey(P)] = Date.now();
      var cur = fieldEl(k);
      if (cur && cur.value === val) delete S.dirty[k];
      savedState(k);
      afterSave(P);
      if (rec.again || (cur && cur.value !== val)) schedule(k, 250);
    }).catch(function (e) {
      delete S.inflight[k];
      S.errors[k] = errText(e);
      savedState(k);
      paintFieldError(k);
    });
    S.inflight[k] = rec;
    savedState(k);
    return rec.p;
  }
  function goalKey(P) { var g = goalOf(P.e, P.id); return g ? String(g.id) : ''; }
  function savedState(k) {
    var P = parseKey(k), gid = goalKey(P); if (!gid) return;
    var box = document.querySelector('#w205 [data-w205saved="' + gid + '"]'); if (!box) return;
    var keys = Object.keys(S.dirty).filter(function (x) { return goalKey(parseKey(x)) === gid; });
    var busy = Object.keys(S.inflight).some(function (x) { return goalKey(parseKey(x)) === gid; });
    var errs = Object.keys(S.errors).filter(function (x) { return goalKey(parseKey(x)) === gid; });
    var conf = Object.keys(S.conflict).some(function (x) { return goalKey(parseKey(x)) === gid; });
    box.className = 'w205saved' + (errs.length ? ' err' : busy || keys.length ? ' busy' : '');
    box.textContent = errs.length ? 'Not saved' : conf ? 'Check the note' : busy ? 'Saving\u2026' : keys.length ? 'Editing\u2026' : (S.savedAt[gid] ? 'Saved' : '');
    if (!errs.length && !busy && !keys.length && S.savedAt[gid]) box.title = 'Saved ' + fmtWhen(S.savedAt[gid]); else box.removeAttribute('title');
  }
  function paintFieldError(k) {
    var el = fieldEl(k); if (!el) return;
    var host = el.parentNode, old = host.querySelector('.w205err[data-for="' + k + '"]'); if (old) old.remove();
    if (S.errors[k]) { var d = document.createElement('div'); d.className = 'w205err'; d.setAttribute('data-for', k); d.setAttribute('role', 'alert'); d.textContent = 'Not saved: ' + S.errors[k]; el.insertAdjacentElement('afterend', d); }
  }
  /* "Ian just changed this": their words and yours, side by side; nothing is lost either way */
  function paintConflict(k) {
    var el = fieldEl(k); if (!el) return;
    var host = el.parentNode, old = host.querySelector('.w205conf[data-for="' + k + '"]'); if (old) old.remove();
    var c = S.conflict[k]; if (!c) return;
    var d = document.createElement('div'); d.className = 'w205conf'; d.setAttribute('data-for', k); d.setAttribute('role', 'status');
    d.innerHTML = '<b>' + E(c.by) + ' just changed this.</b> ' + (c.current ? 'Their version:' : 'They cleared it.') +
      (c.current ? '<span class="theirs" data-w198skip>' + E(c.current) + '</span>' : '') +
      '<div class="acts"><button type="button" class="w205btn sm pri" data-w205keep="' + E(k) + '">Keep mine</button>' +
      '<button type="button" class="w205btn sm" data-w205theirs="' + E(k) + '">Use theirs</button>' +
      '<small style="color:' + MUTED + ';align-self:center">Your words stay in the box until you choose.</small></div>';
    el.insertAdjacentElement('afterend', d);
  }
  function resolveConflict(k, keepMine) {
    var c = S.conflict[k]; if (!c) return;
    delete S.conflict[k];
    var el = fieldEl(k);
    var note = document.querySelector('#w205 .w205conf[data-for="' + k + '"]'); if (note) note.remove();
    if (keepMine) { S.dirty[k] = true; save(k); }
    else { if (el) { el.value = c.current; grow(el); } S.base[k] = c.current; delete S.dirty[k]; var P = parseKey(k), row = rowOf(P.e, P.id); if (row) row[P.f] = c.current; savedState(k); afterSave(P); }
  }
  /* the at-a-glance table and the progress bar follow the fields */
  function afterSave(P) {
    try {
      var g = goalOf(P.e, P.id); if (!g) return;
      if (P.e === 'goal' && ['title', 'measure', 'baseline', 'target_fy29', 'target_fy31'].indexOf(P.f) >= 0) paintGlance();
      if (P.e === 'milestone' && P.f === 'status') { paintProgress(g.id); var ms = byId(S.milestones, P.id), box = document.querySelector('#w205 [data-w205ms="' + P.id + '"]'); if (box && ms) box.classList.toggle('done', ms.status === 'done'); paintGlance(); }
      if (P.e === 'goal' && P.f === 'status') { var sel = fieldEl(key('goal', g.id, 'status')); if (sel) sel.className = 'w205stsel s-' + stKey(g.status); }
      if (P.e === 'milestone' && P.f === 'fy') repaintGoal(g.id, true);
      if (P.e === 'checkpoint' || P.e === 'target') { afterYearSave(P); paintYear(); }
      if (P.e === 'activity') { paintActs(g.id); paintCoverage(); paintGlance(); }
    } catch (e) { /* cosmetic */ }
  }
  function stKey(s) { return String(s || 'not started').replace(/ (\w)/g, function (m, c) { return c.toUpperCase(); }).replace(/[^A-Za-z]/g, ''); }
  function grow(el) { if (!el || el.tagName !== 'TEXTAREA') return; el.style.height = 'auto'; el.style.height = (el.scrollHeight + 2) + 'px'; }

  /* ---------- live: other people's saves and who is here ---------- */
  function onRemoteRow(e, row, kind) {
    var fields = ENTS[e].fields;
    var by = nameOf(row.updated_by);
    var mine = lower(row.updated_by) === myEmail();
    var list = ENTS[e].list();
    var cur = byId(list, row.id);
    if (e === 'goal') {
      if (!isActiveOrg(row)) { if (cur || row.retired_at) { S.loaded = 0; loadAll(true).then(paintSoon); } return; }
      if (!cur) { S.loaded = 0; loadAll(true).then(paintSoon); return; }
      ['approval', 'approved_at', 'owner', 'number'].forEach(function (f) { cur[f] = row[f]; });
    }
    if (e !== 'goal' && (row.archived_at || !cur)) {
      if (row.archived_at) { var i = list.indexOf(cur); if (i >= 0) list.splice(i, 1); }
      else list.push(row);
      if (row.archived_at || !cur) { baseRow(e, row, fields); repaintGoal(row.goal_id, true); if (e === 'activity') { paintActs(row.goal_id); paintCoverage(); paintGlance(); } if (e === 'target' || e === 'checkpoint') paintYear(); if (S.drawer && S.drawer.kind === 'acts') paintDrawer(); return; }
    }
    fields.forEach(function (f) {
      var k = key(e, row.id, f), v = str(row[f]);
      if (v === str(S.base[k])) { if (cur) cur[f] = row[f]; return; }   /* our own save coming back */
      var el = fieldEl(k);
      var busy = el && (document.activeElement === el || S.dirty[k] || S.inflight[k]) && el.value !== v;
      if (busy && !mine) {
        /* they are typing here: keep their words, show the other person's */
        S.conflict[k] = { current: v, by: by, at: row.updated_at, mine: el.value };
        S.base[k] = v; paintConflict(k); savedState(k);
      } else {
        S.base[k] = v; if (cur) cur[f] = row[f];
        if (el && el.value !== v) { el.value = v; grow(el); if (!mine) { el.classList.remove('flash'); void el.offsetWidth; el.classList.add('flash'); el.title = 'Changed by ' + by + ' ' + fmtWhen(row.updated_at); } }
        afterSave({ e: e, id: row.id, f: f });
      }
      if (cur) cur[f] = row[f];
    });
  }
  function onRemote(table, payload) {
    var row = payload.new || {}, ev = payload.eventType;
    if (!row || !row.id) return;
    if (table === 'goals') onRemoteRow('goal', row, ev);
    else if (table === 'goal_milestones') onRemoteRow('milestone', row, ev);
    else if (table === 'goal_paths') onRemoteRow('path', row, ev);
    else if (table === 'goal_activities') onRemoteRow('activity', row, ev);
    else if (table === 'goal_year_targets') onRemoteRow('target', row, ev);
    else if (table === 'goal_checkpoints') onRemoteRow('checkpoint', row, ev);
    else if (table === 'goal_owners') {
      var o = byId(S.owners, row.id);
      if (row.removed_at) { if (o) S.owners.splice(S.owners.indexOf(o), 1); }
      else if (o) Object.assign(o, row); else S.owners.push(row);
      paintOwners(row.goal_id);
    } else if (table === 'goal_comments') {
      var c = byId(S.comments, row.id); if (c) Object.assign(c, row); else S.comments.push(row);
      paintCounts(row.goal_id); paintYear();
      if (S.drawer && S.drawer.kind === 'comments' && String(S.drawer.goal) === String(row.goal_id)) paintDrawer();
    } else if (table === 'projects') {
      var p = byId(S.projects, row.id);
      if (row.banked_at) { if (p) S.projects.splice(S.projects.indexOf(p), 1); }
      else if (p) Object.assign(p, row); else S.projects.push(row);
      S.goals.forEach(function (g) { paintProjects(g.id); });
      paintUnlinked(); paintYear();
      if (S.drawer && S.drawer.kind === 'link') paintDrawer();
    }
  }
  var paintT = null;
  function paintSoon() { clearTimeout(paintT); paintT = setTimeout(function () { if (onPage()) paint(); }, 60); }

  /* presence travels on a Realtime channel anyone holding the page's public key could listen to: it carries the roster id and
     the first name only (as the public website does), never an email; who you are comes from the roster on each side */
  var TAB = 't' + Math.random().toString(36).slice(2, 10);
  function myKey() { var m = me(); return m.id ? 'm' + m.id : TAB; }
  function presenceMeta() {
    var m = me();
    return { mid: m.id || null, name: String(m.name || '').split(' ')[0], goal: S.focus.goal, field: S.focus.field, view: S.view, at: Date.now() };
  }
  function track() { try { if (S.channel && S.live) S.channel.track(presenceMeta()); } catch (e) { /* fine */ } }
  var trackT = null;
  function trackSoon() { clearTimeout(trackT); trackT = setTimeout(track, 250); }
  function readPresence() {
    var st = {}; try { st = S.channel && S.channel.presenceState ? S.channel.presenceState() : {}; } catch (e) { st = {}; }
    var seen = {}, out = [], mine = me().id;
    Object.keys(st || {}).forEach(function (k) {
      (st[k] || []).forEach(function (m) {
        var id = m.mid ? 'm' + m.mid : k; if (!id || k === TAB || (mine && String(m.mid) === String(mine))) return;
        if (!seen[id] || (m.at || 0) > (seen[id].at || 0)) seen[id] = m;
      });
    });
    Object.keys(seen).forEach(function (id) { out.push(seen[id]); });
    out.sort(function (a, b) { return String(a.name).localeCompare(String(b.name)); });
    S.presence = out;
    paintPresence();
  }
  function goLive() {
    if (S.channel || typeof db === 'undefined' || !db || typeof db.channel !== 'function') return;
    try {
      var ch = db.channel('wa205-strategy', { config: { presence: { key: myKey() } } });
      ['goals', 'goal_milestones', 'goal_paths', 'goal_owners', 'goal_comments', 'projects', 'goal_activities', 'goal_year_targets', 'goal_checkpoints'].forEach(function (t) {
        var opt = { event: '*', schema: 'public', table: t };
        if (t === 'goals') opt.filter = 'department=eq.org';
        ch.on('postgres_changes', opt, function (payload) { try { onRemote(t, payload); } catch (e) { console.warn('wave205 live', e); } });
      });
      ch.on('presence', { event: 'sync' }, readPresence);
      ch.on('presence', { event: 'join' }, readPresence);
      ch.on('presence', { event: 'leave' }, readPresence);
      S.channel = ch;
      ch.subscribe(function (status) {
        S.live = status === 'SUBSCRIBED';
        if (S.live) track();
        paintPresence();
      });
    } catch (e) { console.warn('wave205 realtime', e); S.channel = null; }
  }
  function goQuiet() {
    var ch = S.channel; if (!ch) return;
    S.channel = null; S.live = false; S.presence = [];
    try { if (ch.untrack) ch.untrack(); } catch (e) { /* fine */ }
    try { if (db.removeChannel) db.removeChannel(ch); else if (ch.unsubscribe) ch.unsubscribe(); } catch (e) { /* fine */ }
  }

  /* ---------- the page ---------- */
  function deptLabel(d) { try { return (typeof DEPT_LABEL !== 'undefined' && DEPT_LABEL[d]) || (window.WA_TEAMS && WA_TEAMS.labels && WA_TEAMS.labels[d]) || d || 'Other'; } catch (e) { return d || 'Other'; } }
  function deptColor(d) { try { return (typeof DEPT_COLOR !== 'undefined' && DEPT_COLOR[d]) || MUTED; } catch (e) { return MUTED; } }
  function av(p, size) { try { return window.w116Avatar ? window.w116Avatar(p, size) : ''; } catch (e) { return ''; } }
  function onPage() { var a = document.querySelector('.panel.active'); return !!(a && a.id === 'orggoals'); }
  function host() {
    var sec = document.getElementById('orggoals'); if (!sec) return null;
    var h = document.getElementById('w205');
    if (!h) { h = document.createElement('div'); h.id = 'w205'; sec.appendChild(h); }
    return h;
  }
  function approvalLabel() { var a = S.plan.approval || {}; return a.label || 'Draft for board approval (19 Oct 2026)'; }
  function approved() { return S.goals.length && S.goals.every(function (g) { return g.approval === 'approved'; }); }

  function mastHtml(title, line) {
    return '<header class="w205mast"><div><div class="crumb">' + (boardMode() ? 'Board' : 'Strategy') + '</div><h1>' + E(title) + '</h1>' + (line ? '<p>' + E(line) + '</p>' : '') + '</div><span class="sp"></span>' +
      '<div class="w205pres" data-w205pres></div></header>';
  }
  /* a field you click and type in; it saves itself (the database checks who may) */
  function ed(e, row, f, o) {
    o = o || {};
    var g = e === 'goal' ? row : byId(S.goals, row.goal_id);
    var k = key(e, row.id, f), can = canEdit(g), v = str(row[f]);
    var ph = can ? (o.ph || 'Click to write') : (o.empty || 'Not written yet');
    return '<textarea class="w205ed' + (o.cls ? ' ' + o.cls : '') + '" rows="1" data-w205k="' + E(k) + '" aria-label="' + E(o.label || f) + '" placeholder="' + E(ph) + '"' + (can ? '' : ' readonly tabindex="-1"') + ' data-w198skip spellcheck="true">' + E(v) + '</textarea>';
  }
  function stSel(e, row, f, list) {
    var g = e === 'goal' ? row : byId(S.goals, row.goal_id), can = canEdit(g), v = row[f] || list[0];
    var cls = e === 'goal' ? 'w205stsel' : 'w205dot';
    return '<select class="' + cls + ' s-' + stKey(v) + '" data-w205k="' + E(key(e, row.id, f)) + '" aria-label="' + (e === 'goal' ? 'Goal status' : 'Milestone status') + '" title="' + E(ST_LABEL[v] || v) + '"' + (can ? '' : ' disabled') + '>' +
      list.map(function (s) { return '<option value="' + E(s) + '"' + (s === v ? ' selected' : '') + '>' + E(ST_LABEL[s] || s) + '</option>'; }).join('') + '</select>';
  }
  function heroHtml() {
    var p = S.plan;
    return '<section class="w205hero" aria-label="Our mission"><div class="lab">Our mission</div><blockquote data-w198skip>' + E(p.mission || '') + '</blockquote><div class="bar"></div>' +
      '<p>' + E(p.mission_note || '') + (p.window ? ' ' + E(p.window) : '') + '</p></section>';
  }
  function statusHtml() {
    var ok = approved(), a = S.goals[0] || {};
    return '<div class="w205status">' +
      (ok ? '<span class="w205badge ok">' + I('check') + ' Approved by the board' + (a.approved_at ? ' \u00b7 ' + E(fmtDay(a.approved_at)) : '') + '</span>'
          : '<span class="w205badge draft">' + I('flag') + ' ' + E(approvalLabel()) + '</span><span class="note">The board votes on these goals on Oct 19, 2026.</span>') +
      (isAdmin() && S.goals.length ? '<button type="button" class="w205btn sm" data-w205approve="' + (ok ? 'draft' : 'approved') + '">' + (ok ? 'Back to draft' : 'Mark approved by the board') + '</button>' : '') +
      '</div>' +
      (canComment() && S.goals.some(function (g) { return canEdit(g); }) ? '' : '<div class="w205ro" role="note">' + E(readOnlyWhy()) + '</div>');
  }
  function whyHtml() {
    var p = S.plan; if (!p.why_reset) return '';
    return '<details class="w205why" style="margin:0 0 6px"><summary class="w205link" style="list-style:none;display:inline-block">Why these goals</summary>' +
      '<div style="background:#FFFAF2;border:1px solid rgba(16,63,57,.1);border-radius:14px;padding:14px 16px;margin-top:8px;font-size:14px;line-height:1.55">' +
      '<p style="margin:0 0 8px">' + E(p.why_reset) + '</p>' + (p.long_range ? '<p style="margin:0 0 8px">' + E(p.long_range) + '</p>' : '') +
      (p.rule ? '<p style="margin:0"><b>Rule for every goal:</b> ' + E(p.rule) + '</p>' : '') + '</div></details>';
  }
  function ownerNames(gid) { return ownersOf(gid).map(function (o) { var m = memberById(o.member_id); return (m ? m.name : '?') + (o.is_lead ? ' (lead)' : ''); }).join(', '); }
  function glanceHtml() {
    if (!S.goals.length) return '';
    return '<div class="w205sec"><h2>The goals at a glance</h2><span class="hint">FY29 is the 3-year target; FY31 applies only if the FY29 gate is met.</span></div>' +
      '<div class="w205glance" data-w205glance><table><thead><tr><th>Goal</th><th>Headline measure</th><th>Baseline</th><th>FY29 (3-year)</th><th>FY31 (5-year, gated)</th><th>Owners</th><th>Charitable activities</th><th>Milestones</th></tr></thead><tbody>' +
      S.goals.map(function (g) {
        var pr = progress(g.id);
        return '<tr data-w205jump="' + g.id + '" tabindex="0" role="link" aria-label="Open goal ' + E(g.number) + '">' +
          '<td><span style="display:flex;gap:10px;align-items:center"><span class="w205num">' + E(g.number) + '</span><b data-w198skip>' + E(g.title) + '</b></span></td>' +
          '<td data-l="Measure" data-w198skip>' + E(g.measure) + '</td><td data-l="Baseline" data-w198skip>' + E(g.baseline) + '</td>' +
          '<td data-l="FY29" class="t29" data-w198skip>' + E(g.target_fy29) + '</td><td data-l="FY31" class="g31" data-w198skip>' + E(g.target_fy31) + '</td>' +
          '<td data-l="Owners" data-w198skip>' + E(ownerNames(g.id)) + '</td><td data-l="Activities">' + actsMini(g.id) + '</td><td data-l="Milestones">' + pr.done + ' of ' + pr.total + ' done</td></tr>';
      }).join('') + '</tbody></table></div>';
  }
  function paintGlance() { var el = document.querySelector('#w205 [data-w205glance]'); if (!el) return; var tmp = document.createElement('div'); tmp.innerHTML = glanceHtml(); var n = tmp.querySelector('[data-w205glance]'); if (n) el.innerHTML = n.innerHTML; }

  function ownersHtml(g) {
    var can = canEdit(g);
    return ownersOf(g.id).map(function (o) {
      var m = memberById(o.member_id) || { name: 'Someone' };
      var inner = av(m, 24) + '<span data-w198skip>' + E(m.name) + '</span>' + (o.is_lead ? '<span class="lead">Lead</span>' : '') + (o.focus ? '<span class="focus" data-w198skip>' + E(o.focus) + '</span>' : '');
      return can ? '<button type="button" class="w205chip" data-w205owner="' + g.id + ':' + o.member_id + '" aria-label="' + E(m.name) + ': owner options">' + inner + '</button>' : '<span class="w205chip">' + inner + '</span>';
    }).join('') + (can ? '<button type="button" class="w205chip add" data-w205addowner="' + g.id + '">' + I('plus') + ' Owner</button>' : '') +
      (ownersOf(g.id).length ? '' : '<span style="font-size:12.5px;color:' + MUTED + '">No owner yet.</span>');
  }
  function paintOwners(gid) { var el = document.querySelector('#w205 [data-w205owners="' + gid + '"]'); var g = byId(S.goals, gid); if (el && g) el.innerHTML = ownersHtml(g); paintGlance(); }
  function progHtml(g) {
    var pr = progress(g.id);
    return '<div class="trk" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="' + pr.pct + '" aria-label="Milestones done, FY27 to FY29"><i style="width:' + pr.pct + '%"></i></div>' +
      '<span><b style="color:' + GREEN + '">' + pr.done + ' of ' + pr.total + '</b> milestones done, FY27 to FY29' + (pr.yTotal ? ' \u00b7 ' + E(pr.fy) + ': ' + pr.yDone + ' of ' + pr.yTotal : '') + '</span>';
  }
  function paintProgress(gid) { var el = document.querySelector('#w205 [data-w205prog="' + gid + '"]'); var g = byId(S.goals, gid); if (el && g) el.innerHTML = progHtml(g); }
  function projChip(p) {
    return '<button type="button" class="w205pj" data-w205proj="' + p.id + '" title="' + E(deptLabel(p.department)) + ': ' + E(p.name) + '"><i class="d" style="background:' + E(deptColor(p.department)) + '"></i><span data-w198skip>' + E(p.name) + '</span></button>';
  }
  function cntBtn(gid, mid) {
    var n = commentsOf(gid, mid == null ? undefined : mid).length;
    if (mid == null) n = commentsOf(gid).length;
    return '<button type="button" class="w205cnt' + (n ? ' has' : '') + '" data-w205cmts="' + gid + (mid != null ? ':' + mid : '') + '" aria-label="' + (mid != null ? 'Comments on this milestone' : 'Comments on this goal') + ' (' + n + ')">' + I('chat') + (n ? n : '') + '</button>';
  }
  function msHtml(m, g) {
    var can = canEdit(g), ps = S.projects.filter(function (p) { return String(p.milestone_id) === String(m.id); });
    return '<div class="w205ms' + (m.status === 'done' ? ' done' : '') + '" data-w205ms="' + m.id + '"><div class="row">' + stSel('milestone', m, 'status', MS_ST) +
      ed('milestone', m, 'body', { label: m.fy + ' milestone', ph: 'Write the milestone' }) +
      (can ? '<button type="button" class="w205rm" data-w205rm="milestone:' + m.id + '" aria-label="Remove this milestone">' + I('x') + '</button>' : '') + '</div>' +
      '<div class="w205msft">' + ps.map(projChip).join('') + cntBtn(g.id, m.id) +
      (canComment() ? '<button type="button" class="w205cnt" data-w205link="' + g.id + ':' + m.id + '" aria-label="Link a project to this milestone">' + I('link') + '</button>' : '') + '</div></div>';
  }
  function yearsHtml(g) {
    var ms = msOf(g.id), now = currentFy(), can = canEdit(g);
    var fys = FYS.slice(); ms.forEach(function (m) { if (fys.indexOf(m.fy) < 0) fys.push(m.fy); }); fys.sort();
    return fys.map(function (fy) {
      var list = ms.filter(function (m) { return m.fy === fy; }), done = list.filter(function (m) { return m.status === 'done'; }).length;
      return '<div class="w205yr' + (fy === 'FY31' || fy === 'FY30' ? ' gated' : '') + (fy === now ? ' now' : '') + '"><div class="yh"><b>' + fy + '</b><span>' + E(FY_LABEL[fy] || '') + '</span>' + (list.length ? '<em>' + done + '/' + list.length + '</em>' : '') + '</div>' +
        list.map(function (m) { return msHtml(m, g); }).join('') +
        (list.length ? '' : '<p style="font-size:12.5px;color:' + MUTED + ';margin:2px 2px 8px">' + (can ? 'No milestone yet.' : 'No milestone for this year.') + '</p>') +
        (can ? '<button type="button" class="w205addms" data-w205addms="' + g.id + ':' + fy + '">' + I('plus') + ' Add a milestone</button>' : '') +
        (fy === 'FY31' ? '<p style="font-size:11px;color:' + MUTED + ';margin:6px 2px 0">Only if the FY29 gate is met.</p>' : '') + '</div>';
    }).join('');
  }
  function pathsHtml(g) {
    var can = canEdit(g), ps = pathsOf(g.id);
    return '<ol class="w205paths">' + ps.map(function (p) {
      return '<li data-w205path="' + p.id + '">' + ed('path', p, 'body', { label: 'Path', ph: 'Write the path' }) + (can ? '<button type="button" class="w205rm" data-w205rm="path:' + p.id + '" aria-label="Remove this path">' + I('x') + '</button>' : '') + '</li>';
    }).join('') + '</ol>' + (ps.length ? '' : '<p style="font-size:13px;color:' + MUTED + ';margin:0">' + (can ? 'No path yet: add how we get there.' : 'No path written yet.') + '</p>');
  }
  function projectsHtml(g) {
    var ms = {}; msOf(g.id).forEach(function (m) { ms[m.id] = 1; });
    var ps = projOf(g.id).filter(function (p) { return !p.milestone_id || !ms[p.milestone_id]; });
    var all = projOf(g.id);
    return '<div class="w205projs">' + (ps.length ? ps.map(projChip).join('') : '') +
      (canComment() ? '<button type="button" class="w205btn sm" data-w205link="' + g.id + '">' + I('link') + ' Link a project</button>' : '') +
      (all.length ? '' : '<span style="font-size:12.5px;color:' + MUTED + '">' + (canComment() ? 'No project serves this goal yet.' : 'No project linked yet.') + '</span>') + '</div>';
  }
  function paintProjects(gid) {
    var g = byId(S.goals, gid); if (!g) return;
    var el = document.querySelector('#w205 [data-w205projs="' + gid + '"]'); if (el) el.innerHTML = projectsHtml(g);
    msOf(gid).forEach(function (m) {
      var box = document.querySelector('#w205 [data-w205ms="' + m.id + '"] .w205msft'); if (!box) return;
      var ps = S.projects.filter(function (p) { return String(p.milestone_id) === String(m.id); });
      box.innerHTML = ps.map(projChip).join('') + cntBtn(g.id, m.id) + (canComment() ? '<button type="button" class="w205cnt" data-w205link="' + g.id + ':' + m.id + '" aria-label="Link a project to this milestone">' + I('link') + '</button>' : '');
    });
    var c = document.querySelector('#w205 [data-w205pcount="' + gid + '"]'); if (c) c.textContent = projOf(gid).length ? '(' + projOf(gid).length + ')' : '';
    paintCpFoot(gid);
  }
  function paintCounts(gid) {
    var b = document.querySelector('#w205 [data-w205cmtsft="' + gid + '"]'); var n = commentsOf(gid).length;
    if (b) b.innerHTML = I('chat') + ' Comments' + (n ? ' (' + n + ')' : '');
    msOf(gid).forEach(function (m) { var x = document.querySelector('#w205 [data-w205cmts="' + gid + ':' + m.id + '"]'); if (x) x.outerHTML = cntBtn(gid, m.id); });
  }
  function goalBodyHtml(g) {
    return '<div class="w205prog" data-w205prog="' + g.id + '">' + progHtml(g) + '</div>' +
      '<div class="w205two"><div class="w205smart"><div class="w205lab">SMART <span class="who" data-w205who="' + E(key('goal', g.id, 'detail')) + '" hidden></span></div>' + ed('goal', g, 'detail', { label: 'SMART statement', ph: 'Write the goal as the board will read it' }) + '</div>' +
      '<div><div class="w205lab">Why <span class="who" data-w205who="' + E(key('goal', g.id, 'why')) + '" hidden></span></div>' + ed('goal', g, 'why', { label: 'Why', ph: 'Why this goal matters' }) + '</div></div>' +
      '<div class="w205meas">' + [['measure', 'Headline measure'], ['baseline', 'Baseline'], ['target_fy29', 'FY29 target'], ['target_fy31', 'FY31 target, gated']].map(function (x) {
        return '<div' + (x[0] === 'target_fy29' ? ' class="t29"' : '') + '><div class="w205lab">' + E(x[1]) + ' <span class="who" data-w205who="' + E(key('goal', g.id, x[0])) + '" hidden></span></div>' + ed('goal', g, x[0], { label: x[1], ph: 'Add it' }) + '</div>';
      }).join('') + '</div>' +
      '<div class="w205h4"><h4>Paths</h4><span style="font-size:12px;color:' + MUTED + '">How we get there</span><span class="sp"></span>' + (canEdit(g) ? '<button type="button" class="w205btn sm ghost" data-w205addpath="' + g.id + '">' + I('plus') + ' Add a path</button>' : '') + '</div>' +
      '<div data-w205paths="' + g.id + '">' + pathsHtml(g) + '</div>' +
      yearBlockHtml(g) +
      '<div class="w205h4"><h4>Milestones</h4><span style="font-size:12px;color:' + MUTED + '">By fiscal year (Oct 1 to Sep 30)</span></div>' +
      '<div class="w205years" data-w205years="' + g.id + '">' + yearsHtml(g) + '</div>' +
      '<div class="w205h4"><h4>Projects serving this goal <span data-w205pcount="' + g.id + '" style="font-family:' + BODY + ';font-size:13px;color:' + MUTED + ';text-transform:none">' + (projOf(g.id).length ? '(' + projOf(g.id).length + ')' : '') + '</span></h4></div>' +
      '<div data-w205projs="' + g.id + '">' + projectsHtml(g) + '</div>';
  }
  function goalHtml(g) {
    var folded = !!S.folded[g.id] && String(S.goalId) !== String(g.id);
    var n = commentsOf(g.id).length;
    return '<article class="w205goal' + (folded ? ' folded' : '') + (String(S.goalId) === String(g.id) ? ' target' : '') + '" id="w205g-' + g.id + '" data-w205goal="' + g.id + '" aria-labelledby="w205gt-' + g.id + '">' +
      '<div class="w205ghd"><span class="w205num" aria-hidden="true">' + E(g.number) + '</span><div class="tw" id="w205gt-' + g.id + '">' + ed('goal', g, 'title', { cls: 'title', label: 'Goal ' + g.number + ' title', ph: 'Name the goal' }) + '</div>' +
      '<div class="side"><span class="w205pres" style="margin:0" data-w205gpres="' + g.id + '"></span>' + stSel('goal', g, 'status', GOAL_ST) + '<span class="w205saved" data-w205saved="' + g.id + '" aria-live="polite"></span>' +
      '<button type="button" class="w205fold" data-w205fold="' + g.id + '" aria-expanded="' + (folded ? 'false' : 'true') + '" aria-label="Fold or open this goal">' + I('chev') + '</button></div></div>' +
      '<div class="w205owners" data-w205owners="' + g.id + '">' + ownersHtml(g) + '</div>' +
      '<div class="w207acts" data-w207acts="' + g.id + '">' + actsHtml(g) + '</div>' +
      '<div class="w205gbody" data-w205gbody="' + g.id + '">' + goalBodyHtml(g) + '</div>' +
      '<div class="w205gft"><button type="button" class="w205btn sm" data-w205cmtsft="' + g.id + '" data-w205cmts="' + g.id + '">' + I('chat') + ' Comments' + (n ? ' (' + n + ')' : '') + '</button>' +
      '<button type="button" class="w205btn sm" data-w205hist="' + g.id + '">' + I('clock') + ' History</button>' +
      '<span class="sp"></span><span>Due ' + E(fmtDay(g.due_date)) + (canEdit(g) ? '' : ' \u00b7 read only') + '</span></div></article>';
  }
  /* repaint one goal's body without losing what someone is typing */
  function repaintGoal(gid, keepFocus) {
    var g = byId(S.goals, gid), box = document.querySelector('#w205 [data-w205gbody="' + gid + '"]'); if (!g || !box) return;
    var act = document.activeElement, actKey = act && box.contains(act) ? act.getAttribute('data-w205k') : null, sel = null;
    if (actKey && act.selectionStart != null) sel = [act.selectionStart, act.selectionEnd];
    var keep = {};
    box.querySelectorAll('[data-w205k]').forEach(function (el) { var k = el.getAttribute('data-w205k'); if (S.dirty[k] || S.conflict[k]) keep[k] = el.value; });
    box.innerHTML = goalBodyHtml(g);
    Object.keys(keep).forEach(function (k) { var el = fieldEl(k); if (el) el.value = keep[k]; if (S.conflict[k]) paintConflict(k); });
    box.querySelectorAll('textarea.w205ed').forEach(grow);
    if (keepFocus && actKey) { var n = fieldEl(actKey); if (n) { n.focus(); if (sel) try { n.setSelectionRange(sel[0], sel[1]); } catch (e) { /* fine */ } } }
    paintGlance(); paintPresence();
  }
  function roadHtml() {
    var r = S.plan.roadmap; if (!r) return '';
    var ph = r.phases || [];
    return '<div class="w205sec"><h2>Roadmap</h2><span class="hint">Four phases, one checkpoint, one gate.</span></div>' +
      '<section class="w205road" aria-label="Roadmap"><h3>' + E(r.title || '') + '</h3><div class="bar"></div>' +
      '<div class="w205phases">' + ph.map(function (p) {
        return '<div class="w205ph' + (p.gated ? ' gated' : '') + '"><div class="k">' + E(p.key + ' ' + p.name) + '</div><div class="d">' + E(p.dates) + (p.gated ? ' \u00b7 gated' : '') + '</div><ul>' + (p.items || []).map(function (x) { return '<li>' + E(x) + '</li>'; }).join('') + '</ul></div>';
      }).join('') + '</div>' +
      '<div class="w205marks"><div></div>' +
      (r.checkpoint ? '<div class="w205mk"><b>' + E(r.checkpoint.name) + '</b><ul>' + (r.checkpoint.items || []).map(function (x) { return '<li>' + E(x) + '</li>'; }).join('') + '</ul></div>' : '<div></div>') + '<div></div>' +
      (r.gate ? '<div class="w205mk gt"><b>' + E(r.gate.name) + '</b><ul>' + (r.gate.items || []).map(function (x) { return '<li>' + E(x) + '</li>'; }).join('') + '</ul></div>' : '') + '</div>' +
      (r.gate_rule ? '<p class="w205rule">' + E(r.gate_rule) + '</p>' : '') + '</section>' +
      (S.plan.cadence && S.plan.cadence.length ? '<div class="w205list" style="margin-top:12px"><div class="it" style="font-weight:700;color:' + GREEN + '">How we track it</div>' + S.plan.cadence.map(function (c) { return '<div class="it">' + E(c) + '</div>'; }).join('') + '</div>' : '');
  }
  function unlinkedList() {
    return S.projects.filter(function (p) {
      var s = lower(p.status || 'active'); if (/done|complete|closed|archiv/.test(s)) return false;
      return !p.goal_id || !byId(S.goals, p.goal_id);
    }).sort(function (a, b) { return String(a.department).localeCompare(String(b.department)) || String(a.name).localeCompare(String(b.name)); });
  }
  function unlinkedHtml() {
    var list = unlinkedList();
    return '<div class="w205sec"><h2>Projects not linked to a goal yet</h2><span class="hint">Departments own projects; each one serves a goal.</span></div>' +
      (list.length ? '<div class="w205list" data-w205unlinked>' + list.map(function (p) {
        var was = p.goal_id ? byId(S.allGoals || [], p.goal_id) : null;
        return '<div class="it"><i style="width:9px;height:9px;border-radius:50%;background:' + E(deptColor(p.department)) + ';flex:none"></i><div class="t"><b data-w198skip>' + E(p.name) + '</b><small>' + E(deptLabel(p.department)) + (was ? ' \u00b7 was linked to a retired goal: <span data-w198skip>' + E(clip(was.title, 70)) + '</span>' : '') + '</small></div>' +
          (canComment() ? '<button type="button" class="w205btn sm" data-w205linkp="' + p.id + '">' + I('link') + ' Link</button>' : '') + '</div>';
      }).join('') + '</div>' : '<div class="w205empty" data-w205unlinked><b>Every project serves a goal</b>Nothing to link.</div>');
  }
  function paintUnlinked() { var el = document.querySelector('#w205 [data-w205unlinked]'); if (!el) return; var t = document.createElement('div'); t.innerHTML = unlinkedHtml(); var n = t.querySelector('[data-w205unlinked]'); if (n) el.replaceWith(n); }
  function libPreviewHtml() {
    var pinned = S.docs.filter(function (d) { return d.pinned; }).slice(0, 6);
    return '<div class="w205sec"><h2>Strategy Library</h2><span class="hint">The documents that set our direction, pinned for everyone.</span><span class="sp"></span><button type="button" class="w205btn sm" data-w205go="#orggoals/library">' + I('doc') + ' Open the library (' + S.docs.length + ')</button></div>' +
      (pinned.length ? '<div class="w205lib">' + pinned.map(function (d) { return docHtml(d, true); }).join('') + '</div>' : '<div class="w205empty"><b>Nothing pinned yet</b>' + (isAdmin() ? 'Pin the documents everyone should read from the library.' : 'Admins pin the documents everyone should read.') + '</div>');
  }
  function goalsViewHtml() {
    var p = S.plan;
    if (!S.goals.length) {
      return mastHtml('Goals', p.window || '') + heroHtml() + '<div class="w205empty"><b>No organizational goals yet</b>' + (S.err ? 'The goals could not be read (' + E(clip(S.err, 120)) + ').' : 'When the goals are written, they show here.') + '</div>';
    }
    return mastHtml('Goals', 'Five goals for FY27 to FY29, with a gated view to FY31. Departments own projects; each one serves a goal.') +
      heroHtml() + statusHtml() + yearViewHtml() + whyHtml() + glanceHtml() + coverageHtml() +
      '<div class="w205sec"><h2>Goal by goal</h2><span class="hint">' + (S.goals.some(canEdit) ? 'Click any text to change it; it saves as you type.' : 'Owners keep these up to date.') + '</span></div>' +
      S.goals.map(goalHtml).join('') + roadHtml() + libPreviewHtml() + unlinkedHtml() +
      '<div class="w205more"><button type="button" class="w205tile" data-w205go="#goalmap"><b>Goal alignment</b><span>Every project and the goal it serves, on one map.</span></button>' +
      '<button type="button" class="w205tile" data-w205go="#projects"><b>Projects</b><span>Every department\u2019s projects, their leads and their goals.</span></button>' +
      '<button type="button" class="w205tile" data-w205go="#orggoals/retired"><b>Retired goals (' + S.retired.length + ')</b><span>The department goals and the three earlier org goals, kept with their wins and comments.</span></button></div>' +
      (p.source && p.source.title ? '<p style="font-size:12px;color:' + MUTED + ';margin:18px 0 0">From the draft "' + E(p.source.title) + '".</p>' : '');
  }

  /* ---------- the drawer: comments, history, link a project, owners, a library document ---------- */
  function ensureDrawer() {
    if (document.getElementById('w205drawer')) return;
    var s = document.createElement('div'); s.id = 'w205scrim'; s.setAttribute('data-w205close', '1');
    var d = document.createElement('aside'); d.id = 'w205drawer'; d.setAttribute('role', 'dialog'); d.setAttribute('aria-modal', 'true'); d.setAttribute('aria-labelledby', 'w205dt'); d.setAttribute('aria-hidden', 'true');
    document.body.appendChild(s); document.body.appendChild(d);
  }
  function openDrawer(st) {
    ensureDrawer();
    S.drawer = st; S.drawer.opener = document.activeElement;
    paintDrawer();
    var d = document.getElementById('w205drawer'), s = document.getElementById('w205scrim');
    d.classList.add('open'); s.classList.add('open'); d.setAttribute('aria-hidden', 'false');
    setTimeout(function () { var f = d.querySelector('[data-w205autofocus]') || d.querySelector('textarea,input,button'); if (f) try { f.focus(); } catch (e) { /* fine */ } }, 60);
  }
  function closeDrawer() {
    var d = document.getElementById('w205drawer'), s = document.getElementById('w205scrim');
    if (!d || !S.drawer) return;
    var op = S.drawer.opener; S.drawer = null;
    d.classList.remove('open'); s.classList.remove('open'); d.setAttribute('aria-hidden', 'true');
    if (onPage() && /\/(comments|history)/.test(location.hash)) { try { history.replaceState(null, '', '#orggoals/goal/' + S.goalId); } catch (e) { /* fine */ } }
    if (op && document.body.contains(op)) try { op.focus(); } catch (e) { /* fine */ }
  }
  function drawerShell(title, sub, body, foot) {
    return '<div class="dh"><div><h3 id="w205dt">' + title + '</h3>' + (sub ? '<small>' + sub + '</small>' : '') + '</div><span class="sp"></span><button type="button" class="w205btn sm ghost" data-w205close="1" aria-label="Close">' + I('x') + '</button></div>' +
      '<div class="db">' + body + '</div>' + (foot ? '<div class="df">' + foot + '</div>' : '');
  }
  function paintDrawer() {
    var d = document.getElementById('w205drawer'); if (!d || !S.drawer) return;
    var st = S.drawer, html = '';
    var keepVal = null, ta = d.querySelector('textarea[data-w205cmt]'); if (ta) keepVal = { v: ta.value, focus: document.activeElement === ta, s: ta.selectionStart };
    var keepReply = {}; d.querySelectorAll('textarea[data-w205reply]').forEach(function (t) { keepReply[t.getAttribute('data-w205reply')] = t.value; });
    if (st.kind === 'comments') html = commentsDrawer(st);
    else if (st.kind === 'history') html = historyDrawer(st);
    else if (st.kind === 'link') html = linkDrawer(st);
    else if (st.kind === 'owner') html = ownerDrawer(st);
    else if (st.kind === 'doc') html = docDrawer(st);
    else if (st.kind === 'acts') html = actsDrawer(st);
    d.innerHTML = html;
    if (keepVal) { var t2 = d.querySelector('textarea[data-w205cmt]'); if (t2) { t2.value = keepVal.v; if (keepVal.focus) { t2.focus(); try { t2.setSelectionRange(keepVal.s, keepVal.s); } catch (e) { /* fine */ } } } }
    Object.keys(keepReply).forEach(function (k) { var t = d.querySelector('textarea[data-w205reply="' + k + '"]'); if (t) t.value = keepReply[k]; });
  }

  /* comments, threaded; @mentions through wave138 (the picker and the DM it already sends) */
  function markText(s) { var h = E(s); try { if (window.w138Mark) h = window.w138Mark(h); } catch (e) { /* fine */ } return h; }
  function commentHtml(c, gid, canReply) {
    var mine = c.author_email && lower(c.author_email) === myEmail();
    var m = memberByEmail(c.author_email) || { name: c.author || 'Someone' };
    var editing = S.drawer && String(S.drawer.editing) === String(c.id);
    return '<div class="w205cm" data-w205c="' + c.id + '">' + av(m, 28) + '<div class="bd"><div class="who" data-w198skip>' + E(c.author || m.name) + '<small>' + E(fmtWhen(c.created_at)) + (c.edited_at ? ' \u00b7 edited' : '') + '</small></div>' +
      (editing ? '<textarea data-w205edit="' + c.id + '" aria-label="Edit your comment">' + E(c.body) + '</textarea><div class="acts"><button type="button" class="w205btn sm pri" data-w205editsave="' + c.id + '">Save</button><button type="button" class="w205btn sm ghost" data-w205editcancel="1">Cancel</button></div>'
        : '<div class="tx" data-w198skip>' + markText(c.body) + '</div>') +
      (!editing ? '<div class="ln">' + (canReply ? '<button type="button" class="w205link" data-w205replyto="' + c.id + '">Reply</button>' : '') + ((mine || isAdmin()) && canComment() ? '<button type="button" class="w205link" data-w205editc="' + c.id + '">Edit</button>' : '') + '</div>' : '') + '</div></div>';
  }
  function commentsDrawer(st) {
    var g = byId(S.goals, st.goal) || byId(S.allGoals || [], st.goal);
    if (!g) return drawerShell('Comments', '', '<p>That goal is not here.</p>');
    var ms = msOf(g.id), mid = st.milestone || null, cid = st.checkpoint || null, can = canComment();
    var all = commentsOf(g.id);
    var roots = all.filter(function (c) { return !c.parent_id && (cid ? String(c.checkpoint_id) === String(cid) : mid ? String(c.milestone_id) === String(mid) : true); });
    var seg = '<div class="w205seg" role="tablist"><button type="button" role="tab" class="' + (!mid && !cid ? 'on' : '') + '" data-w205cseg="" aria-selected="' + (!mid && !cid) + '">Everything (' + all.length + ')</button>' +
      cpsOfGoal(g.id).filter(function (c) { return all.some(function (x) { return String(x.checkpoint_id) === String(c.id); }) || String(c.id) === String(cid); }).map(function (c) {
        var n = all.filter(function (x) { return String(x.checkpoint_id) === String(c.id); }).length;
        return '<button type="button" role="tab" class="' + (String(c.id) === String(cid) ? 'on' : '') + '" data-w207cseg="' + c.id + '" title="' + E(c.body) + '" aria-selected="' + (String(c.id) === String(cid)) + '">' + E(cpLabel(c)) + ' (' + n + ')</button>';
      }).join('') +
      ms.filter(function (m) { return all.some(function (c) { return String(c.milestone_id) === String(m.id); }) || String(m.id) === String(mid); }).map(function (m) {
        var n = all.filter(function (c) { return String(c.milestone_id) === String(m.id); }).length;
        return '<button type="button" role="tab" class="' + (String(m.id) === String(mid) ? 'on' : '') + '" data-w205cseg="' + m.id + '" title="' + E(m.body) + '" aria-selected="' + (String(m.id) === String(mid)) + '">' + E(m.fy) + ': ' + E(clip(m.body, 26)) + ' (' + n + ')</button>';
      }).join('') + '</div>';
    var threads = roots.map(function (c) {
      var reps = all.filter(function (r) { return String(r.parent_id) === String(c.id); });
      var mm = c.milestone_id ? byId(S.milestones, c.milestone_id) : null, cc = c.checkpoint_id ? byId(S.checkpoints, c.checkpoint_id) : null;
      return '<div class="w205th">' + (mm && !mid ? '<span class="w205ms-tag" data-w198skip>' + E(mm.fy) + ': ' + E(clip(mm.body, 40)) + '</span>' : '') + (cc && !cid ? '<span class="w205ms-tag" data-w198skip>' + E(cpLabel(cc)) + ': ' + E(clip(cc.body, 40)) + '</span>' : '') + commentHtml(c, g.id, can) +
        (reps.length || String(st.replyTo) === String(c.id) ? '<div class="w205replies">' + reps.map(function (r) { return commentHtml(r, g.id, false); }).join('') +
          (String(st.replyTo) === String(c.id) ? '<div style="margin-top:10px"><textarea data-w205reply="' + c.id + '" data-w205cmt="reply" placeholder="Write a reply. Type @ to bring someone in." aria-label="Your reply" data-w205autofocus></textarea><div class="acts"><button type="button" class="w205btn sm pri" data-w205sendreply="' + c.id + '">Reply</button><button type="button" class="w205btn sm ghost" data-w205replyto="">Cancel</button></div></div>' : '') + '</div>' : '') + '</div>';
    }).join('');
    var msNow = mid ? byId(S.milestones, mid) : null, cpNow = cid ? byId(S.checkpoints, cid) : null;
    var body = seg + (threads || '<div class="w205empty"><b>No comments yet</b>' + (can ? 'Start the conversation: a question, a link, an @mention.' : 'When the team talks about this goal, it shows here.') + '</div>');
    var foot = can ? '<textarea data-w205cmt="new" placeholder="' + (cpNow ? 'Comment on this checkpoint' : msNow ? 'Comment on this milestone' : 'Comment on this goal') + '. Type @ to bring someone in." aria-label="Your comment"' + (st.replyTo ? '' : ' data-w205autofocus') + '></textarea>' +
      '<div class="acts"><small>' + (cpNow ? 'On ' + E(cpLabel(cpNow)) + ': ' + E(clip(cpNow.body, 40)) : msNow ? 'On ' + E(msNow.fy) + ': ' + E(clip(msNow.body, 40)) : 'On the whole goal') + ' \u00b7 Ctrl+Enter posts</small><span class="sp"></span><button type="button" class="w205btn pri sm" data-w205post="1">Post</button></div>' +
      '<small style="display:block;color:' + MUTED + ';font-size:11px;margin-top:6px">People you @mention hear about it the way every Hub @mention works.</small>'
      : '<small style="color:' + MUTED + '">' + E(readOnlyWhy()) + '</small>';
    return drawerShell('Comments', '<span data-w198skip>Goal ' + E(g.number || '') + ': ' + E(g.title) + '</span>', body, foot);
  }
  function postComment(parent) {
    var d = document.getElementById('w205drawer'); if (!d || !S.drawer) return;
    var ta = parent ? d.querySelector('textarea[data-w205reply="' + parent + '"]') : d.querySelector('textarea[data-w205cmt="new"]');
    var body = ta ? ta.value.trim() : ''; if (!body) { if (ta) ta.focus(); return; }
    var st = S.drawer, btn = d.querySelector(parent ? '[data-w205sendreply="' + parent + '"]' : '[data-w205post]'); if (btn) btn.disabled = true;
    var pc = parent ? byId(S.comments, parent) : null, cpId = parent ? (pc && pc.checkpoint_id) : st.checkpoint;
    (cpId ? rpc('strategy_checkpoint_comment_add', { p_checkpoint: Number(cpId), p_parent: parent ? Number(parent) : null, p_body: body })
      : rpc('strategy_comment_add', { p_goal: Number(st.goal), p_milestone: parent ? null : (st.milestone ? Number(st.milestone) : null), p_parent: parent ? Number(parent) : null, p_body: body })).then(function (row) {
      if (row && row.id && !byId(S.comments, row.id)) S.comments.push(row);
      if (ta) ta.value = '';
      if (parent) st.replyTo = null;
      paintDrawer(); paintCounts(st.goal); paintYearCounts(st.goal);
      toastS('Comment posted');
    }).catch(function (e) { toastS('Not posted: ' + errText(e)); if (btn) btn.disabled = false; });
  }
  function saveEdit(id) {
    var d = document.getElementById('w205drawer'), ta = d && d.querySelector('textarea[data-w205edit="' + id + '"]'); if (!ta) return;
    rpc('strategy_comment_edit', { p_id: Number(id), p_body: ta.value }).then(function (row) {
      var c = byId(S.comments, id); if (c && row) Object.assign(c, row);
      S.drawer.editing = null; paintDrawer();
    }).catch(function (e) { toastS('Not saved: ' + errText(e)); });
  }

  /* the history: every change, who and when, with Restore */
  function histLabel(h) {
    var f = FIELD_LABEL[h.field] || h.field;
    if (h.entity === 'goal') return 'changed ' + f;
    if (h.entity === 'milestone') return h.field === 'added' ? 'added a milestone' : h.field === 'archived_at' ? (h.new_value ? 'removed a milestone' : 'brought back a milestone') : 'changed a milestone\u2019s ' + (h.field === 'body' ? 'text' : f.replace(/^the /, ''));
    if (h.entity === 'path') return h.field === 'added' ? 'added a path' : h.field === 'archived_at' ? (h.new_value ? 'removed a path' : 'brought back a path') : 'changed a path';
    if (h.entity === 'owner') return h.field === 'added' ? 'added an owner' : h.field === 'removed' ? 'took an owner off' : h.field === 'is_lead' ? 'changed the lead' : 'changed an owner\u2019s focus';
    if (h.entity === 'project') return h.field === 'goal_id' ? (h.new_value ? 'linked a project' : 'unlinked a project') : h.field === 'checkpoint_id' ? (h.new_value ? 'linked a project to a checkpoint' : 'took a project off a checkpoint') : 'moved a project to a milestone';
    if (h.entity === 'activity') return h.field === 'added' ? 'anchored the goal on a charitable activity' : h.field === 'archived_at' ? (h.new_value ? 'took a charitable activity off' : 'brought back a charitable activity') : 'changed why it serves a charitable activity';
    if (h.entity === 'target') return h.field === 'owners' ? 'changed who reports on the yearly target' : 'changed the yearly target';
    if (h.entity === 'checkpoint') return 'changed a checkpoint\u2019s ' + (h.field === 'body' ? 'text' : h.field === 'due_date' ? 'due date' : f.replace(/^the /, ''));
    return 'changed ' + f;
  }
  function restorable(h) {
    if (h.entity === 'project') return canComment();
    var g = byId(S.goals, h.goal_id); if (!canEdit(g)) return false;
    if (h.entity === 'goal') return ['title', 'detail', 'why', 'measure', 'baseline', 'target_fy29', 'target_fy31', 'status', 'due_date', 'activities_note'].indexOf(h.field) >= 0;
    return true;
  }
  function histVal(h, v) {
    if (v == null || v === '') return '';
    if (h.field === 'archived_at') return '';
    if (h.field === 'status') return ST_LABEL[v] || v;
    if (h.field === 'is_lead') return v === 'true' ? 'Lead' : 'Not the lead';
    return v;
  }
  function historyDrawer(st) {
    var g = byId(S.goals, st.goal); if (!g) return drawerShell('History', '', '<p>That goal is not here.</p>');
    var body;
    if (st.loading) body = '<p style="color:' + MUTED + '">Reading the history\u2026</p>';
    else if (st.err) body = '<div class="w205empty"><b>The history could not be read</b>' + E(st.err) + '</div>';
    else if (!st.rows || !st.rows.length) body = '<div class="w205empty"><b>No changes yet</b>Every change to this goal shows here, with who made it and when.</div>';
    else {
      var day = '', out = [];
      st.rows.forEach(function (h) {
        var dd = fmtDay(h.changed_at); if (dd !== day) { day = dd; out.push('<div class="w205hday">' + E(dd) + '</div>'); }
        var ov = histVal(h, h.old_value), nv = histVal(h, h.new_value), simple = (h.entity === 'project' && h.field !== 'checkpoint_id') || h.entity === 'owner' || h.field === 'added' || (h.field === 'archived_at' && h.entity !== 'activity');
        if (h.entity === 'activity' && h.field === 'archived_at') { simple = true; nv = h.new_value || h.old_value || ''; }
        var cpx = h.entity === 'checkpoint' ? cpLabel(byId(S.checkpoints, h.entity_id)) : '';
        out.push('<div class="w205h" data-w205h="' + h.id + '"><div class="l1"><span><b data-w198skip>' + E(h.changed_by_name || h.changed_by || 'Someone') + '</b> ' + E(histLabel(h)) + '</span><span class="sp"></span><small>' + E(new Date(h.changed_at).toLocaleTimeString('en-CA', { hour: 'numeric', minute: '2-digit' })) + '</small></div>' +
          (h.restored_from ? '<span class="rs">A restore</span>' : '') + (cpx ? '<span class="w205ms-tag">' + E(cpx) + '</span>' : '') +
          (simple ? ((nv || ov) ? '<span class="nv" data-w198skip>' + E(nv || ov) + '</span>' : '') : (ov ? '<span class="ov" data-w198skip>' + E(ov) + '</span>' : '') + (nv ? '<span class="nv" data-w198skip>' + E(nv) + '</span>' : '<span class="nv"><i>cleared</i></span>')) +
          (restorable(h) ? '<div style="margin-top:6px"><button type="button" class="w205btn sm" data-w205restore="' + h.id + '">' + I('undo') + ' Restore</button></div>' : '') + '</div>');
      });
      body = out.join('');
    }
    return drawerShell('History', '<span data-w198skip>Goal ' + E(g.number) + ': ' + E(g.title) + '</span> \u00b7 every change, newest first', body, canEdit(g) ? '<small style="color:' + MUTED + '">Restore puts the old version back; the restore is itself a change here, so nothing is lost.</small>' : '');
  }
  function loadHistory() {
    var st = S.drawer; if (!st || st.kind !== 'history') return;
    st.loading = true; paintDrawer();
    Promise.resolve(db.from('goal_history').select('*').eq('goal_id', Number(st.goal)).order('changed_at', { ascending: false }).limit(300)).then(function (r) {
      if (S.drawer !== st) return;
      st.loading = false; st.err = r && r.error ? (r.error.message || String(r.error)) : null; st.rows = (r && r.data) || [];
      st.rows.sort(function (a, b) { return String(b.changed_at).localeCompare(String(a.changed_at)) || b.id - a.id; });
      paintDrawer();
    }, function (e) { st.loading = false; st.err = errText(e); paintDrawer(); });
  }
  function restore(id) {
    rpc('strategy_restore', { p_history: Number(id) }).then(function (res) {
      if (res && res.conflict) { toastS('Someone changed that field again; read the latest first.'); }
      else toastS('Restored');
      S.loaded = 0;
      return loadAll(true).then(function () { paint(); if (S.drawer && S.drawer.kind === 'history') loadHistory(); });
    }).catch(function (e) { toastS('Not restored: ' + errText(e)); });
  }

  /* link a project to a goal and, ideally, one milestone */
  function linkDrawer(st) {
    var g = st.goal ? byId(S.goals, st.goal) : null;
    var qv = lower(st.q || '');
    var p = st.project ? byId(S.projects, st.project) : null;
    var body = '';
    if (!p) {
      var list = S.projects.filter(function (x) { var s = lower(x.status || 'active'); return !/done|complete|closed|archiv/.test(s); })
        .filter(function (x) { return !qv || lower(x.name + ' ' + deptLabel(x.department)).indexOf(qv) >= 0; })
        .sort(function (a, b) { return String(deptLabel(a.department)).localeCompare(String(deptLabel(b.department))) || String(a.name).localeCompare(String(b.name)); });
      var groups = {}; list.forEach(function (x) { (groups[x.department] = groups[x.department] || []).push(x); });
      body = '<label class="w205search" style="max-width:none;margin:0 0 10px">' + I('search') + '<input type="search" data-w205linkq value="' + E(st.q || '') + '" placeholder="Find a project" aria-label="Find a project" data-w205autofocus /></label>' +
        (list.length ? Object.keys(groups).map(function (d) {
          return '<div class="w205grp">' + E(deptLabel(d)) + '</div><div class="w205pick">' + groups[d].map(function (x) {
            var cur = x.goal_id ? byId(S.goals, x.goal_id) : null;
            return '<label><input type="radio" name="w205lp" data-w205pickp="' + x.id + '" /><span class="t"><span data-w198skip>' + E(x.name) + '</span><small>' + (cur ? 'Serves goal ' + E(cur.number) + (g && cur.id === g.id ? ' (this goal)' : '') : 'Not linked to a goal yet') + '</small></span></label>';
          }).join('') + '</div>';
        }).join('') : '<div class="w205empty"><b>No project matches</b>Projects are added on a team\u2019s page or on Projects.</div>');
      return drawerShell('Link a project', g ? '<span data-w198skip>To goal ' + E(g.number) + ': ' + E(g.title) + '</span>' : 'Pick the project first', body, '<small style="color:' + MUTED + '">Departments own their projects; linking one says which goal (and milestone) it serves.</small>');
    }
    var goalSel = st.goalPick != null ? st.goalPick : (g ? g.id : p.goal_id);
    var gg = byId(S.goals, goalSel);
    var curG = p.goal_id ? byId(S.goals, p.goal_id) : null;
    body = '<div class="w205th"><b data-w198skip>' + E(p.name) + '</b><div style="font-size:12.5px;color:' + MUTED + ';margin-top:2px">' + E(deptLabel(p.department)) + ' \u00b7 ' + (curG ? 'serves goal ' + E(curG.number) : 'not linked to a goal yet') + '</div>' +
      '<div style="margin-top:8px"><a class="w205btn sm" href="#project/' + p.id + '">Open the project</a></div></div>' +
      '<div class="w205grp">The goal it serves</div><div class="w205pick">' + S.goals.map(function (x) {
        return '<label class="' + (String(x.id) === String(goalSel) ? 'on' : '') + '"><input type="radio" name="w205lg" data-w205pickg="' + x.id + '"' + (String(x.id) === String(goalSel) ? ' checked' : '') + ' /><span class="w205num" style="width:24px;height:24px;font-size:13px">' + E(x.number) + '</span><span class="t" data-w198skip>' + E(x.title) + '</span></label>';
      }).join('') + '</div>' +
      (gg ? '<div class="w205grp">The milestone (optional)</div><div class="w205pick"><label class="' + (!st.msPick ? 'on' : '') + '"><input type="radio" name="w205lm" data-w205pickm=""' + (!st.msPick ? ' checked' : '') + ' /><span class="t">The goal as a whole</span></label>' +
        msOf(gg.id).map(function (m) { return '<label class="' + (String(st.msPick) === String(m.id) ? 'on' : '') + '"><input type="radio" name="w205lm" data-w205pickm="' + m.id + '"' + (String(st.msPick) === String(m.id) ? ' checked' : '') + ' /><span class="t"><span data-w198skip>' + E(m.body) + '</span><small>' + E(m.fy) + '</small></span></label>'; }).join('') + '</div>' : '') +
      (gg ? cpPickHtml(gg, st) : '');
    var foot = '<div class="acts" style="margin:0">' + (curG ? '<button type="button" class="w205btn sm ghost" data-w205unlink="' + p.id + '">Unlink</button>' : '') + '<span class="sp"></span><button type="button" class="w205btn sm ghost" data-w205close="1">Cancel</button><button type="button" class="w205btn pri" data-w205dolink="1"' + (gg ? '' : ' disabled') + '>' + I('link') + ' Link it</button></div>';
    return drawerShell(curG ? 'Move or unlink a project' : 'Link a project', '<span data-w198skip>' + E(p.name) + '</span>', body, foot);
  }
  function doLink(unlink) {
    var st = S.drawer; if (!st || st.kind !== 'link' || !st.project) return;
    var p = byId(S.projects, st.project), g = unlink ? null : (st.goalPick != null ? st.goalPick : (st.goal || (p && p.goal_id)));
    var m = unlink ? null : (st.msPick || null);
    var cp = unlink ? null : (st.cpPick || null);
    rpc('strategy_link_project', { p_project: Number(st.project), p_goal: g ? Number(g) : null, p_milestone: m ? Number(m) : null }).then(function () {
      /* wave207: the checkpoint after the goal (moving the goal clears a checkpoint of another goal) */
      var keep = p && p.checkpoint_id && cpsOfGoal(g).some(function (c) { return String(c.id) === String(p.checkpoint_id); }) ? p.checkpoint_id : null;
      if (String(cp || '') === String(keep || '')) return null;
      return rpc('strategy_link_checkpoint', { p_project: Number(st.project), p_checkpoint: cp ? Number(cp) : null });
    }).then(function () {
      if (p) { p.goal_id = g ? Number(g) : null; p.milestone_id = m ? Number(m) : null; p.checkpoint_id = cp ? Number(cp) : null; }
      paintYear();
      closeDrawer();
      S.goals.forEach(function (x) { paintProjects(x.id); }); paintUnlinked();
      /* the shared project store (wave116i): Projects, the team pages and Goal alignment repaint from the same rows */
      try {
        var PS = window.__waProjects;
        if (PS && PS.rows) { PS.rows.forEach(function (x) { if (String(x.id) === String(st.project)) { x.goal_id = g ? Number(g) : null; x.milestone_id = m ? Number(m) : null; x.checkpoint_id = cp ? Number(cp) : null; } }); if (window.w116ProjectsChanged) window.w116ProjectsChanged(PS.rows); }
        else if (window.w116Goals && window.w116Goals.refresh) window.w116Goals.refresh();
      } catch (e) { /* fine */ }
      toastS(unlink ? 'Unlinked' : 'Linked to goal ' + ((byId(S.goals, g) || {}).number || ''));
    }).catch(function (e) { toastS('Not linked: ' + errText(e)); });
  }

  /* owners: add someone from the roster, make the lead, take someone off */
  function ownerDrawer(st) {
    var g = byId(S.goals, st.goal); if (!g) return drawerShell('Owners', '', '');
    var qv = lower(st.q || ''), own = ownersOf(g.id);
    var current = own.map(function (o) {
      var m = memberById(o.member_id) || { name: '?' };
      return '<div class="w205th" style="display:flex;align-items:center;gap:10px">' + av(m, 30) + '<div style="flex:1;min-width:0"><b data-w198skip>' + E(m.name) + '</b>' + (o.is_lead ? ' <span class="w205tag g">Lead</span>' : '') +
        '<label class="w205field" style="margin:6px 0 0;font-weight:600">What they carry <input type="text" data-w205focus="' + o.member_id + '" value="' + E(o.focus || '') + '" placeholder="Optional, e.g. Toronto" /></label></div>' +
        '<div style="display:flex;flex-direction:column;gap:6px">' + (o.is_lead ? '' : '<button type="button" class="w205btn sm" data-w205lead="' + o.member_id + '">Make lead</button>') + '<button type="button" class="w205btn sm ghost" data-w205ownoff="' + o.member_id + '">Take off</button></div></div>';
    }).join('');
    var ids = {}; own.forEach(function (o) { ids[o.member_id] = 1; });
    var pool = members().filter(function (m) { return m.active !== false && !ids[m.id] && (!qv || lower(m.name + ' ' + (m.role || '') + ' ' + deptLabel(m.department)).indexOf(qv) >= 0); })
      .sort(function (a, b) { return String(a.name).localeCompare(String(b.name)); }).slice(0, 40);
    var body = '<div class="w205grp">Owners now</div>' + (current || '<p style="font-size:13px;color:' + MUTED + '">No owner yet.</p>') +
      '<div class="w205grp">Add an owner</div><label class="w205search" style="max-width:none;margin:0 0 8px">' + I('search') + '<input type="search" data-w205ownq value="' + E(st.q || '') + '" placeholder="Find someone on the roster" aria-label="Find someone on the roster" data-w205autofocus /></label>' +
      '<div class="w205pick">' + pool.map(function (m) { return '<label data-w205ownon="' + m.id + '" tabindex="0" role="button">' + av(m, 26) + '<span class="t"><span data-w198skip>' + E(m.name) + '</span><small>' + E(m.role || deptLabel(m.department)) + '</small></span>' + I('plus') + '</label>'; }).join('') + '</div>';
    return drawerShell('Owners', '<span data-w198skip>Goal ' + E(g.number) + ': ' + E(g.title) + '</span> \u00b7 one to three, one lead', body, '<small style="color:' + MUTED + '">Owners and admins edit the goal. Every change is in its history.</small>');
  }
  function ownerSet(gid, mid, on, lead, focus) {
    return rpc('strategy_owner_set', { p_goal: Number(gid), p_member: Number(mid), p_on: !!on, p_lead: lead == null ? null : !!lead, p_focus: focus == null ? null : focus }).then(function () {
      return Promise.resolve(db.from('goal_owners').select('*').eq('goal_id', Number(gid))).then(function (r) {
        S.owners = S.owners.filter(function (o) { return String(o.goal_id) !== String(gid); }).concat(((r && r.data) || []).filter(function (o) { return !o.removed_at; }));
        paintOwners(gid); if (S.drawer && S.drawer.kind === 'owner') paintDrawer(); paintSoonIfRights();
      });
    }).catch(function (e) { toastS('Not changed: ' + errText(e)); });
  }
  function paintSoonIfRights() { /* someone who took themselves off loses the pen: redraw the fields */ var g = S.goals.filter(function (x) { return !canEdit(x); }).length; if (g !== S.lastNoEdit) { S.lastNoEdit = g; paintSoon(); } }

  /* a library document (admins) */
  function docDrawer(st) {
    var d = st.id ? byId(S.docs, st.id) : {};
    var f = function (n, l, ph, ta) { return '<label class="w205field">' + E(l) + (ta ? '<textarea data-w205df="' + n + '" rows="3" placeholder="' + E(ph) + '">' + E(d[n] || '') + '</textarea>' : '<input type="' + (n === 'url' ? 'url' : 'text') + '" data-w205df="' + n + '" value="' + E(d[n] || '') + '" placeholder="' + E(ph) + '"' + (n === 'title' ? ' data-w205autofocus' : '') + ' />') + '</label>'; };
    var body = f('title', 'Title', 'The document\u2019s name') + f('url', 'Link', 'https://docs.google.com/...') + f('group_label', 'Shelf', 'Our plans, Consulting work or Sources') + f('doc_date', 'When it was written', 'e.g. Jun 2026') +
      f('direction', 'The direction it sets', 'What it says we will do', true) + f('status_note', 'Where it stands', 'e.g. Concept; no dates or targets', true) +
      '<label style="display:flex;align-items:center;gap:8px;font-size:13.5px;font-weight:600"><input type="checkbox" data-w205df="pinned"' + (st.id ? (d.pinned ? ' checked' : '') : ' checked') + ' /> Pinned for everyone (shows on the Goals page)</label>';
    var foot = '<div class="acts" style="margin:0">' + (st.id ? '<button type="button" class="w205btn sm ghost" data-w205docarch="' + st.id + '">Take it out of the library</button>' : '') + '<span class="sp"></span><button type="button" class="w205btn sm ghost" data-w205close="1">Cancel</button><button type="button" class="w205btn pri" data-w205docsave="1">' + (st.id ? 'Save' : 'Add it') + '</button></div>';
    return drawerShell(st.id ? 'Edit a document' : 'Add a document', 'The Strategy Library', body, foot);
  }
  function docSave(archive) {
    var st = S.drawer, d = document.getElementById('w205drawer'); if (!st || !d) return;
    var patch = {};
    if (archive) patch.archived = true;
    else d.querySelectorAll('[data-w205df]').forEach(function (el) { var n = el.getAttribute('data-w205df'); patch[n] = el.type === 'checkbox' ? el.checked : el.value; });
    if (!archive && !String(patch.title || '').trim()) { toastS('A document needs a title'); return; }
    rpc('strategy_doc_save', { p_id: st.id ? Number(st.id) : null, p_patch: patch }).then(function (row) {
      S.docs = S.docs.filter(function (x) { return String(x.id) !== String(row && row.id); });
      if (row && !row.archived_at) S.docs.push(row);
      S.docs.sort(function (a, b) { return a.sort - b.sort; });
      closeDrawer(); paint(); toastS(archive ? 'Taken out of the library' : 'Saved');
    }).catch(function (e) { toastS('Not saved: ' + errText(e)); });
  }
  function togglePin(id) {
    var d = byId(S.docs, id); if (!d) return;
    rpc('strategy_doc_save', { p_id: Number(id), p_patch: { pinned: !d.pinned } }).then(function (row) { if (row) Object.assign(d, row); paint(); toastS(d.pinned ? 'Pinned for everyone' : 'Unpinned'); }).catch(function (e) { toastS('Not changed: ' + errText(e)); });
  }

  /* ---------- the Strategy Library ---------- */
  function docHtml(d, compact) {
    var admin = isAdmin();
    var gl = (d.goals || []).filter(Boolean).map(function (n) { var g = S.goals.filter(function (x) { return String(x.number) === String(n); })[0]; return g ? '<a class="w205tag g" href="#orggoals/goal/' + g.id + '" data-w205go="#orggoals/goal/' + g.id + '">Goal ' + E(n) + '</a>' : ''; }).join(' ');
    return '<article class="w205doc' + (d.pinned ? '' : ' unpinned') + '" data-w205doc="' + d.id + '"><div class="hd"><span class="ic">' + I(d.url ? 'doc' : 'archive') + '</span><div style="flex:1;min-width:0">' +
      '<h4 data-w198skip>' + (d.url ? '<a href="' + E(d.url) + '" target="_blank" rel="noopener">' + E(d.title) + '</a>' : E(d.title)) + '</h4>' +
      '<div class="meta">' + E(d.group_label || '') + (d.doc_date ? ' \u00b7 ' + E(d.doc_date) : '') + (d.url ? '' : ' \u00b7 no link yet') + '</div></div>' +
      (admin ? '<button type="button" class="w205pinb' + (d.pinned ? ' on' : '') + '" data-w205pin="' + d.id + '" aria-pressed="' + (d.pinned ? 'true' : 'false') + '" aria-label="' + (d.pinned ? 'Unpin' : 'Pin') + ' this document" title="' + (d.pinned ? 'Pinned for everyone: unpin' : 'Pin it for everyone') + '">' + I('star') + '</button>' : (d.pinned ? '<span class="w205pinb on" title="Pinned">' + I('star') + '</span>' : '')) + '</div>' +
      (d.direction ? '<div class="dir" data-w198skip>' + E(compact ? clip(d.direction, 150) : d.direction) + '</div>' : '') +
      (d.status_note && !compact ? '<div class="st" data-w198skip>' + E(d.status_note) + '</div>' : '') +
      '<div class="ft">' + gl + '<span style="flex:1"></span>' + (d.url ? '<a class="w205btn sm ghost" href="' + E(d.url) + '" target="_blank" rel="noopener">' + I('ext') + ' Open</a>' : '') +
      (admin && !compact ? '<button type="button" class="w205btn sm ghost" data-w205docedit="' + d.id + '">Edit</button>' : '') + '</div></article>';
  }
  function libraryViewHtml() {
    var qv = lower(S.libQ), admin = isAdmin();
    var list = S.docs.filter(function (d) {
      if (!qv) return true;
      return lower([d.title, d.direction, d.status_note, d.group_label, d.doc_date].join(' ')).indexOf(qv) >= 0;
    });
    var shelves = []; list.forEach(function (d) { var s = d.group_label || 'Other'; if (shelves.indexOf(s) < 0) shelves.push(s); });
    var order = ['Our plans', 'Consulting work', 'Sources']; shelves.sort(function (a, b) { var ia = order.indexOf(a), ib = order.indexOf(b); return (ia < 0 ? 9 : ia) - (ib < 0 ? 9 : ib) || a.localeCompare(b); });
    var pinnedN = S.docs.filter(function (d) { return d.pinned; }).length;
    var html = mastHtml('Strategy Library', 'The documents that set Welfare Avenue\u2019s direction: what each one says and where it stands. Pinned documents lead the Goals page.') +
      '<div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin:0 0 6px"><label class="w205search">' + I('search') + '<input type="search" data-w205libq value="' + E(S.libQ) + '" placeholder="Search the library" aria-label="Search the Strategy Library" /></label>' +
      '<span style="font-size:13px;color:' + MUTED + '">' + plural(S.docs.length, 'document') + ', ' + pinnedN + ' pinned</span><span style="flex:1"></span>' +
      (admin ? '<button type="button" class="w205btn pri" data-w205docadd>' + I('plus') + ' Add a document</button>' : '') +
      '<button type="button" class="w205btn" data-w205go="#orggoals">Back to the goals</button></div>';
    if (!list.length) {
      html += '<div class="w205empty" style="margin-top:16px"><b>' + (qv ? 'Nothing matches' : 'The library is empty') + '</b>' + (qv ? 'Try another word, or clear the search.' : (admin ? 'Add the first document.' : 'Admins add the documents that set our direction.')) + '</div>';
      return html;
    }
    shelves.forEach(function (s) {
      var ds = list.filter(function (d) { return (d.group_label || 'Other') === s; }).sort(function (a, b) { return (b.pinned ? 1 : 0) - (a.pinned ? 1 : 0) || (a.sort - b.sort); });
      html += '<div class="w205shelf">' + E(s) + ' <small>' + ds.length + '</small></div><div class="w205lib">' + ds.map(function (d) { return docHtml(d, false); }).join('') + '</div>';
    });
    if (S.plan.source && S.plan.source.title) html += '<p style="font-size:12px;color:' + MUTED + ';margin:20px 0 0">Seeded from "What our own plans already say" and the sources of the draft "' + E(S.plan.source.title) + '".</p>';
    return html;
  }

  /* ---------- the retired goals ---------- */
  function retiredViewHtml() {
    var oldOrg = S.retired.filter(function (g) { return g.department === 'org'; });
    var dept = S.retired.filter(function (g) { return g.department !== 'org'; });
    var lead = isLeader();
    function row(g) {
      var to = g.maps_to_goal_id ? byId(S.goals, g.maps_to_goal_id) : null;
      var proj = g.moved_to_project_id ? byId(S.projects, g.moved_to_project_id) : null;
      var wins = S.wins[g.id] || 0, cm = (S.comments || []).filter(function (c) { return String(c.goal_id) === String(g.id); }).length;
      return '<div class="it"><i style="width:9px;height:9px;border-radius:50%;background:' + E(g.department === 'org' ? GOLD : deptColor(g.department)) + ';flex:none"></i><div class="t"><b data-w198skip>' + E(g.title) + '</b>' +
        '<small>' + E(g.department === 'org' ? 'Organizational goal' : deptLabel(g.department)) + (g.quarter ? ' \u00b7 ' + E(g.quarter) : '') + (g.status_before_retire ? ' \u00b7 was ' + E(ST_LABEL[g.status_before_retire] || g.status_before_retire) : '') +
        (wins ? ' \u00b7 ' + plural(wins, 'win') : '') + (cm ? ' \u00b7 ' + plural(cm, 'comment') : '') + '</small>' +
        (g.retired_note ? '<small data-w198skip>' + E(g.retired_note) + '</small>' : '') + '</div>' +
        (to ? '<a class="w205tag g" href="#orggoals/goal/' + to.id + '" data-w205go="#orggoals/goal/' + to.id + '">Goal ' + E(to.number) + '</a>' : '<span class="w205tag">No obvious fit</span>') +
        (g.department !== 'org' ? (proj ? '<a class="w205btn sm ghost" href="#project/' + proj.id + '">Now a project</a>' : g.moved_to_project_id ? '<span class="w205tag p">Now a project</span>' : (lead ? '<button type="button" class="w205btn sm" data-w205toproj="' + g.id + '" title="Once only: a project in ' + E(deptLabel(g.department)) + (to ? ', linked to goal ' + E(to.number) : '') + '">Make it a project</button>' : '')) : '') + '</div>';
    }
    var groups = {}; dept.forEach(function (g) { var k = g.maps_to_goal_id && byId(S.goals, g.maps_to_goal_id) ? String(g.maps_to_goal_id) : 'none'; (groups[k] = groups[k] || []).push(g); });
    var html = mastHtml('Retired goals', 'Department goals are retired as a tier: departments own projects, and projects serve the five goals. Nothing was removed: each goal keeps its wins, comments and history.') +
      '<div style="margin:0 0 14px"><button type="button" class="w205btn" data-w205go="#orggoals">Back to the goals</button></div>';
    if (!S.retired.length) return html + '<div class="w205empty"><b>No retired goals</b>Goals retired later show here.</div>';
    if (oldOrg.length) html += '<div class="w205shelf">The earlier organizational goals <small>' + oldOrg.length + '</small></div><div class="w205list">' + oldOrg.map(row).join('') + '</div>';
    html += '<div class="w205shelf">Department goals <small>' + dept.length + '</small></div>' +
      '<p style="font-size:13px;color:' + MUTED + ';margin:-4px 0 10px">Grouped by the goal each one served. ' + (lead ? 'Make it a project turns one into a project in the same team, linked to that goal (once per goal).' : 'Leaders and admins can turn one into a project.') + '</p>';
    S.goals.concat([{ id: 'none' }]).forEach(function (g) {
      var list = groups[String(g.id)]; if (!list || !list.length) return;
      html += '<div class="w205grp">' + (g.id === 'none' ? 'No obvious fit with one of the five goals' : 'Served goal ' + E(g.number) + ': <span data-w198skip>' + E(g.title) + '</span>') + '</div><div class="w205list" style="margin-bottom:10px">' + list.map(row).join('') + '</div>';
    });
    return html;
  }

  /* =====================================================================
     wave207 (04/10/26): the charitable activities and this year's goals, inside wave205's page.
     Steel: "Each org goal is anchored on one or more of WA's 8 registered charitable activities": chips on each goal (the
     reason on hover or tap), a column in the goals at a glance, and the 8 activities coverage strip; owners and admins
     anchor a goal on an activity, take one off and say why (strategy_activity_set, strategy_save 'activity' reason).
     "This year's goals (FY27)": per goal the FY27 target and its Q1 to Q4 checkpoints with a status (not started, on track,
     at risk, done), edited live like every other field (strategy_save 'target' and 'checkpoint'), with comments
     (strategy_checkpoint_comment_add) and history; the This year view at the top of Goals: the current quarter, what is due
     next, overdue checkpoints flagged. Projects link to a checkpoint (strategy_link_checkpoint) as well as a goal.
     The words are the plan's (wa207_activities_fy27.sql); nothing here invents a target.
     ===================================================================== */
  if (!document.getElementById('w207css')) {
    var css7 = document.createElement('style'); css7.id = 'w207css';
    css7.textContent = ''
      /* the This year view */
      + '.w207year{background:#FFFAF2;border:1px solid rgba(16,63,57,.12);border-radius:20px;padding:20px 22px 18px;margin:0 0 8px;position:relative;overflow:hidden;}'
      + '.w207year:before{content:"";position:absolute;left:0;top:0;bottom:0;width:5px;background:' + GOLD + ';}'
      + '.w207year .hd{display:flex;align-items:flex-start;gap:16px;flex-wrap:wrap;}'
      + '.w207year .lab{font-size:12px;font-weight:700;letter-spacing:1.4px;text-transform:uppercase;color:' + PURPLE + ';}'
      + '.w207year h2{font-family:' + HEAD + ';font-size:30px;line-height:1.05;text-transform:uppercase;color:' + GREEN + ';margin:2px 0 0;}'
      + '.w207year .sub{font-size:13px;color:' + MUTED + ';margin:4px 0 0;max-width:620px;line-height:1.45;}'
      + '.w207qs{display:flex;gap:6px;margin-left:auto;flex-wrap:wrap;}'
      + '.w207q{border:1px solid rgba(16,63,57,.15);border-radius:12px;padding:6px 10px;min-width:86px;background:#F4F2EA;}'
      + '.w207q b{display:block;font-family:' + HEAD + ';font-size:17px;font-weight:600;color:' + GREEN + ';}'
      + '.w207q small{font-size:11px;color:' + MUTED + ';}'
      + '.w207q.now{background:' + GREEN + ';border-color:' + GREEN + ';}'
      + '.w207q.now b,.w207q.now small{color:' + CREAM + ';}'
      + '.w207q.now em{display:inline-block;font-style:normal;font-size:10px;font-weight:700;letter-spacing:.8px;text-transform:uppercase;color:' + GROUND + ';background:' + GOLD + ';border-radius:999px;padding:1px 7px;margin-left:4px;vertical-align:2px;}'
      + '.w207q.past{opacity:.6;}'
      + '.w207alerts{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:16px 0 14px;}'
      + '.w207box{border-radius:14px;padding:12px 14px;border:1px solid rgba(16,63,57,.12);background:#F4F2EA;min-width:0;}'
      + '.w207box h3{font-family:' + HEAD + ';font-size:18px;font-weight:600;text-transform:uppercase;color:' + GREEN + ';margin:0 0 2px;display:flex;align-items:center;gap:8px;}'
      + '.w207box .when{font-size:12.5px;color:' + MUTED + ';margin:0 0 8px;}'
      + '.w207box.late{background:rgba(179,64,47,.07);border-color:rgba(179,64,47,.35);}'
      + '.w207box.late h3{color:' + FLAG + ';}'
      + '.w207box.ok{background:rgba(42,140,122,.07);border-color:rgba(42,140,122,.3);}'
      + '.w207it{display:flex;gap:8px;align-items:flex-start;padding:6px 0;border-top:1px solid rgba(16,63,57,.08);font-size:13px;line-height:1.4;cursor:pointer;}'
      + '.w207it:first-of-type{border-top:0;}'
      + '.w207it:hover .tx{text-decoration:underline;text-underline-offset:3px;}'
      + '.w207it .w205num{width:22px;height:22px;font-size:12px;}'
      + '.w207it .tx{flex:1;min-width:0;}'
      + '.w207pill{display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:700;border-radius:999px;padding:2px 8px;white-space:nowrap;background:rgba(16,63,57,.07);color:' + GREEN + ';}'
      + '.w207pill:before{content:"";width:7px;height:7px;border-radius:50%;background:rgba(16,63,57,.35);}'
      + '.w207pill.s-onTrack{background:rgba(42,140,122,.12);color:#1d6b5d;}.w207pill.s-onTrack:before{background:' + TEAL + ';}'
      + '.w207pill.s-atRisk{background:rgba(179,64,47,.1);color:' + FLAG + ';}.w207pill.s-atRisk:before{background:' + FLAG + ';}'
      + '.w207pill.s-done{background:rgba(42,140,122,.18);color:#1d6b5d;}.w207pill.s-done:before{background:' + TEAL + ';}'
      + '.w207pill.late{background:' + FLAG + ';color:' + CREAM + ';}.w207pill.late:before{background:' + CREAM + ';}'
      + '.w207grid{border:1px solid rgba(16,63,57,.10);border-radius:14px;overflow:hidden;background:#FFFAF2;}'
      + '.w207grid table{width:100%;border-collapse:collapse;font-size:13px;table-layout:fixed;}'
      + '.w207grid th{text-align:left;font-size:11px;letter-spacing:1px;text-transform:uppercase;color:' + MUTED + ';font-weight:700;padding:10px 10px;background:rgba(16,63,57,.04);}'
      + '.w207grid th.now{color:' + GREEN + ';background:rgba(220,165,39,.22);}'
      + '.w207grid td{padding:10px 10px;border-top:1px solid rgba(16,63,57,.08);vertical-align:top;line-height:1.4;overflow-wrap:anywhere;}'
      + '.w207grid td.now{background:rgba(220,165,39,.09);}'
      + '.w207grid td.late{box-shadow:inset 3px 0 0 ' + FLAG + ';}'
      + '.w207grid tr[data-w207goto]{cursor:pointer;}'
      + '.w207grid tr[data-w207goto]:hover td{background:rgba(111,100,171,.05);}'
      + '.w207grid tr[data-w207goto]:hover td.now{background:rgba(220,165,39,.16);}'
      + '.w207grid td b{font-family:' + HEAD + ';font-size:16px;font-weight:600;color:' + GREEN + ';}'
      + '.w207grid .tg{font-weight:700;color:' + GREEN + ';}'
      + '.w207grid .w207pill{margin-bottom:4px;}'
      + '.w207year .note{font-size:12px;color:' + MUTED + ';margin:10px 0 0;line-height:1.45;}'
      /* activities: chips on a goal, the coverage strip */
      + '.w207acts{display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin:0 0 12px;}'
      + '.w207acts .lab{font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:' + MUTED + ';margin-right:2px;}'
      + '.w207chip{display:inline-flex;align-items:center;gap:6px;max-width:300px;border:1px solid rgba(111,100,171,.3);background:rgba(111,100,171,.07);color:#3f3780;border-radius:999px;padding:3px 10px 3px 3px;font-size:12px;font-weight:600;cursor:pointer;font-family:' + BODY + ';}'
      + '.w207chip b{display:inline-flex;align-items:center;justify-content:center;width:20px;height:20px;border-radius:50%;background:' + PURPLE + ';color:' + CREAM + ';font-size:11px;flex:none;}'
      + '.w207chip span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}'
      + '.w207chip[aria-expanded="true"]{background:' + PURPLE + ';color:' + CREAM + ';}'
      + '.w207chip[aria-expanded="true"] b{background:' + CREAM + ';color:' + PURPLE + ';}'
      + '.w207chip:focus-visible{outline:2px solid ' + GOLD + ';outline-offset:2px;}'
      + '.w207tip{flex:1 0 100%;background:#F4F2EA;border:1px solid rgba(111,100,171,.25);border-radius:12px;padding:9px 12px;font-size:13px;line-height:1.45;}'
      + '.w207tip b{color:#3f3780;}'
      + '.w207note{flex:1 0 100%;font-size:12.5px;color:' + MUTED + ';}'
      + '.w207note .w205ed{font-size:12.5px;padding:2px 4px;margin:0;color:' + MUTED + ';}'
      + '.w207mini{display:flex;gap:4px;flex-wrap:wrap;}'
      + '.w207mini i{display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;border-radius:50%;background:rgba(111,100,171,.14);color:#3f3780;font-style:normal;font-size:11.5px;font-weight:700;}'
      + '.w207cov{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;}'
      + '.w207tile{background:#FFFAF2;border:1px solid rgba(16,63,57,.10);border-radius:14px;padding:12px 12px 10px;display:flex;flex-direction:column;gap:8px;min-width:0;}'
      + '.w207tile .n{display:inline-flex;align-items:center;justify-content:center;width:26px;height:26px;border-radius:50%;background:' + PURPLE + ';color:' + CREAM + ';font-family:' + HEAD + ';font-weight:700;font-size:15px;}'
      + '.w207tile .t{font-size:13px;font-weight:600;line-height:1.35;color:' + GROUND + ';flex:1;}'
      + '.w207tile .gs{display:flex;gap:4px;flex-wrap:wrap;align-items:center;}'
      + '.w207tile .gs button{border:0;padding:0;background:none;cursor:pointer;}'
      + '.w207tile .gs .w205num{width:24px;height:24px;font-size:13px;}'
      + '.w207tile.gap{border-color:rgba(179,64,47,.45);background:rgba(179,64,47,.05);}'
      + '.w207tile.gap .gs{color:' + FLAG + ';font-size:12px;font-weight:700;}'
      + '.w207covsum{display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:700;color:#1d6b5d;}'
      + '.w207covsum.gap{color:' + FLAG + ';}'
      /* a goal's year block */
      + '.w207yb{background:#F4F2EA;border:1px solid rgba(220,165,39,.45);border-radius:16px;padding:12px 14px;margin:6px 0 4px;}'
      + '.w207yb .top{display:grid;grid-template-columns:2fr 1fr;gap:12px;}'
      + '.w207yb .w205ed{background:#FFFAF2;}'
      + '.w207cps{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:10px;}'
      + '.w207cp{background:#FFFAF2;border:1px solid rgba(16,63,57,.10);border-radius:12px;padding:8px 9px;min-width:0;display:flex;flex-direction:column;gap:6px;}'
      + '.w207cp.now{border-color:rgba(220,165,39,.8);box-shadow:inset 0 0 0 1px rgba(220,165,39,.5);}'
      + '.w207cp.late{border-color:rgba(179,64,47,.55);}'
      + '.w207cp.done .w205ed{color:#2d6a5f;}'
      + '.w207cp .qh{display:flex;align-items:center;gap:6px;flex-wrap:wrap;}'
      + '.w207cp .qh b{font-family:' + HEAD + ';font-size:17px;font-weight:600;color:' + GREEN + ';}'
      + '.w207cp .qh em{font-style:normal;font-size:10px;font-weight:700;letter-spacing:.8px;text-transform:uppercase;background:' + GOLD + ';color:' + GROUND + ';border-radius:999px;padding:1px 7px;}'
      + '.w207cp .w205ed{font-size:13px;padding:3px 4px;margin:0;}'
      + '#w205 select.w207st{appearance:auto;font-size:12px;font-weight:700;border-radius:999px;border:1px solid rgba(16,63,57,.2);padding:3px 6px;background:#FFFAF2;color:' + GREEN + ';max-width:100%;}'
      + '#w205 select.w207st.s-onTrack,#w205 select.w207st.s-done{background:rgba(42,140,122,.12);border-color:rgba(42,140,122,.4);color:#1d6b5d;}'
      + '#w205 select.w207st.s-atRisk{background:rgba(179,64,47,.1);border-color:rgba(179,64,47,.4);color:' + FLAG + ';}'
      + '.w207cp .ft{display:flex;align-items:center;gap:6px;flex-wrap:wrap;font-size:11.5px;color:' + MUTED + ';}'
      + '.w207cp input.w207due{font-family:' + BODY + ';font-size:11.5px;border:1px solid rgba(16,63,57,.15);border-radius:8px;padding:2px 5px;background:#FFFAF2;color:' + GROUND + ';max-width:140px;}'
      + '.w207cp input.w207due[readonly]{border-color:transparent;background:transparent;padding-left:0;}'
      + '.w207late{color:' + FLAG + ';font-weight:700;}'
      /* the activities drawer */
      + '.w207pick label{align-items:flex-start;}'
      + '.w207pick .w205ed{background:#FFFAF2;border:1px solid rgba(16,63,57,.15);border-radius:8px;margin-top:6px;font-size:13px;}'
      + '@media (max-width:900px){.w207cov{grid-template-columns:1fr 1fr;}.w207cps{grid-template-columns:1fr 1fr;}.w207alerts{grid-template-columns:1fr;}}'
      + '@media (max-width:640px){'
      + '.w207year{padding:16px 14px 14px;border-radius:16px;}'
      + '.w207qs{margin-left:0;width:100%;display:grid;grid-template-columns:repeat(4,1fr);gap:4px;}'
      + '.w207q{min-width:0;padding:5px 6px;}'
      + '.w207q b{font-size:15px;}'
      + '.w207q small{font-size:10px;}'
      + '.w207q.now em{display:none;}'
      + '.w207grid table,.w207grid tbody,.w207grid tr,.w207grid td{display:block;width:100%;}'
      + '.w207grid thead{display:none;}'
      + '.w207grid tr{border-top:1px solid rgba(16,63,57,.1);padding:8px 0;}'
      + '.w207grid td{border:0;padding:3px 12px;}'
      + '.w207grid td[data-l]:before{content:attr(data-l) ": ";font-size:10.5px;font-weight:700;color:' + MUTED + ';text-transform:uppercase;letter-spacing:.8px;}'
      + '.w207grid td.now{background:rgba(220,165,39,.12);}'
      + '.w207cov{grid-template-columns:1fr;}'
      + '.w207yb .top{grid-template-columns:1fr;}'
      + '.w207cps{grid-template-columns:1fr;}'
      + '.w207chip{max-width:100%;}'
      + '}';
    document.head.appendChild(css7);
  }

  /* ---------- dates: the fiscal year starts October 1 ---------- */
  function todayStr() {
    if (window.__W207_TODAY) return String(window.__W207_TODAY);
    var d = new Date(); return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
  }
  function quarterOf(ds) {
    var p = String(ds || todayStr()).slice(0, 10).split('-'), y = Number(p[0]), m = Number(p[1]) - 1;
    var q = m >= 9 ? 1 : m <= 2 ? 2 : m <= 5 ? 3 : 4;
    return { fy: 'FY' + String(m >= 9 ? y + 1 : y).slice(2), q: q };
  }
  function daysTo(ds) { var a = new Date(todayStr() + 'T12:00:00'), b = new Date(String(ds).slice(0, 10) + 'T12:00:00'); return Math.round((b - a) / 86400000); }
  function inDays(n) { return n === 0 ? 'today' : n === 1 ? 'tomorrow' : n > 1 ? 'in ' + n + ' days' : n === -1 ? 'yesterday' : (-n) + ' days ago'; }
  var Q_SPAN = { 1: 'Oct to Dec', 2: 'Jan to Mar', 3: 'Apr to Jun', 4: 'Jul to Sep' };

  /* ---------- the rows ---------- */
  function targetOf(gid, fy) { return S.targets.filter(function (t) { return String(t.goal_id) === String(gid) && t.fy === fy; })[0] || null; }
  function cpsOfTarget(tid) { return S.checkpoints.filter(function (c) { return String(c.target_id) === String(tid); }).sort(function (a, b) { return a.quarter - b.quarter; }); }
  function cpsOfGoal(gid) {
    return S.checkpoints.filter(function (c) { return String(c.goal_id) === String(gid); }).sort(function (a, b) {
      var ta = byId(S.targets, a.target_id) || {}, tb = byId(S.targets, b.target_id) || {};
      return String(ta.fy).localeCompare(String(tb.fy)) || a.quarter - b.quarter;
    });
  }
  function cpFy(c) { var t = c ? byId(S.targets, c.target_id) : null; return t ? t.fy : ''; }
  function cpLabel(c) { return c ? (cpFy(c) + ' Q' + c.quarter) : 'A checkpoint'; }
  function isLate(c) { return !!c && c.status !== 'done' && !!c.due_date && String(c.due_date).slice(0, 10) < todayStr(); }
  function yearFy() {
    var now = quarterOf().fy;
    if (S.targets.some(function (t) { return t.fy === now; })) return now;
    var fys = S.targets.map(function (t) { return t.fy; }).sort();
    return fys.length ? fys[fys.length - 1] : now;
  }
  function yearState() {
    var fy = yearFy(), tq = quarterOf(), today = todayStr();
    var cps = S.checkpoints.filter(function (c) { return cpFy(c) === fy && byId(S.goals, c.goal_id); });
    var open = cps.filter(function (c) { return c.status !== 'done' && String(c.due_date).slice(0, 10) >= today; }).sort(function (a, b) { return String(a.due_date).localeCompare(String(b.due_date)); });
    var nextDue = open.length ? String(open[0].due_date).slice(0, 10) : null;
    var late = S.checkpoints.filter(function (c) { return isLate(c) && byId(S.goals, c.goal_id); }).sort(function (a, b) { return String(a.due_date).localeCompare(String(b.due_date)); });
    return { fy: fy, today: today, quarter: tq.fy === fy ? tq.q : null, nextDue: nextDue, next: open.filter(function (c) { return String(c.due_date).slice(0, 10) === nextDue; }), overdue: late, total: cps.length, done: cps.filter(function (c) { return c.status === 'done'; }).length };
  }
  function goalNum(gid) { var g = byId(S.goals, gid); return g ? g.number : ''; }
  function pill(c) { return '<span class="w207pill s-' + stKey(c.status) + (isLate(c) ? ' late' : '') + '">' + E(isLate(c) ? 'Overdue' : (ST_LABEL[c.status] || c.status)) + '</span>'; }

  /* ---------- the This year view, at the top of Goals ---------- */
  function yearViewHtml() {
    if (!S.targets.length) return '<div data-w207year></div>';
    var Y = yearState(), plan = S.plan['year_' + Y.fy.toLowerCase()] || {};
    var cps0 = S.checkpoints.filter(function (c) { return cpFy(c) === Y.fy; });
    var qDue = {}; cps0.forEach(function (c) { if (!qDue[c.quarter] || String(c.due_date) > qDue[c.quarter]) qDue[c.quarter] = String(c.due_date).slice(0, 10); });
    var qs = [1, 2, 3, 4].map(function (q) {
      var past = Y.quarter != null ? q < Y.quarter : (qDue[q] && qDue[q] < Y.today);
      return '<div class="w207q' + (Y.quarter === q ? ' now' : '') + (past ? ' past' : '') + '"><b>Q' + q + (Y.quarter === q ? '<em>Now</em>' : '') + '</b><small>' + E(Q_SPAN[q]) + (qDue[q] ? ' \u00b7 due ' + E(fmtDay(qDue[q]).replace(/, \d{4}$/, '')) : '') + '</small></div>';
    }).join('');
    var item = function (c) {
      return '<div class="w207it" data-w207goto="' + c.goal_id + '" role="link" tabindex="0"><span class="w205num">' + E(goalNum(c.goal_id)) + '</span><span class="tx" data-w198skip>' + E(c.body) + '</span>' + pill(c) + '</div>';
    };
    var lateBox = Y.overdue.length
      ? '<div class="w207box late" data-w207overdue><h3>' + I('flag') + ' Overdue (' + Y.overdue.length + ')</h3><p class="when">Past their due date and not done.</p>' + Y.overdue.map(function (c) { return item(c).replace('<span class="tx"', '<span class="tx" title="' + E(cpLabel(c) + ', due ' + fmtDay(c.due_date)) + '"'); }).join('') + '</div>'
      : '<div class="w207box ok" data-w207overdue><h3>' + I('check') + ' Nothing overdue</h3><p class="when">Every checkpoint that has come due is done.</p></div>';
    var nextBox = Y.nextDue
      ? '<div class="w207box" data-w207next><h3>' + I('clock') + ' Due next</h3><p class="when">' + E(fmtDay(Y.nextDue)) + ' \u00b7 ' + E(inDays(daysTo(Y.nextDue))) + '</p>' + Y.next.map(item).join('') + '</div>'
      : '<div class="w207box ok" data-w207next><h3>' + I('check') + ' Nothing left to come due</h3><p class="when">' + E(Y.fy) + '\u2019s checkpoints are done or past.</p></div>';
    var rows = S.goals.map(function (g) {
      var t = targetOf(g.id, Y.fy); if (!t) return '';
      var cps = cpsOfTarget(t.id);
      return '<tr data-w207goto="' + g.id + '" tabindex="0" role="link" aria-label="Open goal ' + E(g.number) + '">' +
        '<td><span style="display:flex;gap:8px;align-items:center"><span class="w205num">' + E(g.number) + '</span><b data-w198skip>' + E(g.title) + '</b></span></td>' +
        '<td data-l="' + E(Y.fy) + ' target" class="tg" data-w198skip>' + E(t.body) + '</td>' +
        [1, 2, 3, 4].map(function (q) {
          var c = cps.filter(function (x) { return x.quarter === q; })[0];
          return '<td data-l="Q' + q + '" class="' + (Y.quarter === q ? 'now' : '') + (c && isLate(c) ? ' late' : '') + '">' + (c ? pill(c) + '<div data-w198skip>' + E(c.body) + '</div>' : '') + '</td>';
        }).join('') +
        '<td data-l="Owners" data-w198skip>' + E(t.owners || '') + '</td></tr>';
    }).join('');
    return '<section class="w207year" data-w207year aria-label="This year">' +
      '<div class="hd"><div><div class="lab">This year</div><h2>' + E(Y.fy) + ' goals</h2><p class="sub">' + E(plan.title || ('This year\u2019s goals: ' + Y.fy)) + '</p></div><div class="w207qs" aria-label="Quarters">' + qs + '</div></div>' +
      (plan.intro ? '<p class="sub" style="margin-top:10px">' + E(plan.intro) + '</p>' : '') +
      '<div class="w207alerts">' + nextBox + lateBox + '</div>' +
      '<div class="w207grid"><table><colgroup><col style="width:17%"><col style="width:17%"><col><col><col><col><col style="width:10%"></colgroup><thead><tr><th>Goal</th><th>' + E(Y.fy) + ' target</th>' + [1, 2, 3, 4].map(function (q) { return '<th class="' + (Y.quarter === q ? 'now' : '') + '">Q' + q + (qDue[q] ? ' (by ' + E(fmtDay(qDue[q]).replace(/, \d{4}$/, '')) + ')' : '') + '</th>'; }).join('') + '<th>Owners</th></tr></thead><tbody>' + rows + '</tbody></table></div>' +
      '<p class="note">' + E(Y.done + ' of ' + Y.total + ' checkpoints done. ') + (plan.note ? E(plan.note) : '') + '</p></section>';
  }
  function paintYear() {
    var el = document.querySelector('#w205 [data-w207year]'); if (!el) return;
    var t = document.createElement('div'); t.innerHTML = yearViewHtml(); var n = t.firstElementChild; if (n) el.replaceWith(n);
  }
  function goYear(gid) { go('#orggoals/goal/' + gid); setTimeout(function () { var b = document.querySelector('#w205 [data-w207yb="' + gid + '"]'); if (b) try { b.scrollIntoView({ behavior: 'smooth', block: 'center' }); } catch (e) { /* fine */ } }, 500); }

  /* ---------- a goal's year block: the target, who reports on it, the four checkpoints ---------- */
  function cpCmtBtn(c) {
    var n = S.comments.filter(function (x) { return String(x.checkpoint_id) === String(c.id); }).length;
    return '<button type="button" class="w205cnt' + (n ? ' has' : '') + '" data-w207cpcmts="' + c.id + '" aria-label="Comments on this checkpoint (' + n + ')">' + I('chat') + (n ? n : '') + '</button>';
  }
  function cpHtml(c, g, Y) {
    var can = canEdit(g), late = isLate(c), now = Y.quarter === c.quarter && cpFy(c) === Y.fy;
    var k = key('checkpoint', c.id, 'status'), kd = key('checkpoint', c.id, 'due_date');
    return '<div class="w207cp' + (now ? ' now' : '') + (late ? ' late' : '') + (c.status === 'done' ? ' done' : '') + '" data-w207cp="' + c.id + '">' +
      '<div class="qh"><b>Q' + c.quarter + '</b>' + (now ? '<em>Now</em>' : '') + '<span class="sp" style="flex:1"></span>' +
      '<select class="w207st s-' + stKey(c.status) + '" data-w205k="' + E(k) + '" aria-label="Q' + c.quarter + ' checkpoint status"' + (can ? '' : ' disabled') + '>' +
      CP_ST.map(function (s0) { return '<option value="' + E(s0) + '"' + (s0 === c.status ? ' selected' : '') + '>' + E(ST_LABEL[s0] || s0) + '</option>'; }).join('') + '</select></div>' +
      ed('checkpoint', c, 'body', { label: 'Q' + c.quarter + ' checkpoint', ph: 'Write the checkpoint' }) +
      '<div class="ft"><span>Due</span><input type="date" class="w207due" data-w205k="' + E(kd) + '" value="' + E(String(c.due_date || '').slice(0, 10)) + '" aria-label="Q' + c.quarter + ' due date"' + (can ? '' : ' readonly tabindex="-1"') + ' />' +
      (late ? '<span class="w207late">Overdue</span>' : '') + '</div>' +
      '<div class="w205msft" style="margin:0" data-w207cpft="' + c.id + '">' + cpFootHtml(c) + '</div></div>';
  }
  function yearBlockHtml(g) {
    var Y = yearState(), t = targetOf(g.id, Y.fy); if (!t) return '';
    return '<div class="w205h4"><h4>This year (' + E(Y.fy) + ')</h4><span style="font-size:12px;color:' + MUTED + '">The yearly target and its quarterly checkpoints</span></div>' +
      '<div class="w207yb" data-w207yb="' + g.id + '"><div class="top"><div><div class="w205lab">' + E(Y.fy) + ' target <span class="who" data-w205who="' + E(key('target', t.id, 'body')) + '" hidden></span></div>' + ed('target', t, 'body', { label: Y.fy + ' target', ph: 'Write the target' }) + '</div>' +
      '<div><div class="w205lab">Owners who report on it <span class="who" data-w205who="' + E(key('target', t.id, 'owners')) + '" hidden></span></div>' + ed('target', t, 'owners', { label: Y.fy + ' owners', ph: 'Who reports on it' }) + '</div></div>' +
      '<div class="w207cps">' + cpsOfTarget(t.id).map(function (c) { return cpHtml(c, g, Y); }).join('') + '</div></div>';
  }
  function afterYearSave(P) {
    if (P.e !== 'checkpoint') return;
    var c = byId(S.checkpoints, P.id), box = document.querySelector('#w205 [data-w207cp="' + P.id + '"]'); if (!c || !box) return;
    var Y = yearState();
    box.classList.toggle('done', c.status === 'done'); box.classList.toggle('late', isLate(c));
    var sel = box.querySelector('select.w207st'); if (sel) sel.className = 'w207st s-' + stKey(c.status);
    var ft = box.querySelector('.ft'), lt = ft && ft.querySelector('.w207late');
    if (isLate(c) && ft && !lt) { var s0 = document.createElement('span'); s0.className = 'w207late'; s0.textContent = 'Overdue'; ft.appendChild(s0); }
    if (!isLate(c) && lt) lt.remove();
    void Y;
  }
  function cpFootHtml(c) {
    var ps = S.projects.filter(function (p) { return String(p.checkpoint_id) === String(c.id); });
    return ps.map(projChip).join('') + cpCmtBtn(c) + (canComment() ? '<button type="button" class="w205cnt" data-w207cplink="' + c.id + '" aria-label="Link a project to this checkpoint">' + I('link') + '</button>' : '');
  }
  function paintCpFoot(gid) { cpsOfGoal(gid).forEach(function (c) { var el = document.querySelector('#w205 [data-w207cpft="' + c.id + '"]'); if (el) el.innerHTML = cpFootHtml(c); }); }
  function paintYearCounts(gid) {
    cpsOfGoal(gid).forEach(function (c) { var b = document.querySelector('#w205 [data-w207cpcmts="' + c.id + '"]'); if (b) b.outerHTML = cpCmtBtn(c); });
  }

  /* ---------- the charitable activities ---------- */
  function actOf(id) { return byId(S.acts, id); }
  function gactsOf(gid) { return S.gacts.filter(function (a) { return String(a.goal_id) === String(gid); }).sort(function (a, b) { return (a.sort - b.sort) || (a.activity_id - b.activity_id); }); }
  function actsMini(gid) { return '<span class="w207mini">' + gactsOf(gid).map(function (a) { var x = actOf(a.activity_id) || {}; return '<i title="' + E(a.activity_id + '. ' + (x.title || '') + (a.reason ? ' (' + a.reason + ')' : '')) + '">' + E(a.activity_id) + '</i>'; }).join('') + '</span>'; }
  function actsHtml(g) {
    var list = gactsOf(g.id), can = canEdit(g);
    var note = can ? '<div class="w207note">' + ed('goal', g, 'activities_note', { label: 'Note on the charitable activities', ph: 'A note on the activities (optional)' }) + '</div>'
      : (g.activities_note ? '<div class="w207note" data-w198skip>' + E(g.activities_note) + '</div>' : '');
    return '<span class="lab">Charitable activities</span>' + list.map(function (a) {
      var x = actOf(a.activity_id) || { title: '' };
      return '<button type="button" class="w207chip" data-w207chip="' + g.id + ':' + a.activity_id + '" aria-expanded="false" title="' + E(a.activity_id + '. ' + x.title + (a.reason ? ': ' + a.reason : '')) + '"><b>' + E(a.activity_id) + '</b><span data-w198skip>' + E(x.title) + '</span></button>';
    }).join('') + (list.length ? '' : '<span style="font-size:12.5px;color:' + FLAG + '">Not anchored on an activity yet.</span>') +
      (can ? '<button type="button" class="w205chip add" data-w207manage="' + g.id + '">' + I('plus') + ' Activities</button>' : '') + note;
  }
  function paintActs(gid) {
    var el = document.querySelector('#w205 [data-w207acts="' + gid + '"]'), g = byId(S.goals, gid); if (!el || !g) return;
    var nk = key('goal', g.id, 'activities_note'), cur = fieldEl(nk), keep = cur && (S.dirty[nk] || document.activeElement === cur) ? cur.value : null, foc = cur && document.activeElement === cur;
    el.innerHTML = actsHtml(g);
    var n = fieldEl(nk); if (n) { if (keep != null) n.value = keep; grow(n); if (foc) n.focus(); }
  }
  function chipTip(el) {
    var p = el.getAttribute('data-w207chip').split(':'), box = el.parentNode, open = el.getAttribute('aria-expanded') === 'true';
    box.querySelectorAll('.w207tip').forEach(function (t) { t.remove(); });
    box.querySelectorAll('[data-w207chip]').forEach(function (c) { c.setAttribute('aria-expanded', 'false'); });
    if (open) return;
    var a = S.gacts.filter(function (x) { return String(x.goal_id) === p[0] && String(x.activity_id) === p[1]; })[0], x = actOf(p[1]) || {};
    var tip = document.createElement('div'); tip.className = 'w207tip'; tip.setAttribute('role', 'note');
    tip.innerHTML = '<b>' + E(p[1] + '. ' + (x.title || '')) + '</b><br>' + (a && a.reason ? 'Why this goal serves it: <span data-w198skip>' + E(a.reason) + '</span>' : 'No reason written yet.');
    el.setAttribute('aria-expanded', 'true');
    var note = box.querySelector('.w207note'); if (note) box.insertBefore(tip, note); else box.appendChild(tip);
  }
  function coverage() { return S.acts.map(function (a) { return { act: a, goals: S.goals.filter(function (g) { return gactsOf(g.id).some(function (x) { return String(x.activity_id) === String(a.id); }); }) }; }); }
  function coverageHtml() {
    if (!S.acts.length) return '<div data-w207cov></div>';
    var cov = coverage(), n = cov.filter(function (c) { return c.goals.length; }).length, plan = S.plan.activities || {};
    return '<div data-w207cov><div class="w205sec"><h2>' + E(S.acts.length) + ' activities</h2><span class="hint">' + E(plan.intro || 'Every goal serves at least one of the charitable activities registered with the CRA.') + '</span><span class="sp"></span>' +
      '<span class="w207covsum' + (n < S.acts.length ? ' gap' : '') + '">' + I(n < S.acts.length ? 'flag' : 'check') + ' ' + (n === S.acts.length ? 'All ' + n + ' covered' : n + ' of ' + S.acts.length + ' covered') + '</span></div>' +
      '<div class="w207cov" aria-label="Charitable activities and the goals that serve them">' + cov.map(function (c) {
        return '<div class="w207tile' + (c.goals.length ? '' : ' gap') + '"><span class="n">' + E(c.act.id) + '</span><span class="t" data-w198skip>' + E(c.act.title) + '</span><div class="gs">' +
          (c.goals.length ? c.goals.map(function (g) { var a = gactsOf(g.id).filter(function (x) { return String(x.activity_id) === String(c.act.id); })[0]; return '<button type="button" data-w205jump="' + g.id + '" title="' + E('Goal ' + g.number + ': ' + g.title + (a && a.reason ? ' (' + a.reason + ')' : '')) + '" aria-label="Goal ' + E(g.number) + '"><span class="w205num">' + E(g.number) + '</span></button>'; }).join('') : 'No goal serves it yet') + '</div></div>';
      }).join('') + '</div></div>';
  }
  function paintCoverage() { var el = document.querySelector('#w205 [data-w207cov]'); if (!el) return; var t = document.createElement('div'); t.innerHTML = coverageHtml(); var n = t.firstElementChild; if (n) el.replaceWith(n); }
  function actsDrawer(st) {
    var g = byId(S.goals, st.goal); if (!g) return drawerShell('Charitable activities', '', '');
    var can = canEdit(g), on = {}; gactsOf(g.id).forEach(function (a) { on[a.activity_id] = a; });
    var body = '<p style="font-size:13px;color:' + MUTED + ';margin:0 0 10px">' + E((S.plan.activities || {}).intro || '') + '</p><div class="w205pick w207pick">' + S.acts.map(function (x) {
      var a = on[x.id];
      return '<label class="' + (a ? 'on' : '') + '"><input type="checkbox" data-w207act="' + x.id + '"' + (a ? ' checked' : '') + (can ? '' : ' disabled') + ' /><span class="t"><span><b>' + E(x.id) + '.</b> ' + E(x.title) + '</span>' +
        (a ? '<small>Why this goal serves it</small>' + ed('activity', a, 'reason', { label: 'Why goal ' + g.number + ' serves activity ' + x.id, ph: 'A few words, e.g. free, healthy meals' }) : '') + '</span></label>';
    }).join('') + '</div>';
    return drawerShell('Charitable activities', '<span data-w198skip>Goal ' + E(g.number) + ': ' + E(g.title) + '</span>', body, '<small style="color:' + MUTED + '">Tick the activities this goal serves and say why in a few words. It saves as you go; every change is in the goal\u2019s history.</small>');
  }
  function actToggle(gid, aid, on, el) {
    if (el) el.disabled = true;
    rpc('strategy_activity_set', { p_goal: Number(gid), p_activity: Number(aid), p_on: !!on, p_reason: null }).then(function (row) {
      S.gacts = S.gacts.filter(function (a) { return !(String(a.goal_id) === String(gid) && String(a.activity_id) === String(aid)); });
      if (row && !row.archived_at) { S.gacts.push(row); baseRow('activity', row, ['reason']); }
      paintActs(gid); paintCoverage(); paintGlance(); if (S.drawer && S.drawer.kind === 'acts') paintDrawer();
      toastS(on ? 'Activity added to the goal' : 'Activity taken off. History has Restore.');
    }).catch(function (e) { if (el) { el.disabled = false; el.checked = !on; } toastS('Not changed: ' + errText(e)); });
  }

  /* the link sheet: a checkpoint of the chosen goal, optional */
  function cpPickHtml(gg, st) {
    var Y = yearState(), list = cpsOfGoal(gg.id); if (!list.length) return '';
    return '<div class="w205grp">The checkpoint (optional)</div><div class="w205pick"><label class="' + (!st.cpPick ? 'on' : '') + '"><input type="radio" name="w207lc" data-w207pickc=""' + (!st.cpPick ? ' checked' : '') + ' /><span class="t">No checkpoint</span></label>' +
      list.map(function (c) {
        var sel = String(st.cpPick) === String(c.id);
        return '<label class="' + (sel ? 'on' : '') + '"><input type="radio" name="w207lc" data-w207pickc="' + c.id + '"' + (sel ? ' checked' : '') + ' /><span class="t"><span data-w198skip>' + E(c.body) + '</span><small>' + E(cpLabel(c)) + ' \u00b7 due ' + E(fmtDay(c.due_date)) + (Y.quarter === c.quarter && cpFy(c) === Y.fy ? ' \u00b7 this quarter' : '') + '</small></span></label>';
      }).join('') + '</div>';
  }

  /* ---------- the page tours (wave122's engine): tour:orggoals (Goals), tour:strategylib (the library), tour:goalmap ---------- */
  function addTours() {
    try {
      var W = window.w122; if (!W || !W.tours || (W.tours.orggoals && W.tours.orggoals.__w205)) return;
      var OPT = { opt: 1 };
      var T = function (sel, t, p, o) { var x = { s: sel, t: t, p: p }; if (o) Object.keys(o).forEach(function (k) { x[k] = o[k]; }); return x; };
      var jump = function (h) { return function () { if (location.hash !== h) location.hash = h; }; };
      W.tours.orggoals = { __w205: true, tab: 'orggoals', icon: 'target', hash: '#orggoals', steps: [
        T('#w205 .w205mast', 'Goals', 'Welfare Avenue\u2019s five organizational goals for FY27 to FY29, with a gated view to FY31. Departments own projects, and every project serves one of these goals.'),
        T('#w205 .w205hero', 'The mission first', 'Every goal serves the mission the board adopted in July 2026.', OPT),
        T('#w205 .w205status', 'Draft or approved', 'Until the board votes (Oct 19, 2026) the goals say Draft for board approval. An admin marks them approved after the vote.', OPT),
        T('#w205 [data-w207year]', 'This year', 'This year\u2019s goals: each goal\u2019s target for the fiscal year and its four quarterly checkpoints. The current quarter is highlighted, Due next lists what comes due first, and anything past its date and not done is flagged Overdue. Click a row to open the goal.', OPT),
        T('#w205 [data-w205pres]', 'Who is here', 'The people on this page right now. On a goal, their faces show which goal they are in; a field someone is typing in says so.', OPT),
        T('#w205 [data-w205glance]', 'At a glance', 'One line per goal: the headline measure, the baseline, the FY29 and FY31 targets, the owners and the milestones done. Click a row to jump to the goal.', OPT),
        T('#w205 [data-w207cov]', 'Our 8 charitable activities', 'The eight activities Welfare Avenue is registered for, and the goals that serve each one. A tile with no goal would be flagged; today all eight are covered.', OPT),
        T('#w205 .w205goal .w205ghd', 'A goal', 'Its number, its title and its status. If you own the goal (or you are an admin), click any text and type: it saves as you go, and Saved shows when it is in.', OPT),
        T('#w205 .w205goal .w205owners', 'Owners', 'One to three owners, one lead. Owners and admins edit the goal; everyone on staff reads it and comments.', OPT),
        T('#w205 .w205goal .w207acts', 'Charitable activities', 'The registered activities this goal serves. Hover or tap a chip for why. Owners and admins add or take off an activity with + Activities.', OPT),
        T('#w205 .w205goal .w205two', 'SMART and Why', 'The goal as the board reads it, and why it matters.', OPT),
        T('#w205 .w205goal .w205meas', 'The targets', 'The headline measure, where we started, the 3-year target (FY29) and the 5-year target (FY31, only if the FY29 gate is met).', OPT),
        T('#w205 .w205goal .w205paths', 'Paths', 'How we get there. Owners add, change and remove paths.', OPT),
        T('#w205 .w205goal .w207yb', 'This year\u2019s target', 'The goal\u2019s target for this fiscal year, who reports on it, and its Q1 to Q4 checkpoints. Owners set each checkpoint\u2019s status (not started, on track, at risk, done) and its due date; the speech bubble holds its comments and the link icon ties a project to it.', OPT),
        T('#w205 .w205goal .w205years', 'Milestones by year', 'Each fiscal year\u2019s milestones with their status (tap the circle). The projects serving a milestone sit under it; the speech bubble is its own comments.', OPT),
        T('#w205 .w205goal [data-w205projs]', 'Projects serving the goal', 'Departments link their projects here, to the goal or to one milestone. Link a project picks the project and the milestone.', OPT),
        T('#w205 .w205goal .w205gft', 'Comments and history', 'Comments are threaded; type @ to bring someone in. History lists every change, who made it and when; Restore puts an old version back.', OPT),
        T('#w205 .w205road', 'The roadmap', 'Three years to prove it: stabilize, strengthen, scale. The checkpoint in Oct 2027 and the FY29 gate in Oct 2029 decide whether FY30 and FY31 go ahead.', OPT),
        T('#w205 .w205lib', 'The Strategy Library', 'The pinned documents that set our direction. The full library is in the menu.', OPT),
        T('#w205 [data-w205unlinked]', 'Not linked yet', 'Active projects that do not serve a goal yet. Link each one so the goals show the work behind them.', OPT)
      ] };
      W.tours.strategylib = { __w205: true, tab: 'orggoals', icon: 'book', hash: '#orggoals/library', steps: [
        T('#w205 .w205mast', 'The Strategy Library', 'The documents that set Welfare Avenue\u2019s direction: our plans, the consulting work, the sources.', { go: jump('#orggoals/library') }),
        T('#w205 .w205search', 'Search', 'Find a document by its title, what it sets or where it stands.', OPT),
        T('#w205 .w205doc', 'A document', 'What it says, when it was written, where it stands today, and the goals it feeds. Open takes you to the document.', OPT),
        T('#w205 .w205pinb', 'Pinned', 'Pinned documents lead the library and show on the Goals page. Admins pin and unpin, and add new documents.', OPT)
      ] };
      W.tours.goalmap = { __w205: true, tab: 'goalmap', icon: 'link', hash: '#goalmap', steps: [
        T('#goalmap .w116ptop', 'How it all connects', 'Every active project and the organizational goal it serves. Department goals are retired: departments own projects, and projects serve the goals.'),
        T('#w116maphost .sum', 'Gaps at a glance', 'Projects without a goal, and goals with no project yet.', OPT),
        T('#w116maphost .chips', 'Filter by team', 'Focus the map on one team.', OPT),
        T('#w116maphost .w116mcols > .w116mcol:nth-child(1)', 'Projects', 'The work underway. A project marked Link to a goal is not connected yet: click it to link it.', OPT),
        T('#w116maphost .w116mcols > .w116mcol:nth-child(2)', 'The goals', 'The five organizational goals and the milestones their projects serve.', OPT),
        T('#w116maphost p.note', 'Try it', 'Hover anything to light up its chain; click it to pin it.', OPT)
      ] };
      if (W.tours.goals) delete W.tours.goals;   /* the Department goals page is retired */
    } catch (e) { /* fine */ }
  }

  /* ---------- presence on the page ---------- */
  function presName(p) { var m = p.mid ? memberById(p.mid) : null; return (m && m.name) || p.name || 'Someone'; }
  function presMember(p) { return (p.mid && memberById(p.mid)) || { name: presName(p) }; }
  function paintPresence() {
    var top = document.querySelector('#w205 [data-w205pres]');
    var people = S.presence;
    if (top) {
      top.innerHTML = '<span class="w205live' + (S.live ? '' : ' off') + '" title="' + (S.live ? 'Live: changes arrive as people make them' : 'Not live: changes show when you reload') + '"></span>' +
        (people.length ? '<span>Here now</span><span class="avs">' + people.slice(0, 8).map(function (p) {
          var g = p.goal ? byId(S.goals, p.goal) : null, m = presMember(p);
          return '<span title="' + E(presName(p) + (g ? ', in goal ' + g.number : '')) + '">' + av(m, 26) + '</span>';
        }).join('') + '</span>' + (people.length > 8 ? '<span>+' + (people.length - 8) + '</span>' : '') : '<span>' + (S.live ? 'Just you here' : 'Offline view') + '</span>');
    }
    document.querySelectorAll('#w205 [data-w205gpres]').forEach(function (el) {
      var gid = el.getAttribute('data-w205gpres'), here = people.filter(function (p) { return String(p.goal) === String(gid); });
      el.innerHTML = here.length ? '<span class="avs">' + here.map(function (p) { var m = presMember(p); return '<span title="' + E(presName(p)) + ' is in this goal">' + av(m, 24) + '</span>'; }).join('') + '</span>' : '';
    });
    document.querySelectorAll('#w205 [data-w205who]').forEach(function (el) {
      var k = el.getAttribute('data-w205who'), who = people.filter(function (p) { return p.field === k; }).map(presName);
      if (who.length) { el.hidden = false; el.textContent = who.join(', ') + ' editing'; } else el.hidden = true;
    });
    document.querySelectorAll('#w205 .w205ed.other').forEach(function (el) { el.classList.remove('other'); el.removeAttribute('data-w205by'); });
    people.forEach(function (p) { if (!p.field) return; var el = fieldEl(p.field); if (el) { el.classList.add('other'); el.title = presName(p) + ' is editing this'; } });
  }

  /* the boxes fit their words: again once the fonts are in and when the width changes */
  function growAll() { document.querySelectorAll('#w205 textarea.w205ed').forEach(grow); }
  function growSoon() { setTimeout(growAll, 30); setTimeout(growAll, 400); try { if (document.fonts && document.fonts.ready) document.fonts.ready.then(growAll); } catch (e) { /* fine */ } }
  var rzT = null; window.addEventListener('resize', function () { clearTimeout(rzT); rzT = setTimeout(function () { if (onPage()) growAll(); }, 150); });
  /* ---------- paint and route ---------- */
  function paint() {
    var h = host(); if (!h) return;
    var act = document.activeElement, actKey = act && h.contains(act) ? act.getAttribute('data-w205k') : null, sel = null;
    if (actKey && act.selectionStart != null) sel = [act.selectionStart, act.selectionEnd];
    var keep = {}; h.querySelectorAll('[data-w205k]').forEach(function (el) { var k = el.getAttribute('data-w205k'); if (S.dirty[k] || S.conflict[k]) keep[k] = el.value; });
    var libFocus = act && act.hasAttribute && act.hasAttribute('data-w205libq');
    var html;
    if (!staffOk() && !boardMode()) html = mastHtml('Goals', '') + '<div class="w205empty"><b>Sign in to read the goals</b>The Strategy app is for Welfare Avenue accounts and the board.</div>';
    else if (S.view === 'library') html = libraryViewHtml();
    else if (S.view === 'retired') html = retiredViewHtml();
    else html = goalsViewHtml();
    h.innerHTML = html;
    Object.keys(keep).forEach(function (k) { var el = fieldEl(k); if (el) el.value = keep[k]; if (S.conflict[k]) paintConflict(k); });
    h.querySelectorAll('textarea.w205ed').forEach(grow);
    Object.keys(S.errors).forEach(paintFieldError);
    S.goals.forEach(function (g) { savedState(key('goal', g.id, 'title')); });
    if (actKey) { var n = fieldEl(actKey); if (n) { n.focus(); if (sel) try { n.setSelectionRange(sel[0], sel[1]); } catch (e) { /* fine */ } } }
    if (libFocus) { var li = h.querySelector('[data-w205libq]'); if (li) { li.focus(); li.setSelectionRange(li.value.length, li.value.length); } }
    paintPresence(); growSoon();
    try { document.title = (S.view === 'library' ? 'Strategy Library' : S.view === 'retired' ? 'Retired goals' : 'Goals') + ' \u00b7 Welfare Avenue Hub'; } catch (e) { /* fine */ }
    S.lastNoEdit = S.goals.filter(function (x) { return !canEdit(x); }).length;
  }
  function route(hh) {
    var p = String(hh || '').replace(/^#/, '').split('/');
    S.view = 'goals'; S.goalId = null; S.sub = ''; S.subId = null;
    if (p[1] === 'library') S.view = 'library';
    else if (p[1] === 'retired') S.view = 'retired';
    else if (p[1] === 'goal' && p[2]) { S.goalId = p[2]; S.sub = p[3] || ''; S.subId = p[4] || null; }
  }
  function show(hh) {
    route(hh);
    var h = host(); if (!h) return;
    if (!S.loaded) h.innerHTML = '<div class="w205empty" style="margin-top:20px"><b>Loading the goals</b>One moment.</div>';
    return loadAll().then(function () {
      paint();
      goLive(); trackSoon();
      if (S.goalId) {
        var card = document.getElementById('w205g-' + S.goalId);
        if (card) setTimeout(function () { try { card.scrollIntoView({ behavior: 'smooth', block: 'start' }); } catch (e) { card.scrollIntoView(); } }, 80);
        if (S.sub === 'comments') openDrawer({ kind: 'comments', goal: S.goalId, milestone: null, focusComment: S.subId });
        else if (S.sub === 'history') { openDrawer({ kind: 'history', goal: S.goalId }); loadHistory(); }
      } else window.scrollTo(0, 0);
    });
  }
  function go(h) { if (location.hash === h) { try { applyHash(); } catch (e) { show(h); } } else location.hash = h; }

  /* ---------- events ---------- */
  function inApp(t) { return !!(t && t.closest && (t.closest('#w205') || t.closest('#w205drawer') || t.closest('#w205scrim'))); }
  document.addEventListener('input', function (e) {
    var t = e.target; if (!inApp(t)) return;
    var k = t.getAttribute && t.getAttribute('data-w205k');
    if (k) {
      if (t.readOnly || t.disabled) return;
      grow(t); S.dirty[k] = true; delete S.errors[k];
      var er = t.parentNode.querySelector('.w205err[data-for="' + k + '"]'); if (er) er.remove();
      schedule(k, t.tagName === 'SELECT' ? 0 : SAVE_MS);
      return;
    }
    if (t.hasAttribute('data-w205libq')) { S.libQ = t.value; clearTimeout(S.libT); S.libT = setTimeout(paint, 160); return; }
    if (t.hasAttribute('data-w205linkq') && S.drawer) { S.drawer.q = t.value; clearTimeout(S.dT); S.dT = setTimeout(function () { paintDrawer(); var i = document.querySelector('#w205drawer [data-w205linkq]'); if (i) { i.focus(); i.setSelectionRange(i.value.length, i.value.length); } }, 150); return; }
    if (t.hasAttribute('data-w205ownq') && S.drawer) { S.drawer.q = t.value; clearTimeout(S.dT); S.dT = setTimeout(function () { paintDrawer(); var i = document.querySelector('#w205drawer [data-w205ownq]'); if (i) { i.focus(); i.setSelectionRange(i.value.length, i.value.length); } }, 150); return; }
  });
  document.addEventListener('change', function (e) {
    var t = e.target; if (!inApp(t)) return;
    var k = t.getAttribute && t.getAttribute('data-w205k');
    if (k && t.tagName === 'SELECT') { t.className = t.className.replace(/\bs-\w+/, 's-' + stKey(t.value)); t.title = ST_LABEL[t.value] || t.value; return; }
    if (t.hasAttribute('data-w205pickp') && S.drawer) { S.drawer.project = t.getAttribute('data-w205pickp'); var p = byId(S.projects, S.drawer.project); S.drawer.goalPick = S.drawer.goal || (p && p.goal_id) || null; S.drawer.msPick = p && String(p.goal_id) === String(S.drawer.goalPick) ? p.milestone_id : (S.drawer.ms || null); S.drawer.cpPick = S.drawer.cp || (p && String(p.goal_id) === String(S.drawer.goalPick) ? p.checkpoint_id : null) || null; paintDrawer(); return; }
    if (t.hasAttribute('data-w205pickg') && S.drawer) { S.drawer.goalPick = t.getAttribute('data-w205pickg'); S.drawer.msPick = null; S.drawer.cpPick = null; paintDrawer(); return; }
    if (t.hasAttribute('data-w207pickc') && S.drawer) { S.drawer.cpPick = t.getAttribute('data-w207pickc') || null; paintDrawer(); return; }
    if (t.hasAttribute('data-w207act') && S.drawer) { actToggle(S.drawer.goal, t.getAttribute('data-w207act'), t.checked, t); return; }
    if (t.hasAttribute('data-w205pickm') && S.drawer) { S.drawer.msPick = t.getAttribute('data-w205pickm') || null; paintDrawer(); return; }
    if (t.hasAttribute('data-w205focus') && S.drawer) { ownerSet(S.drawer.goal, t.getAttribute('data-w205focus'), true, null, t.value); return; }
  });
  document.addEventListener('focusin', function (e) {
    var t = e.target; if (!t || !t.closest || !t.closest('#w205')) return;
    var card = t.closest('[data-w205goal]'), k = t.getAttribute('data-w205k');
    var g = card ? card.getAttribute('data-w205goal') : null;
    var f = k && !t.readOnly && !t.disabled ? k : null;
    if (g !== S.focus.goal || f !== S.focus.field) { S.focus = { goal: g, field: f }; trackSoon(); }
  });
  document.addEventListener('focusout', function (e) {
    var t = e.target; if (!t || !t.closest || !t.closest('#w205')) return;
    var k = t.getAttribute('data-w205k');
    if (k && S.dirty[k] && t.tagName !== 'SELECT') { clearTimeout(S.timers[k]); save(k); }
    setTimeout(function () { var a = document.activeElement; if (!a || !a.closest || !a.closest('#w205')) { if (S.focus.field || S.focus.goal) { S.focus = { goal: null, field: null }; trackSoon(); } } }, 50);
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && S.drawer) { e.preventDefault(); closeDrawer(); return; }
    var t = e.target; if (!inApp(t)) return;
    if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
      if (t.matches('textarea[data-w205cmt="new"]')) { e.preventDefault(); postComment(null); return; }
      if (t.matches('textarea[data-w205reply]')) { e.preventDefault(); postComment(t.getAttribute('data-w205reply')); return; }
      if (t.matches('textarea[data-w205edit]')) { e.preventDefault(); saveEdit(t.getAttribute('data-w205edit')); return; }
    }
    /* a title and a measure are one line: Enter saves and leaves, like a heading in a document */
    var k = t.getAttribute && t.getAttribute('data-w205k');
    if (k && e.key === 'Enter' && !e.shiftKey && /:(title|measure|baseline|target_fy29|target_fy31)$/.test(k)) { e.preventDefault(); t.blur(); return; }
    if (k && e.key === 'Enter' && !e.shiftKey && /^(target|activity):.*:(owners|reason)$/.test(k)) { e.preventDefault(); t.blur(); return; }
    if ((e.key === 'Enter' || e.key === ' ') && t.matches('[data-w205jump],label[data-w205ownon],[data-w207goto]')) { e.preventDefault(); t.click(); }
  });
