    '#w197sheet .stg button{font-family:' + BODY + ';font-size:12.5px;font-weight:700;border-radius:999px;padding:7px 12px;border:1px solid rgba(16,63,57,.2);background:transparent;color:' + GREEN + ';cursor:pointer;}' +
