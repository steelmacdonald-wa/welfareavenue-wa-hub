    /* the candidate sheet */
    '#w197sheet{position:fixed;inset:0;z-index:9000;display:none;}' +
    '#w197sheet.open{display:block;}' +
    '#w197sheet .bk{position:absolute;inset:0;background:rgba(31,32,30,.38);}' +
