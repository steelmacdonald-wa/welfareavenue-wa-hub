    'html.w200lock,html.w200lock body{overflow:hidden;}' +
    '#w200add{position:fixed;inset:0;z-index:300;background:rgba(16,32,30,.45);display:flex;align-items:flex-start;justify-content:center;padding:5vh 16px 16px;animation:w200in .15s ease-out;}' +
