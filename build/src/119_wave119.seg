    '#w200add .pan > :not(.al){flex:none;}#w200add .ph{display:flex;align-items:flex-start;gap:10px;padding:18px 20px 8px;}#w200add .ph > div{flex:1;min-width:0;}#w200add h3{margin:0;font:700 24px ' + HEAD + ';text-transform:uppercase;letter-spacing:.3px;color:' + GREEN + ';}#w200add .ph p{margin:2px 0 0;font-size:12.5px;color:var(--wa-muted);}' +
    '#w200add .xx{border:none;background:rgba(16,63,57,.07);width:34px;height:34px;border-radius:50%;cursor:pointer;color:' + GREEN + ';font-size:14px;flex:none;}' +
