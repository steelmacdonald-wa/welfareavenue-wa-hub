/* =====================================================================
   WA v119 MTL Volunteering: the event command centre (25/09/26)
   =====================================================================
   Steel: "MTL Volunteering can use some Apple-looking UI and ClickUp
   robustness, dragging and dropping, AI features and any other
   recommendations." Cut 1 of three:
   - The event page becomes one screen: a masthead (date, countdown,
     venue, meals, status) with two readiness rings (checklist, roster)
     and "what's next": the three most urgent unticked steps with a
     one-tap tick.
   - Three columns on a wide screen: the checklist (the same phases and
     steps as before, every handler untouched), the roster as a board
     (one column per role, volunteer cards you drag between roles or in
     from a bench of available volunteers, targets per role, status on
     the card), and a side rail (the event summary, tasks that came
     from meetings, the cancel button).
   - Calendar: a month grid beside the list, each event with its
     readiness and gaps; the next-event hero counts down.
   Everything older keeps working underneath: this wave regroups what
   wave20, 26, 28, 31 and 59 paint, and adds its own roster board on the
   same event_roster rows.
   wave200 (03/10/26), Steel: "This is interface is really difficult to interact with, could you make it easier to work
   with? Also, all team members should be searchable as a volunteer. Also anyone for any position should be searchable for
   all positions." The board's columns count the way The team's line does (on the list of the target, with how many
   confirmed); a card has its status and its role as two plain menus, and the column's + Add opens "Add people", a
   roomy window over the page instead of a box squeezed into the column: the role to add as (any role, switchable),
   one search over every volunteer and every team member (name, phone, email, tag, role), Everyone / Has done this
   role / Team members, Add keeps the window open for the next person (Undo), Enter adds the first match, and
   people already on the serving show where they are. A team member with no volunteer record gets one when added
   (the one record of wave176, linked to their CRM contact by email).
   ===================================================================== */
(function () {
  if (window.__wa119) return; window.__wa119 = true;
  var GREEN = '#103F39', CREAM = '#FFFAF2', GOLD = '#DCA527', FLAG = '#B3402F', TEAL = '#2A8C7A', PURPLE = '#6F64AB';
  var BODY = "'Space Grotesk','Helvetica Neue',Arial,sans-serif";
  var HEAD = "'Barlow Condensed','Arial Narrow','Helvetica Neue',Arial,sans-serif";
  var ROLE_ORDER = ['team_leader', 'cook', 'driver', 'server', 'dishwasher', 'photographer', 'community_talker', 'community_debrief'];
  var TARGET = { team_leader: 2, cook: 4, driver: 2, server: 8, dishwasher: 2, photographer: 1, community_talker: 2, community_debrief: 1 };
  var V = { pend: null, bench: null, benchRole: null, q: '', drag: null, calMonth: null, busy: false, addTab: 'all', addShow: 60, added: [], addBusy: '' };

  var css = document.createElement('style');
  css.id = 'wa119css';
  css.textContent = '' +
    '#w119{font-family:' + BODY + ';}' +
    '#w119 .mast{background:' + GREEN + ';color:' + CREAM + ';border-radius:22px;padding:22px 24px 20px;margin:8px 0 16px;position:relative;overflow:hidden;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:16px 24px;align-items:center;}' +
    '#w119 .mast:before{content:"";position:absolute;right:-80px;top:-110px;width:320px;height:320px;border-radius:50%;background:radial-gradient(closest-side,rgba(111,100,171,.5),rgba(111,100,171,0));pointer-events:none;}' +
    '#w119 .mast .k{font-size:11px;letter-spacing:1.6px;text-transform:uppercase;color:' + GOLD + ';font-weight:700;margin:0 0 4px;}' +
    '#w119 .mast h3{font-family:' + HEAD + ';font-size:36px;line-height:1;margin:0 0 6px;color:' + CREAM + ';letter-spacing:.3px;font-weight:700;}' +
    '#w119 .mast .meta{font-size:13px;color:rgba(255,250,242,.85);display:flex;gap:14px;flex-wrap:wrap;align-items:center;}' +
    '#w119 .mast .meta .st{display:inline-block;font-size:10.5px;letter-spacing:.6px;text-transform:uppercase;font-weight:800;border-radius:999px;padding:3px 10px;background:' + GOLD + ';color:' + GREEN + ';}' +
    '#w119 .mast .meta .st.cancelled{background:' + FLAG + ';color:' + CREAM + ';}#w119 .mast .meta .st.completed{background:' + TEAL + ';color:' + CREAM + ';}' +
    '#w119 .mast .cd{font-family:' + HEAD + ';font-size:15px;color:' + CREAM + ';}' +
    '#w119 .mast .cd b{font-size:22px;color:' + GOLD + ';}' +
    '#w119 .rings{display:flex;gap:18px;position:relative;}' +
    '#w119 .ring{display:flex;flex-direction:column;align-items:center;gap:4px;font-size:11px;color:rgba(255,250,242,.85);letter-spacing:.4px;text-transform:uppercase;font-weight:700;}' +
    '#w119 .ring svg{width:74px;height:74px;transform:rotate(-90deg);}' +
    '#w119 .ring circle{fill:none;stroke-width:7;}' +
    '#w119 .ring .bg{stroke:rgba(255,250,242,.18);}' +
    '#w119 .ring .fg{stroke:' + GOLD + ';stroke-linecap:round;transition:stroke-dasharray .5s ease;}' +
    '#w119 .ring .fg.ok{stroke:' + TEAL + ';}' +
    '#w119 .ring .v{position:absolute;font-family:' + HEAD + ';font-size:19px;color:' + CREAM + ';margin-top:24px;}' +
    '#w119 .ring .wrap{position:relative;display:flex;justify-content:center;}' +
    '#w119 .mast .acts{grid-column:1 / -1;display:flex;gap:8px;flex-wrap:wrap;align-items:center;}' +
    '#w119 .mast .acts .btn{background:rgba(255,250,242,.14);color:' + CREAM + ';border:none;}' +
    '#w119 .mast .acts .btn:hover{background:rgba(255,250,242,.24);}' +
    '#w119 .mast .acts .btn.warn{background:rgba(179,64,47,.55);}' +
    /* what's next */
    '#w119 .next{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:10px;margin:0 0 16px;}' +
    '#w119 .next .n{background:#FFFAF2;border:1px solid rgba(16,63,57,.10);border-radius:14px;padding:11px 13px;display:grid;grid-template-columns:24px minmax(0,1fr);gap:10px;align-items:start;box-shadow:0 8px 20px -18px rgba(16,63,57,.6);}' +
    '#w119 .next .n .tk{width:20px;height:20px;border-radius:7px;border:1.5px solid rgba(16,63,57,.35);cursor:pointer;margin-top:1px;}' +
