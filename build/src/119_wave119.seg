    '#w119 .rc .h .n{font-size:11px;color:var(--wa-muted);font-weight:700;}' +
    '#w119 .rc .h .n.short{color:' + FLAG + ';}' +
    '#w119 .rc .h .n.full{color:' + TEAL + ';}' +
    '#w119 .rc .add{border:none;border-radius:999px;background:' + GREEN + ';color:' + CREAM + ';font:700 12px ' + BODY + ';padding:5px 11px;line-height:1.2;cursor:pointer;flex:none;white-space:nowrap;}#w119 .rc .add:hover{background:#0b2e29;}' +
    '#w119 .pc{background:#FFFAF2;border-radius:12px;padding:8px 9px;margin:0 0 7px;box-shadow:0 6px 16px -14px rgba(16,63,57,.7);cursor:grab;position:relative;font-size:12.5px;}' +
    '#w119 .pc:active{cursor:grabbing;}' +
    '#w119 .pc.dragging{opacity:.4;}' +
    '#w119 .pc b{display:block;font-size:13px;line-height:1.25;color:var(--wa-text);padding-right:16px;}' +
    '#w119 .pc .x{position:absolute;top:6px;right:7px;font-size:11px;color:var(--wa-muted);cursor:pointer;background:none;border:none;padding:0;}' +
    '#w119 .pc .x:hover{color:' + FLAG + ';}' +
    '#w119 .pc select{width:100%;margin-top:6px;border:none;border-radius:999px;padding:4px 8px;font-size:11px;font-weight:800;letter-spacing:.3px;font-family:' + BODY + ';background:rgba(16,63,57,.08);color:' + GREEN + ';appearance:none;-webkit-appearance:none;cursor:pointer;}' +
    '#w119 .pc.s-confirmed select{background:rgba(42,140,122,.18);color:#1c6b5d;}' +
    '#w119 .pc.s-waiting select{background:rgba(220,165,39,.22);color:#6b4d05;}' +
    '#w119 .pc.s-unavailable select,#w119 .pc.s-cancelled select{background:rgba(179,64,47,.12);color:' + FLAG + ';}' +
    '#w119 .pc .c{display:block;font-size:11px;color:var(--wa-muted);margin-top:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}' +
