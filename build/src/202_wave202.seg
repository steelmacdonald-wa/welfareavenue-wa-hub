      + '.w202spc .w152in{font-size:12.5px;padding:6px 8px;}'
      + '.w202spadd{all:unset;cursor:pointer;box-sizing:border-box;aspect-ratio:4/3;border:2px dashed rgba(16,63,57,.25);border-radius:10px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;color:' + GREEN + ';font-size:13px;font-weight:600;}.w202spadd:hover{border-color:' + GOLD + ';}.w202spadd .w202i{width:24px;height:24px;}'
