      + '.w202chip.t{background:rgba(42,140,122,.14);color:#1e6b5d;}.w202chip.x{background:rgba(179,64,47,.12);color:' + FLAG + ';}'
      + '.w202ca{display:flex;flex-wrap:wrap;gap:6px;padding:12px 16px 14px;margin-top:auto;}'
