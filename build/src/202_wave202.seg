      + '.w202trow .w202mini{min-height:70px;padding:10px 12px;border:0;}.w202trow .w202mini b{font-size:15px;}.w202trow>span{display:flex;flex-direction:column;gap:2px;padding:8px 10px 8px 0;}.w202trow b{color:' + GREEN + ';font-size:14px;}.w202trow .m{font-size:12.5px;line-height:1.35;}'
      + '.w202trow.on{border-color:' + GOLD + ';box-shadow:0 0 0 2px ' + GOLD + ' inset;}.w202trow:focus-visible{outline:2px solid ' + GOLD + ';}'
      + '.w202tsel{display:grid;grid-template-columns:150px minmax(0,1fr);gap:14px;align-items:center;margin-bottom:8px;}.w202tsel .w202mini{border-radius:12px;border:1px solid rgba(16,63,57,.1);}.w202tsel h3{font-size:22px;}'
