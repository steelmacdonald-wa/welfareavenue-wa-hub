      + '.w202mini b{font-family:' + HEAD + ';font-weight:500;font-size:22px;line-height:1.02;text-transform:uppercase;color:' + GREEN + ';}.w202mini.g b{color:' + CREAM + ';}.w202mini b.a{color:' + GOLD + ';}'
      + '.w202cb{padding:12px 16px 4px;display:flex;flex-direction:column;gap:3px;}.w202cb b{font-size:15px;color:' + GREEN + ';}.w202cb .m{font-size:13px;line-height:1.4;}'
