      + '.w202way .w202i{width:26px;height:26px;color:' + GOLD + ';}.w202way b{font-family:' + HEAD + ';font-size:22px;text-transform:uppercase;color:' + GREEN + ';font-weight:600;letter-spacing:.3px;}.w202way span{font-size:13.5px;line-height:1.45;color:var(--wa-muted,' + MUTED + ');}'
