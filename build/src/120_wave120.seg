/* =====================================================================
   WA v120 Marketing analytics (25/09/26)
   =====================================================================
   Steel: "Can the marketing department have a new page that reads
   analytics from our Meta insights dashboard, TikTok, LinkedIn etc?"
   One page under Marketing, Branding & Web: a tile per platform
   (followers with the change over the period, reach, views, engagement,
   a 90 day sparkline), one chart across platforms, the AI's weekly note,
   the posts that worked, and a set-up drawer for staff: Meta connects
   with the system user token in the vault, GA4 with the hub's service
   account, TikTok and LinkedIn take their CSV exports until their APIs
   are approved. Data: social_overview() (wa120), social-pull v1.
   ===================================================================== */
(function () {
  if (window.__wa120) return; window.__wa120 = true;
  var GREEN = '#103F39', CREAM = '#FFFAF2', GOLD = '#DCA527', FLAG = '#B3402F', TEAL = '#2A8C7A', PURPLE = '#6F64AB';
  var BODY = "'Space Grotesk','Helvetica Neue',Arial,sans-serif";
  var HEAD = "'Barlow Condensed','Arial Narrow','Helvetica Neue',Arial,sans-serif";
  var P = {
    instagram: { label: 'Instagram', color: '#C13584', mark: 'IG', head: 'followers', stats: ['reach', 'views', 'engagement'] },
    facebook: { label: 'Facebook', color: '#1877F2', mark: 'f', head: 'followers', stats: ['reach', 'views', 'engagement'] },
    tiktok: { label: 'TikTok', color: '#111111', mark: 'TT', head: 'followers', stats: ['views', 'likes', 'shares'] },
    linkedin: { label: 'LinkedIn', color: '#0A66C2', mark: 'in', head: 'followers', stats: ['reach', 'views', 'engagement'] },
    ga4: { label: 'Website', color: TEAL, mark: 'W', head: 'sessions', stats: ['users', 'pageviews', 'sessions_social'] },
    youtube: { label: 'YouTube', color: '#FF0000', mark: 'YT', head: 'followers', stats: ['views', 'likes', 'comments'] }
  };
  var ORDER = ['instagram', 'facebook', 'tiktok', 'linkedin', 'ga4'];
  var MLABEL = { followers: 'Followers', new_followers: 'New followers', unfollows: 'Unfollows', reach: 'Reach', views: 'Views', video_views: 'Video views', profile_views: 'Profile visits', engagement: 'Engagement', accounts_engaged: 'Accounts engaged', likes: 'Likes', comments: 'Comments', shares: 'Shares', saves: 'Saves', clicks: 'Clicks', posts: 'Posts', sessions: 'Sessions', users: 'Visitors', new_users: 'New visitors', pageviews: 'Page views', sessions_social: 'From social' };
  var CHART_METRICS = ['reach', 'views', 'engagement', 'new_followers', 'sessions'];
  var S = { days: 30, data: null, loading: false, err: null, filter: null, setup: false, status: null, probe: null, csv: null, chart: 'reach', busy: {} };

  var css = document.createElement('style'); css.id = 'wa120css';
  css.textContent = '' +
    '#socialstats{font-family:' + BODY + ';}' +
    '#socialstats .w120wrap{max-width:1180px;}' +
    '#socialstats .w120ctl{display:flex;align-items:center;gap:8px;flex-wrap:wrap;}' +
    '#socialstats .w120ctl .meta{font-size:12px;color:var(--wa-muted);}' +
    '#socialstats .w120tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(215px,1fr));gap:12px;margin:0 0 16px;}' +
    '#socialstats .tile{background:#fff;border:1px solid rgba(16,63,57,.10);border-radius:18px;padding:14px 15px 12px;box-shadow:0 12px 28px -22px rgba(16,63,57,.55);position:relative;overflow:hidden;min-height:150px;display:flex;flex-direction:column;}' +
    '#socialstats .tile .ph{display:flex;align-items:center;gap:8px;margin:0 0 8px;}' +
    '#socialstats .tile .mk{width:26px;height:26px;border-radius:9px;display:inline-flex;align-items:center;justify-content:center;font-family:' + HEAD + ';font-size:12px;font-weight:800;color:#fff;letter-spacing:.3px;flex:none;}' +
    '#socialstats .tile .ph b{font-family:' + HEAD + ';font-size:17px;color:' + GREEN + ';letter-spacing:.3px;}' +
    '#socialstats .tile .ph .st{margin-left:auto;font-size:10px;letter-spacing:.6px;text-transform:uppercase;font-weight:800;border-radius:999px;padding:2px 8px;background:rgba(42,140,122,.14);color:#1c6b5d;white-space:nowrap;}' +
    '#socialstats .tile .ph .st.csv{background:rgba(220,165,39,.2);color:#6b4d05;}#socialstats .tile .ph .st.off{background:rgba(16,63,57,.08);color:var(--wa-muted);}#socialstats .tile .ph .st.err{background:rgba(179,64,47,.12);color:' + FLAG + ';}' +
    '#socialstats .tile .big{font-family:' + HEAD + ';font-size:36px;line-height:1;color:' + GREEN + ';display:flex;align-items:baseline;gap:8px;flex-wrap:wrap;}' +
    '#socialstats .tile .big small{font-family:' + BODY + ';font-size:11px;font-weight:700;letter-spacing:.8px;text-transform:uppercase;color:var(--wa-muted);}' +
    '#socialstats .d{display:inline-block;font-family:' + BODY + ';font-size:11px;font-weight:800;border-radius:999px;padding:2px 7px;background:rgba(42,140,122,.14);color:#1c6b5d;vertical-align:middle;}' +
    '#socialstats .d.down{background:rgba(179,64,47,.12);color:' + FLAG + ';}#socialstats .d.flat{background:rgba(16,63,57,.08);color:var(--wa-muted);}' +
    '#socialstats .tile .row{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px;margin:10px 0 0;}' +
    '#socialstats .tile .row div{font-size:11px;color:var(--wa-muted);line-height:1.25;}' +
    '#socialstats .tile .row b{display:block;font-family:' + HEAD + ';font-size:17px;color:var(--wa-text);}' +
    '#socialstats .tile svg.sp{width:100%;height:34px;margin:8px 0 0;display:block;}' +
    '#socialstats .tile .off{font-size:12px;color:var(--wa-muted);margin:6px 0 0;line-height:1.4;}' +
    '#socialstats .tile .off a{color:' + GREEN + ';font-weight:700;cursor:pointer;text-decoration:underline;}' +
    '#socialstats .cardy{background:#fff;border:1px solid rgba(16,63,57,.10);border-radius:18px;padding:16px 18px;margin:0 0 16px;box-shadow:0 12px 28px -22px rgba(16,63,57,.55);}' +
    '#socialstats .cardy h4{font-family:' + HEAD + ';font-size:21px;margin:0 0 10px;color:' + GREEN + ';display:flex;align-items:center;gap:10px;flex-wrap:wrap;}' +
    '#socialstats .cardy h4 .w116seg{margin-left:auto;}#socialstats .cardy h4 .w116seg a{padding:5px 11px;font-size:12px;}' +
    '#socialstats .chart{position:relative;}#socialstats .chart svg{width:100%;height:220px;display:block;}' +
    '#socialstats .chart .lg{display:flex;gap:12px;flex-wrap:wrap;margin:8px 0 0;font-size:12px;color:var(--wa-muted);}' +
    '#socialstats .chart .lg i{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:5px;vertical-align:-1px;}' +
    '#socialstats .chart .none{font-size:13px;color:var(--wa-muted);padding:40px 0;text-align:center;}' +
    '#socialstats .note{background:' + GREEN + ';color:' + CREAM + ';border-radius:18px;padding:18px 22px;margin:0 0 16px;position:relative;overflow:hidden;}' +
    '#socialstats .note:before{content:"";position:absolute;right:-60px;top:-90px;width:260px;height:260px;border-radius:50%;background:radial-gradient(closest-side,rgba(220,165,39,.45),rgba(220,165,39,0));pointer-events:none;}' +
    '#socialstats .note .k{font-size:11px;letter-spacing:1.6px;text-transform:uppercase;color:' + GOLD + ';font-weight:700;margin:0 0 6px;}' +
    '#socialstats .note p{font-size:15px;line-height:1.55;margin:0;max-width:820px;position:relative;}' +
    '#socialstats .note .m{font-size:11.5px;color:rgba(255,250,242,.7);margin:8px 0 0;display:flex;gap:10px;align-items:center;flex-wrap:wrap;}' +
    '#socialstats .note .btn{background:rgba(255,250,242,.14);color:' + CREAM + ';border:none;}' +
    '#socialstats .posts{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:12px;}' +
    '#socialstats .post{background:#fff;border:1px solid rgba(16,63,57,.10);border-radius:16px;overflow:hidden;box-shadow:0 10px 24px -20px rgba(16,63,57,.5);display:flex;flex-direction:column;text-decoration:none;color:inherit;}' +
    '#socialstats .post .th{aspect-ratio:16/10;background:rgba(16,63,57,.06);position:relative;display:flex;align-items:center;justify-content:center;}' +
    '#socialstats .post .th img{width:100%;height:100%;object-fit:cover;display:block;}' +
    '#socialstats .post .th .mk{position:absolute;left:10px;top:10px;width:26px;height:26px;border-radius:9px;display:inline-flex;align-items:center;justify-content:center;font-family:' + HEAD + ';font-size:12px;font-weight:800;color:#fff;box-shadow:0 2px 6px rgba(0,0,0,.25);}' +
    '#socialstats .post .th .big{font-family:' + HEAD + ';font-size:30px;color:rgba(16,63,57,.25);}' +
    '#socialstats .post .bd{padding:10px 12px 12px;display:flex;flex-direction:column;gap:6px;flex:1;}' +
    '#socialstats .post .cap{font-size:13px;line-height:1.35;color:var(--wa-text);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;}' +
    '#socialstats .post .when{font-size:11px;color:var(--wa-muted);}' +
    '#socialstats .post .nums{display:flex;gap:10px;flex-wrap:wrap;margin-top:auto;font-size:11px;color:var(--wa-muted);}' +
    '#socialstats .post .nums b{font-family:' + HEAD + ';font-size:15px;color:' + GREEN + ';margin-right:3px;}' +
    '#socialstats .fchips{display:flex;gap:6px;flex-wrap:wrap;margin:0 0 12px;}' +
    '#socialstats .fchips span{font-size:12px;font-weight:700;border-radius:999px;padding:5px 12px;background:rgba(16,63,57,.07);color:' + GREEN + ';cursor:pointer;}' +
    '#socialstats .fchips span.on{background:' + GREEN + ';color:' + CREAM + ';}' +
    '#socialstats .empty{font-size:13px;color:var(--wa-muted);padding:18px 0;text-align:center;}' +
    '#socialstats .hero{background:#fff;border:1px dashed rgba(16,63,57,.25);border-radius:18px;padding:34px 24px;text-align:center;margin:0 0 16px;}' +
    '#socialstats .hero h3{font-family:' + HEAD + ';font-size:28px;margin:0 0 6px;color:' + GREEN + ';}' +
    '#socialstats .hero p{font-size:13.5px;color:var(--wa-muted);margin:0 auto 14px;max-width:560px;line-height:1.5;}' +
    /* set-up drawer */
    '#socialstats .setup{background:' + CREAM + ';border:1px solid rgba(16,63,57,.14);border-radius:18px;padding:16px 18px;margin:0 0 16px;}' +
    '#socialstats .setup h4{font-family:' + HEAD + ';font-size:21px;margin:0 0 4px;color:' + GREEN + ';}' +
    '#socialstats .setup .sub{font-size:12.5px;color:var(--wa-muted);margin:0 0 12px;}' +
    '#socialstats .setup .sgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:12px;}' +
    '#socialstats .sc{background:#fff;border:1px solid rgba(16,63,57,.10);border-radius:14px;padding:12px 14px;}' +
    '#socialstats .sc h5{font-family:' + HEAD + ';font-size:17px;margin:0 0 6px;color:' + GREEN + ';display:flex;align-items:center;gap:8px;}' +
    '#socialstats .sc p{font-size:12.5px;color:var(--wa-muted);margin:0 0 8px;line-height:1.45;}' +
    '#socialstats .sc code{font-size:11.5px;background:rgba(16,63,57,.07);border-radius:6px;padding:2px 6px;user-select:all;}' +
    '#socialstats .sc input[type=text],#socialstats .sc select{padding:7px 10px;border:1px solid rgba(16,63,57,.2);border-radius:10px;font-size:12.5px;font-family:' + BODY + ';margin:0 6px 6px 0;max-width:100%;}' +
    '#socialstats .sc .acc{display:grid;grid-template-columns:minmax(0,1fr) auto auto;gap:3px 6px;align-items:center;font-size:12.5px;padding:7px 0;border-top:1px solid rgba(16,63,57,.08);}' +
    '#socialstats .sc .acc b{font-weight:700;display:block;}#socialstats .sc .acc .s{display:block;font-size:11px;color:var(--wa-muted);}#socialstats .sc .acc .er{grid-column:1 / -1;color:' + FLAG + ';font-size:11px;line-height:1.35;}' +
    '#socialstats .sc .acc .btn{font-size:11px;padding:4px 9px;}' +
    '#socialstats .sc .pg{display:flex;align-items:center;gap:8px;font-size:12.5px;padding:6px 0;}' +
    '#socialstats .sc .pg img{width:28px;height:28px;border-radius:50%;}' +
    '#socialstats .map{display:grid;grid-template-columns:auto minmax(0,1fr);gap:6px 10px;align-items:center;font-size:12px;margin:8px 0;}' +
    '#socialstats .map label{color:var(--wa-muted);font-weight:700;}' +
    '#socialstats .btn.mini{font-size:11.5px;padding:5px 10px;}' +
    '#socialstats .btn.ghost{background:rgba(16,63,57,.08);color:' + GREEN + ';}' +
    '@media (min-width:1120px){#socialstats .w120tiles{grid-template-columns:repeat(5,minmax(0,1fr));}}' +
    '@media (max-width:700px){#socialstats .tile .big{font-size:30px;}#socialstats .cardy h4 .w116seg{margin-left:0;}}';
  document.head.appendChild(css);

  /* ---------- helpers ---------- */
  function E(s) { return (typeof esc === 'function') ? esc(s) : String(s == null ? '' : s); }
  function toastS(t) { try { toast(t); } catch (e) { /* fine */ } }
  function staff() { try { return typeof isStaff === 'function' && isStaff(); } catch (e) { return false; } }
  function board() { try { return typeof MODE !== 'undefined' && MODE === 'board'; } catch (e) { return false; } }
  function allowed() { return staff() || board(); }
  function num(v) { v = Number(v); if (!isFinite(v)) return '\u2013'; var a = Math.abs(v); if (a >= 1e6) return (v / 1e6).toFixed(1).replace(/\.0$/, '') + 'M'; if (a >= 1e4) return Math.round(v / 1e3) + 'k'; if (a >= 1e3) return (v / 1e3).toFixed(1).replace(/\.0$/, '') + 'k'; return String(Math.round(v)); }
  function delta(cur, prev, abs) {
    if (cur == null || prev == null) return '';
    cur = Number(cur); prev = Number(prev);
    if (abs) { var d = cur - prev; if (!d) return '<span class="d flat">no change</span>'; return '<span class="d' + (d < 0 ? ' down' : '') + '">' + (d > 0 ? '+' : '\u2212') + num(Math.abs(d)) + '</span>'; }
    if (!prev) return cur ? '<span class="d">new</span>' : '';
    var pc = Math.round((cur - prev) / prev * 100);
    if (!pc) return '<span class="d flat">0%</span>';
    return '<span class="d' + (pc < 0 ? ' down' : '') + '">' + (pc > 0 ? '+' : '\u2212') + Math.abs(pc) + '%</span>';
  }
  function ago(iso) { if (!iso) return 'never'; var m = Math.round((Date.now() - new Date(iso).getTime()) / 60000); if (m < 2) return 'just now'; if (m < 60) return m + ' min ago'; var h = Math.round(m / 60); if (h < 36) return h + ' h ago'; return Math.round(h / 24) + ' days ago'; }
  function niceDay(iso) { try { return new Date(String(iso).slice(0, 10) + 'T12:00:00').toLocaleDateString('en-CA', { month: 'short', day: 'numeric' }); } catch (e) { return iso; } }
  function mark(p, size) { var c = P[p] || { color: GREEN, mark: '?' }; return '<span class="mk" style="background:' + c.color + (size ? ';width:' + size + 'px;height:' + size + 'px' : '') + '">' + E(c.mark) + '</span>'; }
  function acctOf(p) { var d = S.data; return ((d && d.accounts) || []).filter(function (a) { return a.platform === p; })[0] || null; }
  function series(p, metric) { var d = S.data; var s = d && d.series && d.series[p] && d.series[p][metric]; return Array.isArray(s) ? s : []; }
  function windowed(pts) { var from = S.data && S.data.from; return from ? pts.filter(function (x) { return x[0] >= from; }) : pts; }
  function spark(pts, color) {
    if (!pts || pts.length < 2) return '';
    var w = 200, h = 34, vals = pts.map(function (x) { return Number(x[1]) || 0; }); var mn = Math.min.apply(null, vals), mx = Math.max.apply(null, vals); var span = (mx - mn) || 1;
    var d = vals.map(function (v, i) { return (i / (vals.length - 1) * w).toFixed(1) + ',' + (h - 3 - (v - mn) / span * (h - 8)).toFixed(1); });
    return '<svg class="sp" viewBox="0 0 ' + w + ' ' + h + '" preserveAspectRatio="none"><polyline fill="none" stroke="' + color + '" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" points="' + d.join(' ') + '"></polyline><circle r="3" cx="' + w + '" cy="' + d[d.length - 1].split(',')[1] + '" fill="' + color + '"></circle></svg>';
  }
  function fn(body) {
    try { return db.functions.invoke('social-pull', { body: body }).then(function (r) { if (r.error) throw r.error; if (r.data && r.data.error) throw new Error(r.data.error); return r.data; }); }
    catch (e) { return Promise.reject(e); }
  }

  /* ---------- the panel ---------- */
  function panel() {
    var sec = document.getElementById('socialstats');
    if (!sec) { var main = document.querySelector('main'); if (!main) return null; sec = document.createElement('section'); sec.id = 'socialstats'; sec.className = 'panel'; main.appendChild(sec); }
    return sec;
  }
  async function load(force) {
    if (S.loading) return;
    if (!force && S.data && S.at && Date.now() - S.at < 60000 && S.data.days === S.days) { paint(); return; }
    S.loading = true; S.err = null;
    if (force || !S.data) paint();
    try {
      var r = await db.rpc('social_overview', { p_days: S.days });
      if (r.error) throw r.error;
      S.data = r.data || {}; S.at = Date.now();
    } catch (e) { S.err = e.message || String(e); }
    S.loading = false;
    paint();
  }
  function header() {
    var d = S.data; var last = null;
    ((d && d.accounts) || []).forEach(function (a) { if (a.last_sync_at && (!last || a.last_sync_at > last)) last = a.last_sync_at; });
    return '<div class="w116crumb"><a data-w116go="#mypage">Home</a> &middot; Departments &middot; <a data-w116go="#team/marketing">Marketing, Branding &amp; Web</a> &middot; Analytics</div>' +
      '<div class="w116top"><div><h2><span class="dot" style="background:' + PURPLE + '"></span>Marketing analytics</h2><p class="sub">Followers, reach and what worked across Instagram, Facebook, TikTok, LinkedIn and the website. Numbers refresh every morning.</p></div>' +
      '<div class="w120ctl"><span class="w116seg">' + [7, 30, 90].map(function (n) { return '<a data-w120days="' + n + '" class="' + (S.days === n ? 'on' : '') + '">' + n + ' days</a>'; }).join('') + '</span>' +
      (staff() ? '<button class="btn mini ghost" data-w120sync="all"' + (S.busy.sync ? ' disabled' : '') + '>' + (S.busy.sync ? 'Syncing\u2026' : 'Sync now') + '</button><button class="btn mini' + (S.setup ? '' : ' ghost') + '" data-w120setup="toggle">' + (S.setup ? 'Close set-up' : 'Set up') + '</button>' : '') +
      '<span class="meta">' + (last ? 'Last sync ' + E(ago(last)) : '') + '</span></div></div>';
  }
  function tile(p) {
    var c = P[p]; var a = acctOf(p); var d = S.data || {}; var tot = (d.totals || {})[p] || {}; var fol = (d.followers || {})[p];
    var st = !a ? '<span class="st off">Not connected</span>' : a.status === 'error' ? '<span class="st err" title="' + E(a.last_error || '') + '">Check</span>' : a.status === 'csv' ? '<span class="st csv">CSV</span>' : '<span class="st">Live</span>';
    var html = '<div class="tile"><div class="ph">' + mark(p) + '<b>' + E(c.label) + (a && a.handle ? ' <span style="font-family:' + BODY + ';font-size:11.5px;font-weight:500;color:var(--wa-muted)">@' + E(a.handle) + '</span>' : '') + '</b>' + st + '</div>';
    if (!a) {
      html += '<div class="big" style="color:var(--wa-muted)">\u2013</div><div class="off">' + (staff() ? '<a data-w120setup="1">Connect ' + E(c.label) + '</a>' + (p === 'tiktok' || p === 'linkedin' ? ' (CSV export until the API is approved)' : '') : 'Not connected yet.') + '</div></div>';
      return html;
    }
    if (c.head === 'followers') {
      html += '<div class="big">' + (fol && fol.now != null ? num(fol.now) : '\u2013') + '<small>followers</small>' + (fol ? delta(fol.now, fol.then, true) : '') + '</div>';
    } else {
      var s = tot.sessions || {};
      html += '<div class="big">' + (s.cur != null ? num(s.cur) : '\u2013') + '<small>sessions</small>' + delta(s.cur, s.prev) + '</div>';
    }
    html += '<div class="row">' + c.stats.map(function (m) { var t = tot[m] || {}; return '<div><b>' + (t.cur != null ? num(t.cur) : '\u2013') + '</b>' + E(MLABEL[m] || m) + ' ' + delta(t.cur, t.prev) + '</div>'; }).join('') + '</div>';
    var sp = c.head === 'followers' ? series(p, 'followers') : series(p, 'sessions');
    if (sp.length < 2) sp = series(p, c.stats[0]);
    html += spark(windowed(sp).length > 1 ? windowed(sp) : sp, c.color);
    html += '<div class="off" style="font-size:11px">' + E(ago(a.last_sync_at)) + (a.status === 'error' && a.last_error ? ' \u00b7 ' + E(String(a.last_error).slice(0, 90)) : '') + '</div></div>';
    return html;
  }
  function chart() {
    var d = S.data || {}; var m = S.chart;
    var lines = []; var maxV = 0; var from = d.from || '', to = d.to || '';
    ORDER.forEach(function (p) { var pts = windowed(series(p, m)); if (pts.length > 1) { lines.push({ p: p, pts: pts }); pts.forEach(function (x) { maxV = Math.max(maxV, Number(x[1]) || 0); }); } });
    var seg = '<span class="w116seg">' + CHART_METRICS.map(function (k) { return '<a data-w120chart="' + k + '" class="' + (S.chart === k ? 'on' : '') + '">' + E(MLABEL[k] || k) + '</a>'; }).join('') + '</span>';
    if (!lines.length) return '<div class="cardy chart"><h4>By day' + seg + '</h4><div class="none">No daily ' + E((MLABEL[m] || m).toLowerCase()) + ' numbers in this window yet.</div></div>';
    var w = 800, h = 220, padL = 36, padB = 22, padT = 10;
    var t0 = new Date(from + 'T00:00:00Z').getTime(), t1 = new Date(to + 'T00:00:00Z').getTime(); var span = (t1 - t0) || 1;
    function X(day) { return padL + (new Date(day + 'T00:00:00Z').getTime() - t0) / span * (w - padL - 8); }
    function Y(v) { return padT + (1 - (Number(v) || 0) / (maxV || 1)) * (h - padT - padB); }
