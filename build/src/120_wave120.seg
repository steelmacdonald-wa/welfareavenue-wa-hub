    if ((el = t.closest('[data-w120f]'))) { S.filter = el.getAttribute('data-w120f') || null; paint(); return; }
    if ((el = t.closest('[data-w120setup]'))) { e.preventDefault(); S.setup = el.getAttribute('data-w120setup') === 'toggle' ? !S.setup : true; paint(); if (S.setup && !S.status) { try { S.status = await fn({ action: 'status' }); } catch (e2) { S.status = { error: e2.message }; } paint(); } return; }
    if ((el = t.closest('[data-w120sync]'))) { var id = el.getAttribute('data-w120sync'); S.busy.sync = true; paint(); try { var r = await fn(id === 'all' ? { action: 'sync' } : { action: 'sync', account_id: Number(id) }); var bad = (r.results || []).filter(function (x) { return x.error; }); toastS(bad.length ? 'Synced with ' + bad.length + ' problem' + (bad.length > 1 ? 's' : '') + ': ' + bad[0].error : 'Synced ' + (r.results || []).length + ' account' + ((r.results || []).length === 1 ? '' : 's')); } catch (e3) { toastS('Sync failed: ' + e3.message); } S.busy.sync = false; S.data = null; load(true); return; }
    if ((el = t.closest('[data-w120note]'))) { S.busy.note = true; paint(); try { var n = await fn({ action: 'note', days: Math.min(30, S.days) }); toastS(n.note ? 'Note written' : (n.skipped || 'Nothing to write yet')); } catch (e4) { toastS('Could not write it: ' + e4.message); } S.busy.note = false; S.data = null; load(true); return; }
    if ((el = t.closest('[data-w120probe]'))) { S.busy.probe = true; paint(); try { S.probe = await fn({ action: 'probe' }); } catch (e5) { S.probe = { meta: { ok: false, error: e5.message } }; } S.busy.probe = false; paint(); return; }
    if ((el = t.closest('[data-w120connect]'))) { S.busy.connect = true; paint(); try { var c = await fn({ action: 'connect_meta', page_id: el.getAttribute('data-w120connect') }); var probs = (c.results || []).filter(function (x) { return x.error; }); toastS('Connected ' + (c.added || []).length + ' account' + ((c.added || []).length === 1 ? '' : 's') + (probs.length ? '; first sync had a problem: ' + probs[0].error : ' and pulled the first numbers')); } catch (e6) { toastS('Could not connect: ' + e6.message); } S.busy.connect = false; S.probe = null; S.status = null; S.data = null; load(true); return; }
    if ((el = t.closest('[data-w120ga]'))) { var pid = (document.getElementById('w120gaid') || {}).value || ''; var site = (document.getElementById('w120gasite') || {}).value || ''; if (!pid.replace(/\D/g, '')) { toastS('Property id first'); return; } S.busy.ga = true; paint(); try { var g = await fn({ action: 'connect_ga4', property_id: pid, site: site }); toastS(g.ok ? 'Google Analytics connected' : 'Connected, but the first read failed: ' + ((g.result || {}).error || '')); } catch (e7) { toastS('Could not connect: ' + e7.message); } S.busy.ga = false; S.status = null; S.data = null; load(true); return; }
    if ((el = t.closest('[data-w120rm]'))) { if (!confirm('Remove this account and every number the hub pulled for it?')) return; try { await fn({ action: 'disconnect', account_id: Number(el.getAttribute('data-w120rm')) }); toastS('Removed'); } catch (e8) { toastS('Could not remove: ' + e8.message); } S.data = null; load(true); return; }
    if ((el = t.closest('[data-w120csvx]'))) { S.csv = null; paint(); return; }
    if ((el = t.closest('[data-w120import]'))) { if (!S.csv) return; var body; try { body = buildImport(S.csv); } catch (e9) { toastS(e9.message); return; } S.busy.import = true; paint(); try { var im = await fn(body); toastS('Imported ' + (im.rows || 0) + ' numbers and ' + (im.posts || 0) + ' posts'); S.csv = null; } catch (e10) { toastS('Import failed: ' + e10.message); } S.busy.import = false; S.data = null; load(true); return; }
  }, true);
  document.addEventListener('change', function (e) {
    var t = e.target; if (!t || !t.closest || !t.closest('#socialstats')) return;
    if (t.getAttribute('data-w120csv')) {
      var p = t.getAttribute('data-w120csv'); var f = t.files && t.files[0]; if (!f) return;
      var kindSel = document.querySelector('#socialstats [data-w120csvkind="' + p + '"]'); var kind = kindSel ? kindSel.value : 'daily';
      var rd = new FileReader();
      rd.onload = function () { var rows = parseCsv(rd.result); if (rows.length < 2) { toastS('That file has no rows'); return; } var cols = rows[0].map(function (c) { return String(c).trim(); }); S.csv = { platform: p, kind: kind, name: f.name, cols: cols, rows: rows.slice(1), guess: guessMap(cols, kind), handle: (acctOf(p) || {}).handle || '' }; paint(); };
      rd.readAsText(f);
      return;
    }
    if (t.getAttribute('data-w120csvkind') && S.csv && S.csv.platform === t.getAttribute('data-w120csvkind')) { S.csv.kind = t.value; S.csv.guess = guessMap(S.csv.cols, t.value); paint(); }
  });
  window.w120Debug = function () { return { days: S.days, loaded: !!S.data, accounts: S.data ? (S.data.accounts || []).length : null, setup: S.setup }; };
})();
