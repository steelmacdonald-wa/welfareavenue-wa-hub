    tiktok: { label: 'TikTok', color: '#111111', mark: 'TT', head: 'followers', stats: ['views', 'likes', 'shares'] },
    linkedin: { label: 'LinkedIn', color: '#0A66C2', mark: 'in', head: 'followers', stats: ['reach', 'views', 'engagement'] },
