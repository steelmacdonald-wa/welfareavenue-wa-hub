  /* wave129: ranges from a week to everything the platforms kept, or two dates */
  var RANGES = [['7', '7 days'], ['30', '30 days'], ['90', '90 days'], ['182', '6 months'], ['365', '1 year'], ['730', '2 years'], ['all', 'All time'], ['custom', 'Custom']];
  function ymdTz(d) { try { return d.toLocaleDateString('en-CA', { timeZone: 'America/Toronto' }); } catch (e) { return d.toISOString().slice(0, 10); } }
  function rangeDates() {
    var now = new Date(), to = ymdTz(now);
    if (S.range === 'custom' && S.cfrom && S.cto) return [S.cfrom <= S.cto ? S.cfrom : S.cto, S.cfrom <= S.cto ? S.cto : S.cfrom];
    if (S.range === 'all') return [null, to];
    var n = Number(S.range) || 30; var f = new Date(now.getTime() - (n - 1) * 86400000);
    return [ymdTz(f), to];
  }
  var RSENT = { '7': '7 days', '30': '30 days', '90': '90 days', '182': '6 months', '365': 'year', '730': '2 years' };
  function dLong(iso) { return iso ? niceDay(iso) + ', ' + String(iso).slice(0, 4) : ''; }
  function rangeLabel() { var d = S.data || {}; if (S.range === 'all') return 'all time' + (d.from ? ' (since ' + dLong(d.from) + ')' : ''); if (S.range === 'custom') return (d.from ? dLong(d.from) + ' to ' + dLong(d.to) : 'the dates you picked'); return 'the last ' + (RSENT[S.range] || (S.days + ' days')); }
  function dayR(iso) { var d = S.data || {}; return (Number(d.days) || 0) > 330 || (d.from && String(d.from).slice(0, 4) !== String(d.to || '').slice(0, 4)) ? dLong(iso) : niceDay(iso); }
  function overLabel() { var d = S.data || {}; if (S.range === 'all') return d.from ? 'since ' + dLong(d.from) : 'over all time'; if (S.range === 'custom') return d.from ? 'from ' + dLong(d.from) + ' to ' + dLong(d.to) : 'over the dates you picked'; return 'over ' + rangeLabel(); }
  function vsLabel() { var d = S.data || {}; if (S.range === 'custom' || !RSENT[S.range]) return 'these ' + (d.days || S.days) + ' days against the ' + (d.days || S.days) + ' before'; return 'the last ' + RSENT[S.range] + ' against the ' + RSENT[S.range] + ' before'; }

