    '.w116upd .hd b{color:' + GREEN + ';}' +
    '.w116upd .hd a{color:' + GREEN + ';cursor:pointer;text-decoration:none;font-weight:600;}' +
    '.w116upd ul{margin:0;padding:0 0 0 18px;}' +
    '.w116upd li{font-size:13.5px;line-height:1.45;margin:0 0 3px;color:var(--wa-text);}' +
