    '.w116av.st-tentative{box-shadow:0 0 0 2px ' + GOLD + ';}' +
    '.w116empty{color:var(--wa-muted);font-size:13px;margin:0;}' +
    '.w116note{font-size:12px;color:var(--wa-muted);margin:8px 0 0;}' +
    /* projects */
    '.w116pro{display:flex;flex-direction:column;gap:10px;}' +
    '.w116pro .p{cursor:pointer;}' +
    '.w116pro .p .n{display:flex;justify-content:space-between;gap:8px;font-size:13px;font-weight:600;color:var(--wa-text);}' +
    '.w116pro .p .n span{color:var(--wa-muted);font-weight:500;font-size:12px;white-space:nowrap;}' +
    '.w116pro .p .n:hover{color:' + GREEN + ';}' +
    '.w116pro .bar{height:5px;background:rgba(16,63,57,.10);border-radius:3px;overflow:hidden;margin-top:5px;}' +
