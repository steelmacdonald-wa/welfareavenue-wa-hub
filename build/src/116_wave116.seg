    '.w116met input{font-family:' + HEAD + ';font-size:18px;width:110px;padding:2px 6px;border:1px solid rgba(16,63,57,.3);border-radius:6px;}' +
    /* bullet updates */
    '.w116upd{display:flex;flex-direction:column;gap:12px;}' +
    '.w116upd .u{border-left:3px solid ' + GOLD + ';padding:2px 0 2px 12px;}' +
