/* =====================================================================
   WA v116 team pages (24/09/26): one page per team, fed by the hub calendar
   =====================================================================
   Steel: "For the drop down of each department, it should hold a
   different page for each team... each their own Agenda tool (the
   Agenda tab under Meetings is the master agenda tool that only admins
   can view and query), each their own Overview page that holds clear
   bullet point form updates, mentions from other departments, and other
   pertinent KPIs... Operations Montreal should have the Volunteering
   tool under its drop down... Fundraising & Finances: Grants, Event
   Fundraising, Donor Relations and Finance each get their own task
   management page (ClickUp-like) with their projects; Finance also
   opens the existing Finance tool... sync meeting times to what
   hub@welfareavenue.com has on its calendar... on one's home page they
   should see exactly what meetings they have upcoming."
   1. Routes: #team/<dept> (Overview), #team/<dept>/agenda,
      #team/<dept>/tasks[/<workstream>], #team/fundraising/<board>
      (grants, events, donors, finance) and #team/opsmtl/volunteering.
      One panel (#team) hosts them all; the classic #dept/<d> page stays
      reachable (Executive decisions, Transcripts, the footer link).
   2. Departments menu: clicking a team opens its Overview; the flyout
      lists the team's pages, then Executive decisions and Transcripts.
   3. Overview: KPI tiles from live data, tracked KPIs (metrics table,
      editable by staff), updates in bullet form, mentions from other
      teams, upcoming meetings (hub calendar), projects, team.
   4. Agenda: the existing agenda tool, scoped to the team (department
      locked, filter hidden). The master Agendas page is admins only.
   5. Calendar: public.hub_events mirrors hub@welfareavenue.com every 30
      minutes (edge fn calendar-sync + cron). Department meeting chips
      read the synced cache instead of each person's own Google Calendar,
      and Home gains "Your upcoming meetings" (who accepted, join link).
   The task boards themselves live in wave116b (w116Board).
   ===================================================================== */
(function () {
  if (window.__wa116) return; window.__wa116 = true;
  var T = window.WA_TEAMS;
  if (!T) return;
  var GREEN = '#103F39', CREAM = '#FFFAF2', GOLD = '#DCA527', PURPLE = '#6F64AB', GROUND = '#1F201E', FLAG = '#B3402F';
  var HEAD = "'Barlow Condensed','Arial Narrow','Helvetica Neue',Arial,sans-serif";
  var BODY = "'Space Grotesk','Helvetica Neue',Arial,sans-serif";
  var W116 = window.W116 = { cur: null, events: [], eventsAt: 0, calState: null, mentions: null, projects: null, metrics: null, agCard: null, agHome: null, vol: {} };

  /* ---------- styles ---------- */
  var css = document.createElement('style');
  css.id = 'wa116css';
  css.textContent = '' +
    '#team{max-width:1240px;}' +
    '.w116crumb{font-family:' + BODY + ';font-size:11px;font-weight:700;letter-spacing:1.6px;text-transform:uppercase;color:var(--wa-muted);margin:2px 0 6px;}' +
    '.w116crumb a{color:inherit;cursor:pointer;text-decoration:none;}' +
    '.w116crumb a:hover{color:' + GREEN + ';}' +
    '.w116top{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap;margin:0 0 14px;}' +
    '.w116top h2{font-family:' + HEAD + ';font-weight:500;font-size:38px;line-height:1.05;letter-spacing:.3px;text-transform:uppercase;color:' + GREEN + ';margin:0;display:flex;align-items:center;gap:12px;}' +
    '.w116top h2 .dot{width:14px;height:14px;border-radius:4px;display:inline-block;flex:0 0 auto;}' +
    '.w116top .sub{font-family:' + BODY + ';font-size:13px;color:var(--wa-muted);margin:4px 0 0;max-width:640px;}' +
    '.w116right{display:flex;align-items:center;gap:10px;flex-wrap:wrap;}' +
    '.w116seg{display:inline-flex;background:rgba(16,63,57,.08);border-radius:12px;padding:3px;gap:2px;flex-wrap:wrap;}' +
    '.w116seg a{font-family:' + BODY + ';font-size:13px;font-weight:600;color:' + GREEN + ';padding:7px 14px;border-radius:9px;cursor:pointer;text-decoration:none;white-space:nowrap;}' +
    '.w116seg a.on{background:var(--wa-card);box-shadow:0 1px 2px rgba(16,63,57,.12);}' +
    '.w116seg a:hover{color:' + GREEN + ';background:rgba(255,250,242,.7);}' +
    '.w116avs{display:inline-flex;align-items:center;}' +
    '.w116av{display:inline-flex;align-items:center;justify-content:center;border-radius:50%;overflow:hidden;background:' + GREEN + ';color:' + CREAM + ';font-family:' + BODY + ';font-weight:700;flex:0 0 auto;border:2px solid var(--wa-card);box-sizing:border-box;}' +
    '.w116av img{width:100%;height:100%;object-fit:cover;display:block;}' +
    '.w116avs .w116av{margin-left:-7px;}' +
    '.w116avs .w116av:first-child{margin-left:0;}' +
    '.w116avs .more{font-size:11px;font-weight:700;color:var(--wa-muted);margin-left:6px;}' +
    '.w116next{display:inline-flex;align-items:center;gap:8px;background:var(--wa-card);border:1px solid rgba(16,63,57,.10);border-radius:999px;padding:6px 12px 6px 8px;font-size:12.5px;color:var(--wa-text);}' +
    '.w116next .ic{width:24px;height:24px;border-radius:50%;background:' + GOLD + ';display:inline-flex;align-items:center;justify-content:center;color:' + GREEN + ';font-weight:800;font-size:12px;}' +
    '.w116next a{color:' + GREEN + ';font-weight:700;text-decoration:none;}' +
    '.w116grid{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(0,1fr);gap:16px;align-items:start;}' +
    '.w116col{display:flex;flex-direction:column;gap:16px;min-width:0;}' +
    '.w116card{background:var(--wa-card);border:1px solid rgba(16,63,57,.08);border-radius:16px;box-shadow:0 1px 2px rgba(16,63,57,.04),0 8px 24px rgba(16,63,57,.05);padding:18px 20px;}' +
    '.w116card h3{font-family:' + BODY + ';font-weight:700;font-size:12px;letter-spacing:1.4px;text-transform:uppercase;color:' + GREEN + ';margin:0 0 10px;display:flex;align-items:center;justify-content:space-between;gap:8px;}' +
