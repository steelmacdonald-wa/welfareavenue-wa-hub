    '.w116men .m .w{font-size:11.5px;color:var(--wa-muted);margin-top:2px;}' +
    '.w116men .m .w a{color:' + GREEN + ';cursor:pointer;text-decoration:none;font-weight:600;}' +
    '.w116pill{display:inline-block;font-size:10.5px;font-weight:700;letter-spacing:.4px;text-transform:uppercase;border-radius:999px;padding:2px 8px;color:#fff;white-space:nowrap;}' +
    /* events */
    '.w116evl{display:flex;flex-direction:column;gap:8px;}' +
    '.w116ev{display:grid;grid-template-columns:52px minmax(0,1fr) auto;gap:12px;align-items:center;background:rgba(16,63,57,.04);border-radius:12px;padding:10px 12px;}' +
