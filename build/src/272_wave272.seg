  }
  function escHow(e) { if (e.key === 'Escape') { e.stopPropagation(); closeHow(); } }
  function openHow(from) {
    closeHow(); H.from = from || document.activeElement; hwStyle();
    var bk = document.createElement('div'); bk.id = 'w272back';
    bk.innerHTML = '<div id="w272sheet" role="dialog" aria-modal="true" aria-labelledby="w272howt"><div class="top"><h2 id="w272howt">Add the Hub as an app</h2><button type="button" class="x" aria-label="Close" data-w272h="close">&times;</button></div>'
      + '<div class="seg" role="group" aria-label="Your device"><button type="button" data-w272tab="iphone">iPhone</button><button type="button" data-w272tab="android">Android</button><button type="button" data-w272tab="computer">Computer</button></div>'
      + '<div id="w272how"></div>'
      + '<div class="ft"><span>On your phone, open <span class="addr">hub.welfareavenue.com</span></span><button type="button" class="dn" data-w272h="added">I added it</button></div></div>';
    document.body.appendChild(bk);
    bk.addEventListener('click', function (e) {
      if (e.target === bk) { closeHow(); return; }
      var t = e.target.closest && e.target.closest('[data-w272tab],[data-w272h]'); if (!t) return;
      if (t.hasAttribute('data-w272tab')) { showTab(t.getAttribute('data-w272tab')); return; }
      if (t.getAttribute('data-w272h') === 'added') { lsSet(KEY_APP, '1'); closeHow(); paintSetup(); say('Thanks. The Hub is on your list of apps.'); return; }
      closeHow();
    });
    document.addEventListener('keydown', escHow, true);
    showTab(IOS ? 'iphone' : ANDROID ? 'android' : 'computer');
    var x = bk.querySelector('.x'); if (x) x.focus({ preventScroll: true });
  }

  /* ---------- the small note ----------
     At most twice on a device, 14 days apart, only on Home, only when nothing else is open. No scrim and no focus taken. */
  var TIP = { timer: null, tries: 0 };
  function tipState() { var o = null; try { o = JSON.parse(lsGet(KEY_TIP) || 'null'); } catch (e) { o = null; } return o || { n: 0, at: 0 }; }
  function otherOpen() {
    if (!document.documentElement.classList.contains('wa-ready')) return true;
    if (document.getElementById('w272back') || document.getElementById('w213pop') || document.getElementById('w262new')) return true;
    var vis = function (el) { if (!el) return false; var c = getComputedStyle(el); return c.display !== 'none' && c.visibility !== 'hidden' && el.getBoundingClientRect().width > 0; };
    if (vis(document.getElementById('w238loop')) || vis(document.getElementById('w177pop')) || vis(document.getElementById('w227'))) return true;
    if (document.querySelector('.w122tp')) return true;
    return Array.prototype.some.call(document.querySelectorAll('[aria-modal="true"]'), vis);
  }
  function closeTip() { var t = document.getElementById('w272tip'); if (t) t.remove(); }
  function tryTip() {
    clearTimeout(TIP.timer);
    if (appDone() || FIREFOX || !(staff() || board()) || !onHome()) return;
    var st = tipState();
    if (st.n >= 2 || (st.at && Date.now() - st.at < 14 * 86400000) || document.getElementById('w272tip')) return;
    if (otherOpen()) { if (TIP.tries++ < 40) TIP.timer = setTimeout(tryTip, 5000); return; }
    lsSet(KEY_TIP, JSON.stringify({ n: st.n + 1, at: Date.now() }));
    var el = document.createElement('div'); el.id = 'w272tip'; el.setAttribute('role', 'region'); el.setAttribute('aria-label', 'Add the Hub as an app');
    var where = IOS || ANDROID ? 'on this phone' : 'on this computer';
    el.innerHTML = '<b>Keep the Hub one tap away</b><p>Add it as an app ' + where + ': its own icon, and notifications when someone needs you.</p><div class="acts">'
      + (BIP ? '<button type="button" class="go" data-w219="install" data-w272s="again">Install</button>' : '<button type="button" class="go" data-w272s="how">Show me how</button>')
      + '<button type="button" class="no" data-w272tip="no">Not now</button></div>';
    document.body.appendChild(el); void el.offsetWidth; el.classList.add('on');
  }
  document.addEventListener('click', function (e) {
    var b = e.target && e.target.closest && e.target.closest('[data-w272tip]'); if (!b) return;
    var t = document.getElementById('w272tip'); if (!t) return;
    t.classList.remove('on'); setTimeout(function () { t.remove(); }, 220);
  });
  window.addEventListener('hashchange', function () { if (!onHome()) closeTip(); });

  /* ---------- directors get Home (Steel, 01/11/26) ----------
     Wave74 draws them the greeting; their meetings come from wave116 as for everyone. Their Board pages take the place of the
     apps, which directors do not open. Read only, as ever; a card the older waves draw for staff stays out of their Home. */
  var dirCss = ''
    + '#mypage.w272dir #mpBody > #w272apps{grid-column:1 / -1;}'
    + '#mypage.w272dir > #w105my,#mypage.w272dir > #w105sign,#mypage.w272dir #w110mine,#mypage.w272dir #w114switch,#mypage.w272dir #w262homebar{display:none !important;}';
  var BOARD_PAGES = [['governance', 'Board overview', 'shield'], ['committees', 'Committees', 'people'], ['orggoals', 'Organization goals', 'target'], ['calendar', 'Calendar', 'list']];
  function paintDirector() {
    var body = document.getElementById('mpBody'), head = body && body.querySelector(':scope > .mp-head'); if (!head) return;
    var sum = document.getElementById('w272sum');
    if (!sum || sum.parentNode !== head) { sum = document.createElement('p'); sum.id = 'w272sum'; head.appendChild(sum); }
    sum.textContent = 'Your meetings and the board\u2019s pages, in one place.';
    var allowed = []; try { allowed = wa40Allowed() || []; } catch (e) { allowed = []; }
    var A = window.WA_APP, el = document.getElementById('w272apps');
    var mine = BOARD_PAGES.filter(function (p) { return allowed.indexOf(p[0]) >= 0; });
    if (!mine.length) { if (el) el.remove(); return; }
    if (!el || el.parentNode !== body) { el = document.createElement('section'); el.id = 'w272apps'; el.setAttribute('aria-label', 'Board'); body.appendChild(el); }
    var html = '<h3>Board</h3><div class="tiles">' + mine.map(function (p) { return '<button type="button" data-w272page="#' + E(p[0]) + '"><span class="ti">' + (A && A.icon ? A.icon(p[2]) : '') + '</span>' + E(p[1]) + '</button>'; }).join('') + '</div>';
    if (el.__h !== html) { el.innerHTML = html; el.__h = html; }
  }
  document.addEventListener('click', function (e) {
    var b = e.target && e.target.closest && e.target.closest('[data-w272page]'); if (b) location.hash = b.getAttribute('data-w272page');
  });
  /* Home joins the pages a director may open; wave260's landing and the menu read this same list */
  function wrapAllowed() {
    try {
      if (typeof wa40Allowed !== 'function' || !board() || wa40Allowed().indexOf('mypage') >= 0) return;
      var __al = wa40Allowed;
      wa40Allowed = function () { var a = __al.apply(this, arguments) || []; if (board() && a.indexOf('mypage') < 0) a = a.concat(['mypage']); return a; };
      Object.keys(__al).forEach(function (k) { try { wa40Allowed[k] = __al[k]; } catch (e) { /* fine */ } });
    } catch (e) { /* fine */ }
  }
  /* wave9 adds Home's menu button for staff only */
  function directorTab() {
    var bar = document.getElementById('tabBar'); if (!bar) return;
    var b = bar.querySelector('.tab[data-tab="mypage"]');
    if (!b) { b = document.createElement('button'); b.className = 'tab'; b.dataset.tab = 'mypage'; b.innerHTML = '<span class="tabdot" style="background:' + GREEN + '"></span>Home'; bar.insertBefore(b, bar.firstChild); }
    b.style.display = '';
    try { if (window.WA_NAV && WA_NAV.applyLayout) WA_NAV.applyLayout(); } catch (e) { /* fine */ }
  }

  /* ---------- the how-to films: adding the Hub to a phone ----------
     Every frame is a function of time (seek): nothing here carries state between frames, so a film can be paused, stepped
     or looped from anywhere. Silent on purpose: people watch these on a phone, often in a meeting.
     Steps: Apple "Turn a website into an app in Safari on iPhone" and "Bookmark a website in Safari on iPhone"; Google Chrome
     Help "Use web apps" (Android). The phone is an illustration, so the film says a phone may look a little different. */
  var HW = {
    iphone: {
      dur: 18, title: 'Add the Hub to your iPhone', where: 'In Safari, at hub.welfareavenue.com',
      steps: [[2.4, 'Tap \u00b7\u00b7\u00b7 next to the address'], [5.2, 'Tap Share'], [7, 'Scroll down, tap Add to Home Screen'], [10.4, 'Keep Open as Web App on, tap Add'], [13.8, 'Open the Hub from your new icon']],
      plain: ['In Safari, open hub.welfareavenue.com.', 'Tap the \u00b7\u00b7\u00b7 next to the address, then Share. If you see the Share button at the bottom or top of Safari, tap it directly.', 'Scroll down and tap Add to Home Screen. If it is not there, tap Edit Actions at the bottom of the list and add it.', 'Keep Open as Web App on, then tap Add.', 'Open the Hub from its new icon, then turn on notifications there.']
    },
    android: {
