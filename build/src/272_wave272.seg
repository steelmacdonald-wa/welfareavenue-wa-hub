        el.tap.style.left = tp[1] + 'px'; el.tap.style.top = tp[2] + 'px'; el.tap.style.transform = 'scale(' + s + ')';
        el.tap.style.opacity = u < -0.2 ? hwClamp((u + 0.42) / 0.2) : u > 0.08 ? 1 - hwClamp((u - 0.08) / 0.16) : 1;
