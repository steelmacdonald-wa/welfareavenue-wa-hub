/* =====================================================================
   WA v116d the Strategy section (24/09/26): Goal alignment + Executive dashboard
   =====================================================================
   Steel: "Executive Decisions should be its own page in a new section
   called Strategy... rename the strategy page to Goal Alignment...
   since the Dashboard page is executive decisions, just move it to the
   new Strategy section and call it Executive Dashboard."
   - A Strategy group in the menu holds Goal alignment (the goals page,
     renamed at build time by teams_remap) and Executive dashboard (the
     overview page: stat strip, folders and the open decisions, same id,
     same hash, same gating).
   - Later waves rebuild the menu on timers (wave73 at 250ms, wave95 at
     800ms and 2.5s), so the group is re-applied after each of them; the
     routine is idempotent.
   - Projects (Steel, second ask): the Projects tab leaves Goal alignment
     and becomes its own page in the Strategy section (#projects),
     rendered by wave116e (the master projects page).
   ===================================================================== */
(function () {
  if (window.__wa116d) return; window.__wa116d = true;
  var FLAG = '#B3402F', GREEN = '#103F39';
  var HEAD = "'Barlow Condensed','Arial Narrow','Helvetica Neue',Arial,sans-serif";
  var BODY = "'Space Grotesk','Helvetica Neue',Arial,sans-serif";
  var css = document.createElement('style');
  css.id = 'wa116dcss';
  css.textContent = '' +
    '#w68tabs [data-w68v="proj"]{display:none !important;}' +
    '#projects{max-width:1240px;}' +
    '#projects .w116ptop{margin:0 0 14px;}' +
    '#projects .w116ptop .crumb{font-family:' + BODY + ';font-size:11px;font-weight:700;letter-spacing:1.6px;text-transform:uppercase;color:var(--wa-muted);margin:2px 0 6px;}' +
    '#projects .w116ptop h2{font-family:' + HEAD + ';font-weight:500;font-size:38px;line-height:1.05;letter-spacing:.3px;text-transform:uppercase;color:' + GREEN + ';margin:0;}' +
    '#projects .w116ptop p{font-family:' + BODY + ';font-size:13px;color:var(--wa-muted);margin:4px 0 0;max-width:640px;}' +
    '#projects .card{padding:20px 22px;}';
  document.head.appendChild(css);

  /* ---------- Projects: its own page ---------- */
  function projectsPanel() {
    var main = document.querySelector('main'); if (!main) return null;
    var sec = document.getElementById('projects');
    if (!sec) {
      sec = document.createElement('section'); sec.id = 'projects'; sec.className = 'panel';
      sec.innerHTML = '<div class="w116ptop"><div class="crumb">Goals and projects</div><h2>Projects</h2><p>Every active project by team, with its status, the goal it serves and its open work. Open a project for the full picture.</p></div><div class="card" id="w116projhost"><p class="read">Loading projects...</p></div>';
      var goals = document.getElementById('goals');
      if (goals && goals.parentNode === main) goals.insertAdjacentElement('afterend', sec); else main.appendChild(sec);
    }
    return sec;
  }
  /* the goals page must not sit on the now-hidden Projects tab */
  function offProjTab() {
    try { var on = document.querySelector('#w68tabs .w68tab.on'); if (!on || on.getAttribute('data-w68v') === 'proj') { var d = document.querySelector('#w68tabs [data-w68v="dept"]'); if (d) d.click(); } } catch (e) { /* fine */ }
  }
  async function showProjects() {
    var sec = projectsPanel(); if (!sec) return;
    var host = document.getElementById('w116projhost'); if (!host) return;
    if (window.w116ProjectsPage && window.w116ProjectsPage.render) { try { await window.w116ProjectsPage.render(host); } catch (e) { host.innerHTML = '<p class="read">Could not load the projects.</p>'; } }
    else host.innerHTML = '<p class="read">The projects page is not available in this build.</p>';
  }
  if (typeof renderGoalsPage === 'function') {
    var __rg116d = renderGoalsPage;
    renderGoalsPage = async function () {
      var r = await __rg116d.apply(this, arguments);
      try { offProjTab(); } catch (e) { /* fine */ }
      return r;
    };
  }
  function enrolProjects() {
    try {
      if (typeof WA40_TABS === 'undefined' || typeof WA40_DEFAULTS === 'undefined') return;
      if (WA40_TABS.indexOf('projects') < 0) WA40_TABS.push('projects');
      ['admin', 'leader', 'member'].forEach(function (r) { if (WA40_DEFAULTS[r] && WA40_DEFAULTS[r].indexOf('projects') < 0) WA40_DEFAULTS[r].push('projects'); });
      if (typeof WA40_MINE !== 'undefined' && WA40_MINE && Array.isArray(WA40_MINE.tabs) && WA40_MINE.tabs.length && WA40_MINE.tabs.indexOf('goals') >= 0 && WA40_MINE.tabs.indexOf('projects') < 0) WA40_MINE.tabs.push('projects');
    } catch (e) { /* non-fatal */ }
  }
  enrolProjects();
  projectsPanel();
  if (window.WA_NAV && WA_NAV.register) {
    WA_NAV.register({ id: 'projects', gate: 'member', panel: false, onShow: function () { showProjects(); } });
  }

  function relabel(btn, text) {
    if (!btn) return;
    var dot = btn.querySelector('.tabdot');
    btn.innerHTML = (dot ? dot.outerHTML : '') + text;
  }
  function strategyGroup() {
    var bar = document.getElementById('tabBar'); if (!bar) return;
    /* wave134: the menu layout places these pages; this still creates the buttons and names them */
    if (window.WA_NAV && WA_NAV.layout) {
      [['overview', 'Executive dashboard', null], ['orggoals', 'Organizational goals', '#DCA527'], ['goals', 'Department goals', null], ['projects', 'Projects', '#6F64AB'], ['goalmap', 'Goal alignment', '#2A8C7A']].forEach(function (o) {
        var b0 = bar.querySelector('.tab[data-tab="' + o[0] + '"]');
        if (!b0 && o[2]) { b0 = document.createElement('button'); b0.className = 'tab'; b0.setAttribute('data-tab', o[0]); b0.innerHTML = '<span class="tabdot" style="background:' + o[2] + '"></span>' + o[1]; bar.appendChild(b0); }
        if (b0 && (b0.textContent || '').trim() !== o[1]) relabel(b0, o[1]);
      });
      return;
    }
    var goals = bar.querySelector('.tab[data-tab="goals"]');
    var over = bar.querySelector('.tab[data-tab="overview"]');
    if (!goals && !over) return;
    var g = bar.querySelector('.tab-group[data-w42g="strategy"]');
    if (!g) {
      g = document.createElement('span'); g.className = 'tab-group'; g.setAttribute('data-w42g', 'strategy');
      var hd = document.createElement('button'); hd.className = 'tab-group-h'; hd.innerHTML = 'Strategy <span class="caret">&#9660;</span>';
      var p = document.createElement('div'); p.className = 'tab-group-p';
      g.appendChild(hd); g.appendChild(p);
      hd.addEventListener('click', function (ev) {
        ev.stopPropagation();
        var was = g.classList.contains('open');
        document.querySelectorAll('#tabBar .tab-group.open').forEach(function (x) { x.classList.remove('open'); });
        if (!was) g.classList.add('open');
      });
      /* sits where the goals tab was; after Departments when goals is elsewhere */
      var anchorEl = goals ? (goals.closest('.tab-group') || goals) : null;
      if (anchorEl && anchorEl.parentNode === bar) bar.insertBefore(g, anchorEl);
      else {
        var depts = bar.querySelector('.tab-group[data-w42g="departments"]');
        if (depts && depts.nextSibling) bar.insertBefore(g, depts.nextSibling); else bar.appendChild(g);
      }
    }
    var host = g.querySelector('.tab-group-p');
    /* wave116f: the section holds five pages in this order; buttons that do not
       exist yet (Organizational goals, Projects, Goal alignment) are created here */
    var ORDER = [
      ['overview', 'Executive dashboard', null],
      ['orggoals', 'Organizational goals', '#DCA527'],
      ['goals', 'Department goals', null],
      ['projects', 'Projects', '#6F64AB'],
      ['goalmap', 'Goal alignment', '#2A8C7A']
    ];
    var prev = null;
    ORDER.forEach(function (o) {
      var b = bar.querySelector('.tab[data-tab="' + o[0] + '"]');
      if (!b && o[2]) { b = document.createElement('button'); b.className = 'tab'; b.setAttribute('data-tab', o[0]); b.innerHTML = '<span class="tabdot" style="background:' + o[2] + '"></span>' + o[1]; }
      if (!b) return;
      if ((b.textContent || '').trim() !== o[1]) relabel(b, o[1]);
      if (b.parentNode !== host || (prev ? prev.nextSibling !== b : host.firstChild !== b)) {
        if (prev) prev.insertAdjacentElement('afterend', b); else host.insertBefore(b, host.firstChild);
      }
      prev = b;
    });
    var hd2 = g.querySelector('.tab-group-h');
    if (hd2) hd2.style.display = Array.prototype.some.call(host.querySelectorAll('.tab'), function (t) { return t.style.display !== 'none'; }) ? '' : 'none';
  }
  window.w116Strategy = strategyGroup;
  window.w116StrategyOk = function () {
    if (window.WA_NAV && WA_NAV.layout) return true; /* wave134 */
    var bar = document.getElementById('tabBar'); if (!bar) return true;
    var g = bar.querySelector('.tab-group[data-w42g="strategy"] .tab-group-p'); if (!g) return false;
    return ['overview', 'orggoals', 'goals', 'projects', 'goalmap'].every(function (id) { var b = bar.querySelector('.tab[data-tab="' + id + '"]'); return !b || b.parentNode === g; });
  };

  if (typeof startApp === 'function') {
    var __sa116d = startApp;
    startApp = async function () {
      var r = await __sa116d.apply(this, arguments);
      try {
        enrolProjects();
        projectsPanel();
        strategyGroup();
        if (typeof wa40Enforce === 'function') wa40Enforce();
        if (String(location.hash || '') === '#projects') { try { applyHash(); } catch (e) { /* fine */ } }
      } catch (e) { console.warn('wave116d boot', e); }
      return r;
    };
  }
})();
