    + '#w225host .sched .pn{display:flex;align-items:center;gap:6px;font-weight:700;font-size:12px;}'
    + '#w225host .sched .c{min-height:34px;border-radius:10px;background:rgba(16,63,57,.04);padding:4px;display:flex;flex-direction:column;gap:3px;}'
