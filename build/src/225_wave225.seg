    + '#w225host .slot{display:grid;grid-template-columns:54px minmax(0,1fr) auto;gap:10px;align-items:center;padding:8px 0;border-top:1px dashed rgba(16,63,57,.15);color:' + MUTED + ';font-size:12.5px;}'
    + '#w225host .slot .ph{width:54px;height:30px;border-radius:8px;border:1.5px dashed rgba(16,63,57,.2);display:flex;align-items:center;justify-content:center;font-size:12px;}'
    /* bars */
