    + '#w225host .pl:first-child{border-top:none;}'
    + '#w225host .pl img,#w225host .pl .ph{width:54px;height:54px;border-radius:10px;object-fit:cover;background:rgba(16,63,57,.06);display:flex;align-items:center;justify-content:center;color:' + MUTED + ';}'
    + '#w225host .pl b{display:block;font-size:13.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}'
    + '#w225host .pl small{display:block;font-size:12px;color:' + MUTED + ';white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}'
