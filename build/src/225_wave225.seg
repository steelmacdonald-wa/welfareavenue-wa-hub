    + '#w225host .btn225.pri{background:' + GREEN + ';color:' + CREAM + ';border-color:' + GREEN + ';}'
    + '#w225host .btn225.rose{background:' + ROSE + ';color:' + CREAM + ';border-color:' + ROSE + ';}'
    + '#w225host .btn225.bad{color:' + FLAG + ';border-color:rgba(179,64,47,.35);}'
    + '#w225host .btn225[disabled]{opacity:.5;cursor:default;}'
    + '#w225host .btn225.sm{padding:4px 10px;font-size:11.5px;}'
    + '#w225host .row{display:flex;gap:8px;align-items:center;flex-wrap:wrap;}'
    + '#w225host .sp{flex:1;}'
    + '#w225host .muted{color:' + MUTED + ';font-size:12.5px;}'
    + '#w225host .empty{color:' + MUTED + ';font-size:13px;padding:10px 0;}'
    + '#w225host input[type=text],#w225host input[type=url],#w225host input[type=search],#w225host input[type=number],#w225host input[type=time],#w225host input[type=password],#w225host select,#w225host textarea{font:13px ' + BODY + ';padding:8px 11px;border:1px solid rgba(16,63,57,.2);border-radius:10px;background:#FFFAF2;color:var(--wa-text,' + INK + ');box-sizing:border-box;}'
