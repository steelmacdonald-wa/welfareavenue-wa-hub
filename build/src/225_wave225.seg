  document.head.appendChild(css);

  /* ---------- the page: one panel (#studio), sections by address ---------- */
  function mast(title, blurb) {
    var sec = document.getElementById('studio'); if (!sec) return;
    var m = sec.querySelector(':scope > .w118mast');
    if (!m) { m = document.createElement('div'); m.className = 'w118mast'; m.setAttribute('data-w225', '1'); sec.insertBefore(m, sec.firstChild); }
    var html = '<h1>' + E(title) + '</h1><p>' + E(blurb) + '</p>';
    if (m.getAttribute('data-h') !== html) { m.innerHTML = html; m.setAttribute('data-h', html); }
  }
  function host() {
    var sec = document.getElementById('studio'); if (!sec) return null;
    var t = SECT[S.sec] || SECT.overview; mast(t[0], t[1]);
    try { document.title = t[0] + ' \u00b7 Welfare Avenue Hub'; } catch (e) { /* fine */ }
    var h = document.getElementById('w225host');
    if (!h) { h = document.createElement('div'); h.id = 'w225host'; sec.appendChild(h); }
    return h;
  }
  function go(h) { if (location.hash === h) { try { applyHash(); } catch (e) { /* fine */ } } else location.hash = h; }
  function postRow(p, extra) {
    var th = thumbOf(p), s = stateOf(p);
    return '<div class="pl" data-w225open="' + p.id + '">' + (th ? '<img src="' + E(th) + '" alt="" loading="lazy">' : '<div class="ph">' + I('cal') + '</div>') +
      '<div style="min-width:0"><b>' + E(titleOf(p)) + '</b><small>' + (p.platforms || []).map(function (k) { return mark(k, s.live && s.live[k]); }).join('') + ' ' + E(p.scheduled_at ? niceWhen(p.scheduled_at) : 'No date') + (p.owner ? ' \u00b7 ' + E(p.owner) : '') + '</small>' + (extra || '') + '</div>' +
      '<span class="pill ' + (s.cls === 'live' ? 'ok' : s.cls === 'sched' ? 'warn' : s.cls === 'appr' ? 'appr' : s.cls === 'bad' || s.cls === 'due' ? 'bad' : '') + '">' + E(s.label) + '</span></div>';
  }
  function weekBounds(off) { var m = addDays(mondayOf(today()), 7 * (off || 0)); return [m, addDays(m, 6)]; }
  function postsIn(a, b) { return posts().filter(function (p) { var d = dayOf(p.scheduled_at || p.published_at); return d && d >= a && d <= b && p.status !== 'cancelled'; }); }
  /* goals: posts per platform per week (hub_settings content_studio.goals); a week counts for the streak when every goal with a target is met */
  function goalStatus(off) {
    var wb = weekBounds(off), g = goals(), list = postsIn(wb[0], wb[1]).filter(function (p) { return ['published', 'posted', 'scheduled', 'publishing'].indexOf(p.status) >= 0 || (off < 0 && p.status === 'failed' && Object.keys(p.results || {}).some(function (k) { return p.results[k] && p.results[k].id; })); });
    var out = {}; PORDER.forEach(function (k) { out[k] = { goal: Number(g[k] || 0), n: list.filter(function (p) { return (p.platforms || []).indexOf(k) >= 0; }).length }; });
    return out;
  }
  function streak() {
    var n = 0; for (var w = -1; w > -53; w--) { var gs = goalStatus(w), any = false, met = true; PORDER.forEach(function (k) { if (gs[k].goal > 0) { any = true; if (gs[k].n < gs[k].goal) met = false; } }); if (!any || !met) break; n++; }
    return n;
  }
  function overviewHtml() {
    var now = Date.now(), t = today(), wb = weekBounds(0);
    var all = posts();
    var scheduled = all.filter(function (p) { return p.status === 'scheduled' && p.scheduled_at && new Date(p.scheduled_at).getTime() > now; });
    var thisWeek = postsIn(wb[0], wb[1]);
    var pend = all.filter(function (p) { return p.approval_status === 'pending' && ['draft', 'scheduled', 'failed'].indexOf(p.status) >= 0; });
    var mine = all.filter(function (p) { return p.approval_status === 'changes' && lower(p.submitted_by) === myEmail(); });
    var attn = all.filter(function (p) { return p.status !== 'cancelled' && stateOf(p).attn; });
    var open = S.comments.filter(function (c) { return c.status === 'open' && !c.from_us; });
    var clicks30 = S.clicks.length;
    var reach30 = 0; S.social.forEach(function (sp) { if (sp.published_at && now - new Date(sp.published_at).getTime() < 30 * 86400000) reach30 += Number(sp.reach || sp.views || 0); });
    var gs = goalStatus(0), gT = 0, gN = 0; PORDER.forEach(function (k) { gT += gs[k].goal; gN += Math.min(gs[k].n, gs[k].goal); });
    var st = streak();
    var kpis = '<div class="kpis">' +
      '<div class="kpi" data-w225go="#contentcal"><b>' + scheduled.length + '</b><span>scheduled ahead</span><em>' + thisWeek.length + ' this week</em></div>' +
      '<div class="kpi" data-w225go="#studio/approvals"><b class="' + (pend.length ? 'warn' : '') + '">' + pend.length + '</b><span>waiting for approval</span>' + (mine.length ? '<em>' + mine.length + ' of yours sent back</em>' : '') + '</div>' +
      '<div class="kpi" data-w225go="#studio/inbox"><b class="' + (open.length ? 'warn' : 'ok') + '">' + open.length + '</b><span>comments to answer</span></div>' +
      '<div class="kpi" data-w225go="#studio/queue"><b class="' + (gT && gN >= gT ? 'ok' : '') + '">' + (gT ? gN + '/' + gT : '\u2013') + '</b><span>weekly goal</span><em>' + (st ? st + '-week streak' : 'Meet every goal to start a streak') + '</em></div>' +
      '<div class="kpi" data-w225go="#studio/links"><b>' + num(clicks30) + '</b><span>link clicks, 30 days</span></div>' +
      '<div class="kpi" data-w225go="#socialstats"><b>' + (reach30 ? num(reach30) : '\u2013') + '</b><span>reach and views, 30 days</span></div></div>';
    /* the next seven days */
    var days = ''; for (var i = 0; i < 7; i++) {
      var d = addDays(t, i), list = all.filter(function (p) { return p.scheduled_at && dayOf(p.scheduled_at) === d && p.status !== 'cancelled'; }).sort(function (a, b) { return String(a.scheduled_at).localeCompare(String(b.scheduled_at)); });
      if (!list.length) continue;
      days += '<div class="day">' + E(i === 0 ? 'Today' : i === 1 ? 'Tomorrow' : niceDate(d, { weekday: 'long', month: 'short', day: 'numeric' })) + '</div>' + list.map(function (p) { return postRow(p); }).join('');
    }
    var week = '<div class="card"><h3>' + I('cal') + ' The week ahead <span class="sp"></span><a class="btn225 sm" data-w225go="#contentcal">' + I('cal') + ' Calendar</a><a class="btn225 sm pri" data-w225new="1">' + I('plus') + ' New post</a></h3>' + (days || '<div class="empty">Nothing planned for the next seven days. <a data-w225go="#studio/queue" style="cursor:pointer;color:' + ROSE + ';font-weight:700">Fill the queue</a>.</div>') + '</div>';
    var needs = attn.concat(mine.filter(function (p) { return attn.indexOf(p) < 0; }));
    var attnCard = needs.length ? '<div class="card"><h3>' + I('warn') + ' Needs attention <small>' + needs.length + '</small></h3>' + needs.slice(0, 8).map(function (p) { return postRow(p, '<small style="color:' + FLAG + '">' + E(stateOf(p).note || '') + '</small>'); }).join('') + '</div>' : '';
    var apprCard = pend.length ? '<div class="card"><h3>' + I('check') + ' Waiting for approval <small>' + pend.length + '</small><span class="sp"></span><a class="btn225 sm" data-w225go="#studio/approvals">Open</a></h3>' + pend.slice(0, 5).map(function (p) { return postRow(p, '<small>From ' + E(String(p.submitted_by || '').split('@')[0]) + '</small>'); }).join('') + '</div>' : '';
    var goalsCard = '<div class="card"><h3>' + I('bolt') + ' This week\u2019s goals <span class="sp"></span><a class="btn225 sm" data-w225go="#studio/queue">Change</a></h3>' + PORDER.filter(function (k) { return gs[k].goal > 0 || gs[k].n > 0; }).map(function (k) { var g = gs[k], w = g.goal ? Math.min(100, Math.round(g.n / g.goal * 100)) : 100; return '<div class="goal"><span>' + mark(k) + ' ' + E(PLX[k][0]) + '</span><div class="bar"><i class="' + (g.goal && g.n > g.goal ? 'over' : '') + '" style="width:' + w + '%"></i></div><span>' + g.n + (g.goal ? ' / ' + g.goal : '') + '</span></div>'; }).join('') + '<p class="muted" style="margin:8px 0 0">' + (st ? 'A ' + st + '-week streak: every goal met ' + st + ' week' + (st === 1 ? '' : 's') + ' in a row.' : 'Counts what is scheduled or out this week (Monday to Sunday).') + '</p></div>';
    var cx = cap(); var connCard = '<div class="card"><h3>' + I('plug') + ' How we post <span class="sp"></span><a class="btn225 sm" data-w225go="#studio/connections">Connections</a></h3>' + PORDER.map(function (k) { var m = modeOf(k), mm = MODE[m] || MODE.reminder; return '<div class="row" style="margin:5px 0;font-size:12.5px">' + mark(k) + '<b style="width:80px">' + E(PLX[k][0]) + '</b><span style="color:' + mm[1] + ';font-weight:700">' + E(mm[0]) + '</span></div>'; }).join('') + (cx && cx.missing && cx.missing.length ? '<p class="muted" style="margin:8px 0 0;color:' + FLAG + '">The Meta token is missing ' + cx.missing.length + ' permission' + (cx.missing.length === 1 ? '' : 's') + ': comments and some formats wait for the new token.</p>' : '') + '</div>';
    var cmCard = '<div class="card"><h3>' + I('chat') + ' Latest comments <span class="sp"></span><a class="btn225 sm" data-w225go="#studio/inbox">Comments</a></h3>' + (open.length ? open.slice(0, 4).map(function (c) { return '<div style="font-size:12.5px;margin:6px 0">' + mark(c.platform) + '<b>' + E(c.author_handle || c.author_name || 'Someone') + '</b> <span class="muted">' + E(ago(c.commented_at)) + '</span><div>' + E(clip(c.text, 140)) + '</div></div>'; }).join('') : '<div class="empty">' + (S.inboxLast ? 'Every comment is answered.' : 'The inbox fills once the Meta token has the comment permissions (Connections).') + '</div>') + '</div>';
    var top = S.social.filter(function (sp) { return sp.published_at && now - new Date(sp.published_at).getTime() < 30 * 86400000; }).sort(function (a, b) { return Number(b.engagement || (Number(b.likes || 0) + Number(b.comments || 0) + Number(b.shares || 0) + Number(b.saves || 0))) - Number(a.engagement || (Number(a.likes || 0) + Number(a.comments || 0) + Number(a.shares || 0) + Number(a.saves || 0))); })[0];
    var topCard = top ? '<div class="card"><h3>' + I('star') + ' Best post, 30 days</h3><div class="pl" style="cursor:default">' + (top.thumb_cached || top.thumb_url ? '<img src="' + E(top.thumb_cached || top.thumb_url) + '" alt="" loading="lazy">' : '<div class="ph"></div>') + '<div style="min-width:0"><b>' + E(clip(top.caption || 'A post', 80)) + '</b><small>' + mark(top.platform) + ' ' + num(top.reach || top.views || 0) + ' reach \u00b7 ' + num(top.likes || 0) + ' likes \u00b7 ' + num(top.comments || 0) + ' comments</small></div>' + (top.url ? '<a class="btn225 sm" href="' + E(top.url) + '" target="_blank" rel="noopener">' + I('ext') + '</a>' : '') + '</div></div>' : '';
    return kpis + '<div class="grid2"><div>' + week + attnCard + apprCard + '</div><div>' + goalsCard + connCard + cmCard + topCard + '</div></div>';
  }

  /* ---------- the queue and the posting schedule ---------- */
  function slotGroups() {
    /* one row per weekday and time, with the platforms that post then */
    var m = {}; slots().forEach(function (s) { var k = s.weekday + '|' + String(s.at).slice(0, 5); (m[k] = m[k] || { wd: Number(s.weekday), at: String(s.at).slice(0, 5), pls: [], ids: [] }); m[k].pls.push(s.platform); m[k].ids.push(s.id); });
    return Object.keys(m).map(function (k) { m[k].pls.sort(function (a, b) { return PORDER.indexOf(a) - PORDER.indexOf(b); }); return m[k]; });
  }
  function queueHtml14() {
    var t = today(), nowHm = hm(new Date().toISOString()), groups = slotGroups(), all = posts();
    var ideas = all.filter(function (p) { return !p.scheduled_at && p.status === 'draft'; });
    var html = '';
    for (var i = 0; i < 14; i++) {
      var d = addDays(t, i), wd = dowOf(d);
      var dayPosts = all.filter(function (p) { return p.scheduled_at && dayOf(p.scheduled_at) === d && p.status !== 'cancelled'; });
      var taken = {}; dayPosts.forEach(function (p) { taken[hm(p.scheduled_at)] = 1; });
      var free = groups.filter(function (g) { return g.wd === wd && !taken[g.at] && !(i === 0 && g.at <= nowHm); });
      var rows = dayPosts.map(function (p) { return { at: hm(p.scheduled_at), html: postRow(p) }; }).concat(free.map(function (g) {
        return { at: g.at, html: '<div class="slot"><div class="ph">' + E(g.at) + '</div><div>Free slot \u00b7 ' + g.pls.map(function (k) { return mark(k); }).join('') + ' ' + E(g.pls.map(function (k) { return PLX[k][0]; }).join(', ')) + '</div><div class="row">' +
          (ideas.length ? '<select data-w225fill="' + d + '|' + g.at + '" aria-label="Fill with an idea"><option value="">Fill with an idea\u2026</option>' + ideas.slice(0, 40).map(function (p) { return '<option value="' + p.id + '">' + E(clip(titleOf(p), 50)) + '</option>'; }).join('') + '</select>' : '') +
          '<a class="btn225 sm" data-w225slotnew="' + d + '|' + g.at + '|' + g.pls.join(',') + '">' + I('plus') + ' New post</a></div></div>' };
      })).sort(function (a, b) { return a.at.localeCompare(b.at); });
      if (!rows.length) continue;
      html += '<div class="day">' + E(i === 0 ? 'Today' : i === 1 ? 'Tomorrow' : niceDate(d, { weekday: 'long', month: 'short', day: 'numeric' })) + '</div>' + rows.map(function (r) { return r.html; }).join('');
    }
    return html || '<div class="empty">' + (groups.length ? 'Nothing in the next two weeks.' : 'Set the posting schedule below: the queue then shows the free slots to fill.') + '</div>';
  }
  /* suggested times: our own results, per platform, weekday and hour (engagement over reach), at least two posts a cell */
  function suggestTimes() {
    var out = {}; var by = {};
    S.social.forEach(function (sp) {
      if (!sp.published_at || PORDER.indexOf(sp.platform) < 0) return;
      var d = new Date(sp.published_at), wd = (d.getDay() + 6) % 7, h = d.getHours();
      var base = Number(sp.reach || sp.views || 0), eng = Number(sp.engagement || (Number(sp.likes || 0) + Number(sp.comments || 0) * 2 + Number(sp.shares || 0) * 3 + Number(sp.saves || 0) * 2));
      if (!base) return;
      var k = sp.platform + '|' + wd + '|' + h; (by[k] = by[k] || { pl: sp.platform, wd: wd, h: h, n: 0, rate: 0 }); by[k].n++; by[k].rate += eng / base;
    });
    Object.keys(by).forEach(function (k) { var c = by[k]; if (c.n < 2) return; c.rate = c.rate / c.n; (out[c.pl] = out[c.pl] || []).push(c); });
    Object.keys(out).forEach(function (pl) { out[pl].sort(function (a, b) { return b.rate - a.rate; }); out[pl] = out[pl].slice(0, 3); });
    return out;
  }
  function schedHtml() {
    var mk = S.mk, sug = S.suggest;
    var head = '<div class="sched"><div></div>' + WD.map(function (d) { return '<div class="h">' + d + '</div>'; }).join('');
    var body = PORDER.map(function (k) {
      return '<div class="pn">' + mark(k) + E(PLX[k][0]) + '</div>' + WD.map(function (d, wd) {
        var list = slots().filter(function (s) { return s.platform === k && Number(s.weekday) === wd; }).sort(function (a, b) { return String(a.at).localeCompare(String(b.at)); });
        var sl = (sug && sug[k] || []).filter(function (c) { return c.wd === wd && !list.some(function (s) { return Number(String(s.at).slice(0, 2)) === c.h; }); });
        return '<div class="c">' + list.map(function (s) { return '<span class="t">' + E(String(s.at).slice(0, 5)) + (mk ? '<a data-w225slotx="' + s.id + '" title="Remove">\u2715</a>' : '') + '</span>'; }).join('') + sl.map(function (c) { return '<span class="t sug" title="Suggested from our results: ' + Math.round(c.rate * 1000) / 10 + '% engagement over ' + c.n + ' posts">' + pad(c.h) + ':00' + (mk ? '<a data-w225sugadd="' + k + '|' + c.wd + '|' + pad(c.h) + ':00" title="Add it">+</a>' : '') + '</span>'; }).join('') + '</div>';
      }).join('');
    }).join('');
    var add = mk ? '<div class="row" style="margin-top:12px"><select id="w225spl"><option value="all">Every platform</option>' + PORDER.map(function (k) { return '<option value="' + k + '">' + E(PLX[k][0]) + '</option>'; }).join('') + '</select>' +
      '<span class="seg" id="w225swd">' + WD.map(function (d, i) { return '<a data-w225swd="' + i + '" class="' + ((S.keys.swd || []).indexOf(i) >= 0 ? 'on' : '') + '">' + d + '</a>'; }).join('') + '</span><input type="time" id="w225sat" value="' + E(S.keys.sat || '18:00') + '"><a class="btn225 sm pri" data-w225slotadd="1">' + I('plus') + ' Add the time</a><span class="sp"></span><a class="btn225 sm" data-w225sug="1">' + I('bolt') + (sug ? ' Hide the suggestions' : ' Suggest times from our results') + '</a></div>' : '';
    return head + body + '</div>' + add + (sug ? '<p class="muted" style="margin:8px 0 0">Dashed times are the hours our own posts did best (engagement over reach, the last year, at least two posts). ' + (Object.keys(sug).length ? '' : 'Not enough posts yet to suggest anything.') + '</p>' : '');
  }
  function goalsHtml() {
    var g = goals(), mk = S.mk;
    return '<div class="grid3" style="grid-template-columns:repeat(auto-fit,minmax(150px,1fr))">' + PORDER.map(function (k) { return '<label style="display:flex;align-items:center;gap:8px;font-size:12.5px">' + mark(k) + '<span style="flex:1">' + E(PLX[k][0]) + '</span><input type="number" min="0" max="21" data-w225goal="' + k + '" value="' + E(g[k] != null ? g[k] : 0) + '" style="width:64px"' + (mk ? '' : ' disabled') + '> a week</label>'; }).join('') + '</div>' + (mk ? '<div class="row" style="margin-top:10px"><span class="sp"></span><a class="btn225 sm pri" data-w225goalsave="1">Save the goals</a></div>' : '');
  }
  function gridHtml() {
    var ig = S.social.filter(function (sp) { return sp.platform === 'instagram' && (sp.kind || '').toLowerCase().indexOf('story') < 0; }).slice(0, 12);
    var next = posts().filter(function (p) { return (p.platforms || []).indexOf('instagram') >= 0 && p.scheduled_at && new Date(p.scheduled_at).getTime() > Date.now() && ['draft', 'scheduled'].indexOf(p.status) >= 0 && (((p.variants || {}).instagram || {}).kind || 'feed') !== 'story'; }).sort(function (a, b) { return String(b.scheduled_at).localeCompare(String(a.scheduled_at)); }).slice(-6);
    var cells = next.map(function (p) { var th = thumbOf(p); return '<div class="next" data-w225open="' + p.id + '" title="' + E(titleOf(p) + ' \u00b7 ' + niceWhen(p.scheduled_at)) + '">' + (th ? '<img src="' + E(th) + '" alt="">' : '') + '<span>' + E(niceDate(dayOf(p.scheduled_at), { month: 'short', day: 'numeric' })) + '</span></div>'; })
      .concat(ig.map(function (sp) { var u = sp.thumb_cached || sp.thumb_url; return '<div>' + (u ? '<img src="' + E(u) + '" alt="" loading="lazy">' : '') + '</div>'; })).slice(0, 12);
    return cells.length ? '<div class="igg">' + cells.join('') + '</div><p class="muted" style="margin:8px 0 0">Planned posts (outlined, newest first) in front of the last ones on @welfareavenue: how the profile will look.</p>' : '<div class="empty">No Instagram posts yet.</div>';
  }
  function queueHtml() {
    return '<div class="grid2"><div><div class="card"><h3>' + I('cal') + ' The next two weeks <small>planned posts and free slots</small><span class="sp"></span><a class="btn225 sm pri" data-w225new="1">' + I('plus') + ' New post</a></h3>' + queueHtml14() + '</div></div><div>' +
      '<div class="card"><h3>' + I('bolt') + ' Weekly goals</h3>' + goalsHtml() + '</div>' +
      '<div class="card"><h3>' + I('eye') + ' Instagram grid</h3>' + gridHtml() + '</div></div></div>' +
      '<div class="card"><h3>' + I('clock') + ' Posting schedule <small>times in Toronto; Next in the queue in the composer uses them</small></h3>' + schedHtml() + '</div>';
  }
  async function addSlots(pls, wds, at) {
    var rows = []; pls.forEach(function (k) { wds.forEach(function (wd) { if (!slots().some(function (s) { return s.platform === k && Number(s.weekday) === wd && String(s.at).slice(0, 5) === at; })) rows.push({ platform: k, weekday: wd, at: at, created_by: myName() || 'staff' }); }); });
    if (!rows.length) { toastS('Those times are already in the schedule'); return; }
    var r = await db.from('content_slots').insert(rows); if (r.error) throw r.error;
    var w = W(); if (w) await w.studio(); toastS(rows.length === 1 ? 'Added' : rows.length + ' times added');
  }

  /* ---------- approvals ---------- */
  function apCard(p) {
    var th = thumbOf(p), pub = S.pub, s = stateOf(p);
    var who0 = memberByEmail(p.submitted_by); var whoN = who0 ? who0.name : String(p.submitted_by || '').split('@')[0];
    var caps = (p.platforms || []).map(function (k) { var v = (p.variants || {})[k] || {}; var c = v.caption && String(v.caption).trim() ? v.caption : p.caption; return '<div style="margin:6px 0;font-size:12.5px">' + mark(k) + '<b>' + E(PLX[k] ? PLX[k][0] : k) + (v.kind && v.kind !== 'feed' ? ' ' + E(v.kind) : '') + '</b><div style="white-space:pre-wrap;margin-top:2px">' + E(clip(c || '', 400)) + '</div></div>'; }).join('');
    return '<div class="card"><div class="pl" style="border:none;padding:0" data-w225open="' + p.id + '">' + (th ? '<img src="' + E(th) + '" alt="">' : '<div class="ph">' + I('cal') + '</div>') + '<div style="min-width:0"><b>' + E(titleOf(p)) + '</b><small>' + E(p.scheduled_at ? niceWhen(p.scheduled_at) : 'No date yet') + ' \u00b7 sent by ' + E(whoN) + (p.submitted_at ? ' ' + E(ago(p.submitted_at)) : '') + '</small></div><span class="pill ' + (p.approval_status === 'pending' ? 'appr' : p.approval_status === 'changes' ? 'bad' : 'ok') + '">' + E(s.label) + '</span></div>' +
      (p.approval_note ? '<div class="muted" style="margin:8px 0;padding:8px 10px;background:rgba(111,100,171,.08);border-radius:10px;color:var(--wa-text)">' + E(p.approval_note) + '</div>' : '') + caps +
      ((p.media || []).length > 1 ? '<div class="row" style="gap:4px;margin:6px 0">' + p.media.slice(0, 8).map(function (m) { return String(m.kind || m.mime || '').indexOf('video') >= 0 ? '<span class="pill">video</span>' : '<img src="' + E(m.url) + '" alt="' + E(m.alt || '') + '" style="width:48px;height:48px;object-fit:cover;border-radius:8px">'; }).join('') + '</div>' : '') +
      '<div class="row" style="margin-top:8px"><a class="btn225 sm" data-w225open="' + p.id + '">' + I('eye') + ' Open</a><span class="sp"></span>' +
      (pub && p.approval_status === 'pending' ? '<input type="text" data-w225apnote="' + p.id + '" placeholder="Note (needed to send it back)" style="min-width:200px;flex:1"><a class="btn225 sm bad" data-w225dec="changes|' + p.id + '">Send it back</a><a class="btn225 sm pri" data-w225dec="approve|' + p.id + '">' + I('check') + ' Approve' + (p.scheduled_at ? ' and schedule' : '') + '</a>' : '') + '</div></div>';
  }
  function approvalsHtml() {
    var all = posts().filter(function (p) { return ['draft', 'scheduled', 'failed', 'published', 'posted'].indexOf(p.status) >= 0; });
    var pend = all.filter(function (p) { return p.approval_status === 'pending' && ['draft', 'scheduled', 'failed'].indexOf(p.status) >= 0; });
    var back = all.filter(function (p) { return p.approval_status === 'changes' && ['draft', 'scheduled', 'failed'].indexOf(p.status) >= 0; });
    var mine = all.filter(function (p) { return lower(p.submitted_by) === myEmail(); });
    var done = all.filter(function (p) { return p.approval_status === 'approved' && p.approved_at && Date.now() - new Date(p.approved_at).getTime() < 30 * 86400000; }).sort(function (a, b) { return String(b.approved_at).localeCompare(String(a.approved_at)); });
    var tabs = [['pending', 'Waiting', pend], ['changes', 'Sent back', back], ['mine', 'Mine', mine], ['approved', 'Approved, 30 days', done]];
    var cur = tabs.filter(function (t) { return t[0] === S.f.apr; })[0] || tabs[0];
    var intro = S.pub ? 'You approve posts: open one to check it, then Approve or Send it back with a note. The person who sent it hears about it in the Hub and on Slack.' : 'Marketing leads and admins approve posts before they go out. Send a post for approval from the composer; you hear back in the Hub and on Slack.';
    return '<div class="row" style="margin:0 0 12px"><span class="seg">' + tabs.map(function (t) { return '<a data-w225apr="' + t[0] + '" class="' + (cur[0] === t[0] ? 'on' : '') + '">' + E(t[1]) + '<span class="n">' + t[2].length + '</span></a>'; }).join('') + '</span><span class="sp"></span><span class="muted">' + E(intro) + '</span></div>' +
      (cur[2].length ? cur[2].map(apCard).join('') : '<div class="card"><div class="empty">' + (cur[0] === 'pending' ? 'Nothing waits for an approval.' : cur[0] === 'changes' ? 'Nothing was sent back.' : cur[0] === 'mine' ? 'You have not sent anything for approval.' : 'Nothing approved in the last 30 days.') + '</div></div>');
  }
  async function decideFrom(dec, id) {
    var inp = document.querySelector('#w225host [data-w225apnote="' + id + '"]'); var note = inp ? inp.value.trim() : '';
    if (dec === 'changes' && !note) { toastS('Write a note so they know what to change'); if (inp) inp.focus(); return; }
    try { var r = await db.rpc('studio_decide', { p_id: Number(id), p_decision: dec, p_note: note || null }); if (r.error) throw r.error; toastS(dec === 'approve' ? 'Approved' : 'Sent back with your note'); await loadAll(true); paint(); }
    catch (x) { toastS('Could not save the decision: ' + (x.message || x)); }
  }

  /* ---------- the comments inbox ---------- */
  function scoreOf(list) {
    var since = Date.now() - 30 * 86400000;
    var theirs = list.filter(function (c) { return !c.from_us && c.commented_at && new Date(c.commented_at).getTime() > since && c.status !== 'deleted'; });
    /* answered: the inbox marked a reply (replied_at), or one of our replies sits under it (its time counts) */
    var repAt = function (c) { if (c.replied_at) return c.replied_at; var k = list.filter(function (x) { return x.from_us && x.platform === c.platform && x.parent_external_id === c.external_id && x.commented_at; }).sort(function (x, y) { return String(x.commented_at).localeCompare(String(y.commented_at)); })[0]; return k ? k.commented_at : null; };
    theirs.forEach(function (c) { c.__rep = repAt(c); });
    var answered = theirs.filter(function (c) { return c.__rep; });
    var times = answered.map(function (c) { return (new Date(c.__rep).getTime() - new Date(c.commented_at).getTime()) / 3600000; }).filter(function (h) { return h >= 0; }).sort(function (a, b) { return a - b; });
    var med = times.length ? times[Math.floor(times.length / 2)] : null;
    var within = theirs.length ? answered.filter(function (c) { return (new Date(c.__rep).getTime() - new Date(c.commented_at).getTime()) < 24 * 3600000; }).length / theirs.length : null;
    var score = theirs.length ? Math.round(((answered.length / theirs.length) * 0.6 + (within || 0) * 0.4) * 100) : null;
    return { total: theirs.length, answered: answered.length, med: med, within: within, score: score };
  }
  function postFor(c) {
    var sp = S.social.filter(function (x) { return (c.social_post_id && x.id === c.social_post_id) || (x.platform === c.platform && (x.external_id === c.media_external_id || String(x.external_id).split('_').pop() === String(c.media_external_id || '').split('_').pop())); })[0];
    if (sp) return { thumb: sp.thumb_cached || sp.thumb_url, text: sp.caption, url: sp.url };
    var cp = c.content_post_id ? posts().filter(function (p) { return p.id === c.content_post_id; })[0] : null;
    if (cp) return { thumb: thumbOf(cp), text: titleOf(cp), url: c.permalink };
    return { thumb: null, text: null, url: c.permalink };
  }
  function cmHtml(c, kids) {
    var mk = S.mk, pub = S.pub, r = S.reply[c.id];
    var nm = c.author_handle ? '@' + c.author_handle : (c.author_name || 'Someone');
    var ours = kids.filter(function (k) { return k.from_us; }), theirs = kids.filter(function (k) { return !k.from_us; });
    var replies = lib().filter(function (x) { return x.kind === 'reply'; });
    var acts = mk ? '<div class="acts">' + (c.status !== 'deleted' ? '<a data-w225rp="' + c.id + '">' + I('chat') + ' Reply</a>' : '') +
      (c.platform === 'facebook' && !c.liked_by_us ? '<a data-w225act="like|' + c.id + '">' + I('heart') + ' Like</a>' : '') +
      (c.hidden ? '<a data-w225act="unhide|' + c.id + '">Show again</a>' : '<a data-w225act="hide|' + c.id + '">' + I('eye') + ' Hide</a>') +
      (c.status === 'open' ? '<a data-w225act="resolve|' + c.id + '">' + I('check') + ' Resolve</a>' : c.status === 'resolved' ? '<a data-w225act="reopen|' + c.id + '">Reopen</a>' : '') +
      '<select data-w225assign="' + c.id + '" aria-label="Assign" style="font-size:11.5px;padding:3px 8px;border-radius:999px"><option value="">' + (c.assigned_to ? 'Assigned: ' + E(c.assigned_to) : 'Assign\u2026') + '</option>' + members().filter(function (m) { return m.department === 'marketing' || m.department === 'exec'; }).map(function (m) { return '<option value="' + E(m.name) + '">' + E(m.name) + '</option>'; }).join('') + '</select>' +
      (pub && c.status !== 'deleted' ? '<a class="bad" data-w225act="delete|' + c.id + '">' + I('trash') + ' Delete</a>' : '') +
      (c.permalink ? '<a href="' + E(c.permalink) + '" target="_blank" rel="noopener">' + I('ext') + ' Open</a>' : '') + '</div>' : '';
    var box = r ? '<div class="rbox"><textarea data-w225rtext="' + c.id + '" placeholder="Reply as Welfare Avenue">' + E(r.text || '') + '</textarea><div class="row" style="margin-top:6px">' +
      (replies.length ? '<select data-w225saved="' + c.id + '"><option value="">Saved replies\u2026</option>' + replies.map(function (x) { return '<option value="' + x.id + '">' + E(x.name) + '</option>'; }).join('') + '</select>' : '') +
      '<a class="btn225 sm" data-w225ai="' + c.id + '"' + (r.busy ? ' disabled' : '') + '>' + I('star') + (r.busy ? ' Writing\u2026' : ' Suggest a reply') + '</a><span class="sp"></span><a class="btn225 sm" data-w225rpx="' + c.id + '">Cancel</a><a class="btn225 sm pri" data-w225send="' + c.id + '"' + (r.sending ? ' disabled' : '') + '>' + I('send') + ' Send</a></div></div>' : '';
    return '<div class="cm"><div class="av">' + E(String(nm).replace(/^@/, '').charAt(0).toUpperCase() || '?') + '</div><div style="min-width:0"><div class="who">' + mark(c.platform) + E(nm) + '<small>' + E(ago(c.commented_at)) + (c.like_count ? ' \u00b7 ' + c.like_count + ' likes' : '') + (c.status !== 'open' ? ' \u00b7 ' + E(c.status) : '') + (c.assigned_to ? ' \u00b7 for ' + E(c.assigned_to) : '') + '</small></div>' +
      '<div class="tx' + (c.hidden ? ' hid' : '') + '">' + E(c.text || '') + '</div>' +
      ours.map(function (o) { return '<div class="ours">' + I('chat') + ' ' + E(o.text || '') + (o.replied_by ? ' <span class="muted">(' + E(o.replied_by) + ')</span>' : '') + '</div>'; }).join('') +
      theirs.map(function (o) { return '<div style="margin:4px 0 4px 10px;font-size:12.5px"><b>' + E(o.author_handle ? '@' + o.author_handle : o.author_name || '') + '</b> ' + E(o.text || '') + '</div>'; }).join('') +
      acts + box + '</div></div>';
  }
  function inboxHtml() {
    var f = S.f, all = S.comments.filter(function (c) { return c.status !== 'deleted' || f.inbox === 'all'; });
    var tops = all.filter(function (c) { return !c.parent_external_id || !all.some(function (p) { return p.platform === c.platform && p.external_id === c.parent_external_id; }); }).filter(function (c) { return !c.from_us; });
    var kidsOf = function (c) { return all.filter(function (k) { return k.platform === c.platform && k.parent_external_id === c.external_id; }); };
    var counts = { open: tops.filter(function (c) { return c.status === 'open'; }).length, resolved: tops.filter(function (c) { return c.status === 'resolved'; }).length, hidden: tops.filter(function (c) { return c.status === 'hidden' || c.hidden; }).length, all: tops.length };
    var list = tops.filter(function (c) {
      if (f.inbox === 'open' && c.status !== 'open') return false;
      if (f.inbox === 'resolved' && c.status !== 'resolved') return false;
      if (f.inbox === 'hidden' && !(c.status === 'hidden' || c.hidden)) return false;
      if (f.ipl && c.platform !== f.ipl) return false;
      if (f.imine && lower(c.assigned_to) !== lower(myName())) return false;
      if (f.iq && (lower(c.text) + ' ' + lower(c.author_handle) + ' ' + lower(c.author_name)).indexOf(lower(f.iq)) < 0) return false;
      return true;
    });
    var sc = scoreOf(S.comments);
    var last = S.inboxLast;
    var errs = last && last.result ? Object.keys(last.result).filter(function (k) { return last.result[k] && last.result[k].error; }) : [];
    var head = '<div class="kpis"><div class="kpi"><b class="' + (counts.open ? 'warn' : 'ok') + '">' + counts.open + '</b><span>open</span></div>' +
      '<div class="kpi"><b>' + (sc.score == null ? '\u2013' : sc.score) + '</b><span>comment score</span><em>' + (sc.total ? sc.answered + ' of ' + sc.total + ' answered, 30 days' : 'No comments in 30 days') + '</em></div>' +
      '<div class="kpi"><b>' + (sc.med == null ? '\u2013' : sc.med < 1 ? Math.round(sc.med * 60) + ' min' : Math.round(sc.med) + ' h') + '</b><span>typical reply time</span><em>' + (sc.within == null ? '' : pct(sc.within) + ' within a day') + '</em></div>' +
      '<div class="kpi"><b style="font-size:18px">' + E(last && last.at ? ago(last.at) : 'never') + '</b><span>last check</span><em>' + (S.mk ? '<a data-w225sync="1" style="cursor:pointer;color:' + ROSE + ';font-weight:700">' + (S.busy.sync ? 'Checking\u2026' : 'Check now') + '</a>' : 'Every 10 minutes') + '</em></div></div>' +
      (errs.length ? '<div class="card" style="background:rgba(220,165,39,.10)"><b>Some platforms could not be read:</b> ' + errs.map(function (k) { return E(PLX[k] ? PLX[k][0] : k) + ' (' + E(clip(last.result[k].error, 120)) + ')'; }).join('; ') + '. <a data-w225go="#studio/connections" style="cursor:pointer;font-weight:700">Connections</a></div>' : '');
    var filters = '<div class="row" style="margin:0 0 12px"><span class="seg">' + [['open', 'Open'], ['resolved', 'Resolved'], ['hidden', 'Hidden'], ['all', 'Everything']].map(function (x) { return '<a data-w225ib="' + x[0] + '" class="' + (f.inbox === x[0] ? 'on' : '') + '">' + x[1] + '<span class="n">' + counts[x[0]] + '</span></a>'; }).join('') + '</span>' +
      '<span class="seg"><a data-w225ipl="" class="' + (!f.ipl ? 'on' : '') + '">All</a>' + PORDER.filter(function (k) { return S.comments.some(function (c) { return c.platform === k; }); }).map(function (k) { return '<a data-w225ipl="' + k + '" class="' + (f.ipl === k ? 'on' : '') + '">' + E(PLX[k][0]) + '</a>'; }).join('') + '</span>' +
      '<label class="muted" style="display:flex;gap:6px;align-items:center"><input type="checkbox" data-w225imine' + (f.imine ? ' checked' : '') + '> Assigned to me</label><span class="sp"></span><input type="search" data-w225iq placeholder="Search comments" value="' + E(f.iq) + '"></div>';
    /* grouped by post */
    var groups = {}, order = [];
    list.forEach(function (c) { var k = c.platform + '|' + (c.media_external_id || c.social_post_id || 'none'); if (!groups[k]) { groups[k] = []; order.push(k); } groups[k].push(c); });
    var body = order.map(function (k) {
      var g = groups[k], pp = postFor(g[0]);
      return '<div class="card"><div class="post">' + (pp.thumb ? '<img src="' + E(pp.thumb) + '" alt="" loading="lazy">' : '<div class="ph"></div>') + '<div style="min-width:0"><b>' + mark(g[0].platform) + E(clip(pp.text || 'A post', 110)) + '</b>' + (pp.url ? '<a class="muted" href="' + E(pp.url) + '" target="_blank" rel="noopener">Open the post</a>' : '') + '</div></div>' +
        g.map(function (c) { return cmHtml(c, kidsOf(c)); }).join('') + '</div>';
    }).join('');
    if (!S.mk && !S.pub) body = '<div class="card"><div class="empty">The comments are for the marketing team and admins.</div></div>';
    else if (!list.length) body = '<div class="card"><div class="empty">' + (S.comments.length ? (f.inbox === 'open' ? 'Every comment is answered.' : 'Nothing matches.') : 'No comments yet. They arrive here within 10 minutes once the Meta token has the comment permissions (Connections), and from Threads and YouTube once they are connected.') + '</div></div>';
    return head + filters + body;
  }
  var REPLY_SYSTEM = 'You reply to comments on Welfare Avenue\u2019s social media posts. Welfare Avenue is a youth-powered charity in Montreal and Toronto that serves meals and builds community. Write one reply as Welfare Avenue: warm, specific, short (one or two sentences), plain words. Thank people by name when there is a handle. Answer questions only with what the post or comment says; otherwise point to info@welfareavenue.com or the link in our bio. Never promise anything, never invent facts, dates or numbers. Reply in the language of the comment (Quebec French for French). No em dashes. At most one emoji, only when natural. Return only the reply text.';
  async function suggestReply(id) {
    var c = S.comments.filter(function (x) { return String(x.id) === String(id); })[0]; if (!c) return;
    var r = S.reply[id] = S.reply[id] || { text: '' }; r.busy = true; paint();
    try {
      var pp = postFor(c);
      var res = await db.functions.invoke('llm', { body: { task: 'draft', caller: 'content-studio', max_tokens: 300, temperature: 0.5, system: REPLY_SYSTEM, messages: [{ role: 'user', content: 'PLATFORM: ' + c.platform + '\nPOST: ' + clip(pp.text || '', 600) + '\nCOMMENT by ' + (c.author_handle || c.author_name || 'someone') + ': ' + (c.text || '') } ] } });
      if (res.error) throw res.error;
      var txt = ((res.data && res.data.content) || []).filter(function (x) { return x.type === 'text'; }).map(function (x) { return x.text; }).join(' ').replace(/\u2014/g, ',').trim();
      if (!txt) throw new Error('nothing came back');
      r.text = txt;
    } catch (x) { toastS('The Hub could not help this time: ' + (x.message || x)); }
    r.busy = false; paint();
  }
  async function inboxAct(action, id, extra) {
    if (action === 'delete' && !confirm('Delete this comment on the platform? It cannot be brought back.')) return;
    try {
      var body = Object.assign({ action: action, id: Number(id) }, extra || {});
      await fn('social-inbox', body);
      toastS({ reply: 'Reply sent', like: 'Liked', hide: 'Hidden', unhide: 'Shown again', resolve: 'Resolved', reopen: 'Reopened', delete: 'Deleted', assign: 'Assigned' }[action] || 'Done');
      if (action === 'reply') delete S.reply[id];
      var r = await q(db.from('social_comments').select('*').gte('commented_at', new Date(Date.now() - 90 * 86400000).toISOString()).order('commented_at', { ascending: false }).limit(1500));
      if (r.data) S.comments = r.data;
      paint(); try { if (window.w153) window.w153.paint(); } catch (e) { /* fine */ }
    } catch (x) { toastS('Could not ' + action + ': ' + (x.message || x)); if (action === 'reply' && S.reply[id]) { S.reply[id].sending = false; paint(); } }
  }

  /* ---------- the library: templates, hashtag groups, saved replies, tags ---------- */
  var LIBT = [['templates', 'Templates', 'template'], ['hashtags', 'Hashtag groups', 'hashtags'], ['replies', 'Saved replies', 'reply'], ['tags', 'Tags', null]];
  var TAGCOLORS = ['#6F64AB', '#2A8C7A', '#B4467A', '#DCA527', '#1877F2', '#B3402F', '#103F39', '#C13584'];
  function libTab() { var t = LIBT.filter(function (x) { return x[0] === S.sub; })[0]; return t || LIBT.filter(function (x) { return x[0] === S.f.lib; })[0] || LIBT[0]; }
  function hashCount(s) { return (String(s || '').match(/#[\p{L}\p{N}_]+/gu) || []).length; }
  function libEditor(t) {
    var e = S.libEdit; if (!e || e.tab !== t[0]) return '';
    var nm = '<label class="muted" style="display:block;margin:0 0 4px">Name</label><input type="text" data-w225lf="name" value="' + E(e.name || '') + '" style="width:100%" maxlength="80">';
    var body = '';
    if (t[0] === 'tags') {
      body = '<label class="muted" style="display:block;margin:10px 0 4px">Colour</label><div class="row" style="gap:6px">' + TAGCOLORS.map(function (c) { return '<a data-w225lcol="' + c + '" title="' + c + '" style="width:26px;height:26px;border-radius:50%;background:' + c + ';cursor:pointer;outline:' + (e.color === c ? '3px solid ' + GOLD : 'none') + ';outline-offset:2px"></a>'; }).join('') + '</div>';
    } else {
      var lab = t[0] === 'hashtags' ? 'The hashtags (Instagram takes 5 at most)' : t[0] === 'replies' ? 'The reply' : 'The caption';
      body = '<label class="muted" style="display:block;margin:10px 0 4px">' + lab + '</label><textarea data-w225lf="body" rows="' + (t[0] === 'hashtags' ? 3 : 6) + '" style="width:100%">' + E(e.body || '') + '</textarea>';
      if (t[0] === 'hashtags') { var n = hashCount(e.body); body += '<p class="muted" style="margin:4px 0 0;' + (n > 5 ? 'color:' + FLAG : '') + '">' + n + ' hashtag' + (n === 1 ? '' : 's') + (n > 5 ? ': Instagram keeps the first 5' : '') + '</p>'; }
      if (t[0] === 'templates') {
        var pls = e.platforms || [];
        body += '<label class="muted" style="display:block;margin:10px 0 4px">Platforms</label><div class="row" style="gap:6px">' + PORDER.map(function (k) { return '<label style="display:flex;gap:4px;align-items:center;font-size:12.5px"><input type="checkbox" data-w225lpl="' + k + '"' + (pls.indexOf(k) >= 0 ? ' checked' : '') + '>' + mark(k) + E(PLX[k][0]) + '</label>'; }).join('') + '</div>' +
          '<label class="muted" style="display:block;margin:10px 0 4px">First comment (optional)</label><input type="text" data-w225lf="first_comment" value="' + E(e.first_comment || '') + '" style="width:100%">';
      }
      if (t[0] === 'replies') body += '<p class="muted" style="margin:4px 0 0">Use {name} for the person\u2019s name or handle.</p>';
    }
    return '<div class="card" style="border-color:' + ROSE + '"><h3>' + I(e.id ? 'star' : 'plus') + ' ' + (e.id ? 'Change' : 'New') + ' ' + E(t[1].replace(/s$/, '').toLowerCase()) + '</h3>' + nm + body +
      '<div class="row" style="margin-top:12px"><span class="sp"></span><a class="btn225 sm" data-w225lcancel="1">Cancel</a><a class="btn225 sm pri" data-w225lsave="1"' + (S.busy.lib ? ' disabled' : '') + '>' + I('check') + ' Save</a></div></div>';
  }
  function libraryHtml() {
    var t = libTab(), mk = S.mk, qq = lower(S.f.lq);
    var tabs = '<div class="row" style="margin:0 0 12px"><span class="seg">' + LIBT.map(function (x) {
      var n = x[2] ? lib().filter(function (s) { return s.kind === x[2]; }).length : tagsAll().length;
      return '<a data-w225go="#studio/library/' + x[0] + '" class="' + (t[0] === x[0] ? 'on' : '') + '">' + E(x[1]) + '<span class="n">' + n + '</span></a>';
    }).join('') + '</span><span class="sp"></span><input type="search" data-w225lq placeholder="Search the library" value="' + E(S.f.lq || '') + '">' + (mk ? '<a class="btn225 sm pri" data-w225lnew="' + t[0] + '">' + I('plus') + ' New</a>' : '') + '</div>';
    var intro = { templates: 'Start a post from a template: the platforms, caption, first comment and tags come with it. Save one from the composer with Save as template, or make one here.', hashtags: 'Groups of hashtags to drop into a caption from the composer. Instagram counts 5 at most since December 2025, so keep the groups short.', replies: 'Answers the team sends often, ready in the Comments inbox.', tags: 'Tags sort posts by theme or campaign. Filter the calendar and the report by them.' }[t[0]];
    var items;
    if (t[0] === 'tags') {
      var used = {}; posts().forEach(function (p) { (p.tags || []).forEach(function (g) { used[g] = (used[g] || 0) + 1; }); });
      items = tagsAll().filter(function (g) { return !qq || lower(g.name).indexOf(qq) >= 0; }).map(function (g) {
        return '<div class="it"><div class="row"><span class="tagdot" style="background:' + E(g.color || PURPLE) + '"></span><b>' + E(g.name) + '</b><span class="sp"></span><span class="muted">' + (used[g.name] || 0) + ' post' + (used[g.name] === 1 ? '' : 's') + '</span></div>' +
          (mk ? '<div class="row"><a class="btn225 sm" data-w225lcal="' + E(g.name) + '">' + I('cal') + ' See the posts</a><span class="sp"></span><a class="btn225 sm" data-w225ledit="tag|' + g.id + '">Change</a><a class="btn225 sm bad" data-w225ldel="tag|' + g.id + '">' + I('trash') + '</a></div>' : '<div class="row"><a class="btn225 sm" data-w225lcal="' + E(g.name) + '">' + I('cal') + ' See the posts</a></div>') + '</div>';
      });
    } else {
      items = lib().filter(function (s) { return s.kind === t[2] && (!qq || (lower(s.name) + ' ' + lower(s.body)).indexOf(qq) >= 0); }).sort(function (a, b) { return Number(b.uses || 0) - Number(a.uses || 0) || String(a.name).localeCompare(String(b.name)); }).map(function (s) {
        var d = s.data || {}, txt = t[0] === 'templates' ? (d.caption || s.body || '') : s.body;
        var meta = t[0] === 'templates' ? (d.platforms || []).map(function (k) { return mark(k); }).join('') + ((d.tags || []).length ? ' <span class="muted">' + E(d.tags.join(', ')) + '</span>' : '') : t[0] === 'hashtags' ? '<span class="muted">' + hashCount(s.body) + ' hashtags</span>' : '';
        var use = t[0] === 'templates' ? '<a class="btn225 sm pri" data-w225luse="' + s.id + '">' + I('plus') + ' Use</a>' : '<a class="btn225 sm" data-w225lcopy="' + s.id + '">' + I('copy') + ' Copy</a>';
        return '<div class="it"><div class="row"><b style="flex:1;min-width:0">' + E(s.name) + '</b>' + (s.uses ? '<span class="muted">used ' + s.uses + '\u00d7</span>' : '') + '</div>' + (meta ? '<div>' + meta + '</div>' : '') + '<p>' + E(txt) + '</p>' +
          '<div class="row" style="margin-top:auto">' + use + '<span class="sp"></span>' + (mk ? '<a class="btn225 sm" data-w225ledit="' + t[2] + '|' + s.id + '">Change</a><a class="btn225 sm bad" data-w225ldel="' + t[2] + '|' + s.id + '" title="Remove">' + I('trash') + '</a>' : '') + '</div>' +
          '<small class="muted">' + E(s.updated_by || s.created_by || '') + (s.updated_at ? ' \u00b7 ' + E(ago(s.updated_at)) : '') + '</small></div>';
      });
    }
    return tabs + '<p class="muted" style="margin:-4px 0 12px">' + E(intro) + '</p>' + libEditor(t) +
      (items.length ? '<div class="lib">' + items.join('') + '</div>' : '<div class="card"><div class="empty">' + (qq ? 'Nothing matches.' : 'Nothing here yet.' + (mk ? ' Press New to add the first one.' : '')) + '</div></div>');
  }
  function libNew(tab) {
    var t = LIBT.filter(function (x) { return x[0] === tab; })[0] || LIBT[0];
    S.libEdit = { tab: t[0], id: null, name: '', body: t[0] === 'hashtags' ? '#WelfareAvenue ' : '', color: TAGCOLORS[tagsAll().length % TAGCOLORS.length], platforms: t[0] === 'templates' ? ['instagram', 'facebook'] : [], first_comment: '' };
  }
  function libEdit(kind, id) {
    if (kind === 'tag') { var g = tagsAll().filter(function (x) { return String(x.id) === String(id); })[0]; if (!g) return; S.libEdit = { tab: 'tags', id: g.id, name: g.name, color: g.color || PURPLE, oldName: g.name }; return; }
    var s = lib().filter(function (x) { return String(x.id) === String(id); })[0]; if (!s) return;
    var t = LIBT.filter(function (x) { return x[2] === s.kind; })[0] || LIBT[0], d = s.data || {};
    S.libEdit = { tab: t[0], id: s.id, name: s.name, body: t[0] === 'templates' ? (d.caption || s.body || '') : s.body, platforms: (d.platforms || []).slice(), first_comment: d.first_comment || '', data: d };
  }
  async function libSave() {
    var e = S.libEdit; if (!e) return;
    var name = String(e.name || '').trim(); if (!name) { toastS('Give it a name'); return; }
    S.busy.lib = true; paint();
    try {
      var r;
      if (e.tab === 'tags') {
        if (tagsAll().some(function (g) { return lower(g.name) === lower(name) && String(g.id) !== String(e.id); })) throw new Error('That tag already exists');
        r = e.id ? await db.from('content_tags').update({ name: name, color: e.color }).eq('id', e.id) : await db.from('content_tags').insert({ name: name, color: e.color, created_by: myName() || myEmail() });
        if (r.error) throw r.error;
        /* a renamed tag follows onto the posts that carry it (the ones this person may change) */
        if (e.id && e.oldName && e.oldName !== name) {
          var hit = posts().filter(function (p) { return (p.tags || []).indexOf(e.oldName) >= 0; });
          for (var i = 0; i < hit.length; i++) { await q(db.from('content_posts').update({ tags: hit[i].tags.map(function (x) { return x === e.oldName ? name : x; }) }).eq('id', hit[i].id)); }
        }
      } else {
        var kind = { templates: 'template', hashtags: 'hashtags', replies: 'reply' }[e.tab];
        var row = { name: name, body: String(e.body || ''), updated_by: myName() || myEmail(), updated_at: new Date().toISOString() };
        if (kind === 'template') row.data = Object.assign({}, e.data || {}, { platforms: (e.platforms || []).slice(), caption: String(e.body || ''), first_comment: String(e.first_comment || '') });
        r = e.id ? await db.from('content_snippets').update(row).eq('id', e.id) : await db.from('content_snippets').insert(Object.assign({ kind: kind, created_by: myName() || myEmail() }, row));
        if (r.error) throw r.error;
      }
      S.libEdit = null; var w = W(); if (w) { await w.studio(); if (e.tab === 'tags') await w.load(true); }
      toastS('Saved');
    } catch (x) { toastS('Could not save: ' + (x.message || x)); }
    S.busy.lib = false; paint();
  }
  async function libRemove(kind, id) {
    var isTag = kind === 'tag', item = isTag ? tagsAll().filter(function (x) { return String(x.id) === String(id); })[0] : lib().filter(function (x) { return String(x.id) === String(id); })[0];
    if (!item) return;
    if (!confirm('Remove "' + item.name + '" from the library?' + (isTag ? ' Posts keep the tag name, without its colour.' : ''))) return;
    try { var r = await db.from(isTag ? 'content_tags' : 'content_snippets').delete().eq('id', id); if (r.error) throw r.error; var w = W(); if (w) await w.studio(); toastS('Removed'); }
    catch (x) { toastS('Could not remove it: ' + (x.message || x)); }
    paint();
  }
  function libUse(id) {
    var s = lib().filter(function (x) { return String(x.id) === String(id); })[0]; if (!s) return;
    var d = s.data || {}, w = W();
    var pre = { platforms: (d.platforms && d.platforms.length ? d.platforms : ['instagram', 'facebook']).slice(), caption: d.caption != null ? d.caption : s.body, first_comment: d.first_comment || '', tags: (d.tags || []).slice(), title: d.title || '' };
    if (d.variants) pre.variants = d.variants;
    if (d.campaign) pre.campaign = d.campaign;
    q(db.from('content_snippets').update({ uses: Number(s.uses || 0) + 1 }).eq('id', s.id));
    if (w && w.compose) w.compose(pre); else if (window.w121Compose) window.w121Compose(pre);
  }
  function libCopy(id) {
    var s = lib().filter(function (x) { return String(x.id) === String(id); })[0]; if (!s) return;
    copyText(s.body || ''); q(db.from('content_snippets').update({ uses: Number(s.uses || 0) + 1 }).eq('id', s.id));
  }

  /* ---------- short links that count clicks (the link pages live in l_pages.js since wave230) ---------- */
  function shortUrl(code) { return HUB + '/l/' + code; }
  function randCode(n) { var a = 'abcdefghjkmnpqrstuvwxyz23456789', s = ''; for (var i = 0; i < (n || 6); i++) s += a.charAt(Math.floor(Math.random() * a.length)); return s; }
  function slug(s) { return lower(s).normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 30); }
  function clicksBy(linkId) { return S.clicks.filter(function (c) { return String(c.link_id) === String(linkId); }); }
  function sparkHtml(list, days) {
    days = days || 30; var t = today(), b = [], mx = 1;
    for (var i = days - 1; i >= 0; i--) { var d = addDays(t, -i), n = list.filter(function (c) { return dayOf(c.at) === d; }).length; b.push([d, n]); if (n > mx) mx = n; }
    return '<div class="spark" role="img" aria-label="Clicks a day, last ' + days + ' days">' + b.map(function (x) { return '<i style="height:' + Math.max(2, Math.round(x[1] / mx * 100)) + '%" title="' + E(niceDate(x[0])) + ': ' + x[1] + '"></i>'; }).join('') + '</div>';
  }
  function topOf(list, key, n) { var m = {}; list.forEach(function (c) { var k = c[key] || 'unknown'; m[k] = (m[k] || 0) + 1; }); return Object.keys(m).map(function (k) { return [k, m[k]]; }).sort(function (a, b) { return b[1] - a[1]; }).slice(0, n || 5); }
  function linksTabs() { return '<div class="row" style="margin:0 0 12px"><span class="muted">Short links for posts, emails and print. The link in our bio and its insights live in <a data-w225go="#studio/pages" style="cursor:pointer;font-weight:700;color:' + ROSE + '">Link pages</a>.</span></div>'; }
  function linksHtml() {
    if (S.sub === 'bio') { setTimeout(function () { go('#studio/pages'); }, 0); return ''; }
    var all = S.links.filter(function (l) { return !/^(bio|lp)-/.test(l.code); }), qq = lower(S.f.kq);
    var list = all.filter(function (l) { return (S.f.kall || l.active) && (!qq || (lower(l.code) + ' ' + lower(l.label) + ' ' + lower(l.url) + ' ' + lower(l.campaign)).indexOf(qq) >= 0); });
    var c30 = S.clicks, c7 = c30.filter(function (c) { return Date.now() - new Date(c.at).getTime() < 7 * 86400000; });
    var bio = S.links.filter(function (l) { return /^(bio|lp)-/.test(l.code); }).map(function (l) { return String(l.id); });
    var bioClicks = c30.filter(function (c) { return bio.indexOf(String(c.link_id)) >= 0; }).length;
    var kpis = '<div class="kpis"><div class="kpi"><b>' + num(c30.length) + '</b><span>clicks, 30 days</span><em>' + num(c7.length) + ' in the last 7</em></div><div class="kpi"><b>' + all.filter(function (l) { return l.active; }).length + '</b><span>live short links</span></div><div class="kpi" data-w225go="#studio/pages"><b>' + num(bioClicks) + '</b><span>link page clicks, 30 days</span></div>' +
      '<div class="kpi"><b style="font-size:17px">' + E((topOf(c30, 'device', 1)[0] || ['\u2013'])[0]) + '</b><span>most clicks from</span><em>' + E(topOf(c30, 'referrer_host', 2).map(function (x) { return x[0] + ' ' + x[1]; }).join(' \u00b7 ')) + '</em></div></div>';
    var mk = S.mk;
    var form = '<div class="card"><h3>' + I('plus') + ' Make a short link <small>anyone on staff</small></h3><div class="row" style="gap:8px"><input type="url" id="w225kurl" placeholder="https://welfareavenue.com/\u2026" style="flex:2;min-width:220px"><input type="text" id="w225klabel" placeholder="What it is (for us)" style="flex:1;min-width:150px"><input type="text" id="w225kcode" placeholder="Ending (optional)" style="width:150px" maxlength="40"><input type="text" id="w225kcamp" placeholder="Campaign (optional)" style="width:160px"><a class="btn225 sm pri" data-w225kmake="1"' + (S.busy.link ? ' disabled' : '') + '>' + I('link') + ' Make it</a></div><p class="muted" style="margin:8px 0 0">The short link is ' + E(HUB) + '/l/<i>ending</i>. Posts make their own when Tracked links is on in the composer, with the UTM tags added.</p></div>';
    var rows = list.map(function (l) {
      var cl = clicksBy(l.id), p = l.post_id ? posts().filter(function (x) { return String(x.id) === String(l.post_id); })[0] : null;
      return '<div class="card" style="padding:12px 14px;' + (l.active ? '' : 'opacity:.6') + '"><div class="row" style="gap:10px;align-items:flex-start"><div style="flex:1;min-width:0"><b>' + E(l.label || l.code) + '</b>' + (l.platform ? ' ' + mark(l.platform) : '') + (l.campaign ? ' <span class="pill">' + E(l.campaign) + '</span>' : '') + (l.active ? '' : ' <span class="pill bad">off</span>') +
        '<div style="font-size:12.5px;margin-top:3px"><a href="' + E(shortUrl(l.code)) + '" target="_blank" rel="noopener" style="color:' + ROSE + ';font-weight:700">' + E(shortUrl(l.code).replace(/^https:\/\//, '')) + '</a> <span class="muted">\u2192 ' + E(clip(l.url, 90)) + '</span></div>' +
        (p ? '<div class="muted" style="font-size:12px;margin-top:2px;cursor:pointer" data-w225open="' + p.id + '">From the post: ' + E(clip(titleOf(p), 60)) + '</div>' : '') + '</div>' +
        '<div style="width:150px">' + sparkHtml(cl, 30) + '<div class="muted" style="font-size:11.5px;text-align:right">' + num(l.clicks || 0) + ' in all \u00b7 ' + cl.length + ' in 30 days</div></div>' +
        '<div class="row" style="gap:4px"><a class="btn225 sm" data-w225kcopy="' + E(l.code) + '" title="Copy">' + I('copy') + '</a>' + (mk ? '<a class="btn225 sm" data-w225kact="' + (l.active ? 'off' : 'on') + '|' + l.id + '">' + (l.active ? 'Switch off' : 'Switch on') + '</a>' : '') + '</div></div></div>';
    }).join('');
    return linksTabs() + kpis + '<div class="card"><h3>' + I('bolt') + ' Clicks a day <small>every short link, 30 days</small></h3>' + sparkHtml(c30, 30) + '</div>' + form +
      '<div class="row" style="margin:0 0 10px"><input type="search" data-w225kq placeholder="Search the links" value="' + E(S.f.kq || '') + '"><label class="muted" style="display:flex;gap:6px;align-items:center"><input type="checkbox" data-w225kall' + (S.f.kall ? ' checked' : '') + '> Show the switched-off ones</label></div>' +
      (rows || '<div class="card"><div class="empty">' + (all.length ? 'Nothing matches.' : 'No short links yet.') + '</div></div>');
  }
  async function makeLink(url, label, code, campaign, extra) {
    url = String(url || '').trim(); if (!/^https?:\/\/\S+\.\S+/.test(url)) throw new Error('Paste a full address that starts with https://');
    code = String(code || '').trim(); if (code && !/^[A-Za-z0-9_-]{3,40}$/.test(code)) throw new Error('The ending takes letters, numbers, - and _ (3 to 40)');
    if (code && /^(bio|lp)-/.test(code) && !(extra && extra.bio)) throw new Error('Endings that start with lp- are for the link pages');
    var tries = code ? 1 : 4;
    for (var i = 0; i < tries; i++) {
      var c = code || randCode(6);
      var r = await db.from('short_links').insert(Object.assign({ code: c, url: url, label: label || null, campaign: campaign || null, created_by: myName() || myEmail() }, extra && extra.row || {})).select('*').maybeSingle();
      if (!r.error) { S.links.unshift(r.data); return r.data; }
      if (String(r.error.code) !== '23505') throw r.error;
      if (code) throw new Error('That ending is taken: pick another');
    }
    throw new Error('Could not find a free ending, try again');
  }
  async function makeLinkFromForm() {
    var g = function (id) { var el = document.getElementById(id); return el ? el.value : ''; };
    S.busy.link = true;
    try { var l = await makeLink(g('w225kurl'), g('w225klabel').trim(), g('w225kcode'), g('w225kcamp').trim()); ['w225kurl', 'w225klabel', 'w225kcode', 'w225kcamp'].forEach(function (id) { var el = document.getElementById(id); if (el) el.value = ''; }); copyText(shortUrl(l.code)); toastS('Made and copied: ' + shortUrl(l.code).replace(/^https:\/\//, '')); }
    catch (x) { toastS(x.message || String(x)); }
    S.busy.link = false; paint();
  }
  async function linkActive(id, on) {
    try { var r = await db.from('short_links').update({ active: on }).eq('id', id); if (r.error) throw r.error; S.links.forEach(function (l) { if (String(l.id) === String(id)) l.active = on; }); toastS(on ? 'Switched on' : 'Switched off: the link now goes to the website'); }
    catch (x) { toastS('Could not change it: ' + (x.message || x)); }
    paint();
  }


  /* ---------- connections: how the Hub reaches each platform ---------- */
  var REDIRECT = 'https://zwnmulmnvopclzcvytce.supabase.co/functions/v1/social-connect';
  var CONSOLE = {
    threads: ['https://developers.facebook.com/apps/', 'Meta for Developers: the Welfare Avenue Threads app, Use cases, Access the Threads API, Settings'],
    youtube: ['https://console.cloud.google.com/apis/credentials', 'Google Cloud: APIs and services, Credentials, the Web client'],
    tiktok: ['https://developers.tiktok.com/apps/', 'TikTok for Developers: Manage apps, the Welfare Avenue app, Basic information'],
    linkedin: ['https://www.linkedin.com/developers/apps', 'LinkedIn Developers: My apps, the Welfare Avenue app, Auth']
  };
  var CX_STEPS = {
    threads: ['Steel adds the Welfare Avenue Threads account as a Threads tester in the app and accepts the invite in Threads (Settings, Account, Website permissions).', 'Copy the Threads app ID and app secret below and save them.', 'Press Connect and sign in to Threads as @welfareavenue.'],
    youtube: ['In Google Cloud, the OAuth client lists the redirect address below and the YouTube Data API v3 is on.', 'Copy the client ID and client secret below and save them.', 'Press Connect and pick the Welfare Avenue channel (the brand account).'],
    tiktok: ['The TikTok app has Login Kit and Content Posting API with video.upload, and the redirect address below.', 'Copy the client key and client secret below and save them.', 'Press Connect and sign in to TikTok as Welfare Avenue. Videos then land in the TikTok drafts to finish in the app.'],
    linkedin: ['Once LinkedIn approves the Community Management API, copy the client ID and secret below.', 'Press Connect and sign in as a Page admin. Until then, the Make route below posts to the Page.']
  };
  function connOf(k) { return (S.conn && S.conn.connections && S.conn.connections[k]) || {}; }
  function chips(list, cls) { return (list || []).map(function (x) { return '<span class="' + (cls || '') + '">' + E(x) + '</span>'; }).join(''); }
  function statusLine(k) {
    var m = modeOf(k), mm = MODE[m] || MODE.reminder, c = connOf(k);
    return '<small style="color:' + mm[1] + ';font-weight:700">' + E(mm[0]) + '</small>' + (c.name || c.handle ? ' <small>\u00b7 ' + E(c.handle ? '@' + c.handle : c.name) + '</small>' : '') + (c.connected_at ? ' <small>\u00b7 since ' + E(niceDate(dayOf(c.connected_at), { month: 'short', day: 'numeric', year: 'numeric' })) + '</small>' : '');
  }
  function hdr(k, sub, name) { var x = PLX[k] || ['Make.com', 'M', '#6D00CC']; return '<div class="hd"><div class="lg" style="background:' + x[2] + '">' + E(x[1]) + '</div><div><b>' + E(name || x[0]) + '</b>' + (sub || statusLine(k)) + '</div></div>'; }
  function metaCard() {
    var cx = cap() || {}, c = connOf('meta'), can = S.conn && S.conn.can_meta, granted = cx.granted || c.granted || [], missing = cx.missing || c.missing || [];
    var html = '<div class="card">' + hdr('instagram', '<small>Instagram and Facebook, through the Meta system user token</small>', 'Meta') +
      '<div class="row" style="gap:6px">' + ['instagram', 'facebook'].map(function (k) { var mm = MODE[modeOf(k)] || MODE.reminder; return mark(k) + '<small style="color:' + mm[1] + ';font-weight:700;margin-right:8px">' + E(mm[0]) + '</small>'; }).join('') + '</div>' +
      (cx.token === false ? '<p style="color:' + FLAG + ';margin:0">No Meta token in the vault yet.</p>' : '') +
      (granted.length ? '<div class="chips">' + chips(granted) + chips(missing, 'miss') + '</div>' : '') +
      (missing.length ? '<p class="muted" style="margin:0;color:' + FLAG + '">Missing: ' + E(missing.join(', ')) + '. Comments' + (missing.some(function (x) { return /publish|manage_posts/.test(x); }) ? ', posting' : '') + ' and some formats wait for a token with these. Section 2 of the setup doc says how to make it.</p>' : granted.length ? '<p class="muted" style="margin:0">Every permission the Studio uses is there.</p>' : '') +
      (c.replaced_at ? '<p class="muted" style="margin:0">Replaced ' + E(ago(c.replaced_at)) + ' by ' + E(String(c.replaced_by || '').split('@')[0]) + '.</p>' : '');
    if (can) html += '<h4>Replace the token</h4><div class="row" style="gap:6px"><input type="password" id="w225metatok" autocomplete="off" spellcheck="false" placeholder="Paste the new system user token" style="flex:1;min-width:200px"><a class="btn225 sm" data-w225cx="meta_check">Check it</a><a class="btn225 sm pri" data-w225cx="meta_save"' + (S.busy.meta ? ' disabled' : '') + '>Replace</a></div><p class="muted" style="margin:0">It goes straight into the vault. The Hub never shows it again.</p>' + (S.keys.metaCheck ? '<div class="chips">' + chips(S.keys.metaCheck.granted) + chips(S.keys.metaCheck.missing, 'miss') + '</div>' : '');
    else html += '<p class="muted" style="margin:0">An admin replaces the token.</p>';
    return html + '</div>';
  }
  function appCard(k) {
    var c = connOf(k), st = S.conn || {}, ch = st.can_change, con = CONSOLE[k];
    var connected = c.status === 'connected';
    var html = '<div class="card">' + hdr(k) +
      (c.last_error ? '<p style="color:' + FLAG + ';margin:0;font-size:12.5px">' + E(c.last_error) + '</p>' : '') +
      '<ol>' + CX_STEPS[k].map(function (s) { return '<li>' + E(s) + '</li>'; }).join('') + '</ol>' +
      '<div style="font-size:12px">Redirect address <code>' + E(REDIRECT) + '</code> <a data-w225ccopy="' + E(REDIRECT) + '" style="cursor:pointer" title="Copy">' + I('copy') + '</a></div>' +
      (k === 'threads' ? '<div style="font-size:12px">Uninstall callback <code>' + E(REDIRECT + '?event=uninstall') + '</code> <a data-w225ccopy="' + E(REDIRECT + '?event=uninstall') + '" style="cursor:pointer">' + I('copy') + '</a><br>Delete callback <code>' + E(REDIRECT + '?event=delete') + '</code> <a data-w225ccopy="' + E(REDIRECT + '?event=delete') + '" style="cursor:pointer">' + I('copy') + '</a></div>' : '') +
      (con ? '<a class="muted" href="' + con[0] + '" target="_blank" rel="noopener" style="font-size:12px">' + I('ext') + ' ' + E(con[1]) + '</a>' : '');
    if (ch) {
      html += '<h4>App keys ' + (c.app_saved ? '<span class="pill ok" style="text-transform:none;letter-spacing:0">saved ' + E(c.app_id || '') + '</span>' : '') + '</h4>' +
        '<div class="row" style="gap:6px"><input type="text" id="w225cid-' + k + '" autocomplete="off" spellcheck="false" placeholder="' + (k === 'tiktok' ? 'Client key' : k === 'threads' ? 'Threads app ID' : 'Client ID') + '" style="flex:1;min-width:140px"><input type="password" id="w225csec-' + k + '" autocomplete="off" placeholder="' + (k === 'threads' ? 'Threads app secret' : 'Client secret') + '" style="flex:1;min-width:140px"><a class="btn225 sm" data-w225cx="save_app|' + k + '">Save the keys</a></div>' +
        '<div class="row" style="gap:6px;margin-top:4px">' + (connected ? '<span class="pill ok">' + I('check') + ' Connected</span><span class="sp"></span><a class="btn225 sm" data-w225cx="start|' + k + '">Connect again</a><a class="btn225 sm bad" data-w225cx="disconnect|' + k + '">Disconnect</a>' : '<span class="sp"></span><a class="btn225 sm pri" data-w225cx="start|' + k + '"' + (c.app_saved ? '' : ' disabled title="Save the app keys first"') + '>' + I('plug') + ' Connect</a>') + '</div>';
      if (k === 'youtube' && connected) html += '<div class="row"><span class="muted" style="flex:1">Try it with an unlisted Short only you can see.</span><a class="btn225 sm" data-w225cx="test_short">' + I('send') + ' Send a test Short</a></div>';
    } else html += '<p class="muted" style="margin:0">A marketing lead or an admin connects it.</p>';
    return html + '</div>';
  }
  function makeCard() {
    var c = connOf('make'), ch = S.conn && S.conn.can_change, li = modeOf('linkedin');
    var html = '<div class="card">' + hdr('make', '<small>Posts to the LinkedIn Page until LinkedIn approves the direct connection' + (li === 'make' ? ' \u00b7 <b style="color:' + TEAL + '">in use</b>' : '') + '</small>') +
      '<ol><li>In Make, a scenario starts with Webhooks, Custom webhook. Copy its address and save it below.</li><li>Press Send Make a sample, then in Make press Redetermine data structure (or run once) so it learns the fields.</li><li>Add a filter: secret equals the code below. Then LinkedIn, Create a company text post (or image post when image_url is filled), with text as the content.</li><li>Turn the scenario on. Send a test post if you want to see it on the Page.</li></ol>';
    if (ch) {
      html += '<div class="row" style="gap:6px"><input type="url" id="w225mkhook" autocomplete="off" placeholder="' + (c.saved ? 'Saved. Paste a new address to replace it' : 'https://hook.us2.make.com/\u2026') + '" style="flex:1;min-width:200px"><a class="btn225 sm" data-w225cx="make_hook">Save</a></div>' +
        (c.secret ? '<div style="font-size:12px">The filter code <code>' + E(c.secret) + '</code> <a data-w225ccopy="' + E(c.secret) + '" style="cursor:pointer">' + I('copy') + '</a></div>' : '') +
        '<div class="row" style="gap:6px">' + (c.saved ? '<a class="btn225 sm" data-w225cx="make_sample">Send Make a sample</a><a class="btn225 sm" data-w225cx="make_test">' + I('send') + ' Send a test post</a><span class="sp"></span><a class="btn225 sm bad" data-w225cx="disconnect|make">Forget it</a>' : '') + '</div>' +
        (c.sampled_at || c.tested_at ? '<p class="muted" style="margin:0">' + (c.sampled_at ? 'Sample sent ' + E(ago(c.sampled_at)) + '. ' : '') + (c.tested_at ? 'Test post ' + E(ago(c.tested_at)) + (c.tested_ok ? ', Make took it.' : ', Make refused it.') : '') + '</p>' : '');
    } else html += '<p class="muted" style="margin:0">' + (c.saved ? 'Set up.' : 'Not set up yet.') + ' A marketing lead or an admin changes it.</p>';
    return html + '</div>';
  }
  function remindCard() {
    var man = PORDER.filter(function (k) { return modeOf(k) === 'reminder'; });
    return '<div class="card">' + '<div class="hd"><div class="lg" style="background:' + GOLD + ';color:' + GREEN + '">' + I('clock') + '</div><div><b>Reminders</b><small>For every platform the Hub cannot post to yet</small></div></div>' +
      '<p style="margin:0;font-size:12.5px">At the post\u2019s time, its owner gets a Hub notification and a Slack message with the caption and the media. They post it in the app, then press Mark posted in the composer, so the calendar and the goals stay right.</p>' +
      '<p class="muted" style="margin:0">' + (man.length ? 'By reminder now: ' + E(man.map(function (k) { return PLX[k][0]; }).join(', ')) + '.' : 'Every platform posts on its own.') + ' People turn these off in their notification settings (Content Studio).</p>' +
      '<div class="row"><span class="sp"></span><a class="btn225 sm" data-w225cx="remind_preview">' + I('eye') + ' Preview a reminder</a></div>' +
      (S.keys.remind ? '<div style="white-space:pre-wrap;font-size:12px;background:rgba(16,63,57,.05);border-radius:10px;padding:10px">' + E(S.keys.remind) + '</div>' : '') + '</div>';
  }
  function connectHtml() {
    if (!S.conn) { loadConn().then(paint); return '<div class="card"><div class="empty">Checking the connections\u2026</div></div>'; }
    if (S.conn.error) return '<div class="card"><div class="empty">Could not read the connections: ' + E(S.conn.error) + ' <a data-w225cx="reload" style="cursor:pointer;font-weight:700">Try again</a></div></div>';
    var flash = S.keys.flash ? '<div class="card" style="background:' + (S.keys.flash.ok ? 'rgba(42,140,122,.10)' : 'rgba(179,64,47,.08)') + '">' + E(S.keys.flash.text) + '</div>' : '';
    return flash + '<div class="row" style="margin:0 0 12px"><span class="muted">Every platform posts straight from the Hub once it is connected. Until then, the Hub reminds the post\u2019s owner to post it by hand. Keys and tokens go into the vault and are never shown again.</span><span class="sp"></span><a class="btn225 sm" data-w225cx="reload">' + I('refresh') + ' Check again</a></div>' +
      '<div class="cx">' + metaCard() + appCard('threads') + appCard('youtube') + appCard('tiktok') + appCard('linkedin') + makeCard() + remindCard() + '</div>' +
      '<p class="muted" style="margin:14px 0 0">The setup doc (09/10/26) has every form, answer and email for these steps.</p>';
  }
  /* the platforms send people back to #studio/connections?connected=x or ?error= */
  function connFlash() {
    var h = location.hash || '', i = h.indexOf('?'); if (i < 0) return;
    var p = new URLSearchParams(h.slice(i + 1)), ok = p.get('connected'), er = p.get('error');
    if (ok) S.keys.flash = { ok: true, text: (PLX[ok] ? PLX[ok][0] : ok) + ' is connected. New posts go there directly.' };
    else if (er) S.keys.flash = { ok: false, text: er };
    S.conn = null;
    try { history.replaceState(null, '', location.pathname + location.search + h.slice(0, i)); } catch (e) { /* fine */ }
  }
  async function connAct(what) {
    var parts = String(what).split('|'), a = parts[0], k = parts[1];
    var val = function (id) { var el = document.getElementById(id); return el ? el.value.trim() : ''; };
    var clear = function (id) { var el = document.getElementById(id); if (el) el.value = ''; };
    try {
      if (a === 'reload') { S.conn = null; S.keys.flash = null; var w = W(); if (w) await w.loadCap(); paint(); return; }
      if (a === 'meta_check' || a === 'meta_save') {
        var tok = val('w225metatok'); if (!tok) { toastS('Paste the token first'); return; }
        S.busy.meta = true; paint();
        var r = await fn('social-connect', { action: 'meta_token', token: tok, check_only: a === 'meta_check' });
        S.keys.metaCheck = { granted: r.granted || [], missing: r.missing || [] };
        if (a === 'meta_save') { clear('w225metatok'); toastS('Replaced. ' + (r.missing && r.missing.length ? r.missing.length + ' permissions still missing' : 'Every permission is there')); S.conn = null; var w2 = W(); if (w2) await w2.loadCap(); }
        else toastS(r.missing && r.missing.length ? 'Missing ' + r.missing.length + ': ' + r.missing.join(', ') : 'Every permission is there');
        S.busy.meta = false; paint(); return;
      }
      if (a === 'save_app') {
        var id = val('w225cid-' + k), sec = val('w225csec-' + k); if (!id || !sec) { toastS('Paste both the ID and the secret'); return; }
        await fn('social-connect', { action: 'save_app', platform: k, id: id, secret: sec }); clear('w225cid-' + k); clear('w225csec-' + k);
        toastS('Saved in the vault'); await loadConn(); paint(); return;
      }
      if (a === 'start') { var s = await fn('social-connect', { action: 'start', platform: k }); if (s && s.url) location.href = s.url; return; }
      if (a === 'disconnect') {
        if (!confirm('Disconnect ' + (PLX[k] ? PLX[k][0] : 'Make') + '? Posts go back to reminders until it is connected again.')) return;
        await fn('social-connect', { action: 'disconnect', platform: k }); toastS('Disconnected'); await loadConn(); var w3 = W(); if (w3) await w3.loadCap(); paint(); return;
      }
      if (a === 'make_hook') { var u = val('w225mkhook'); if (!u) { toastS('Paste the webhook address'); return; } await fn('social-connect', { action: 'make_hook', url: u }); clear('w225mkhook'); toastS('Saved. Now send Make a sample'); await loadConn(); var w4 = W(); if (w4) await w4.loadCap(); paint(); return; }
      if (a === 'make_sample') { var m = await fn('social-connect', { action: 'make_sample' }); toastS(m.ok ? 'Make got the sample' : 'Make answered ' + m.status + ': is the scenario listening?'); await loadConn(); paint(); return; }
      if (a === 'make_test') {
        if (!confirm('This puts a real post on the Welfare Avenue LinkedIn Page: "Testing the connection between the Welfare Avenue Hub and our LinkedIn Page. Please ignore this post." Send it?')) return;
        var t = await fn('social-connect', { action: 'make_test', confirm: true }); toastS(t.ok ? 'Sent: check the LinkedIn Page in a minute' : 'Make answered ' + t.status); await loadConn(); paint(); return;
      }
      if (a === 'test_short') {
        var w5 = W(); var pre = { title: 'Test Short from the Hub', platforms: ['youtube'], caption: 'Testing the connection between the Welfare Avenue Hub and YouTube.', variants: { youtube: { title: 'Test from the Hub', privacy: 'unlisted', kids: false } } };
        toastS('Add a short vertical video, then Publish now. It goes up unlisted.');
        if (w5 && w5.compose) w5.compose(pre); return;
      }
      if (a === 'remind_preview') {
        var cand = posts().filter(function (p) { return ['draft', 'scheduled'].indexOf(p.status) >= 0 && (p.platforms || []).some(function (x) { return modeOf(x) === 'reminder'; }); }).sort(function (x, y) { return String(x.scheduled_at || '9').localeCompare(String(y.scheduled_at || '9')); })[0];
        if (!cand) { S.keys.remind = 'No planned post goes out by reminder. Make one for LinkedIn, TikTok or YouTube to see the message.'; paint(); return; }
        var pl = (cand.platforms || []).filter(function (x) { return modeOf(x) === 'reminder'; })[0];
        var rr = await fn('social-publish', { action: 'remind_test', post_id: cand.id, platform: pl });
        var plan = rr.plan || {}; S.keys.remind = 'To: ' + (plan.to || 'nobody (the post has no owner)') + '\n\n' + String(plan.slack || '').replace(/<([^|>]+)\|([^>]+)>/g, '$2').replace(/\*/g, ''); paint(); return;
      }
    } catch (x) { S.busy.meta = false; toastS((x.message || String(x))); paint(); }
  }

  /* ---------- the monthly report (printable) ---------- */
  function repMonth() { var m = /^\d{4}-\d{2}$/.test(S.sub) ? S.sub : (S.reportMonth || today().slice(0, 7)); S.reportMonth = m; return m; }
  function monthAdd(m, n) { var d = new Date(m + '-15T12:00:00'); d.setMonth(d.getMonth() + n); return ymd(d).slice(0, 7); }
  function monthName(m) { try { return new Date(m + '-15T12:00:00').toLocaleDateString('en-CA', { month: 'long', year: 'numeric' }); } catch (e) { return m; } }
  function engOf(sp) { return Number(sp.engagement || (Number(sp.likes || 0) + Number(sp.comments || 0) + Number(sp.shares || 0) + Number(sp.saves || 0))); }
  function monthStats(m) {
    var inM = function (iso) { return iso && dayOf(iso).slice(0, 7) === m; };
    var out = posts().filter(function (p) { return inM(p.published_at || p.scheduled_at) && (['published', 'posted'].indexOf(p.status) >= 0 || Object.keys(p.results || {}).some(function (k) { return p.results[k] && (p.results[k].id || p.results[k].posted_at); })); });
    var sp = S.social.filter(function (x) { return inM(x.published_at) && PORDER.indexOf(x.platform) >= 0; });
    var per = {}; PORDER.forEach(function (k) { per[k] = { posts: 0, reach: 0, eng: 0, likes: 0, comments: 0, shares: 0, n: 0 }; });
    sp.forEach(function (x) { var r = per[x.platform]; r.n++; r.reach += Number(x.reach || x.views || 0); r.eng += engOf(x); r.likes += Number(x.likes || 0); r.comments += Number(x.comments || 0); r.shares += Number(x.shares || 0); });
    out.forEach(function (p) { (p.platforms || []).forEach(function (k) { if (per[k]) per[k].posts++; }); });
    var reach = 0, eng = 0; PORDER.forEach(function (k) { reach += per[k].reach; eng += per[k].eng; });
    var tags = {}; out.forEach(function (p) { (p.tags || []).forEach(function (t) { tags[t] = (tags[t] || 0) + 1; }); });
    var cms = S.comments.filter(function (c) { return !c.from_us && inM(c.commented_at); });
    var answered = cms.filter(function (c) { return c.status === 'resolved' || S.comments.some(function (k) { return k.from_us && k.platform === c.platform && k.parent_external_id === c.external_id; }); }).length;
    return { posts: out, social: sp, per: per, reach: reach, eng: eng, rate: reach ? eng / reach : NaN, tags: tags, comments: cms.length, answered: answered, top: sp.slice().sort(function (a, b) { return engOf(b) - engOf(a); }).slice(0, 5) };
  }
  function delta(a, b) { if (!isFinite(a) || !isFinite(b) || !b) return ''; var d = (a - b) / b; return '<em class="' + (d >= 0 ? 'ok' : 'bad') + '" style="font-style:normal;font-size:11.5px;font-weight:700;color:' + (d >= 0 ? TEAL : FLAG) + '">' + (d >= 0 ? '\u25b2 ' : '\u25bc ') + Math.abs(Math.round(d * 100)) + '% on ' + E(monthName(monthAdd(S.reportMonth, -1)).split(' ')[0]) + '</em>'; }
  function weeksIn(m) { var out = [], d = mondayOf(m + '-01'); while (d.slice(0, 7) <= m) { if (addDays(d, 6).slice(0, 7) >= m && addDays(d, 6) < today()) out.push(d); d = addDays(d, 7); } return out; }
  function goalWeeks(m) {
    var g = goals(), any = PORDER.some(function (k) { return Number(g[k] || 0) > 0; }); if (!any) return null;
    var wk = weeksIn(m), met = 0;
    wk.forEach(function (w) { var off = Math.round((new Date(w + 'T12:00:00') - new Date(mondayOf(today()) + 'T12:00:00')) / (7 * 86400000)); var gs = goalStatus(off), ok = true; PORDER.forEach(function (k) { if (gs[k].goal > 0 && gs[k].n < gs[k].goal) ok = false; }); if (ok) met++; });
    return { met: met, of: wk.length };
  }
  function reportClicks(m) {
    var key = 'clicks-' + m; if (S.keys[key]) return S.keys[key];
    S.keys[key] = { loading: true, n: null };
    var a = m + '-01T00:00:00', b = monthAdd(m, 1) + '-01T00:00:00';
    q(db.from('short_link_clicks').select('id', { count: 'exact', head: true }).gte('at', new Date(a).toISOString()).lt('at', new Date(b).toISOString())).then(function (r) { S.keys[key] = { n: r.count == null ? null : r.count }; if (S.sec === 'report') paint(); });
    return S.keys[key];
  }
  function reportHtml() {
    var m = repMonth(), st = monthStats(m), prev = monthStats(monthAdd(m, -1)), gw = goalWeeks(m), cl = reportClicks(m), cur = today().slice(0, 7);
    var note = S.keys['note-' + m] || '';
    var bar = '<div class="row noprint" style="margin:0 0 12px"><a class="btn225 sm" data-w225go="#studio/report/' + monthAdd(m, -1) + '">\u2039 ' + E(monthName(monthAdd(m, -1))) + '</a>' + (m < cur ? '<a class="btn225 sm" data-w225go="#studio/report/' + monthAdd(m, 1) + '">' + E(monthName(monthAdd(m, 1))) + ' \u203a</a>' : '') + '<span class="sp"></span><a class="btn225 sm" data-w225rcopy="1">' + I('copy') + ' Copy a summary</a><a class="btn225 sm pri" data-w225print="1">' + I('print') + ' Print or save as PDF</a></div>';
    var k = function (v, l, d) { return '<div class="kpi"><b>' + v + '</b><span>' + E(l) + '</span>' + (d || '') + '</div>'; };
    var kpis = '<div class="kpis">' + k(st.posts.length, 'posts out', delta(st.posts.length, prev.posts.length)) + k(st.reach ? num(st.reach) : '\u2013', 'reach and views', delta(st.reach, prev.reach)) + k(st.eng ? num(st.eng) : '\u2013', 'likes, comments, shares, saves', delta(st.eng, prev.eng)) + k(pct(st.rate), 'engagement over reach') +
      k(cl.n == null ? '\u2013' : num(cl.n), 'link clicks') + k(st.comments ? Math.round(st.answered / st.comments * 100) + '%' : '\u2013', 'comments answered', '<em>' + st.comments + ' comments</em>') + (gw ? k(gw.met + '/' + gw.of, 'weeks every goal met') : '') + '</div>';
    var rows = PORDER.filter(function (x) { return st.per[x].posts || st.per[x].n; }).map(function (x) { var r = st.per[x]; return '<tr><td>' + mark(x) + E(PLX[x][0]) + '</td><td>' + r.posts + '</td><td>' + (r.reach ? num(r.reach) : '\u2013') + '</td><td>' + num(r.likes) + '</td><td>' + num(r.comments) + '</td><td>' + num(r.shares) + '</td><td>' + (r.reach ? pct(r.eng / r.reach) : '\u2013') + '</td></tr>'; }).join('');
    var table = '<h4>By platform</h4>' + (rows ? '<table style="width:100%;border-collapse:collapse;font-size:12.5px" class="rt"><thead><tr style="text-align:left;color:' + MUTED + '"><th>Platform</th><th>Posts</th><th>Reach</th><th>Likes</th><th>Comments</th><th>Shares</th><th>Rate</th></tr></thead><tbody>' + rows + '</tbody></table>' : '<p class="muted">Nothing went out this month.</p>');
    var top = '<h4>The best posts</h4>' + (st.top.length ? st.top.map(function (x, i) { var u = x.thumb_cached || x.thumb_url; return '<div class="pl" style="cursor:default">' + (u ? '<img src="' + E(u) + '" alt="">' : '<div class="ph"></div>') + '<div style="min-width:0"><b><span style="font-family:' + HEAD + ';color:' + GOLD + ';margin-right:6px">' + (i + 1) + '</span>' + E(clip(x.caption || 'A post', 90)) + '</b><small>' + mark(x.platform) + ' ' + E(niceDate(dayOf(x.published_at), { month: 'short', day: 'numeric' })) + ' \u00b7 ' + num(x.reach || x.views || 0) + ' reach \u00b7 ' + num(engOf(x)) + ' engagements</small></div></div>'; }).join('') : '<p class="muted">No results yet for this month.</p>');
    var tg = Object.keys(st.tags).sort(function (a, b) { return st.tags[b] - st.tags[a]; });
    var tags = tg.length ? '<h4>Themes</h4><div class="row" style="gap:6px">' + tg.map(function (t) { var g = tagsAll().filter(function (x) { return x.name === t; })[0]; return '<span class="pill"><span class="tagdot" style="background:' + E(g && g.color || PURPLE) + '"></span> ' + E(t) + ' \u00b7 ' + st.tags[t] + '</span>'; }).join('') + '</div>' : '';
    var notes = '<h4>What we learned</h4><textarea data-w225rnote="' + m + '" rows="3" class="noprint" style="width:100%" placeholder="A line or two for the board or the team (kept until you leave the page)">' + E(note) + '</textarea>' + (note ? '<p class="printonly" style="white-space:pre-wrap;font-size:13px">' + E(note) + '</p>' : '');
    return bar + '<div class="rep"><div class="row"><div><h2>Content report, ' + E(monthName(m)) + '</h2><span class="muted">Welfare Avenue \u00b7 Instagram, Facebook, Threads, LinkedIn, TikTok and YouTube \u00b7 made ' + E(niceDate(today(), { month: 'long', day: 'numeric', year: 'numeric' })) + '</span></div></div><div class="band"></div>' + kpis + '<div class="grid2"><div>' + top + '</div><div>' + table + tags + '</div></div>' + notes +
      '<p class="muted" style="margin:14px 0 0;font-size:11px">Reach and engagement come from the platforms (Analytics); posts out come from the Content Studio. Link clicks count the hub.welfareavenue.com/l short links. Change against the month before where both have numbers.</p></div>';
  }
  function reportSummary() {
    var m = repMonth(), st = monthStats(m), cl = reportClicks(m);
    var by = PORDER.filter(function (k) { return st.per[k].posts; }).map(function (k) { return PLX[k][0] + ' ' + st.per[k].posts; }).join(', ');
    return 'Content, ' + monthName(m) + ': ' + st.posts.length + ' posts out' + (by ? ' (' + by + ')' : '') + '; ' + num(st.reach) + ' reach and views; ' + num(st.eng) + ' engagements (' + pct(st.rate) + ' of reach)' + (cl.n != null ? '; ' + num(cl.n) + ' link clicks' : '') + (st.comments ? '; ' + st.answered + ' of ' + st.comments + ' comments answered' : '') + '.' + (st.top[0] ? ' Best post: ' + clip(st.top[0].caption || 'a post', 80) + ' on ' + PLX[st.top[0].platform][0] + ' (' + num(engOf(st.top[0])) + ' engagements).' : '') + (S.keys['note-' + m] ? '\n' + S.keys['note-' + m] : '');
  }
  function printReport() {
    document.body.classList.add('w225print');
    var done = function () { document.body.classList.remove('w225print'); window.removeEventListener('afterprint', done); };
    window.addEventListener('afterprint', done);
    setTimeout(function () { try { window.print(); } catch (e) { done(); } }, 60);
  }

  /* =====================================================================
     wave230 link pages (Steel, 09/10/26): "a linktree section of the studio with the ability to track insights on who
     clicking what link and make it similar to linktree pro but much better". His choices: anonymous insights with no
     cookies, a person named only when they sign up or give; several pages; smart links (schedules, featured, A/B tests,
     fallbacks); sign-up, volunteer and donation blocks; content blocks (Instagram, YouTube, events, impact, English and
     French); a tracked address per source and QR codes; a weekly summary (the linkpage function, Mondays).
     #studio/pages (the pages), #studio/pages/edit/<id>, #studio/pages/insights, #studio/pages/sources, #studio/pages/people.
     Data: link_pages, link_page_sources, link_page_events, wa230_conversions(), short_links (each link button), crm_forms.
     ===================================================================== */
  var LPT = {
    link: ['Link', '\ud83d\udd17', 'A button to any address'],
    form: ['Sign-up form', '\ud83d\udcdd', 'Volunteer, newsletter or any CRM form; sign-ups are credited to the page'],
    donate: ['Donate', '\ud83d\udc9b', 'The donation page; gifts are credited to the page'],
    header: ['Heading', '\ud83d\udd20', 'A title between buttons'],
    text: ['Text', '\u270f\ufe0f', 'A short paragraph'],
    youtube: ['YouTube video', '\u25b6\ufe0f', 'Plays on the page'],
    instagram: ['Instagram posts', '\ud83d\udcf8', 'Our latest posts, as a grid'],
    events: ['Upcoming events', '\ud83d\udcc5', 'From the website\u2019s events'],
    impact: ['Impact numbers', '\ud83d\udcc8', 'Up to four big numbers'],
    socials: ['Social icons', '\ud83d\udd17', 'Our profiles as icons']
  };
  var LPTHEMES = { green: ['#103F39', '#FFFAF2', '#DCA527'], cream: ['#FFFAF2', '#103F39', '#DCA527'], gold: ['#DCA527', '#103F39', '#FFFAF2'], purple: ['#6F64AB', '#FFFAF2', '#DCA527'], night: ['#1F201E', '#103F39', '#DCA527'] };
  var SRCNAME = { ig: 'Instagram', fb: 'Facebook', tt: 'TikTok', li: 'LinkedIn', th: 'Threads', yt: 'YouTube', x: 'X', snap: 'Snapchat', website: 'welfareavenue.com', search: 'Search', email: 'Email', web: 'Other sites', direct: 'Direct or typed' };
  var LPTPL = {
    blank: [],
    event: [{ type: 'header', label: 'The event', label_fr: 'L\u2019\u00e9v\u00e9nement' }, { type: 'link', label: 'Get your ticket', label_fr: 'R\u00e9server ma place', icon: '\ud83c\udf9f\ufe0f', featured: true, url: 'https://welfareavenue.com/' }, { type: 'form', form: 'volunteer', form_fr: 'benevole', label: 'Volunteer at the event', label_fr: '\u00catre b\u00e9n\u00e9vole \u00e0 l\u2019\u00e9v\u00e9nement', icon: '\ud83d\ude4c' }, { type: 'donate', label: 'Can\u2019t come? Give instead', label_fr: 'Vous ne pouvez pas venir? Donnez', icon: '\ud83d\udc9b' }, { type: 'instagram', count: 6 }, { type: 'socials' }],
    campaign: [{ type: 'impact', label: 'What your gift does', label_fr: 'Ce que votre don permet', stats: [{ n: '1,000+', label: 'meals a month', label_fr: 'repas par mois' }, { n: '2', label: 'cities', label_fr: 'villes' }] }, { type: 'donate', label: 'Give now', label_fr: 'Donner maintenant', icon: '\ud83d\udc9b', featured: true }, { type: 'form', form: 'newsletter', label: 'Follow the campaign', label_fr: 'Suivre la campagne', icon: '\ud83d\udc8c' }, { type: 'socials' }],
    city: [{ type: 'form', form: 'volunteer', form_fr: 'benevole', label: 'Volunteer in the city', label_fr: 'Faire du b\u00e9n\u00e9volat', icon: '\ud83d\ude4c', featured: true }, { type: 'events', count: 3 }, { type: 'instagram', count: 6 }, { type: 'socials' }]
  };
  S.lp = { loaded: 0, loading: null, pages: [], sources: [], ev: [], conv: [], forms: [], days: 30, page: 'all', edit: null, open: {}, err: null, busy: {}, prevLang: 'en', prevB: false };

  async function lpLoad(force) {
    var L = S.lp; if (L.loading) return L.loading;
    if (!force && L.loaded && Date.now() - L.loaded < 45000) return;
    L.loading = (async function () {
      try {
        var since = new Date(Date.now() - 92 * 86400000).toISOString();
        var rs = await Promise.all([
          q(db.from('link_pages').select('*').order('id')),
          q(db.from('link_page_sources').select('*').order('id')),
          q(db.from('link_page_events').select('id, page_id, at, kind, block_id, variant, src, src_detail, visitor, repeat_visit, lang, device, os, browser, country, region, city').gte('at', since).eq('is_test', false).order('at', { ascending: false }).limit(40000)),
          q(db.rpc('wa230_conversions', { p_days: 92 })),
          q(db.from('crm_forms').select('slug, title, kind, lang, status').eq('status', 'published').order('title'))
        ]);
        if (rs[0].error) throw rs[0].error;
        L.pages = rs[0].data || []; L.sources = rs[1].data || []; L.ev = rs[2].data || []; L.conv = rs[3].data || []; L.forms = rs[4].data || [];
        L.err = null; L.loaded = Date.now();
      } catch (e) { L.err = e.message || String(e); }
      L.loading = null;
    })();
    return L.loading;
  }
  function lpUrl(p, src) { return HUB + '/links' + (p && p.slug !== 'main' ? '/' + p.slug : '') + (src ? '?s=' + encodeURIComponent(src) : ''); }
  function lpPage(id) { return S.lp.pages.filter(function (p) { return String(p.id) === String(id); })[0] || null; }
  function lpEv(pageId, days) { var since = Date.now() - (days || S.lp.days) * 86400000; return S.lp.ev.filter(function (e) { return (pageId === 'all' || String(e.page_id) === String(pageId)) && new Date(e.at).getTime() >= since; }); }
  function lpConv(pageId, days) { var since = Date.now() - (days || S.lp.days) * 86400000; return S.lp.conv.filter(function (c) { return (pageId === 'all' || String(c.page_id) === String(pageId)) && new Date(c.at).getTime() >= since; }); }
  function uniq(list, key) { var m = {}; list.forEach(function (x) { if (x[key]) m[x[key]] = 1; }); return Object.keys(m).length; }
  function lpStats(ev, conv) {
    var views = ev.filter(function (e) { return e.kind === 'view'; }), clicks = ev.filter(function (e) { return e.kind === 'click'; });
    var vis = uniq(views, 'visitor'), rep = {}; views.forEach(function (e) { if (e.repeat_visit && e.visitor) rep[e.visitor] = 1; });
    var signups = (conv || []).filter(function (c) { return c.kind === 'form'; }).length, gifts = (conv || []).filter(function (c) { return c.kind === 'donation'; }).length;
    return { views: views.length, visitors: vis, repeat: Object.keys(rep).length, clicks: clicks.length, clickers: uniq(clicks, 'visitor'), ctr: views.length ? clicks.length / views.length : NaN, signups: signups, gifts: gifts, gave: (conv || []).filter(function (c) { return c.kind === 'donation' && c.completed; }).length };
  }
  function srcName(code) { var s = S.lp.sources.filter(function (x) { return x.code === code; })[0]; return s ? s.label : (SRCNAME[code] || code || 'Direct'); }
  function blockName(pageId, bid) {
    if (!bid) return 'the page';
    var base = String(bid).replace(/-(\d+|[a-z]+)$/, function (m) { return /^-(\d+)$/.test(m) || /^-(instagram|facebook|tiktok|linkedin|youtube|threads|x)$/.test(m) ? '' : m; });
    var p = lpPage(pageId), b = p && (p.blocks || []).filter(function (x) { return x.id === bid || x.id === base; })[0];
    if (!b) return bid;
    var lab = b.label || (LPT[b.type] ? LPT[b.type][0] : b.type);
    if (b.id !== bid) { var tail = String(bid).slice(b.id.length + 1); lab += /^\d+$/.test(tail) ? ' \u00b7 post ' + tail : ' \u00b7 ' + tail; }
    return lab;
  }
  function countBy(list, fnk) { var m = {}; list.forEach(function (x) { var k = fnk(x); if (k == null || k === '') return; m[k] = (m[k] || 0) + 1; }); return Object.keys(m).map(function (k) { return [k, m[k]]; }).sort(function (a, b) { return b[1] - a[1]; }); }
  function bar(v, max, color) { return '<span class="w230bar"><i style="width:' + (max ? Math.max(2, Math.round(v / max * 100)) : 0) + '%;' + (color ? 'background:' + color : '') + '"></i></span>'; }

  /* ---------- the section's tabs ---------- */
  function lpTabs(cur) {
    return '<div class="row" style="margin:0 0 12px"><span class="seg">' + [['', 'Pages'], ['insights', 'Insights'], ['sources', 'Sources and QR codes'], ['people', 'People']].map(function (t) { return '<a data-w225go="#studio/pages' + (t[0] ? '/' + t[0] : '') + '" class="' + (cur === t[0] ? 'on' : '') + '">' + E(t[1]) + '</a>'; }).join('') + '</span><span class="sp"></span>' +
      (cur === 'insights' || cur === 'people' || cur === 'sources' ? '<select data-w230pg aria-label="Page"><option value="all">Every page</option>' + S.lp.pages.filter(function (p) { return p.status !== 'archived'; }).map(function (p) { return '<option value="' + p.id + '"' + (String(S.lp.page) === String(p.id) ? ' selected' : '') + '>' + E(p.title + (p.slug === 'main' ? ' (bio)' : ' \u00b7 /' + p.slug)) + '</option>'; }).join('') + '</select>' +
        '<span class="seg">' + [7, 30, 90].map(function (d) { return '<a data-w230days="' + d + '" class="' + (S.lp.days === d ? 'on' : '') + '">' + d + ' days</a>'; }).join('') + '</span>' : '') + '</div>';
  }
  function pagesHtml() {
    var L = S.lp;
    if (!L.loaded) { lpLoad().then(paint); return '<div class="card"><div class="empty">Loading the link pages\u2026</div></div>'; }
    if (L.err && !L.pages.length) return '<div class="card"><div class="empty">Could not load the link pages: ' + E(L.err) + '</div></div>';
    if (S.sub === 'edit') return lpEditorHtml();
    if (S.sub === 'insights') return lpTabs('insights') + lpInsightsHtml();
    if (S.sub === 'sources') return lpTabs('sources') + lpSourcesHtml();
    if (S.sub === 'people') return lpTabs('people') + lpPeopleHtml();
    return lpTabs('') + lpListHtml();
  }

  /* ---------- the pages ---------- */
  function lpListHtml() {
    var L = S.lp, mk = S.mk;
    var cards = L.pages.filter(function (p) { return p.status !== 'archived' || L.showArchived; }).map(function (p) {
      var ev = lpEv(p.id, 30), st = lpStats(ev, lpConv(p.id, 30)), views = ev.filter(function (e) { return e.kind === 'view'; });
      var th = (p.theme && LPTHEMES[p.theme.preset]) || LPTHEMES.green;
      return '<div class="card w230pc"><div class="row" style="align-items:flex-start;gap:12px"><div class="w230sw" style="background:' + E((p.theme && p.theme.bg) || th[0]) + '"><i style="background:' + E((p.theme && p.theme.btn) || th[1]) + '"></i><i style="background:' + E((p.theme && p.theme.accent) || th[2]) + '"></i><i style="background:' + E((p.theme && p.theme.btn) || th[1]) + '"></i></div>' +
        '<div style="flex:1;min-width:0"><b style="font-size:16px">' + E(p.title) + '</b> <span class="pill ' + (p.status === 'live' ? 'ok' : p.status === 'archived' ? '' : 'warn') + '">' + E(p.status === 'live' ? 'Live' : p.status === 'archived' ? 'Archived' : 'Draft') + '</span>' + (p.slug === 'main' ? ' <span class="pill appr">Link in bio</span>' : '') +
        '<div style="font-size:12.5px;margin-top:3px"><a href="' + E(lpUrl(p)) + '" target="_blank" rel="noopener" style="color:' + ROSE + ';font-weight:700">' + E(lpUrl(p).replace(/^https:\/\//, '')) + '</a> <a data-w230copy="' + E(lpUrl(p)) + '" title="Copy" style="cursor:pointer">' + I('copy') + '</a></div>' +
        '<div class="w230mini"><span><b>' + num(st.views) + '</b> views</span><span><b>' + num(st.visitors) + '</b> people</span><span><b>' + num(st.clicks) + '</b> clicks</span><span><b>' + pct(st.ctr) + '</b> click rate</span><span><b>' + (st.signups + st.gifts) + '</b> sign-ups and gifts</span></div>' +
        '<div style="max-width:320px;margin-top:6px">' + sparkHtml(views, 30) + '</div></div></div>' +
        '<div class="row" style="margin-top:10px;gap:6px">' + (mk ? '<a class="btn225 sm pri" data-w225go="#studio/pages/edit/' + p.id + '">' + I('star') + ' Edit</a>' : '') + '<a class="btn225 sm" data-w230ins="' + p.id + '">' + I('bolt') + ' Insights</a><a class="btn225 sm" data-w230src="' + p.id + '">Sources and QR</a><a class="btn225 sm" href="' + E(lpUrl(p)) + '" target="_blank" rel="noopener">' + I('ext') + ' Open</a>' +
        (mk && p.slug !== 'main' ? '<span class="sp"></span><a class="btn225 sm" data-w230arch="' + p.id + '">' + (p.status === 'archived' ? 'Bring back' : 'Archive') + '</a>' : '') + '</div></div>';
    }).join('');
    var add = mk ? '<div class="card"><h3>' + I('plus') + ' New page <small>a campaign, an event, a city team</small></h3><div class="row" style="gap:8px"><input type="text" id="w230nt" placeholder="Name, e.g. Rally Paper 2026" style="flex:1;min-width:180px" maxlength="60"><span class="muted">hub.welfareavenue.com/links/</span><input type="text" id="w230ns" placeholder="rally" style="width:140px" maxlength="40">' +
      '<select id="w230ntpl"><option value="blank">Start empty</option><option value="event">Event</option><option value="campaign">Fundraising campaign</option><option value="city">City team</option></select><a class="btn225 sm pri" data-w230new="1">' + I('plus') + ' Make it</a></div><p class="muted" style="margin:8px 0 0">Every page has its own address, QR codes and insights. It starts as a draft: publish it from the editor.</p></div>' : '';
    var arch = L.pages.some(function (p) { return p.status === 'archived'; }) ? '<p class="muted"><a data-w230sharch="1" style="cursor:pointer">' + (L.showArchived ? 'Hide' : 'Show') + ' the archived pages</a></p>' : '';
    return '<div class="w230cards">' + cards + '</div>' + arch + add;
  }
  async function lpCreate() {
    var t = (document.getElementById('w230nt') || {}).value || '', sl = (document.getElementById('w230ns') || {}).value || '', tpl = (document.getElementById('w230ntpl') || {}).value || 'blank';
    t = t.trim(); sl = slug(sl || t).slice(0, 40);
    if (!t) { toastS('Give the page a name'); return; }
    if (!/^[a-z0-9][a-z0-9-]{0,39}$/.test(sl) || sl === 'main') { toastS('The address takes lowercase letters, numbers and dashes'); return; }
    if (S.lp.pages.some(function (p) { return p.slug === sl; })) { toastS('That address is taken'); return; }
    var blocks = JSON.parse(JSON.stringify(LPTPL[tpl] || [])).map(function (b) { b.id = 'b' + randCode(5); b.on = true; return b; });
    var main = lpPage((S.lp.pages.filter(function (p) { return p.slug === 'main'; })[0] || {}).id);
    try {
      var r = await db.from('link_pages').insert({ slug: sl, title: t, bio: '', theme: (main && main.theme) || { preset: 'green' }, socials: (main && main.socials) || {}, blocks: blocks, settings: { lang: 'auto', fallback_url: 'https://welfareavenue.com/' }, status: 'draft', created_by: myName() || myEmail(), updated_by: myName() || myEmail() }).select('*').maybeSingle();
      if (r.error) throw r.error;
      var row = r.data && r.data.id ? r.data : null;
      if (!row) { await lpLoad(true); row = S.lp.pages.filter(function (p) { return p.slug === sl; })[0] || null; } else S.lp.pages.push(row);
      if (row) go('#studio/pages/edit/' + row.id); else { toastS('Made: refresh to open it'); paint(); }
    } catch (x) { toastS('Could not make the page: ' + (x.message || x)); }
  }

  /* ---------- the editor ---------- */
  function lpDraft() {
    var L = S.lp, id = S.sub2;
    if (!L.edit || String(L.edit.id) !== String(id)) {
      var p = lpPage(id); if (!p) return null;
      L.edit = JSON.parse(JSON.stringify(p)); L.edit.dirty = false; L.edit.theme = L.edit.theme || { preset: 'green' }; L.edit.settings = L.edit.settings || {}; L.edit.socials = L.edit.socials || {}; L.edit.blocks = Array.isArray(L.edit.blocks) ? L.edit.blocks : [];
      L.open = {};
    }
    return L.edit;
  }
  function lpResolved(d, fr, showB) {
    /* what the public page would draw from this draft (switched-off and scheduled blocks are shown faded with a tag) */
    var now = Date.now();
    return d.blocks.map(function (b) {
      var pick = function (o, k) { return (fr && o[k + '_fr']) || o[k] || ''; };
      var label = pick(b, 'label'), sub = pick(b, 'sub');
      if (b.ab && b.ab.on && (showB || b.ab.winner === 'b') && b.ab.winner !== 'a') { label = pick(b.ab, 'label') || label; sub = pick(b.ab, 'sub') || sub; }
      var off = b.on === false ? 'Off' : b.start_at && new Date(b.start_at).getTime() > now ? 'From ' + niceDate(dayOf(b.start_at), { month: 'short', day: 'numeric' }) : b.end_at && new Date(b.end_at).getTime() <= now ? 'Ended' : '';
      var o = { id: b.id, type: b.type, label: label, sub: sub, icon: b.icon || '', featured: !!b.featured, thumb: b.thumb || '', _off: off, code: b.code || '', text: pick(b, 'text'), video: lpYt(b.video || ''), count: b.count, stats: (b.stats || []).map(function (s) { return { n: s.n, label: (fr && s.label_fr) || s.label }; }) };
      if (b.type === 'link' && !b.code) o.url = b.url || '';
      return o;
    });
  }
  function lpYt(v) { v = String(v || '').trim(); var m = /(?:youtu\.be\/|v=|shorts\/|embed\/)([A-Za-z0-9_-]{6,20})/.exec(v); return m ? m[1] : (/^[A-Za-z0-9_-]{6,20}$/.test(v) ? v : ''); }
  var lpPrevT = null;
  function lpPreview() {
    clearTimeout(lpPrevT);
    lpPrevT = setTimeout(function () {
      var d = S.lp.edit, f = document.getElementById('w230prev'); if (!d || !f || !f.contentWindow) return;
      var fr = S.lp.prevLang === 'fr';
      try { f.contentWindow.postMessage({ type: 'wa230-preview', lang: fr ? 'fr' : 'en', page: { title: (fr && d.title_fr) || d.title, bio: (fr && d.bio_fr) || d.bio || '', avatar: d.avatar_url || '', theme: d.theme, socials: d.socials, lang_toggle: false }, blocks: lpResolved(d, fr, S.lp.prevB) }, location.origin); } catch (e) { /* fine */ }
    }, 120);
  }
  window.addEventListener('message', function (e) { if (e.origin === location.origin && e.data && e.data.type === 'wa230-ready') lpPreview(); });
  function fld(i, k, label, val, opts) {
    opts = opts || {};
    var a = 'data-w230b="' + i + '|' + k + '"';
    if (opts.area) return '<label class="w230f' + (opts.wide ? ' wide' : '') + '"><span>' + E(label) + '</span><textarea ' + a + ' rows="' + (opts.rows || 2) + '" maxlength="' + (opts.max || 600) + '">' + E(val || '') + '</textarea></label>';
    return '<label class="w230f' + (opts.wide ? ' wide' : '') + '"><span>' + E(label) + '</span><input type="' + (opts.type || 'text') + '" ' + a + ' value="' + E(val || '') + '" placeholder="' + E(opts.ph || '') + '" maxlength="' + (opts.max || 300) + '"></label>';
  }
  function chk(i, k, label, on) { return '<label class="w230c"><input type="checkbox" data-w230bc="' + i + '|' + k + '"' + (on ? ' checked' : '') + '> ' + E(label) + '</label>'; }
  function dtl(iso) { if (!iso) return ''; var d = new Date(iso); return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) + 'T' + pad(d.getHours()) + ':' + pad(d.getMinutes()); }
  function abResult(pageId, b) {
    var ev = lpEv(pageId, 90), out = { a: { v: 0, c: 0 }, b: { v: 0, c: 0 } };
    ev.forEach(function (e) {
      if (e.kind === 'view' && e.variant) { try { var m = JSON.parse(e.variant); if (m[b.id] && out[m[b.id]]) out[m[b.id]].v++; } catch (x) { /* fine */ } }
      if (e.kind === 'click' && e.block_id === b.id && e.variant && out[e.variant]) out[e.variant].c++;
    });
    var ra = out.a.v ? out.a.c / out.a.v : 0, rb = out.b.v ? out.b.c / out.b.v : 0, conf = null;
    if (out.a.v >= 20 && out.b.v >= 20) {
      var p = (out.a.c + out.b.c) / (out.a.v + out.b.v), se = Math.sqrt(p * (1 - p) * (1 / out.a.v + 1 / out.b.v));
      if (se > 0) { var z = Math.abs(ra - rb) / se; conf = 1 - Math.exp(-0.717 * z - 0.416 * z * z); }
    }
    return { a: out.a, b: out.b, ra: ra, rb: rb, conf: conf, lead: rb > ra ? 'b' : ra > rb ? 'a' : null };
  }
  function lpBlockHtml(d, b, i) {
    var t = LPT[b.type] || [b.type, '\u2022', ''], open = !!S.lp.open[b.id], n = d.blocks.length;
    var badges = (b.on === false ? '<span class="pill">Off</span>' : '') + (b.featured ? '<span class="pill appr">Featured</span>' : '') + (b.start_at || b.end_at ? '<span class="pill warn">Scheduled</span>' : '') + (b.ab && b.ab.on ? '<span class="pill ok">A/B' + (b.ab.winner ? ': ' + b.ab.winner.toUpperCase() + ' won' : '') + '</span>' : '');
    var cl = lpEv(d.id, 30).filter(function (e) { return e.kind === 'click' && (e.block_id === b.id || String(e.block_id || '').indexOf(b.id + '-') === 0); }).length;
    var head = '<div class="w230bh" data-w230open="' + E(b.id) + '"><span class="w230ic">' + E(b.icon || t[1]) + '</span><div style="flex:1;min-width:0"><b>' + E(b.label || b.text || t[0]) + '</b><small>' + E(t[0]) + (cl ? ' \u00b7 ' + cl + ' clicks in 30 days' : '') + '</small></div>' + badges +
      '<a class="btn225 sm" data-w230mv="up|' + i + '" title="Up"' + (i ? '' : ' disabled') + '>' + I('up') + '</a><a class="btn225 sm" data-w230mv="down|' + i + '" title="Down"' + (i < n - 1 ? '' : ' disabled') + '>' + I('down') + '</a></div>';
    if (!open) return '<div class="w230blk">' + head + '</div>';
    var f = '';
    var labels = fld(i, 'label', 'Text', b.label) + fld(i, 'label_fr', 'Text in French', b.label_fr, { ph: 'Optional' });
    if (b.type === 'link' || b.type === 'form' || b.type === 'donate') {
      f += labels + fld(i, 'sub', 'Small line under it', b.sub, { ph: 'Optional' }) + fld(i, 'sub_fr', 'Small line in French', b.sub_fr, { ph: 'Optional' }) + fld(i, 'icon', 'Emoji', b.icon, { max: 4, ph: '\ud83d\ude4c' }) + fld(i, 'thumb', 'Picture (address)', b.thumb, { ph: 'https://\u2026 (optional)' });
      if (b.type === 'link') f += fld(i, 'url', 'Goes to', b.url, { type: 'url', wide: true, ph: 'https://' }) + fld(i, 'fallback', 'When it is switched off, go to', b.fallback, { type: 'url', wide: true, ph: 'Optional: else the page\u2019s fallback' });
      if (b.type === 'form') f += '<label class="w230f"><span>Form</span><select data-w230b="' + i + '|form">' + S.lp.forms.map(function (x) { return '<option value="' + E(x.slug) + '"' + (x.slug === b.form ? ' selected' : '') + '>' + E(x.title) + '</option>'; }).join('') + '</select></label><label class="w230f"><span>French form</span><select data-w230b="' + i + '|form_fr"><option value="">The same form</option>' + S.lp.forms.map(function (x) { return '<option value="' + E(x.slug) + '"' + (x.slug === b.form_fr ? ' selected' : '') + '>' + E(x.title) + '</option>'; }).join('') + '</select></label>';
      if (b.type === 'donate') f += fld(i, 'campaign', 'Campaign (optional)', b.campaign, { max: 40 });
      f += '<div class="w230row wide">' + chk(i, 'featured', 'Featured (gold, gently pulsing)', b.featured) + '</div>';
      f += '<label class="w230f"><span>Show from</span><input type="datetime-local" data-w230b="' + i + '|start_at" value="' + E(dtl(b.start_at)) + '"></label><label class="w230f"><span>Until</span><input type="datetime-local" data-w230b="' + i + '|end_at" value="' + E(dtl(b.end_at)) + '"></label>';
      var ab = b.ab || {};
      f += '<div class="w230ab wide"><label class="w230c"><input type="checkbox" data-w230ab="' + i + '|on"' + (ab.on ? ' checked' : '') + '> A/B test: show half the visitors another text</label>' +
        (ab.on ? '<div class="w230grid">' + '<label class="w230f"><span>Text B</span><input type="text" data-w230ab="' + i + '|label" value="' + E(ab.label || '') + '"></label><label class="w230f"><span>Text B in French</span><input type="text" data-w230ab="' + i + '|label_fr" value="' + E(ab.label_fr || '') + '"></label></div>' + lpAbHtml(d, b, i) : '') + '</div>';
    } else if (b.type === 'header') f += labels;
    else if (b.type === 'text') f += fld(i, 'text', 'Text', b.text, { area: true, wide: true, rows: 3 }) + fld(i, 'text_fr', 'Text in French', b.text_fr, { area: true, wide: true, rows: 3 });
    else if (b.type === 'youtube') f += fld(i, 'video', 'YouTube address', b.video, { wide: true, ph: 'https://youtu.be/\u2026' }) + labels;
    else if (b.type === 'instagram' || b.type === 'events') f += labels + fld(i, 'count', 'How many', b.count || (b.type === 'events' ? 3 : 6), { type: 'number', max: 2 });
    else if (b.type === 'impact') {
      f += labels;
      var st = (b.stats || []).concat([{}, {}, {}, {}]).slice(0, 4);
      f += '<div class="wide w230grid4">' + st.map(function (s, k) { return '<label class="w230f"><span>Number ' + (k + 1) + '</span><input type="text" data-w230st="' + i + '|' + k + '|n" value="' + E(s.n || '') + '" placeholder="1,000+" maxlength="20"></label><label class="w230f"><span>says</span><input type="text" data-w230st="' + i + '|' + k + '|label" value="' + E(s.label || '') + '" placeholder="meals a month"></label><label class="w230f"><span>in French</span><input type="text" data-w230st="' + i + '|' + k + '|label_fr" value="' + E(s.label_fr || '') + '"></label>'; }).join('') + '</div>';
    } else if (b.type === 'socials') f += '<p class="muted wide" style="margin:0">The icons come from the page\u2019s social profiles (Look and settings).</p>';
    return '<div class="w230blk open">' + head + '<div class="w230bb">' + f + '<div class="row wide" style="margin-top:6px">' + chk(i, 'on', 'Shown on the page', b.on !== false) + '<span class="sp"></span><a class="btn225 sm" data-w230dup="' + i + '">Duplicate</a><a class="btn225 sm bad" data-w230rm="' + i + '">' + I('trash') + ' Remove</a></div></div></div>';
  }
  function lpAbHtml(d, b, i) {
    var r = abResult(d.id, b), cf = r.conf;
    var row = function (k, lab) { var x = r[k]; return '<tr' + (b.ab.winner === k ? ' style="font-weight:700"' : '') + '><td>' + k.toUpperCase() + '</td><td>' + E(clip(lab || '', 40)) + '</td><td>' + x.v + '</td><td>' + x.c + '</td><td>' + (x.v ? pct(x.c / x.v) : '\u2013') + '</td></tr>'; };
    return '<table class="w230t" style="margin-top:6px"><thead><tr><th></th><th>Text</th><th>Views</th><th>Clicks</th><th>Rate</th></tr></thead><tbody>' + row('a', b.label) + row('b', b.ab.label) + '</tbody></table>' +
      '<p class="muted" style="margin:6px 0">' + (b.ab.winner ? 'Everyone now sees ' + b.ab.winner.toUpperCase() + '.' : r.a.v + r.b.v < 40 ? 'Too early to tell: about 20 views each is the least.' : cf != null && cf >= 0.95 && r.lead ? r.lead.toUpperCase() + ' is ahead and we are ' + Math.round(cf * 100) + '% sure: pick it.' : r.lead ? r.lead.toUpperCase() + ' leads, but not clearly yet (' + Math.round((cf || 0) * 100) + '% sure).' : 'No difference yet.') + '</p>' +
      '<div class="row" style="gap:6px"><a class="btn225 sm" data-w230win="' + i + '|a">Keep A</a><a class="btn225 sm" data-w230win="' + i + '|b">Keep B</a>' + (b.ab.winner ? '<a class="btn225 sm" data-w230win="' + i + '|">Test again</a>' : '') + '</div>';
  }
  function lpEditorHtml() {
    var d = lpDraft(); if (!d) return '<div class="card"><div class="empty">That page is not here. <a data-w225go="#studio/pages" style="cursor:pointer">Back to the pages</a></div></div>';
    if (!S.mk) return '<div class="card"><div class="empty">The marketing team and admins change the link pages.</div></div>';
    var th = d.theme || {}, st = d.settings || {};
    var top = '<div class="row w230bar0"><a class="btn225 sm" data-w225go="#studio/pages">\u2039 Pages</a><b style="font-size:16px">' + E(d.title) + '</b><span class="pill ' + (d.status === 'live' ? 'ok' : 'warn') + '">' + (d.status === 'live' ? 'Live' : 'Draft') + '</span><span class="sp"></span><span class="muted">' + (d.dirty ? 'Changes not saved' : 'Saved') + '</span>' +
      (d.dirty ? '<a class="btn225 sm" data-w230discard="1">Discard</a>' : '') + '<a class="btn225 sm' + (d.dirty ? ' pri' : '') + '" data-w230save="1"' + (S.lp.busy.save ? ' disabled' : '') + '>' + I('check') + ' Save</a>' +
      (d.slug !== 'main' ? '<a class="btn225 sm' + (d.status === 'live' ? '' : ' pri') + '" data-w230pub="' + (d.status === 'live' ? 'draft' : 'live') + '">' + (d.status === 'live' ? 'Unpublish' : 'Save and publish') + '</a>' : '') + '<a class="btn225 sm" href="' + E(lpUrl(d)) + '" target="_blank" rel="noopener">' + I('ext') + '</a></div>';
    var page = '<div class="card"><h3>' + I('star') + ' The page</h3><div class="w230grid">' +
      '<label class="w230f"><span>Name at the top</span><input type="text" data-w230p="title" value="' + E(d.title) + '" maxlength="60"></label><label class="w230f"><span>In French</span><input type="text" data-w230p="title_fr" value="' + E(d.title_fr || '') + '" maxlength="60" placeholder="Optional"></label>' +
      '<label class="w230f wide"><span>A line under it</span><textarea data-w230p="bio" rows="2" maxlength="220">' + E(d.bio || '') + '</textarea></label><label class="w230f wide"><span>In French</span><textarea data-w230p="bio_fr" rows="2" maxlength="220" placeholder="Optional">' + E(d.bio_fr || '') + '</textarea></label>' +
      '<label class="w230f wide"><span>Picture at the top (address; empty shows our logo)</span><input type="url" data-w230p="avatar_url" value="' + E(d.avatar_url || '') + '" placeholder="https://\u2026"></label>' +
      (d.slug !== 'main' ? '<label class="w230f"><span>Address</span><input type="text" data-w230p="slug" value="' + E(d.slug) + '" maxlength="40"></label>' : '') + '</div></div>';
    var adds = Object.keys(LPT).map(function (k) { return '<a class="w230add" data-w230addb="' + k + '" title="' + E(LPT[k][2]) + '"><span>' + LPT[k][1] + '</span>' + E(LPT[k][0]) + '</a>'; }).join('');
    var blocks = '<div class="card"><h3>' + I('link') + ' What is on it <small>top to bottom; open one to change it</small></h3>' + (d.blocks.length ? d.blocks.map(function (b, i) { return lpBlockHtml(d, b, i); }).join('') : '<div class="empty">Nothing yet: add a block below.</div>') +
      '<h4>Add</h4><div class="w230adds">' + adds + '</div></div>';
    var look = '<div class="card"><h3>' + I('eye') + ' Look and settings</h3><div class="row" style="gap:6px;flex-wrap:wrap">' + Object.keys(LPTHEMES).map(function (k) { var c = LPTHEMES[k]; return '<a class="w230th' + ((th.preset || 'green') === k ? ' on' : '') + '" data-w230t="preset|' + k + '" title="' + k + '" style="background:' + c[0] + '"><i style="background:' + c[1] + '"></i><i style="background:' + c[2] + '"></i></a>'; }).join('') + '</div>' +
      '<div class="w230grid" style="margin-top:10px"><label class="w230f"><span>Background</span><input type="color" data-w230tc="bg" value="' + E(th.bg || LPTHEMES[th.preset || 'green'][0]) + '"></label><label class="w230f"><span>Buttons</span><input type="color" data-w230tc="btn" value="' + E(th.btn || LPTHEMES[th.preset || 'green'][1]) + '"></label><label class="w230f"><span>Highlight</span><input type="color" data-w230tc="accent" value="' + E(th.accent || LPTHEMES[th.preset || 'green'][2]) + '"></label>' +
      '<label class="w230f"><span>Button shape</span><select data-w230t2="shape">' + [['pill', 'Pill'], ['rounded', 'Rounded'], ['square', 'Square']].map(function (x) { return '<option value="' + x[0] + '"' + ((th.shape || 'pill') === x[0] ? ' selected' : '') + '>' + x[1] + '</option>'; }).join('') + '</select></label>' +
      '<label class="w230f"><span>Language</span><select data-w230s="lang">' + [['auto', 'English or French, from the phone\u2019s language'], ['en', 'English only'], ['fr-only', 'French only']].map(function (x) { return '<option value="' + x[0] + '"' + ((st.lang || 'auto') === x[0] ? ' selected' : '') + '>' + x[1] + '</option>'; }).join('') + '</select></label>' +
      '<label class="w230f"><span>Switched-off links go to</span><input type="url" data-w230s="fallback_url" value="' + E(st.fallback_url || 'https://welfareavenue.com/') + '"></label></div>' +
      '<h4>Social profiles</h4><div class="w230grid">' + ['instagram', 'facebook', 'tiktok', 'linkedin', 'threads', 'youtube'].map(function (k) { return '<label class="w230f"><span>' + E(PLX[k] ? PLX[k][0] : k) + '</span><input type="url" data-w230so="' + k + '" value="' + E(d.socials[k] || '') + '" placeholder="https://"></label>'; }).join('') + '</div></div>';
    var prev = '<div class="card w230prevcard"><h3>' + I('eye') + ' How it looks <span class="sp"></span><span class="seg"><a data-w230pl="en" class="' + (S.lp.prevLang === 'en' ? 'on' : '') + '">EN</a><a data-w230pl="fr" class="' + (S.lp.prevLang === 'fr' ? 'on' : '') + '">FR</a></span>' + (d.blocks.some(function (b) { return b.ab && b.ab.on && !b.ab.winner; }) ? '<span class="seg"><a data-w230pb="0" class="' + (!S.lp.prevB ? 'on' : '') + '">A</a><a data-w230pb="1" class="' + (S.lp.prevB ? 'on' : '') + '">B</a></span>' : '') + '</h3>' +
      '<div class="w230phone"><iframe id="w230prev" title="Preview" src="/links/' + E(d.slug) + '?preview=1&from=' + E(lpPage(d.id) ? lpPage(d.id).slug : 'main') + '"></iframe></div><p class="muted" style="text-align:center;margin:8px 0 0">Faded buttons are off or scheduled; the live page leaves them out.</p></div>';
    return top + '<div class="grid2 w230ed"><div>' + page + blocks + look + '</div><div>' + prev + '</div></div>';
  }
  function lpSet(path, val) {
    var d = S.lp.edit; if (!d) return;
    var p = path.split('|'), i = Number(p[0]), k = p[1], b = d.blocks[i]; if (!b) return;
    if (k === 'start_at' || k === 'end_at') val = val ? new Date(val).toISOString() : null;
    if (k === 'count') val = Math.max(1, Math.min(9, Number(val) || 1));
    if (k === 'icon') val = String(val || '').trim().slice(0, 4);
    b[k] = val; d.dirty = true;
  }
  async function lpSave(status) {
    var d = S.lp.edit; if (!d || S.lp.busy.save) return;
    var orig = lpPage(d.id) || {};
    if (!String(d.title || '').trim()) { toastS('The page needs a name'); return; }
    if (d.slug !== 'main' && (!/^[a-z0-9][a-z0-9-]{0,39}$/.test(d.slug) || d.slug === 'main' || S.lp.pages.some(function (p) { return p.slug === d.slug && String(p.id) !== String(d.id); }))) { toastS('Check the address: lowercase letters, numbers and dashes, not taken'); return; }
    for (var i = 0; i < d.blocks.length; i++) { var b0 = d.blocks[i]; if (b0.type === 'link' && b0.url && !/^https?:\/\/\S+\.\S+/.test(b0.url)) { toastS('\u201c' + (b0.label || 'A link') + '\u201d needs a full address starting with https://'); S.lp.open[b0.id] = true; paint(); return; } }
    S.lp.busy.save = true; paint();
    try {
      /* each link button is a short link, so the go function redirects and counts it */
      for (var j = 0; j < d.blocks.length; j++) {
        var b = d.blocks[j]; if (b.type !== 'link' || !b.url) continue;
        var row = b.code ? S.links.filter(function (l) { return l.code === b.code; })[0] : null;
        if (b.code && !row) { var rr = await q(db.from('short_links').select('*').eq('code', b.code).maybeSingle()); row = rr.data || null; }
        if (row) {
          if (row.url !== b.url || (row.fallback_url || '') !== (b.fallback || '') || row.active !== (b.on !== false)) {
            var up = await db.from('short_links').update({ url: b.url, fallback_url: b.fallback || null, label: (b.label || 'Link') + ' (link page ' + d.slug + ')', active: b.on !== false }).eq('id', row.id); if (up.error) throw up.error;
            row.url = b.url; row.fallback_url = b.fallback || null; row.active = b.on !== false;
          }
        } else {
          var made = await makeLink(b.url, (b.label || 'Link') + ' (link page ' + d.slug + ')', 'lp-' + d.slug.slice(0, 20) + '-' + randCode(4), 'link page ' + d.slug, { bio: true, row: { fallback_url: b.fallback || null } });
          b.code = made.code;
        }
      }
      var patch = { title: String(d.title).trim(), title_fr: d.title_fr || null, bio: d.bio || null, bio_fr: d.bio_fr || null, avatar_url: d.avatar_url || null, theme: d.theme, socials: d.socials, settings: d.settings, blocks: d.blocks.map(function (b) { var c = Object.assign({}, b); return c; }), updated_by: myName() || myEmail() };
      if (d.slug !== orig.slug) patch.slug = d.slug;
      if (status) patch.status = status;
      var r = await db.from('link_pages').update(patch).eq('id', d.id).select('*').maybeSingle(); if (r.error) throw r.error;
      var saved = Object.assign({}, orig, patch, r.data || {});
      S.lp.pages = S.lp.pages.map(function (p) { return String(p.id) === String(d.id) ? saved : p; });
      S.lp.edit = null; lpDraft();
      toastS(status === 'live' ? 'Saved and live at ' + lpUrl(saved).replace(/^https:\/\//, '') : status === 'draft' ? 'Unpublished: the page shows nothing until you publish it again' : 'Saved' + (saved.status === 'live' ? ': the page is updated' : ''));
    } catch (x) { toastS('Could not save: ' + (x.message || x)); }
    S.lp.busy.save = false; paint();
  }

  /* ---------- insights ---------- */
  function lpDaily(ev, days) {
    var t = today(), rows = [];
    for (var i = days - 1; i >= 0; i--) { var d = addDays(t, -i); rows.push({ d: d, v: 0, c: 0 }); }
    var idx = {}; rows.forEach(function (r, k) { idx[r.d] = k; });
    ev.forEach(function (e) { var k = idx[dayOf(e.at)]; if (k == null) return; if (e.kind === 'view') rows[k].v++; else rows[k].c++; });
    var mx = Math.max.apply(null, rows.map(function (r) { return r.v; }).concat([1])), W = 720, H = 150, bw = W / rows.length;
    var bars = rows.map(function (r, k) { var h = Math.round(r.v / mx * (H - 24)); return '<rect x="' + (k * bw + 1).toFixed(1) + '" y="' + (H - 18 - h) + '" width="' + Math.max(1, bw - 2).toFixed(1) + '" height="' + h + '" rx="2" fill="' + GREEN + '" opacity=".75"><title>' + E(niceDate(r.d)) + ': ' + r.v + ' views, ' + r.c + ' clicks</title></rect>'; }).join('');
    var line = rows.map(function (r, k) { return (k ? 'L' : 'M') + (k * bw + bw / 2).toFixed(1) + ' ' + (H - 18 - Math.round(r.c / mx * (H - 24))); }).join(' ');
    var lab = rows.filter(function (r, k) { return k === 0 || k === rows.length - 1 || k === Math.floor(rows.length / 2); }).map(function (r) { var k = idx[r.d]; return '<text x="' + (k * bw + bw / 2).toFixed(1) + '" y="' + (H - 3) + '" text-anchor="middle" font-size="10" fill="' + MUTED + '">' + E(niceDate(r.d, { month: 'short', day: 'numeric' })) + '</text>'; }).join('');
    return '<svg viewBox="0 0 ' + W + ' ' + H + '" class="w230chart" role="img" aria-label="Views and clicks a day">' + bars + '<path d="' + line + '" fill="none" stroke="' + GOLD + '" stroke-width="2.5" stroke-linejoin="round"/>' + lab + '</svg><div class="w230leg"><span><i style="background:' + GREEN + '"></i>Views</span><span><i style="background:' + GOLD + '"></i>Clicks</span></div>';
  }
  function lpHeat(views) {
    var g = []; for (var d = 0; d < 7; d++) { g.push([]); for (var h = 0; h < 24; h++) g[d].push(0); }
    views.forEach(function (e) { var t = new Date(e.at); g[(t.getDay() + 6) % 7][t.getHours()]++; });
    var mx = 1; g.forEach(function (r) { r.forEach(function (v) { if (v > mx) mx = v; }); });
    var best = null; g.forEach(function (r, d) { r.forEach(function (v, h) { if (!best || v > best.v) best = { d: d, h: h, v: v }; }); });
    return { html: '<div class="w230heat">' + '<span></span>' + [0, 3, 6, 9, 12, 15, 18, 21].map(function (h) { return '<em style="grid-column:span 3">' + h + 'h</em>'; }).join('') + g.map(function (r, d) { return '<b>' + WD[d] + '</b>' + r.map(function (v, h) { return '<i title="' + WDL[d] + ' ' + h + ':00, ' + v + ' views" style="opacity:' + (v ? (0.15 + 0.85 * v / mx).toFixed(2) : 0.05) + '"></i>'; }).join(''); }).join('') + '</div>', best: best && best.v ? best : null };
  }
  function lpTable(rows, heads) { return '<table class="w230t"><thead><tr>' + heads.map(function (h) { return '<th>' + E(h) + '</th>'; }).join('') + '</tr></thead><tbody>' + rows.join('') + '</tbody></table>'; }
  function lpInsightsHtml() {
    var L = S.lp, ev = lpEv(L.page, L.days), conv = lpConv(L.page, L.days), st = lpStats(ev, conv);
    var prevEv = S.lp.ev.filter(function (e) { var a = Date.now() - new Date(e.at).getTime(); return (L.page === 'all' || String(e.page_id) === String(L.page)) && a >= L.days * 86400000 && a < 2 * L.days * 86400000; });
    var pst = lpStats(prevEv, []);
    var dl = function (a, b) { if (!b || L.days > 45) return ''; var x = (a - b) / b; return '<em style="color:' + (x >= 0 ? TEAL : FLAG) + '">' + (x >= 0 ? '\u25b2 ' : '\u25bc ') + Math.abs(Math.round(x * 100)) + '%</em>'; };
    var views = ev.filter(function (e) { return e.kind === 'view'; }), clicks = ev.filter(function (e) { return e.kind === 'click'; });
    if (!ev.length) return '<div class="card"><div class="empty">No visits in this window yet. Put ' + E(lpUrl(L.page === 'all' ? lpPage((L.pages.filter(function (p) { return p.slug === 'main'; })[0] || {}).id) : lpPage(L.page)).replace(/^https:\/\//, '')) + ' in our bios (Sources and QR codes gives each platform its own address), and the numbers start with the first visit.</div></div>';
    var kpis = '<div class="kpis"><div class="kpi"><b>' + num(st.views) + '</b><span>views</span>' + dl(st.views, pst.views) + '</div><div class="kpi"><b>' + num(st.visitors) + '</b><span>people</span><em>' + (st.visitors ? pct(st.repeat / st.visitors) + ' came back' : '') + '</em></div>' +
      '<div class="kpi"><b>' + num(st.clicks) + '</b><span>clicks</span>' + dl(st.clicks, pst.clicks) + '</div><div class="kpi"><b>' + pct(st.ctr) + '</b><span>click rate</span><em>' + (st.visitors ? pct(st.clickers / st.visitors) + ' of people clicked' : '') + '</em></div>' +
      '<div class="kpi" data-w225go="#studio/pages/people"><b class="' + (st.signups ? 'ok' : '') + '">' + st.signups + '</b><span>sign-ups</span><em>' + (st.gifts ? st.gifts + ' gift' + (st.gifts === 1 ? '' : 's') + ' started, ' + st.gave + ' made' : 'from the forms on the page') + '</em></div></div>';
    /* buttons */
    var byBlock = {}; clicks.forEach(function (e) { var k = e.page_id + '|' + e.block_id; (byBlock[k] = byBlock[k] || { p: e.page_id, b: e.block_id, n: 0, who: {} }).n++; if (e.visitor) byBlock[k].who[e.visitor] = 1; });
    var cvBlock = {}; conv.forEach(function (c) { var k = c.page_id + '|' + c.block_id; cvBlock[k] = (cvBlock[k] || 0) + 1; });
    var bl = Object.keys(byBlock).map(function (k) { return byBlock[k]; }).sort(function (a, b) { return b.n - a.n; });
    var mxb = bl.length ? bl[0].n : 1;
    var btnRows = bl.slice(0, 15).map(function (x) { var k = x.p + '|' + x.b; return '<tr><td>' + E(blockName(x.p, x.b)) + (L.page === 'all' ? ' <small class="muted">' + E((lpPage(x.p) || {}).title || '') + '</small>' : '') + '</td><td>' + bar(x.n, mxb) + ' ' + x.n + '</td><td>' + Object.keys(x.who).length + '</td><td>' + (st.views ? pct(x.n / st.views) : '\u2013') + '</td><td>' + (cvBlock[k] || '') + '</td></tr>'; });
    /* sources */
    var srcs = {}; views.forEach(function (e) { var s = e.src || 'direct'; (srcs[s] = srcs[s] || { v: 0, c: 0, who: {}, cv: 0 }).v++; if (e.visitor) srcs[s].who[e.visitor] = 1; });
    clicks.forEach(function (e) { var s = e.src || 'direct'; (srcs[s] = srcs[s] || { v: 0, c: 0, who: {}, cv: 0 }).c++; });
    conv.forEach(function (c) { var s = c.src || 'direct'; (srcs[s] = srcs[s] || { v: 0, c: 0, who: {}, cv: 0 }).cv++; });
    var sl = Object.keys(srcs).map(function (k) { return [k, srcs[k]]; }).sort(function (a, b) { return b[1].v - a[1].v; });
    var mxs = sl.length ? sl[0][1].v : 1;
    var srcRows = sl.map(function (x) { var s = x[1]; return '<tr><td>' + E(srcName(x[0])) + '</td><td>' + bar(s.v, mxs, ROSE) + ' ' + s.v + '</td><td>' + Object.keys(s.who).length + '</td><td>' + s.c + '</td><td>' + (s.v ? pct(s.c / s.v) : '\u2013') + '</td><td>' + (s.cv || '') + '</td></tr>'; });
    /* places, devices, languages */
    var places = countBy(views, function (e) { return e.city ? e.city + (e.region ? ', ' + e.region : '') : e.region ? e.region : e.country ? e.country : null; }).slice(0, 8);
    var cn = null; try { cn = new Intl.DisplayNames(['en'], { type: 'region' }); } catch (x) { cn = null; }
    var countries = countBy(views, function (e) { return e.country ? (cn ? cn.of(e.country) : e.country) : null; }).slice(0, 5);
    var devs = countBy(views, function (e) { return e.device ? e.device.charAt(0).toUpperCase() + e.device.slice(1) : null; }), apps = countBy(views, function (e) { return e.browser; }).slice(0, 6), oss = countBy(views, function (e) { return e.os; }).slice(0, 5), langs = countBy(views, function (e) { return e.lang === 'fr' ? 'French' : 'English'; });
    var listCard = function (title, rows, total) { var mx = rows.length ? rows[0][1] : 1; return '<h4>' + E(title) + '</h4>' + (rows.length ? rows.map(function (r) { return '<div class="w230li"><span>' + E(r[0]) + '</span>' + bar(r[1], mx, PURPLE) + '<b>' + (total ? pct(r[1] / total) : r[1]) + '</b></div>'; }).join('') : '<p class="muted">Not known yet.</p>'); };
    var heat = lpHeat(views);
    /* the funnel */
    var fun = [['Views', st.views], ['People', st.visitors], ['Clicked', st.clickers], ['Signed up or gave', st.signups + st.gave]];
    var funnel = '<div class="w230fun">' + fun.map(function (f, k) { return '<div><b>' + num(f[1]) + '</b><span>' + E(f[0]) + '</span>' + (k ? '<em>' + (fun[k - 1][1] ? pct(f[1] / fun[k - 1][1]) : '\u2013') + '</em>' : '') + '</div>'; }).join('') + '</div>';
    /* what it says */
    var tips = [];
    if (sl.length) { var top = sl[0]; tips.push(srcName(top[0]) + ' brings ' + pct(top[1].v / st.views) + ' of the visits.'); }
    var conv2 = sl.filter(function (x) { return x[1].v >= 15; }).sort(function (a, b) { return (b[1].c / b[1].v) - (a[1].c / a[1].v); });
    if (conv2.length > 1) tips.push('People from ' + srcName(conv2[0][0]) + ' click the most (' + pct(conv2[0][1].c / conv2[0][1].v) + ' click rate); ' + srcName(conv2[conv2.length - 1][0]) + ' the least (' + pct(conv2[conv2.length - 1][1].c / conv2[conv2.length - 1][1].v) + ').');
    if (bl.length) tips.push('\u201c' + blockName(bl[0].p, bl[0].b) + '\u201d gets ' + pct(bl[0].n / Math.max(1, st.clicks)) + ' of all clicks.');
    if (heat.best && views.length >= 20) tips.push('Visits peak on ' + WDL[heat.best.d] + 's around ' + heat.best.h + ':00: a good time to post.');
    var phone = devs.filter(function (x) { return x[0] === 'Phone'; })[0]; if (phone && st.views) tips.push(pct(phone[1] / st.views) + ' visit on a phone.');
    var tipCard = tips.length ? '<div class="card w230tips"><h3>' + I('bolt') + ' What it says</h3><ul>' + tips.map(function (t) { return '<li>' + E(t) + '</li>'; }).join('') + '</ul></div>' : '';
    return kpis + tipCard + '<div class="card"><h3>' + I('cal') + ' Views and clicks a day <span class="sp"></span><a class="btn225 sm" data-w230csv="1">' + I('down') + ' Export</a></h3>' + lpDaily(ev, L.days) + '</div>' +
      '<div class="grid2"><div><div class="card"><h3>' + I('link') + ' Buttons <small>what people clicked</small></h3>' + (btnRows.length ? lpTable(btnRows, ['Button', 'Clicks', 'People', 'Of views', 'Sign-ups']) : '<div class="empty">No clicks yet.</div>') + '</div>' +
      '<div class="card"><h3>' + I('send') + ' Where they came from</h3>' + lpTable(srcRows, ['Source', 'Views', 'People', 'Clicks', 'Click rate', 'Sign-ups']) + '<p class="muted" style="margin:8px 0 0">Visits with a source address (Sources and QR codes) are exact; the rest are read from the app they opened in or the site that sent them.</p></div></div>' +
      '<div><div class="card"><h3>' + I('check') + ' From a view to a sign-up</h3>' + funnel + '</div><div class="card"><h3>' + I('home') + ' Where they are</h3>' + listCard('Cities and regions', places, 0) + listCard('Countries', countries, st.views) + '</div>' +
      '<div class="card"><h3>' + I('eye') + ' How they visit</h3>' + listCard('Device', devs, st.views) + listCard('App or browser', apps, st.views) + listCard('System', oss, st.views) + listCard('Language', langs, st.views) + '</div></div></div>' +
      '<div class="card"><h3>' + I('clock') + ' When they visit <small>Toronto time</small></h3>' + heat.html + '</div>' +
      '<p class="muted">No cookie is set and no address is kept: a person is a code that changes every month, so \u201cpeople\u201d and \u201ccame back\u201d count within the month. Names appear only under People, for those who signed up or gave.</p>';
  }
  function lpCsv() {
    var L = S.lp, ev = lpEv(L.page, L.days);
    var head = ['when', 'page', 'kind', 'button', 'variant', 'source', 'device', 'system', 'app_or_browser', 'language', 'city', 'region', 'country', 'came_back'];
    var esc = function (v) { v = v == null ? '' : String(v); return /[",\n]/.test(v) ? '"' + v.replace(/"/g, '""') + '"' : v; };
    var rows = ev.map(function (e) { return [e.at, (lpPage(e.page_id) || {}).slug, e.kind, e.kind === 'click' ? blockName(e.page_id, e.block_id) : '', e.kind === 'click' ? e.variant : '', srcName(e.src), e.device, e.os, e.browser, e.lang, e.city, e.region, e.country, e.repeat_visit ? 'yes' : ''].map(esc).join(','); });
    var blob = new Blob([head.join(',') + '\n' + rows.join('\n')], { type: 'text/csv' }), a = document.createElement('a');
    a.href = URL.createObjectURL(blob); a.download = 'link-pages-' + today() + '.csv'; document.body.appendChild(a); a.click(); setTimeout(function () { URL.revokeObjectURL(a.href); a.remove(); }, 500);
  }

  /* ---------- people ---------- */
  function lpPeopleHtml() {
    var L = S.lp, conv = lpConv(L.page, L.days).slice().sort(function (a, b) { return String(b.at).localeCompare(String(a.at)); });
    var st = lpStats(lpEv(L.page, L.days), conv);
    var rows = conv.map(function (c) {
      var who = c.contact_name ? '<a href="#crm/c/' + c.contact_id + '" style="font-weight:700;color:' + ROSE + '">' + E(c.contact_name) + '</a>' : '<span class="muted">' + (c.kind === 'donation' ? (c.completed ? 'A donor' : 'Someone (not finished)') : 'Someone') + '</span>';
      return '<tr><td>' + who + '</td><td>' + E(c.kind === 'form' ? c.title : c.completed ? 'Gave (' + (c.ref || 'once') + ')' : 'Started a gift') + '</td><td>' + E(srcName(c.src)) + '</td><td>' + E(blockName(c.page_id, c.block_id)) + (L.page === 'all' ? ' <small class="muted">' + E((lpPage(c.page_id) || {}).title || '') + '</small>' : '') + '</td><td>' + E(niceWhen(c.at)) + '</td><td class="muted">' + E(Math.max(1, Math.round((new Date(c.at) - new Date(c.clicked_at)) / 60000))) + ' min after the click</td></tr>';
    });
    return '<div class="kpis"><div class="kpi"><b>' + num(st.visitors) + '</b><span>people visited</span><em>anonymous</em></div><div class="kpi"><b>' + num(st.clickers) + '</b><span>clicked something</span><em>anonymous</em></div><div class="kpi"><b class="ok">' + conv.length + '</b><span>signed up or gave</span><em>named in the CRM</em></div></div>' +
      '<div class="card"><h3>' + I('heart') + ' Who signed up or gave after a click</h3>' + (rows.length ? lpTable(rows, ['Person', 'What', 'Came from', 'Button', 'When', '']) : '<div class="empty">Nobody yet in this window. When someone clicks a form or the donation button and finishes it within 2 hours, they appear here with their CRM record.</div>') +
      '<p class="muted" style="margin:8px 0 0">A sign-up is credited to the last click on a link page from the same network in the 2 hours before it. Everyone else stays anonymous.</p></div>';
  }

  /* ---------- sources and QR codes ---------- */
  function lpSourcesHtml() {
    var L = S.lp, page = L.page === 'all' ? (L.pages.filter(function (p) { return p.slug === 'main'; })[0] || L.pages[0]) : lpPage(L.page);
    if (!page) return '<div class="card"><div class="empty">Make a page first.</div></div>';
    var ev = lpEv(page.id, L.days), conv = lpConv(page.id, L.days);
    var mine = L.sources.filter(function (s) { return s.active && (!s.page_id || String(s.page_id) === String(page.id)); });
    var seen = countBy(ev.filter(function (e) { return e.kind === 'view'; }), function (e) { return e.src || 'direct'; });
    var rows = mine.map(function (s) {
      var v = ev.filter(function (e) { return e.kind === 'view' && e.src === s.code; }).length, c = ev.filter(function (e) { return e.kind === 'click' && e.src === s.code; }).length, cv = conv.filter(function (x) { return x.src === s.code; }).length;
      var u = lpUrl(page, s.code);
      return '<tr><td><b>' + E(s.label) + '</b><br><small class="muted">' + E({ platform: 'Platform bio', qr: 'QR code', email: 'Email', print: 'Print', partner: 'Partner', other: 'Other' }[s.kind] || s.kind) + (s.page_id ? '' : ' \u00b7 every page') + '</small></td><td><code>' + E(u.replace(/^https:\/\//, '')) + '</code> <a data-w230copy="' + E(u) + '" style="cursor:pointer" title="Copy">' + I('copy') + '</a></td><td>' + v + '</td><td>' + c + '</td><td>' + (cv || '') + '</td>' +
        '<td style="white-space:nowrap"><a class="btn225 sm" data-w230qr="' + E(s.code) + '|png">QR PNG</a> <a class="btn225 sm" data-w230qr="' + E(s.code) + '|svg">SVG</a>' + (S.mk ? ' <a class="btn225 sm" data-w230soff="' + s.id + '" title="Retire">' + I('x') + '</a>' : '') + '</td></tr>';
    });
    var other = seen.filter(function (x) { return !mine.some(function (s) { return s.code === x[0]; }); });
    var add = S.mk ? '<div class="card"><h3>' + I('plus') + ' New source</h3><div class="row" style="gap:8px"><input type="text" id="w230sl" placeholder="e.g. Poster at Concordia" style="flex:1;min-width:180px" maxlength="60"><select id="w230sk"><option value="qr">QR code</option><option value="print">Print</option><option value="platform">Platform bio</option><option value="email">Email</option><option value="partner">Partner</option><option value="other">Other</option></select>' +
      '<select id="w230sp"><option value="' + page.id + '">This page only</option><option value="">Every page</option></select><a class="btn225 sm pri" data-w230sadd="1">' + I('plus') + ' Add</a></div><p class="muted" style="margin:8px 0 0">Each source gets its own address and QR code, so every visit and sign-up is credited to the right place. Put a different QR code on each poster to see which spot works.</p></div>' : '';
    return '<div class="card"><h3>' + I('send') + ' Addresses for ' + E(page.title) + ' <small>' + E(L.days) + ' days</small></h3>' + lpTable(rows, ['Source', 'Address', 'Views', 'Clicks', 'Sign-ups', '']) +
      (other.length ? '<h4>Also seen, without a source address</h4><div class="row" style="gap:6px;flex-wrap:wrap">' + other.map(function (x) { return '<span class="pill">' + E(srcName(x[0])) + ' \u00b7 ' + x[1] + '</span>'; }).join('') + '</div>' : '') + '</div>' + add + '<div id="w230qrbox"></div>';
  }
  async function lpAddSource() {
    var label = ((document.getElementById('w230sl') || {}).value || '').trim(), kind = (document.getElementById('w230sk') || {}).value || 'other', pg = (document.getElementById('w230sp') || {}).value;
    if (!label) { toastS('Name the source'); return; }
    var base = slug(label).slice(0, 30) || 'src', code = base, n = 2;
    while (S.lp.sources.some(function (s) { return s.code === code && (!s.page_id || !pg || String(s.page_id) === String(pg)); })) code = base.slice(0, 26) + '-' + (n++);
    try { var r = await db.from('link_page_sources').insert({ page_id: pg ? Number(pg) : null, code: code, label: label, kind: kind, created_by: myName() || myEmail() }).select('*').maybeSingle(); if (r.error) throw r.error; S.lp.sources.push(r.data || { code: code, label: label, kind: kind, active: true, page_id: pg ? Number(pg) : null }); toastS('Added: ' + code); }
    catch (x) { toastS('Could not add it: ' + (x.message || x)); }
    paint();
  }
  /* QR codes: qrcode-generator (MIT, cdnjs) draws the matrix; we draw it in our green with a cream quiet zone */
  function lpQrLib() {
    if (window.qrcode) return Promise.resolve(window.qrcode);
    return new Promise(function (res, rej) { var s = document.createElement('script'); s.src = 'https://cdnjs.cloudflare.com/ajax/libs/qrcode-generator/1.4.4/qrcode.min.js'; s.onload = function () { res(window.qrcode); }; s.onerror = function () { rej(new Error('the QR maker did not load')); }; document.head.appendChild(s); });
  }
  async function lpQr(code, kind) {
    var L = S.lp, page = L.page === 'all' ? (L.pages.filter(function (p) { return p.slug === 'main'; })[0] || L.pages[0]) : lpPage(L.page);
    var src = L.sources.filter(function (s) { return s.code === code; })[0] || { label: code };
    var url = lpUrl(page, code);
    try {
      var qr = (await lpQrLib())(0, 'H'); qr.addData(url); qr.make();
      var n = qr.getModuleCount(), pad0 = 4, sz = n + pad0 * 2, cells = '';
      for (var r = 0; r < n; r++) for (var c = 0; c < n; c++) if (qr.isDark(r, c)) cells += 'M' + (c + pad0) + ' ' + (r + pad0) + 'h1v1h-1z';
      var mid = sz / 2, badge = Math.round(n * 0.22);
      var svg = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ' + sz + ' ' + sz + '" shape-rendering="crispEdges"><rect width="' + sz + '" height="' + sz + '" fill="#FFFAF2"/><path d="' + cells + '" fill="#103F39"/>' +
        '<rect x="' + (mid - badge / 2 - 0.5) + '" y="' + (mid - badge / 2 - 0.5) + '" width="' + (badge + 1) + '" height="' + (badge + 1) + '" rx="1.5" fill="#FFFAF2"/><rect x="' + (mid - badge / 2) + '" y="' + (mid - badge / 2) + '" width="' + badge + '" height="' + badge + '" rx="1.2" fill="#DCA527"/>' +
        '<text x="' + mid + '" y="' + (mid + badge * 0.24) + '" text-anchor="middle" font-family="Arial Black,Arial,sans-serif" font-weight="900" font-size="' + (badge * 0.62).toFixed(2) + '" fill="#103F39">W</text></svg>';
      var name = 'qr-' + (page.slug === 'main' ? 'links' : page.slug) + '-' + code;
      var save = function (blob, ext) { var a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = name + '.' + ext; document.body.appendChild(a); a.click(); setTimeout(function () { URL.revokeObjectURL(a.href); a.remove(); }, 800); };
      var box = document.getElementById('w230qrbox');
      if (box) box.innerHTML = '<div class="card"><h3>' + I('eye') + ' ' + E(src.label) + ' <small>' + E(url.replace(/^https:\/\//, '')) + '</small></h3><div style="width:180px">' + svg + '</div><p class="muted" style="margin:6px 0 0">Scans open the page and are counted as ' + E(src.label) + '.</p></div>';
      if (kind === 'svg') { save(new Blob([svg], { type: 'image/svg+xml' }), 'svg'); return; }
      var img = new Image(), px = 1200; img.onload = function () { var cv = document.createElement('canvas'); cv.width = px; cv.height = px; var g = cv.getContext('2d'); g.imageSmoothingEnabled = false; g.drawImage(img, 0, 0, px, px); cv.toBlob(function (b) { if (b) save(b, 'png'); }, 'image/png'); };
      img.src = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg);
    } catch (x) { toastS('Could not make the QR code: ' + (x.message || x)); }
  }

  /* a repaint of the editor keeps the preview's frame (a fresh frame would reload the page each click) */
  function lpPatch(h, html) {
    var old = h.querySelector('.w230ed'), f0 = h.querySelector('#w230prev'); if (!old || !f0) return false;
    var tmp = document.createElement('div'); tmp.innerHTML = html;
    var ned = tmp.querySelector('.w230ed'), f1 = tmp.querySelector('#w230prev');
    if (!ned || !f1 || f1.getAttribute('src') !== f0.getAttribute('src')) return false;
    old.firstElementChild.innerHTML = ned.firstElementChild.innerHTML;
    var oc = old.querySelector('.w230prevcard'), nc = ned.querySelector('.w230prevcard');
    if (oc && nc) { oc.querySelector('h3').innerHTML = nc.querySelector('h3').innerHTML; }
    while (old.previousSibling) old.parentNode.removeChild(old.previousSibling);
    while (ned.previousSibling) old.parentNode.insertBefore(ned.parentNode.firstChild, old);
    while (old.nextSibling) old.parentNode.removeChild(old.nextSibling);
    while (ned.nextSibling) old.parentNode.appendChild(ned.nextSibling);
    return true;
  }

  /* ---------- events of this section ---------- */
  function inLp(t) { return !!(t && t.closest && t.closest('#w225host')) && S.sec === 'pages'; }
  document.addEventListener('click', function (e) {
    var t = e.target; if (!inLp(t)) return;
    var el = t.closest('[data-w230copy],[data-w230ins],[data-w230src],[data-w230arch],[data-w230sharch],[data-w230new],[data-w230days],[data-w230open],[data-w230mv],[data-w230addb],[data-w230dup],[data-w230rm],[data-w230save],[data-w230pub],[data-w230discard],[data-w230t],[data-w230pl],[data-w230pb],[data-w230win],[data-w230csv],[data-w230qr],[data-w230sadd],[data-w230soff]');
    if (!el || el.hasAttribute('disabled')) return;
    var x, d = S.lp.edit;
    if ((x = el.getAttribute('data-w230copy'))) { copyText(x); return; }
    if ((x = el.getAttribute('data-w230ins'))) { S.lp.page = x; go('#studio/pages/insights'); return; }
    if ((x = el.getAttribute('data-w230src'))) { S.lp.page = x; go('#studio/pages/sources'); return; }
    if ((x = el.getAttribute('data-w230arch'))) { var pg = lpPage(x); if (!pg) return; q(db.from('link_pages').update({ status: pg.status === 'archived' ? 'draft' : 'archived', updated_by: myName() || myEmail() }).eq('id', pg.id)).then(function (r) { if (r.error) toastS('Could not change it'); else { pg.status = pg.status === 'archived' ? 'draft' : 'archived'; paint(); } }); return; }
    if (el.hasAttribute('data-w230sharch')) { S.lp.showArchived = !S.lp.showArchived; paint(); return; }
    if (el.hasAttribute('data-w230new')) { lpCreate(); return; }
    if ((x = el.getAttribute('data-w230days'))) { S.lp.days = Number(x); paint(); return; }
    if (el.hasAttribute('data-w230csv')) { lpCsv(); return; }
    if ((x = el.getAttribute('data-w230qr'))) { var qp = x.split('|'); lpQr(qp[0], qp[1]); return; }
    if (el.hasAttribute('data-w230sadd')) { lpAddSource(); return; }
    if ((x = el.getAttribute('data-w230soff'))) { if (!confirm('Retire this source? Its address keeps working; it just leaves this list.')) return; q(db.from('link_page_sources').update({ active: false }).eq('id', Number(x))).then(function () { S.lp.sources.forEach(function (s) { if (String(s.id) === x) s.active = false; }); paint(); }); return; }
    if (!d) return;
    if ((x = el.getAttribute('data-w230open'))) { if (t.closest('[data-w230mv]')) return; S.lp.open[x] = !S.lp.open[x]; paint(); return; }
    if ((x = el.getAttribute('data-w230mv'))) { var mp = x.split('|'), i = Number(mp[1]), j = mp[0] === 'up' ? i - 1 : i + 1; if (j < 0 || j >= d.blocks.length) return; var tmp = d.blocks[i]; d.blocks[i] = d.blocks[j]; d.blocks[j] = tmp; d.dirty = true; paint(); lpPreview(); return; }
    if ((x = el.getAttribute('data-w230addb'))) { var nb = { id: 'b' + randCode(5), type: x, on: true }; if (x === 'form') nb.form = (S.lp.forms[0] || {}).slug || 'newsletter'; if (x === 'donate') { nb.label = 'Give'; nb.label_fr = 'Donner'; nb.icon = '\ud83d\udc9b'; } if (x === 'instagram') nb.count = 6; if (x === 'events') nb.count = 3; if (x === 'link') nb.url = 'https://'; d.blocks.push(nb); S.lp.open[nb.id] = true; d.dirty = true; paint(); lpPreview(); return; }
    if ((x = el.getAttribute('data-w230dup'))) { var src0 = d.blocks[Number(x)]; if (!src0) return; var cp = JSON.parse(JSON.stringify(src0)); cp.id = 'b' + randCode(5); delete cp.code; if (cp.ab) cp.ab.winner = null; d.blocks.splice(Number(x) + 1, 0, cp); S.lp.open[cp.id] = true; d.dirty = true; paint(); lpPreview(); return; }
    if ((x = el.getAttribute('data-w230rm'))) { var rb = d.blocks[Number(x)]; if (!rb || !confirm('Remove \u201c' + (rb.label || (LPT[rb.type] || [rb.type])[0]) + '\u201d from the page? Its past clicks stay in the insights.')) return; d.blocks.splice(Number(x), 1); d.dirty = true; paint(); lpPreview(); return; }
    if (el.hasAttribute('data-w230save')) { lpSave(null); return; }
    if ((x = el.getAttribute('data-w230pub'))) { lpSave(x); return; }
    if (el.hasAttribute('data-w230discard')) { if (!confirm('Discard the changes since the last save?')) return; S.lp.edit = null; paint(); return; }
    if ((x = el.getAttribute('data-w230t'))) { var tp = x.split('|'); d.theme = { preset: tp[1], shape: d.theme.shape }; d.dirty = true; paint(); lpPreview(); return; }
    if ((x = el.getAttribute('data-w230pl'))) { S.lp.prevLang = x; paint(); lpPreview(); return; }
    if ((x = el.getAttribute('data-w230pb'))) { S.lp.prevB = x === '1'; paint(); lpPreview(); return; }
    if (el.hasAttribute('data-w230win')) { var wp = el.getAttribute('data-w230win').split('|'), wb = d.blocks[Number(wp[0])]; if (!wb || !wb.ab) return; wb.ab.winner = wp[1] || null; if (wp[1] === 'b') { /* B becomes the text everyone sees */ } d.dirty = true; paint(); lpPreview(); toastS(wp[1] ? 'Everyone will see ' + wp[1].toUpperCase() + ' once you save' : 'The test restarts once you save'); return; }
  });
  document.addEventListener('input', function (e) {
    var t = e.target; if (!inLp(t) || !t.matches) return;
    var d = S.lp.edit; if (!d) return;
    var mark0 = function () { d.dirty = true; var m = document.querySelector('#w225host .w230bar0 .muted'); if (m) m.textContent = 'Changes not saved'; lpPreview(); };
    if (t.matches('[data-w230b]')) { lpSet(t.getAttribute('data-w230b'), t.value); mark0(); return; }
    if (t.matches('[data-w230p]')) { var k = t.getAttribute('data-w230p'); d[k] = k === 'slug' ? t.value.toLowerCase().replace(/[^a-z0-9-]/g, '') : t.value; mark0(); return; }
    if (t.matches('[data-w230s]')) { d.settings[t.getAttribute('data-w230s')] = t.value; mark0(); return; }
    if (t.matches('[data-w230so]')) { var v = t.value.trim(); if (v) d.socials[t.getAttribute('data-w230so')] = v; else delete d.socials[t.getAttribute('data-w230so')]; mark0(); return; }
    if (t.matches('[data-w230tc]')) { d.theme[t.getAttribute('data-w230tc')] = t.value; mark0(); return; }
    if (t.matches('[data-w230ab]')) { var ap = t.getAttribute('data-w230ab').split('|'), ab = d.blocks[Number(ap[0])]; if (!ab) return; ab.ab = ab.ab || {}; if (ap[1] !== 'on') { ab.ab[ap[1]] = t.value; mark0(); } return; }
    if (t.matches('[data-w230st]')) { var sp = t.getAttribute('data-w230st').split('|'), sb = d.blocks[Number(sp[0])]; if (!sb) return; sb.stats = (sb.stats || []).concat([{}, {}, {}, {}]).slice(0, 4); sb.stats[Number(sp[1])][sp[2]] = t.value; sb.stats = sb.stats.filter(function (s, k) { return s.n || s.label || k < 1; }); mark0(); return; }
  });
  document.addEventListener('change', function (e) {
    var t = e.target; if (!inLp(t) || !t.matches) return;
    if (t.matches('[data-w230pg]')) { S.lp.page = t.value === 'all' ? 'all' : t.value; paint(); return; }
    var d = S.lp.edit; if (!d) return;
    if (t.matches('[data-w230bc]')) { var p = t.getAttribute('data-w230bc').split('|'), b = d.blocks[Number(p[0])]; if (!b) return; b[p[1]] = !!t.checked; d.dirty = true; paint(); lpPreview(); return; }
    if (t.matches('[data-w230ab]') && /\|on$/.test(t.getAttribute('data-w230ab'))) { var ab = d.blocks[Number(t.getAttribute('data-w230ab').split('|')[0])]; if (!ab) return; ab.ab = Object.assign(ab.ab || {}, { on: !!t.checked, started_at: ab.ab && ab.ab.started_at || new Date().toISOString() }); d.dirty = true; paint(); lpPreview(); return; }
    if (t.matches('select[data-w230b]')) { lpSet(t.getAttribute('data-w230b'), t.value); d.dirty = true; paint(); lpPreview(); return; }
    if (t.matches('[data-w230t2]')) { d.theme[t.getAttribute('data-w230t2')] = t.value; d.dirty = true; lpPreview(); return; }
    if (t.matches('select[data-w230s]')) { d.settings[t.getAttribute('data-w230s')] = t.value; d.dirty = true; lpPreview(); return; }
  });

  /* ---------- the academy's page tours (wave122's engine; trainings row tour:contentstudio; tour:studio is the Email studio (wave202)) ---------- */
  function addTours() {
    try {
      var T = window.w122; if (!T || !T.tours) return false;
      var OPT = { opt: 1 };
      var St = function (sel, t, p, o) { var x = { s: sel, t: t, p: p }; if (o) Object.keys(o).forEach(function (k) { x[k] = o[k]; }); return x; };
      var Ct = function (t, p) { return { c: 1, t: t, p: p }; };
      if (!T.tours.contentstudio || !T.tours.contentstudio.__w225) T.tours.contentstudio = { __w225: true, tab: 'studio', icon: 'grid', hash: '#studio', steps: [
        St('#studio > .w118mast', 'Content Studio', 'Everything for our social media in one app: plan, approve, post, answer comments and see what worked, on Instagram, Facebook, Threads, LinkedIn, TikTok and YouTube.'),
        St('#w225host .kpis', 'At a glance', 'What is scheduled, what waits for approval, comments to answer, the weekly goal and the clicks on our links. Each number opens its page.', OPT),
        St('#w225host .grid2', 'The week ahead', 'The next seven days, anything that needs attention, the goals and how each platform posts.', OPT),
        Ct('The app menu', 'Calendar to plan and write posts; Queue and schedule for the posting times and goals; Approvals; Comments; Library for templates, hashtags and saved replies; Link pages for our link in bio and campaign pages, with who clicks what; Short links; Analytics; Report; Connections.'),
        Ct('Approvals', 'Marketing leads and admins publish. Everyone else presses Send for approval in the composer; a lead approves it or sends it back with a note, and you hear about it in the Hub and on Slack.'),
        Ct('Reminders', 'Where the Hub cannot post yet (LinkedIn, TikTok or YouTube until they are connected), the post\u2019s owner gets a reminder at post time with the caption and the media. Post it in the app, then press Mark posted.')
      ] };
      var cc = T.tours.contentcal;
      if (cc && !cc.__w225) {
        cc.__w225 = true;
        cc.steps = (cc.steps || []).map(function (s) {
          if (s.s === '#contentcal .w116top') return St(s.s, 'Content calendar', 'Plan, approve and publish posts for Instagram, Facebook, Threads, LinkedIn, TikTok and YouTube. It lives in the Content Studio app.');
          if (s.s === '#contentcal .cap') return St(s.s, 'How we post', 'Which platforms the Hub posts to directly, and which ones send a reminder to post by hand. Connections in the Content Studio sets them up.', OPT);
          if (s.c && s.t === 'The composer') return Ct('The composer', 'Pick the platforms, write the caption (the Hub drafts it and tailors it for each platform), add images or a video with alt text, a first comment and tags. Preview it on each platform, then plan it, schedule it in the next free slot, or send it for approval.');
          if (s.s === '#contentcal .chips') return St(s.s, 'Filters', 'By platform, state, tag, and the posts waiting for approval.', OPT);
          return s;
        });
      }
      return true;
    } catch (e) { return false; }
  }

  /* ---------- paint and route ---------- */
  var KEEP = ['data-w225iq', 'data-w225lq', 'data-w225kq', 'data-w225lf', 'data-w225bf', 'data-w225bsoc', 'data-w225rtext', 'data-w225rnote', 'data-w225blabel', 'data-w225burl', 'data-w225apnote', 'data-w230b', 'data-w230p', 'data-w230s', 'data-w230so', 'data-w230tc', 'data-w230ab', 'data-w230st'];
  function paint() {
    if (S.sec === 'calendar') return;
    var h = host(); if (!h) return;
    var a = document.activeElement, keep = null;
    if (a && h.contains(a)) { for (var i = 0; i < KEEP.length; i++) { if (a.hasAttribute(KEEP[i])) { keep = { attr: KEEP[i], val: a.getAttribute(KEEP[i]), s: a.selectionStart, e: a.selectionEnd }; break; } } }
    /* typed-but-unsent text survives a repaint */
    var held = {}; h.querySelectorAll('[data-w225apnote],[data-w225blabel],[data-w225burl]').forEach(function (el) { var k = ['data-w225apnote', 'data-w225blabel', 'data-w225burl'].filter(function (x) { return el.hasAttribute(x); })[0]; held[k + '=' + el.getAttribute(k)] = el.value; });
    h.querySelectorAll('input[id^="w225"],textarea[id^="w225"],select[id^="w225"],input[id^="w230"],select[id^="w230"]').forEach(function (el) { if (el.value) held['id=' + el.id] = el.value; });
    var html;
    if (!staffOk()) html = '<div class="card"><div class="empty">The Content Studio is for the staff.</div></div>';
    else if (S.err && !S.loaded) html = '<div class="card"><div class="empty">The Content Studio could not load (' + E(clip(S.err, 140)) + '). <a data-w225reload="1" style="cursor:pointer;font-weight:700">Try again</a></div></div>';
    else if (!S.loaded && !W()) html = '<div class="card"><div class="empty">Loading the Content Studio\u2026</div></div>';
    else {
      try {
        html = S.sec === 'queue' ? queueHtml() : S.sec === 'approvals' ? approvalsHtml() : S.sec === 'inbox' ? inboxHtml() : S.sec === 'library' ? libraryHtml() : S.sec === 'pages' ? pagesHtml() : S.sec === 'links' ? linksHtml() : S.sec === 'report' ? reportHtml() : S.sec === 'connections' ? connectHtml() : overviewHtml();
      } catch (e) { console.warn('wave225 paint', e); html = '<div class="card"><div class="empty">Something went wrong drawing this page: ' + E(e.message || e) + '</div></div>'; }
    }
    if (!(S.sec === 'pages' && S.sub === 'edit' && lpPatch(h, html))) h.innerHTML = html;
    Object.keys(held).forEach(function (k) { var p = k.split('='), el = h.querySelector('[' + p[0] + '="' + p.slice(1).join('=') + '"]'); if (el && held[k] !== el.value) el.value = held[k]; });
    if (keep) { try { var el = h.querySelector('[' + keep.attr + (keep.val ? '="' + keep.val + '"' : '') + ']'); if (el) { el.focus(); if (keep.s != null && el.setSelectionRange) el.setSelectionRange(keep.s, keep.e); } } catch (e) { /* fine */ } }
  }
  function route(hh) {
    var raw = String(hh || '').replace(/^#/, ''), qi = raw.indexOf('?'), path = qi >= 0 ? raw.slice(0, qi) : raw;
    var p = path.split('/'), sec = p[1] || 'overview', sub = p[2] || '';
    S.sec = SECTIONS.indexOf(sec) >= 0 ? sec : 'overview';
    S.sub = sub; S.sub2 = p[3] || '';
    if (S.sec === 'library') { if (LIBT.some(function (x) { return x[0] === sub; })) S.f.lib = sub; else S.sub = S.f.lib || 'templates'; if (S.libEdit && S.libEdit.tab !== S.sub) S.libEdit = null; }
    if (S.sec === 'connections' && qi >= 0) connFlash();
  }
  async function show(hh) {
    route(hh || location.hash);
    var h = host(); if (!h) return;
    if (!S.loaded) paint();
    await loadAll();
    if (S.sec === 'connections' && !S.conn) await loadConn();
    if (S.sec === 'pages') { try { await lpLoad(); } catch (e) { /* drawn below */ } }
    paint();
    try { if (window.w153 && window.w153.paint) window.w153.paint(); } catch (e) { /* fine */ }
  }
  function reload() { S.loaded = 0; S.conn = null; return show(location.hash); }

  /* ---------- small actions ---------- */
  function compose(pre) { var w = W(); if (w && w.compose) { w.compose(pre || null); return; } if (window.w121Compose) window.w121Compose(pre || null); else go('#contentcal/new'); }
  function openPost(id) { var w = W(); if (w && w.open && w.open(id)) return; go('#contentcal/' + id); }
  function localIso(d, at) { return new Date(d + 'T' + (at || '18:00') + ':00').toISOString(); }
  async function fillSlot(d, at, id) {
    try {
      var r = await db.from('content_posts').update({ scheduled_at: localIso(d, at), updated_by: myName() || myEmail(), updated_at: new Date().toISOString() }).eq('id', Number(id)); if (r.error) throw r.error;
      var w = W(); if (w) await w.load(true); toastS('Planned for ' + niceDate(d) + ', ' + at + '. Open it to schedule it.');
    } catch (x) { toastS('Could not plan it: ' + (x.message || x)); }
    paint();
  }
  async function removeSlot(id) {
    try { var r = await db.from('content_slots').delete().eq('id', Number(id)); if (r.error) throw r.error; var w = W(); if (w) await w.studio(); } catch (x) { toastS('Could not remove it: ' + (x.message || x)); }
    paint();
  }
  async function saveGoals() {
    var g = {}; document.querySelectorAll('#w225host [data-w225goal]').forEach(function (el) { var v = Math.max(0, Math.min(21, Math.round(Number(el.value) || 0))); g[el.getAttribute('data-w225goal')] = v; });
    try { var value = Object.assign({}, S.settings || {}, { goals: g }); var r = await db.rpc('studio_settings_save', { p_key: 'content_studio', p_value: value }); if (r.error) throw r.error; S.settings = value; toastS('Goals saved'); }
    catch (x) { toastS('Could not save the goals: ' + (x.message || x)); }
    paint();
  }
  async function syncInbox() {
    if (S.busy.sync) return; S.busy.sync = true; paint();
    try {
      var r = await fn('social-inbox', { action: 'sync', days: 45 });
      var rs = await Promise.all([q(db.from('social_comments').select('*').gte('commented_at', new Date(Date.now() - 90 * 86400000).toISOString()).order('commented_at', { ascending: false }).limit(1500)), q(db.from('hub_settings').select('value').eq('key', 'studio_inbox_sync').maybeSingle())]);
      if (rs[0].data) S.comments = rs[0].data; if (rs[1].data) S.inboxLast = rs[1].data.value;
      var added = 0; Object.keys((r && r.platforms) || {}).forEach(function (k) { added += Number(r.platforms[k].added || 0); }); toastS(added ? added + ' new comment' + (added === 1 ? '' : 's') : 'Checked: nothing new');
    } catch (x) { toastS('Could not check: ' + (x.message || x)); }
    S.busy.sync = false; paint(); try { if (window.w153) window.w153.paint(); } catch (e) { /* fine */ }
  }

  /* ---------- events ---------- */
  function inApp(t) { return !!(t && t.closest && t.closest('#w225host')); }
  var tT = null; function soon() { clearTimeout(tT); tT = setTimeout(paint, 200); }
  function arg(el, a) { return el.getAttribute(a) || ''; }
  document.addEventListener('click', function (e) {
    var t = e.target; if (!inApp(t)) return;
    var el = t.closest('a,button,[data-w225open],[data-w225go],[data-w225lcol]'); if (!el) return;
    if (el.hasAttribute('disabled')) { e.preventDefault(); return; }
    var x;
    if (el.hasAttribute('href') && /^https?:/.test(el.getAttribute('href'))) return;
    if ((x = arg(el, 'data-w225open'))) { e.preventDefault(); openPost(x); return; }
    if ((x = arg(el, 'data-w225go'))) { e.preventDefault(); go(x); return; }
    if (el.hasAttribute('data-w225new')) { e.preventDefault(); compose(null); return; }
    if (el.hasAttribute('data-w225reload')) { reload(); return; }
    if ((x = arg(el, 'data-w225slotnew'))) { var sp = x.split('|'); compose({ date: sp[0], time: sp[1], platforms: (sp[2] || '').split(',').filter(Boolean) }); return; }
    if ((x = arg(el, 'data-w225slotx'))) { removeSlot(x); return; }
    if ((x = arg(el, 'data-w225sugadd'))) { var sa = x.split('|'); addSlots([sa[0]], [Number(sa[1])], sa[2]).then(paint, function (er) { toastS('Could not add it: ' + (er.message || er)); }); return; }
    if (el.hasAttribute('data-w225swd')) { var wd = Number(arg(el, 'data-w225swd')), arr = S.keys.swd = S.keys.swd || []; var ix = arr.indexOf(wd); if (ix >= 0) arr.splice(ix, 1); else arr.push(wd); el.classList.toggle('on', ix < 0); return; }
    if (el.hasAttribute('data-w225slotadd')) {
      var pl = (document.getElementById('w225spl') || {}).value || 'all', at = (document.getElementById('w225sat') || {}).value || '';
      if (!(S.keys.swd || []).length) { toastS('Pick the days first'); return; } if (!/^\d{2}:\d{2}$/.test(at)) { toastS('Pick a time'); return; }
      S.keys.sat = at; addSlots(pl === 'all' ? PORDER.slice() : [pl], S.keys.swd.slice().sort(), at).then(paint, function (er) { toastS('Could not add it: ' + (er.message || er)); }); return;
    }
    if (el.hasAttribute('data-w225sug')) { S.suggest = S.suggest ? null : suggestTimes(); paint(); return; }
    if (el.hasAttribute('data-w225goalsave')) { saveGoals(); return; }
    if ((x = arg(el, 'data-w225apr'))) { S.f.apr = x; paint(); return; }
    if ((x = arg(el, 'data-w225dec'))) { var dp = x.split('|'); el.setAttribute('disabled', '1'); decideFrom(dp[0], dp[1]); return; }
    /* comments */
    if ((x = arg(el, 'data-w225rp'))) { S.reply[x] = S.reply[x] || { text: '' }; paint(); var ta = document.querySelector('#w225host [data-w225rtext="' + x + '"]'); if (ta) ta.focus(); return; }
    if ((x = arg(el, 'data-w225act'))) { var ap = x.split('|'); inboxAct(ap[0], ap[1]); return; }
    if ((x = arg(el, 'data-w225ai'))) { suggestReply(x); return; }
    if ((x = arg(el, 'data-w225rpx'))) { delete S.reply[x]; paint(); return; }
    if ((x = arg(el, 'data-w225send'))) { var rr = S.reply[x]; if (!rr || !String(rr.text || '').trim()) { toastS('Write the reply first'); return; } rr.sending = true; paint(); inboxAct('reply', x, { text: String(rr.text).trim() }); return; }
    if (el.hasAttribute('data-w225ib')) { S.f.inbox = arg(el, 'data-w225ib') || 'open'; lsSet('w225ib', S.f.inbox); paint(); return; }
    if (el.hasAttribute('data-w225ipl')) { S.f.ipl = arg(el, 'data-w225ipl'); paint(); return; }
    if (el.hasAttribute('data-w225sync')) { syncInbox(); return; }
    /* library */
    if ((x = arg(el, 'data-w225lnew'))) { libNew(x); paint(); var f0 = document.querySelector('#w225host [data-w225lf="name"]'); if (f0) f0.focus(); return; }
    if ((x = arg(el, 'data-w225ledit'))) { var le = x.split('|'); libEdit(le[0], le[1]); paint(); window.scrollTo({ top: 0, behavior: 'smooth' }); return; }
    if ((x = arg(el, 'data-w225ldel'))) { var ld = x.split('|'); libRemove(ld[0], ld[1]); return; }
    if ((x = arg(el, 'data-w225luse'))) { libUse(x); return; }
    if ((x = arg(el, 'data-w225lcopy'))) { libCopy(x); return; }
    if ((x = arg(el, 'data-w225lcal'))) { var w = W(); if (w && w.filter) w.filter('tag', x); go('#contentcal'); return; }
    if ((x = arg(el, 'data-w225lcol'))) { if (S.libEdit) { S.libEdit.color = x; paint(); } return; }
    if (el.hasAttribute('data-w225lsave')) { libSave(); return; }
    if (el.hasAttribute('data-w225lcancel')) { S.libEdit = null; paint(); return; }
    /* links */
    if (el.hasAttribute('data-w225kmake')) { makeLinkFromForm(); return; }
    if ((x = arg(el, 'data-w225kcopy'))) { copyText(shortUrl(x)); return; }
    if ((x = arg(el, 'data-w225kact'))) { var ka = x.split('|'); linkActive(ka[1], ka[0] === 'on'); return; }
    /* connections */
    if ((x = arg(el, 'data-w225cx'))) { e.preventDefault(); connAct(x); return; }
    if ((x = arg(el, 'data-w225ccopy'))) { copyText(x); return; }
    /* report */
    if (el.hasAttribute('data-w225rcopy')) { copyText(reportSummary()); return; }
    if (el.hasAttribute('data-w225print')) { printReport(); return; }
  });
  document.addEventListener('input', function (e) {
    var t = e.target; if (!inApp(t) || !t.matches) return;
    if (t.matches('[data-w225iq]')) { S.f.iq = t.value; soon(); return; }
    if (t.matches('[data-w225lq]')) { S.f.lq = t.value; soon(); return; }
    if (t.matches('[data-w225kq]')) { S.f.kq = t.value; soon(); return; }
    if (t.matches('[data-w225rtext]')) { var id = t.getAttribute('data-w225rtext'); (S.reply[id] = S.reply[id] || {}).text = t.value; return; }
    if (t.matches('[data-w225rnote]')) { S.keys['note-' + t.getAttribute('data-w225rnote')] = t.value; return; }
    if (t.matches('[data-w225lf]')) { if (S.libEdit) { S.libEdit[t.getAttribute('data-w225lf')] = t.value; if (S.libEdit.tab === 'hashtags' && t.getAttribute('data-w225lf') === 'body') soon(); } return; }
  });
  document.addEventListener('change', function (e) {
    var t = e.target; if (!inApp(t) || !t.matches) return;
    if (t.matches('[data-w225fill]')) { if (!t.value) return; var f = t.getAttribute('data-w225fill').split('|'); fillSlot(f[0], f[1], t.value); return; }
    if (t.matches('[data-w225assign]')) { inboxAct('assign', t.getAttribute('data-w225assign'), { to: t.value }); return; }
    if (t.matches('[data-w225saved]')) {
      var cid = t.getAttribute('data-w225saved'), sn = lib().filter(function (x) { return String(x.id) === t.value; })[0]; if (!sn) return;
      var c = S.comments.filter(function (x) { return String(x.id) === cid; })[0], nm = c ? (c.author_handle ? '@' + c.author_handle : (c.author_name || '').split(' ')[0]) : '';
      var r = S.reply[cid] = S.reply[cid] || {}; r.text = String(sn.body || '').replace(/\{name\}/g, nm || 'there');
      q(db.from('content_snippets').update({ uses: Number(sn.uses || 0) + 1 }).eq('id', sn.id)); paint(); return;
    }
    if (t.matches('[data-w225imine]')) { S.f.imine = !!t.checked; paint(); return; }
    if (t.matches('[data-w225kall]')) { S.f.kall = !!t.checked; paint(); return; }
    if (t.matches('[data-w225lpl]')) { if (!S.libEdit) return; var k = t.getAttribute('data-w225lpl'), pls = S.libEdit.platforms = S.libEdit.platforms || []; var i = pls.indexOf(k); if (t.checked && i < 0) pls.push(k); else if (!t.checked && i >= 0) pls.splice(i, 1); return; }
  });
  document.addEventListener('keydown', function (e) {
    var t = e.target; if (!inApp(t) || e.key !== 'Enter') return;
    if (t.matches && t.matches('#w225kurl,#w225klabel,#w225kcode,#w225kcamp')) { e.preventDefault(); makeLinkFromForm(); }
  });
  window.addEventListener('beforeunload', function (e) { if (S.lp && S.lp.edit && S.lp.edit.dirty && S.sec === 'pages') { e.preventDefault(); e.returnValue = ''; } });

  /* ---------- the page in the Hub ---------- */
  function tabOk(id) { try { return typeof wa40Allowed !== 'function' || (wa40Allowed() || []).indexOf(id) >= 0; } catch (e) { return false; } }
  /* whoever opens the app reaches the calendar and the analytics through it: body.w225has takes those out of their Hub menu (wave153's rule) */
  function markHas() { try { document.body.classList.toggle('w225has', staffOk() && tabOk('studio')); } catch (e) { /* fine */ } }
  var hasT = null;
  function watchHas() {
    var bar = document.getElementById('tabBar'); if (!bar || bar.__w225obs) return;
    bar.__w225obs = true;
    try { new MutationObserver(function () { clearTimeout(hasT); hasT = setTimeout(markHas, 150); }).observe(bar, { attributes: true, subtree: true, attributeFilter: ['style'] }); } catch (e) { /* fine */ }
  }
  /* Steel's rule (09/10/26), also before every access profile lists the page (wa225b): the marketing, fundraising and executive
     profiles, admins and team leads get the app; never the board */
  function enrol() {
    try {
      if (typeof wa40Allowed === 'function' && !wa40Allowed.__w225) {
        var __al = wa40Allowed;
        wa40Allowed = function () { var a = __al.apply(this, arguments) || []; var bd = false; try { bd = (typeof MODE !== 'undefined' && MODE === 'board') || role() === 'board'; } catch (x) { /* fine */ } var pk = ''; try { pk = (typeof WA40_MINE !== 'undefined' && WA40_MINE && WA40_MINE.profile) || ''; } catch (x) { /* fine */ } if (!bd && a.indexOf('studio') < 0 && (['marketing', 'fundraising', 'executive', 'admin'].indexOf(pk) >= 0 || role() === 'admin' || role() === 'leader')) a = a.concat(['studio']); return a; };
        Object.keys(__al).forEach(function (k) { try { wa40Allowed[k] = __al[k]; } catch (x) { /* fine */ } });
        wa40Allowed.__w225 = true;
      }
    } catch (e) { /* fine */ }
  }
  function register() {
    if (!window.WA_NAV || typeof WA_NAV.register !== 'function') return;
    enrol();
    if (!WA_NAV.pages.some(function (p) { return p.id === 'studio'; })) WA_NAV.register({ id: 'studio', label: 'Content Studio', group: 'apps', dot: ROSE, gate: 'leader', onShow: function (h) { show(h); } });
  }
  var toursOk = false;
  if (typeof startApp === 'function') {
    var __sa225 = startApp;
    startApp = async function () {
      var out = await __sa225.apply(this, arguments);
      try {
        register(); toursOk = addTours(); markHas(); watchHas();
        [400, 1500, 4000].forEach(function (ms) { setTimeout(function () { markHas(); if (!toursOk) toursOk = addTours(); }, ms); });
        var h = decodeURIComponent(location.hash || '').replace(/^#/, '');
        if (h.split('/')[0] === 'studio') { try { showPanel('studio'); } catch (x) { /* fine */ } show(h); }
        else setTimeout(function () { if (staffOk() && tabOk('studio') && !S.loaded) loadAll(); }, 6000);   /* the rail's counts */
      } catch (e) { console.warn('wave225 boot', e); }
      return out;
    };
  }

  /* ---------- test hook ---------- */
  window.w225 = {
    counts: counts, state: function () { return S; }, paint: paint, show: show, load: loadAll, route: route, reload: reload,
    html: { overview: overviewHtml, queue: queueHtml, approvals: approvalsHtml, inbox: inboxHtml, library: libraryHtml, links: linksHtml, report: reportHtml, connections: connectHtml },
    monthStats: monthStats, reportSummary: reportSummary, suggestTimes: suggestTimes, goalStatus: goalStatus, streak: streak, makeLink: makeLink, shortUrl: shortUrl
  };
})();
