    + '#w225host .kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin:0 0 14px;}'
    + '#w225host .kpi{background:#FFFAF2;border:1px solid rgba(16,63,57,.10);border-radius:16px;padding:12px 14px;cursor:default;}'
