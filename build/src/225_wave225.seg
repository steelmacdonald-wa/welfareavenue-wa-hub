    + '#w225host .pill.ok{background:rgba(42,140,122,.16);color:#1c6b5d;}#w225host .pill.warn{background:rgba(220,165,39,.22);color:#6b4d05;}#w225host .pill.bad{background:rgba(179,64,47,.12);color:' + FLAG + ';}#w225host .pill.appr{background:rgba(111,100,171,.16);color:' + PURPLE + ';}'
    /* lists of posts */
