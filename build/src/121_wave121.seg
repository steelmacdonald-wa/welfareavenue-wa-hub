    '@media (max-width:640px){#contentcal .mg{gap:2px;}#contentcal .d{min-height:64px;padding:3px;}#contentcal .ch .tt,#contentcal .ch img{display:none;}#contentcal .wg{grid-template-columns:minmax(0,1fr);}#contentcal .lr{grid-template-columns:70px 40px minmax(0,1fr);}#contentcal .lr .rt{grid-column:1 / -1;flex-direction:row;justify-content:flex-start;}#w121dr .row2{grid-template-columns:1fr;}#contentcal .ctl .nav b{min-width:120px;font-size:20px;}}';
  document.head.appendChild(css);

  /* ---------- helpers ---------- */
  function E(s) { return (typeof esc === 'function') ? esc(s) : String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
  function toastS(t) { try { toast(t); } catch (e) { /* fine */ } }
  function staff() { try { return typeof isStaff === 'function' && isStaff(); } catch (e) { return false; } }
  function board() { try { return typeof MODE !== 'undefined' && MODE === 'board'; } catch (e) { return false; } }
  function allowed() { return staff() || board(); }
  function me() { try { return (typeof USER !== 'undefined' && USER && USER.name) || ''; } catch (e) { return ''; } }
  function ymd(d) { return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'); }
  function today() { return ymd(new Date()); }
  function addDays(ds, n) { var d = new Date(ds + 'T12:00:00'); return ymd(new Date(d.getTime() + n * 86400000)); }
  function dowOf(ds) { return (new Date(ds + 'T12:00:00').getDay() + 6) % 7; }
  function mondayOf(ds) { return addDays(ds, -dowOf(ds)); }
  function addMonths(ds, n) { var y = Number(ds.slice(0, 4)), m = Number(ds.slice(5, 7)) - 1 + n; y += Math.floor(m / 12); m = ((m % 12) + 12) % 12; return y + '-' + String(m + 1).padStart(2, '0') + '-01'; }
  function dayOf(iso) { return iso ? ymd(new Date(iso)) : null; }
  function hm(iso) { if (!iso) return ''; var d = new Date(iso); return String(d.getHours()).padStart(2, '0') + ':' + String(d.getMinutes()).padStart(2, '0'); }
  function niceDate(ds, opts) { try { return new Date(ds + 'T12:00:00').toLocaleDateString('en-CA', opts || { weekday: 'short', month: 'short', day: 'numeric' }); } catch (e) { return ds; } }
  function niceWhen(iso) { if (!iso) return 'No date'; return niceDate(dayOf(iso)) + ', ' + hm(iso); }
  function isoOf(ds, t) { return new Date(ds + 'T' + (t || '18:00') + ':00').toISOString(); }
  function num(v) { v = Number(v); if (!isFinite(v)) return '\u2013'; var a = Math.abs(v); if (a >= 1e6) return (v / 1e6).toFixed(1).replace(/\.0$/, '') + 'M'; if (a >= 1e4) return Math.round(v / 1e3) + 'k'; if (a >= 1e3) return (v / 1e3).toFixed(1).replace(/\.0$/, '') + 'k'; return String(Math.round(v)); }
  function tz() { try { return Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch (e) { return ''; } }
  function marks(pls, liveMap) { return '<span class="pm">' + (pls || []).map(function (p) { var c = PL[p]; if (!c) return ''; return '<i class="' + (liveMap && liveMap[p] ? 'ok' : '') + '" style="background:' + c.color + '" title="' + E(c.label) + (liveMap && liveMap[p] ? ': live' : '') + '">' + E(c.short) + '</i>'; }).join('') + '</span>'; }
  function thumbOf(p) { var m = (p.media || []).filter(function (x) { return x && x.url && String(x.kind || x.mime || '').indexOf('video') < 0; })[0]; return m ? m.url : null; }
  function hasVideo(p) { return (p.media || []).some(function (x) { return x && String(x.kind || x.mime || '').indexOf('video') >= 0; }); }
  function titleOf(p) { var t = String(p.title || '').trim(); if (t) return t; var c = String(p.caption || '').replace(/\s+/g, ' ').trim(); return c ? (c.length > 60 ? c.slice(0, 57) + '\u2026' : c) : 'Untitled post'; }
  function fn(name, body) { return db.functions.invoke(name, { body: body }).then(function (r) { if (r.error) throw r.error; if (r.data && r.data.error) throw new Error(r.data.error); return r.data; }); }
  function canPublish(pls) { var c = C.cap; if (!c || !c.token) return false; return (pls || []).length > 0 && (pls || []).every(function (p) { return c.can && c.can[p] === true; }); }
  function anyPublish() { var c = C.cap; return !!(c && c.token && c.can && (c.can.instagram || c.can.facebook)); }

  /* the state a post is really in, including what the analytics confirmed */
  function stateOf(p) {
    var now = Date.now(); var due = p.scheduled_at ? new Date(p.scheduled_at).getTime() : null;
    var liveMap = {}; Object.keys(p.live || {}).forEach(function (k) { if (p.live[k] && (p.live[k].external_id || p.live[k].url)) liveMap[k] = p.live[k]; });
    var results = p.results || {};
    var up = Object.keys(results).filter(function (k) { return results[k] && (results[k].id || results[k].url); });
    var s = p.status || 'draft'; var cls = (ST[s] || ST.draft).cls; var label = (ST[s] || ST.draft).label; var attn = false; var note = '';
    if (s === 'scheduled' && due && due < now - 15 * 60000) { cls = 'due'; label = 'Due'; attn = true; note = canPublish(p.platforms) ? 'Was due at ' + hm(p.scheduled_at) + '; publishing did not run' : 'Due: post it in Meta Business Suite; the hub confirms it when it shows up'; }
    else if (s === 'scheduled') note = canPublish(p.platforms) ? 'Publishes automatically at ' + hm(p.scheduled_at) : 'Planned for ' + niceWhen(p.scheduled_at) + '; post it by hand (publishing is off)';
    else if (s === 'failed') { attn = true; if (up.length) { label = 'Partly published'; } note = p.error || 'Publishing failed'; }
    else if (s === 'publishing') { var pend = Object.keys(results).some(function (k) { return results[k] && results[k].pending; }); note = pend ? 'Instagram is processing the video; it goes up within a few minutes' : 'Publishing now'; if (now - new Date(p.updated_at || p.created_at || now).getTime() > 15 * 60000) attn = true; }
    else if (s === 'published' || s === 'posted') {
      var missing = (p.platforms || []).filter(function (k) { return !liveMap[k]; });
      var ago = p.published_at ? (now - new Date(p.published_at).getTime()) / 3600000 : 0;
      var connected = function (k) { return ((C.cap && C.cap.accounts) || []).some(function (a) { return a.platform === k; }); };
      if (!missing.length) note = 'Live on ' + (p.platforms || []).map(function (k) { return PL[k] ? PL[k].label : k; }).join(' and ');
      else if (ago > 36 && missing.some(connected)) { note = 'Not seen in the analytics yet on ' + missing.filter(connected).map(function (k) { return PL[k].label; }).join(' and '); attn = true; }
      else note = s === 'posted' ? 'Marked posted; the numbers arrive with the next morning pull' : 'Published; the numbers arrive with the next morning pull';
    }
    return { cls: cls, label: label, attn: attn, note: note, live: liveMap, up: up };
  }
  function draggable(p) { return staff() && ['draft', 'scheduled', 'failed'].indexOf(p.status || 'draft') >= 0 && !(p.status === 'failed' && stateOf(p).up.length); }
  function matches(p) {
    var f = C.filter;
    if (f.pl && (p.platforms || []).indexOf(f.pl) < 0) return false;
    if (f.st) {
      var s = stateOf(p);
      if (f.st === 'planned' && ['draft', 'scheduled'].indexOf(p.status) < 0) return false;
      if (f.st === 'live' && ['published', 'posted'].indexOf(p.status) < 0) return false;
      if (f.st === 'attn' && !s.attn) return false;
      if (f.st === 'drafts' && p.status !== 'draft') return false;
    }
    if (f.q) { var q = f.q.toLowerCase(); if ([p.title, p.caption, p.campaign, p.owner, p.notes].join(' ').toLowerCase().indexOf(q) < 0) return false; }
    return true;
  }
  function dated() { return C.posts.filter(function (p) { return p.scheduled_at && p.status !== 'cancelled' && matches(p); }); }
  function undated() { return C.posts.filter(function (p) { return !p.scheduled_at && p.status !== 'cancelled' && matches(p); }); }
  function byDay() { var m = {}; dated().forEach(function (p) { var d = dayOf(p.scheduled_at); (m[d] = m[d] || []).push(p); }); Object.keys(m).forEach(function (k) { m[k].sort(function (a, b) { return String(a.scheduled_at).localeCompare(String(b.scheduled_at)); }); }); return m; }

  /* ---------- data ---------- */
  async function load(force) {
    if (C.loading) return;
    if (!force && C.loaded && Date.now() - C.at < 30000) { paint(); return; }
    C.loading = true; C.err = null; if (!C.loaded) paint();
    try {
      var r = await db.from('content_posts').select('*').order('scheduled_at', { ascending: true }).limit(1500);
      if (r.error) throw r.error;
      var all121 = (r.data || []).map(function (p) { p.platforms = p.platforms || []; p.media = p.media || []; p.results = p.results || {}; p.live = p.live || {}; return p; });
      /* wave136: an idea in the bank is out of the calendar until its date (the bank page lists it) */
      C.banked = all121.filter(function (p) { return !!p.banked_at; });
      C.posts = all121.filter(function (p) { return !p.banked_at; });
      loadSources();
      C.loaded = true; C.at = Date.now();
    } catch (e) { C.err = e.message || String(e); }
    C.loading = false; paint();
    if (!C.cap && staff() && !C.capBusy) loadCap();
    if (!C.perf && !C.perfBusy) loadPerf();
  }
  /* wave136: the meeting each idea came from */
  async function loadSources() {
    try {
      C.src = C.src || {}; var ids = [];
      C.posts.concat(C.banked || []).forEach(function (p) { var s = p.source_transcript_id; if (s && !C.src[s] && ids.indexOf(s) < 0) ids.push(s); });
      if (!ids.length) return;
      var r = await db.from('transcripts').select('id, title, meeting_date').in('id', ids.slice(0, 200));
      ((r && r.data) || []).forEach(function (x) { C.src[x.id] = { title: x.title || null, date: x.meeting_date || null }; });
      ids.forEach(function (id) { if (!C.src[id]) C.src[id] = { title: null, date: null }; });
      paint(); if (C.edit) paintDrawer();
    } catch (e) { /* the ideas still show, without the meeting's name */ }
  }
  function srcOf(p) { if (!p || !p.source_transcript_id) return null; return (C.src && C.src[p.source_transcript_id]) || { title: null, date: null }; }
  function shortDay(ds) { return niceDate(ds, String(ds).slice(0, 4) === today().slice(0, 4) ? { month: 'short', day: 'numeric' } : { month: 'short', day: 'numeric', year: 'numeric' }); }
  function ideaLine(p) {
    var bits = [], s = srcOf(p);
    if (p.resurfaced_at && (Date.now() - new Date(p.resurfaced_at).getTime()) < 14 * 86400000) bits.push('<i>Back from the bank</i>');
    if (p.idea_for) bits.push('For ' + E(shortDay(p.idea_for)));
    if (s) bits.push('From ' + (s.title ? E(s.title) : 'a meeting'));
    else if (p.suggested_by) bits.push('Idea from ' + E(p.suggested_by));
    return bits.join(' \u00b7 ');
  }
  window.w121Stale = function () { C.at = 0; };
  async function loadCap() {
    C.capBusy = true;
    try { C.cap = await fn('social-publish', { action: 'capabilities' }); } catch (e) { C.cap = { token: false, error: e.message || String(e), can: {}, accounts: [] }; }
    C.capBusy = false; paint(); if (C.edit) paintDrawer();
  }
  /* the analytics (90 days) for the best slot and the handle */
  async function loadPerf() {
    C.perfBusy = true;
    try {
      var d = window.w120Data ? window.w120Data() : null;
      if (!d || !d.posts_all) { var r = await db.rpc('social_overview', { p_days: 90 }); if (r && !r.error) d = r.data; }
      C.perf = d || {};
    } catch (e) { C.perf = {}; }
    C.perfBusy = false; paint();
  }
  function bestSlot() { try { return C.perf && window.w120BestSlot ? window.w120BestSlot(C.perf) : null; } catch (e) { return null; } }
  function igHandle() { var a = ((C.perf && C.perf.accounts) || []).filter(function (x) { return x.platform === 'instagram'; })[0] || ((C.cap && C.cap.accounts) || []).filter(function (x) { return x.platform === 'instagram'; })[0]; return (a && a.handle) || 'welfareavenue'; }
  function nextSlotDate(slot) {
    var t = today(); var h = slot && slot.h != null ? String(slot.h).padStart(2, '0') + ':00' : '18:00';
    if (!slot || !slot.wd) { var d0 = addDays(t, 1); return { date: d0, time: h }; }
    var want = WD.indexOf(slot.wd); for (var i = 1; i <= 7; i++) { var d = addDays(t, i); if (dowOf(d) === want) return { date: d, time: h }; }
    return { date: addDays(t, 1), time: h };
  }
  async function saveRow(id, patch) {
    patch.updated_at = new Date().toISOString(); patch.updated_by = me() || 'staff';
    var r = await db.from('content_posts').update(patch).eq('id', id).select('*');
    if (r.error) throw r.error;
    var row = (r.data && r.data[0]) || null;
    C.posts = C.posts.map(function (p) { if (String(p.id) !== String(id)) return p; var n = Object.assign({}, p, patch, row || {}); n.platforms = n.platforms || []; n.media = n.media || []; n.results = n.results || {}; n.live = n.live || {}; return n; });
    return row;
  }
  async function insertRow(row) {
    row.created_by = me() || 'staff'; row.updated_by = row.created_by;
    var r = await db.from('content_posts').insert(row).select('*').single();
    if (r.error) throw r.error;
    var n = Object.assign({}, row, r.data || {}); if (n.id == null) n.id = 'tmp' + Date.now();
    n.platforms = n.platforms || []; n.media = n.media || []; n.results = n.results || {}; n.live = n.live || {};
    C.posts.push(n); return n;
  }
  function logIt(id, field, oldV, newV) { try { logChange('content_post', id, field, oldV, newV); } catch (e) { /* fine */ } }

  /* ---------- the page ---------- */
  function panel() {
    var sec = document.getElementById('contentcal');
    if (!sec) { var main = document.querySelector('main'); if (!main) return null; sec = document.createElement('section'); sec.id = 'contentcal'; sec.className = 'panel'; main.appendChild(sec); }
    return sec;
  }
  function capBanner() {
    if (!staff()) return '';
    var c = C.cap;
    if (!c) return '<div class="cap"><div><b>Checking the Meta connection\u2026</b></div></div>';
    if (c.token && c.can && c.can.instagram && c.can.facebook) return '<div class="cap on"><div><b>Publishing is on for Instagram and Facebook.</b>Scheduled posts go out within five minutes of their time, and each one is confirmed live when it shows up in the analytics.</div></div>';
    var parts = [];
    if (!c.token) parts.push('The Meta token is not in the vault yet, so the calendar plans posts and confirms them when they show up in the analytics. To publish from here, generate the token with <b style="display:inline">pages_manage_posts</b> and <b style="display:inline">instagram_content_publish</b> ticked as well (<a data-w121go="#socialstats">Analytics &gt; Set up</a>).');
    else {
      var on = ['instagram', 'facebook'].filter(function (k) { return c.can && c.can[k]; }).map(function (k) { return PL[k].label; });
      if (on.length) parts.push('Publishing is on for ' + on.join(' and ') + '.');
      if ((c.missing || []).length) parts.push('The token is missing ' + c.missing.join(' and ') + '; generate it again with ' + (c.missing.length > 1 ? 'those' : 'that') + ' ticked to publish everywhere.');
      if ((c.accounts_missing || []).length) parts.push('Connect ' + c.accounts_missing.map(function (k) { return PL[k] ? PL[k].label : k; }).join(' and ') + ' in <a data-w121go="#socialstats">Analytics &gt; Set up</a>.');
      if (!on.length && !(c.missing || []).length && !(c.accounts_missing || []).length) parts.push('Publishing is off.');
      parts.push('Until then, posts are planned here and confirmed from the analytics.');
    }
    return '<div class="cap"><div><b>' + (c.token ? 'Publishing is partly on' : 'Plan and confirm mode') + '</b>' + parts.join(' ') + '</div></div>';
  }
  function glance() {
    var now = Date.now(); var t = today(); var mon = mondayOf(t), sun = addDays(mon, 6);
    var wk = C.posts.filter(function (p) { var d = dayOf(p.scheduled_at || p.published_at); return d && d >= mon && d <= sun && p.status !== 'cancelled'; });
    var planned = wk.filter(function (p) { return ['draft', 'scheduled', 'publishing'].indexOf(p.status) >= 0; }).length;
    var live = wk.filter(function (p) { return ['published', 'posted'].indexOf(p.status) >= 0; }).length;
    var next = C.posts.filter(function (p) { return p.scheduled_at && new Date(p.scheduled_at).getTime() > now && ['draft', 'scheduled'].indexOf(p.status) >= 0; }).sort(function (a, b) { return String(a.scheduled_at).localeCompare(String(b.scheduled_at)); })[0];
    var attn = C.posts.filter(function (p) { return p.status !== 'cancelled' && stateOf(p).attn; }).length;
    var ideas = C.posts.filter(function (p) { return !p.scheduled_at && p.status === 'draft'; }).length;
    var reach = 0; C.posts.forEach(function (p) { var d = dayOf(p.published_at); if (!d || (now - new Date(p.published_at).getTime()) > 30 * 86400000) return; Object.keys(p.live || {}).forEach(function (k) { reach += Number((p.live[k] || {}).reach || 0); }); });
    var slot = bestSlot();
    return '<div class="glance">' +
      '<div><b>' + planned + '</b><span>planned this week</span></div>' +
      '<div><b>' + live + '</b><span>live this week</span></div>' +
      '<div' + (next ? ' data-w121open="' + next.id + '"' + ' data-w121jump="1"' : '') + '><b>' + (next ? E(niceDate(dayOf(next.scheduled_at), { weekday: 'short' }) + ' ' + hm(next.scheduled_at)) : '\u2013') + '</b><span>next post</span>' + (next ? '<em>' + E(titleOf(next)) + '</em>' : '') + '</div>' +
      '<div data-w121jump="attn"><b class="' + (attn ? 'warn' : '') + '">' + attn + '</b><span>need attention</span></div>' +
      '<div><b>' + ideas + '</b><span>ideas without a date' + (C.banked && C.banked.length ? ', ' + C.banked.length + ' more in the bank' : '') + '</span></div>' +
      '<div><b>' + (reach ? num(reach) : '\u2013') + '</b><span>reach from calendar posts, 30 days</span></div>' +
      (slot ? '<div title="From the analytics insights"><b style="font-size:20px">' + E(slot.label) + '</b><span>best slot to post</span></div>' : '') +
      '</div>';
  }
  function header() {
    var a = C.anchor, v = C.view; var label = v === 'month' ? niceDate(a, { month: 'long', year: 'numeric' }) : v === 'week' ? (function () { var m = mondayOf(a); return niceDate(m, { month: 'short', day: 'numeric' }) + ' to ' + niceDate(addDays(m, 6), { month: 'short', day: 'numeric' }); })() : 'All posts';
    return '<div class="w116crumb"><a data-w116go="#mypage">Home</a> &middot; Departments &middot; <a data-w116go="#team/marketing">Marketing, Branding &amp; Web</a> &middot; Content calendar</div>' +
      '<div class="w116top"><div><h2><span class="dot" style="background:#6F64AB"></span>Content calendar</h2><p class="sub">Plan, publish and confirm Instagram and Facebook posts. Drag a post to move it; drop an idea on a day to plan it.</p></div>' +
      '<div class="w120ctl" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">' + (staff() ? '<button class="btn" data-w121new="1">New post</button><button class="btn mini ghost" data-w121set="1" title="Slack confirmations">Settings</button>' : '') + '<a class="btn mini ghost" data-w121go="#socialstats">Analytics</a></div></div>' +
      '<div class="ctl"><span class="w116seg">' + [['month', 'Month'], ['week', 'Week'], ['list', 'List']].map(function (x) { return '<a data-w121view="' + x[0] + '" class="' + (v === x[0] ? 'on' : '') + '">' + x[1] + '</a>'; }).join('') + '</span>' +
      (v !== 'list' ? '<span class="nav"><button data-w121nav="-1" title="Back">&lsaquo;</button><b>' + E(label) + '</b><button data-w121nav="1" title="Forward">&rsaquo;</button></span><button class="btn mini ghost" data-w121nav="0">Today</button>' : '') +
      '<span class="sp"></span><input type="search" id="w121q" placeholder="Search posts" value="' + E(C.filter.q) + '"></div>' +
      '<div class="chips">' + [['', 'All platforms'], ['instagram', 'Instagram'], ['facebook', 'Facebook']].map(function (x) { return '<span data-w121fpl="' + x[0] + '" class="' + (C.filter.pl === x[0] ? 'on' : '') + '">' + x[1] + '</span>'; }).join('') + '<i></i>' +
      [['', 'Everything'], ['planned', 'Planned'], ['live', 'Live'], ['attn', 'Needs attention'], ['drafts', 'Drafts']].map(function (x) { return '<span data-w121fst="' + x[0] + '" class="' + (C.filter.st === x[0] ? 'on' : '') + '">' + x[1] + '</span>'; }).join('') + '</div>';
  }
  function settingsPanel() {
    if (!C.settingsOpen || !staff()) return '';
    var s = (C.cap && C.cap.settings) || {}; var chans = C.channels || [];
    var cur = s.slack_channel || 'social-media';
    var opts = (chans.length ? chans : [{ name: cur, member: true }]).map(function (c) { return '<option value="' + E(c.name) + '"' + (c.name === cur ? ' selected' : '') + '>#' + E(c.name) + (c.member === false ? ' (bot not in it yet)' : '') + '</option>'; }).join('');
    return '<div class="setp"><label style="display:flex;gap:8px;align-items:center;font-weight:700"><input type="checkbox" id="w121slack"' + (s.slack_confirm ? ' checked' : '') + '> Confirm in Slack when a post goes live</label><select id="w121chan">' + opts + '</select><button class="btn mini" data-w121saveset="1">Save</button><span style="color:var(--wa-muted)">One message per post and platform: published from here, or seen in the analytics.</span></div>';
  }
  function chip(p) {
    var s = stateOf(p); var th = thumbOf(p);
    return '<div class="ch st-' + s.cls + '" data-w121open="' + p.id + '" draggable="' + (draggable(p) ? 'true' : 'false') + '" data-w121card="' + p.id + '" title="' + E(titleOf(p) + ' \u00b7 ' + s.label + (s.note ? ' \u00b7 ' + s.note : '')) + '">' + (th ? '<img src="' + E(th) + '" alt="" loading="lazy">' : '') + '<span class="tm">' + hm(p.scheduled_at) + '</span>' + marks(p.platforms, s.live) + '<span class="tt">' + E(titleOf(p)) + '</span></div>';
  }
  function monthView() {
    var a = C.anchor; var first = a.slice(0, 8) + '01'; var start = mondayOf(first); var m = byDay(); var t = today(); var slot = bestSlot();
    var html = '<div class="mg">' + WD.map(function (d) { return '<div class="dow">' + d + '</div>'; }).join('');
    var monthNo = first.slice(5, 7);
    for (var i = 0; i < 42; i++) {
      var d = addDays(start, i); if (i >= 35 && d.slice(5, 7) !== monthNo) break;
      var list = m[d] || []; var shown = list.slice(0, 4);
      var cls = 'd' + (d.slice(5, 7) !== monthNo ? ' out' : '') + (d === t ? ' today' : '') + (d < t ? ' past' : '') + (slot && slot.wd && WD[dowOf(d)] === slot.wd && d >= t ? ' best' : '');
      html += '<div class="' + cls + '" data-w121day="' + d + '"' + (slot && slot.wd && WD[dowOf(d)] === slot.wd ? ' title="Best day to post, from the insights"' : '') + '><div class="dh"><span class="dn">' + Number(d.slice(8, 10)) + '</span>' + (staff() && d >= t ? '<button class="add" data-w121new="' + d + '" title="New post on this day">+</button>' : '') + '</div>' + shown.map(chip).join('') + (list.length > shown.length ? '<div class="more" data-w121more="' + d + '">+' + (list.length - shown.length) + ' more</div>' : '') + '</div>';
    }
    return html + '</div>';
  }
  function weekCard(p) {
    var s = stateOf(p); var th = thumbOf(p);
    return '<div class="wk st-' + s.cls + '" data-w121open="' + p.id + '" draggable="' + (draggable(p) ? 'true' : 'false') + '" data-w121card="' + p.id + '">' + (th ? '<img src="' + E(th) + '" alt="" loading="lazy">' : '') + '<div class="row"><span class="tm">' + hm(p.scheduled_at) + '</span>' + marks(p.platforms, s.live) + '<span style="flex:1"></span><span class="pill ' + s.cls + '">' + E(s.label) + '</span></div><b>' + E(titleOf(p)) + '</b>' + (p.caption ? '<div class="cap2">' + E(p.caption) + '</div>' : '') + confLine(p, s) + '</div>';
  }
  function confLine(p, s) {
    s = s || stateOf(p);
    var bits = Object.keys(s.live).map(function (k) { var l = s.live[k]; var n = []; if (l.reach != null) n.push(num(l.reach) + ' reach'); else if (l.views != null) n.push(num(l.views) + ' views'); if (l.likes != null) n.push(num(l.likes) + ' likes'); return (PL[k] ? PL[k].label : k) + (n.length ? ' ' + n.join(', ') : ' live'); });
    if (bits.length) return '<div class="cf ok">\u2713 ' + E(bits.join(' \u00b7 ')) + '</div>';
    if (s.note) return '<div class="cf ' + (s.attn ? 'bad' : s.cls === 'sched' ? 'warn' : 'muted') + '">' + E(s.note) + '</div>';
    return '';
  }
  function weekView() {
    var mon = mondayOf(C.anchor); var m = byDay(); var t = today();
    var html = '<div class="wg">';
    for (var i = 0; i < 7; i++) {
      var d = addDays(mon, i); var list = m[d] || [];
      html += '<div class="wc' + (d === t ? ' today' : '') + '" data-w121day="' + d + '"><div class="wh"><b>' + WD[i] + ' ' + Number(d.slice(8, 10)) + '</b><span>' + list.length + ' post' + (list.length === 1 ? '' : 's') + '</span>' + (staff() && d >= t ? '<button class="add" data-w121new="' + d + '" title="New post on this day">+</button>' : '') + '</div>' + list.map(weekCard).join('') + '</div>';
    }
    return html + '</div>';
  }
  function listRow(p) {
    var s = stateOf(p); var th = thumbOf(p);
    return '<div class="lr" data-w121open="' + p.id + '"><div class="when">' + (p.scheduled_at ? E(niceDate(dayOf(p.scheduled_at))) + '<span>' + hm(p.scheduled_at) + '</span>' : 'No date<span>' + (p.idea_for ? 'for ' + E(shortDay(p.idea_for)) : 'idea') + '</span>') + '</div>' + (th ? '<img src="' + E(th) + '" alt="" loading="lazy">' : '<div class="ph">' + (hasVideo(p) ? '\u25b6' : '\u270e') + '</div>') + '<div style="min-width:0"><b>' + E(titleOf(p)) + '</b><div class="cap2">' + E(p.caption || p.notes || '') + '</div>' + (function () { var il = p.scheduled_at ? '' : ideaLine(p); return il ? '<div class="src">' + il + '</div>' : ''; })() + confLine(p, s) + '</div><div class="rt"><span class="pill ' + s.cls + '">' + E(s.label) + '</span>' + marks(p.platforms, s.live) + (p.owner ? '<span style="font-size:11px;color:var(--wa-muted)">' + E(p.owner) + '</span>' : '') + '</div></div>';
  }
  function listView() {
    var all = C.posts.filter(function (p) { return p.status !== 'cancelled' && matches(p); }); var now = Date.now();
    var attn = all.filter(function (p) { return stateOf(p).attn; });
    var up = all.filter(function (p) { return p.scheduled_at && new Date(p.scheduled_at).getTime() >= now - 15 * 60000 && !stateOf(p).attn && ['draft', 'scheduled', 'publishing'].indexOf(p.status) >= 0; }).sort(function (a, b) { return String(a.scheduled_at).localeCompare(String(b.scheduled_at)); });
    var ideas = all.filter(function (p) { return !p.scheduled_at && !stateOf(p).attn; });
    var past = all.filter(function (p) { return attn.indexOf(p) < 0 && up.indexOf(p) < 0 && ideas.indexOf(p) < 0; }).sort(function (a, b) { return String(b.published_at || b.scheduled_at || '').localeCompare(String(a.published_at || a.scheduled_at || '')); });
    function grp(title, sub, rows) { if (!rows.length) return ''; return '<h4>' + E(title) + ' <small>' + E(sub) + '</small></h4>' + rows.map(listRow).join(''); }
    var html = '<div class="lg">' + grp('Needs attention', attn.length + ' post' + (attn.length === 1 ? '' : 's'), attn) + grp('Coming up', up.length + ' planned', up) + grp('Ideas and drafts without a date', ideas.length + '', ideas) + grp('Posted', past.length + ' in the calendar', past.slice(0, 80)) + '</div>';
    if (!all.length) html = '<div class="loading">' + (C.filter.q || C.filter.pl || C.filter.st ? 'Nothing matches the filters.' : 'Nothing planned yet. ' + (staff() ? 'Start with New post, or plan one from the insights on the Analytics page.' : '')) + '</div>';
    return html;
  }
  function tray() {
    var list = undated();
    return '<div class="tray" data-w121tray="1"><h4>Ideas</h4><p>Posts without a date. Drag one onto a day to plan it; drag a planned post here to take it off the calendar. Ideas from marketing meetings land here too.</p>' + (list.length ? list.map(function (p) { var th = thumbOf(p); return '<div class="tr" draggable="' + (draggable(p) ? 'true' : 'false') + '" data-w121card="' + p.id + '" data-w121open="' + p.id + '">' + (th ? '<img src="' + E(th) + '" alt="">' : '') + '<div style="min-width:0"><b>' + E(titleOf(p)) + '</b><span>' + (p.campaign ? E(p.campaign) + ' \u00b7 ' : '') + (p.platforms || []).map(function (k) { return PL[k] ? PL[k].label : k; }).join(', ') + '</span>' + (function () { var il = ideaLine(p); return il ? '<em>' + il + '</em>' : ''; })() + '</div></div>'; }).join('') : '<div class="empty">No ideas waiting.</div>') + (staff() ? '<button class="btn mini ghost" style="width:100%;margin-top:6px" data-w121new="idea">New idea</button>' : '') + (C.banked && C.banked.length ? '<a class="bnk" href="#bank/marketing">' + C.banked.length + (C.banked.length === 1 ? ' idea waits' : ' ideas wait') + ' in the bank</a>' : '') + '</div>';
  }
  function paint() {
    var sec = panel(); if (!sec) return;
    if (!C.view) C.view = (window.innerWidth || 1200) < 700 ? 'list' : 'month';
    if (!C.anchor) C.anchor = today();
    var body;
    if (C.err) body = '<div class="loading">Could not load the calendar: ' + E(C.err) + '</div>';
    else if (!C.loaded) body = '<div class="loading">Loading the calendar\u2026</div>';
    else body = capBanner() + settingsPanel() + glance() + '<div class="lay' + (C.view === 'list' ? ' list' : '') + '"><div>' + (C.view === 'month' ? monthView() : C.view === 'week' ? weekView() : listView()) + '</div>' + (C.view !== 'list' ? tray() : '') + '</div>';
    var q = document.getElementById('w121q'); var hadFocus = q && document.activeElement === q; var pos = hadFocus ? q.selectionStart : 0;
    sec.innerHTML = '<div class="w121wrap">' + header() + body + '</div>' + (C.undo ? '<div class="undo"><span>' + E(C.undo.text) + '</span><a data-w121undo="1">Undo</a></div>' : '');
    if (hadFocus) { var q2 = document.getElementById('w121q'); if (q2) { q2.focus(); try { q2.setSelectionRange(pos, pos); } catch (e) { /* fine */ } } }
  }

  /* ---------- moves (drag and drop), with Undo ---------- */
  async function move(id, day) {
    var p = C.posts.filter(function (x) { return String(x.id) === String(id); })[0]; if (!p || !draggable(p)) return;
    var before = { scheduled_at: p.scheduled_at, status: p.status };
    var patch;
    if (!day) patch = { scheduled_at: null, status: 'draft' };
    else {
      var t = p.scheduled_at ? hm(p.scheduled_at) : (function () { var s = bestSlot(); return s && s.h != null ? String(s.h).padStart(2, '0') + ':00' : '18:00'; })();
      patch = { scheduled_at: isoOf(day, t) };
      if (p.status === 'failed') patch.status = 'scheduled';
      if (dayOf(p.scheduled_at) === day) return;
    }
    try {
      await saveRow(p.id, patch);
      logIt(p.id, 'scheduled_at', before.scheduled_at, patch.scheduled_at);
      C.undo = { id: p.id, patch: before, text: day ? 'Moved to ' + niceDate(day) + ', ' + hm(patch.scheduled_at) : 'Taken off the calendar' };
      clearTimeout(C.undoT); C.undoT = setTimeout(function () { C.undo = null; paint(); }, 7000);
      paint();
    } catch (e) { toastS('Could not move it: ' + (e.message || e)); }
  }
  document.addEventListener('dragstart', function (e) {
    var t = e.target; if (!t || !t.closest) return;
    var c = t.closest('#contentcal [data-w121card]'); if (!c || c.getAttribute('draggable') !== 'true') return;
    C.drag = c.getAttribute('data-w121card'); c.classList.add('dragging');
    try { e.dataTransfer.effectAllowed = 'move'; e.dataTransfer.setData('text/plain', 'w121:' + C.drag); } catch (e2) { /* fine */ }
  });
  document.addEventListener('dragend', function () { C.drag = null; document.querySelectorAll('#contentcal .dragging').forEach(function (x) { x.classList.remove('dragging'); }); document.querySelectorAll('#contentcal .over').forEach(function (x) { x.classList.remove('over'); }); });
  document.addEventListener('dragover', function (e) {
    if (!C.drag) return; var t = e.target; if (!t || !t.closest) return;
    var z = t.closest('#contentcal [data-w121day]') || t.closest('#contentcal [data-w121tray]'); if (!z) return;
    e.preventDefault(); document.querySelectorAll('#contentcal .over').forEach(function (x) { if (x !== z) x.classList.remove('over'); }); z.classList.add('over');
  });
  document.addEventListener('drop', async function (e) {
    if (!C.drag) return; var t = e.target; if (!t || !t.closest) return;
    var z = t.closest('#contentcal [data-w121day]') || t.closest('#contentcal [data-w121tray]'); if (!z) return;
    e.preventDefault(); e.stopPropagation(); var id = C.drag; C.drag = null; z.classList.remove('over');
    var day = z.getAttribute('data-w121day'); if (day && day < today()) { toastS('That day has passed; pick today or later'); return; }
    await move(id, day || null);
  }, true);

  /* ---------- the composer ---------- */
  function blank(day) {
    var slot = bestSlot(); var ns = day && day !== '1' && day !== 'idea' ? { date: day, time: slot && slot.h != null ? String(slot.h).padStart(2, '0') + ':00' : '18:00' } : (day === 'idea' ? { date: '', time: '' } : nextSlotDate(slot));
    return { id: null, title: '', platforms: ['instagram', 'facebook'], caption: '', link_url: '', media: [], date: ns.date, time: ns.time, owner: me(), campaign: '', notes: '', status: 'draft', results: {}, live: {}, error: null, dirty: false, tab: 'instagram', ai: null, aiBusy: false, lang: 'en', manual: false };
  }
  function fromPost(p) {
    return { id: p.id, title: p.title || '', platforms: (p.platforms || []).slice(), caption: p.caption || '', link_url: p.link_url || '', media: (p.media || []).map(function (m) { return Object.assign({}, m); }), date: p.scheduled_at ? dayOf(p.scheduled_at) : '', time: p.scheduled_at ? hm(p.scheduled_at) : '', owner: p.owner || '', campaign: p.campaign || '', notes: p.notes || '', status: p.status || 'draft', results: p.results || {}, live: p.live || {}, error: p.error || null, published_at: p.published_at || null, dirty: false, tab: (p.platforms || [])[0] || 'instagram', ai: null, aiBusy: false, lang: 'en', manual: false };
  }
  function openComposer(pOrDay, prefill) {
    if (!allowed()) return;
    var p = pOrDay && typeof pOrDay === 'object' ? pOrDay : null;
    C.edit = p ? fromPost(p) : blank(pOrDay);
    if (prefill) { if (prefill.title) C.edit.title = prefill.title; if (prefill.notes) C.edit.notes = prefill.notes; if (prefill.campaign) C.edit.campaign = prefill.campaign; if (prefill.slot) { var ns = nextSlotDate(prefill.slot); C.edit.date = ns.date; C.edit.time = ns.time; } C.edit.dirty = true; }
    paintDrawer();
    if (!C.cap && staff() && !C.capBusy) loadCap();
    if (!C.perf && !C.perfBusy) loadPerf();
    setTimeout(function () { var t = document.getElementById(C.edit && C.edit.id ? 'w121cap' : 'w121title'); if (t && staff() && !readOnly()) t.focus(); }, 60);
  }
  function readOnly() { var e = C.edit; if (!e) return true; if (!staff()) return true; return ['publishing', 'published', 'posted'].indexOf(e.status) >= 0; }
  function closeComposer(force) {
    if (!C.edit) return;
    if (!force && C.edit.dirty && !readOnly() && !confirm('Close without saving the changes?')) return;
    C.edit = null; var d = document.getElementById('w121dr'); if (d) d.remove();
    try { if (/^#contentcal\/./.test(location.hash)) history.replaceState(null, '', '#contentcal'); } catch (e) { /* fine */ }
  }
  function imgs(e) { return (e.media || []).filter(function (m) { return String(m.kind || m.mime || '').indexOf('video') < 0; }); }
  function vids(e) { return (e.media || []).filter(function (m) { return String(m.kind || m.mime || '').indexOf('video') >= 0; }); }
  function ratioOf(m) { return m && m.w && m.h ? m.w / m.h : null; }
  function ratioLabel(r) { if (!r) return ''; var known = [[1, '1:1'], [0.8, '4:5'], [1.91, '1.91:1'], [0.5625, '9:16'], [1.7778, '16:9'], [0.6667, '2:3'], [1.5, '3:2'], [0.75, '3:4'], [1.3333, '4:3']]; for (var i = 0; i < known.length; i++) if (Math.abs(known[i][0] - r) < 0.02) return known[i][1]; return r.toFixed(2) + ':1'; }
  function igRatioOk(r) { return r != null && r >= 0.795 && r <= 1.915; }
  function tagsOf(s) { return (String(s || '').match(/#[\w\u00c0-\u024f]+/g) || []); }
  function validate(e) {
    var out = { ig: [], fb: [], all: [], errors: 0 };
    function err(list, t) { list.push({ t: t, k: 'e' }); out.errors++; } function warn(list, t) { list.push({ t: t, k: 'w' }); } function ok(list, t) { list.push({ t: t, k: 'k' }); }
    var im = imgs(e), vi = vids(e);
    if (!e.platforms.length) err(out.all, 'Pick Instagram, Facebook or both.');
    if ((e.media || []).some(function (m) { return m.uploading; })) err(out.all, 'Wait for the uploads to finish.');
    if (e.platforms.indexOf('instagram') >= 0) {
      if (!im.length && !vi.length) err(out.ig, 'Instagram needs a photo or a video.');
