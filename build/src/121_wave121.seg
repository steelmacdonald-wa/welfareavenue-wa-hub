    if (ro) return '<footer>' + (e.id ? '<button class="lnk" data-w121dup="1">Duplicate</button>' : '') + '<span class="sp"></span>' + (e.status === 'posted' || e.status === 'published' ? '<button class="lnk" data-w121reopen="1" title="Back to a draft (does not remove the post from Instagram or Facebook)">Back to draft</button>' : '') + '<button class="btn mini ghost" data-w121close="1">Close</button></footer>';
