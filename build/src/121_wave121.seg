/* =====================================================================
   WA v121 Marketing: the content calendar (25/09/26)
   =====================================================================
   Steel: "The marketing department should have a content calendar module
   that is capable of posting content to Instagram and Facebook using the
   Meta Business Suite APIs. Only if we are given enough functionality to
   upload posts; if not, keep it to a highly functional content calendar
   with confirmations of posts going up on social media based on the
   connections we are getting."
   - Month, week and list views; drag a post to another day (the time
     stays), drag an undated idea onto a day, drag back to the tray to
     unschedule; Undo on every move. Filters by platform and state,
     search, the week at a glance, what needs attention.
   - The composer (a side panel): Instagram and Facebook, photos (turned
     into JPEG, checked against Instagram's 4:5 to 1.91:1, one-click crop),
     a video for a reel, caption counts (2,200 characters, 30 hashtags),
     AI help (write, shorten, hashtags; English, French or both), link,
     date and time with the best slot from the insights, owner, campaign,
     notes, live Instagram and Facebook previews.
   - Publishing follows the connection (social-publish capabilities):
     when the Meta token carries pages_manage_posts and
     instagram_content_publish, Publish now and Schedule to publish send
     the post (a cron every 5 minutes); when it does not, the calendar
     plans, reminds when a post is due, and confirms it anyway: every
     morning's analytics pull matches what went up (by id, link or
     caption) and the post shows Live with its reach and likes.
   - Optional Slack confirmations to a channel (Settings on the page).
   Data: content_posts (wa121), social-publish v2, social-pull v1.2.
   ===================================================================== */
(function () {
  if (window.__wa121) return; window.__wa121 = true;
  var GREEN = '#103F39', CREAM = '#FFFAF2', GOLD = '#DCA527', FLAG = '#B3402F', TEAL = '#2A8C7A', PURPLE = '#6F64AB';
  var BODY = "'Space Grotesk','Helvetica Neue',Arial,sans-serif";
  var HEAD = "'Barlow Condensed','Arial Narrow','Helvetica Neue',Arial,sans-serif";
  var PL = { instagram: { label: 'Instagram', short: 'IG', color: '#C13584' }, facebook: { label: 'Facebook', short: 'f', color: '#1877F2' } };
  var ST = {
    draft: { label: 'Draft', cls: 'draft' }, scheduled: { label: 'Scheduled', cls: 'sched' }, publishing: { label: 'Publishing', cls: 'pub' },
    published: { label: 'Published', cls: 'live' }, posted: { label: 'Posted', cls: 'live' }, failed: { label: 'Failed', cls: 'bad' }, cancelled: { label: 'Cancelled', cls: 'draft' }
  };
  var WD = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
  var C = { view: null, anchor: null, posts: [], loaded: false, loading: false, at: 0, cap: null, capBusy: false, filter: { pl: '', st: '', q: '' }, drag: null, edit: null, perf: null, perfBusy: false, undo: null, settingsOpen: false, channels: null, err: null };

  var css = document.createElement('style'); css.id = 'wa121css';
  css.textContent = '' +
    '#contentcal{font-family:' + BODY + ';}' +
    '#contentcal .w121wrap{max-width:1240px;}' +
    '#contentcal .ctl{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin:0 0 12px;}' +
    '#contentcal .ctl .nav{display:inline-flex;align-items:center;gap:4px;}' +
    '#contentcal .ctl .nav b{font-family:' + HEAD + ';font-size:24px;color:' + GREEN + ';min-width:170px;text-align:center;letter-spacing:.3px;}' +
    '#contentcal .ctl .nav button{width:32px;height:32px;border-radius:10px;border:1px solid rgba(16,63,57,.15);background:#FFFAF2;color:' + GREEN + ';font-size:16px;cursor:pointer;}' +
    '#contentcal .ctl .sp{flex:1;}' +
    '#contentcal .ctl input[type=search]{padding:8px 13px;border:1px solid rgba(16,63,57,.2);border-radius:999px;font-size:12.5px;font-family:' + BODY + ';min-width:180px;}' +
    '#contentcal .chips{display:flex;gap:6px;flex-wrap:wrap;margin:0 0 12px;align-items:center;}' +
    '#contentcal .chips span{font-size:12px;font-weight:700;border-radius:999px;padding:5px 12px;background:rgba(16,63,57,.07);color:' + GREEN + ';cursor:pointer;user-select:none;}' +
    '#contentcal .chips span.on{background:' + GREEN + ';color:' + CREAM + ';}' +
    '#contentcal .chips i{width:1px;height:18px;background:rgba(16,63,57,.15);margin:0 4px;}' +
    '#contentcal .cap{display:flex;gap:12px;align-items:flex-start;border-radius:16px;padding:12px 16px;margin:0 0 14px;font-size:13px;line-height:1.5;background:rgba(220,165,39,.12);color:#5a430c;}' +
    '#contentcal .cap.on{background:rgba(42,140,122,.12);color:#155a4d;}' +
    '#contentcal .cap b{display:block;font-size:13.5px;}' +
    '#contentcal .cap a{color:inherit;font-weight:700;cursor:pointer;text-decoration:underline;}' +
    '#contentcal .glance{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:10px;margin:0 0 14px;}' +
    '#contentcal .glance div{background:#FFFAF2;border:1px solid rgba(16,63,57,.10);border-radius:14px;padding:10px 14px;box-shadow:0 10px 22px -20px rgba(16,63,57,.6);cursor:default;}' +
    '#contentcal .glance div[data-w121jump]{cursor:pointer;}' +
    '#contentcal .glance b{display:block;font-family:' + HEAD + ';font-size:26px;line-height:1;color:' + GREEN + ';}' +
    '#contentcal .glance b.warn{color:' + FLAG + ';}' +
    '#contentcal .glance span{display:block;font-size:11px;color:var(--wa-muted);letter-spacing:.4px;text-transform:uppercase;font-weight:700;margin-top:4px;}' +
    '#contentcal .glance em{display:block;font-style:normal;font-size:12px;color:var(--wa-text);margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}' +
    '#contentcal .lay{display:grid;grid-template-columns:minmax(0,1fr) 250px;gap:14px;align-items:start;}' +
    '#contentcal .lay.list{grid-template-columns:minmax(0,1fr);}' +
    /* month */
    '#contentcal .mg{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:5px;}' +
    '#contentcal .mg .dow{font-size:10.5px;letter-spacing:.8px;text-transform:uppercase;color:var(--wa-muted);font-weight:800;text-align:center;padding:2px 0 3px;}' +
    '#contentcal .d{min-height:104px;border-radius:12px;background:#FFFAF2;border:1px solid rgba(16,63,57,.08);padding:5px 5px 6px;position:relative;transition:background .12s,box-shadow .12s;}' +
    '#contentcal .d.out{background:rgba(16,63,57,.025);border-color:transparent;}#contentcal .d.out .dn{opacity:.4;}' +
    '#contentcal .d.past{background:rgba(16,63,57,.02);}' +
    '#contentcal .d.today{box-shadow:inset 0 0 0 2px ' + GOLD + ';}' +
    '#contentcal .d.best:after{content:"";position:absolute;right:6px;top:8px;width:6px;height:6px;border-radius:50%;background:' + GOLD + ';}' +
    '#contentcal .d.over,#contentcal .wc.over,#contentcal .tray.over{background:rgba(220,165,39,.16);box-shadow:inset 0 0 0 2px ' + GOLD + ';}' +
    '#contentcal .dh{display:flex;align-items:center;gap:4px;margin:0 0 4px;padding:0 2px;}' +
    '#contentcal .dn{font-size:12px;font-weight:700;color:var(--wa-text);}' +
    '#contentcal .d .add,#contentcal .wc .add{margin-left:auto;width:20px;height:20px;border-radius:50%;border:none;background:rgba(16,63,57,.08);color:' + GREEN + ';font-size:14px;line-height:1;cursor:pointer;opacity:0;transition:opacity .12s;}' +
    '#contentcal .d:hover .add,#contentcal .wc:hover .add{opacity:1;}' +
    '#contentcal .d .more{font-size:10.5px;color:var(--wa-muted);padding:1px 4px;cursor:pointer;}' +
    /* chips on the grid */
    '#contentcal .ch{display:flex;align-items:center;gap:4px;border-radius:8px;padding:3px 5px;margin:0 0 3px;font-size:11px;line-height:1.25;cursor:pointer;background:rgba(16,63,57,.06);color:var(--wa-text);border-left:3px solid rgba(16,63,57,.25);overflow:hidden;}' +
    '#contentcal .ch[draggable=true]{cursor:grab;}' +
    '#contentcal .ch.dragging,#contentcal .wk.dragging,#contentcal .tr.dragging{opacity:.4;}' +
    '#contentcal .ch .tm{font-weight:800;color:' + GREEN + ';flex:none;}' +
    '#contentcal .ch .tt{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0;flex:1;}' +
    '#contentcal .ch img,#contentcal .wk img,#contentcal .tr img,#contentcal .lr img{object-fit:cover;flex:none;background:rgba(16,63,57,.08);}' +
    '#contentcal .ch img{width:18px;height:18px;border-radius:4px;}' +
    '#contentcal .pm{display:inline-flex;gap:2px;flex:none;}' +
    '#contentcal .pm i{display:inline-flex;align-items:center;justify-content:center;width:14px;height:14px;border-radius:4px;font-style:normal;font-family:' + HEAD + ';font-size:8.5px;font-weight:800;color:#FFFAF2;}' +
    '#contentcal .pm i.ok{box-shadow:0 0 0 1.5px #FFFAF2,0 0 0 3px ' + TEAL + ';}' +
    '#contentcal .st-draft{border-left-color:rgba(16,63,57,.3);}#contentcal .st-draft .tt{color:var(--wa-muted);}' +
    '#contentcal .st-sched{border-left-color:' + GOLD + ';background:rgba(220,165,39,.12);}' +
    '#contentcal .st-pub{border-left-color:' + PURPLE + ';background:rgba(111,100,171,.12);}' +
    '#contentcal .st-live{border-left-color:' + TEAL + ';background:rgba(42,140,122,.12);}' +
    '#contentcal .st-bad,#contentcal .st-due{border-left-color:' + FLAG + ';background:rgba(179,64,47,.10);}' +
    /* week */
    '#contentcal .wg{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:6px;}' +
    '#contentcal .wc{background:#FFFAF2;border:1px solid rgba(16,63,57,.08);border-radius:14px;padding:8px;min-height:360px;}' +
    '#contentcal .wc.today{box-shadow:inset 0 0 0 2px ' + GOLD + ';}' +
    '#contentcal .wc .wh{display:flex;align-items:center;gap:6px;margin:0 0 8px;}' +
    '#contentcal .wc .wh b{font-family:' + HEAD + ';font-size:16px;color:' + GREEN + ';}' +
    '#contentcal .wc .wh span{font-size:11px;color:var(--wa-muted);}' +
    '#contentcal .wk{border-radius:12px;padding:8px;margin:0 0 6px;background:rgba(16,63,57,.05);border-left:3px solid rgba(16,63,57,.25);cursor:pointer;font-size:12px;}' +
    '#contentcal .wk[draggable=true]{cursor:grab;}' +
    '#contentcal .wk img{width:100%;height:84px;border-radius:8px;margin:0 0 6px;display:block;}' +
    '#contentcal .wk .row{display:flex;align-items:center;gap:5px;}' +
    '#contentcal .wk .tm{font-weight:800;color:' + GREEN + ';}' +
    '#contentcal .wk b{display:block;font-size:12.5px;line-height:1.3;margin:4px 0 2px;color:var(--wa-text);}' +
    '#contentcal .wk .cap2{font-size:11.5px;color:var(--wa-muted);line-height:1.35;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;}' +
    '#contentcal .wk .cf,#contentcal .lr .cf{font-size:10.5px;margin-top:5px;font-weight:700;}' +
    '#contentcal .cf.ok{color:#1c6b5d;}#contentcal .cf.warn{color:#8a5a00;}#contentcal .cf.bad{color:' + FLAG + ';}#contentcal .cf.muted{color:var(--wa-muted);font-weight:500;}' +
    /* tray */
    '#contentcal .tray{background:#FFFAF2;border:1px solid rgba(16,63,57,.10);border-radius:16px;padding:12px;position:sticky;top:12px;min-height:160px;transition:background .12s;}' +
    '#contentcal .tray h4{font-family:' + HEAD + ';font-size:18px;margin:0 0 2px;color:' + GREEN + ';}' +
    '#contentcal .tray p{font-size:11.5px;color:var(--wa-muted);margin:0 0 10px;line-height:1.4;}' +
    '#contentcal .tr{display:flex;gap:8px;align-items:center;border-radius:10px;padding:7px 8px;margin:0 0 5px;background:rgba(16,63,57,.05);font-size:12px;cursor:pointer;}' +
    '#contentcal .tr[draggable=true]{cursor:grab;}' +
    '#contentcal .tr img{width:30px;height:30px;border-radius:6px;}' +
    '#contentcal .tr b{display:block;font-size:12px;line-height:1.25;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}' +
    '#contentcal .tr span{display:block;font-size:10.5px;color:var(--wa-muted);}' +
    '#contentcal .tray .empty{font-size:12px;color:var(--wa-muted);text-align:center;padding:16px 6px;border:1px dashed rgba(16,63,57,.2);border-radius:10px;}' +
    /* wave136: ideas from meetings, and the bank */
    '#contentcal .tr em{display:block;font-style:normal;font-size:10.5px;color:' + GREEN + ';opacity:.85;margin-top:1px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}' +
    '#contentcal .tr em i,#contentcal .lr .src i{font-style:normal;background:rgba(220,165,39,.25);color:#6b4d05;border-radius:999px;padding:0 6px;margin-right:4px;}' +
    '#contentcal .tray .bnk{display:block;text-align:center;font-size:11.5px;margin-top:8px;color:' + GREEN + ';font-weight:600;text-decoration:underline;cursor:pointer;}' +
    '#contentcal .lr .src{font-size:11px;color:' + GREEN + ';opacity:.85;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}' +
    '#w121dr .w136src{background:rgba(220,165,39,.12);border:1px solid rgba(220,165,39,.35);border-radius:12px;padding:9px 12px;margin:0 0 12px;font-size:12.5px;line-height:1.45;}' +
    '#w121dr .w136src a{color:' + GREEN + ';font-weight:600;cursor:pointer;}' +
    '#w121dr .w136bank{border:1px solid rgba(16,63,57,.15);border-radius:12px;padding:10px 12px;margin:0 0 12px;background:#FFFAF2;}' +
    '#w121dr .w136bank label{display:block;font-size:12.5px;font-weight:700;margin:0 0 4px;color:' + GREEN + ';}' +
    '#w121dr .w136bank p{font-size:11.5px;color:var(--wa-muted);margin:0 0 8px;line-height:1.4;}' +
    '#w121dr .w136bank .r2{display:grid;grid-template-columns:150px minmax(0,1fr);gap:8px;margin-bottom:8px;}' +
    '#w121dr .w136bank .ac{display:flex;gap:8px;justify-content:flex-end;}' +
    '@media (max-width:520px){#w121dr .w136bank .r2{grid-template-columns:minmax(0,1fr);}}' +
    /* list */
    '#contentcal .lg h4{font-family:' + HEAD + ';font-size:18px;color:' + GREEN + ';margin:14px 0 8px;display:flex;gap:8px;align-items:baseline;}' +
    '#contentcal .lg h4 small{font-family:' + BODY + ';font-size:11.5px;color:var(--wa-muted);font-weight:500;}' +
    '#contentcal .lr{display:grid;grid-template-columns:92px 44px minmax(0,1fr) auto;gap:12px;align-items:center;background:#FFFAF2;border:1px solid rgba(16,63,57,.08);border-radius:14px;padding:9px 12px;margin:0 0 6px;cursor:pointer;}' +
    '#contentcal .lr:hover{border-color:rgba(16,63,57,.25);}' +
    '#contentcal .lr .when{font-size:12px;color:var(--wa-text);font-weight:700;line-height:1.3;}' +
    '#contentcal .lr .when span{display:block;font-weight:500;color:var(--wa-muted);font-size:11px;}' +
    '#contentcal .lr img{width:44px;height:44px;border-radius:9px;}' +
    '#contentcal .lr .ph{width:44px;height:44px;border-radius:9px;background:rgba(16,63,57,.07);display:flex;align-items:center;justify-content:center;font-size:18px;color:rgba(16,63,57,.35);}' +
    '#contentcal .lr b{display:block;font-size:13px;line-height:1.3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}' +
    '#contentcal .lr .cap2{font-size:12px;color:var(--wa-muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}' +
    '#contentcal .lr .rt{display:flex;flex-direction:column;align-items:flex-end;gap:4px;}' +
    '#contentcal .pill{display:inline-block;font-size:10px;letter-spacing:.6px;text-transform:uppercase;font-weight:800;border-radius:999px;padding:2px 8px;white-space:nowrap;}' +
    '#contentcal .pill.draft,#w121dr .pill.draft{background:rgba(16,63,57,.08);color:var(--wa-muted);}' +
    '#contentcal .pill.sched,#w121dr .pill.sched{background:rgba(220,165,39,.22);color:#6b4d05;}' +
    '#contentcal .pill.pub,#w121dr .pill.pub{background:rgba(111,100,171,.18);color:' + PURPLE + ';}' +
    '#contentcal .pill.live,#w121dr .pill.live{background:rgba(42,140,122,.16);color:#1c6b5d;}' +
    '#contentcal .pill.bad,#contentcal .pill.due,#w121dr .pill.bad,#w121dr .pill.due{background:rgba(179,64,47,.12);color:' + FLAG + ';}' +
    '#contentcal .undo{position:fixed;left:50%;bottom:24px;transform:translateX(-50%);background:' + GREEN + ';color:' + CREAM + ';border-radius:999px;padding:10px 18px;font-size:13px;box-shadow:0 12px 30px -10px rgba(0,0,0,.4);z-index:60;display:flex;gap:14px;align-items:center;}' +
    '#contentcal .undo a{color:' + GOLD + ';font-weight:800;cursor:pointer;}' +
    '#contentcal .setp{background:#FFFAF2;border:1px solid rgba(16,63,57,.12);border-radius:14px;padding:12px 14px;margin:0 0 14px;font-size:12.5px;display:flex;gap:10px;align-items:center;flex-wrap:wrap;}' +
    '#contentcal .setp select{padding:6px 10px;border:1px solid rgba(16,63,57,.2);border-radius:10px;font-size:12.5px;font-family:' + BODY + ';}' +
    '#contentcal .loading{font-size:13px;color:var(--wa-muted);padding:40px 0;text-align:center;}' +
    /* the composer */
    '#w121dr{position:fixed;inset:0;z-index:80;display:flex;justify-content:flex-end;font-family:' + BODY + ';}' +
    '#w121dr .bk{position:absolute;inset:0;background:rgba(16,32,30,.38);}' +
    '#w121dr .pn{position:relative;width:min(620px,100vw);height:100%;background:' + CREAM + ';box-shadow:-20px 0 50px -20px rgba(0,0,0,.35);display:flex;flex-direction:column;animation:w121in .18s ease-out;}' +
    '@keyframes w121in{from{transform:translateX(24px);opacity:.6;}to{transform:none;opacity:1;}}' +
    '#w121dr header{display:flex;align-items:center;gap:10px;padding:16px 20px 12px;border-bottom:1px solid rgba(16,63,57,.10);}' +
    '#w121dr header .ttl{flex:1;min-width:0;font-family:' + HEAD + ';font-size:24px;color:' + GREEN + ';border:none;background:transparent;padding:2px 0;outline:none;}' +
    '#w121dr header .ttl::placeholder{color:rgba(16,63,57,.35);}' +
    '#w121dr header .x{width:32px;height:32px;border-radius:50%;border:none;background:rgba(16,63,57,.07);color:' + GREEN + ';font-size:16px;cursor:pointer;flex:none;}' +
    '#w121dr .bd{flex:1;overflow:auto;padding:14px 20px 20px;}' +
    '#w121dr .sec{margin:0 0 16px;}' +
    '#w121dr .sec > label,#w121dr .lbl{display:block;font-size:11px;letter-spacing:1px;text-transform:uppercase;color:var(--wa-muted);font-weight:800;margin:0 0 6px;}' +
    '#w121dr .pls{display:flex;gap:8px;flex-wrap:wrap;}' +
    '#w121dr .tg{display:inline-flex;align-items:center;gap:8px;border-radius:12px;padding:8px 12px;border:1.5px solid rgba(16,63,57,.15);background:#FFFAF2;font-size:13px;font-weight:700;color:var(--wa-muted);cursor:pointer;user-select:none;}' +
    '#w121dr .tg i{display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;border-radius:7px;font-style:normal;font-family:' + HEAD + ';font-size:11px;font-weight:800;color:#FFFAF2;opacity:.45;}' +
    '#w121dr .tg.on{border-color:' + GREEN + ';color:' + GREEN + ';}#w121dr .tg.on i{opacity:1;}' +
    '#w121dr .val{font-size:12px;line-height:1.45;margin:8px 0 0;}' +
    '#w121dr .val div{padding:2px 0;}#w121dr .val .e{color:' + FLAG + ';}#w121dr .val .w{color:#8a5a00;}#w121dr .val .k{color:#1c6b5d;}' +
    '#w121dr .drop{border:1.5px dashed rgba(16,63,57,.28);border-radius:14px;padding:16px;text-align:center;font-size:12.5px;color:var(--wa-muted);background:#FFFAF2;transition:background .12s,border-color .12s;}' +
    '#w121dr .drop.over{background:rgba(220,165,39,.12);border-color:' + GOLD + ';}' +
    '#w121dr .drop a{color:' + GREEN + ';font-weight:700;cursor:pointer;text-decoration:underline;}' +
    '#w121dr .thumbs{display:flex;gap:8px;flex-wrap:wrap;margin:10px 0 0;}' +
    '#w121dr .th{position:relative;width:104px;border-radius:12px;overflow:hidden;background:#FFFAF2;border:1px solid rgba(16,63,57,.12);cursor:grab;}' +
    '#w121dr .th.dragging{opacity:.4;}' +
    '#w121dr .th img,#w121dr .th video{width:104px;height:104px;object-fit:cover;display:block;background:rgba(16,63,57,.08);}' +
    '#w121dr .th .rt{position:absolute;left:6px;top:6px;font-size:10px;font-weight:800;border-radius:999px;padding:1px 6px;background:rgba(255,250,242,.92);color:#1c6b5d;}' +
    '#w121dr .th .rt.bad{color:' + FLAG + ';}' +
    '#w121dr .th .rm{position:absolute;right:5px;top:5px;width:20px;height:20px;border-radius:50%;border:none;background:rgba(16,32,30,.65);color:#FFFAF2;font-size:11px;cursor:pointer;line-height:1;}' +
    '#w121dr .th .n1{position:absolute;left:6px;bottom:30px;font-size:9.5px;font-weight:800;border-radius:999px;padding:1px 6px;background:' + GOLD + ';color:' + GREEN + ';}' +
    '#w121dr .th .crop{display:flex;gap:2px;padding:4px;flex-wrap:wrap;background:#FFFAF2;}' +
    '#w121dr .th .crop button{flex:1;font-size:9.5px;font-weight:800;border:none;border-radius:6px;padding:3px 0;background:rgba(16,63,57,.08);color:' + GREEN + ';cursor:pointer;}' +
    '#w121dr .th .up{position:absolute;inset:0;background:rgba(255,250,242,.75);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:' + GREEN + ';}' +
