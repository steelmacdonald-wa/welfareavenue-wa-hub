      '<div class="sec"><label>Photos or a video</label>' + (ro ? '' : '<div class="drop" id="w121drop">Drop photos or a video here, <a data-w121pick="1">choose files</a>, or paste. Photos become JPEGs for Instagram.<input type="file" id="w121file" multiple accept="image/*,video/mp4,video/quicktime" style="display:none"></div>') + '<div class="thumbs" id="w121thumbs">' + e.media.map(thumbHtml).join('') + '</div>' + altHtml(e) + '</div>' +
      '<div class="sec"><label>Caption</label><textarea id="w121cap" placeholder="What is this post about? Start with the line people see first."' + (ro ? ' disabled' : '') + '>' + E(e.caption) + '</textarea><div class="cc"><span><b class="' + (chars > 2200 ? 'bad' : '') + '">' + num(chars) + '</b> / 2,200 characters</span><span><b class="' + (tags > hc ? 'bad' : '') + '">' + tags + '</b> / ' + hc + ' hashtags on Instagram</span><span>' + (chars > 125 ? 'Instagram shows the first 125 before \u201cmore\u201d' : '') + '</span></div>' +
