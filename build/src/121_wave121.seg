      '<div class="sec"><label>Notes for the team</label><textarea id="w121notes" style="min-height:70px" placeholder="Brief, sources, who to tag, the photo credit"' + (ro ? ' disabled' : '') + '>' + E(e.notes) + '</textarea></div>' +
