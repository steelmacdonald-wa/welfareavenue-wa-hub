      (ro ? '' : '<div class="ai"><button data-w121ai="write">Write it with AI</button><button data-w121ai="shorten">Shorten</button><button data-w121ai="hashtags">Hashtags</button><select id="w121lang"><option value="en"' + (e.lang === 'en' ? ' selected' : '') + '>English</option><option value="fr"' + (e.lang === 'fr' ? ' selected' : '') + '>Fran\u00e7ais</option><option value="both"' + (e.lang === 'both' ? ' selected' : '') + '>Both</option></select></div>' + aiHtml) + '</div>' +
