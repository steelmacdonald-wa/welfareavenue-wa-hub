    '#contentcal .cf.ok{color:#1c6b5d;}#contentcal .cf.warn{color:#8a5a00;}#contentcal .cf.bad{color:' + FLAG + ';}#contentcal .cf.muted{color:var(--wa-muted);font-weight:500;}' +
    /* tray */
    '#contentcal .tray{background:#FFFAF2;border:1px solid rgba(16,63,57,.10);border-radius:16px;padding:12px;position:sticky;top:12px;min-height:160px;transition:background .12s;}' +
