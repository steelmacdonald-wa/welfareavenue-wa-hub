    /* month */
    '#contentcal .mg{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:5px;}' +
    '#contentcal .mg .dow{font-size:10.5px;letter-spacing:.8px;text-transform:uppercase;color:var(--wa-muted);font-weight:800;text-align:center;padding:2px 0 3px;}' +
    '#contentcal .d{min-height:104px;border-radius:12px;background:#FFFAF2;border:1px solid rgba(16,63,57,.08);padding:5px 5px 6px;position:relative;transition:background .12s,box-shadow .12s;}' +
    '#contentcal .d.out{background:rgba(16,63,57,.025);border-color:transparent;}#contentcal .d.out .dn{opacity:.4;}' +
    '#contentcal .d.past{background:rgba(16,63,57,.02);}' +
    '#contentcal .d.today{box-shadow:inset 0 0 0 2px ' + GOLD + ';}' +
    '#contentcal .d.best:after{content:"";position:absolute;right:6px;top:8px;width:6px;height:6px;border-radius:50%;background:' + GOLD + ';}' +
    '#contentcal .d.over,#contentcal .wc.over,#contentcal .tray.over{background:rgba(220,165,39,.16);box-shadow:inset 0 0 0 2px ' + GOLD + ';}' +
    '#contentcal .dh{display:flex;align-items:center;gap:4px;margin:0 0 4px;padding:0 2px;}' +
    '#contentcal .dn{font-size:12px;font-weight:700;color:var(--wa-text);}' +
    '#contentcal .d .add,#contentcal .wc .add{margin-left:auto;width:20px;height:20px;border-radius:50%;border:none;background:rgba(16,63,57,.08);color:' + GREEN + ';font-size:14px;line-height:1;cursor:pointer;opacity:0;transition:opacity .12s;}' +
    '#contentcal .d:hover .add,#contentcal .wc:hover .add{opacity:1;}' +
    '#contentcal .d .more{font-size:10.5px;color:var(--wa-muted);padding:1px 4px;cursor:pointer;}' +
    /* chips on the grid */
    '#contentcal .ch{display:flex;align-items:center;gap:4px;border-radius:8px;padding:3px 5px;margin:0 0 3px;font-size:11px;line-height:1.25;cursor:pointer;background:rgba(16,63,57,.06);color:var(--wa-text);border-left:3px solid rgba(16,63,57,.25);overflow:hidden;}' +
    '#contentcal .ch[draggable=true]{cursor:grab;}' +
    '#contentcal .ch.dragging,#contentcal .wk.dragging,#contentcal .tr.dragging{opacity:.4;}' +
    '#contentcal .ch .tm{font-weight:800;color:' + GREEN + ';flex:none;}' +
    '#contentcal .ch .tt{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0;flex:1;}' +
    '#contentcal .ch img,#contentcal .wk img,#contentcal .tr img,#contentcal .lr img{object-fit:cover;flex:none;background:rgba(16,63,57,.08);}' +
    '#contentcal .ch img{width:18px;height:18px;border-radius:4px;}' +
    '#contentcal .pm{display:inline-flex;gap:2px;flex:none;}' +
    '#contentcal .pm i{display:inline-flex;align-items:center;justify-content:center;width:14px;height:14px;border-radius:4px;font-style:normal;font-family:' + HEAD + ';font-size:8.5px;font-weight:800;color:#FFFAF2;}' +
    '#contentcal .pm i.ok{box-shadow:0 0 0 1.5px #FFFAF2,0 0 0 3px ' + TEAL + ';}' +
    '#contentcal .st-draft{border-left-color:rgba(16,63,57,.3);}#contentcal .st-draft .tt{color:var(--wa-muted);}' +
    '#contentcal .st-sched{border-left-color:' + GOLD + ';background:rgba(220,165,39,.12);}' +
    '#contentcal .st-pub{border-left-color:' + PURPLE + ';background:rgba(111,100,171,.12);}' +
    '#contentcal .st-live{border-left-color:' + TEAL + ';background:rgba(42,140,122,.12);}' +
