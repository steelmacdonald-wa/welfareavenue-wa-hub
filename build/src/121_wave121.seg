    '#contentcal .tr em{display:block;font-style:normal;font-size:10.5px;color:' + GREEN + ';opacity:.85;margin-top:1px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}' +
    '#contentcal .tr em i,#contentcal .lr .src i{font-style:normal;background:rgba(220,165,39,.25);color:#6b4d05;border-radius:999px;padding:0 6px;margin-right:4px;}' +
    '#contentcal .tray .bnk{display:block;text-align:center;font-size:11.5px;margin-top:8px;color:' + GREEN + ';font-weight:600;text-decoration:underline;cursor:pointer;}' +
    '#contentcal .lr .src{font-size:11px;color:' + GREEN + ';opacity:.85;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}' +
