  /* AI help through the router (task draft) */
  var CAPTION_SYSTEM = 'You write social media captions for Welfare Avenue, a youth-powered charity in Montreal and Toronto that serves meals every other Sunday and builds community around them. Voice: warm, specific, dignified and plain. Say people we serve, community, neighbours; never beneficiaries, never the homeless, never the less fortunate. No charity boilerplate (making a difference together, in these challenging times). No em dashes. At most two emojis, only when natural. Never invent numbers, names, dates or quotes: use only what the brief gives, and leave a [confirm: ...] placeholder where a fact is needed. Instagram: the first line must hook within 125 characters; put hashtags at the end; links are not clickable, so say link in bio. Facebook: the link can sit in the text. When asked for French, write natural Quebec French; when asked for both, English first, then French after a blank line.';
  async function ai(mode) {
    readForm(); var e = C.edit; if (!e) return;
    var lang = (document.getElementById('w121lang') || {}).value || e.lang || 'en'; e.lang = lang;
    var brief = { mode: mode, language: lang === 'fr' ? 'French' : lang === 'both' ? 'English then French' : 'English', title: e.title, notes: e.notes, current_caption: e.caption, platforms: e.platforms, campaign: e.campaign, link: e.link_url, when: e.date ? niceDate(e.date) + ' ' + e.time : null, media: imgs(e).length ? imgs(e).length + ' photo(s)' : vids(e).length ? 'a video (reel)' : 'none' };
    var ask = mode === 'write' ? 'Write three different caption options from the brief (and the current caption if there is one). Vary the opening line.' : mode === 'shorten' ? 'Shorten the current caption into three tighter options (under 300 characters each), keeping the facts and the ask.' : 'Suggest 8 to 12 relevant hashtags for Montreal or Toronto community, food and volunteering, and one option of the current caption with the best 3 to 6 of them at the end.';
    if (mode !== 'write' && !e.caption.trim()) { toastS('Write or generate a caption first'); return; }
    e.aiBusy = true; e.ai = null; paintDrawer();
    try {
      var r = await db.functions.invoke('llm', { body: { task: 'draft', caller: 'content-calendar', max_tokens: 1400, temperature: 0.7, system: CAPTION_SYSTEM, messages: [{ role: 'user', content: ask + '\n\nBRIEF:\n' + JSON.stringify(brief, null, 1) }], tools: [{ name: 'captions', description: 'Caption options and hashtags.', input_schema: { type: 'object', properties: { options: { type: 'array', items: { type: 'object', properties: { caption: { type: 'string' }, note: { type: 'string', description: 'what this option does differently, a few words' } }, required: ['caption'] } }, hashtags: { type: 'array', items: { type: 'string' } } }, required: ['options'] } }], tool_choice: { type: 'tool', name: 'captions' } } });
      if (r.error) throw r.error;
      var tu = ((r.data && r.data.content) || []).filter(function (c) { return c.type === 'tool_use'; })[0];
      var inp = (tu && tu.input) || {};
      var opts = (inp.options || []).map(function (o) { return { caption: String(o.caption || '').replace(/\u2014/g, ',').trim(), note: String(o.note || '').trim() }; }).filter(function (o) { return o.caption; }).slice(0, 3);
      var tags = (inp.hashtags || []).map(function (h) { h = String(h || '').trim().replace(/\s+/g, ''); return h ? (h.charAt(0) === '#' ? h : '#' + h) : ''; }).filter(Boolean).slice(0, 14);
      if (!opts.length && !tags.length) throw new Error('nothing came back');
      if (C.edit === e) { e.ai = { options: opts, hashtags: tags }; }
    } catch (x) { toastS('AI help failed: ' + (x.message || x)); }
    e.aiBusy = false; if (C.edit === e) paintDrawer();
  }

