    if ((el = t.closest('[data-w121ai]'))) { e.preventDefault(); await ai(el.getAttribute('data-w121ai')); return; }
    if ((el = t.closest('[data-w121aipick]'))) { readForm(); var o = ed.ai && ed.ai.options[Number(el.getAttribute('data-w121aipick'))]; if (o) { ed.caption = o.caption; ed.dirty = true; ed.ai = null; paintDrawer(); } return; }
    if ((el = t.closest('[data-w121tag]'))) { readForm(); var tg = el.getAttribute('data-w121tag'); if (ed.caption.indexOf(tg) < 0) { ed.caption = ed.caption.replace(/\s+$/, '') + (/(#[\w\u00c0-\u024f]+\s*)$/.test(ed.caption.trim()) ? ' ' : '\n\n') + tg; ed.dirty = true; } el.remove(); var ta = document.getElementById('w121cap'); if (ta) ta.value = ed.caption; return; }
    if ((el = t.closest('[data-w121best]'))) { readForm(); var ns = nextSlotDate(bestSlot()); ed.date = ns.date; ed.time = ns.time; ed.dirty = true; paintDrawer(); return; }
    if ((el = t.closest('[data-w121quick]'))) { readForm(); var q = el.getAttribute('data-w121quick'); if (q === 'nodate') { ed.date = ''; ed.time = ''; } else { ed.date = addDays(today(), 1); ed.time = '12:00'; } ed.dirty = true; paintDrawer(); return; }
    if ((el = t.closest('[data-w121save]'))) { e.preventDefault(); await saveEdit(el.getAttribute('data-w121save')); return; }
    if ((el = t.closest('[data-w121man]'))) { e.preventDefault(); readForm(); ed.manual = el.getAttribute('data-w121man') === '1'; paintDrawer(); var bd = document.querySelector('#w121dr .bd'); if (bd && ed.manual) bd.scrollTop = 0; return; }
    if ((el = t.closest('[data-w121mandone]'))) { e.preventDefault(); await markPosted(); return; }
    if ((el = t.closest('[data-w121dup]'))) { e.preventDefault(); readForm(); try { var row = rowFromEdit(ed); row.title = (row.title || titleOf(ed)) + ' (copy)'; row.scheduled_at = null; row.status = 'draft'; var n2 = await insertRow(row); logIt(n2.id, 'created', null, 'copy of #' + ed.id); toastS('Copied to the ideas tray'); closeComposer(true); paint(); } catch (x) { toastS('Could not copy: ' + (x.message || x)); } return; }
    if ((el = t.closest('[data-w121reopen]'))) { e.preventDefault(); if (!confirm('Back to a draft? This does not take it down from Instagram or Facebook.')) return; try { await saveRow(ed.id, { status: 'draft', results: {}, live: {}, published_at: null, error: null }); logIt(ed.id, 'status', ed.status, 'draft'); toastS('Back to a draft'); closeComposer(true); paint(); } catch (x) { toastS('Could not change it: ' + (x.message || x)); } return; }
    if ((el = t.closest('[data-w121del]'))) { e.preventDefault(); if (!confirm('Delete this post from the calendar?')) return; try { var r = await db.from('content_posts').delete().eq('id', ed.id); if (r.error) throw r.error; logIt(ed.id, 'deleted', titleOf(ed), null); C.posts = C.posts.filter(function (x) { return String(x.id) !== String(ed.id); }); toastS('Deleted'); closeComposer(true); paint(); } catch (x) { toastS('Could not delete: ' + (x.message || x)); } return; }
  }, true);
  document.addEventListener('input', function (e) {
    var t = e.target; if (!t) return;
    if (t.id === 'w121q') { C.filter.q = t.value; clearTimeout(C.qT); C.qT = setTimeout(paint, 180); return; }
    if (!C.edit || !t.closest || !t.closest('#w121dr')) return;
    if (C.edit.bank && (t.id === 'w136until' || t.id === 'w136note')) { C.edit.bank[t.id === 'w136until' ? 'until' : 'note'] = t.value; return; } /* wave136 */
    C.edit.dirty = true;
    if (t.id === 'w121cap') { readForm(); var cc = document.querySelector('#w121dr .cc'); if (cc) { var chars = C.edit.caption.length, tags = tagsOf(C.edit.caption).length; cc.innerHTML = '<span><b class="' + (chars > 2200 ? 'bad' : '') + '">' + num(chars) + '</b> / 2,200 characters</span><span><b class="' + (tags > 30 ? 'bad' : '') + '">' + tags + '</b> / 30 hashtags</span><span>' + (chars > 125 ? 'Instagram shows the first 125 before \u201cmore\u201d' : '') + '</span>'; } clearTimeout(C.pvT); C.pvT = setTimeout(function () { if (!C.edit) return; readForm(); var pv = document.querySelector('#w121dr .sec:last-child'); var box = pv ? pv : null; if (box) box.innerHTML = '<label>Preview</label>' + previewHtml(C.edit); var val = document.querySelector('#w121dr .pls + .val, #w121dr .pls'); var sec = document.querySelector('#w121dr [data-w121pl]'); if (sec) { var host = sec.closest('.sec'); var v = validate(C.edit); var old = host.querySelector('.val'); var nv = valHtml(v); if (old) old.outerHTML = nv || '<div class="val"></div>'; else host.insertAdjacentHTML('beforeend', nv); } var f = document.querySelector('#w121dr footer'); if (f) f.outerHTML = footerHtml(C.edit, validate(C.edit), canPublish(C.edit.platforms), readOnly()); }, 350); }
  });
  document.addEventListener('change', function (e) {
    var t = e.target; if (!t || !C.edit || !t.closest || !t.closest('#w121dr')) return;
    if (t.id === 'w121file') { addFiles(t.files); t.value = ''; return; }
    if (t.id === 'w121lang') { C.edit.lang = t.value; return; }
    if (t.id === 'w121date' || t.id === 'w121time' || t.id === 'w121link') { readForm(); C.edit.dirty = true; paintDrawer(); }
  });
  document.addEventListener('keydown', function (e) {
    if (!C.edit) return;
    if (e.key === 'Escape') { e.preventDefault(); closeComposer(false); return; }
    if ((e.ctrlKey || e.metaKey) && e.key === 'Enter' && !readOnly()) { e.preventDefault(); saveEdit('draft'); }
  });
  document.addEventListener('paste', function (e) {
    if (!C.edit || readOnly()) return; var t = e.target; if (!t || !t.closest || !t.closest('#w121dr')) return;
    var items = (e.clipboardData && e.clipboardData.files) || []; if (!items.length) return;
    e.preventDefault(); addFiles(items);
  });
  /* dropping files on the composer, and reordering the thumbnails */
  var mdrag = null;
  document.addEventListener('dragstart', function (e) { var th = e.target && e.target.closest && e.target.closest('#w121dr [data-w121mi]'); if (!th || th.getAttribute('draggable') !== 'true') return; mdrag = Number(th.getAttribute('data-w121mi')); th.classList.add('dragging'); try { e.dataTransfer.effectAllowed = 'move'; e.dataTransfer.setData('text/plain', 'w121m'); } catch (x) { /* fine */ } });
  document.addEventListener('dragover', function (e) {
    var t = e.target; if (!t || !t.closest || !t.closest('#w121dr')) return;
    if (mdrag != null) { if (t.closest('[data-w121mi]')) e.preventDefault(); return; }
    var types = (e.dataTransfer && e.dataTransfer.types) || []; if (Array.prototype.indexOf.call(types, 'Files') < 0) return;
    e.preventDefault(); var d = document.getElementById('w121drop'); if (d) d.classList.add('over');
  });
  document.addEventListener('dragleave', function (e) { var d = document.getElementById('w121drop'); if (d && e.target === d) d.classList.remove('over'); });
  document.addEventListener('drop', function (e) {
    var t = e.target; if (!t || !t.closest || !t.closest('#w121dr') || !C.edit) return;
    var d = document.getElementById('w121drop'); if (d) d.classList.remove('over');
    if (mdrag != null) { var tgt = t.closest('[data-w121mi]'); var from = mdrag; mdrag = null; if (!tgt) return; e.preventDefault(); var to = Number(tgt.getAttribute('data-w121mi')); if (from === to) return; readForm(); var m = C.edit.media.splice(from, 1)[0]; C.edit.media.splice(to, 0, m); C.edit.dirty = true; paintDrawer(); return; }
    if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length) { e.preventDefault(); readForm(); addFiles(e.dataTransfer.files); }
  });
  document.addEventListener('dragend', function () { mdrag = null; document.querySelectorAll('#w121dr .dragging').forEach(function (x) { x.classList.remove('dragging'); }); });
  window.w121Debug = function () { return { view: C.view, anchor: C.anchor, posts: C.posts.length, loaded: C.loaded, cap: C.cap ? { token: C.cap.token, can: C.cap.can } : null, edit: C.edit ? { id: C.edit.id, status: C.edit.status, platforms: C.edit.platforms, media: C.edit.media.length } : null, best: bestSlot() }; };
})();
