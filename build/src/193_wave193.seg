    + '.w193fit{display:inline-flex;align-items:center;justify-content:center;min-width:34px;height:24px;border-radius:999px;font-size:12px;font-weight:800;padding:0 7px;background:rgba(121,119,115,.14);color:#5c5a56;flex:0 0 auto;}'
    + '.w193fit.go{background:rgba(42,140,122,.18);color:#1d6b5d;}'
