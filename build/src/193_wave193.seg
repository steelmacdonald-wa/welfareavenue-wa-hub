    + '.w193btn.ghost{background:transparent;color:' + GREEN + ' !important;border-color:rgba(16,63,57,.22);}'
    + '.w193btn.ghost:hover{background:rgba(16,63,57,.06);box-shadow:none;}'
    + '.w193btn.orange{background:' + ORANGE + ';border-color:' + ORANGE + ';}'
