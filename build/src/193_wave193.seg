    + '.w193lnk:hover{text-decoration:underline;}'
    + '.w193card{background:var(--wa-card,#FFFAF2);border:1px solid rgba(16,63,57,.07);border-radius:18px;box-shadow:' + SH1 + ';padding:18px 20px;min-width:0;}'
    + '.w193card h3{font-size:12px;font-weight:700;letter-spacing:1.4px;text-transform:uppercase;color:' + GREEN + ';margin:0 0 12px;display:flex;align-items:center;gap:8px;}'
    + '.w193card h3 .sp,.w193bar .sp,.w193row .sp{flex:1 1 auto;}'
    + '.w193card h3 .lnk{font-size:11.5px;letter-spacing:.3px;text-transform:none;font-weight:600;color:var(--wa-muted);cursor:pointer;}'
    + '.w193card h3 .lnk:hover{color:' + GREEN + ';}'
    + '.w193empty{font-size:13px;color:var(--wa-muted);line-height:1.5;margin:0;}'
    + '.w193note{font-size:12.5px;color:var(--wa-muted);line-height:1.5;margin:8px 0 0;}'
    + '.w193stack{display:flex;flex-direction:column;gap:14px;}'
    + '.w193two{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:14px;align-items:start;}'
    + '.w193side{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:16px;align-items:start;}'
    + '.w193kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin:0 0 14px;}'
    + '.w193kpi{background:var(--wa-card,#FFFAF2);border:1px solid rgba(16,63,57,.07);border-radius:16px;padding:14px 16px;box-shadow:' + SH1 + ';cursor:pointer;min-width:0;}'
    + '.w193kpi:hover{border-color:rgba(16,63,57,.2);}'
