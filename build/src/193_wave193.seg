    + '.w193chip{display:inline-flex;align-items:center;gap:7px;font-size:12.5px;font-weight:600;color:' + GREEN + ';background:rgba(16,63,57,.07);border:1px solid transparent;border-radius:999px;padding:6px 12px;cursor:pointer;white-space:nowrap;user-select:none;}'
