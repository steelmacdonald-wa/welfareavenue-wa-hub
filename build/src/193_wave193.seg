    /* pills, fits, chips */
    + '.w193pill{display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:700;letter-spacing:.4px;text-transform:uppercase;border-radius:999px;padding:3px 9px;background:rgba(16,63,57,.08);color:' + GREEN + ';white-space:nowrap;}'
    + '.w193pill[data-st=watching]{background:rgba(121,119,115,.14);color:#5c5a56;}'
