    pen: '<path d="m4 20 1.2-4.6L15.8 4.8a2.3 2.3 0 0 1 3.3 3.3L8.6 18.8z"/><path d="m14 6.6 3.3 3.3"/>',
    camera: '<path d="M4 8h3.2l1.6-2.5h6.4L16.8 8H20a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1z"/><circle cx="12" cy="13" r="3.6"/>',
    printer: '<path d="M7 9V4h10v5M7 17H5a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-2"/><path d="M7 14h10v6H7z"/>',
    receipt: '<path d="M6 3.5h12v17l-3-2-3 2-3-2-3 2z"/><path d="M9 8.5h6M9 12h6M9 15.5h3.5"/>',
    cart: '<circle cx="9" cy="19.5" r="1.4"/><circle cx="17" cy="19.5" r="1.4"/><path d="M3 4h2.5l2.3 11h10.4L20.5 7.5H6.4"/>',
    doc: '<path d="M6.5 3.5h7L18 8v12.5h-11.5z"/><path d="M13.5 3.5V8H18M9 12.5h6M9 16h6"/>',
    sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/>',
    flag: '<path d="M5.5 21V4M5.5 4.5h11l-2 4 2 4h-11"/>',
    key: '<circle cx="8" cy="15" r="4"/><path d="m11 12 8.5-8.5M16 7l2.5 2.5M18 5l2 2"/>',
    box: '<path d="M3.5 7.5 12 3l8.5 4.5v9L12 21l-8.5-4.5z"/><path d="M3.5 7.5 12 12l8.5-4.5M12 12v9"/>',
    people: '<circle cx="9" cy="8.5" r="3.3"/><path d="M3 19.5c.7-3.3 3.1-5.2 6-5.2s5.3 1.9 6 5.2"/><circle cx="17" cy="9.5" r="2.6"/><path d="M16.5 14.3c2.3.2 4 1.8 4.5 4.7"/>',
    truck: '<path d="M2.5 6.5h11v9.5h-11zM13.5 10H18l3.5 3.5V16h-8"/><circle cx="6.5" cy="17.5" r="1.8"/><circle cx="17.5" cy="17.5" r="1.8"/>',
    shield: '<path d="M12 3 4.5 6v5.5c0 4.6 3.1 8.2 7.5 9.5 4.4-1.3 7.5-4.9 7.5-9.5V6z"/><path d="m9 12 2.2 2.2L15.5 10"/>',
    pot: '<path d="M4 10h16v5.5A4.5 4.5 0 0 1 15.5 20h-7A4.5 4.5 0 0 1 4 15.5z"/><path d="M2.5 10h19M9 6.5c0-1.4 1.3-2.5 3-2.5s3 1.1 3 2.5"/>',
    sprout: '<path d="M12 21v-9"/><path d="M12 12c0-4 2.7-6.5 7-6.5 0 4.3-2.7 6.5-7 6.5zM12 14c0-3.1-2.2-5.2-5.8-5.2 0 3.4 2.2 5.2 5.8 5.2z"/>',
    pin: '<path d="M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0c0 5-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.3"/>',
    heart: '<path d="M12 20s-7.5-4.6-7.5-10.2A4.3 4.3 0 0 1 12 7.2a4.3 4.3 0 0 1 7.5 2.6C19.5 15.4 12 20 12 20z"/>',
    columns: '<path d="M3 20.5h18M4.5 17.5h15M6 10v7.5M10 10v7.5M14 10v7.5M18 10v7.5M3.5 8.5 12 3.5l8.5 5z"/>',
    mic: '<rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5v3"/>',
    link: '<path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/>',
    x: '<path d="M6 6l12 12M18 6 6 18"/>',
    undo: '<path d="M9 14 4.5 9.5 9 5"/><path d="M4.5 9.5H14a5.5 5.5 0 0 1 0 11h-3"/>',
    arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
    bolt: '<path d="M13 3 5 13.5h6L10 21l8-10.5h-6z"/>'
  };
  function I(name, cls) { return '<svg class="w123i' + (cls ? ' ' + cls : '') + '" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + (P[name] || P.spark) + '</svg>'; }
  var TYPE_ICON = { 'post-request': 'megaphone', 'email-request': 'mail', 'design-request': 'pen', 'event-coverage': 'camera', 'print-request': 'printer', 'reimbursement': 'receipt', 'purchase-order': 'cart', 'grant-info': 'doc', 'time-off': 'sun', 'hiring-request': 'userplus', 'onboarding-request': 'flag', 'access-request': 'key', 'event-supplies': 'box', 'volunteer-support': 'people', 'transport-request': 'truck', 'media-release': 'shield' };
  var TEAM_ICON = { opsmtl: 'pot', progdev: 'sprout', opsto: 'pin', marketing: 'megaphone', fundraising: 'heart', finance: 'receipt', hr: 'people', board: 'columns' };
  /* wave164: the teams that receive requests and emails: the seven teams plus Finance (no team page; its inbox is in the Finance app) */
  var INBOX = (T.inbox && T.inbox.length) ? T.inbox : T.order;
  function pageOfTeam(d) { return d === 'finance' ? 'finances' : d; }

  /* ---------- small helpers ---------- */
  function E(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;'); }
  function lower(s) { return String(s == null ? '' : s).toLowerCase().trim(); }
  function cap(s) { s = String(s || ''); return s ? s.charAt(0).toUpperCase() + s.slice(1) : s; }
  function clip(s, n) { s = String(s == null ? '' : s).replace(/\s+/g, ' ').trim(); return s.length > n ? s.slice(0, n - 1).trim() + '\u2026' : s; }
  function toastS(m) { try { if (typeof toast === 'function') toast(m); } catch (e) { /* fine */ } }
  function now() { return Date.now(); }
  function isoDay(d) { var x = d ? new Date(d) : new Date(); return x.getFullYear() + '-' + String(x.getMonth() + 1).padStart(2, '0') + '-' + String(x.getDate()).padStart(2, '0'); }
  function asDate(v) { if (!v) return null; var s = String(v); var d = /^\d{4}-\d{2}-\d{2}$/.test(s) ? new Date(s + 'T12:00:00') : new Date(s); return isNaN(d.getTime()) ? null : d; }
  function fmtDay(v) { var d = asDate(v); if (!d) return ''; return d.toLocaleDateString('en-CA', { month: 'short', day: 'numeric' }); }
  function fmtLong(v) { var d = asDate(v); if (!d) return ''; return d.toLocaleDateString('en-CA', { weekday: 'short', month: 'short', day: 'numeric' }); }
  function fmtWhen(v) { var d = asDate(v); if (!d) return ''; return d.toLocaleString('en-CA', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }); }
  function ago(v) {
    var d = asDate(v); if (!d) return '';
    var m = Math.round((now() - d.getTime()) / 60000);
    if (m < 1) return 'just now'; if (m < 60) return m + ' min ago';
    var h = Math.round(m / 60); if (h < 24) return h + ' h ago';
    var dd = Math.round(h / 24); if (dd < 7) return dd + (dd === 1 ? ' day ago' : ' days ago');
    return fmtDay(d);
  }
  function daysUntil(v) { var d = asDate(v); if (!d) return null; var t = new Date(isoDay() + 'T12:00:00'); return Math.round((new Date(isoDay(d) + 'T12:00:00').getTime() - t.getTime()) / 86400000); }
  function dueText(v) {
    var n = daysUntil(v); if (n === null) return '';
    if (n < 0) return 'overdue by ' + (-n) + (n === -1 ? ' day' : ' days');
    if (n === 0) return 'needed today'; if (n === 1) return 'needed tomorrow';
    if (n < 7) return 'needed in ' + n + ' days';
    return 'needed by ' + fmtDay(v);
  }
  function lsGet(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }
  function lsSet(k, v) { try { if (v === null) localStorage.removeItem(k); else localStorage.setItem(k, v); } catch (e) { /* fine */ } }
  function reduced() { try { return window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) { return false; } }
  function initials(n) { var p = String(n || '').trim().split(/\s+/).filter(Boolean); if (!p.length) return '?'; return (p[0][0] + (p.length > 1 ? p[p.length - 1][0] : '')).toUpperCase(); }
  function hue(n) { var h = 0, s = String(n || ''); for (var i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) >>> 0; return ['#103F39', '#6F64AB', '#B9851B', '#2A8C7A', '#c87a2f', '#3a6ea5', '#B3402F'][h % 7]; }
  function avatar(name, size) { size = size || 24; return '<span class="w123av" style="width:' + size + 'px;height:' + size + 'px;font-size:' + Math.round(size * 0.42) + 'px;background:' + hue(name) + '" title="' + E(name) + '">' + E(initials(name)) + '</span>'; }

  /* ---------- styles ---------- */
  var css = document.createElement('style');
  css.id = 'wa123css';
  css.textContent = ''
    + '#requests.w123on > :not(.w118mast):not(#w123){display:none !important;}'
    + '#w123,#w123sheet,.w123tcard{font-family:' + BODY + ';color:var(--wa-text,' + INK + ');}'
    + '#w123{max-width:1180px;margin:0 0 40px;clear:both;}'
    + '.w123i{width:18px;height:18px;flex:0 0 auto;display:inline-block;vertical-align:middle;}'
    + '.w123av{display:inline-flex;align-items:center;justify-content:center;border-radius:50%;color:' + CREAM + ';font-weight:700;flex:0 0 auto;letter-spacing:.2px;}'
    /* nav */
    + '.w123nav{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin:0 0 18px;}'
    + '.w123seg{display:inline-flex;background:rgba(16,63,57,.08);border-radius:14px;padding:4px;gap:2px;flex-wrap:wrap;}'
    + '.w123seg a{display:inline-flex;align-items:center;gap:7px;font-size:13.5px;font-weight:600;color:' + GREEN + ';padding:8px 15px;border-radius:10px;cursor:pointer;text-decoration:none;white-space:nowrap;user-select:none;}'
    + '.w123seg a .n{font-size:11px;font-weight:700;min-width:18px;height:18px;padding:0 5px;border-radius:9px;background:rgba(16,63,57,.12);display:inline-flex;align-items:center;justify-content:center;box-sizing:border-box;}'
    + '.w123seg a .n.hot{background:' + GOLD + ';color:' + GREEN + ';}'
    + '.w123seg a.on{background:var(--wa-card,#FFFAF2);box-shadow:0 1px 3px rgba(16,63,57,.14);}'
    + '.w123seg a:not(.on):hover{background:rgba(255,250,242,.55);}'
    + '.w123nav .sp{flex:1 1 auto;}'
    + '.w123nav .w123gear{display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:600;color:var(--wa-muted);cursor:pointer;padding:8px 10px;border-radius:10px;}'
    + '.w123nav .w123gear:hover{color:' + GREEN + ';background:rgba(16,63,57,.06);}'
    /* buttons */
    + '.w123btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;font-family:' + BODY + ';font-size:14px;font-weight:700;background:' + GREEN + ';color:' + CREAM + ' !important;border:1px solid ' + GREEN + ';border-radius:12px;padding:11px 18px;cursor:pointer;text-decoration:none !important;line-height:1.1;transition:transform .12s ease,box-shadow .12s ease;}'
    + '.w123btn:hover{box-shadow:0 6px 16px rgba(16,63,57,.22);transform:translateY(-1px);}'
    + '.w123btn[disabled]{opacity:.55;cursor:default;transform:none;box-shadow:none;}'
    + '.w123btn.ghost{background:transparent;color:' + GREEN + ' !important;border-color:rgba(16,63,57,.22);}'
    + '.w123btn.ghost:hover{background:rgba(16,63,57,.06);box-shadow:none;}'
    + '.w123btn.gold{background:' + GOLD + ';border-color:' + GOLD + ';color:' + GREEN + ' !important;}'
    + '.w123btn.warn{background:transparent;color:' + FLAG + ' !important;border-color:rgba(179,64,47,.35);}'
    + '.w123btn.sm{font-size:12.5px;padding:7px 12px;border-radius:10px;}'
    + '.w123lnk{color:' + GREEN + ';font-weight:700;cursor:pointer;text-decoration:none;}'
    + '.w123lnk:hover{text-decoration:underline;}'
    /* cards and headings */
    + '.w123card{background:var(--wa-card,#FFFAF2);border:1px solid rgba(16,63,57,.07);border-radius:20px;box-shadow:' + SH1 + ';padding:24px 26px;}'
    + '.w123h{font-size:25px;font-weight:700;letter-spacing:-.4px;line-height:1.15;margin:0;color:var(--wa-text,' + INK + ');text-transform:none;}'
    + '.w123sub{font-size:14px;color:var(--wa-muted);margin:6px 0 0;line-height:1.5;max-width:720px;}'
    + '.w123sec{margin:26px 0 10px;display:flex;align-items:baseline;gap:10px;}'
    + '.w123sec h3{font-size:12px;font-weight:700;letter-spacing:1.4px;text-transform:uppercase;color:' + GREEN + ';margin:0;}'
    + '.w123sec .c{font-size:12px;color:var(--wa-muted);}'
    + '.w123crumb{display:flex;align-items:center;gap:6px;flex-wrap:wrap;font-size:13px;color:var(--wa-muted);margin:0 0 14px;}'
    + '.w123crumb a{color:' + GREEN + ';font-weight:600;cursor:pointer;}'
    + '.w123crumb a:hover{text-decoration:underline;}'
    + '.w123crumb .w123i{width:14px;height:14px;opacity:.5;}'
    + '.w123empty{font-size:14px;color:var(--wa-muted);padding:22px 4px;line-height:1.55;}'
    + '.w123empty b{color:var(--wa-text,' + INK + ');}'
    /* step 1: search and teams */
    + '.w123search{position:relative;margin:18px 0 0;max-width:560px;}'
    + '.w123search .w123i{position:absolute;left:16px;top:50%;margin-top:-9px;color:var(--wa-muted);}'
    + '#w123 .w123search input[type=search]{width:100%;box-sizing:border-box;height:50px;font-family:' + BODY + ';font-size:15px;padding:0 16px 0 46px !important;margin:0;-webkit-appearance:none;appearance:none;border:1px solid rgba(16,63,57,.16);border-radius:14px;background:var(--wa-card,#FFFAF2);outline:none;transition:border-color .15s,box-shadow .15s;}'
    + '#w123 .w123search input[type=search]:focus{border-color:' + GOLD + ';box-shadow:0 0 0 4px rgba(220,165,39,.18);}'
    + '.w123teams{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:14px;margin:18px 0 0;}'
    + '.w123team{display:flex;flex-direction:column;align-items:flex-start;gap:8px;text-align:left;background:var(--wa-card,#FFFAF2);border:1px solid rgba(16,63,57,.08);border-radius:18px;padding:18px 18px 16px;cursor:pointer;box-shadow:' + SH1 + ';font-family:' + BODY + ';color:var(--wa-text,' + INK + ');transition:transform .15s ease,box-shadow .15s ease,border-color .15s ease;min-width:0;}'
    + '.w123team:hover{transform:translateY(-2px);box-shadow:' + SH2 + ';border-color:var(--c);}'
    + '.w123team:focus-visible{outline:3px solid rgba(220,165,39,.5);outline-offset:2px;}'
    + '.w123ico{width:44px;height:44px;border-radius:14px;display:inline-flex;align-items:center;justify-content:center;background:var(--cb,rgba(16,63,57,.1));color:var(--c);flex:0 0 auto;}'
    + '.w123ico .w123i{width:22px;height:22px;}'
    + '.w123team b{font-size:16px;font-weight:700;line-height:1.25;}'
    + '.w123team .s{font-size:13px;color:var(--wa-muted);line-height:1.45;}'
    + '.w123team .m{font-size:12px;color:var(--wa-muted);margin-top:auto;padding-top:4px;display:flex;gap:10px;flex-wrap:wrap;}'
    + '.w123team .m span{display:inline-flex;align-items:center;gap:4px;}'
