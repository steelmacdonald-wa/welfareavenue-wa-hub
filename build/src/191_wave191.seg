    try { var r = await Promise.all([db.rpc('is_wa_admin'), db.rpc('is_wa_leader'), db.rpc('wa_is_hr')]); out.text = [0, 1, 2].some(function (i) { return r[i] && r[i].data === true; }); } catch (e) { /* the database decides anyway */ }
