      + '<div><div style="font-size:13.5px;line-height:1.6">' + (row && row.start_time ? 'Serving at <b>' + E(hm12(row.start_time)) + '</b>' : 'Start time not set') + (row && row.location ? ' \u00b7 ' + E(row.location) : '') + '<br>Ops line <a href="tel:+14388087754" style="color:' + GREEN + '"><b>438-808-7754</b></a>'
      + '<br>WhatsApp group: ' + (row && row.whatsapp_url ? '<a href="' + E(row.whatsapp_url) + '" target="_blank" rel="noopener" style="color:' + GREEN + ';font-weight:600">open</a>' : '<span style="color:' + FLAG + '">no link yet</span>') + '</div>'
      + '<div class="w191line" style="margin-top:10px">' + (tl ? '<a class="w191btn ghost" target="_blank" rel="noopener" href="https://hub.welfareavenue.com/c/' + E(tl.confirm_token) + '?test=1&it=1">The team leader\u2019s itinerary</a>' : '') + (staff() ? '<button class="w191btn ghost" data-w191go="hist182">Sent and scheduled</button>' : '') + '</div></div></div></div>';
