    + '.w126lnk:hover{text-decoration:underline;}'
    + '.w126card{background:var(--wa-card,#fff);border:1px solid rgba(16,63,57,.07);border-radius:18px;box-shadow:' + SH1 + ';padding:18px 20px;min-width:0;}'
    + '.w126card > h3{font-size:12px;font-weight:700;letter-spacing:1.4px;text-transform:uppercase;color:' + GREEN + ';margin:0 0 12px;display:flex;align-items:center;gap:8px;justify-content:space-between;}'
    + '.w126card > h3 .lnk{font-size:11.5px;letter-spacing:.3px;text-transform:none;font-weight:600;color:var(--wa-muted);cursor:pointer;}'
    + '.w126card > h3 .lnk:hover{color:' + GREEN + ';}'
    + '.w126empty{font-size:13px;color:var(--wa-muted);line-height:1.5;margin:0;}'
