    + '.w126seg a.on{background:var(--wa-card,#fff);box-shadow:0 1px 2px rgba(16,63,57,.12);}'
    + '.w126st{display:inline-flex;align-items:center;font-size:11px;font-weight:700;letter-spacing:.3px;border-radius:999px;padding:3px 9px;white-space:nowrap;}'
