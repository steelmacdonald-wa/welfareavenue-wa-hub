          if (c.getAttribute('data-w258n') !== String(n)) { c.innerHTML = html; c.setAttribute('data-w258n', String(n)); }
          c.setAttribute('title', n ? 'Open your team page at its decisions' : label(d) + ' has no open decisions right now');
        }
