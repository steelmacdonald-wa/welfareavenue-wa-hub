      if (!c.hasAttribute('data-w258chip') && !c.hasAttribute('data-mphash') && !c.hasAttribute('data-w74men')) return;
      if (!c.hasAttribute('role')) { c.setAttribute('role', 'button'); c.setAttribute('tabindex', '0'); }
    });
