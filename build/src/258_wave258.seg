    var chips = Array.prototype.slice.call(body.querySelectorAll('.mp-chips .mp-chip')); if (!chips.length) return;
    var plain = chips.filter(function (c) { return !c.hasAttribute('data-mphash') && !c.hasAttribute('data-mpgo') && !c.hasAttribute('data-w74men'); });
    var d = myTeam();
    if (plain[0]) plain[0].setAttribute('data-w258chip', 'mine');
    if (plain[1] && d) plain[1].setAttribute('data-w258chip', 'team');
    chips.forEach(function (c) {
      if (c.hasAttribute('data-mpgo')) c.setAttribute('data-w258chip', 'req');
