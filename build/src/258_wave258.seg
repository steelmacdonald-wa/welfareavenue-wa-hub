          if (c.getAttribute('data-w258chip') === 'dec') { c.removeAttribute('data-w258chip'); c.removeAttribute('data-w258n'); c.removeAttribute('title'); c.innerHTML = c.__w258orig; }
        } else {
          var n = teamDecisions(d).length;
          c.setAttribute('data-w258chip', 'dec');
