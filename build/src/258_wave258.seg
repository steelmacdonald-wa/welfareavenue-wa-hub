  /* ---------- decisions for one team (the same rule as the team page's card) ---------- */
  var AREA = { 'ops mtl': 'opsmtl', 'program development': 'progdev', 'ops to': 'opsto', 'marketing': 'marketing', 'fundraising': 'fundraising', 'grants': 'fundraising', 'events': 'fundraising', 'finance': 'fundraising', 'hr': 'hr', 'board': 'board' };
  function areaDept(area) {
    var s = lower(area);
    if (AREA[s]) return AREA[s];
    if (s.indexOf('program dev') >= 0) return 'progdev';
