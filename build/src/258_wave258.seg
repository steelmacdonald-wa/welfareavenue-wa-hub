  /* ---------- 3. The Grants page ---------- */
  function lead() {
    var ms = (typeof DB_MEMBERS !== 'undefined' ? DB_MEMBERS : []).filter(function (m) { return m && m.active !== false && /grants lead/i.test(m.role || ''); });
    return ms[0] || { name: 'Suhaib' };
  }
  function grantRows() {
    var b = grantsBoard(); var f = window.w116TasksFor; if (!b || !f) return [];
    try { return f('fundraising', b, null) || []; } catch (e) { return []; }
  }
  function statsHtml() {
    var rows = grantRows().filter(function (t) { return !t.done; }), tdy = todayKey();
    var wk = new Date(Date.now() + 7 * 86400000); var wkKey = wk.getFullYear() + '-' + String(wk.getMonth() + 1).padStart(2, '0') + '-' + String(wk.getDate()).padStart(2, '0');
    var over = rows.filter(function (t) { return t.due_date && t.due_date < tdy; }).length;
    var soon = rows.filter(function (t) { return t.due_date && t.due_date >= tdy && t.due_date <= wkKey; }).length;
    var none = rows.filter(function (t) { return !t.due_date; }).length;
    return '<span><b>' + rows.length + '</b>open</span><span><b class="' + (over ? 'warn' : '') + '">' + over + '</b>overdue</span><span><b>' + soon + '</b>due this week</span><span><b>' + none + '</b>with no date</span>';
  }
  function paintGrants() {
    var sec = document.getElementById('grants'); if (!sec) return;
    try { document.title = 'Grants \u00b7 Welfare Avenue Hub'; } catch (e) { /* fine */ }
    try { var gb = document.querySelector('#tabBar .tab[data-tab="grants"]'); var row = gb && gb.closest ? gb.closest('.w42d') : null; if (row) row.classList.add('w116open', 'w116act'); } catch (e) { /* fine */ }
    if (!staff() || !canSee('grants')) { sec.innerHTML = '<div class="w116crumb"><a data-w116go="#mypage">Home</a> &middot; Teams &middot; Grants</div><p class="w258deny">The Grants page is for the people who can open the Fundraising team page.</p>'; return; }
    var L = lead(), av = '';
    try { if (window.w116Avatar && L.id) av = window.w116Avatar(L, 24); } catch (e) { av = ''; }
    var pipe = canSee('fund');
    sec.innerHTML = '<div class="w116crumb"><a data-w116go="#mypage">Home</a> &middot; Teams &middot; <a data-w116go="#team/fundraising">Fundraising</a> &middot; Grants</div>'
      + '<div class="w116top"><div><h2><span class="dot" style="background:' + GRANT + '"></span>Grants</h2>'
      + '<p class="sub">Applications, reports and funder relationships. Grants left the Fundraising page so its tasks have room of their own.</p>'
      + '<p class="w258over">' + av + '<span>Overseen by <b>' + E(String(L.name || 'Suhaib').split(' ')[0]) + '</b></span></p></div>'
      + '<div class="w258acts">' + (pipe ? '<button type="button" class="w258btn" data-w258g="pipe">Open the grants pipeline</button>' : '') + '<button type="button" class="w258btn pri" data-w258g="add">+ Add a grants task</button></div></div>'
      + '<div class="w258stat" id="w258gstat">' + statsHtml() + '</div>'
      + '<div id="w258gtasks"><p class="w116empty">Loading the grants tasks\u2026</p></div>';
    var slot = document.getElementById('w258gtasks');
    var go = function () {
      if (!document.body.contains(slot)) return;
      if (window.w116Board && window.w116Board.render && grantsBoard()) window.w116Board.render(slot, { dept: 'fundraising', board: grantsBoard(), ws: null });
      else slot.innerHTML = '<p class="w116empty">The task board is not available in this build.</p>';
    };
    try { if (window.w116LoadProjects) Promise.resolve(window.w116LoadProjects()).then(go, go); else go(); } catch (e) { go(); }
  }
  function addGrantTask() {
    var slot = document.getElementById('w258gtasks'); if (!slot) return;
    var list = slot.querySelector('[data-act="view"][data-v="list"]');
    if (list && !list.classList.contains('on')) list.click();
    setTimeout(function () {
      var qa = slot.querySelector('[data-act="qa"][data-g="p0"]') || slot.querySelector('[data-act="qa"]');
      if (qa) { qa.click(); var box = qa.closest('.w116g'); if (box) flash(box); }
      else toastS('Open the Grants list to add a task.');
    }, 60);
  }
  document.addEventListener('click', function (e) {
    var b = e.target && e.target.closest && e.target.closest('#grants [data-w258g]'); if (!b) return;
    e.preventDefault();
    var k = b.getAttribute('data-w258g');
    if (k === 'pipe') location.hash = '#fund/grants';
    if (k === 'add') addGrantTask();
  });
  /* the stats under the title follow the board (a tick, an add, a new date) */
  var stT = null;
  function watchGrants() {
    var sec = document.getElementById('grants'); if (!sec || sec.__w258obs) return;
    sec.__w258obs = true;
    try { new MutationObserver(function (ms) { if (ms.every(function (m) { return m.target && m.target.id === 'w258gstat'; })) return; clearTimeout(stT); stT = setTimeout(function () { var s = document.getElementById('w258gstat'); if (s) { var h = statsHtml(); if (s.innerHTML !== h) s.innerHTML = h; } }, 120); }).observe(sec, { childList: true, subtree: true }); } catch (e) { /* fine */ }
  }
  function register() {
    if (!window.WA_NAV || typeof WA_NAV.register !== 'function') return;
    if (!WA_NAV.pages.some(function (p) { return p.id === 'grants'; })) WA_NAV.register({ id: 'grants', label: 'Grants', dot: GRANT, gate: 'member', onShow: function () { paintGrants(); watchGrants(); } });
    try { if (window.w116Nav) window.w116Nav(); } catch (e) { /* fine */ }
  }

  /* ---------- the page tour (wave122's engine; trainings row tour:grants) ---------- */
  function addTour() {
    try {
      var W = window.w122; if (!W || !W.tours) return false; if (W.tours.grants) return true;
      var OPT = { opt: 1 };
      var Tt = function (sel, t, p, o) { var x = { s: sel, t: t, p: p }; if (o) Object.keys(o).forEach(function (k) { x[k] = o[k]; }); return x; };
      W.tours.grants = { tab: 'grants', icon: 'target', hash: '#grants', steps: [
        Tt('#grants .w116top', 'Grants', 'Grant applications, reports and funder follow-ups, on a page of their own. It sits in the Fundraising row of the menu.'),
        Tt('#grants .w258over', 'Who oversees it', 'The grants lead looks after this list. Ask them before you change a funder deadline.', OPT),
        Tt('#grants [data-w258g="pipe"]', 'The grants pipeline', 'Every grant we are watching, writing or waiting on lives in the Fundraising app. This opens it.', OPT),
        Tt('#grants [data-w258g="add"]', 'Add a grants task', 'A new task here is filed under Fundraising, Grants, so it never lands back on the Fundraising page.', OPT),
        Tt('#grants #w258gtasks .w116g, #grants #w258gtasks .w116b', 'The tasks', 'Tick one when it is done, click it for the details, comments and To the bank. Drag to reorder or to another project.', OPT)
      ] };
      return true;
    } catch (e) { return false; }
  }
  if (!addTour()) { var tries = 0, iv = setInterval(function () { if (addTour() || ++tries > 40) clearInterval(iv); }, 500); }

  /* ---------- start: inside the startApp chain, so the first paint already has the requests (wave222) ---------- */
  function homeOn() { var m = document.getElementById('mypage'); return !!(m && m.classList.contains('active')); }
  if (typeof startApp === 'function') {
    var __sa258 = startApp;
    startApp = async function () {
      var out = await __sa258.apply(this, arguments);
      try {
        wrapTasksFor(); wrapAllowed(); wrapHome();
        register(); watchTeam();
        var hadReq = !!document.querySelector('#mpBody [data-mpgo]');
        if (staff() && window.w123 && !window.w123.loaded()) {
          await Promise.race([Promise.resolve(window.w123.load()).catch(function () { return null; }), new Promise(function (r) { setTimeout(r, 3000); })]);
        }
        /* Home drew its chips before the requests came in: draw it once more, still inside the start */
        var d0 = myTeam(), nReq = 0;
        try { nReq = (typeof REQ_CACHE !== 'undefined' ? REQ_CACHE : []).filter(function (x) { return d0 && x.department === d0 && !x.done; }).length; } catch (e) { nReq = 0; }
        if (homeOn() && !hadReq && nReq && typeof renderMyPage === 'function') { try { await renderMyPage(); } catch (e) { /* fine */ } }
        decorateTeam(); decorateChips();
        if (decodeURIComponent(location.hash || '').replace(/^#/, '').split('/')[0] === 'grants') { try { applyHash(); } catch (e) { /* fine */ } }
      } catch (e) { console.warn('wave258 boot', e); }
      return out;
    };
  }

  /* ---------- test hook ---------- */
  window.w258 = { isGrant: isGrant, teamDecisions: teamDecisions, decorateChips: decorateChips, decorateTeam: decorateTeam, paintGrants: paintGrants, chipGo: chipGo, routeDecisions: routeDecisions, reqBlock: reqBlock };
})();
