    if (!want) { if (old) old.remove(); return; }
    var html = tabsHtml();
    if (old && old.outerHTML === html) return;
    if (old) old.remove();
    var mast = sec.querySelector('.w118mast'), card = sec.querySelector(':scope > .card');
    var anchor = mast || (card && card.querySelector('.vl-sub')) || card;
    if (!anchor) return;
    if (mast) mast.insertAdjacentHTML('afterend', html); else if (anchor.classList.contains('vl-sub')) anchor.insertAdjacentHTML('afterend', html); else anchor.insertAdjacentHTML('afterbegin', html);
  }
  function fixChips() {
    var row = document.querySelector('#volunteering .vl-sub'); if (!row) return;
    var html = chipsHtml();
    var mine = row.querySelector('[data-w259chip]');
    if (mine && row.getAttribute('data-w259') === html) return;
    /* keep wave23's Text volunteers chip; replace the rest */
    var keep = row.querySelector('[data-vtxt]');
    row.innerHTML = html; if (keep) row.appendChild(keep);
    row.setAttribute('data-w259', html);
  }
  /* the rail: no separate Applicants and Sign-offs items (they are People's tabs); the right item lit for every address */
  function railGroups() {
    var A = window.WA_APP && window.WA_APP.apps; if (!A || !A.volunteer || typeof A.volunteer.groups !== 'function') return;
    if (A.volunteer.groups.__w259) return;
    var g0 = A.volunteer.groups;
    var g = function () {
      var gs = g0.apply(this, arguments);
      try {
        gs.forEach(function (grp) { grp.items = grp.items.filter(function (it) { return !/#volunteering\/(applicants|signoffs)$/.test(it.h); }); });
        gs = gs.filter(function (grp) { return grp.items.length; });
      } catch (e) { /* fine */ }
      return gs;
    };
    g.__w259 = true; A.volunteer.groups = g;
    try { if (window.WA_APP && typeof WA_APP.renderRail === 'function') WA_APP.renderRail(); } catch (e) { /* fine */ }
  }
  function fixRail() {
    railGroups();
    var r = document.getElementById('w153rail'); if (!r || !document.body.classList.contains('w153volunteer')) return;
    var s = sub(); var want = placeOf(s); if (!want && s && s !== 'e') want = ''; if (/^#volunteering\/e\//.test(location.hash || '')) want = '';
    var hash = want ? PLACES.filter(function (p) { return p[0] === want; })[0][2] : '#volunteering';
    r.querySelectorAll('.w153it[data-w153go^="#volunteering"]').forEach(function (a) {
      var on = a.getAttribute('data-w153go') === hash;
      if (a.classList.contains('on') !== on) { a.classList.toggle('on', on); if (on) a.setAttribute('aria-current', 'page'); else a.removeAttribute('aria-current'); }
    });
    /* the People badge: new applicants plus sign-offs waiting (wave195 and 209 used to badge their own items) */
    var pa = r.querySelector('.w153it[data-w153go="#volunteering/people"]');
    if (pa) { var n = peopleBadge(), bd = pa.querySelector('.w153n'); if (n) { if (!bd) { bd = document.createElement('small'); bd.className = 'w153n'; pa.appendChild(bd); } if (bd.textContent !== n) bd.textContent = n; } else if (bd) bd.remove(); }
    var where = document.querySelector('#w153bar .w153bc > span');
    if (where) { var lbl = (PLACES.filter(function (p) { return p[0] === want; })[0] || PLACES[0])[1]; if (/^#volunteering\/e\//.test(location.hash || '')) lbl = 'Serving'; if (where.textContent !== lbl) where.textContent = lbl; }
  }

  /* ---------- Setup ---------- */
  async function loadSetup(force) {
    if (!force && S.setup && Date.now() - S.setupAt < 30000) return S.setup;
    try { var r = await db.rpc('wa259_text_setup'); if (r && r.error) throw r.error; S.setup = r.data || {}; S.setupAt = Date.now(); S.err = ''; } catch (e) { S.err = msgOf(e); }
    return S.setup;
  }
  function on(k) { return String((S.setup || {})[k] || 'on') === 'on'; }
  function num(k, d) { var v = Number((S.setup || {})[k]); return isFinite(v) && v > 0 ? v : d; }
  function scheduleRows(ev) {
    var d = ev.date, h = hour12(num('sms_confirm_hour', 10));
    return [
      { k: 'confirm', l: 'Confirmation', when: addDays(d, -num('sms_confirm_days', 10)), at: h, who: 'Everyone on the list who has not answered: the role, the date, their link, and "tell us at least ' + num('cancel_notice_days', 4) + ' days before if you can\u2019t make it". Cooks are asked to choose their dish and pick-up or drop-off first.', on: true },
      { k: 'reminder', l: 'Monday reminder', when: addDays(d, -num('sms_reminder_days', 6)), at: h, who: 'Confirmed: "you\u2019re confirmed, tell us by the deadline if anything changes". Not answered: "we still need your answer".', on: on('sms_reminder_on'), sw: 'sms_reminder_on' },
      { k: 'deadline', l: 'Last day to cancel', when: addDays(d, -num('cancel_notice_days', 4)), at: '', who: num('cancel_notice_days', 4) + ' days before. No text; the date every other text names.', on: true },
      { k: 'checkin', l: 'Thursday check-in', when: addDays(d, -num('sms_checkin_days', 3)), at: h, who: 'Confirmed: "see you Sunday, your details, call us right away if anything came up". Not answered: "can you still come? reply today".', on: on('sms_checkin_on'), sw: 'sms_checkin_on' },
      { k: 'itinerary', l: 'Itinerary', when: addDays(d, -1), at: hour12(num('sms_itinerary_hour', 17)), who: 'Confirmed team leaders, drivers and the roles with an itinerary (text or email, per serving).', on: true },
      { k: 'survey', l: 'Thank-you and survey', when: d, at: hour12(num('sms_survey_hour', 18)), who: 'Everyone confirmed.', on: true }
    ];
  }
  function setupHtml() {
    var st = S.setup || {}, can = !!st.can_text, next = st.next || [], ev = next[0];
    var card = function (id, title, body, foot) { return '<section class="w259card" id="' + id + '"><h3>' + E(title) + '</h3>' + body + (foot ? '<div class="ft">' + foot + '</div>' : '') + '</section>'; };
    var h = '<div class="w259setup">';
    /* the three reference pages */
    h += '<div class="w259grid">'
      + '<a class="w259tile" href="#volunteering/sop"><b>The SOP</b><span>The master checklist every serving starts from, in six stages.</span></a>'
      + '<a class="w259tile" href="#volunteering/recipes"><b>Recipes</b><span>What the cooks make, with the recipe links.</span></a>'
      + '<a class="w259tile" href="#volunteering/inventory"><b>Inventory</b><span>The kit in storage, counted and reordered.</span></a></div>';
    /* texts */
    var sched = ev ? scheduleRows(ev) : [];
    var rows = sched.map(function (r) {
      return '<li class="' + (r.k === 'deadline' ? 'dl' : '') + (r.on ? '' : ' off') + '"><div class="w"><b>' + E(r.l) + '</b><span>' + E(dayTxt(r.when)) + (r.at ? ', ' + E(r.at) : '') + '</span></div><p>' + E(r.who) + '</p>'
        + (r.sw ? '<label class="sw"><input type="checkbox" data-w259sw="' + r.sw + '"' + (r.on ? ' checked' : '') + (can ? '' : ' disabled') + '><span>' + (r.on ? 'On' : 'Off') + '</span></label>' : '') + '</li>';
    }).join('');
    var others = next.slice(1).map(function (e) { return dayTxt(e.date) + ': confirmations ' + dayTxt(addDays(e.date, -num('sms_confirm_days', 10))) + ', reminder ' + dayTxt(addDays(e.date, -num('sms_reminder_days', 6))) + ', last day to cancel ' + dayTxt(addDays(e.date, -num('cancel_notice_days', 4))) + ', check-in ' + dayTxt(addDays(e.date, -num('sms_checkin_days', 3))); }).join('. ');
    h += card('w259texts', 'Texts to volunteers',
      '<p class="lead">Every automatic text, from the ops line 438-808-7754, between ' + E(hour12(num('sms_window_start', 9))) + ' and ' + E(hour12(num('sms_window_end', 19))) + ' Toronto time, once per person per serving. ' + (st.sms_mode && st.sms_mode !== 'live' ? '<b style="color:' + FLAG + '">Texts are in ' + E(st.sms_mode) + ' mode.</b> ' : '') + (ev ? 'For the next serving, <b>' + E(dayTxt(ev.date, true)) + '</b>' + (ev.code ? ' (' + E(ev.code) + ')' : '') + ':' : 'No upcoming serving.') + '</p>'
      + (sched.length ? '<ol class="w259sched">' + rows + '</ol>' : '')
      + (others ? '<p class="m">Then ' + E(others) + '.</p>' : '')
      + '<p class="m">Not on a schedule: the sign-up text the moment a form puts someone on a serving; the text and email when the team places someone (Assign to servings); invitations from Find volunteers; Still in?; the thank-you after a YES or NO reply. A confirmed volunteer who says they can\u2019t come on their page tells the role\u2019s owner and the volunteer team at once.</p>'
      + '<div class="w259days">' + [['sms_confirm_days', 'Confirmation, days before'], ['sms_reminder_days', 'Reminder, days before'], ['sms_checkin_days', 'Check-in, days before'], ['cancel_notice_days', 'Days\u2019 notice to cancel']].map(function (x) {
        return '<label><span>' + E(x[1]) + '</span><input type="number" min="1" max="30" value="' + E(num(x[0], 0) || '') + '" data-w259d="' + x[0] + '"' + (can ? '' : ' disabled') + '></label>';
      }).join('') + (can ? '<button type="button" class="w259b pri" data-w259go="days">Save the days</button>' : '<span class="m">Leaders, HR, admins and the volunteer team change these.</span>') + '</div>',
      '<button type="button" class="w259b" data-w171set="1">Text settings</button><span class="m">The mode, the test phone, each role\u2019s page, the survey and the itineraries.</span><span class="m">Who got what: open a serving, then <b>Text log</b>.</span>');
    /* the usual spot counts */
    var usual = st.usual || {};
    h += card('w259spots', 'The usual spot counts',
      '<p class="lead">How many of each role a serving needs unless it sets its own (a serving\u2019s More menu, Spot counts).</p><div class="w259spots">' + ROLES.map(function (r) {
        return '<label><span>' + E(r[1]) + '</span><input type="number" min="0" max="60" value="' + E(usual[r[0]] == null ? '' : usual[r[0]]) + '" data-w259sp="' + r[0] + '"' + (can ? '' : ' disabled') + '></label>';
      }).join('') + '</div>',
