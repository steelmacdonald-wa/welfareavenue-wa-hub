  function chipsHtml() {
    var cur = placeOf(sub());
    return PLACES.map(function (p) { return '<a class="fchip' + (cur === p[0] ? ' on' : '') + '" href="' + p[2] + '" data-w259chip="' + (p[0] || 'home') + '"' + (p[3] ? ' data-vl="' + p[3] + '"' : ' data-w257cal="1"') + '>' + E(p[1]) + (p[0] === 'people' && peopleBadge() ? ' (' + peopleBadge() + ')' : '') + '</a>'; }).join('');
  }
  /* the People tabs under the title */
  function tabsHtml() {
    var s = sub() || 'people';
    var tabs = [['people', 'Volunteers', null, '#volunteering/people'], ['applicants', 'New applicants', nApps(), '#volunteering/applicants'], ['signoffs', 'Sign-offs', nSign(), '#volunteering/signoffs']];
    return '<nav class="w259tabs" aria-label="People">' + tabs.map(function (t) { return '<a href="' + t[3] + '" data-vl="' + t[0] + '" class="' + (s === t[0] ? 'on' : '') + '"' + (s === t[0] ? ' aria-current="page"' : '') + '>' + E(t[1]) + (t[2] ? '<em>' + t[2] + '</em>' : '') + '</a>'; }).join('') + '</nav>';
  }
  function placeTabs() {
    var sec = document.getElementById('volunteering'); if (!sec) return;
