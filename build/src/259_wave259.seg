  function placeOf(s) { if (PEOPLE.indexOf(s) >= 0) return 'people'; if (SETUP.indexOf(s) >= 0) return 'setup'; if (s === 'phone' || s === 'messages') return 'phone'; if (s === 'calendar') return 'calendar'; return ''; }
  function nApps() { try { return Number((window.w209 && window.w209.state().n) || 0); } catch (e) { return 0; } }
