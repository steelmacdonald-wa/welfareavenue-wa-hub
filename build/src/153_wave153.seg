    + '#w153bar .w153bc b{font-family:' + HEAD + ';font-weight:600;font-size:18px;letter-spacing:.6px;text-transform:uppercase;color:' + GREEN + ';}'
    /* wave163: the arrow and the grey go to where you are, never to the app's icon tile (it read \u203a, a faded icon) */
    + '#w153bar .w153bc > span:not(.w153ai){font-size:13.5px;color:' + MUTED + ';}'
    + '#w153bar .w153bc > span:not(.w153ai)::before{content:"\\203A";margin:0 8px 0 2px;color:rgba(16,63,57,.35);}'
    + '#w153bar .w153acts{margin-left:auto;display:flex;gap:8px;align-items:center;}'
    + '#w153bar .w153btn{display:inline-flex;align-items:center;gap:6px;border:none;border-radius:999px;padding:8px 14px;background:' + GREEN + ';color:' + CREAM + ';font-family:' + BODY + ';font-size:13px;font-weight:700;cursor:pointer;}'
    + '#w153bar .w153btn:hover{background:#0c332e;}'
    + '#w153bar .w153btn .w153i{width:15px;height:15px;}'
    + '#w153bar .w153menu{display:none;align-items:center;gap:6px;border:1px solid rgba(16,63,57,.18);border-radius:999px;padding:7px 12px;background:none;color:' + GREEN + ';font-family:' + BODY + ';font-size:12.5px;font-weight:700;cursor:pointer;}'
    + 'body.w153app.w153crm #crm > .w118mast .crumb{display:none;}'
    + '@media (min-width:901px){body.w153app.w153crm #crm .w152tabs{display:none;}}'
    /* search everything: contacts */
    + '#searchResults .sr .sr-type.w153c{background:rgba(42,140,122,.14);color:' + TEAL + ';}'
    /* the gifts tab in the CRM */
    + '#crm .w153gifts .w152lh,#crm .w153gifts .w152row{grid-template-columns:110px 1.4fr 110px 1fr 1fr;}'
    + '#crm .w153gifts .w152row{cursor:default;}'
    + '#crm .w153gifts .w152row .amt{font-weight:700;color:' + GREEN + ';}'
    + '#crm .w153gifts .w152row a{color:' + GREEN + ';font-weight:600;text-decoration:none;}'
    + '#crm .w153gifts .w152row a:hover{text-decoration:underline;}'
    + '#crm .w153gifts .rc{font-size:12px;color:' + MUTED + ';}'
    + '#crm .w153gifts .rc a{font-weight:500;}'
    + '#crm .w153gtot{margin:6px 0 10px;font-size:13px;color:' + MUTED + ';}'
    + '#crm .w153gtot b{color:' + INK + ';}'
    /* phones */
    + '@media (max-width:900px){'
    + '#w153pop{left:12px;right:12px;width:auto;bottom:calc(82px + env(safe-area-inset-bottom));}'
    + '#w153bar{position:sticky;top:0;z-index:40;margin:0 0 10px;box-shadow:0 8px 24px -12px rgba(16,63,57,.25);}'
    + '#w153bar .w153menu{display:inline-flex;}'
    + '#w153bar .w153acts{margin-left:0;width:100%;justify-content:space-between;}'
    + '#crm .w153gifts .w152lh{display:none;}'
    + '#crm .w153gifts .w152row{grid-template-columns:1fr 1fr;}'
    + '}';
  if (!document.getElementById('wa153css')) { var st = document.createElement('style'); st.id = 'wa153css'; st.textContent = css; document.head.appendChild(st); }

  /* ---------- the dock, the launcher and the rail ---------- */
  var S = { app: null, open: false, drawn: 0 };
  function nav() { return document.querySelector('nav.wa-nav'); }
