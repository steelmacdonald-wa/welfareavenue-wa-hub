    + '#w153rail .w153next .w153i{width:14px;height:14px;}'
    /* the app bar above the page */
    + '#w153bar{display:none;align-items:center;gap:12px;flex-wrap:wrap;margin:0 0 14px;padding:10px 14px;border-radius:14px;background:var(--wa-card);border:1px solid rgba(16,63,57,.08);font-family:' + BODY + ';}'
    + 'body.w153app #w153bar{display:flex;}'
