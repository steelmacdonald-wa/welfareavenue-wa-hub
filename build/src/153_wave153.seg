      clearTimeout(tS);
      if (crmContacts()) addHits(q);
      else tS = setTimeout(function () { loadContacts().then(function () { var gs = document.getElementById('globalSearch'); if (gs && gs.value.trim() === q) addHits(q); }); }, 200);
    };
  }
  function placeholder() {
