/* =====================================================================
   WA v29 goals reorganization (29/07/26)
   1. The goals page is organized as dropdowns: quarters first (newest
      open), then departments inside each quarter, then every goal. Each
      department goals card links through to its full list.
   2. Goals are editable: add, edit, archive. Every goal carries a
      description (used to match projects automatically), a measure, a
      quarter, a status and a due date.
   3. Projects attach to goals from the goal side too: link and unlink
      in the goal editor.
   4. Creating or editing a project suggests the best-matching goal from
      the project name and description.
   ===================================================================== */

var WA29_FOCUS = null;

(function () {
  if (document.getElementById('wa29css')) return;
  var st = document.createElement('style');
  st.id = 'wa29css';
  st.textContent = '' +
    '.w29q{margin:0 0 14px;border:1px solid rgba(127,127,127,.25);border-radius:11px;padding:4px 14px 10px;}' +
    '.w29q>summary{cursor:pointer;font-weight:700;font-size:15px;padding:8px 0;color:#a87f2c;}' +
    '.w29d{margin:8px 0;border-left:3px solid rgba(127,127,127,.25);padding-left:12px;}' +
    '.w29d>summary{cursor:pointer;font-weight:600;font-size:13px;padding:5px 0;}' +
    '.w29d>summary .n{opacity:.6;font-weight:400;margin-left:6px;font-size:11.5px;}' +
    '.w29add{margin:6px 0 2px;}' +
    '.w29ge{font-size:11.5px;margin:2px 0 12px;}' +
    '.w29ge a{color:#2c7a66;cursor:pointer;text-decoration:underline;opacity:.85;}' +
    '.w29lp{display:flex;gap:6px;flex-wrap:wrap;margin:6px 0;font-size:12px;}' +
    '.w29lp .pjx{border:1px solid rgba(44,122,102,.45);color:#2c7a66;border-radius:8px;padding:2px 9px;}' +
    '.w29lp .pjx a{cursor:pointer;margin-left:5px;opacity:.7;}' +
    '.w29hint{font-size:12px;color:#a87f2c;margin:4px 0 0;}' +
    '.w29hint a{cursor:pointer;text-decoration:underline;}';
  document.head.appendChild(st);
})();

function wa29QKey(q) {
  var m = String(q || '').match(/FY\s*(\d{4})/i);
  var fy = m ? Number(m[1]) : 0;
  var qm = String(q || '').match(/Q(\d)/i);
  return fy * 10 + (qm ? Number(qm[1]) : 0);
}

function wa29Goals() {
  return (typeof GOALS_CACHE !== 'undefined' ? GOALS_CACHE : []).filter(function (g) { return g.status !== 'archived'; });
}

/* ---------- goals page: quarter > department > goals ---------- */
if (typeof renderGoalsPage === 'function') {
  /* dead: wave30 reset renderGoalsPage again without capture; removed in Phase 0 compaction */
}

/* ---------- goal editor ---------- */
function wa29GoalModal(gid, presetDept, presetQ) { /* superseded: wave30 reset without capture; superseded; body removed in Phase 0 compaction */ }

/* ---------- dept preview cards link through ---------- */
if (typeof renderDeptGoalsCards === 'function') {
  (function () {
    /* dead wrap: wave43 reset renderDeptGoalsCards without capture; removed in Phase 0 compaction */
  })();
