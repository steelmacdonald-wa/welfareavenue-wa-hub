            return;
          }
          var s = document.getElementById('w195sheet'); if (s) closeSheet();
          return await __vr195.apply(this, arguments);
        };
        waVolRender.__w195 = true;
      }
    } else ok = false;
    if (typeof waVolShell === 'function') {
      if (!waVolShell.__w195) {
