      card.querySelector('.wa-sop-toolbar').scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
      card.querySelector(':scope > .vl-phase:not([hidden]) > summary')?.focus({ preventScroll: true }); return;
    }
    if (target.closest('.wa-sop-all')) { ui.stage = 'all'; ui.folded = {}; update(card); return; }
    if (target.closest('.wa-sop-unassigned')) { ui.unassigned = !ui.unassigned; ui.folded = {}; update(card); return; }
    if (target.closest('.wa-sop-clear')) { ui.stage = 'all'; ui.query = ''; ui.unassigned = false; ui.folded = {}; card.querySelector('.wa-sop-search input').value = ''; update(card); return; }
    if (target.closest('.wa-sop-expand')) {
      var open = target.closest('button').textContent === 'Expand all';
      card.querySelectorAll(':scope > .vl-phase:not([hidden])').forEach(function (p) { ui.open[p.dataset.waSopSection] = open; ui.folded[p.dataset.waSopSection] = !open; p.open = open; }); update(card); return;
    }
    if (target.closest('.wa-sop-bundles-link')) { var role = card.querySelector('.wa-sop-role-bundles'); role.open = true; role.scrollIntoView({ behavior: 'smooth', block: 'center' }); role.querySelector('summary').focus({ preventScroll: true }); return; }
    if (target.closest('.wa-sop-new')) { card.querySelector('[data-w25sec]')?.click(); return; }
    if (target.closest('.wa-sop-subline [data-vlmore]')) requestAnimationFrame(function () { var b = target.closest('[data-vlmore]'); attr(b, 'aria-expanded', b.closest('.vl-step').querySelector('.vl-det')?.classList.contains('open')); });
  });
  document.addEventListener('input', function (event) {
    if (event.target.matches('.wa-sop-search input')) { ui.query = event.target.value; ui.folded = {}; update(currentCard()); }
    if (event.target.matches('.wa-sop-person-search input')) filterPeople(event.target.value);
  });
  document.addEventListener('change', function (event) { if (event.target.matches('.wa-sop-workspace select[data-vlowner], .wa-sop-workspace select[data-w47rb]')) { syncOwner(event.target); schedule(); } });
  document.addEventListener('toggle', function (event) {
    var phase = event.target;
    if (!phase.matches('.wa-sop-workspace > .vl-phase')) return;
    var automated = phase._waSopExpected === phase.open; delete phase._waSopExpected;
    if (!automated && phase.dataset.waSopSection) { ui.open[phase.dataset.waSopSection] = phase.open; if (phase.dataset.waSopFiltering === 'true') ui.folded[phase.dataset.waSopSection] = !phase.open; }
    var card = currentCard(), button = card?.querySelector('.wa-sop-expand');
    if (button) { var all = Array.from(card.querySelectorAll(':scope > .vl-phase:not([hidden])')); text(button, all.length && all.every(function (p) { return p.open; }) ? 'Collapse all' : 'Expand all'); }
  }, true);
  document.addEventListener('keydown', function (event) {
    if (popup && event.key === 'Escape') { event.preventDefault(); event.stopImmediatePropagation(); closePopup(true); return; }
    if (popup && event.key === 'Tab' && popup.panel.contains(event.target)) { closePopup(true); return; }
    if (popup && ['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key) && popup.panel.contains(event.target)) {
      if (event.target.matches('.wa-sop-person-search input') && ['Home', 'End'].includes(event.key)) return;
      event.preventDefault(); event.stopImmediatePropagation(); var choices = Array.from(popup.panel.querySelectorAll('.wa-sop-person:not([hidden]), .wa-sop-action:not(:disabled)')), i = choices.indexOf(document.activeElement);
      var at = event.key === 'Home' ? 0 : event.key === 'End' ? choices.length - 1 : i === -1 ? (event.key === 'ArrowDown' ? 0 : choices.length - 1) : (i + (event.key === 'ArrowDown' ? 1 : choices.length - 1)) % choices.length;
      choices[at]?.focus({ preventScroll: true }); return;
    }
    if (event.target.matches('.wa-sop-person-search input') && event.key === 'Enter') { event.preventDefault(); popup?.panel.querySelector('.wa-sop-person:not([hidden])')?.click(); return; }
    if (event.target.matches('.wa-sop-workspace [role="button"]:not(button)') && ['Enter', ' '].includes(event.key)) { event.preventDefault(); event.target.click(); }
  }, true);
  document.addEventListener('focusin', function (event) { if (popup && !popup.panel.contains(event.target) && !popup.trigger.contains(event.target)) closePopup(false); });
  document.addEventListener('scroll', positionPopup, true); window.addEventListener('resize', positionPopup); window.addEventListener('hashchange', function () { closePopup(false); schedule(); });
  function boot() { var section = document.getElementById('volunteering'); if (!section) return;
    new MutationObserver(function (records) { if (records.some(function (r) { return !r.target.closest || !r.target.closest('[data-wa-enhancement]'); })) schedule(); }).observe(section, { childList: true, subtree: true }); schedule();
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot); else boot();
})();

(function () {
  var style = document.createElement("style");
  style.id = "wa-ui-applicants";
  style.textContent = "/* Quiet motion and compact, legible people workflows. */\n#w209v,#w256,#w195 { --people-line:#dce1d8; --people-muted:#6b756f; }\n.wa-people-enter { animation:wa-people-enter 180ms ease-out; }\n@keyframes wa-people-enter { from { opacity:.55; transform:translateY(5px); } to { opacity:1; transform:none; } }\n#volunteering :is(button,a,summary,input,select,textarea) { transition:background-color 140ms ease,border-color 140ms ease,box-shadow 140ms ease,color 140ms ease; }\n#volunteering :is(button,a,summary,input,select,textarea):focus-visible { outline:2px solid #b9851b; outline-offset:3px; }\n\n/* The applicant's message and two distinct states are the scanning surface. */\n#w209v .w209lead { max-width:64em; color:var(--people-muted); line-height:1.6; margin:0 0 18px; }\n#w209v .w209bar { margin-bottom:12px; gap:10px; }\n#w209v .w209filt { margin:0 0 18px; }\n#w209v .w209filt :is(input,select) { border-radius:10px; min-height:40px; font-size:13px; }\n#w209v .w209list { align-items:start; gap:14px; grid-template-columns:repeat(2,minmax(0,1fr)); }\n#w209v .w209app { background:#fffcf7; padding:18px 18px 0; border:1px solid var(--people-line); border-radius:16px; overflow:hidden; box-shadow:0 2px 5px #103f3904; }\n#w209v .w209hd { align-items:center; margin-bottom:13px; }\n#w209v .w209hd b { font-size:17px; letter-spacing:-.2px; line-height:1.3; overflow-wrap:anywhere; }\n.wa-app-signals { display:flex; flex-wrap:wrap; gap:12px 22px; margin-bottom:14px; }\n.wa-app-signals > span { display:flex; flex-direction:column; align-items:flex-start; gap:5px; }\n.wa-app-signals small { font-size:10px; text-transform:uppercase; font-weight:700; letter-spacing:.8px; color:var(--people-muted); }\n#w209v :is(.w209st,.wa-app-review) { font-size:11px; font-weight:650; line-height:1.5; padding:3px 9px; border-radius:6px; display:inline-flex; align-items:center; gap:5px; }\n.wa-app-review::before { content:'\u25cf'; font-size:7px; }\n.wa-app-review.clear { background:#e7efea; color:#286653; }\n.wa-app-review.flagged { background:#f9e9dd; color:#9b4626; }\n.wa-app-review.unknown { background:#eeefea; color:#64716b; }\n#w209v .w209msg { font-size:13px; line-height:1.65; padding:0; margin:0 0 16px; min-height:110px; background:transparent; }\n#w209v .w209msg .link { font-size:12px; padding:0 2px; font-weight:700; }\n#w209v .wa-app-no-message { color:var(--people-muted); font-style:italic; }\n.wa-app-details { border-top:1px solid var(--people-line); margin:0 -18px; }\n.wa-app-details > summary { list-style:none; display:flex; align-items:center; justify-content:space-between; min-height:45px; padding:10px 18px; box-sizing:border-box; color:#103f39; font-size:12px; font-weight:650; cursor:pointer; background:#f4f5ee; -webkit-user-select:none; user-select:none; }\n.wa-app-details > summary::-webkit-details-marker { display:none; }\n.wa-app-details > summary:hover { background:#eaf0e8; }\n.wa-app-details > summary span { font-size:18px; line-height:1; transition:transform 180ms ease; }\n.wa-app-details[open] > summary span { transform:rotate(180deg); }\n.wa-app-body { padding:14px 18px 18px; }\n#w209v .w209roles2 { margin:0 0 9px; }\n#w209v .w209roles2 small { display:none; }\n#w209v .w209meta { font-size:11.5px; line-height:1.6; }\n#w209v .w209ct { display:flex; flex-wrap:wrap; gap:4px; font-size:12px; line-height:1.6; margin:8px 0 12px; }\n#w209v .w209ct a { overflow-wrap:anywhere; }\n#w209v .w209do { border-top:1px solid var(--people-line); padding-top:12px; margin-top:12px; gap:7px; }\n#w209v .w209do input { flex-basis:100%; min-height:36px; }\n#w209v .w209acts { gap:7px; }\n#w209v .w209do .w197b,#w209v .w209acts .w197b { font-size:11.5px; min-height:29px; }\n.wa-app-review-note { background:#fbefdf; color:#864c20; padding:9px 10px; border-radius:8px; font-size:12px; line-height:1.5; margin:0 0 12px; }\n#w209v .w257up { border-top:1px solid var(--people-line); padding-top:10px; margin-top:10px; font-size:12px; }\n\n\n@media(max-width:760px){#w209v .w209list{grid-template-columns:1fr;}.wa-app-signals{gap:10px 16px;}}\n@media(prefers-reduced-motion:reduce){#volunteering :is(button,a,summary,input,select,textarea){transition:none;}}\n";
  document.head.appendChild(style);
})();
/* Animate the existing applicant disclosure while preserving its original controls. */
(function () {
  const animations = new WeakMap();
  document.addEventListener('click', event => {
    const summary = event.target.closest?.('.wa-app-details > summary');
    if (!summary || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const details = summary.parentElement;
    if (typeof details.animate !== 'function') return;
    event.preventDefault();
    if (animations.has(details)) return;
    const start = details.getBoundingClientRect().height;
    const opening = !details.open;
    if (opening) details.open = true;
    const end = opening ? details.getBoundingClientRect().height : summary.getBoundingClientRect().height;
    details.style.overflow = 'hidden';
    const animation = details.animate([{ height: start + 'px' }, { height: end + 'px' }], {
      duration: 180, easing: 'cubic-bezier(.2,.7,.2,1)'
    });
    animations.set(details, animation);
    animation.onfinish = () => {
      details.open = opening;
      details.style.overflow = '';
      animations.delete(details);
    };
    animation.oncancel = () => {
      details.style.overflow = '';
      animations.delete(details);
    };
  });
})();

