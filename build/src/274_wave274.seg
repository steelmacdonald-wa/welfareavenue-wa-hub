  style.textContent = "/* A focused master-checklist editor, using the existing Welfare Avenue palette. */\n#volunteering .wa-sop-workspace .wa-sop-context {border:1px solid #dfe4d9;border-radius:10px;background:#f0f3e9;margin:0 0 16px;padding:0 13px}\n#volunteering .wa-sop-context > summary {display:flex;align-items:center;gap:10px;list-style:none;cursor:pointer;padding:11px 0;font:400 11px/1.5 'Space Grotesk',sans-serif;color:#677565}\n#volunteering .wa-sop-context > summary::-webkit-details-marker {display:none}\n#volunteering .wa-sop-context > summary b {font-size:12px;color:#103f39;white-space:nowrap}\n#volunteering .wa-sop-context-link {margin-left:auto;white-space:nowrap;color:#103f39;font-weight:600}\n#volunteering .wa-sop-context > p {font:400 12px/1.7 'Space Grotesk',sans-serif;color:#677565;margin:0;padding:10px 0;border-top:1px solid #103f3915}\n#volunteering .wa-sop-workspace #w191legend {display:block;margin:0 0 24px;padding:20px;background:#103f39;border:1px solid #103f39;border-radius:18px;position:relative;overflow:hidden}\n#volunteering .wa-sop-workspace #w191legend > .lg {display:none}\n#volunteering .wa-sop-journey-head {display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:17px}\n#volunteering .wa-sop-eyebrow {display:block;color:#e3b743;font:600 9px 'Space Grotesk',sans-serif;letter-spacing:1.7px;margin-bottom:6px}\n#volunteering .wa-sop-journey-head h2 {font:600 25px/1.15 'Barlow Condensed',sans-serif;letter-spacing:.2px;color:#fffaf2;margin:0}\n#volunteering .wa-sop-journey-head p {font:400 11px/1.5 'Space Grotesk',sans-serif;color:#b8ccc4;margin:6px 0 0}\n#volunteering .wa-sop-total {flex:none;border:1px solid #fffaf22b;background:#fffaf20c;border-radius:999px;padding:5px 9px;color:#e5eee5;font:500 10px 'Space Grotesk',sans-serif;white-space:nowrap;margin-top:14px}\n#volunteering .wa-sop-journey {display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px}\n#volunteering .wa-sop-stage {display:flex;flex-direction:column;min-width:0;text-align:left;background:#fffaf2;border:1px solid #fffaf2;border-radius:11px;padding:12px;color:#103f39;cursor:pointer;position:relative;transition:transform .15s,border-color .15s;box-shadow:none}\n#volunteering .wa-sop-stage:hover {transform:translateY(-2px);border-color:#e5b63e}\n#volunteering .wa-sop-stage[aria-pressed=true] {border-color:#e5b63e;box-shadow:inset 0 0 0 1px #e5b63e;background:#fff7e6}\n#volunteering .wa-sop-stage-top {display:flex;align-items:center;gap:8px;margin-bottom:9px}\n#volunteering .wa-sop-stage-icon {display:flex;align-items:center;justify-content:center;width:29px;height:29px;flex:none;border-radius:9px;background:var(--sop-paper);color:var(--sop-ink)}\n#volunteering .wa-sop-stage-icon svg {width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}\n#volunteering .wa-sop-stage-number {font:600 10px 'Space Grotesk',sans-serif;color:#879083}\n#volunteering .wa-sop-stage-arrow {margin-left:auto;font:400 16px 'Space Grotesk',sans-serif;color:var(--sop-ink)}\n#volunteering .wa-sop-stage > b {font:600 15px/1.25 'Space Grotesk',sans-serif;color:#103f39}\n#volunteering .wa-sop-stage-description {display:block;font:400 11.5px/1.5 'Space Grotesk',sans-serif;color:#748071;margin:5px 0 9px;min-height:0}\n#volunteering .wa-sop-stage-bottom {display:flex;flex-direction:column;gap:5px;margin-top:auto;padding-top:9px;border-top:1px solid #103f3910;font:500 10.5px 'Space Grotesk',sans-serif;color:var(--sop-ink)}\n#volunteering .wa-sop-stage-count {font-size:11px;font-weight:600;color:#103f39}\n#volunteering .wa-sop-stage-count[data-missing=true] {color:#9a6b1c}\n#volunteering .wa-sop-toolbar {margin:0 0 14px;font-family:'Space Grotesk',sans-serif}\n#volunteering .wa-sop-toolbar-head {display:flex;align-items:center;gap:14px;justify-content:space-between;margin-bottom:12px}\n#volunteering .wa-sop-toolbar-head h3 {font:600 21px/1.25 'Barlow Condensed',sans-serif;text-transform:uppercase;letter-spacing:.3px;margin:0;color:#103f39}\n#volunteering .wa-sop-result {display:block;font-size:10.5px;color:#7a8175;margin-top:3px}\n#volunteering .wa-sop-workspace .wa-sop-new {border:0;border-radius:8px;background:#103f39;color:#fffaf2;font:600 11px 'Space Grotesk',sans-serif;padding:9px 12px;cursor:pointer;white-space:nowrap}\n#volunteering .wa-sop-controls {display:flex;gap:8px;align-items:center}\n#volunteering .wa-sop-search {display:flex;align-items:center;gap:9px;flex:1;min-width:0;padding:0 12px;border:1px solid #d9e0d4;border-radius:9px;background:#fffdf8}\n#volunteering .wa-sop-search svg {width:16px;height:16px;fill:none;stroke:#81907e;stroke-width:1.7;flex:none}\n#volunteering .wa-sop-search input {border:0;background:transparent;box-shadow:none;border-radius:0;padding:11px 0;width:100%;min-width:0;font:400 12px 'Space Grotesk',sans-serif;color:#103f39}\n#volunteering .wa-sop-search input:focus {outline:0}\n#volunteering .wa-sop-search:focus-within {outline:2px solid #467a68;outline-offset:2px}\n#volunteering .wa-sop-toolbar button:not(.wa-sop-new) {background:transparent;border:1px solid #d9e0d4;border-radius:8px;color:#103f39;cursor:pointer;font:500 10.5px 'Space Grotesk',sans-serif;padding:8px 10px;white-space:nowrap}\n#volunteering .wa-sop-toolbar .wa-sop-unassigned[aria-pressed=true] {background:#fbefd6;color:#8a6016;border-color:#e3c474}\n#volunteering .wa-sop-filter-row {display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-top:10px}\n#volunteering .wa-sop-filter-label {font-size:9.5px;color:#83907d}\n#volunteering .wa-sop-filter-row .wa-sop-all[aria-pressed=true] {background:#eaf1e7;border-color:#cbd9c6;color:#35674f}\n#volunteering .wa-sop-filter-row .wa-sop-clear {text-decoration:underline;border-color:transparent!important;padding-left:2px!important;color:#6c7e67!important}\n#volunteering .wa-sop-spacer {flex:1}\n#volunteering .wa-sop-workspace #w65sophint,#volunteering .wa-sop-workspace .wa25-secadd {display:none}\n#volunteering .wa-sop-workspace > .vl-phase {border:1px solid #dbe2d4;border-radius:12px;background:#fffdf8;margin-bottom:10px;overflow:visible;box-shadow:none}\n#volunteering .wa-sop-workspace > .vl-phase[open] {border-color:#bbccba}\n#volunteering .wa-sop-workspace > .vl-phase > summary {display:flex;align-items:center;gap:11px;padding:14px;cursor:pointer;border-radius:12px;background:transparent;list-style:none}\n#volunteering .wa-sop-workspace > .vl-phase > summary:before {display:none}\n#volunteering .wa-sop-workspace > .vl-phase > summary::-webkit-details-marker {display:none}\n#volunteering .wa-sop-workspace > .vl-phase > summary:hover {background:#f4f6ee}\n#volunteering .wa-sop-workspace > .vl-phase[open] > summary {border-radius:12px 12px 0 0}\n#volunteering .wa-sop-section-icon {display:flex;align-items:center;justify-content:center;width:32px;height:32px;background:var(--sop-paper);color:var(--sop-ink);border-radius:9px;flex:none}\n#volunteering .wa-sop-section-icon svg {width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}\n#volunteering .wa-sop-section-name {display:block;flex:1;min-width:0}\n#volunteering .wa-sop-section-name > b {display:block;font:600 13px/1.4 'Space Grotesk',sans-serif;color:#103f39}\n#volunteering .wa-sop-section-meta {display:block;font:400 10px/1.4 'Space Grotesk',sans-serif;color:#7b8774;margin-top:3px}\n#volunteering .wa-sop-section-count {padding:4px 7px;border-radius:6px;background:var(--sop-paper);color:var(--sop-ink);font:600 10px 'Space Grotesk',sans-serif;white-space:nowrap}\n.wa-sop-chevron {width:6px;height:6px;border-right:1.5px solid currentColor;border-bottom:1.5px solid currentColor;transform:translateY(-2px) rotate(45deg);flex:none;margin-left:3px}\n#volunteering .wa-sop-workspace > .vl-phase[open] > summary > .wa-sop-chevron {transform:translateY(1px) rotate(225deg)}\n#volunteering .wa-sop-workspace .vl-phase > .vl-body {padding:11px;border-top:1px solid #e3e8dd;background:#f2f4ec;border-radius:0 0 12px 12px}\n#volunteering .wa-sop-workspace .vl-step {display:grid;grid-template-columns:12px minmax(0,1fr) 152px auto;align-items:center;column-gap:10px;row-gap:5px;border:1px solid #e0e5da;border-radius:9px;background:#fffdf8;padding:12px;margin-bottom:8px;font-family:'Space Grotesk',sans-serif;box-shadow:none}\n#volunteering .wa-sop-workspace .vl-step:last-of-type {margin-bottom:0}\n#volunteering .wa-sop-workspace .vl-step.vl-d1 {margin-left:18px}\n#volunteering .wa-sop-workspace .vl-step.vl-d2 {margin-left:36px}\n#volunteering .wa-sop-workspace .vl-step.vl-d3 {margin-left:54px}\n#volunteering .wa-sop-workspace .vl-step > input[type=checkbox],#volunteering .wa-sop-workspace .wa24-sx {display:none!important}\n#volunteering .wa-sop-workspace .vl-step > .w65h {position:static;grid-column:1;grid-row:1/3;align-self:center;width:12px;height:auto;color:#a5b09b;cursor:grab;font-size:12px;line-height:1.2;padding:0;margin:0;letter-spacing:-2px}\n#volunteering .wa-sop-workspace .vl-step > .vl-t {display:contents}\n#volunteering .wa-sop-workspace .vl-step .vl-name {display:flex;align-items:center;gap:5px;flex-wrap:wrap;grid-column:2;grid-row:1;min-width:0;padding:0;font-size:14px;line-height:1.5;color:#173e34;font-weight:500}\n#volunteering .wa-sop-workspace .vl-step .vl-name > .w191stg {display:none}\n#volunteering .wa-sop-workspace .vl-step .vl-meta {display:flex;align-items:center;grid-column:3;grid-row:1/3;padding:0;margin:0;min-width:0;font-size:11px}\n#volunteering .wa-sop-workspace .vl-step .vl-meta input[type=date],#volunteering .wa-sop-workspace select[data-wa-sop-ready] {display:none!important}\n#volunteering .wa-sop-workspace .vl-meta > .w59role,#volunteering .wa-sop-workspace .vl-meta > .w59sel {display:none!important}\n#volunteering .wa-sop-subline {display:flex;align-items:center;gap:10px;grid-column:2;grid-row:2;min-height:15px}\n#volunteering .wa-sop-workspace .wa-sop-subline .vl-more {background:transparent;border:0;box-shadow:none;padding:0;margin:0;font:500 10px/1.4 'Space Grotesk',sans-serif;color:#72846b;cursor:pointer;text-decoration:underline;text-underline-offset:2px}\n#volunteering .wa-sop-help {font-size:10px;color:#467a68}\n#volunteering .wa-sop-workspace .vl-step .vl-det {grid-column:2/-1;grid-row:3;display:none;font:400 12px/1.7 'Space Grotesk',sans-serif;border:0;border-top:1px solid #e3e8db;background:transparent;border-radius:0;margin:8px 0 0;padding:10px 0 0;color:#67755f}\n#volunteering .wa-sop-workspace .vl-step .vl-det.open {display:block}\n#volunteering .wa-sop-workspace .vl-step .vl-det p {margin:0}\n#volunteering .wa-sop-step-tools {display:flex;align-items:center;gap:4px;grid-column:4;grid-row:1/3}\n#volunteering .wa-sop-workspace .wa-sop-step-tools button,#volunteering .wa-sop-workspace .w46row > .wa-sop-more {border:1px solid #dce2d5;border-radius:7px;background:transparent;color:#5e7455;font:500 10px 'Space Grotesk',sans-serif;padding:7px 8px;cursor:pointer}\n#volunteering .wa-sop-workspace .wa-sop-step-tools .wa-sop-more,#volunteering .wa-sop-workspace .w46row > .wa-sop-more {font-size:17px;line-height:1;padding:5px 7px;width:28px}\n#volunteering .wa-sop-workspace .wa-sop-owner {display:flex;align-items:center;gap:7px;min-width:0;width:100%;border:1px solid #dce3d6;border-radius:8px;background:#f0f4eb;color:#31563e;padding:6px 8px;min-height:35px;font:500 11.5px 'Space Grotesk',sans-serif;cursor:pointer;text-align:left}\n#volunteering .wa-sop-owner-name {flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.wa-sop-avatar {display:inline-flex;align-items:center;justify-content:center;width:21px;height:21px;flex:none;background:#dae7d5;border-radius:50%;color:#3f694b;font:600 8px 'Space Grotesk',sans-serif}\n#volunteering .wa-sop-workspace .wa-sop-owner[data-empty=true] {background:#fcf3dd;border-color:#e8d6a9;color:#8b691e}\n#volunteering .wa-sop-owner[data-empty=true] .wa-sop-avatar {background:#efdfb3;color:#8b691e}\n#volunteering .wa-sop-owner[aria-expanded=true] {border-color:#5c8360;box-shadow:0 0 0 2px #e1ebdc}\n#volunteering .wa-sop-owner:disabled {cursor:default;opacity:.6}\n#volunteering .wa-sop-workspace .wa-sop-role-bundles {margin-top:22px;border:1px solid #dbe2d5;border-radius:12px;background:#f2f4ec}\n#volunteering .wa-sop-role-bundles > summary {display:flex;align-items:center;gap:9px;padding:14px;list-style:none;cursor:pointer;font:400 10.5px 'Space Grotesk',sans-serif;color:#7b8973}\n#volunteering .wa-sop-role-bundles > summary::-webkit-details-marker {display:none}\n#volunteering .wa-sop-role-bundles > summary:after {content:'\u2304';font-size:17px;color:#66825a}\n#volunteering .wa-sop-role-bundles > summary b {font-size:12px;color:#31563e}\n#volunteering .wa-sop-role-count {margin-left:auto;font-size:10px;color:#5e7753}\n#volunteering .wa-sop-workspace #w47roles {background:transparent;border-radius:0;padding:0 14px 14px;margin:0}\n#volunteering .wa-sop-workspace #w47roles > h4 {display:none}\n#volunteering .wa-sop-workspace #w47roles > p {font:400 11px/1.6 'Space Grotesk',sans-serif;color:#78876e;max-width:650px}\n#volunteering .wa-sop-workspace #w47roles .w46row {display:grid;grid-template-columns:minmax(100px,1fr) 74px 150px auto 28px;gap:10px;align-items:center;padding:12px 0;border-bottom:1px solid #dfe5d6}\n#volunteering .wa-sop-workspace #w47roles .w46row > b {min-width:0!important;font-size:12px;color:#31563e}\n#volunteering .wa-sop-workspace #w47roles .w46days {font-size:9.5px;color:#78876e;white-space:nowrap}\n#volunteering .wa-sop-workspace #w47roles [data-w47rd] {display:none}\n#volunteering .wa-sop-workspace #w47roles [data-w47re],#volunteering .wa-sop-workspace #w47roles [data-w47ra] {font-size:10px;padding:7px 9px;border:1px solid #d5dfcd;border-radius:8px;white-space:nowrap;cursor:pointer;background:#fffdf8;color:#46663a;text-decoration:none}\n#volunteering .wa-sop-workspace .wa-sop-no-results {padding:28px;text-align:center;border:1px dashed #c7d5be;background:#f2f5ed;border-radius:12px;font:400 12px/1.5 'Space Grotesk',sans-serif;color:#728367;margin-bottom:14px}\n#volunteering .wa-sop-no-results b {color:#355b3d;font-weight:600}\n#volunteering .wa-sop-no-results p {margin:5px 0 12px}\n#volunteering .wa-sop-no-results button {border:1px solid #c9d7bf;border-radius:8px;padding:8px 12px;color:#355b3d;background:#fffdf8;font:600 11px 'Space Grotesk',sans-serif;cursor:pointer}\n#volunteering .wa-sop-workspace [hidden] {display:none!important}\n#volunteering .wa-sop-workspace button:focus-visible,#volunteering .wa-sop-workspace summary:focus-visible,#volunteering .wa-sop-workspace [role=button]:focus-visible {outline:2px solid #6e9464;outline-offset:3px}\n.wa-sop-popup {position:fixed;z-index:1900;max-width:calc(100vw - 24px);max-height:calc(100dvh - 24px);overflow:auto;background:#fffdf8;border:1px solid #d9e1d1;border-radius:12px;box-shadow:0 14px 40px #103f3922;font:400 12px/1.5 'Space Grotesk',sans-serif;color:#31563e;padding:7px;text-align:left}\n.wa-sop-people {width:260px}\n.wa-sop-person-search {display:flex;align-items:center;gap:9px;border:1px solid #dce4d4;border-radius:8px;padding:0 10px;margin:2px 2px 7px;background:#f7f9f2}\n.wa-sop-person-search svg {width:15px;height:15px;fill:none;stroke:#8a9a7f;stroke-width:1.7;flex:none}\n.wa-sop-person-search input {border:0;background:transparent;width:100%;min-width:0;padding:10px 0;font:400 12px 'Space Grotesk',sans-serif;color:#31563e;outline:none}\n.wa-sop-person-search:focus-within {border-color:#66845c;box-shadow:0 0 0 2px #e4eddd}\n.wa-sop-person-list {display:flex;flex-direction:column;gap:2px;max-height:280px;overflow:auto}\n.wa-sop-person {display:flex;align-items:center;gap:9px;border:0;background:transparent;color:#49643d;text-align:left;cursor:pointer;border-radius:7px;padding:8px;font:500 11px 'Space Grotesk',sans-serif}\n.wa-sop-person > span:nth-child(2) {flex:1}\n.wa-sop-person-check {visibility:hidden}\n.wa-sop-person[aria-selected=true] {background:#edf3e5}\n.wa-sop-person[aria-selected=true] .wa-sop-person-check {visibility:visible}\n.wa-sop-person:hover,.wa-sop-person:focus-visible {background:#edf3e5;outline:0}\n.wa-sop-person-empty {padding:8px;text-align:center;font-size:11px;color:#7c8d70;margin:0}\n.wa-sop-popup [hidden] {display:none!important}\n.wa-sop-actions {width:180px}\n.wa-sop-action {display:block;width:100%;padding:9px 10px;border:0;border-radius:7px;background:transparent;font:500 11px 'Space Grotesk',sans-serif;color:#49643d;cursor:pointer;text-align:left}\n.wa-sop-action:hover,.wa-sop-action:focus-visible {background:#edf3e5;outline:0}\n.wa-sop-action:disabled {color:#aab3a3;cursor:default;background:transparent}\n.wa-sop-action.danger {color:#ac5143;border-top:1px solid #e9e8df;margin-top:4px;padding-top:11px}\n@media(max-width:900px) {\n  #volunteering .wa-sop-filter-label {display:none}\n  #volunteering .wa-sop-workspace .vl-step {grid-template-columns:10px minmax(0,1fr) 132px auto;column-gap:8px;padding:10px}\n  #volunteering .wa-sop-step-tools .wa-sop-edit {display:none}\n  #volunteering .wa-sop-stage-description {min-height:31px}\n}\n@media(max-width:700px) {\n  #volunteering .wa-sop-workspace #w191legend {padding:14px}\n  #volunteering .wa-sop-journey {grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}\n  #volunteering .wa-sop-total {display:none}\n  #volunteering .wa-sop-context > summary > span:not(.wa-sop-context-link) {display:none}\n  #volunteering .wa-sop-stage {padding:10px}\n  #volunteering .wa-sop-stage-description {min-height:31px}\n  #volunteering .wa-sop-filter-row {gap:5px}\n  #volunteering .wa-sop-filter-label {display:none}\n  #volunteering .wa-sop-controls {flex-wrap:wrap}\n  #volunteering .wa-sop-search {flex-basis:100%}\n  #volunteering .wa-sop-workspace .vl-step {grid-template-columns:10px minmax(0,1fr) auto}\n  #volunteering .wa-sop-workspace .vl-step .vl-name {grid-column:2/-1;grid-row:1;padding-right:26px}\n  #volunteering .wa-sop-workspace .vl-step .vl-meta {grid-column:2;grid-row:3;width:150px;margin-top:5px}\n  #volunteering .wa-sop-subline {grid-column:2;grid-row:2}\n  #volunteering .wa-sop-step-tools {grid-column:3;grid-row:3;justify-self:end;margin-top:5px}\n  #volunteering .wa-sop-workspace .vl-step .vl-det {grid-column:2/-1;grid-row:4}\n  #volunteering .wa-sop-workspace .vl-step > .w65h {grid-row:1/4}\n  #volunteering .wa-sop-role-bundles > summary > span {display:none}\n  #volunteering .wa-sop-workspace #w47roles .w46row {grid-template-columns:minmax(0,1fr) auto 28px;gap:8px}\n  #volunteering .wa-sop-workspace #w47roles .w46row > b {grid-column:1;grid-row:1}\n  #volunteering .wa-sop-workspace #w47roles .w46days {grid-column:2;grid-row:1}\n  #volunteering .wa-sop-workspace #w47roles .wa-sop-owner {grid-column:1;grid-row:2}\n  #volunteering .wa-sop-workspace #w47roles [data-w47re] {grid-column:2;grid-row:2}\n  #volunteering .wa-sop-workspace #w47roles .wa-sop-more {grid-column:3;grid-row:2}\n}\n@media(prefers-reduced-motion:reduce) {#volunteering .wa-sop-stage {transition:none}}\n";
  document.head.appendChild(style);
})();
