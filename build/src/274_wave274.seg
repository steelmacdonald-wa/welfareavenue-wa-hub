    + '#toronto > .w118mast > p{color:var(--t-mut);font-size:14px;}'   /* the Hub muted on the page ground is 4.0:1; this is 5.8:1 */
    + '#toronto > .w118mast .w274cnt{display:inline-block;vertical-align:.32em;margin-left:10px;padding:3px 11px;border-radius:999px;background:var(--t-act);color:var(--t-ink);font:600 15px/1.3 ' + BODY + ';font-variant-numeric:tabular-nums;}'
    + '#toronto > .w118mast .w274back{display:inline-flex;align-items:center;gap:6px;min-height:36px;margin:0 0 2px -2px;color:var(--t-ac);font:600 14px/1 ' + BODY + ';text-decoration:none;white-space:nowrap;border-radius:8px;' + TAP + '}'
    + '#toronto > .w118mast .w274back svg{width:18px;height:18px;flex:0 0 18px;}'
