    setText(label, shown ? 'NEEDS PEOPLE' : '\u2713 Every role filled');
  }
  function toolbar(team) {
    var tools = team.querySelector('.wa-roster-tools'), s = state();
    if (!tools) {
      tools = node('div', 'wa-roster-tools');
