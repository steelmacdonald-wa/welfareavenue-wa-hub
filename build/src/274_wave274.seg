    + '#toronto .w274btn svg,#w274sheet .w274btn svg{width:18px;height:18px;flex:0 0 18px;}'
    + '#toronto .w274ib,#w274sheet .w274ib{display:inline-grid;place-items:center;width:44px;height:44px;flex:0 0 44px;padding:0;border:0;border-radius:10px;background:none;color:var(--t-green);cursor:pointer;' + TAP + 'transition:transform 160ms ' + OUT + ',background-color 200ms ' + OUT + ';}'
