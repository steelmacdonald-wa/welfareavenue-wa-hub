/* =====================================================================
   WA v24 navigation embedding and SOP master editing (27/07/26)
   1. Volunteering and Create leave the top bar and become buttons inside
      their home departments (Ops Montreal and Marketing). The Finances
      button moves out from behind the fundraising banner photo into a
      visible quick-links row. Pages stay reachable at their hashes.
   2. Volunteers table: cooks show an Address column, drivers show a Car
      column, filters count tags from the volunteers file too.
   3. The SOP tab becomes the master editor: staff edit a step's name,
      assignee, help link and notes in one place. Names, notes and help
      links render from the template everywhere instantly; assignee
      changes propagate to upcoming planned events via a database
      trigger, leaving in-progress events alone.
   ===================================================================== */

var WA24_EDIT = false;

(function () {
  if (document.getElementById('wa24css')) return;
  var css = '' +
    '.wa24-links{display:flex;gap:8px;flex-wrap:wrap;margin:14px 0 4px;}' +
    '.wa24-links button{background:#2c7a66;color:#fff;border:0;border-radius:9px;padding:8px 15px;font-size:13px;font-weight:600;cursor:pointer;}' +
    '.wa24-links button:hover{filter:brightness(1.1);}' +
    '.wa24-sx{display:flex;gap:7px;align-items:center;flex-wrap:wrap;margin:2px 0 8px 26px;font-size:11px;}' +
    '.wa24-sx .who{border:1px solid rgba(127,127,127,.4);border-radius:8px;padding:1px 8px;color:var(--wa-muted,#7b8a86);}' +
    '.wa24-sx a.help{color:#2c7a66;text-decoration:underline;}' +
    '.wa24-sx a.ed{color:#2c7a66;cursor:pointer;text-decoration:underline;opacity:.85;}';
  var st = document.createElement('style');
  st.id = 'wa24css';
  st.textContent = css;
  document.head.appendChild(st);
})();

/* ---------- 1. nav embedding ---------- */
function wa24Nav() {
  var bar = document.getElementById('tabBar');
  if (!bar) return;
  ['volunteering', 'create'].forEach(function (id) {
    var b = bar.querySelector('[data-tab="' + id + '"]');
    if (b) b.remove();
  });
}

function wa24Links(id) {
  var map = {
    opsmtl: [['#volunteering', 'Volunteering programme']],
    marketing: [['#create', 'Create content']],
    fundraising: [['#finances', 'Finances and budgeting']]
  };
  var links = map[id];
  if (!links) return;
  if (typeof isStaff === 'function' && !isStaff()) return;
  var card = document.querySelector('#' + id + ' .dept-card');
  if (!card || card.querySelector('.wa24-links')) return;
  var old = card.querySelector('[data-fin-open]');
  if (old) old.remove();
  var row = document.createElement('div');
  row.className = 'wa24-links';
  links.forEach(function (l) {
    var b = document.createElement('button');
    b.innerHTML = l[1] + ' &raquo;';
    b.addEventListener('click', function () { location.hash = l[0]; });
    row.appendChild(b);
  });
  var anchor = card.querySelector('.dept-banner') || card.querySelector('h2');
  if (anchor) anchor.insertAdjacentElement('afterend', row);
  else card.insertBefore(row, card.firstChild);
}

/* ---------- 2. volunteers table with address and car ---------- */
if (typeof waVolRenderPeople === 'function') {
  /* dead: wave26 reset waVolRenderPeople without capture; removed in Phase 0 compaction */
}

/* ---------- 3. SOP master editing ---------- */
if (typeof waVolStepHtml === 'function') {
  (function () {
    var __sh24 = waVolStepHtml;
    waVolStepHtml = function (t, s) {
      var html = __sh24(t, s);
      try {
        var bits = [];
        var who = (s && s.owner) || t.default_owner || '';
        if (who) bits.push('<span class="who">' + esc(who) + '</span>');
        if (t.help_url) bits.push('<a class="help" href="' + esc(t.help_url) + '" target="_blank" rel="noopener">How to do this</a>');
        if (WA24_EDIT && typeof isStaff === 'function' && isStaff()) bits.push('<a class="ed" data-w24e="' + t.id + '">edit</a>');
        if (bits.length) html += '<div class="wa24-sx">' + bits.join(' ') + '</div>';
      } catch (e) { /* non-fatal */ }
      return html;
    };
  })();
}

if (typeof waVolRenderSop === 'function') {
  (function () {
    var __rs24 = waVolRenderSop;
    waVolRenderSop = function () {
      WA24_EDIT = true;
      try { __rs24(); } finally { WA24_EDIT = false; }
    };
  })();
}

if (typeof waVolLoad === 'function') {
  (function () {
    var __ld24 = waVolLoad;
    waVolLoad = async function (force) {
      await __ld24(force);
      try {
        if (WA_VOL_TMPL.length && WA_VOL_TMPL[0].help_url === undefined) {
          var r = await db.from('sop_template').select('id, help_url');
          var by = {};
          ((r && r.data) || []).forEach(function (x) { by[x.id] = x.help_url; });
          WA_VOL_TMPL.forEach(function (t) { t.help_url = by[t.id] || null; });
        }
      } catch (e) { /* non-fatal */ }
    };
  })();
}

function wa24SopModal(tid) {
  var t = null;
  WA_VOL_TMPL.forEach(function (x) { if (String(x.id) === String(tid)) t = x; });
  if (!t) return;
  openModal('<h3>Edit this SOP step</h3>' +
    '<p class="m-sub">This edits the master template. The name, notes and help link change everywhere immediately. The assignee applies to all upcoming planned events; events already in progress keep their own assignments.</p>' +
    '<label>Step name</label><input type="text" id="w24Name" value="' + esc(t.name || '') + '" />' +
    '<div class="m-row"><div><label>Assignee</label><input type="text" id="w24Owner" value="' + esc(t.default_owner || '') + '" placeholder="Who owns this step" /></div>' +
    '<div><label>Help link (Google Drive or doc)</label><input type="text" id="w24Help" value="' + esc(t.help_url || '') + '" placeholder="https://..." /></div></div>' +
    '<label>Notes and how-to (shown under the step)</label><textarea id="w24Desc" rows="5">' + esc(t.description || '') + '</textarea>' +
    '<div class="m-actions"><button class="btn" id="w24Save">Save to the master SOP</button> <button class="btn ghost" id="w24Cancel">Cancel</button></div>');
  var cancel = document.getElementById('w24Cancel');
  if (cancel) cancel.addEventListener('click', function () { closeModal(); });
  var save = document.getElementById('w24Save');
  if (save) save.addEventListener('click', async function () {
    var patch = {
      name: (document.getElementById('w24Name').value || '').trim(),
      default_owner: (document.getElementById('w24Owner').value || '').trim() || null,
      help_url: (document.getElementById('w24Help').value || '').trim() || null,
      description: (document.getElementById('w24Desc').value || '').trim() || null
    };
    if (!patch.name) { toast('The step needs a name'); return; }
    save.disabled = true;
    var r = await db.from('sop_template').update(patch).eq('id', t.id);
    if (r.error) { save.disabled = false; toast('Save failed'); return; }
    t.name = patch.name;
    t.default_owner = patch.default_owner;
    t.help_url = patch.help_url;
    t.description = patch.description;
    closeModal();
    toast('Saved. Assignee pushed to upcoming planned events.');
    try { waVolRender(); } catch (e) { /* non-fatal */ }
  });
}

/* ---------- wiring ---------- */
(function () {
  function wire() {
    wa24Nav();
    var sec = document.getElementById('volunteering');
    if (sec && !sec.dataset.wa24Wired) {
      sec.dataset.wa24Wired = '1';
      sec.addEventListener('click', function (e) {
        var t = e.target.closest('[data-w24e]');
        if (!t) return;
        if (typeof isStaff === 'function' && !isStaff()) return;
        try { wa24SopModal(t.getAttribute('data-w24e')); } catch (err) { /* non-fatal */ }
      });
    }
    if (typeof DEPT_ORDER !== 'undefined') {
      DEPT_ORDER.forEach(function (id) { try { wa24Links(id); } catch (e) { /* non-fatal */ } });
    }
  }

  if (typeof renderSection === 'function') {
    var __rsec24 = renderSection;
    renderSection = function (id) {
      __rsec24(id);
      try { wa24Links(id); } catch (e) { /* non-fatal */ }
    };
  }

  var __sa24 = startApp;
  startApp = async function () {
    await __sa24();
    try { wire(); } catch (e) { /* non-fatal */ }
  };
  try { if (document.querySelector('.dept-card') || document.getElementById('tabBar')) wire(); } catch (e) { /* boot */ }
})();
