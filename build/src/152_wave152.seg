  /* ======================= the contacts (#crm) ======================= */
  var ACTS = [['', 'Any activity'], ['served12', 'Served in the last 12 months'], ['served', 'Has served at an event'], ['never', 'Volunteers who have not served yet'],
    ['review', 'Volunteer record needs a review'], ['noemail', 'No email address'], ['new30', 'Added in the last 30 days']];
  var PERMS = [['', 'Any email permission'], ['express', 'Express consent'], ['implied', 'Implied consent'], ['unknown', 'Not recorded'], ['none', 'No consent'], ['unsub', 'Unsubscribed or bouncing']];
  var SORTS = [['recent', 'Recently active'], ['name', 'Name'], ['served', 'Most servings'], ['new', 'Newest']];
  function hasKind(c, k) {
    if (k === 'donor') return c._donor;
    if (k === 'partner') return c._partner;
    return c.kinds.indexOf(k) >= 0;
  }
  function actOk(c, a) {
    if (!a) return true;
    if (a === 'served12') { var n = daysSince(c.last_serving_on); return n != null && n <= 365 && n >= 0; }
    if (a === 'served') return c._served > 0;
    if (a === 'never') return c.kinds.indexOf('volunteer') >= 0 && !c._served;
    if (a === 'review') return !!c.volunteer_needs_review;
    if (a === 'noemail') return !c.emails.length;
    if (a === 'new30') { var d = daysSince(c.created_at); return d != null && d <= 30; }
    return true;
  }
  function permOk(c, p) {
    if (!p) return true;
    if (p === 'unsub') return c._perm === 'unsub' || c._perm === 'bounced';
    return c._perm === p;
  }
  function qOk(c, q) {
    if (!q) return true;
    var ds = digits(q);
    if (ds.length >= 4 && ds.length >= q.replace(/[\s()+.-]/g, '').length - 1) return c._digits.some(function (d) { return d.indexOf(ds) >= 0; });
    return fold(q).split(/\s+/).filter(Boolean).every(function (t) { return c._hay.indexOf(t) >= 0; });
  }
  function matches(c) {
    var u = S.ui;
    return (!u.kind || hasKind(c, u.kind)) && (!u.role || c._roles.indexOf(u.role) >= 0) && actOk(c, u.act) && permOk(c, u.perm) && qOk(c, u.q);
  }
  function sortRows(list) {
    var s = S.ui.sort;
    var byName = function (a, b) { return fold(a.full_name).localeCompare(fold(b.full_name)); };
    if (s === 'name') return list.sort(byName);
    if (s === 'served') return list.sort(function (a, b) { return (b._served - a._served) || byName(a, b); });
    if (s === 'new') return list.sort(function (a, b) { return String(b.created_at || '').localeCompare(String(a.created_at || '')) || byName(a, b); });
    return list.sort(function (a, b) { return String(b._last || '').localeCompare(String(a._last || '')) || (b._served - a._served) || byName(a, b); });
  }
  function tabsHtml() {
    var t = S.ui.tab, n = S.contacts && S.dupes ? dupePairs().length : 0;
    return '<nav class="w152tabs" role="tablist">' +
      '<button role="tab" class="' + (t === 'contacts' ? 'on' : '') + '" data-w152go="#crm">' + I('people') + ' Contacts</button>' +
      '<button role="tab" class="' + (t === 'dupes' ? 'on' : '') + '" data-w152go="#crm/dupes">' + I('merge') + ' Possible duplicates' + (n ? ' <em>' + n + '</em>' : '') + '</button>' +
      '<button role="tab" class="' + (t === 'sources' ? 'on' : '') + '" data-w152go="#crm/sources">' + I('db') + ' Sources</button>' +
      '<button role="tab" class="' + (t === 'gifts' ? 'on' : '') + '" data-w152go="#crm/gifts">' + I('heart') + ' Gifts</button>' +
      '<button role="tab" class="' + (t === 'email' ? 'on' : '') + '" data-w152go="#crm/email">' + I('mail') + ' Email</button>' +
      '<button role="tab" class="' + (t === 'lists' ? 'on' : '') + '" data-w152go="#crm/lists">' + I('list') + ' Lists</button>' +
      '<button role="tab" class="' + (t === 'campaigns' ? 'on' : '') + '" data-w152go="#crm/campaigns">' + I('send') + ' Campaigns</button>' +
      '<button role="tab" class="' + (t === 'forms' ? 'on' : '') + '" data-w152go="#crm/forms">' + I('form') + ' Forms</button>' +
      '<button role="tab" class="' + (t === 'automations' ? 'on' : '') + '" data-w152go="#crm/automations">' + I('bolt') + ' Automations</button>' +
      '<button role="tab" class="' + (t === 'reports' ? 'on' : '') + '" data-w152go="#crm/reports">' + I('chart') + ' Reports</button></nav>';
  }
  function statsHtml(all) {
    var u = S.ui, plain = !u.role && !u.perm && !u.q;
    var vol = all.filter(function (c) { return hasKind(c, 'volunteer'); }).length;
    var served = all.filter(function (c) { return c._served > 0; }).length;
    var donors = all.filter(function (c) { return c._donor; }).length;
    var pairs = S.dupes ? dupePairs().length : 0;
    function st(key, n, label, on) { return '<button class="w152st' + (on ? ' on' : '') + '" data-w152set="' + key + '"><b>' + Number(n).toLocaleString('en-CA') + '</b><span>' + E(label) + '</span></button>'; }
    return '<div class="w152stats">' +
      st('all', all.length, 'contacts in the CRM', plain && !u.kind && !u.act) +
      st('volunteer', vol, 'volunteers', plain && u.kind === 'volunteer' && !u.act) +
      st('served', served, 'have served at an event', plain && !u.kind && u.act === 'served') +
      (donors ? st('donor', donors, 'donors', plain && u.kind === 'donor' && !u.act)
        : '<button class="w152st" data-w152go="#crm/dupes"><b>' + pairs + '</b><span>possible duplicates to check</span></button>') + '</div>';
  }
  function opts(list, cur) { return list.map(function (o) { return '<option value="' + E(o[0]) + '"' + (String(cur) === String(o[0]) ? ' selected' : '') + '>' + E(o[1]) + '</option>'; }).join(''); }
  function barHtml(all) {
    var u = S.ui, kc = {}, rc = {};
    all.forEach(function (c) {
      KIND_ORDER.forEach(function (k) { if (hasKind(c, k)) kc[k] = (kc[k] || 0) + 1; });
      c._roles.forEach(function (r) { rc[r] = (rc[r] || 0) + 1; });
    });
    var chips = '<button class="w152chip' + (!u.kind ? ' on' : '') + '" data-w152kind="">Everyone <em>' + all.length + '</em></button>' +
      KIND_ORDER.filter(function (k) { return kc[k]; }).map(function (k) {
        return '<button class="w152chip' + (u.kind === k ? ' on' : '') + '" data-w152kind="' + k + '"><i style="background:' + KINDS[k][1] + '"></i>' + E(KINDS[k][0]) + ' <em>' + kc[k] + '</em></button>';
      }).join('');
    var roles = ROLE_ORDER.filter(function (r) { return rc[r]; }).concat(Object.keys(rc).filter(function (r) { return ROLE_ORDER.indexOf(r) < 0; }).sort());
    return '<div class="w152bar"><div class="w152chips">' + chips + '</div></div>' +
      '<div class="w152bar">' +
      '<div class="w152q">' + I('search') + '<input type="search" data-w152q="contacts" placeholder="Search a name, email, phone, organization or tag" value="' + E(u.q) + '" aria-label="Search contacts"></div>' +
      '<select class="w152sel" data-w152role aria-label="Volunteer role"><option value="">Every volunteer role</option>' + roles.map(function (r) { return '<option value="' + E(r) + '"' + (u.role === r ? ' selected' : '') + '>' + E(roleName(r)) + ' (' + rc[r] + ')</option>'; }).join('') + '</select>' +
      '<select class="w152sel" data-w152act aria-label="Activity">' + opts(ACTS, u.act) + '</select>' +
      '<select class="w152sel" data-w152perm aria-label="Email permission">' + opts(PERMS, u.perm) + '</select>' +
      '<select class="w152sel" data-w152sort aria-label="Sort">' + opts(SORTS.map(function (s) { return [s[0], 'Sort: ' + s[1]]; }), u.sort) + '</select>' +
      '<button class="w152btn" data-w152add="1">' + I('plus') + ' Add a contact</button></div>';
  }
  function rowHtml(c) {
    var roles = c._roles.slice(0, 3).map(function (r) { return '<span class="w152rl">' + E(roleName(r)) + '</span>'; }).join('') + (c._roles.length > 3 ? '<span class="w152count">+' + (c._roles.length - 3) + '</span>' : '');
    var em = c.emails[0] || '', ph = c.phones[0] || '';
    return '<button class="w152row" data-w152open="' + E(c.id) + '">' +
      '<span class="who">' + avatar(c) + '<span style="min-width:0"><span class="nm">' + E(c.full_name) + '</span><span class="ks">' + kindsHtml(c) +
      (c.volunteer_needs_review ? '<span class="w152kd" style="background:rgba(179,64,47,.1);color:' + FLAG + '">Review</span>' : '') + '</span></span></span>' +
      '<span class="ct"><div>' + (em ? E(em) : '<span class="m">No email</span>') + '</div>' + (ph ? '<div class="m">' + E(ph) + '</div>' : '') + '</span>' +
      '<span class="rl">' + (roles || '<span class="w152count">\u2013</span>') + '</span>' +
      '<span class="sv">' + (c._served ? c._served + '<small>' + (c._served === 1 ? 'serving' : 'servings') + '</small>' : '<span class="w152count">\u2013</span>') + '</span>' +
      '<span class="la">' + (c._last ? E(ago(c._last)) : '\u2013') + '</span></button>';
  }
  function paintContacts(root) {
    var all = S.contacts || [], u = S.ui;
    var focus = document.activeElement && document.activeElement.getAttribute ? document.activeElement.getAttribute('data-w152q') : null;
    var caret = focus && document.activeElement.selectionStart;
    var list = sortRows(all.filter(matches));
    var shown = list.slice(0, u.show);
    var filtered = u.kind || u.role || u.act || u.perm || u.q;
    root.innerHTML = statsHtml(all) + tabsHtml() + barHtml(all) +
      '<div class="w152count">' + (filtered ? plural(list.length, 'contact matches', 'contacts match') + ' \u00b7 <button class="w152mini" data-w152clear="1">' + I('x') + 'Clear the filters</button>' : plural(all.length, 'contact', 'contacts')) +
      (shown.length < list.length ? ' \u00b7 showing the first ' + shown.length : '') + '</div>' +
      (shown.length ? '<div class="w152list" role="list"><div class="w152lh" aria-hidden="true"><span>Name</span><span>Email and phone</span><span class="c3">Volunteer roles</span><span>Served</span><span>Last activity</span></div>' +
        shown.map(rowHtml).join('') + '</div>' +
        (shown.length < list.length ? '<button class="w152btn soft w152more" data-w152more="1">Show ' + Math.min(60, list.length - shown.length) + ' more</button>' : '')
        : '<div class="w152empty">Nobody matches. Try another word, or <button class="w152mini" data-w152clear="1">clear the filters</button>.</div>');
    if (focus) { var inp = root.querySelector('[data-w152q="' + focus + '"]'); if (inp) { inp.focus(); try { inp.setSelectionRange(caret, caret); } catch (e) { /* fine */ } } }
  }
  function paint() {
    var root = mastFor(); if (!root) return;
    if (!staffOk() || boardMode()) { root.innerHTML = '<div class="w152empty">' + I('lock') + ' The CRM is for the Welfare Avenue team.</div>'; return; }
    if (!S.contacts) { root.innerHTML = busy('Loading the contacts\u2026'); return; }
    if (S.err.contacts && !S.contacts.length) { root.innerHTML = '<div class="w152empty">The contacts could not load (' + E(S.err.contacts) + ').</div>'; return; }
    if (S.ui.tab === 'dupes') paintDupes(root);
    else if (S.ui.tab === 'sources') paintSources(root);
    else if (S.ui.tab === 'gifts') paintGifts(root);
    else if (S.ui.tab === 'email') paintEmail(root);
    else if (S.ui.tab === 'lists') paintLists(root);
    else if (S.ui.tab === 'campaigns') paintCampaigns(root);
    else if (S.ui.tab === 'forms') paintForms(root);
    else if (S.ui.tab === 'automations') paintAutos(root);
    else if (S.ui.tab === 'reports') paintReports(root);
    else paintContacts(root);
  }
  function openCrm(h) {
    var parts = String(h || '').split('/');
    var sub = parts[1] || '';
    S.ui.tab = sub === 'dupes' ? 'dupes' : sub === 'sources' ? 'sources' : sub === 'gifts' ? 'gifts' : sub === 'email' ? 'email' : sub === 'lists' ? 'lists' : sub === 'campaigns' ? 'campaigns' : sub === 'forms' ? 'forms' : sub === 'automations' ? 'automations' : sub === 'reports' ? 'reports' : 'contacts';
    if (sub === 'campaigns') openCampaigns(parts);
    if (sub === 'forms') openForms(parts);
    if (sub === 'automations') openAutos(parts);
    if (sub === 'reports') openReports(parts);
    if (sub === 'gifts') { GF.view = parts[2] === 'receipts' ? 'receipts' : parts[2] === 'online' ? 'online' : ''; DG.confirm = false; DG.msg = ''; DG.err = ''; DG.draft = {}; if (GF.view === 'receipts') { GF.cfg = null; S.rcpts = null; RB.act = null; RB.confirmOn = false; } GF.msg = ''; GF.err = ''; RB.msg = ''; RB.err = ''; }
    if (!staffOk() || boardMode()) { paint(); return; }
    Promise.all([load('contacts'), load('dupes')].concat(sub === 'gifts' ? [load('gifts'), load('grcpt')] : sub === 'email' ? [load('templates'), load('sends')] : sub === 'lists' ? [load('lists')] : sub === 'campaigns' ? [load('campaigns'), load('cstats'), load('lists'), load('templates')] : sub === 'forms' ? [load('forms'), load('fstats'), load('cfields'), load('fevents')] : sub === 'automations' ? [load('autos'), load('astats'), load('forms'), load('templates'), load('depts'), load('tmembers')] : [])).then(function () {
      paint();
      if (sub === 'c' && parts[2]) contactSheet(parts[2]);
      else if (S.sheet && /^c:/.test(S.sheet)) closeSheet(true);
    });
    paint();
  }
  /* ======================= a contact's page (#crm/c/<id>) ======================= */
  var lastFocus = null;
  function openSheet(html, tag, narrow) {
    var o = document.getElementById('w152sheet');
    if (!o) {
      o = document.createElement('div'); o.id = 'w152sheet'; o.setAttribute('role', 'dialog'); o.setAttribute('aria-modal', 'true');
      document.body.appendChild(o);
      o.addEventListener('click', function (e) { if (e.target === o) closeSheet(); });
    }
    if (!S.sheet) lastFocus = document.activeElement;
    var same = S.sheet === tag;
    S.sheet = tag || 'sheet';
    var keep = same ? o.scrollTop : 0;
    o.innerHTML = '<div class="sh' + (narrow ? ' narrow' : '') + '"><button class="xb" data-w152close="1" aria-label="Close">' + I('x') + '</button>' + html + '</div>';
    o.style.display = 'flex';
    o.scrollTop = keep;
    if (!same) { var f = o.querySelector('.w152form input,.w152form select,.w152form textarea') || o.querySelector('.xb'); if (f) { try { f.focus({ preventScroll: true }); } catch (e) { /* fine */ } } }
  }
  /* closing a contact puts the address back to the list (no page repaint) */
  function closeSheet(quiet) {
    var o = document.getElementById('w152sheet'); if (o) { o.style.display = 'none'; o.innerHTML = ''; }
    S.sheet = null; S.confirm = null;
    if (!quiet && /^#crm\/c\//.test(location.hash)) { try { history.replaceState(null, '', '#crm'); } catch (e) { /* fine */ } }
    if (lastFocus && lastFocus.focus && document.body.contains(lastFocus)) { try { lastFocus.focus({ preventScroll: true }); } catch (e) { /* fine */ } }
    lastFocus = null;
  }
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && S.sheet) closeSheet(); });

  function loadDetail(c) {
    var id = String(c.id);
    var q = function (p) { return Promise.resolve(p).then(function (r) { return (r && !r.error && r.data) || []; }, function () { return []; }); };
    return Promise.all([
      q(db.from('crm_interactions').select('*').eq('contact_id', c.id).order('occurred_at', { ascending: false }).limit(300)),
      q(db.from('crm_donations').select('id,amount,currency,donated_at,platform,campaign,designation,recurring,receipt_number,receipt_issued_at,receipt_url,notes').eq('contact_id', c.id).order('donated_at', { ascending: false }).limit(300)),
      q(db.from('crm_volunteer_history').select('*').eq('contact_id', c.id).order('event_at', { ascending: false }).limit(500)),
      c.volunteer_id ? q(db.from('event_roster').select('id,event_id,person_id,role,status,confirmed_at,detail').eq('person_id', c.volunteer_id).limit(500)) : Promise.resolve([]),
      q(db.from('crm_contact_orgs').select('*').eq('contact_id', c.id)),
      load('partners'),
      q(db.from('crm_contact_fields').select('field_id,value,source,updated_at').eq('contact_id', c.id)),
      load('cfields'),
      /* wave157: the automations they are in */
      q(db.from('crm_automation_runs').select('id,automation_id,status,step_id,next_at,is_test,started_at,finished_at').eq('contact_id', c.id).eq('is_test', false).order('started_at', { ascending: false }).limit(50)),
      load('autos')
    ]).then(function (r) {
      var roster = r[3].filter(function (x) { return String(x.person_id) === String(c.volunteer_id); });
      var ids = uniq(roster.map(function (x) { return String(x.event_id); }));
      var evs = ids.length ? q(db.from('volunteer_events').select('id,event_date,title,location,status,kind,code').in('id', ids.map(Number))) : Promise.resolve([]);
      return evs.then(function (events) {
        S.detail[id] = { ints: r[0], gifts: r[1], hist: r[2], roster: roster, events: events, orgs: r[4], fields: r[6] || [], runs: r[8] || [], at: Date.now() };
        return S.detail[id];
      });
    });
  }

  function partnerOf(id) { return (S.partners || []).filter(function (p) { return String(p.id) === String(id); })[0] || null; }
  function sourceName(s) { return (SOURCES[s] || [s ? String(s).replace(/_/g, ' ') : 'Unknown'])[0]; }
  function langName(l) { var x = LANGS.filter(function (o) { return o[0] === l; })[0]; return x ? x[1] : (l || ''); }
  function telOf(p) { var d = digits(p); if (d.length === 10) d = '1' + d; return d ? '+' + d : ''; }

  function detailsHtml(c) {
    var rows = [];
    if (c.emails.length) rows.push(['Email', c.emails.map(function (e) { return '<a href="mailto:' + E(e) + '">' + E(e) + '</a>'; }).join('<br>')]);
    if (c.phones.length) rows.push(['Phone', c.phones.map(function (p) { return telOf(p) ? '<a href="tel:' + E(telOf(p)) + '">' + E(p) + '</a>' : E(p); }).join('<br>')]);
    var place = [c.address, [c.city, c.province].filter(Boolean).join(', '), c.postal_code].filter(Boolean).join(' \u00b7 ');
    if (place) rows.push(['Address', E(place)]);
    if (c.language) rows.push(['Language', E(langName(c.language))]);
    if (c.volunteer_organization) rows.push(['School or work', E(c.volunteer_organization)]);
    return rows.length ? '<div class="w152kv">' + rows.map(function (r) { return '<b>' + r[0] + '</b><span>' + r[1] + '</span>'; }).join('') + '</div>' : '<p class="w152pnote">No details yet.</p>';
  }
  function withUsHtml(c, d) {
    var out = [];
    if (c.kinds.indexOf('volunteer') >= 0 || c.volunteer_id) {
      if (c._roles.length) out.push('<div class="w152line">' + c._roles.map(function (r) { return '<span class="w152rl">' + E(roleName(r)) + '</span>'; }).join(' ') + '</div>');
      var hs = Number(c.hub_servings) || 0, ls = Number(c.legacy_servings) || 0, lh = Number(c.legacy_hours) || 0;
      out.push('<div class="w152line">' + (hs ? '<b>' + plural(hs, 'serving', 'servings') + '</b> with us (Volunteer Manager)' + (c.last_serving_on ? ', the last on ' + E(fmtDay(c.last_serving_on)) : '') + (lh && !ls ? ' \u00b7 ' + lh.toLocaleString('en-CA') + ' hours on the old website\u2019s records' : '') : 'No serving with us yet') + '</div>');
      if (ls) out.push('<div class="w152line"><b>' + plural(ls, 'serving', 'servings') + '</b> on the old website, not yet in the Volunteer Manager' + (lh ? ' (' + lh.toLocaleString('en-CA') + ' hours)' : '') + '</div>');
      if (c.last_applied) out.push('<div class="w152line"><span class="m">Last signed up on the old website on ' + E(fmtDay(c.last_applied)) + '</span></div>');
      if (c.volunteer_needs_review) out.push('<div class="w152line" style="color:' + FLAG + '">' + I('alert') + ' Their volunteer record needs a review in the Volunteer Manager.</div>');
    }
    if (Number(c.donation_count) > 0) out.push('<div class="w152line"><b>' + money(c.donation_total) + '</b> over ' + plural(Number(c.donation_count), 'gift', 'gifts') + (c.last_donation_at ? ', the last on ' + E(fmtDay(c.last_donation_at)) : '') + '</div>');
    if (c.kinds.indexOf('staff') >= 0 || c.kinds.indexOf('alumni') >= 0) out.push('<div class="w152line">' + (c.kinds.indexOf('staff') >= 0 ? 'On the team' : 'Was on the team') + ' (the Hub roster)</div>');
    /* organizations from Partners */
    var orgs = (d && d.orgs) || [];
    out.push('<div class="w152orgs">' + (orgs.length ? orgs.map(function (o) {
      var p = partnerOf(o.partner_id); var nm = p ? p.name : (c.org_names[0] || 'An organization');
      return '<div class="w152line">' + I('hand') + ' <button class="w152mini" style="padding:0" data-w152go="#partners/' + E(o.partner_id) + '">' + E(nm) + '</button>' + (o.role_title ? ' <span class="m">' + E(o.role_title) + '</span>' : '') +
        ' <button class="w152mini" data-w152unlink="' + E(o.id) + '" aria-label="Unlink ' + E(nm) + '">' + I('x') + '</button></div>';
    }).join('') : (d ? '' : c.org_names.map(function (n) { return '<div class="w152line">' + I('hand') + ' ' + E(n) + '</div>'; }).join(''))) + '</div>');
    /* what Keela knew (the export of 27/09/26) */
    var K = c.legacy_refs && c.legacy_refs.keela;
    if (K && typeof K === 'object') {
      var kl = [];
      var pos = arr(K.positions).map(function (p) { return String(p).replace(/^Volunteer\s+/i, ''); });
      if (pos.length) kl.push('chose ' + listJoin(pos));
      if (K.try_out_date) kl.push('try-out ' + fmtDay(K.try_out_date));
      var dv = arr(K.dates_volunteered).map(function (d) { return fmtDay(String(d).slice(0, 10)); }).filter(Boolean);
      if (dv.length) kl.push('volunteered ' + (dv.length > 4 ? plural(dv.length, 'time', 'times') + ', last ' + dv[dv.length - 1] : listJoin(dv)));
      var av = arr(K.availability); if (av.length) kl.push('available ' + listJoin(av.slice(0, 3)) + (av.length > 3 ? ' and ' + (av.length - 3) + ' more' : ''));
      if (K.rally_paper_team) kl.push('Rally Paper: ' + K.rally_paper_team);
      if (K.assignee) kl.push('looked after by ' + K.assignee);
      var em = K.email_marketing;
      if (em && em.sent) kl.push('opened ' + (Number(em.opened) || 0) + ' of ' + em.sent + ' newsletters' + (em.last_opened ? ', last on ' + fmtDay(em.last_opened) : ''));
      if (kl.length) out.push('<div class="w152line"><span class="m">From Keela: ' + E(kl.join(' \u00b7 ')) + '</span></div>');
    }
    var links = [];
    links.push('<button class="w152mini" data-w152linkorg="' + E(c.id) + '">' + I('link') + 'Link an organization</button>');
    if (c.volunteer_id) links.push('<button class="w152mini" data-w152go="#volunteering/people" data-w176vid="' + E(String(c.volunteer_id)) + '">' + I('arrow') + 'Open in the Volunteer Manager</button>');
    var mem = c.member_id && typeof MEMBER_BY_ID !== 'undefined' && MEMBER_BY_ID ? MEMBER_BY_ID[c.member_id] : null;
    if (mem && mem.name) links.push('<button class="w152mini" data-w152go="#person/' + E(encodeURIComponent(mem.name)) + '">' + I('arrow') + 'Their Hub profile</button>');
    out.push('<div class="w152line">' + links.join(' ') + '</div>');
    return out.join('');
  }
  function permHtml(c) {
    var p = PERM[c._perm] || PERM.unknown, bits = [];
    if (c.email_consent === 'express' && (c.consent_source || c.consent_at)) bits.push('Given ' + [c.consent_source ? '(' + c.consent_source + ')' : '', c.consent_at ? 'on ' + fmtDay(c.consent_at) : ''].filter(Boolean).join(' '));
    if (c.email_consent === 'implied' && c.implied_consent_until) bits.push((dayOf(c.implied_consent_until) >= today() ? 'Runs until ' : 'Ran out on ') + fmtDay(c.implied_consent_until) + (c.consent_source ? ' (' + c.consent_source + ')' : ''));
    if (c._perm === 'unknown' && c.email_consent === 'implied') bits.push('Their implied consent ran out' + (c.implied_consent_until ? ' on ' + fmtDay(c.implied_consent_until) : '') + '.');
    return '<div class="w152line">' + permChip(c._perm) + ' <span class="m">' + E(p[2]) + '</span></div>' + (bits.length ? '<div class="w152line m">' + E(bits.join(' \u00b7 ')) + '</div>' : '') +
      permLine(c) +
      (c.sms_opt_out ? '<div class="w152line m">No text messages, they asked.</div>' : '') +
      '<p class="w152pnote">Canada\u2019s anti-spam law (CASL): newsletters and appeals need their express consent, or an implied consent that has not run out (two years after a gift or a serving; Welfare Avenue is a registered charity). Confirmations, reminders and receipts are not commercial messages and still go out; a bouncing address stops everything.</p>';
  }
  function tagsHtml(c) {
    return '<div class="w152tags">' + c.tags.map(function (t) { return '<span class="w152tg">' + I('tag') + E(t) + '<button data-w152untag="' + E(t) + '" aria-label="Remove the tag ' + E(t) + '">\u00d7</button></span>'; }).join('') +
      '<input data-w152tagin="' + E(c.id) + '" placeholder="Add a tag" aria-label="Add a tag" maxlength="40"></div>';
  }
  /* one timeline: what was logged here, the gifts, the old website's history, the Hub's rosters */
  function timeline(c, d) {
    var out = [];
    var ICON = { note: 'note', call: 'phone', meeting: 'people', email: 'mail', sms: 'chat', website_message: 'mail', form: 'note' };
    (d.ints || []).forEach(function (x) {
      var k = lower(x.kind), dir = lower(x.direction), undated = !!(x.meta && x.meta.undated);
      var t = k === 'note' ? 'Note' : k === 'call' ? (dir === 'in' ? 'They called' : 'Call') : k === 'meeting' ? 'Meeting' : k === 'email' ? (dir === 'in' ? 'Email from them' : 'Email to them') :
        k === 'sms' ? (dir === 'in' ? 'Text from them' : 'Text message') : k === 'website_message' ? (undated ? 'Message from the old website' : 'Message from the website') : (x.subject || k || 'Activity');
      var mine = lower(x.created_by) === myEmail() && lower(x.source) === 'hub';
      var system = /^(crm_sync|wa\d+_import|mail-unsubscribe|mail-events)$/.test(String(x.created_by || ''));
      var sent = lower(x.source) === 'resend' && x.meta && x.meta.send_id; /* wave154: an email the Hub sent, with what happened to it */
      var hubForm = lower(x.source) === 'hub_form'; /* wave156: an answer to one of the CRM's forms */
      out.push({ at: x.occurred_at || x.created_at, undated: undated, icon: hubForm ? 'form' : (ICON[k] || 'note'), t: t + (x.subject && x.subject !== t ? ': ' + x.subject : ''), p: sent ? '' : (x.body || ''), pre: hubForm,
        st: sent ? (x.meta.status || 'sent') : '', by: hubForm ? 'The form at hub.welfareavenue.com/f/' + ((x.meta && x.meta.slug) || '') : sent ? 'Sent from the Hub' + (x.meta.template_name ? ' (' + x.meta.template_name + ')' : '') + (x.created_by && x.created_by !== 'automation' ? ' by ' + x.created_by : '') :
        system ? (undated ? 'The old website (the form kept no date)' : (x.created_by === 'mail-unsubscribe' ? 'Their unsubscribe link' : '')) : (x.created_by || ''), del: !sent && (mine || amAdmin()) ? x.id : null });
    });
    (d.gifts || []).forEach(function (g) {
      out.push({ at: g.donated_at, icon: 'heart', t: money(g.amount) + (g.recurring ? ' monthly gift' : ' gift'),
        p: [g.campaign, g.designation, g.platform ? 'through ' + (g.platform.charAt(0).toUpperCase() + g.platform.slice(1)) : ''].filter(Boolean).join(' \u00b7 '),
        rc: g.receipt_number ? 'Tax receipt ' + g.receipt_number : '', rcUrl: g.receipt_url || '' });
    });
    (d.hist || []).forEach(function (h) {
      if (h.attended && h.volunteer_event_id) return; /* served: the Hub roster has it (the old website's events are in MTL volunteering) */
      var role = h.position ? roleName(lower(h.position)) : 'a volunteer';
      var t = h.attended ? 'Served as ' + role : h.withdrawn ? 'Withdrew' : h.waitlisted ? 'On the waiting list' : h.confirmed ? 'Confirmed as ' + role : h.approved ? 'Approved as ' + role : 'Signed up as ' + role;
      out.push({ at: h.event_at, icon: 'hand2', t: t, p: [h.event_title, h.location || h.city].filter(Boolean).join(' \u00b7 ') + (h.attended && Number(h.hours) ? ' \u00b7 ' + Number(h.hours) + ' hours' : ''), faint: !h.attended, by: 'The old website' });
    });
    var EV = {}; (d.events || []).forEach(function (e) { EV[String(e.id)] = e; });
    (d.roster || []).forEach(function (r) {
      var e = EV[String(r.event_id)]; if (!e || lower(e.status) === 'cancelled') return;
      var st = r.status || '', role = roleName(r.role), past = lower(e.status) === 'completed' || (dayOf(e.event_date) && dayOf(e.event_date) < today());
      var t;
      if (st === 'Confirmed') t = past ? (lower(e.status) === 'completed' ? 'Served as ' + role : 'Down as ' + role) : 'Confirmed as ' + role;
      else if (st === 'Waiting For Response') { if (past) return; t = 'Asked to come as ' + role; }
      else if (st === 'Unavailable') t = 'Could not come (' + role + ')';
      else if (st === 'TBD' && r.detail && r.detail.source === 'hub_form') { if (past) return; t = 'Signed up as ' + role + ' through a form (to confirm)'; }
      else return;
      var nm = e.title || (lower(e.kind) === 'service' || !e.kind ? 'Serving' : e.kind);
      var old = r.detail && r.detail.source === 'old website';
      out.push({ at: e.event_date, icon: 'hand2', t: t, p: [nm, e.location].filter(Boolean).join(' \u00b7 ') + (old && Number(r.detail.hours) ? ' \u00b7 ' + Number(r.detail.hours) + ' hours' : ''), faint: st !== 'Confirmed', by: old ? 'The old website, now in the Volunteer Manager' : 'MTL volunteering' });
    });
    out.sort(function (a, b) { return ((a.undated ? 1 : 0) - (b.undated ? 1 : 0)) || String(dayOf(b.at)).localeCompare(String(dayOf(a.at))) || String(b.at || '').localeCompare(String(a.at || '')); });
    return out;
  }
  function logFormHtml(c) {
    return '<div class="w152log"><div class="r"><select data-w152logk aria-label="What happened">' + LOG_ORDER.map(function (k) { return '<option value="' + k + '">' + E(LOGS[k][2]) + '</option>'; }).join('') + '</select>' +
      '<input type="date" data-w152logd value="' + E(today()) + '" max="' + E(today()) + '" aria-label="When"></div>' +
      '<textarea data-w152logt placeholder="What happened, or what to remember next time" aria-label="Note"></textarea>' +
      '<div class="r" style="justify-content:space-between"><span class="w152err" data-w152logerr></span><button class="w152btn sm" data-w152log="' + E(c.id) + '">' + I('check') + ' Save to the timeline</button></div></div>';
  }
  function timelineHtml(c, d) {
    if (!d) return logFormHtml(c) + busy('Loading their history\u2026');
    var items = timeline(c, d);
    return logFormHtml(c) + (items.length ? '<ul class="w152tl">' + items.map(function (x) {
      return '<li class="w152it' + (x.faint ? ' faint' : '') + '"><span class="ic">' + I(x.icon) + '</span><div><div class="t">' + E(x.t) + (x.st ? '<span class="w154st" style="background:' + (MSTATUS[x.st] || MSTATUS.sent)[1] + '1a;color:' + (MSTATUS[x.st] || MSTATUS.sent)[1] + '">' + E((MSTATUS[x.st] || [x.st])[0]) + '</span>' : '') + '<span class="d">' + (x.undated ? 'date not recorded' : E(fmtDay(x.at)) + (dayOf(x.at) >= today() && dayOf(x.at) !== today() ? ' (' + E(ago(x.at)) + ')' : '')) + '</span></div>' +
        (x.p ? '<p' + (x.pre ? ' class="pre"' : '') + '>' + E(x.p) + '</p>' : '') + (x.rc ? '<div class="by">' + (x.rcUrl ? '<a class="w152mini" style="padding:0" href="' + E(x.rcUrl) + '" target="_blank" rel="noopener">' + E(x.rc) + ' ' + I('ext') + '</a>' : E(x.rc)) + '</div>' : '') +
        (x.by || x.del ? '<div class="by">' + (x.by ? '<span>' + E(x.by) + '</span>' : '') + (x.del ? '<button class="w152mini" data-w152delint="' + E(x.del) + '">' + I('trash') + 'Delete</button>' : '') + '</div>' : '') + '</div></li>';
    }).join('') + '</ul>' : '<p class="w152pnote">Nothing on their timeline yet.</p>');
  }
  /* wave156: custom fields (a form's answers, Keela's fields) */
  function moreHtml(d) {
    var defs = {}; (S.cfields || []).forEach(function (f) { defs[String(f.id)] = f; });
    var rows = (d.fields || []).map(function (v) { var f = defs[String(v.field_id)]; return f && !f.archived_at ? { f: f, v: v } : null; }).filter(Boolean)
      .sort(function (a, b) { return (a.f.sort - b.f.sort) || (a.f.id - b.f.id); });
    if (!rows.length) return '';
    return '<div class="w156more">' + rows.map(function (x) {
      var val = x.v.value, txt = x.f.type === 'yes_no' || typeof val === 'boolean' ? (val === true || val === 'yes' ? 'Yes' : 'No') : Array.isArray(val) ? val.join(', ') : String(val == null ? '' : val);
      return '<div class="w152kv"><span>' + E(x.f.label) + '</span><span' + (x.f.type === 'long_text' ? ' style="white-space:pre-wrap"' : '') + '>' + E(txt) + '</span></div>';
    }).join('') + '</div>';
  }
  function contactHtml(c, d) {
    var srcLine = 'From ' + sourceName(c.source) + (c.created_at ? ' \u00b7 in the CRM since ' + fmtDay(c.created_at) : '');
    var qa = [];
    if (c.emails[0]) qa.push('<a class="w152btn soft sm" href="mailto:' + E(c.emails[0]) + '">' + I('mail') + ' Email</a>');
    if (c.phones[0] && telOf(c.phones[0])) { qa.push('<a class="w152btn soft sm" href="tel:' + E(telOf(c.phones[0])) + '">' + I('phone') + ' Call</a>'); if (!c.sms_opt_out) qa.push('<a class="w152btn soft sm" href="sms:' + E(telOf(c.phones[0])) + '">' + I('chat') + ' Text</a>'); }
    if (c.emails[0]) qa.push('<button class="w152btn ghost sm" data-w152copy="' + E(c.emails[0]) + '">' + I('copy') + ' Copy the email</button>');
    qa.push('<button class="w152btn soft sm" data-w158new="' + E(c.id) + '">' + I('heart') + ' Record a gift</button>');
    if (c.emails[0] && lower(c.email_status) !== 'bounced' && lower(c.email_status) !== 'complained') qa.push('<button class="w152btn soft sm" data-w154send="' + E(c.id) + '">' + I('spark') + ' Send an email from the Hub</button>');
    return '<div class="w152hd">' + avatar(c, true) + '<div style="min-width:0"><h2>' + E(c.full_name) + '</h2><div class="ks">' + kindsHtml(c) + permChip(c._perm) + '</div><div class="sub">' + E(srcLine) + '</div></div></div>' +
      (qa.length ? '<div class="w152qa">' + qa.join('') + '</div>' : '') +
      '<div class="w152cols"><div>' +
      '<div class="w152sec"><h4>Contact details <button class="w152mini" data-w152edit="' + E(c.id) + '">' + I('edit') + 'Edit</button></h4>' + detailsHtml(c) + '</div>' +
      '<div class="w152sec"><h4>With Welfare Avenue</h4>' + withUsHtml(c, d) + '</div>' +
      '<div class="w152sec"><h4>Email permission <button class="w152mini" data-w152perm-edit="' + E(c.id) + '">' + I('shield') + 'Change</button></h4>' + permHtml(c) + '</div>' +
      '<div class="w152sec"><h4>Tags</h4>' + tagsHtml(c) + '</div>' +
      (d && d.fields && moreHtml(d) ? '<div class="w152sec"><h4>More about them</h4>' + moreHtml(d) + '</div>' : '') +
      (d && d.runs && d.runs.length ? '<div class="w152sec"><h4>Automations</h4>' + contactAutosHtml(d) + '</div>' : '') +
      (c.notes ? '<div class="w152sec"><h4>Good to know</h4><p class="w152line" style="white-space:pre-wrap">' + E(c.notes) + '</p></div>' : '') +
      '</div><div><div class="w152sec"><h4>Timeline</h4>' + timelineHtml(c, d) + '</div></div></div>';
  }
  function contactSheet(id, refresh) {
    var c = contact(id);
    if (!c) {
      if (S.contacts) { toastS('That contact is not in the CRM any more (merged, or never there)'); if (/^#crm\/c\//.test(location.hash)) { try { history.replaceState(null, '', '#crm'); } catch (e) { /* fine */ } } }
      return;
    }
    var tag = 'c:' + c.id, d = S.detail[String(c.id)];
    openSheet(contactHtml(c, d), tag);
    if (!d || refresh) loadDetail(c).then(function (dd) { if (S.sheet === tag) openSheet(contactHtml(contact(id) || c, dd), tag); });
  }
  /* a list repaint behind the sheet keeps the list true after an edit */
  function repaintBehind() { try { if (document.getElementById('crm') && document.getElementById('crm').classList.contains('active')) paint(); } catch (e) { /* fine */ } }

  /* ---------- the forms ---------- */
  function field(label, html, full, hint) { return '<label' + (full ? ' class="full"' : '') + '>' + E(label) + (hint ? ' <span class="hint">' + E(hint) + '</span>' : '') + html + '</label>'; }
  function inp(name, val, ph, type) { return '<input data-f="' + name + '"' + (type ? ' type="' + type + '"' : '') + ' value="' + E(val == null ? '' : val) + '"' + (ph ? ' placeholder="' + E(ph) + '"' : '') + '>'; }
  function area(name, val, ph) { return '<textarea data-f="' + name + '"' + (ph ? ' placeholder="' + E(ph) + '"' : '') + '>' + E(val == null ? '' : val) + '</textarea>'; }
  function sel(name, list, cur) { return '<select data-f="' + name + '">' + opts(list, cur) + '</select>'; }
  function formVals() {
    var o = document.getElementById('w152sheet'), v = {}, ks = [];
    if (!o) return v;
    o.querySelectorAll('[data-f]').forEach(function (el) { v[el.getAttribute('data-f')] = el.type === 'checkbox' ? el.checked : String(el.value || '').trim(); });
    o.querySelectorAll('[data-fk]').forEach(function (el) { if (el.checked) ks.push(el.getAttribute('data-fk')); });
    v._kinds = ks;
    return v;
  }
  function showErr(m) { var el = document.querySelector('#w152sheet [data-w152err]'); if (el) el.textContent = m; }
  function splitList(s) { return String(s || '').split(/[,;\n]/).map(function (x) { return x.trim(); }).filter(Boolean); }
  var EMAIL_RE = /^[^\s@,;<>]+@[^\s@,;<>]+\.[^\s@,;<>]{2,}$/;
  function nameParts(n) { var p = String(n || '').trim().split(/\s+/); return { first: p[0] || null, last: p.length > 1 ? p.slice(1).join(' ') : null }; }
  function kindsBoxes(c, isNew) {
    var fixed = [];
    if (!isNew && c && c.volunteer_id) fixed.push('Volunteer (from the Volunteer Manager)');
    if (!isNew && c && c.kinds.indexOf('staff') >= 0) fixed.push('Staff (from the roster)');
    if (!isNew && c && c.kinds.indexOf('alumni') >= 0) fixed.push('Alumni (from the roster)');
    var list = (isNew ? ['volunteer'] : []).concat(KIND_HAND);
    var cur = c ? c.kinds : [];
    return '<div class="kinds">' + list.map(function (k) { return '<label><input type="checkbox" data-fk="' + k + '"' + (cur.indexOf(k) >= 0 ? ' checked' : '') + '> ' + E(KINDS[k][0]) + '</label>'; }).join('') +
      (fixed.length ? '<span class="w152count">' + E(fixed.join(' \u00b7 ')) + '</span>' : '') + '</div>';
  }
  function editForm(id) {
    var c = id ? contact(id) : null, isNew = !c;
    var x = c || { full_name: '', emails: [], phones: [], kinds: [], tags: [] };
    var html = '<h2>' + (isNew ? 'Add a contact' : 'Edit ' + E(x.full_name)) + '</h2>' +
      '<div class="sub">' + (isNew ? 'Someone we know: a donor, a partner\u2019s contact, a supporter. A new volunteer also gets a volunteer record, so the Volunteer Manager sees them.' : 'Their details, as the whole team will see them.') + '</div>' +
      '<div class="w152form">' +
      (c && c.volunteer_id ? '<div class="note">' + I('link') + ' One record: this contact is also their volunteer record, so the Volunteer Manager shows the same name, emails, phones, address, tags and notes.</div>' : '') +
      field('Full name', inp('full_name', x.full_name, 'First and last name'), true) +
      field('Emails', inp('emails', x.emails.join(', '), 'name@example.com'), false, 'separated by commas; the first one is used') +
      field('Phones', inp('phones', x.phones.join(', '), '514 555 0123'), false, 'separated by commas') +
      field('Street address', inp('address', x.address), true) +
      field('City', inp('city', x.city, 'Montreal')) + field('Province', inp('province', x.province, 'QC')) +
      field('Postal code', inp('postal_code', x.postal_code, 'H2X 1Y4')) + field('Language', sel('language', LANGS, x.language || '')) +
      '<div class="full lbl">What they are to us' + kindsBoxes(c, isNew) + '</div>' +
      (isNew ? field('Email permission', sel('perm', [['', 'Not recorded'], ['express', 'Express consent: they said yes to our emails'], ['implied', 'Implied consent: a recent gift, membership or volunteering'], ['none', 'No consent']], ''), false) +
        field('Where it came from', inp('perm_source', '', 'e.g. signed up at the gala'), false) : '') +
      field('Good to know', area('notes', x.notes, 'Anything the team should know: how they like to be reached, who knows them best'), true) +
      '</div><div class="w152foot"><span class="w152err" data-w152err></span><button class="w152btn ghost" data-w152back="' + E(id || '') + '">Cancel</button>' +
      '<button class="w152btn" data-w152save="' + E(id || 'new') + '">' + I('check') + (isNew ? ' Add them' : ' Save') + '</button></div>';
    openSheet(html, isNew ? 'add' : 'edit:' + id, true);
  }
  function permForm(id) {
    var c = contact(id); if (!c) return;
    var until = c.implied_consent_until ? dayOf(c.implied_consent_until) : (c._last ? addYears(c._last, 2) : '');
    var html = '<h2>Email permission</h2><div class="sub">' + E(c.full_name) + '. What they agreed to, so newsletters and campaigns only go to people who said yes.</div><div class="w152form">' +
      field('Permission', sel('email_consent', [['', 'Not recorded'], ['express', 'Express consent: they said yes to our emails'], ['implied', 'Implied consent: an existing relationship'], ['none', 'No consent']], c.email_consent || ''), true) +
      field('Where it came from', inp('consent_source', c.consent_source, 'the website form, a sign-up sheet, an email'), true) +
      field('Date they said yes', inp('consent_at', c.consent_at ? dayOf(c.consent_at) : '', '', 'date'), false, 'express consent') +
      field('Implied consent runs until', inp('implied_consent_until', until, '', 'date'), false, 'two years after the last gift, membership or volunteering') +
      '<label class="chk full"><input type="checkbox" data-f="unsub"' + (c._perm === 'unsub' ? ' checked' : '') + '> They unsubscribed: no newsletters or campaigns</label>' +
      '<label class="chk full"><input type="checkbox" data-f="sms_opt_out"' + (c.sms_opt_out ? ' checked' : '') + '> No text messages</label>' +
      '<div class="note">Implied consent under CASL: an existing relationship in the last two years, such as a gift or volunteering for a registered charity, or a membership. It runs out two years after the last one. When in doubt, ask for express consent.</div>' +
      '</div><div class="w152foot"><span class="w152err" data-w152err></span><button class="w152btn ghost" data-w152back="' + E(id) + '">Cancel</button><button class="w152btn" data-w152savep="' + E(id) + '">' + I('check') + ' Save</button></div>';
    openSheet(html, 'perm:' + id, true);
  }
  function orgForm(id) {
    var c = contact(id); if (!c) return;
    load('partners').then(function (ps) {
      if (S.sheet !== 'c:' + id && S.sheet !== 'org:' + id) return;
      var list = (ps || []).filter(function (p) { return p.status !== 'declined'; });
      var html = '<h2>Link an organization</h2><div class="sub">' + E(c.full_name) + ' and an organization from Partners: a sponsor\u2019s contact, a school\u2019s club president, a funder\u2019s program officer.</div><div class="w152form">' +
        (list.length ? field('Organization', '<select data-f="partner_id"><option value="">Choose</option>' + list.map(function (p) { return '<option value="' + E(p.id) + '">' + E(p.name) + '</option>'; }).join('') + '</select>', true) +
          field('Their role there', inp('role_title', '', 'President, Program officer, Owner'), true) +
          '<label class="chk full"><input type="checkbox" data-f="is_primary"> Their main organization</label>'
          : '<div class="note">No organization in Partners yet. Add it on the Partners page first.</div>') +
        '</div><div class="w152foot"><span class="w152err" data-w152err></span><button class="w152btn ghost" data-w152back="' + E(id) + '">Cancel</button>' + (list.length ? '<button class="w152btn" data-w152saveorg="' + E(id) + '">' + I('check') + ' Link</button>' : '') + '</div>';
      openSheet(html, 'org:' + id, true);
    });
  }

  /* ---------- saving ---------- */
  async function audit(id, field, oldV, newV) {
    try { await db.from('change_log').insert({ entity_type: 'crm_contact', entity_id: String(id), field: field, old_value: oldV == null ? null : String(oldV).slice(0, 500), new_value: newV == null ? null : String(newV).slice(0, 500), changed_by: actor() }); } catch (e) { /* the audit trail is best effort */ }
  }
  /* the row after a save: the database's answer when there is one, else what we sent */
  function applyLocal(id, patch) {
    var c = contact(id); if (!c) return null;
    Object.keys(patch).forEach(function (k) { c[k] = patch[k]; });
    if (patch.emails) c.primary_email = (patch.emails[0] || '').toLowerCase() || null;
    shape(c);
    return c;
  }
  async function saveContact(id) {
    var v = formVals(), isNew = id === 'new';
    var c = isNew ? null : contact(id);
    if (!v.full_name) { showErr('Give their name.'); return; }
    var emails = uniq(splitList(v.emails).map(function (e) { return e.toLowerCase(); }));
    var bad = emails.filter(function (e) { return !EMAIL_RE.test(e); });
    if (bad.length) { showErr('This does not look like an email: ' + bad[0]); return; }
    var phones = uniq(splitList(v.phones));
    var np = nameParts(v.full_name);
    var fixedKinds = c ? c.kinds.filter(function (k) { return KIND_HAND.indexOf(k) < 0; }) : [];
    var kinds = uniq(fixedKinds.concat(v._kinds.filter(function (k) { return k !== 'volunteer' || isNew; })));
    var row = { full_name: v.full_name, first_name: np.first, last_name: np.last, emails: emails, phones: phones, address: v.address || null, city: v.city || null,
      province: v.province || null, postal_code: v.postal_code ? v.postal_code.toUpperCase() : null, language: v.language || null, kinds: kinds, notes: v.notes || null, updated_by: actor() };
    try {
      if (isNew) {
        /* the same person twice is the most common CRM mistake: stop at an email or a phone we already have */
        var byEmail = (S.contacts || []).filter(function (x) { return x.emails.some(function (e) { return emails.indexOf(lower(e)) >= 0; }); })[0];
        var byPhone = (S.contacts || []).filter(function (x) { return x._digits.some(function (d) { return phones.map(digits).indexOf(d) >= 0; }); })[0];
        var clash = byEmail || byPhone;
        var warn = function (html) {
          showErr('');
          var box = document.querySelector('#w152sheet .w152form'); if (!box) return;
          var old = box.querySelector('.w152warn'); if (old) old.remove();
          box.insertAdjacentHTML('afterbegin', '<div class="w152warn">' + html + '</div>');
        };
        if (byEmail && kinds.indexOf('volunteer') >= 0) {
          warn('<b>Already in the CRM.</b> ' + E(byEmail.full_name) + ' has this email, and a volunteer is added once. <button class="w152mini" data-w152open="' + E(byEmail.id) + '">Open ' + E(byEmail.full_name) + '</button>');
          return;
        }
        if (clash && S.confirm !== 'dup:' + clash.id) {
          S.confirm = 'dup:' + clash.id;
          warn('<b>Already in the CRM?</b> ' + E(clash.full_name) + ' has the same ' + (byEmail ? 'email' : 'phone') + '. <button class="w152mini" data-w152open="' + E(clash.id) + '">Open ' + E(clash.full_name) + '</button> or press Add them again to add a new contact anyway.');
          return;
        }
        row.source = 'hub'; row.created_by = actor();
        if (v.perm) { row.email_consent = v.perm; row.consent_source = v.perm_source || null; if (v.perm === 'express') row.consent_at = new Date().toISOString(); if (v.perm === 'implied') row.implied_consent_until = addYears(today(), 2); }
        var newId = null;
        if (kinds.indexOf('volunteer') >= 0) {
          /* a new volunteer: their volunteer record first; the database makes (or links) their contact from it */
          var vr = await db.from('volunteer_people').insert({ full_name: row.full_name, emails: emails, phones: phones, address: row.address, roles: [], tags: [] }).select('id');
          if (vr && vr.error) throw vr.error;
          var vid = vr && vr.data && vr.data[0] && vr.data[0].id;
          if (vid != null) {
            var cr = await db.from('crm_contacts').select('id').eq('volunteer_id', vid).limit(1);
            newId = cr && cr.data && cr.data[0] && cr.data[0].id;
            if (newId != null) {
              var ur = await db.from('crm_contacts').update(row).eq('id', newId).select('id');
              if (ur && ur.error) throw ur.error;
            }
          }
          row.volunteer_id = vid != null ? vid : null;
        }
        if (newId == null) {
          var ir = await db.from('crm_contacts').insert(row).select('id');
          if (ir && ir.error) throw ir.error;
          newId = ir && ir.data && ir.data[0] && ir.data[0].id;
        }
        if (newId == null) newId = 'tmp' + Date.now();
        var nc = shape(Object.assign({ id: newId, kinds: [], tags: [], emails: [], phones: [], created_at: new Date().toISOString(), hub_servings: 0, legacy_servings: 0, legacy_hours: 0, donation_total: 0, donation_count: 0, org_names: [], volunteer_roles: [], volunteer_tags: [] }, row));
        S.contacts.push(nc); BY_ID[String(nc.id)] = nc; S.confirm = null;
        audit(newId, 'created', null, row.full_name);
        S.detail[String(newId)] = { ints: [], gifts: [], hist: [], roster: [], events: [], orgs: [], at: Date.now() };
        toastS(row.full_name + ' is in the CRM');
        try { history.replaceState(null, '', '#crm/c/' + newId); } catch (e) { /* fine */ }
        contactSheet(newId); repaintBehind();
        return;
      }
      /* wave176: one record: the contact is the person, and the Volunteer Manager reads the same row (no second copy to write) */
      var res = await db.from('crm_contacts').update(row).eq('id', c.id).select('id');
      if (res && res.error) throw res.error;
      if (res && Array.isArray(res.data) && !res.data.length) { showErr('Could not save: the CRM is not open to you.'); return; }
      var changed = ['full_name', 'emails', 'phones', 'address', 'city', 'province', 'postal_code', 'language', 'kinds', 'notes'].filter(function (k) { return JSON.stringify(c[k] == null ? null : c[k]) !== JSON.stringify(row[k] == null ? null : row[k]); });
      applyLocal(c.id, row);
      if (changed.length) audit(c.id, 'details', null, changed.join(', '));
      toastS('Saved'); contactSheet(c.id); repaintBehind();
    } catch (e) { showErr('Could not save: ' + String((e && e.message) || e).slice(0, 160)); }
  }
  async function savePerm(id) {
    var c = contact(id); if (!c) return;
    var v = formVals();
    var row = { email_consent: v.email_consent || null, consent_source: v.consent_source || null, updated_by: actor(), sms_opt_out: !!v.sms_opt_out };
    if (v.email_consent === 'express') row.consent_at = v.consent_at ? v.consent_at + 'T12:00:00Z' : (c.consent_at || new Date().toISOString());
    else row.consent_at = v.email_consent ? (c.consent_at || null) : null;
    if (v.email_consent === 'implied') { if (!v.implied_consent_until) { showErr('Say until when the implied consent runs (two years after the last gift or volunteering).'); return; } row.implied_consent_until = v.implied_consent_until; }
    else row.implied_consent_until = null;
    var st = lower(c.email_status);
    if (v.unsub) row.email_status = 'unsubscribed';
    else if (st === 'unsubscribed' || st === 'complained') row.email_status = 'unknown';
    try {
      var res = await db.from('crm_contacts').update(row).eq('id', c.id).select('id');
      if (res && res.error) throw res.error;
      if (res && Array.isArray(res.data) && !res.data.length) { showErr('Could not save: the CRM is not open to you.'); return; }
      var before = c._perm;
      applyLocal(c.id, row);
      audit(c.id, 'email_permission', PERM[before][0], PERM[c._perm][0] + (row.consent_source ? ' (' + row.consent_source + ')' : ''));
      toastS('Saved'); contactSheet(c.id); repaintBehind();
    } catch (e) { showErr('Could not save: ' + String((e && e.message) || e).slice(0, 160)); }
  }
  async function saveTags(id, tags) {
    var c = contact(id); if (!c) return;
    var before = c.tags.slice();
    try {
      var res = await db.from('crm_contacts').update({ tags: tags, updated_by: actor() }).eq('id', c.id).select('id');
      if (res && res.error) throw res.error;
      applyLocal(c.id, { tags: tags });
      audit(c.id, 'tags', before.join(', '), tags.join(', '));
      contactSheet(c.id); repaintBehind();
      var t = document.querySelector('#w152sheet [data-w152tagin]'); if (t) { try { t.focus({ preventScroll: true }); } catch (e) { /* fine */ } }
    } catch (e) { toastS('Could not save the tag: ' + String((e && e.message) || e).slice(0, 120)); }
  }
  async function saveLog(id) {
    var c = contact(id); if (!c) return;
    var o = document.getElementById('w152sheet'); if (!o) return;
    var k = (o.querySelector('[data-w152logk]') || {}).value || 'note', when = (o.querySelector('[data-w152logd]') || {}).value || today(), text = String((o.querySelector('[data-w152logt]') || {}).value || '').trim();
    var errEl = o.querySelector('[data-w152logerr]');
    if (!text) { if (errEl) errEl.textContent = 'Write what happened first.'; return; }
    if (when > today()) { if (errEl) errEl.textContent = 'That date is in the future.'; return; }
    var L = LOGS[k] || LOGS.note;
    var row = { contact_id: c.id, kind: L[0], direction: L[1], channel: L[0] === 'note' ? null : L[0], body: text, occurred_at: when === today() ? new Date().toISOString() : when + 'T12:00:00Z', source: 'hub', created_by: actor() };
    try {
      var res = await db.from('crm_interactions').insert(row).select('*');
      if (res && res.error) throw res.error;
      var saved = Object.assign({ id: 'tmp' + Date.now(), created_at: new Date().toISOString() }, row, (res && res.data && res.data[0]) || {});
      var d = S.detail[String(c.id)]; if (d) d.ints.unshift(saved);
      if (L[1] !== 'internal' && (!c.last_activity_at || String(row.occurred_at) > String(c.last_activity_at))) applyLocal(c.id, { last_activity_at: row.occurred_at });
      toastS('Saved to ' + (c.first_name || c.full_name) + '\u2019s timeline'); contactSheet(c.id); repaintBehind();
    } catch (e) { if (errEl) errEl.textContent = 'Could not save: ' + String((e && e.message) || e).slice(0, 140); }
  }
  async function deleteLog(id, intId) {
    var c = contact(id); if (!c) return;
    if (S.confirm !== 'del:' + intId) { S.confirm = 'del:' + intId; toastS('Press Delete again to remove it from the timeline'); return; }
    S.confirm = null;
    try {
      var res = await db.from('crm_interactions').delete().eq('id', intId).select('id');
      if (res && res.error) throw res.error;
      if (res && Array.isArray(res.data) && !res.data.length) { toastS('Only the person who wrote it (or an admin) can delete it'); return; }
      var d = S.detail[String(c.id)]; if (d) d.ints = d.ints.filter(function (x) { return String(x.id) !== String(intId); });
      audit(c.id, 'timeline', 'deleted an entry', null);
      toastS('Deleted'); contactSheet(c.id);
    } catch (e) { toastS('Could not delete: ' + String((e && e.message) || e).slice(0, 120)); }
  }
  async function saveOrg(id) {
    var c = contact(id); if (!c) return;
    var v = formVals();
    if (!v.partner_id) { showErr('Choose the organization.'); return; }
    var d = S.detail[String(c.id)];
    if (d && d.orgs.some(function (o) { return String(o.partner_id) === String(v.partner_id); })) { showErr('They are already linked to it.'); return; }
    var row = { contact_id: c.id, partner_id: Number(v.partner_id), role_title: v.role_title || null, is_primary: !!v.is_primary, created_by: actor() };
    try {
      var res = await db.from('crm_contact_orgs').insert(row).select('*');
      if (res && res.error) throw res.error;
      var saved = Object.assign({ id: 'tmp' + Date.now() }, row, (res && res.data && res.data[0]) || {});
      if (d) d.orgs.push(saved);
      var p = partnerOf(v.partner_id);
      if (p && c.org_names.indexOf(p.name) < 0) applyLocal(c.id, { org_names: c.org_names.concat([p.name]) });
      audit(c.id, 'organization', null, p ? p.name : v.partner_id);
      toastS('Linked'); contactSheet(c.id); repaintBehind();
    } catch (e) { showErr('Could not link: ' + String((e && e.message) || e).slice(0, 160)); }
  }
  async function unlinkOrg(linkId) {
    var id = String(S.sheet || '').replace(/^c:/, ''); var c = contact(id); if (!c) return;
    if (S.confirm !== 'unlink:' + linkId) { S.confirm = 'unlink:' + linkId; toastS('Press \u00d7 again to unlink the organization'); return; }
    S.confirm = null;
    try {
      var res = await db.from('crm_contact_orgs').delete().eq('id', linkId).select('id');
      if (res && res.error) throw res.error;
      var d = S.detail[String(c.id)], gone = null;
      if (d) { gone = d.orgs.filter(function (o) { return String(o.id) === String(linkId); })[0]; d.orgs = d.orgs.filter(function (o) { return String(o.id) !== String(linkId); }); }
      var p = gone ? partnerOf(gone.partner_id) : null;
      if (p) applyLocal(c.id, { org_names: c.org_names.filter(function (n) { return n !== p.name; }) });
      audit(c.id, 'organization', p ? p.name : linkId, null);
      toastS('Unlinked'); contactSheet(c.id); repaintBehind();
    } catch (e) { toastS('Could not unlink: ' + String((e && e.message) || e).slice(0, 120)); }
  }
  /* ======================= possible duplicates (#crm/dupes) ======================= */
  function sideHtml(c, other) {
    var lines = [];
    if (c.emails.length) lines.push('<div class="ln">' + c.emails.map(function (e) { return other.emails.some(function (x) { return lower(x) === lower(e); }) ? '<b>' + E(e) + '</b>' : E(e); }).join(', ') + '</div>');
    if (c.phones.length) lines.push('<div class="ln">' + c.phones.map(function (p) { var d = digits(p); return d.length >= 7 && other._digits.indexOf(d) >= 0 ? '<b>' + E(p) + '</b>' : E(p); }).join(', ') + '</div>');
    var facts = [];
    if (c._served) facts.push(plural(c._served, 'serving', 'servings'));
    if (Number(c.donation_count)) facts.push(plural(Number(c.donation_count), 'gift', 'gifts'));
    if (c._roles.length) facts.push(c._roles.map(roleName).join(', '));
    lines.push('<div class="ln m">' + E(['From ' + sourceName(c.source)].concat(facts).join(' \u00b7 ')) + '</div>');
    if (c.created_at) lines.push('<div class="ln m">In the CRM since ' + E(fmtDay(c.created_at)) + '</div>');
    return '<div class="w152ds"><div class="top">' + avatar(c) + '<div style="min-width:0"><div class="nm">' + E(c.full_name) + '</div><div class="ks" style="display:flex;gap:4px;flex-wrap:wrap;margin-top:3px">' + kindsHtml(c) + '</div></div></div>' +
      lines.join('') + '<div class="act"><button class="w152btn sm" data-w152keep="' + E(c.id) + '" data-drop="' + E(other.id) + '">' + I('check') + ' Keep this one</button>' +
      '<button class="w152mini" data-w152open="' + E(c.id) + '">Open</button></div></div>';
  }
  function pairHtml(p) {
    var a = contact(p.a), b = contact(p.b);
    var why = p.on.length > 1 ? 'Same email and phone' : p.on[0] === 'email' ? 'Same email' : 'Same phone';
    var cf = '';
    var m = /^merge:(\d+):(\d+)$/.exec(S.confirm || '');
    if (m && ((m[1] === String(a.id) && m[2] === String(b.id)) || (m[1] === String(b.id) && m[2] === String(a.id)))) {
      var keep = contact(m[1]), drop = contact(m[2]);
      cf = '<div class="w152cf"><span>Merge <b>' + E(drop.full_name) + '</b> into <b>' + E(keep.full_name) + '</b>? Their emails, phones, tags, notes and history move to ' + E(keep.full_name) +
        (keep.volunteer_id && drop.volunteer_id ? ', and their two volunteer records become one (with both rosters)' : '') + '. The Hub cannot undo it.</span>' +
        '<span style="display:flex;gap:6px"><button class="w152btn ghost sm" data-w152cancel="1">Cancel</button><button class="w152btn danger sm" data-w152merge="' + E(keep.id) + '" data-drop="' + E(drop.id) + '">' + I('merge') + ' Merge</button></span></div>';
    }
    return '<div class="w152dp" data-pair="' + E(p.a + '-' + p.b) + '"><div class="why">' + I('merge') + E(why) + ' <span>' + E(p.values.join(' \u00b7 ')) + '</span></div>' +
      '<div class="two">' + sideHtml(a, b) + sideHtml(b, a) + '</div>' + cf +
      '<div class="bot"><button class="w152btn ghost sm" data-w152notdup="' + E(p.a + '-' + p.b) + '">' + I('x') + ' Not the same person</button></div></div>';
  }
  function paintDupes(root) {
    var pairs = dupePairs();
    root.innerHTML = tabsHtml() +
      '<div class="w152count" style="max-width:760px;line-height:1.5">Two contacts with the same email or phone. Keep the right one and the other one\u2019s emails, phones, tags, notes and history move to it. Family members often share a phone: mark those as different people and they leave this list.</div>' +
      (S.err.dupes && !S.dupes.length ? '<div class="w152empty">The duplicates could not load (' + E(S.err.dupes) + ').</div>' :
        pairs.length ? '<div class="w152dl">' + pairs.map(pairHtml).join('') + '</div>' : '<div class="w152empty">' + I('check') + ' No possible duplicates right now.</div>');
  }
  async function merge(keepId, dropId) {
    var keep = contact(keepId), drop = contact(dropId); if (!keep || !drop) return;
    var btn = document.querySelector('[data-w152merge="' + keepId + '"]'); if (btn) btn.disabled = true;
    try {
      var r = await db.rpc('crm_merge_contacts', { p_keep: Number(keepId), p_drop: Number(dropId) });
      if (r && r.error) throw r.error;
      /* what the database did, on the page at once; the next visit reloads the numbers */
      applyLocal(keep.id, {
        emails: uniq(keep.emails.concat(drop.emails)), phones: uniq(keep.phones.concat(drop.phones)), tags: uniq(keep.tags.concat(drop.tags)), kinds: uniq(keep.kinds.concat(drop.kinds)),
        hub_servings: (Number(keep.hub_servings) || 0) + (keep.volunteer_id && drop.volunteer_id && keep.volunteer_id !== drop.volunteer_id ? (Number(drop.hub_servings) || 0) : 0),
        legacy_servings: (Number(keep.legacy_servings) || 0) + (Number(drop.legacy_servings) || 0), donation_total: (Number(keep.donation_total) || 0) + (Number(drop.donation_total) || 0),
        donation_count: (Number(keep.donation_count) || 0) + (Number(drop.donation_count) || 0), org_names: uniq(keep.org_names.concat(drop.org_names))
      });
      S.contacts = S.contacts.filter(function (x) { return String(x.id) !== String(dropId); }); delete BY_ID[String(dropId)];
      S.dupes = (S.dupes || []).filter(function (d) { return String(d.contact_id) !== String(dropId) && String(d.duplicate_id) !== String(dropId); });
      delete S.detail[String(keepId)]; delete S.detail[String(dropId)];
      S.at.contacts = 0; S.at.dupes = 0; S.confirm = null;
      toastS(drop.full_name + ' merged into ' + keep.full_name);
      paint();
    } catch (e) { if (btn) btn.disabled = false; toastS('Could not merge: ' + String((e && e.message) || e).slice(0, 140)); }
  }
  async function notDup(key) {
    var ab = String(key).split('-').map(Number); if (ab.length !== 2) return;
    try {
      var r = await db.from('crm_dupe_dismissals').insert({ a_id: Math.min(ab[0], ab[1]), b_id: Math.max(ab[0], ab[1]), dismissed_by: actor() });
      if (r && r.error && !/duplicate key/i.test(String(r.error.message || ''))) throw r.error;
      S.dupes = (S.dupes || []).filter(function (d) { var a = Math.min(Number(d.contact_id), Number(d.duplicate_id)), b = Math.max(Number(d.contact_id), Number(d.duplicate_id)); return !(a === Math.min(ab[0], ab[1]) && b === Math.max(ab[0], ab[1])); });
      toastS('Marked as different people');
      paint();
    } catch (e) { toastS('Could not save: ' + String((e && e.message) || e).slice(0, 140)); }
  }

  /* ======================= sources (#crm/sources) ======================= */
  function loadCounts() {
    if (S.counts && Date.now() - (S.counts.at || 0) < 120000) return Promise.resolve(S.counts);
    var n = function (p) { return Promise.resolve(p).then(function (r) { return r && !r.error && typeof r.count === 'number' ? r.count : null; }, function () { return null; }); };
    return Promise.all([
      n(db.from('crm_volunteer_history').select('id', { count: 'exact', head: true })),
      n(db.from('crm_interactions').select('id', { count: 'exact', head: true }).eq('kind', 'website_message')),
      n(db.from('crm_donations').select('id', { count: 'exact', head: true }))
    ]).then(function (r) { S.counts = { hist: r[0], msgs: r[1], gifts: r[2], at: Date.now() }; return S.counts; });
  }
  function paintSources(root) {
    var all = S.contacts || [], by = {}, perm = {};
    all.forEach(function (c) { by[c.source || ''] = (by[c.source || ''] || 0) + 1; perm[c._perm] = (perm[c._perm] || 0) + 1; });
    var srcRows = Object.keys(by).sort(function (a, b) { return by[b] - by[a]; }).map(function (s) {
      var d = SOURCES[s] || [s ? String(s).replace(/_/g, ' ') : 'Unknown', ''];
      return '<div class="w152srow"><b>' + by[s] + '</b><div><div class="tt">' + E(d[0]) + '</div>' + (d[1] ? '<p>' + E(d[1]) + '</p>' : '') + '</div><span></span></div>';
    }).join('');
    var k = S.counts || {};
    var st = function (n, none) { return n == null ? '<span class="st next">Checking\u2026</span>' : n > 0 ? '<span class="st on">' + Number(n).toLocaleString('en-CA') + ' in</span>' : '<span class="st next">' + E(none) + '</span>'; };
    var keela = by.keela || 0;
    var next = [
      ['Volunteer history from the old website', 'Every event each volunteer signed up for, was confirmed for and served at, from the Django site.', st(k.hist, 'Next')],
      ['Messages from the website', 'What people write through the contact form on welfareavenue.com, on the sender\u2019s timeline.', st(k.msgs, 'Next')],
      ['Gifts and tax receipts from Zeffy', 'Every donation with its receipt, on the donor\u2019s timeline and in their total.', st(k.gifts, 'Later')],
      ['The Keela export', 'Donors and supporters from Keela, merged with the people already here.', keela ? '<span class="st on">' + keela + ' in</span>' : '<span class="st next">When it arrives</span>']
    ].map(function (r) { return '<div class="w152srow nx"><div><div class="tt">' + E(r[0]) + '</div><p>' + E(r[1]) + '</p></div>' + r[2] + '</div>'; }).join('');
    var ok = (perm.express || 0) + (perm.implied || 0);
    var pr = [['express', 'said yes to our emails'], ['implied', 'with an implied consent that has not run out'], ['unknown', 'with no permission on file yet'], ['none', 'with no consent'], ['unsub', 'who unsubscribed'], ['bounced', 'whose address bounces']]
      .filter(function (x) { return perm[x[0]]; }).map(function (x) { return '<div class="w152srow"><b>' + perm[x[0]] + '</b><div><div class="tt">' + permChip(x[0]) + '</div><p>' + E('Contacts ' + x[1] + '.') + '</p></div><span></span></div>'; }).join('');
    var rev = all.filter(function (c) { return c.volunteer_needs_review; }).length, noEm = all.filter(function (c) { return !c.emails.length; }).length, noPh = all.filter(function (c) { return !c.phones.length; }).length, pairs = S.dupes ? dupePairs().length : 0;
    var tidy = [[pairs, 'possible duplicates', 'Same email or phone on two contacts.', '#crm/dupes'], [rev, 'volunteer records to review', 'Flagged in the Volunteer Manager when they were imported.', ''],
      [noEm, 'contacts with no email', '', ''], [noPh, 'contacts with no phone', '', '']].map(function (x) {
      return '<div class="w152srow"><b>' + x[0] + '</b><div><div class="tt">' + E(x[1].charAt(0).toUpperCase() + x[1].slice(1)) + '</div>' + (x[2] ? '<p>' + E(x[2]) + '</p>' : '') + '</div>' + (x[3] && x[0] ? '<button class="w152mini" data-w152go="' + x[3] + '">Check them ' + I('arrow') + '</button>' : '<span></span>') + '</div>';
    }).join('');
    root.innerHTML = tabsHtml() + '<div class="w152grid2">' + keelaHtml() +
      '<div class="w152card"><h3>Where they come from <span>' + plural(all.length, 'contact', 'contacts') + '</span></h3>' + srcRows + '</div>' +
      '<div class="w152card"><h3>What joins next</h3>' + next + '</div>' +
      '<div class="w152card"><h3>Email permission <span>' + plural(ok, 'contact', 'contacts') + ' can get a newsletter today</span></h3>' + pr +
      '<p class="w152pnote">Campaigns go only to express consent, or implied consent that has not run out (CASL). Everyone else is asked first.</p></div>' +
      '<div class="w152card"><h3>To tidy</h3>' + tidy + '</div></div>';
    if (!S.counts) loadCounts().then(function () { if (S.ui.tab === 'sources') paint(); });
    /* wave159a: what Leaving Keela reads */
    var need = ['forms', 'autos', 'kcfg', 'gifts'].filter(function (k) { return !S[k] && !S.loading[k]; });
    if (need.length) Promise.all(need.map(function (k) { return load(k); })).then(function () { if (S.ui.tab === 'sources') paint(); });
  }

  /* ---------- the Gifts tab (wave153): every gift with its donor, campaign, platform and receipt ---------- */
  function fyOf(day) { var d = dayOf(day); if (!d) return ''; var y = Number(d.slice(0, 4)), m = Number(d.slice(5, 7)); return String(m >= 10 ? y + 1 : y); } /* the fiscal year ends September 30 */
  function giftDonor(g) { var c = contact(g.contact_id); return c ? c.full_name : ''; }
  function giftHay(g) { var c = contact(g.contact_id); return fold([giftDonor(g), c ? c.emails.join(' ') : '', g.campaign, g.designation, g.platform, g.receipt_number, g.external_id, g.notes].join(' ')); }
  function giftMatches(g) {
    var u = S.ui;
    if (u.gplat && lower(g.platform) !== u.gplat) return false;
    if (u.gyear && fyOf(g.donated_at) !== u.gyear) return false;
    if (u.gq) { var words = fold(u.gq).split(/\s+/).filter(Boolean), hay = giftHay(g); if (!words.every(function (w) { return hay.indexOf(w) >= 0; })) return false; }
    return true;
  }
  var RFD = { part: ['Part refunded', '#B9851B'], all: ['Refunded', MUTED] }; /* wave161 */
  function platName(p) { p = lower(p); return { zeffy: 'Zeffy', keela: 'Keela', stripe: 'Stripe', cash: 'Cash', cheque: 'Cheque', hub: 'The Hub', paypal: 'PayPal' }[p] || (p ? p.charAt(0).toUpperCase() + p.slice(1) : 'Unknown'); }
  function giftRow(g) {
    var c = contact(g.contact_id), nm = c ? c.full_name : 'Contact ' + g.contact_id;
    var rs = rcptFor(g.id), rule = rs ? [rs.receipt_status, rs.receipt_note] : receiptRule(g);
    var rc = g.receipt_number ? '<span class="rc">' + (g.receipt_url ? '<a href="' + E(g.receipt_url) + '" target="_blank" rel="noopener">Receipt ' + E(g.receipt_number) + ' ' + I('ext') + '</a>' : 'Receipt ' + E(g.receipt_number)) + (g.receipt_issued_at ? ' \u00b7 ' + E(fmtDay(g.receipt_issued_at)) : '') + '</span>'
      : '<span class="rc">' + gchip(RSTS, rule[0]) + '<div class="m">' + E(rule[0] === 'due' ? 'for ' + cents(eligibleOf(g)) : rule[1]) + '</div></span>';
    var kind = g.kind && g.kind !== 'donation' ? ' ' + gchip(GKIND, g.kind) : '';
    return '<div class="w152row w158row" role="listitem" data-w158open="' + E(g.id) + '" tabindex="0" aria-label="Open the gift">' +
      '<span>' + E(fmtDay(g.donated_at)) + '</span>' +
      '<span><a href="#crm/c/' + E(g.contact_id) + '">' + E(nm) + '</a>' + (c && c.emails[0] ? '<div class="m">' + E(c.emails[0]) + '</div>' : '') + '</span>' +
      '<span class="amt">' + E(money(g.amount)) + (g.recurring ? '<small> monthly</small>' : '') + kind + (Number(g.refunded_amount) > 0 ? ' <span class="rfd">' + gchip(RFD, Number(g.amount) > 0 ? 'part' : 'all') + '</span>' : '') + (g.tribute_kind ? '<div class="m">' + E((g.tribute_kind === 'memory' ? 'In memory of ' : 'In honour of ') + (g.tribute_name || '')) + '</div>' : '') + '</span>' +
      '<span>' + E([g.campaign, g.designation].filter(Boolean).join(' \u00b7 ') || '\u2013') + '<div class="m">' + E(platName(g.platform)) + (g.method ? ' \u00b7 ' + E((GMETH.filter(function (m) { return m[0] === g.method; })[0] || ['', g.method])[1]) : '') + '</div></span>' +
      '<span>' + rc + '</span></div>';
  }
  function paintGifts(root) {
    var u = S.ui;
    if (!S.gifts || !S.grcpt) { root.innerHTML = statsHtml(S.contacts || []) + tabsHtml() + busy('Loading the gifts\u2026'); Promise.all([load('gifts'), load('grcpt')]).then(function () { if (u.tab === 'gifts') paint(); }); return; }
    if (GF.view === 'receipts') {
      if (!GF.cfg || !S.rcpts) { root.innerHTML = statsHtml(S.contacts || []) + tabsHtml() + busy('Loading the receipt settings\u2026'); Promise.all([GF.cfg ? null : loadRcfg(), S.rcpts ? null : load('rcpts')]).then(function () { if (u.tab === 'gifts') paint(); }); return; }
      root.innerHTML = statsHtml(S.contacts || []) + tabsHtml() + receiptsHtml(); rbSigLoad(); return;
    }
    if (GF.view === 'online') { /* wave161: the donation page, monthly gifts, what Stripe told the Hub */
      if (!S.dcfg || !S.plans || !S.sevents || !S.dtries) { root.innerHTML = statsHtml(S.contacts || []) + tabsHtml() + busy('Loading online giving\u2026'); Promise.all([load('dcfg'), load('plans'), load('sevents'), load('dtries')]).then(function () { if (u.tab === 'gifts') paint(); }); return; }
      root.innerHTML = statsHtml(S.contacts || []) + tabsHtml() + onlineHtml(); return;
    }
    var all = S.gifts, list = all.filter(giftMatches);
    var total = 0, donors = {}, receipted = 0, years = {}, plats = {};
    all.forEach(function (g) { total += Number(g.amount) || 0; donors[g.contact_id] = 1; if (g.receipt_number) receipted++; var fy = fyOf(g.donated_at); if (fy) years[fy] = 1; plats[lower(g.platform) || ''] = 1; });
    var fyNow = fyOf(today()), thisFy = all.filter(function (g) { return fyOf(g.donated_at) === fyNow; }), thisTot = thisFy.reduce(function (a, g) { return a + (Number(g.amount) || 0); }, 0);
    var sel = list.reduce(function (a, g) { return a + (Number(g.amount) || 0); }, 0);
    var shown = list.slice(0, u.gshow), filtered = u.gq || u.gplat || u.gyear;
    var focus = document.activeElement && document.activeElement.hasAttribute && document.activeElement.hasAttribute('data-w152gq');
    var caret = focus && document.activeElement.selectionStart;
    root.innerHTML = statsHtml(S.contacts || []) + tabsHtml() +
      '<div class="w152stats">' +
      '<div class="w152st"><b>' + E(money(total)) + '</b><span>given, all time (' + plural(all.length, 'gift', 'gifts') + ')</span></div>' +
      '<div class="w152st"><b>' + E(money(thisTot)) + '</b><span>this fiscal year (to 30 Sep ' + E(fyNow) + ', ' + plural(thisFy.length, 'gift', 'gifts') + ')</span></div>' +
      '<div class="w152st"><b>' + Object.keys(donors).length.toLocaleString('en-CA') + '</b><span>donors</span></div>' +
      '<div class="w152st"><b>' + receipted.toLocaleString('en-CA') + '</b><span>with a tax receipt</span></div></div>' +
      '<div class="w152bar"><label class="w152q">' + I('search') + '<input type="search" data-w152gq="1" value="' + E(u.gq) + '" placeholder="Search a donor, campaign, receipt number or platform" aria-label="Search the gifts"></label>' +
      '<select class="w152sel" data-w152gplat aria-label="Platform"><option value="">Every platform</option>' + Object.keys(plats).sort().map(function (p) { return '<option value="' + E(p) + '"' + (u.gplat === p ? ' selected' : '') + '>' + E(platName(p)) + '</option>'; }).join('') + '</select>' +
      '<select class="w152sel" data-w152gyear aria-label="Fiscal year"><option value="">Every year</option>' + Object.keys(years).sort().reverse().map(function (y) { return '<option value="' + E(y) + '"' + (u.gyear === y ? ' selected' : '') + '>FY ' + E(y) + ' (Oct ' + (Number(y) - 1) + ' to Sep ' + E(y) + ')</option>'; }).join('') + '</select>' +
      '<button class="w152btn" data-w158new="1">' + I('plus') + ' Record a gift</button><button class="w152btn ghost" data-w152go="#crm/gifts/receipts">' + I('note') + ' Receipts</button><button class="w152btn ghost" data-w152go="#crm/gifts/online">' + I('card') + ' Online giving</button></div>' + (GF.msg ? '<div class="w154msg">' + E(GF.msg) + '</div>' : '') +
      '<div class="w152count">' + (filtered ? plural(list.length, 'gift matches', 'gifts match') + ' (' + E(money(sel)) + ') \u00b7 <button class="w152mini" data-w152gclear="1">' + I('x') + 'Clear the filters</button>' : plural(all.length, 'gift', 'gifts') + ', newest first') +
      (shown.length < list.length ? ' \u00b7 showing the first ' + shown.length : '') + '</div>' +
      (shown.length ? '<div class="w152list w153gifts" role="list"><div class="w152lh" aria-hidden="true"><span>When</span><span>Donor</span><span>Amount</span><span>Campaign and platform</span><span>Receipt</span></div>' + shown.map(giftRow).join('') + '</div>' +
        (shown.length < list.length ? '<button class="w152btn soft w152more" data-w152gmore="1">Show ' + Math.min(60, list.length - shown.length) + ' more</button>' : '')
        : '<div class="w152empty">' + (all.length ? 'No gift matches. Try another word, or <button class="w152mini" data-w152gclear="1">clear the filters</button>.' : 'No gifts in the CRM yet. Zeffy joins next; until then the Keela export is the record.') + '</div>');
    if (focus) { var inp = root.querySelector('[data-w152gq]'); if (inp) { inp.focus(); try { inp.setSelectionRange(caret, caret); } catch (e) { /* fine */ } } }
  }
  var gqT = null;
  document.addEventListener('input', function (e) {
    var t = e.target; if (!t || !t.getAttribute || !t.hasAttribute('data-w152gq')) return;
    var v = t.value; clearTimeout(gqT);
    gqT = setTimeout(function () { S.ui.gq = v; S.ui.gshow = 60; paint(); }, 160);
  });
  document.addEventListener('change', function (e) {
    var t = e.target; if (!t || !t.closest || !t.closest('.w152root')) return;
    if (t.hasAttribute('data-w152gplat')) S.ui.gplat = t.value;
    else if (t.hasAttribute('data-w152gyear')) S.ui.gyear = t.value;
    else return;
    S.ui.gshow = 60; paint();
  });
  document.addEventListener('click', function (e) {
    var t = e.target, el; if (!t || !t.closest) return;
    if ((el = t.closest('[data-w152gclear]'))) { e.preventDefault(); S.ui.gq = ''; S.ui.gplat = ''; S.ui.gyear = ''; S.ui.gshow = 60; paint(); return; }
    if ((el = t.closest('[data-w152gmore]'))) { e.preventDefault(); S.ui.gshow += 60; paint(); return; }
  });

  /* ======================= the Email tab (wave154): sending from welfareavenue.com, the templates, the send log, the CASL rule =======================
     Steel (27/09/26 plan, step 2): Resend from welfareavenue.com, branded templates, a CASL footer, suppression that follows each
     contact's permission, a send log on the timeline, test sends to Steel only. Registered charity (713048502RR0001) confirmed
     28/09/26: implied consent applies (two years after a gift or a serving). The tab talks to the mail-send function; nothing
     goes out in test mode except to the test recipients. */
  var MAIL = { st: null, err: '', busy: '', prev: null, edit: null, form: false, ferr: '', msg: '', sendc: null };
  var MSTATUS = { queued: ['Queued', MUTED], sent: ['Sent', TEAL], delivered: ['Delivered', GREEN], delayed: ['Delayed', '#B9851B'], bounced: ['Bounced', FLAG], complained: ['Complaint', FLAG], failed: ['Failed', FLAG], suppressed: ['Not sent', MUTED] };
  var MKIND = { transactional: ['Confirmation', TEAL], newsletter: ['Newsletter', PURPLE], fundraising: ['Appeal', '#B9851B'], test: ['Test', MUTED] };
  var DSTATUS = { verified: ['Verified', GREEN], pending: ['Waiting for the records', '#B9851B'], not_started: ['Waiting for the records', '#B9851B'], failed: ['Records not found', FLAG], temporary_failure: ['Checking again', '#B9851B'] };
  LOADERS.templates = function () { return db.from('crm_email_templates').select('*').order('sort', { ascending: true }); };
  LOADERS.sends = function () { return db.from('crm_email_sends').select('id,contact_id,to_email,template_key,kind,subject,status,is_test,permission_basis,error,sent_at,delivered_at,opened_at,clicked_at,bounced_at,created_at,created_by,meta').order('created_at', { ascending: false }).limit(200); };

  /* the function behind the tab; a refused call comes back as {error} with the function's own words */
  function mailFn(action, body) {
    if (typeof db === 'undefined' || !db || !db.functions) return Promise.resolve({ error: 'offline' });
    return Promise.resolve(db.functions.invoke('mail-send', { body: Object.assign({ action: action }, body || {}) })).then(function (r) {
      if (r && r.error) {
        var ctx = r.error.context;
        if (ctx && typeof ctx.json === 'function') return ctx.json().then(function (j) { return { error: (j && j.error) || r.error.message || 'The email function refused.' }; }, function () { return { error: r.error.message || 'The email function refused.' }; });
        return { error: r.error.message || 'The email function refused.' };
      }
      return (r && r.data) || {};
    }).catch(function (e) { return { error: String((e && e.message) || e) }; });
  }
  function mchip(map, key) { var d = map[key] || [key || '?', MUTED]; return '<span class="w154chip" style="background:' + d[1] + '17;color:' + d[1] + '"><i style="background:' + d[1] + '"></i>' + E(d[0]) + '</span>'; }
  function testList() { var s = MAIL.st && MAIL.st.settings ? MAIL.st.settings.mail_test_recipients : ''; return String(s || '').toLowerCase().split(/[,;\s]+/).filter(Boolean); }
  function canTest() { return testList().indexOf(myEmail()) >= 0; }
  function mailAdmin() { return MAIL.st ? !!MAIL.st.admin : amAdmin(); }
  function tplByKey(k) { return (S.templates || []).filter(function (t) { return t.key === k; })[0] || null; }
  /* what a contact may receive today, in the words the rule uses (the server checks again before every send) */
  function permWhy(c) {
    var k = c._perm, st = lower(c.email_status);
    var trans = c.emails.length > 0 && st !== 'bounced' && st !== 'complained';
    var news = k === 'express' || k === 'implied';
    var why = k === 'express' ? 'express consent' : k === 'implied' ? 'implied consent until ' + fmtDay(c.implied_consent_until) : k === 'unsub' ? 'unsubscribed' : k === 'bounced' ? 'the address bounces' :
      k === 'none' ? 'no consent' : (c.email_consent === 'implied' ? 'their implied consent ran out' : 'no permission recorded');
    return { news: news, trans: trans, why: why };
  }
  function permLine(c) {
    var w = permWhy(c);
    if (!c.emails.length) return '<div class="w152line m">No email address on file, so nothing can be sent.</div>';
    return '<div class="w152line m w154perm">Newsletters and appeals: <b style="color:' + (w.news ? GREEN : FLAG) + '">' + (w.news ? 'yes' : 'no') + '</b> (' + E(w.why) + ') \u00b7 Confirmations and reminders: <b style="color:' + (w.trans ? GREEN : FLAG) + '">' + (w.trans ? 'yes' : 'no') + '</b></div>';
  }

  /* ---------- the numbers: who can be emailed today ---------- */
  function permStatsHtml(all) {
    var n = { express: 0, implied: 0, unknown: 0, unsub: 0, bounced: 0 };
    all.forEach(function (c) { if (!c.emails.length) return; var k = c._perm === 'none' ? 'unknown' : c._perm; if (n[k] != null) n[k]++; });
    function st(key, v, label, color) { return '<button class="w152st" data-w154perm="' + key + '"><b style="color:' + color + '">' + Number(v).toLocaleString('en-CA') + '</b><span>' + E(label) + '</span></button>'; }
    return '<div class="w152stats w154stats">' +
      st('express', n.express, 'said yes to our emails (express consent)', GREEN) +
      st('implied', n.implied, 'gave or served in the last two years (implied consent)', TEAL) +
      st('unknown', n.unknown, 'with an address but no permission: confirmations only', MUTED) +
      st('unsub', n.unsub + n.bounced, 'unsubscribed or bouncing: never a newsletter', FLAG) + '</div>';
  }

  /* ---------- the sending card: the domain, the settings, the mode ---------- */
  function hostOf(name) { var d = (MAIL.st && MAIL.st.settings && MAIL.st.settings.mail_domain) || 'welfareavenue.com'; var n = String(name || ''); if (n === d) return '@'; return n.replace(new RegExp('\\.' + d.replace(/\./g, '\\.') + '$'), ''); }
  function dnsHtml(dom) {
    var recs = (dom && dom.records) || [];
    if (!recs.length) return '';
    return '<div class="w154dns"><div class="w154dh"><span>Type</span><span>Host (at Namecheap)</span><span>Value</span><span>Status</span></div>' + recs.map(function (r) {
      var val = String(r.value || ''), st = lower(r.status || 'not_started');
      return '<div class="w154dr"><span><b>' + E(r.type) + '</b>' + (r.priority != null ? '<div class="m">priority ' + E(r.priority) + '</div>' : '') + '<div class="m">' + E(r.record || '') + '</div></span>' +
        '<span><code>' + E(hostOf(r.name)) + '</code> <button class="w152mini" data-w152copy="' + E(hostOf(r.name)) + '" aria-label="Copy the host">' + I('copy') + '</button></span>' +
        '<span><code class="v">' + E(val) + '</code> <button class="w152mini" data-w152copy="' + E(val) + '" aria-label="Copy the value">' + I('copy') + 'Copy</button></span>' +
        '<span>' + mchip(DSTATUS, st) + '</span></div>';
    }).join('') + '</div><p class="w152pnote">Add each record at Namecheap under Advanced DNS (the host is relative to welfareavenue.com; <code>@</code> means the domain itself). Leave the Google MX, SPF and DKIM records as they are. Then Check the domain; verification takes a few minutes once the records are live.</p>';
  }
  function settingsFormHtml(s) {
    return '<div class="w152form w154form">' +
      field('From name', inp('mail_from_name', s.mail_from_name, 'Welfare Avenue')) + field('From address', inp('mail_from_email', s.mail_from_email, 'info@welfareavenue.com'), false, 'on welfareavenue.com') +
      field('Reply-to', inp('mail_reply_to', s.mail_reply_to, 'info@welfareavenue.com')) +
      field('Mode', sel('mail_mode', [['test', 'Test mode: only the test recipients get email'], ['live', 'Live: any contact the rule allows']], s.mail_mode || 'test'), false, 'switching to live is the go-ahead for real sends') +
      field('Test recipients', inp('mail_test_recipients', s.mail_test_recipients, 'name@welfareavenue.com, other@\u2026'), true, 'separated by commas') +
      field('Fundraising without consent', sel('mail_fundraising_exemption', [['off', 'Off: appeals follow the newsletter rule (consent needed)'], ['on', 'On: a registered charity may send appeals without consent (CASL s.6 exemption)']], s.mail_fundraising_exemption || 'off'), true) +
      field('Postal address in the footer', inp('mail_postal_address', s.mail_postal_address, 'Welfare Avenue, 8200 av Bloomfield, Montreal QC H3N 2H9'), true) +
      '</div><div class="w152foot"><span class="w152err">' + E(MAIL.ferr) + '</span><button class="w152btn ghost sm" data-w154cancel="1">Cancel</button><button class="w152btn sm" data-w154savecfg="1">' + I('check') + ' Save the settings</button></div>';
  }
  function sendingCardHtml() {
    var st = MAIL.st, s = (st && st.settings) || {}, adm = mailAdmin();
    var head = '<h3>' + I('mail') + ' Sending from ' + E(s.mail_domain || 'welfareavenue.com') + '</h3>';
    if (!st && !MAIL.err) return '<section class="w154card">' + head + '<div class="w152empty">Checking the engine\u2026</div></section>';
    if (MAIL.err && !st) return '<section class="w154card">' + head + '<div class="w152empty">' + I('alert') + ' The email engine did not answer (' + E(MAIL.err) + '). <button class="w152mini" data-w154retry="1">Try again</button></div></section>';
    var dom = st.domain && !st.domain.error ? st.domain : null;
    var dchip = !st.key_present ? mchip({ k: ['Resend key missing', FLAG] }, 'k') : !st.domain_id ? mchip({ k: ['Not set up yet', MUTED] }, 'k') : dom ? mchip(DSTATUS, lower(dom.status)) : mchip({ k: ['Resend did not answer', FLAG] }, 'k');
    var live = (s.mail_mode || 'test') === 'live';
    var lines = '<div class="w154kv"><span>Domain</span><span>' + dchip + '</span></div>' +
      '<div class="w154kv"><span>From</span><span>' + E(s.mail_from_name || 'Welfare Avenue') + ' &lt;' + E(s.mail_from_email || '') + '&gt;' + (s.mail_reply_to ? '<div class="m">replies to ' + E(s.mail_reply_to) + '</div>' : '') + '</span></div>' +
      '<div class="w154kv"><span>Mode</span><span>' + (live ? mchip({ k: ['Live', GREEN] }, 'k') + ' <span class="m">any contact the rule allows</span>' : mchip({ k: ['Test mode', '#B9851B'] }, 'k') + ' <span class="m">only to ' + E(s.mail_test_recipients || 'nobody yet') + '</span>') + '</span></div>' +
      '<div class="w154kv"><span>Webhook</span><span>' + (st.webhook_id && st.webhook_secret_present ? mchip({ k: ['Connected', GREEN] }, 'k') + ' <span class="m">deliveries, opens, bounces and complaints come back to the log</span>' : mchip({ k: ['Not connected', MUTED] }, 'k')) + '</span></div>' +
      '<div class="w154kv"><span>Last 30 days</span><span>' + plural(st.last30.sent, 'email sent', 'emails sent') + ', ' + plural(st.last30.tests, 'test', 'tests') + (st.last30.bounced ? ', ' + plural(st.last30.bounced, 'bounce', 'bounces') : '') + (st.last30.suppressed ? ', ' + st.last30.suppressed + ' held back by the rule' : '') + (st.last30.failed ? ', ' + st.last30.failed + ' failed' : '') + '</span></div>';
    var acts = [];
    if (adm) {
      if (st.key_present && !st.domain_id) acts.push('<button class="w152btn sm" data-w154act="domain_setup">' + I('spark') + ' Set up the domain in Resend</button>');
      if (st.domain_id) acts.push('<button class="w152btn soft sm" data-w154act="domain_verify">' + I('check') + ' Check the domain</button>');
      if (st.key_present && !(st.webhook_id && st.webhook_secret_present)) acts.push('<button class="w152btn soft sm" data-w154act="webhook_setup">' + I('link') + ' Connect the webhook</button>');
      acts.push('<button class="w152btn ghost sm" data-w154cfg="1">' + I('edit') + ' Change the settings</button>');
      acts.push('<button class="w152btn ghost sm" data-w154act="refresh_consent">' + I('shield') + ' Refresh implied consent</button>');
    }
    return '<section class="w154card">' + head + lines + (MAIL.msg ? '<div class="w154msg">' + E(MAIL.msg) + '</div>' : '') +
      (acts.length ? '<div class="w154acts">' + acts.join('') + '</div>' : '') + (MAIL.busy ? '<div class="w152count">' + E(MAIL.busy) + '\u2026</div>' : '') +
      (MAIL.form && adm ? settingsFormHtml(s) : '') + (dom ? dnsHtml(dom) : '') +
      (!st.key_present ? '<p class="w152pnote">The Resend key (RESEND_API_KEY) is missing from the function secrets, so nothing can be sent or set up. An admin adds it in Supabase; the Hub never stores it.</p>' : '') +
      '</section>';
  }

  /* ---------- the templates ---------- */
  function templatesCardHtml() {
    var list = S.templates || [], adm = mailAdmin();
    var rows = list.map(function (t) {
      var on = MAIL.prev && MAIL.prev.key === t.key, ed = MAIL.edit && MAIL.edit.key === t.key;
      return '<div class="w154tpl' + (t.active ? '' : ' off') + (on ? ' on' : '') + '"><div class="w154tph"><div><b>' + E(t.name) + '</b> ' + mchip(MKIND, t.kind) + (t.active ? '' : ' <span class="m">switched off</span>') + '<div class="m">' + E(t.subject) + '</div></div>' +
        '<div class="w154tpa"><button class="w152mini" data-w154prev="' + E(t.key) + '">' + I('search') + (on ? 'Hide' : 'Preview') + '</button>' +
        (canTest() ? '<button class="w152mini" data-w154test="' + E(t.key) + '">' + I('mail') + 'Send me a test</button>' : '') +
        (adm ? '<button class="w152mini" data-w154edit="' + E(t.key) + '">' + I('edit') + (ed ? 'Close' : 'Edit') + '</button>' : '') + '</div></div>' +
        (ed ? editFormHtml(t) : '') +
        (on ? (MAIL.prev.html ? '<div class="w154pv"><div class="m">Subject: <b>' + E(MAIL.prev.subject) + '</b>' + (MAIL.prev.preheader ? ' \u00b7 preview text: ' + E(MAIL.prev.preheader) : '') + '</div><iframe class="w154frame" title="Preview of ' + E(t.name) + '" sandbox="" srcdoc="' + E(MAIL.prev.html) + '"></iframe></div>' : '<div class="w152count">' + E(MAIL.prev.error || 'Rendering the preview\u2026') + '</div>') : '') + '</div>';
    }).join('');
    return '<section class="w154card"><h3>' + I('note') + ' Templates <span class="m">' + plural(list.length, 'template', 'templates') + '</span></h3>' +
      '<p class="w152pnote">Each one is wrapped in the brand layout: the logo on green, cream body, gold button, and a footer with the postal address, the charity number, why they got it and the unsubscribe link. <code>{{first_name}}</code> fills in from the contact; <code>{{name|fallback}}</code> falls back when empty.</p>' +
      (rows || '<div class="w152empty">No templates yet.</div>') + '</section>';
  }
  function editFormHtml(t) {
    return '<div class="w152form w154form w154edit">' +
      field('Name', inp('name', t.name), true) + field('Subject', inp('subject', t.subject), true) + field('Preview text', inp('preheader', t.preheader), true, 'the line inboxes show after the subject') +
      field('Body (HTML: h1, h2, p, ul, li, strong, a class="btn")', area('html_body', t.html_body), true) + field('Plain-text version', area('text_body', t.text_body), true, 'what clients without HTML show') +
      '<label class="full"><input type="checkbox" data-f="active"' + (t.active ? ' checked' : '') + '> In use</label>' +
      '</div><div class="w152foot"><span class="w152err">' + E(MAIL.ferr) + '</span><button class="w152btn ghost sm" data-w154cancel="1">Cancel</button><button class="w152btn sm" data-w154savetpl="' + E(t.key) + '">' + I('check') + ' Save the template</button></div>';
  }

  /* ---------- the send log ---------- */
  function sendRow(s) {
    var c = s.contact_id ? contact(s.contact_id) : null, t = tplByKey(s.template_key);
    var who = c ? '<a href="#crm/c/' + E(c.id) + '">' + E(c.full_name) + '</a><div class="m">' + E(s.to_email) + '</div>' : E(s.to_email);
    var marks = [];
    if (s.opened_at) marks.push('opened'); if (s.clicked_at) marks.push('clicked'); if (s.is_test) marks.push('test');
    return '<div class="w154sr"><span>' + E(fmtDay(s.created_at)) + '<div class="m">' + E(String(s.created_by || '').split('@')[0]) + '</div></span><span>' + who + '</span>' +
      '<span>' + E(t ? t.name : (s.template_key || '')) + (s.subject ? '<div class="m">' + E(clip(s.subject, 70)) + '</div>' : '') + '</span>' +
      '<span>' + mchip(MSTATUS, s.status) + (marks.length ? '<div class="m">' + E(marks.join(', ')) + '</div>' : '') + (s.status === 'suppressed' || s.status === 'failed' ? '<div class="m">' + E(s.permission_basis || s.error || '') + '</div>' : '') + '</span></div>';
  }
  function sendsCardHtml() {
    var list = S.sends || [];
    return '<section class="w154card wide"><h3>' + I('clock') + ' Recent emails <span class="m">' + (list.length ? 'the last ' + list.length : '') + '</span></h3>' +
      (list.length ? '<div class="w154sl"><div class="w154sh"><span>When</span><span>To</span><span>Template</span><span>What happened</span></div>' + list.slice(0, 60).map(sendRow).join('') + '</div>'
        : '<div class="w152empty">Nothing sent yet. The first message is a test to the test recipients once the domain is verified.</div>') + '</section>';
  }
  function ruleHtml() {
    return '<section class="w154card wide w154rule"><h3>' + I('shield') + ' How the rule works</h3>' +
      '<p>Canada\u2019s anti-spam law (CASL) decides who gets what, and the Hub applies it before every send. Confirmations, reminders and receipts are not commercial messages, so they go to anyone whose address works. Newsletters and appeals need <b>express consent</b> (they said yes) or <b>implied consent</b>: Welfare Avenue is a registered charity (no. 713048502RR0001), so a gift or a serving gives two years of implied consent from that day. Someone who unsubscribed or whose address bounces never gets a newsletter or an appeal. Every email carries our postal address and an unsubscribe link, and each send sits on the contact\u2019s timeline with what happened to it. Implied consent is refreshed every morning from the gifts and the rosters.</p></section>';
  }
  function paintEmail(root) {
    var u = S.ui;
    if (!S.templates || !S.sends) {
      root.innerHTML = statsHtml(S.contacts || []) + tabsHtml() + busy('Loading the email centre\u2026');
      Promise.all([load('templates'), load('sends')]).then(function () { if (u.tab === 'email') paint(); });
      return;
    }
    if (!MAIL.st && !MAIL.busy && !MAIL.err) {
      MAIL.busy = 'Checking the engine';
      mailFn('settings').then(function (r) { MAIL.busy = ''; if (r.error) MAIL.err = r.error; else { MAIL.st = r; MAIL.err = ''; } if (u.tab === 'email') paint(); });
    }
    root.innerHTML = statsHtml(S.contacts || []) + tabsHtml() + permStatsHtml(S.contacts || []) +
      '<div class="w154grid">' + sendingCardHtml() + templatesCardHtml() + sendsCardHtml() + ruleHtml() + '</div>';
  }
  function refreshMail(after) {
    return Promise.all([load('sends', true), mailFn('settings')]).then(function (r) { if (!r[1].error) MAIL.st = r[1]; if (after) after(); if (S.ui.tab === 'email') paint(); });
  }
  function mailAct(action) {
    if (MAIL.busy) return;
    MAIL.busy = { domain_setup: 'Setting up the domain in Resend', domain_verify: 'Asking Resend to check the records', webhook_setup: 'Connecting the webhook', refresh_consent: 'Refreshing implied consent' }[action] || 'Working';
    MAIL.msg = ''; paint();
    mailFn(action).then(function (r) {
      MAIL.busy = '';
      if (r.error) { MAIL.msg = r.error; paint(); return; }
      if (action === 'refresh_consent' && r.counts) { MAIL.msg = 'Implied consent refreshed: ' + r.counts.updated + ' contacts updated, ' + r.counts.implied + ' with implied consent today, ' + r.counts.express + ' express.'; load('contacts', true).then(function () { paint(); }); }
      else if (action === 'webhook_setup') MAIL.msg = r.note ? 'The webhook was already connected.' : 'Webhook connected; its secret is in the vault.';
      else if (r.domain) MAIL.msg = 'Domain ' + (r.domain.name || '') + ': ' + ((DSTATUS[lower(r.domain.status)] || [r.domain.status])[0]).toLowerCase() + '.';
      mailFn('settings').then(function (s) { if (!s.error) MAIL.st = s; paint(); });
    });
  }
  function previewTpl(key, contactId) {
    MAIL.prev = { key: key, html: '', subject: '', preheader: '' }; paint();
    mailFn('preview', { template_key: key, contact_id: contactId || undefined }).then(function (r) {
      if (!MAIL.prev || MAIL.prev.key !== key) return;
      if (r.error) MAIL.prev.error = r.error; else { MAIL.prev.html = r.html; MAIL.prev.subject = r.subject; MAIL.prev.preheader = r.preheader; }
      paint();
    });
  }
  function sendTest(key) {
    if (MAIL.busy) return;
    MAIL.busy = 'Sending a test to ' + myEmail(); MAIL.msg = ''; paint();
    mailFn('test', { template_key: key, to: myEmail() }).then(function (r) {
      MAIL.busy = '';
      MAIL.msg = r.error ? 'The test did not go: ' + r.error : 'Test sent to ' + (r.to || myEmail()) + ' (' + (r.status || 'sent') + ').';
      refreshMail();
    });
  }
  function saveSettings() {
    var v = formVals(); MAIL.ferr = '';
    var body = { mail_from_name: v.mail_from_name, mail_from_email: v.mail_from_email, mail_reply_to: v.mail_reply_to, mail_mode: v.mail_mode, mail_test_recipients: v.mail_test_recipients, mail_fundraising_exemption: v.mail_fundraising_exemption, mail_postal_address: v.mail_postal_address };
    MAIL.busy = 'Saving the settings'; paint();
    return mailFn('set_settings', body).then(function (r) {
      MAIL.busy = '';
      if (r.error) { MAIL.ferr = r.error; paint(); return; }
      MAIL.form = false; MAIL.msg = r.changed ? 'Settings saved (' + plural(r.changed, 'change', 'changes') + ').' : 'Nothing changed.';
      mailFn('settings').then(function (s) { if (!s.error) MAIL.st = s; paint(); });
    });
  }
  function saveTemplate(key) {
    var v = formVals(); MAIL.ferr = '';
    if (!String(v.subject || '').trim() || !String(v.html_body || '').trim()) { MAIL.ferr = 'A subject and a body are needed.'; paint(); return Promise.resolve(); }
    MAIL.busy = 'Saving the template'; paint();
    return mailFn('save_template', { key: key, name: v.name, subject: v.subject, preheader: v.preheader, html_body: v.html_body, text_body: v.text_body, active: !!v.active }).then(function (r) {
      MAIL.busy = '';
      if (r.error) { MAIL.ferr = r.error; paint(); return; }
      MAIL.edit = null; MAIL.msg = 'Template saved.';
      if (MAIL.prev && MAIL.prev.key === key) MAIL.prev = null;
      load('templates', true).then(function () { paint(); });
    });
  }
  /* formVals reads [data-f] inside #w152sheet; the Email tab's forms live on the page, so read them there too */
  var __formVals152 = formVals;
  formVals = function () {
    var o = document.querySelector('#w152sheet [data-f]') ? null : document.querySelector('.w152root .w154form');
    if (!o) return __formVals152();
    var v = {};
    o.querySelectorAll('[data-f]').forEach(function (el) { v[el.getAttribute('data-f')] = el.type === 'checkbox' ? el.checked : String(el.value || '').trim(); });
    v._kinds = [];
    return v;
  };

  /* ---------- a contact's page: send them an email ---------- */
  function mailFormHtml(c) {
    var list = (S.templates || []).filter(function (t) { return t.active && t.kind !== 'test'; });
    var cur = MAIL.sendc && MAIL.sendc.id === c.id ? MAIL.sendc : (MAIL.sendc = { id: c.id, key: list.length ? list[0].key : '', html: '', subject: '', err: '', msg: '', busy: '' });
    var t = tplByKey(cur.key), w = permWhy(c), ok = t ? (t.kind === 'transactional' ? w.trans : w.news) : false;
    var mode = MAIL.st && MAIL.st.settings ? MAIL.st.settings.mail_mode : 'test';
    var testOnly = mode !== 'live' && testList().indexOf(lower(c.emails[0])) < 0;
    return '<h2>Send an email</h2><div class="sub">To ' + E(c.full_name) + ' &lt;' + E(c.emails[0] || '') + '&gt;. The Hub checks their permission first and logs the send on their timeline.</div>' +
      '<div class="w152form w154form"><label class="full">Template<select data-f="template_key" data-w154tplsel="' + E(c.id) + '">' + list.map(function (x) { return '<option value="' + E(x.key) + '"' + (x.key === cur.key ? ' selected' : '') + '>' + E(x.name) + ' (' + E((MKIND[x.kind] || [x.kind])[0].toLowerCase()) + ')</option>'; }).join('') + '</select></label></div>' +
      (t ? '<div class="w152line m" style="margin-top:8px">' + (ok ? '<b style="color:' + GREEN + '">Allowed</b>: ' + E(t.kind === 'transactional' ? 'a confirmation or reminder, not a commercial message' : w.why) : '<b style="color:' + FLAG + '">Held back</b>: ' + E(w.why) + '. The Hub will not send a ' + E((MKIND[t.kind] || [t.kind])[0].toLowerCase()) + ' to them.') + '</div>' : '') +
      (testOnly ? '<div class="w152line m">' + I('alert') + ' The Hub is in test mode: this address is not a test recipient, so the send would be refused until an admin switches the Email tab to live.</div>' : '') +
      (cur.html ? '<iframe class="w154frame sheet" title="Preview" sandbox="" srcdoc="' + E(cur.html) + '"></iframe>' : '<div class="w152count">' + E(cur.err || (cur.busy || 'Rendering the preview\u2026')) + '</div>') +
      '<div class="w152foot"><span class="w152err">' + E(cur.msg) + '</span><button class="w152btn ghost" data-w152back="' + E(c.id) + '">Back</button>' +
      '<button class="w152btn" data-w154go="' + E(c.id) + '"' + (!ok || !t || cur.busy ? ' disabled' : '') + '>' + I('mail') + ' Send now</button></div>';
  }
  function mailForm(id) {
    var c = contact(id); if (!c || !c.emails.length) return;
    var open = function () {
      openSheet(mailFormHtml(c), 'mail:' + c.id, true);
      var cur = MAIL.sendc;
      if (cur && cur.key && !cur.html && !cur.busy) {
        cur.busy = 'Rendering the preview';
        mailFn('preview', { template_key: cur.key, contact_id: c.id }).then(function (r) {
          if (!MAIL.sendc || MAIL.sendc.id !== c.id || MAIL.sendc.key !== cur.key) return;
          cur.busy = ''; if (r.error) cur.err = r.error; else { cur.html = r.html; cur.subject = r.subject; }
          if (S.sheet === 'mail:' + c.id) openSheet(mailFormHtml(c), 'mail:' + c.id, true);
        });
      }
    };
    if (!S.templates) load('templates').then(open); else open();
    if (!MAIL.st) mailFn('settings').then(function (r) { if (!r.error) { MAIL.st = r; if (S.sheet === 'mail:' + c.id) openSheet(mailFormHtml(c), 'mail:' + c.id, true); } });
  }
  function sendNow(id) {
    var c = contact(id), cur = MAIL.sendc; if (!c || !cur || cur.id !== c.id || !cur.key) return Promise.resolve();
    cur.busy = 'Sending'; cur.msg = ''; openSheet(mailFormHtml(c), 'mail:' + c.id, true);
    return mailFn('send', { contact_id: c.id, template_key: cur.key }).then(function (r) {
      cur.busy = '';
      if (r.error) { cur.msg = r.error; openSheet(mailFormHtml(c), 'mail:' + c.id, true); return; }
      if (r.status === 'suppressed') { cur.msg = 'Held back by the rule: ' + (r.basis || ''); openSheet(mailFormHtml(c), 'mail:' + c.id, true); return; }
      toastS('Email sent to ' + (r.to || c.emails[0]));
      MAIL.sendc = null; S.sends = null;
      contactSheet(c.id, true);
    });
  }

  /* ---------- styles ---------- */
  var css154 = document.createElement('style'); css154.id = 'w154css';
  css154.textContent = ''
    + '.w154grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;align-items:start;}'
    + '.w154card{background:var(--wa-card,' + CREAM + ');border-radius:18px;box-shadow:' + SH1 + ';padding:18px 20px;min-width:0;}.w154card.wide{grid-column:1/-1;}'
    + '.w154card h3{display:flex;align-items:center;gap:8px;margin:0 0 12px;font-family:' + HEAD + ';font-size:22px;font-weight:600;text-transform:uppercase;letter-spacing:.3px;color:' + GREEN + ';}.w154card h3 .m{font-family:' + BODY + ';font-size:12.5px;font-weight:500;text-transform:none;letter-spacing:0;color:var(--wa-muted,' + MUTED + ');}'
    + '.w154card .m{color:var(--wa-muted,' + MUTED + ');font-size:12.5px;}.w154card p{font-size:14px;line-height:1.55;margin:0 0 10px;}'
    + '.w154chip{display:inline-flex;align-items:center;gap:5px;font-size:11.5px;font-weight:700;border-radius:999px;padding:2px 8px;white-space:nowrap;}.w154chip i{width:7px;height:7px;border-radius:50%;display:inline-block;}'
    + '.w154kv{display:grid;grid-template-columns:110px minmax(0,1fr);gap:10px;padding:7px 0;border-top:1px solid rgba(16,63,57,.07);font-size:13.5px;align-items:start;}.w154kv>span:first-child{font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--wa-muted,' + MUTED + ');padding-top:3px;}'
    + '.w154acts{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px;}.w154msg{margin-top:10px;padding:9px 12px;border-radius:12px;background:rgba(220,165,39,.14);font-size:13px;}'
    + '.w154form{margin-top:14px;}.w154form textarea{min-height:140px;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:12.5px;}'
    + '.w154dns{margin-top:14px;border:1px solid rgba(16,63,57,.1);border-radius:12px;overflow:hidden;}.w154dh,.w154dr{display:grid;grid-template-columns:minmax(0,.6fr) minmax(0,1.15fr) minmax(0,2fr) minmax(0,1.05fr);gap:10px;padding:9px 12px;font-size:13px;align-items:center;}.w154dr .w154chip{white-space:normal;text-align:left;line-height:1.25;}'
    + '.w154dh{font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--wa-muted,' + MUTED + ');background:rgba(16,63,57,.04);}.w154dr{border-top:1px solid rgba(16,63,57,.07);}'
    + '.w154dr code{font-size:12px;background:rgba(16,63,57,.06);border-radius:6px;padding:2px 6px;display:inline-block;max-width:100%;overflow-wrap:anywhere;word-break:break-all;}.w154dr>span{min-width:0;}'
    + '.w154tpl{border-top:1px solid rgba(16,63,57,.08);padding:12px 0;}.w154tpl.off{opacity:.65;}.w154tph{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;}.w154tph b{font-size:14.5px;}.w154tpa{display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end;}'
    + '.w154pv{margin-top:10px;}.w154frame{width:100%;height:640px;border:1px solid rgba(16,63,57,.12);border-radius:12px;background:' + CREAM + ';margin-top:8px;}.w154frame.sheet{height:520px;}'
    + '.w154sl{border:1px solid rgba(16,63,57,.1);border-radius:12px;overflow:hidden;}.w154sh,.w154sr{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.6fr) minmax(0,1.6fr) minmax(0,1.3fr);gap:10px;padding:9px 12px;font-size:13px;align-items:start;}'
    + '.w154sh{font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--wa-muted,' + MUTED + ');background:rgba(16,63,57,.04);}.w154sr{border-top:1px solid rgba(16,63,57,.07);}.w154sr a{color:' + GREEN + ';font-weight:700;text-decoration:none;}'
    + '.w154rule p{font-size:14px;line-height:1.6;}.w154perm b{font-weight:700;}'
    + '.w154st{display:inline-block;font-size:11px;font-weight:700;border-radius:999px;padding:1px 7px;margin-left:6px;vertical-align:middle;}'
    + '@media (max-width:980px){.w154grid{grid-template-columns:1fr;}.w154dh,.w154dr{grid-template-columns:minmax(0,.8fr) minmax(0,1fr) minmax(0,1.6fr);}.w154dh>span:last-child,.w154dr>span:last-child{display:none;}}'
    + '@media (max-width:700px){.w154sh,.w154sr{grid-template-columns:minmax(0,1fr) minmax(0,1.4fr);}.w154sh>span:nth-child(3),.w154sr>span:nth-child(3){display:none;}.w154kv{grid-template-columns:1fr;gap:2px;}.w154frame{height:520px;}}';
  document.head.appendChild(css154);

  /* ---------- wiring for the tab and the contact form ---------- */
  document.addEventListener('click', function (e) {
    var t = e.target, el; if (!t || !t.closest) return;
    if (!(t.closest('.w152root') || t.closest('#w152sheet'))) return;
    if ((el = t.closest('[data-w154perm]'))) { e.preventDefault(); var k = el.getAttribute('data-w154perm'); setFilter({ perm: k === 'unknown' ? 'unknown' : k }); go('#crm'); return; }
    if ((el = t.closest('[data-w154retry]'))) { e.preventDefault(); MAIL.err = ''; MAIL.st = null; paint(); return; }
    if ((el = t.closest('[data-w154act]'))) { e.preventDefault(); mailAct(el.getAttribute('data-w154act')); return; }
    if ((el = t.closest('[data-w154cfg]'))) { e.preventDefault(); MAIL.form = !MAIL.form; MAIL.edit = null; MAIL.ferr = ''; paint(); return; }
    if ((el = t.closest('[data-w154cancel]'))) { e.preventDefault(); MAIL.form = false; MAIL.edit = null; MAIL.ferr = ''; paint(); return; }
    if ((el = t.closest('[data-w154savecfg]'))) { e.preventDefault(); saveSettings(); return; }
    if ((el = t.closest('[data-w154prev]'))) { e.preventDefault(); var pk = el.getAttribute('data-w154prev'); if (MAIL.prev && MAIL.prev.key === pk) { MAIL.prev = null; paint(); } else previewTpl(pk); return; }
    if ((el = t.closest('[data-w154test]'))) { e.preventDefault(); sendTest(el.getAttribute('data-w154test')); return; }
    if ((el = t.closest('[data-w154edit]'))) { e.preventDefault(); var ek = el.getAttribute('data-w154edit'); MAIL.edit = MAIL.edit && MAIL.edit.key === ek ? null : { key: ek }; MAIL.form = false; MAIL.ferr = ''; paint(); return; }
    if ((el = t.closest('[data-w154savetpl]'))) { e.preventDefault(); saveTemplate(el.getAttribute('data-w154savetpl')); return; }
    if ((el = t.closest('[data-w154send]'))) { e.preventDefault(); MAIL.sendc = null; mailForm(el.getAttribute('data-w154send')); return; }
    if ((el = t.closest('[data-w154go]'))) { e.preventDefault(); el.disabled = true; sendNow(el.getAttribute('data-w154go')); return; }
  });
  document.addEventListener('change', function (e) {
    var t = e.target; if (!t || !t.hasAttribute || !t.hasAttribute('data-w154tplsel')) return;
    var id = t.getAttribute('data-w154tplsel'), c = contact(id), cur = MAIL.sendc; if (!c || !cur) return;
    cur.key = t.value; cur.html = ''; cur.err = ''; cur.msg = ''; cur.busy = '';
    mailForm(id);
  });
  /* ======================= Lists and Campaigns (wave155, 27/09/26) =======================
     Step 3 of the plan, re-scoped by the CRM deep dive: lists built from groups of conditions (AND inside a group, OR
     between groups, over contact, volunteering, gifts, email activity and consent), saved live or fixed; campaigns that
     send the newsletter template to a list through mail-send (the CASL rule per person, Resend's pace, a daily cap for the
     free plan). Steel, 27/09/26: anyone with the CRM sends; volunteer call-outs go to everyone not unsubscribed ("Keela's
     way"); the sender is chosen per campaign; nothing reaches anyone but the test recipients while the mode is test. */
  P.list = '<path d="M8 7h12M8 12h12M8 17h12"/><circle cx="4.5" cy="7" r="1"/><circle cx="4.5" cy="12" r="1"/><circle cx="4.5" cy="17" r="1"/>';
  P.send = '<path d="M21 3 10.5 13.5"/><path d="M21 3 14.5 21l-4-7.5L3 9.5z"/>';
  MSTATUS.sending = ['Sending', TEAL]; MSTATUS.cancelled = ['Cancelled', MUTED]; MKIND.volunteer = ['Volunteer call-out', TEAL];
  var LC = { edit: null, prev: null, pT: null, msg: '', err: '', busy: '', sizes: null, c: null, cprev: null, check: null, confirm: false, cmsg: '', cerr: '', cbusy: '', rcp: null, rcpFor: null, newList: null, cid: null };
  LOADERS.lists = function () { return db.from('crm_lists').select('*').order('updated_at', { ascending: false }); };
  LOADERS.campaigns = function () { return db.from('crm_campaigns').select('*').order('created_at', { ascending: false }).limit(300); };
  LOADERS.cstats = function () { return db.from('crm_campaign_stats_v').select('*'); };
  var CK = { newsletter: ['Newsletter', PURPLE, 'People who said yes, or gave or served in the last two years.'], fundraising: ['Fundraising appeal', '#B9851B', 'The same people as a newsletter (the exemption setting is off).'],
    volunteer: ['Volunteer call-out', TEAL, 'Everyone on the list with a working address who has not unsubscribed.'] };
  var CSTAT = { draft: ['Draft', MUTED], queued: ['Queued', '#B9851B'], sending: ['Sending', TEAL], sent: ['Sent', GREEN], cancelled: ['Stopped', FLAG] };
  function lchip(map, k) { var d = map[k] || [k || '?', MUTED]; return '<span class="w154chip" style="background:' + d[1] + '17;color:' + d[1] + '"><i style="background:' + d[1] + '"></i>' + E(d[0]) + '</span>'; }
  function sizes() {
    if (typeof db === 'undefined' || !db || !db.rpc) return Promise.resolve();
    return Promise.resolve(db.rpc('crm_list_sizes')).then(function (r) { var m = {}; ((r && r.data) || []).forEach(function (x) { m[String(x.list_id)] = Number(x.members) || 0; }); LC.sizes = m; }, function () { LC.sizes = LC.sizes || {}; });
  }
  function listById(id) { return (S.lists || []).filter(function (l) { return String(l.id) === String(id); })[0] || null; }

  /* ---------- the conditions a list can hold ---------- */
  var LF = [
    ['kind', 'Contact type', 'sel', ['is', 'not']], ['role', 'Volunteer role', 'sel', ['is', 'not']], ['tag', 'Tag', 'text', ['has', 'not']],
    ['perm', 'Email permission', 'sel', ['is', 'not']], ['email', 'Email address', 'none', ['has', 'none']],
    ['served', 'Served at an event', 'num', ['ever', 'never', 'within', 'count_gte']], ['gave', 'Gave a gift', 'num', ['ever', 'never', 'within', 'lapsed', 'total_gte', 'count_gte']],
    ['city', 'City', 'text', ['contains', 'not']], ['language', 'Language', 'sel', ['is', 'not']], ['source', 'Came from', 'sel', ['is', 'not']],
    ['added', 'Added to the CRM', 'num', ['within']], ['active', 'Last activity', 'num', ['within']],
    ['opened', 'Opened a Hub email', 'num', ['within']], ['clicked', 'Clicked a Hub email', 'num', ['within']],
    ['review', 'Volunteer record needs a review', 'none', ['is', 'not']], ['search', 'Name, email or organization', 'text', ['contains']]
  ];
  var LOP = { is: 'is', not: 'is not', has: 'has', none: 'has none', ever: 'ever', never: 'never', within: 'in the last \u2026 days', count_gte: 'at least \u2026 times', lapsed: 'not in the last \u2026 days', total_gte: 'at least $\u2026 in total', contains: 'contains' };
  function lf(f) { return LF.filter(function (x) { return x[0] === f; })[0] || LF[0]; }
  function lopts(f) {
    if (f === 'kind') return KIND_ORDER.map(function (k) { return [k, (KINDS[k] || [k])[0]]; });
    if (f === 'role') return ROLE_ORDER.map(function (r) { return [r, ROLES[r]]; });
    if (f === 'perm') return [['express', 'Express consent'], ['implied', 'Implied consent'], ['unknown', 'Not recorded'], ['unsub', 'Unsubscribed or bouncing']];
    if (f === 'language') return [['en', 'English'], ['fr', 'French']];
    if (f === 'source') return Object.keys(SOURCES).map(function (k) { return [k, SOURCES[k][0]]; });
    return [];
  }
  function needsValue(k) {
    var d = lf(k.f);
    if (d[2] === 'none') return false;
    if (k.f === 'served' || k.f === 'gave') return ['within', 'lapsed', 'count_gte', 'total_gte'].indexOf(k.op) >= 0;
    return true;
  }
  function defVal(f, op) {
    if (op === 'within' || op === 'lapsed') return f === 'added' ? '30' : f === 'opened' || f === 'clicked' || f === 'active' ? '90' : '365';
    if (op === 'count_gte') return f === 'served' ? '3' : '2';
    if (op === 'total_gte') return '100';
    var o = lopts(f); return o.length ? o[0][0] : '';
  }
  function newCond(f) { var d = lf(f || 'kind'); var op = d[3][0]; return { f: d[0], op: op, v: defVal(d[0], op) }; }
  function condHtml(k, gi, ci) {
    var d = lf(k.f), at = gi + '.' + ci;
    var fs = '<select class="w152sel" data-w155cf="' + at + '" aria-label="Field">' + LF.map(function (x) { return '<option value="' + x[0] + '"' + (x[0] === k.f ? ' selected' : '') + '>' + E(x[1]) + '</option>'; }).join('') + '</select>';
    var os = '<select class="w152sel" data-w155co="' + at + '" aria-label="Condition">' + d[3].map(function (o) { return '<option value="' + o + '"' + (o === k.op ? ' selected' : '') + '>' + E(LOP[o]) + '</option>'; }).join('') + '</select>';
    var vs = '';
    if (needsValue(k)) {
      var opts = lopts(k.f);
      if (d[2] === 'sel' && opts.length) vs = '<select class="w152sel" data-w155cv="' + at + '" aria-label="Value">' + opts.map(function (o) { return '<option value="' + E(o[0]) + '"' + (String(o[0]) === String(k.v) ? ' selected' : '') + '>' + E(o[1]) + '</option>'; }).join('') + '</select>';
      else vs = '<input class="w152in" data-w155cv="' + at + '" aria-label="Value" ' + (d[2] === 'num' ? 'type="number" min="0" ' : 'type="text" ') + 'value="' + E(k.v) + '">';
    }
    return '<div class="w155c">' + fs + os + vs + '<button class="w152mini" data-w155cx="' + at + '" aria-label="Remove this condition">' + I('x') + '</button></div>';
  }
  function cleanGroups(groups) {
    return (groups || []).map(function (g) { return { all: (g.all || []).filter(function (k) { return k && k.f; }).map(function (k) { var o = { f: k.f, op: k.op }; if (needsValue(k)) o.v = String(k.v == null ? '' : k.v); return o; }) }; });
  }
  /* the Contacts tab's filters as one group */
  function groupsFromFilters() {
    var u = S.ui, all = [];
    if (u.kind) all.push({ f: 'kind', op: 'is', v: u.kind });
    if (u.role) all.push({ f: 'role', op: 'is', v: u.role });
    if (u.act === 'served12') all.push({ f: 'served', op: 'within', v: '365' });
    else if (u.act === 'served') all.push({ f: 'served', op: 'ever' });
    else if (u.act === 'never') { all.push({ f: 'kind', op: 'is', v: 'volunteer' }); all.push({ f: 'served', op: 'never' }); }
    else if (u.act === 'review') all.push({ f: 'review', op: 'is' });
    else if (u.act === 'noemail') all.push({ f: 'email', op: 'none' });
    else if (u.act === 'new30') all.push({ f: 'added', op: 'within', v: '30' });
    if (u.perm) all.push({ f: 'perm', op: 'is', v: u.perm });
    if (u.q) all.push({ f: 'search', op: 'contains', v: u.q });
    return [{ all: all }];
  }
  function describe(groups) {
    var gs = cleanGroups(groups);
    if (!gs.length || gs.every(function (g) { return !g.all.length; })) return 'Everyone in the CRM';
    return gs.map(function (g) {
      return g.all.map(function (k) {
        var d = lf(k.f), o = lopts(k.f), lab = o.filter(function (x) { return String(x[0]) === String(k.v); })[0];
        var val = lab ? lab[1] : k.v, op = LOP[k.op] || k.op;
        if (op.indexOf('\u2026') >= 0) return d[1] + ' ' + op.replace('\u2026', val || '\u2026');
        return d[1] + ' ' + op + (needsValue(k) && val ? ' ' + val : '');
      }).join(' and ') || 'everyone';
    }).join('; or ');
  }

  /* ---------- the live count while a list is being built ---------- */
  function previewSoon() {
    clearTimeout(LC.pT);
    LC.pT = setTimeout(function () {
      var ed = LC.edit; if (!ed) return;
      var groups = cleanGroups(ed.groups), token = JSON.stringify(groups);
      LC.prev = { token: token, busy: true, ids: LC.prev && LC.prev.ids };
      paintPrev();
      Promise.resolve(db.rpc('crm_list_preview', { p_filter: { groups: groups } })).then(function (r) {
        if (!LC.edit || JSON.stringify(cleanGroups(LC.edit.groups)) !== token) return;
        if (r && r.error) { LC.prev = { token: token, err: String(r.error.message || r.error) }; paintPrev(); return; }
        var ids = ((r && r.data) || []).map(function (x) { return typeof x === 'object' && x !== null ? (x.crm_list_preview != null ? x.crm_list_preview : x.id) : x; });
        LC.prev = { token: token, ids: ids }; paintPrev();
      }, function (e) { LC.prev = { token: token, err: String((e && e.message) || e) }; paintPrev(); });
    }, 350);
  }
  function prevHtml() {
    var p = LC.prev;
    if (!p || (!p.ids && p.busy)) return '<div class="w155res m">Counting\u2026</div>';
    if (p.err) return '<div class="w155res w152err">The count did not come back: ' + E(p.err) + '</div>';
    var ids = p.ids || [], people = ids.map(contact).filter(Boolean);
    var news = 0, vol = 0, noem = 0;
    people.forEach(function (c) { if (!c.emails.length) { noem++; return; } if (c._perm === 'express' || c._perm === 'implied') news++; if (c._perm !== 'unsub' && c._perm !== 'bounced') vol++; });
    var names = people.slice(0, 8).map(function (c) { return '<button class="w152lnk" data-w152open="' + E(c.id) + '">' + E(c.full_name || '(no name)') + '</button>'; }).join(', ');
    return '<div class="w155res' + (p.busy ? ' busy' : '') + '"><b>' + plural(ids.length, 'person matches', 'people match') + '</b>' +
      '<div class="w155mix"><span><b>' + news.toLocaleString('en-CA') + '</b> can get a newsletter</span><span><b>' + vol.toLocaleString('en-CA') + '</b> can get a volunteer call-out</span><span><b>' + noem.toLocaleString('en-CA') + '</b> have no email</span></div>' +
      (names ? '<div class="m">' + names + (ids.length > 8 ? ' and ' + plural(ids.length - 8, 'other', 'others') : '') + '</div>' : '') + '</div>';
  }
  function paintPrev() { var el = document.querySelector('#crm [data-w155res]'); if (el) el.innerHTML = prevHtml(); }

  /* ---------- the Lists tab ---------- */
  function listRow(l) {
    var n = LC.sizes && LC.sizes[String(l.id)] != null ? LC.sizes[String(l.id)] : (l.kind === 'static' ? (l.member_ids || []).length : null);
    return '<div class="w155row" role="listitem"><div class="w155nm"><b>' + E(l.name) + '</b><span class="m">' + E(l.description || describe((l.filter || {}).groups || [])) + '</span></div>' +
      '<div>' + lchip({ dynamic: ['Live', TEAL], static: ['Fixed', PURPLE] }, l.kind) + '</div><div class="w155n">' + (n == null ? '\u2026' : plural(n, 'person', 'people')) + '</div>' +
      '<div class="w155ra"><button class="w152btn sm ghost" data-w155edit="' + E(l.id) + '">' + I('edit') + ' Open</button><button class="w152btn sm" data-w155mail="' + E(l.id) + '">' + I('mail') + ' Email this list</button></div></div>';
  }
  function builderHtml() {
    var ed = LC.edit;
    if (!ed) return '<div class="w154card"><h3>' + I('list') + ' Build a list</h3><p>A list is a set of conditions: everyone who matches them today. Conditions in one group must all hold (and); a person who matches any group is in (or).</p><p class="m">Live lists follow the data, so a volunteer who serves on Sunday is in the \u201cserved in the last year\u201d list on Monday. Fixed lists keep the people they had when saved.</p></div>';
    var gs = ed.groups.map(function (g, gi) {
      return (gi ? '<div class="w155or"><span>or</span></div>' : '') + '<div class="w155g"><div class="w155gh">' + (ed.groups.length > 1 ? 'Group ' + (gi + 1) : 'People who match all of these') +
        (ed.groups.length > 1 ? '<button class="w152mini" data-w155gx="' + gi + '">' + I('x') + ' Remove the group</button>' : '') + '</div>' +
        (g.all.length ? g.all.map(function (k, ci) { return condHtml(k, gi, ci); }).join('<div class="w155and">and</div>') : '<div class="m">No condition yet: everyone in the CRM.</div>') +
        '<button class="w152btn sm ghost" data-w155and="' + gi + '">' + I('plus') + ' And</button></div>';
    }).join('');
    return '<div class="w154card w155b"><h3>' + I('list') + (ed.id ? ' Edit the list' : ' New list') + '</h3>' +
      '<label class="w155lb">Name<input class="w152in" data-w155f="name" value="' + E(ed.name) + '" placeholder="Toronto volunteers who served this year"></label>' +
      '<label class="w155lb">What it is for<input class="w152in" data-w155f="description" value="' + E(ed.description) + '" placeholder="Optional"></label>' +
      gs + '<button class="w152btn sm ghost" data-w155or>' + I('plus') + ' Or: another group</button>' +
      '<div data-w155res>' + prevHtml() + '</div>' +
      (ed.del ? '<div class="w154msg">Delete \u201c' + E(ed.name) + '\u201d? Campaigns that used it keep their history. <button class="w152btn sm danger" data-w155delok>Delete it</button> <button class="w152btn sm ghost" data-w155delno>Keep it</button></div>' : '') +
      (LC.err ? '<div class="w152err">' + E(LC.err) + '</div>' : '') +
      '<div class="w154acts"><button class="w152btn" data-w155save="dynamic">' + I('check') + ' Save as a live list</button><button class="w152btn ghost" data-w155save="static">Save as a fixed list</button>' +
      (ed.id ? '<button class="w152btn ghost" data-w155del>' + I('trash') + ' Delete</button>' : '') + '<button class="w152btn ghost" data-w155cancel>Cancel</button></div></div>';
  }
  function paintLists(root) {
    if (!S.lists || !LC.sizes) { root.innerHTML = statsHtml(S.contacts || []) + tabsHtml() + busy('Loading the lists\u2026'); Promise.all([load('lists'), sizes()]).then(function () { if (S.ui.tab === 'lists') paint(); }); return; }
    var ls = S.lists;
    root.innerHTML = statsHtml(S.contacts || []) + tabsHtml() + '<div class="w155grid">' +
      '<div class="w154card"><h3>' + I('list') + ' Saved lists <span class="m">' + plural(ls.length, 'list', 'lists') + '</span></h3>' +
      '<div class="w154acts" style="margin:0 0 10px"><button class="w152btn sm" data-w155new>' + I('plus') + ' New list</button><button class="w152btn sm ghost" data-w155fromf>From the Contacts filters</button></div>' +
      (LC.msg ? '<div class="w154msg">' + E(LC.msg) + '</div>' : '') +
      (ls.length ? '<div class="w155rows" role="list">' + ls.map(listRow).join('') + '</div>' : '<p class="m">No list yet. Start with New list, or narrow the Contacts tab and save its filters as a list.</p>') + '</div>' +
      builderHtml() + '</div>';
    if (LC.edit && !LC.prev) previewSoon();
  }
  function saveList(kind) {
    var ed = LC.edit; if (!ed) return;
    var name = String(ed.name || '').trim(); if (!name) { LC.err = 'A list needs a name.'; paint(); return; }
    var groups = cleanGroups(ed.groups);
    var go2 = function (ids) {
      var row = { name: name, description: String(ed.description || '').trim() || null, kind: kind, filter: { groups: groups }, member_ids: kind === 'static' ? ids : [], updated_by: actor(), updated_at: new Date().toISOString() };
      var q = ed.id ? db.from('crm_lists').update(row).eq('id', ed.id).select().single() : db.from('crm_lists').insert(Object.assign({ created_by: actor() }, row)).select().single();
      LC.err = ''; return Promise.resolve(q).then(function (r) {
        if (r && r.error) { LC.err = 'Not saved: ' + (r.error.message || r.error); paint(); return; }
        LC.msg = '\u201c' + name + '\u201d saved as a ' + (kind === 'static' ? 'fixed list of ' + plural(ids.length, 'person', 'people') : 'live list') + '.';
        LC.edit = null; LC.prev = null; LC.sizes = null; return load('lists', true).then(function () { paint(); });
      });
    };
    if (kind !== 'static') { go2([]); return; }
    Promise.resolve(db.rpc('crm_list_preview', { p_filter: { groups: groups } })).then(function (r) {
      var ids = ((r && r.data) || []).map(function (x) { return typeof x === 'object' && x !== null ? (x.crm_list_preview != null ? x.crm_list_preview : x.id) : x; }).map(Number).filter(function (x) { return x; });
      go2(ids);
    });
  }
  function delList() {
    var ed = LC.edit; if (!ed || !ed.id) return;
    Promise.resolve(db.from('crm_lists').delete().eq('id', ed.id)).then(function (r) {
      if (r && r.error) { LC.err = 'Not deleted: ' + (r.error.message || r.error); paint(); return; }
      LC.msg = '\u201c' + ed.name + '\u201d deleted.'; LC.edit = null; LC.prev = null; LC.sizes = null; load('lists', true).then(function () { paint(); });
    });
  }
  function atOf(s) { var p = String(s || '').split('.'); return { g: Number(p[0]), c: Number(p[1]) }; }

  /* ---------- the Campaigns tab ---------- */
  function statsFor(id) { return (S.cstats || []).filter(function (x) { return String(x.campaign_id) === String(id); })[0] || {}; }
  function campById(id) { return (S.campaigns || []).filter(function (x) { return String(x.id) === String(id); })[0] || null; }
  function pct(a, b) { a = Number(a) || 0; b = Number(b) || 0; return b ? Math.round(a * 100 / b) + '%' : '0%'; }
  function myName() { var me = (S.contacts || []).filter(function (c) { return c.emails.map(lower).indexOf(myEmail()) >= 0; })[0]; return me && me.full_name ? me.full_name : myEmail().split('@')[0].replace(/[._-]+/g, ' ').replace(/\b\w/g, function (x) { return x.toUpperCase(); }); }
  function onDomainMe() { return /@welfareavenue\.com$/.test(myEmail()); }
  function blankCampaign(listId) {
    return { id: null, name: '', list_id: listId || (S.lists && S.lists[0] ? S.lists[0].id : null), kind: 'newsletter', template_key: 'newsletter', from: 'org', from_name: '', from_email: '', subject: '', preheader: '', headline: '', body: '', cta_label: '', cta_url: '' };
  }
  function fromCampaign(k) {
    var v = k.vars || {};
    var from = !k.from_email ? 'org' : (String(k.from_email).toLowerCase() === myEmail() ? 'me' : 'custom');
    return { id: k.id, name: k.name || '', list_id: k.list_id, kind: k.kind || 'newsletter', template_key: k.template_key || 'newsletter', from: from, from_name: k.from_name || '', from_email: k.from_email || '', subject: k.subject || '', preheader: k.preheader || '',
      headline: v.headline || '', body: v.body_text || '', cta_label: v.cta_label || '', cta_url: v.cta_url || '' };
  }
  function bodyHtml(t) { return String(t || '').trim().split(/\n\s*\n/).filter(function (p) { return p.trim(); }).map(function (p) { return '<p>' + E(p.trim()).replace(/\n/g, '<br>') + '</p>'; }).join(''); }
  function campRow(c) {
    var s = campById(c.id) || c, row = s.vars || {};
    var cs = statsFor(c.id), list = listById(c.list_id), sent = Number(cs.sent) || 0;
    return '<div class="w155cr" role="listitem"><button class="w155cn" data-w155copen="' + E(c.id) + '"><b>' + E(c.name || c.subject || 'Untitled') + '</b><span class="m">' + E(c.subject || '') + '</span></button>' +
      '<div>' + lchip(CSTAT, c.status) + '</div><div class="m">' + E(list ? list.name : 'No list') + '<br>' + E((CK[c.kind] || [c.kind])[0]) + '</div>' +
      '<div class="w155n">' + (c.status === 'draft' ? '<span class="m">not sent</span>' : '<b>' + sent.toLocaleString('en-CA') + '</b> sent \u00b7 ' + pct(cs.opened, sent) + ' opened \u00b7 ' + pct(cs.clicked, sent) + ' clicked') + '</div>' +
      '<div class="m">' + E(fmtDay(c.sent_at || c.queued_at || c.updated_at || c.created_at)) + '</div></div>';
  }
  function campListHtml() {
    var cs = S.campaigns || [];
    return '<div class="w154card wide"><h3>' + I('send') + ' Campaigns <span class="m">' + plural(cs.length, 'campaign', 'campaigns') + '</span></h3>' +
      '<div class="w154acts" style="margin:0 0 10px"><button class="w152btn sm" data-w155cnew>' + I('plus') + ' New campaign</button></div>' +
      (LC.cmsg && !LC.c ? '<div class="w154msg">' + E(LC.cmsg) + '</div>' : '') +
      (cs.length ? '<div class="w155ct" role="list"><div class="w155ch" aria-hidden="true"><span>Campaign</span><span>Status</span><span>List and kind</span><span>Results</span><span>Date</span></div>' + cs.map(campRow).join('') + '</div>'
        : '<p class="m">No campaign yet. A campaign sends one message to a list, person by person, through the CASL rule.</p>') + '</div>';
  }
  function modeLine() {
    var st = MAIL.st && MAIL.st.settings ? MAIL.st.settings : null; if (!st) return '';
    var live = st.mail_mode === 'live';
    return '<div class="w155mode ' + (live ? 'live' : 'test') + '">' + (live ? I('check') + ' Live: a campaign reaches its list.' : I('lock') + ' Test mode: campaigns can be written and tested, and go out once an admin switches the mode to live in the Email tab.') +
      (st.mail_daily_cap ? ' Up to ' + E(st.mail_campaign_daily_cap || st.mail_daily_cap) + ' campaign emails a day (Resend\u2019s free plan).' : '') + '</div>';
  }
  function editorHtml() {
    var c = LC.c, ls = S.lists || [], me = myEmail();
    var listSel = '<select class="w152sel" data-w155k="list_id" aria-label="List"><option value="">Pick a list\u2026</option>' + ls.map(function (l) { var n = LC.sizes && LC.sizes[String(l.id)] != null ? ' (' + plural(LC.sizes[String(l.id)], 'person', 'people') + ')' : ''; return '<option value="' + E(l.id) + '"' + (String(l.id) === String(c.list_id) ? ' selected' : '') + '>' + E(l.name + n) + '</option>'; }).join('') + '</select>';
    var kindSel = '<select class="w152sel" data-w155k="kind" aria-label="Kind">' + Object.keys(CK).map(function (k) { return '<option value="' + k + '"' + (k === c.kind ? ' selected' : '') + '>' + E(CK[k][0]) + '</option>'; }).join('') + '</select>';
    var st = MAIL.st && MAIL.st.settings ? MAIL.st.settings : {};
    var fromSel = '<select class="w152sel" data-w155k="from" aria-label="From"><option value="org"' + (c.from === 'org' ? ' selected' : '') + '>' + E((st.mail_from_name || 'Welfare Avenue') + ' <' + (st.mail_from_email || 'info@welfareavenue.com') + '>') + '</option>' +
      (onDomainMe() ? '<option value="me"' + (c.from === 'me' ? ' selected' : '') + '>' + E(myName() + ' <' + me + '>') + '</option>' : '') + '<option value="custom"' + (c.from === 'custom' ? ' selected' : '') + '>Someone else on the team\u2026</option></select>';
    var f = function (k, label, ph, area) { return '<label class="w155lb">' + E(label) + (area ? '<textarea class="w152in" data-w155k="' + k + '" rows="8" placeholder="' + E(ph || '') + '">' + E(c[k]) + '</textarea>' : '<input class="w152in" data-w155k="' + k + '" value="' + E(c[k]) + '" placeholder="' + E(ph || '') + '">') + '</label>'; };
    return '<div class="w154card"><h3>' + I('send') + (c.id ? ' Edit the campaign' : ' New campaign') + '</h3>' + modeLine() +
      f('name', 'Name (for the team)', 'October volunteer call-out') +
      '<label class="w155lb">Send to' + listSel + '</label>' +
      '<label class="w155lb">Kind of message' + kindSel + '<span class="m">' + E((CK[c.kind] || CK.newsletter)[2]) + '</span></label>' +
      '<label class="w155lb">From' + fromSel + '</label>' +
      (c.from === 'custom' ? '<div class="w155two">' + f('from_name', 'Their name', 'Sama Saqib') + f('from_email', 'Their address', 'name@welfareavenue.com') + '</div>' : '') +
      f('subject', 'Subject', 'Sunday needs you, {{first_name|friend}}') + f('preheader', 'Preview text (the line after the subject in the inbox)', 'Servers and cooks wanted for 12 October') +
      f('headline', 'Headline', 'Join us this Sunday') + f('body', 'Message (a blank line starts a new paragraph)', 'Hi {{first_name|there}},\n\nWe are serving at \u2026', true) +
      '<div class="w155two">' + f('cta_label', 'Button', 'Sign up to serve') + f('cta_url', 'Button link', 'https://welfareavenue.com') + '</div>' +
      '<p class="m">{{first_name|there}} becomes each person\u2019s first name. Every email carries the charity number, the postal address, why they got it and an unsubscribe link.</p>' +
      (LC.cerr ? '<div class="w152err">' + E(LC.cerr) + '</div>' : '') + (LC.cmsg ? '<div class="w154msg">' + E(LC.cmsg) + '</div>' : '') + (LC.cbusy ? '<div class="m">' + E(LC.cbusy) + '</div>' : '') +
      '<div class="w154acts"><button class="w152btn ghost" data-w155csave>' + I('check') + ' Save the draft</button><button class="w152btn ghost" data-w155cprev>Preview</button>' +
      '<button class="w152btn ghost" data-w155ctest>' + I('mail') + ' Send me a test</button><button class="w152btn" data-w155csend>' + I('send') + ' Send\u2026</button>' +
      '<button class="w152btn ghost" data-w155cclose>Close</button>' + (c.id ? '<button class="w152btn ghost" data-w155cdel>' + I('trash') + ' Delete the draft</button>' : '') + '</div></div>';
  }
  function checkHtml() {
    var k = LC.check; if (!k) return '';
    if (k.error && k.audience == null) return '<div class="w152err">' + E(k.error) + '</div>';
    var why = Object.keys(k.why || {}).map(function (b) { return '<li>' + E(b) + ': ' + Number(k.why[b]).toLocaleString('en-CA') + '</li>'; }).join('');
    var live = k.mode === 'live';
    return '<div class="w155chk"><b>' + plural(k.eligible || 0, 'person gets it', 'people get it') + '</b> of ' + plural(k.audience || 0, 'person', 'people') + ' on the list' +
      (k.duplicates ? ' (' + plural(k.duplicates, 'shared address', 'shared addresses') + ' counted once)' : '') + '.' +
      (k.held ? '<div class="m">Held back by the rule: ' + plural(k.held, 'person', 'people') + '</div><ul>' + why + '</ul>' : '') +
      (k.per_day ? '<div class="m">At up to ' + k.per_day + ' a day this takes ' + plural(k.days || 1, 'day', 'days') + '.</div>' : '') +
      (LC.confirm ? (live && k.eligible ? '<div class="w155cf"><b>Send it to ' + plural(k.eligible, 'person', 'people') + ' now?</b> The first ones go within the minute; the rest follow at Resend\u2019s pace.<div class="w154acts"><button class="w152btn" data-w155cgo>' + I('send') + ' Send it</button><button class="w152btn ghost" data-w155cno>Not yet</button></div></div>'
        : !live ? '<div class="w155cf test">' + I('lock') + ' The Hub is in test mode, so this campaign cannot go to the list yet. Send yourself a test; an admin switches the mode to live in the Email tab when the team is ready.</div>' : '<div class="w155cf test">Nobody on this list can receive it.</div>') : '') + '</div>';
  }
  function previewPane() {
    var p = LC.cprev;
    return '<div class="w154card"><h3>' + I('mail') + ' Preview</h3>' + checkHtml() +
      (p && p.html ? '<div class="w154pv"><div class="m">From: ' + E(p.from || '') + '<br>Subject: <b>' + E(p.subject || '') + '</b>' + (p.preheader ? '<br>Preview text: ' + E(p.preheader) : '') + '</div><iframe class="w154frame" sandbox="" title="The email as it will look" srcdoc="' + E(p.html) + '"></iframe></div>'
        : p && p.err ? '<div class="w152err">' + E(p.err) + '</div>' : '<p class="m">Preview shows the email in the Welfare Avenue layout, as it will look in an inbox.</p>') + '</div>';
  }
  function reportHtml(k) {
    var cs = statsFor(k.id), list = listById(k.list_id), sent = Number(cs.sent) || 0, elig = Number(k.eligible) || 0, waiting = Number(cs.queued) || 0;
    var tile = function (n, l) { return '<div class="w152st"><b>' + (Number(n) || 0).toLocaleString('en-CA') + '</b><span>' + E(l) + '</span></div>'; };
    var rows = (LC.rcpFor === k.id && LC.rcp) ? LC.rcp : null;
    var bar = elig ? Math.min(100, Math.round(sent * 100 / elig)) : 0;
    return '<div class="w154card wide"><h3>' + I('send') + ' ' + E(k.name || k.subject) + ' ' + lchip(CSTAT, k.status) + '</h3>' +
      '<div class="w154kv"><span>Subject</span><span>' + E(k.subject || '') + '</span></div><div class="w154kv"><span>List</span><span>' + E(list ? list.name : 'the list was deleted') + ' \u00b7 ' + E((CK[k.kind] || [k.kind])[0]) + '</span></div>' +
      '<div class="w154kv"><span>From</span><span>' + E((k.from_name || (MAIL.st && MAIL.st.settings && MAIL.st.settings.mail_from_name) || 'Welfare Avenue') + ' <' + (k.from_email || (MAIL.st && MAIL.st.settings && MAIL.st.settings.mail_from_email) || 'info@welfareavenue.com') + '>') + '</span></div>' +
      '<div class="w154kv"><span>Sent</span><span>' + (k.queued_at ? 'started ' + E(fmtDay(k.queued_at)) + ' by ' + E(k.updated_by || k.created_by || '') : 'not started') + (k.sent_at ? ', finished ' + E(fmtDay(k.sent_at)) : '') + '</span></div>' +
      '<div class="w155bar" role="progressbar" aria-valuenow="' + bar + '" aria-valuemin="0" aria-valuemax="100"><i style="width:' + bar + '%"></i></div><div class="m">' + plural(sent, 'email sent', 'emails sent') + ' of ' + plural(elig, 'person', 'people') + (waiting ? ' \u00b7 ' + plural(waiting, 'waiting', 'waiting') : '') + '</div>' +
      '<div class="w152stats">' + tile(cs.delivered, 'delivered') + tile(cs.opened, 'opened (' + pct(cs.opened, sent) + ')') + tile(cs.clicked, 'clicked (' + pct(cs.clicked, sent) + ')') + tile(cs.unsubscribed, 'unsubscribed') + '</div>' +
      '<div class="w152stats">' + tile(cs.bounced, 'bounced') + tile(cs.suppressed, 'held back by the rule') + tile(cs.failed, 'failed') + tile(cs.cancelled, 'cancelled') + '</div>' +
      (LC.cmsg ? '<div class="w154msg">' + E(LC.cmsg) + '</div>' : '') +
      '<div class="w154acts">' + ((k.status === 'sending' || k.status === 'queued') && waiting ? '<button class="w152btn ghost" data-w155cstop>Stop what is still waiting</button>' : '') +
      '<button class="w152btn ghost" data-w155cdup>Copy into a new draft</button><button class="w152btn ghost" data-w155cclose>Back to the campaigns</button></div>' +
      '<h3 style="margin-top:18px">Recipients</h3>' + (rows ? (rows.length ? '<div class="w154sl">' + rows.slice(0, 300).map(function (r) {
        var c = contact(r.contact_id);
        return '<div class="w154sr"><span>' + (c ? '<a href="#crm/c/' + E(c.id) + '" data-w152open="' + E(c.id) + '">' + E(c.full_name || r.to_email) + '</a>' : E(r.to_email)) + '</span><span class="m">' + E(r.to_email) + '</span><span>' + mchip(MSTATUS, r.status) +
          (r.opened_at ? ' opened' : '') + (r.clicked_at ? ', clicked' : '') + '</span><span class="m">' + E(r.status === 'suppressed' ? r.permission_basis || '' : fmtDay(r.sent_at || r.created_at)) + '</span></div>';
      }).join('') + '</div>' : '<p class="m">Nobody yet.</p>') : '<p class="m">Loading\u2026</p>') + '</div>';
  }
  function paintCampaigns(root) {
    var need = [];
    if (!S.campaigns) need.push(load('campaigns')); if (!S.cstats) need.push(load('cstats')); if (!S.lists) need.push(load('lists')); if (!S.templates) need.push(load('templates')); if (!LC.sizes) need.push(sizes());
    if (!MAIL.st) need.push(mailFn('settings').then(function (r) { if (r && !r.error) MAIL.st = r; else MAIL.st = MAIL.st || { settings: {} }; }));
    if (need.length) { root.innerHTML = statsHtml(S.contacts || []) + tabsHtml() + busy('Loading the campaigns\u2026'); Promise.all(need).then(function () { if (S.ui.tab === 'campaigns') paint(); }); return; }
    var html = statsHtml(S.contacts || []) + tabsHtml();
    if (LC.cid && LC.cid !== 'new' && !LC.c) {
      var k = campById(LC.cid);
      if (k && k.status !== 'draft') {
        if (LC.rcpFor !== k.id) { LC.rcpFor = k.id; LC.rcp = null; Promise.resolve(db.from('crm_email_sends').select('id,contact_id,to_email,status,permission_basis,sent_at,opened_at,clicked_at,created_at').eq('campaign_id', k.id).order('id', { ascending: true }).limit(1000)).then(function (r) { LC.rcp = (r && r.data) || []; if (S.ui.tab === 'campaigns') paint(); }); }
        root.innerHTML = html + '<div class="w155grid">' + reportHtml(k) + '</div>'; return;
      }
      if (k) LC.c = fromCampaign(k);
    }
    if (LC.cid === 'new' && !LC.c) { LC.c = blankCampaign(LC.newList); LC.newList = null; }
    root.innerHTML = html + (LC.c ? '<div class="w155grid">' + editorHtml() + previewPane() + '</div>' : campListHtml());
  }
  function campRowFromEditor() {
    var c = LC.c, st = MAIL.st && MAIL.st.settings ? MAIL.st.settings : {};
    var fromName = c.from === 'me' ? myName() : c.from === 'custom' ? String(c.from_name || '').trim() : '';
    var fromEmail = c.from === 'me' ? myEmail() : c.from === 'custom' ? String(c.from_email || '').trim().toLowerCase() : '';
    return { name: String(c.name || '').trim() || String(c.subject || '').trim() || 'Untitled campaign', list_id: c.list_id ? Number(c.list_id) : null, template_key: c.template_key || 'newsletter', kind: c.kind,
      subject: String(c.subject || '').trim() || null, preheader: String(c.preheader || '').trim() || null,
      vars: { headline: String(c.headline || '').trim(), body_text: String(c.body || ''), body_html: bodyHtml(c.body), cta_label: String(c.cta_label || '').trim() || 'Visit welfareavenue.com', cta_url: String(c.cta_url || '').trim() || 'https://welfareavenue.com' },
      from_name: fromName || null, from_email: fromEmail || null, reply_to: null, updated_by: actor(), updated_at: new Date().toISOString(), _st: st };
  }
  function saveCampaign() {
    var c = LC.c; if (!c) return Promise.resolve(null);
    var row = campRowFromEditor(); delete row._st;
    if (c.from === 'custom' && !/^[^\s@]+@welfareavenue\.com$/i.test(row.from_email || '')) { LC.cerr = 'The sender\u2019s address must be an @welfareavenue.com address.'; paint(); return Promise.resolve(null); }
    var q = c.id ? db.from('crm_campaigns').update(row).eq('id', c.id).select().single() : db.from('crm_campaigns').insert(Object.assign({ status: 'draft', created_by: actor() }, row)).select().single();
    LC.cerr = '';
    return Promise.resolve(q).then(function (r) {
      if (r && r.error) { LC.cerr = 'Not saved: ' + (r.error.message || r.error); paint(); return null; }
      var saved = (r && r.data) || null; if (saved && saved.id) { c.id = saved.id; LC.cid = String(saved.id); try { history.replaceState(null, '', '#crm/campaigns/' + saved.id); } catch (e) { /* fine */ } }
      return load('campaigns', true).then(function () { return c.id; });
    });
  }
  function previewCamp() {
    var row = campRowFromEditor();
    LC.cprev = { busy: true }; LC.cbusy = 'Rendering the preview\u2026'; paint();
    mailFn('preview', { template_key: row.template_key, kind: row.kind, subject: row.subject || 'News from Welfare Avenue', preheader: row.preheader, vars: row.vars, from_name: row.from_name, from_email: row.from_email }).then(function (r) {
      LC.cbusy = ''; LC.cprev = r.error ? { err: 'The preview did not come back: ' + r.error } : r; paint();
    });
  }
  function testCamp() {
    LC.cbusy = 'Saving and sending a test to ' + myEmail() + '\u2026'; LC.cmsg = ''; paint();
    saveCampaign().then(function (id) {
      if (!id) { LC.cbusy = ''; paint(); return; }
      mailFn('campaign_test', { campaign_id: id, to: myEmail() }).then(function (r) { LC.cbusy = ''; if (r.error) LC.cerr = 'The test did not go: ' + r.error; else LC.cmsg = 'Test sent to ' + (r.to || myEmail()) + '.'; paint(); });
    });
  }
  function checkCamp(confirm) {
    if (!LC.c.list_id) { LC.cerr = 'Pick a list first.'; paint(); return; }
    if (!String(LC.c.subject || '').trim()) { LC.cerr = 'Write a subject first.'; paint(); return; }
    LC.cbusy = 'Checking who gets it\u2026'; LC.cmsg = ''; paint();
    saveCampaign().then(function (id) {
      if (!id) { LC.cbusy = ''; paint(); return; }
      mailFn('campaign_check', { campaign_id: id }).then(function (r) { LC.cbusy = ''; LC.check = r; LC.confirm = !!confirm && !r.error; if (r.error) LC.cerr = r.error; paint(); });
    });
  }
  function sendCamp() {
    var id = LC.c && LC.c.id; if (!id) return;
    LC.cbusy = 'Sending\u2026'; paint();
    mailFn('campaign_queue', { campaign_id: id }).then(function (r) {
      LC.cbusy = '';
      if (r.error) { LC.cerr = r.error; LC.confirm = false; paint(); return; }
      LC.cmsg = 'Sending to ' + plural(r.queued || r.eligible || 0, 'person', 'people') + (r.first && r.first.sent ? '; the first ' + r.first.sent + ' went out already' : '') + '.';
      LC.c = null; LC.check = null; LC.confirm = false; LC.cprev = null;
      Promise.all([load('campaigns', true), load('cstats', true)]).then(function () { paint(); });
    });
  }
  function stopCamp(id) {
    mailFn('campaign_cancel', { campaign_id: id }).then(function (r) {
      LC.cmsg = r.error ? 'Not stopped: ' + r.error : 'Stopped: ' + plural(r.cancelled || 0, 'waiting email', 'waiting emails') + ' cancelled.';
      LC.rcpFor = null; Promise.all([load('campaigns', true), load('cstats', true)]).then(function () { paint(); });
    });
  }
  function delCamp() {
    var id = LC.c && LC.c.id; if (!id) { LC.c = null; go('#crm/campaigns'); return; }
    Promise.resolve(db.from('crm_campaigns').delete().eq('id', id)).then(function (r) {
      LC.cmsg = r && r.error ? 'Not deleted: ' + (r.error.message || r.error) : 'Draft deleted.'; LC.c = null; LC.check = null; LC.cprev = null; load('campaigns', true).then(function () { go('#crm/campaigns'); paint(); });
    });
  }
  function openCampaigns(parts) {
    var id = parts[2] || null;
    if (id !== LC.cid) { LC.c = null; LC.check = null; LC.confirm = false; LC.cprev = null; LC.cerr = ''; if (id) LC.cmsg = ''; }
    LC.cid = id;
  }

  /* ---------- styles ---------- */
  var css155 = document.createElement('style'); css155.id = 'w155css';
  css155.textContent = ''
    + '.w155grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.15fr);gap:16px;align-items:start;}.w155grid>.wide{grid-column:1/-1;}'
    + '.w155rows{display:flex;flex-direction:column;}.w155row{display:grid;grid-template-columns:minmax(0,1fr) auto auto;gap:8px 12px;align-items:center;padding:12px 0;border-top:1px solid rgba(16,63,57,.08);}.w155row>.w155ra{grid-column:1/-1;justify-content:flex-start;}'
    + '.w155nm{display:flex;flex-direction:column;min-width:0;}.w155nm b{font-size:14.5px;}.w155nm .m{overflow:hidden;text-overflow:ellipsis;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;}.w155n{font-size:13.5px;white-space:nowrap;}'
    + '.w155ra{display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end;}'
    + '.w155lb{display:flex;flex-direction:column;gap:5px;font-size:12px;font-weight:700;letter-spacing:.6px;text-transform:uppercase;color:var(--wa-muted,' + MUTED + ');margin:0 0 12px;}.w155lb .w152in,.w155lb .w152sel,.w155lb textarea{font-size:14px;font-weight:400;letter-spacing:0;text-transform:none;color:var(--wa-ink,' + INK + ');width:100%;box-sizing:border-box;}.w155lb .m{text-transform:none;letter-spacing:0;font-weight:500;}.w155lb .w152sel{flex:none;max-width:none;}'
    + '.w155lb textarea{min-height:150px;font-family:inherit;line-height:1.5;}.w155two{display:grid;grid-template-columns:1fr 1fr;gap:10px;}'
    + '.w155g{border:1px solid rgba(16,63,57,.14);border-radius:14px;padding:12px;margin:0 0 6px;background:rgba(16,63,57,.025);}.w155gh{display:flex;justify-content:space-between;align-items:center;gap:8px;font-size:11.5px;font-weight:700;letter-spacing:.8px;text-transform:uppercase;color:' + GREEN + ';margin-bottom:8px;}'
    + '.w155c{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr) minmax(0,1fr) auto;gap:6px;align-items:center;}.w155c .w152sel,.w155c .w152in{width:100%;min-width:0;box-sizing:border-box;}'
    + '.w155and{font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--wa-muted,' + MUTED + ');margin:5px 0 5px 4px;}.w155g>.w152btn{margin-top:8px;}'
    + '.w155or{display:flex;align-items:center;gap:10px;margin:8px 0;font-size:11px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;color:' + PURPLE + ';}.w155or:before,.w155or:after{content:"";flex:1;height:1px;background:rgba(111,100,171,.35);}'
    + '.w155res{margin-top:14px;padding:12px 14px;border-radius:14px;background:rgba(16,63,57,.05);font-size:14px;}.w155res.busy{opacity:.6;}.w152lnk{all:unset;cursor:pointer;color:' + GREEN + ';font-weight:600;text-decoration:underline;text-decoration-color:rgba(16,63,57,.3);text-underline-offset:2px;}.w152lnk:hover{text-decoration-color:currentColor;}.w152lnk:focus-visible{outline:2px solid ' + GOLD + ';outline-offset:2px;border-radius:4px;}.w155mix{display:flex;gap:14px;flex-wrap:wrap;margin:6px 0;font-size:13px;}'
    + '.w155ct{border:1px solid rgba(16,63,57,.1);border-radius:12px;overflow:hidden;}.w155ch,.w155cr{display:grid;grid-template-columns:minmax(0,1.8fr) auto minmax(0,1.1fr) minmax(0,1.4fr) minmax(0,.7fr);gap:10px;padding:10px 12px;align-items:center;font-size:13px;}'
    + '.w155ch{font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--wa-muted,' + MUTED + ');background:rgba(16,63,57,.04);}.w155cr{border-top:1px solid rgba(16,63,57,.07);}'
    + '.w155cn{all:unset;cursor:pointer;display:flex;flex-direction:column;min-width:0;}.w155cn b{color:' + GREEN + ';font-size:14px;}.w155cn:focus-visible{outline:2px solid ' + GOLD + ';outline-offset:2px;border-radius:6px;}'
    + '.w155mode{margin:0 0 12px;padding:9px 12px;border-radius:12px;font-size:13px;display:flex;gap:6px;align-items:flex-start;}.w155mode.test{background:rgba(220,165,39,.15);}.w155mode.live{background:rgba(16,63,57,.08);}'
    + '.w155chk{margin:0 0 12px;padding:12px 14px;border-radius:14px;background:rgba(16,63,57,.05);font-size:14px;}.w155chk ul{margin:4px 0 0 18px;padding:0;font-size:13px;}'
    + '.w155cf{margin-top:10px;padding:10px 12px;border-radius:12px;background:rgba(220,165,39,.18);}.w155cf.test{background:rgba(140,140,140,.12);}'
    + '.w155bar{height:10px;border-radius:99px;background:rgba(16,63,57,.1);overflow:hidden;margin:12px 0 4px;}.w155bar i{display:block;height:100%;background:' + TEAL + ';border-radius:99px;}'
    + '@media (max-width:980px){.w155grid{grid-template-columns:1fr;}.w155ch,.w155cr{grid-template-columns:minmax(0,1.6fr) auto minmax(0,1.2fr);}.w155ch>span:nth-child(n+4),.w155cr>div:nth-child(n+4){display:none;}}'
    + '@media (max-width:700px){.w155c{grid-template-columns:1fr 1fr;}.w155c>button{justify-self:end;}.w155two{grid-template-columns:1fr;}}';
  document.head.appendChild(css155);

  /* ---------- wiring ---------- */
  document.addEventListener('click', function (e) {
    var t = e.target, el; if (!t || !t.closest || !t.closest('.w152root')) return;
    var ed = LC.edit;
    if ((el = t.closest('[data-w155new]'))) { e.preventDefault(); LC.edit = { id: null, name: '', description: '', groups: [{ all: [newCond('kind')] }] }; LC.prev = null; LC.msg = ''; LC.err = ''; paint(); return; }
    if ((el = t.closest('[data-w155fromf]'))) { e.preventDefault(); LC.edit = { id: null, name: '', description: 'From the Contacts filters', groups: groupsFromFilters() }; LC.prev = null; LC.msg = ''; LC.err = ''; paint(); return; }
    if ((el = t.closest('[data-w155edit]'))) { e.preventDefault(); var l = listById(el.getAttribute('data-w155edit')); if (!l) return; var g = (l.filter && Array.isArray(l.filter.groups)) ? l.filter.groups : [{ all: [] }]; LC.edit = { id: l.id, name: l.name, description: l.description || '', groups: JSON.parse(JSON.stringify(g)) }; LC.prev = null; LC.msg = ''; LC.err = ''; paint(); return; }
    if ((el = t.closest('[data-w155mail]'))) { e.preventDefault(); LC.newList = el.getAttribute('data-w155mail'); LC.c = null; go('#crm/campaigns/new'); return; }
    if ((el = t.closest('[data-w155and]')) && ed) { e.preventDefault(); ed.groups[Number(el.getAttribute('data-w155and'))].all.push(newCond('served')); previewSoon(); paint(); return; }
    if ((el = t.closest('[data-w155or]')) && ed) { e.preventDefault(); ed.groups.push({ all: [newCond('kind')] }); previewSoon(); paint(); return; }
    if ((el = t.closest('[data-w155gx]')) && ed) { e.preventDefault(); ed.groups.splice(Number(el.getAttribute('data-w155gx')), 1); if (!ed.groups.length) ed.groups.push({ all: [] }); previewSoon(); paint(); return; }
    if ((el = t.closest('[data-w155cx]')) && ed) { e.preventDefault(); var a = atOf(el.getAttribute('data-w155cx')); ed.groups[a.g].all.splice(a.c, 1); previewSoon(); paint(); return; }
    if ((el = t.closest('[data-w155save]')) && ed) { e.preventDefault(); saveList(el.getAttribute('data-w155save')); return; }
    if ((el = t.closest('[data-w155del]')) && ed) { e.preventDefault(); ed.del = true; paint(); return; }
    if ((el = t.closest('[data-w155delno]')) && ed) { e.preventDefault(); ed.del = false; paint(); return; }
    if ((el = t.closest('[data-w155delok]')) && ed) { e.preventDefault(); delList(); return; }
    if ((el = t.closest('[data-w155cancel]'))) { e.preventDefault(); LC.edit = null; LC.prev = null; LC.err = ''; paint(); return; }
    /* campaigns */
    if ((el = t.closest('[data-w155cnew]'))) { e.preventDefault(); LC.c = null; LC.cmsg = ''; go('#crm/campaigns/new'); return; }
    if ((el = t.closest('[data-w155copen]'))) { e.preventDefault(); LC.cmsg = ''; go('#crm/campaigns/' + el.getAttribute('data-w155copen')); return; }
    if ((el = t.closest('[data-w155cclose]'))) { e.preventDefault(); LC.c = null; LC.check = null; LC.cprev = null; LC.confirm = false; go('#crm/campaigns'); return; }
    if ((el = t.closest('[data-w155csave]')) && LC.c) { e.preventDefault(); LC.cbusy = 'Saving\u2026'; paint(); saveCampaign().then(function (id) { LC.cbusy = ''; if (id) LC.cmsg = 'Draft saved.'; paint(); }); return; }
    if ((el = t.closest('[data-w155cprev]')) && LC.c) { e.preventDefault(); previewCamp(); return; }
    if ((el = t.closest('[data-w155ctest]')) && LC.c) { e.preventDefault(); testCamp(); return; }
    if ((el = t.closest('[data-w155csend]')) && LC.c) { e.preventDefault(); checkCamp(true); return; }
    if ((el = t.closest('[data-w155cgo]')) && LC.c) { e.preventDefault(); el.disabled = true; sendCamp(); return; }
    if ((el = t.closest('[data-w155cno]'))) { e.preventDefault(); LC.confirm = false; paint(); return; }
    if ((el = t.closest('[data-w155cdel]'))) { e.preventDefault(); delCamp(); return; }
    if ((el = t.closest('[data-w155cstop]'))) { e.preventDefault(); stopCamp(LC.cid); return; }
    if ((el = t.closest('[data-w155cdup]'))) { e.preventDefault(); var src = campById(LC.cid); if (!src) return; var copy = fromCampaign(src); copy.id = null; copy.name = (src.name || 'Campaign') + ' (copy)'; LC.c = copy; LC.cid = 'new'; LC.check = null; LC.cprev = null; LC.cmsg = ''; try { history.replaceState(null, '', '#crm/campaigns/new'); } catch (x) { /* fine */ } paint(); return; }
  });
  function onField(e) {
    var t = e.target; if (!t || !t.closest || !t.closest('.w152root')) return;
    var ed = LC.edit, a;
    if (t.hasAttribute('data-w155f') && ed) { ed[t.getAttribute('data-w155f')] = t.value; return; }
    if (t.hasAttribute('data-w155cf') && ed) { a = atOf(t.getAttribute('data-w155cf')); ed.groups[a.g].all[a.c] = newCond(t.value); previewSoon(); paint(); return; }
    if (t.hasAttribute('data-w155co') && ed) { a = atOf(t.getAttribute('data-w155co')); var k = ed.groups[a.g].all[a.c]; k.op = t.value; if (needsValue(k) && (k.v === '' || k.v == null || !/^\d/.test(String(k.v)) && lf(k.f)[2] === 'num')) k.v = defVal(k.f, k.op); previewSoon(); paint(); return; }
    if (t.hasAttribute('data-w155cv') && ed) { a = atOf(t.getAttribute('data-w155cv')); ed.groups[a.g].all[a.c].v = t.value; previewSoon(); return; }
    if (t.hasAttribute('data-w155k') && LC.c) {
      var key = t.getAttribute('data-w155k'); LC.c[key] = t.value;
      if (key === 'kind' || key === 'from' || key === 'list_id') { LC.check = null; LC.confirm = false; if (e.type === 'change') paint(); }
    }
  }
  document.addEventListener('input', onField);
  document.addEventListener('change', function (e) { var t = e.target; if (t && t.tagName === 'SELECT') onField(e); });

  /* ======================= Forms (wave156, 28/09/26) =======================
     The CRM's own forms, so new volunteers and subscribers land in the Hub directly (Keela has no API or webhooks).
     Steel, 28/09/26: the forms live at hub.welfareavenue.com/f/<slug>; the volunteer applications and the newsletter
     sign-up come first; the Toronto form's birth date and health questions are replaced; built-in spam checks.
     A form is a list of questions, each saved to a place in the CRM (the contact's name, email, phone, city or language,
     their volunteer roles, a sign-up for each serving date they pick, a custom field, or the timeline note), plus the
     email permission question whose words are kept with a ticked box. Staff with the CRM build, preview, put live and
     close forms, and read every answer with what the Hub did with it. The public page and form-submit do the rest. */
  P.form = '<path d="M7 3.5h10a1.5 1.5 0 0 1 1.5 1.5v14A1.5 1.5 0 0 1 17 20.5H7A1.5 1.5 0 0 1 5.5 19V5A1.5 1.5 0 0 1 7 3.5z"/><path d="M9 8.5h6M9 12h6M9 15.5h3.5"/>';
  P.up = '<path d="m6 14 6-6 6 6"/>'; P.down = '<path d="m6 10 6 6 6-6"/>'; P.eye = '<path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z"/><circle cx="12" cy="12" r="2.8"/>';
  SOURCES.hub_form = ['Hub forms', 'People who filled in a form on hub.welfareavenue.com/f/.'];
  var FORM_HOST = 'https://hub.welfareavenue.com/f/';
  var CONSENT_DEFAULT = 'Yes, Welfare Avenue can email me news, volunteer call-outs and ways to help. I can unsubscribe at any time.';
  var FM = { fid: null, f: null, sub: '', msg: '', err: '', busy: '', confirm: '', subs: null, subsFor: null, showSpam: false, showTests: false, openSub: null, counts: null };
  LOADERS.forms = function () { return db.from('crm_forms').select('*').order('created_at', { ascending: true }); };
  LOADERS.fstats = function () { return db.from('crm_form_stats_v').select('*'); };
  LOADERS.cfields = function () { return db.from('crm_fields').select('*').order('sort', { ascending: true }).order('id', { ascending: true }); };
  LOADERS.fevents = function () { return db.from('volunteer_events').select('id,event_date,status,kind,location,title').eq('status', 'planned').gte('event_date', today()).order('event_date', { ascending: true }).limit(24); };
  var FKIND = { volunteer: ['Volunteer application', TEAL], newsletter: ['Newsletter sign-up', PURPLE], general: ['General', MUTED] };
  /* wave168: every form's page opens with a photo from the Photo library behind the logo and the title (crm_forms.cover_photo_id;
     none uses the kind's default, as form-submit does) */
  var COVER_KIND = { volunteer: 9, newsletter: 3, general: 26 };
  var PSTORE = 'https://zwnmulmnvopclzcvytce.supabase.co/storage/v1/object/public/content-images/';
  var LOCKUP_IMG = PSTORE + 'brand/logo-lockup-cream-600.png';
  var EYEBROW = { en: { volunteer: 'Volunteer with us', newsletter: 'Stay in touch', general: 'Welfare Avenue' }, fr: { volunteer: 'B\u00e9n\u00e9volat', newsletter: 'Restez au courant', general: 'Welfare Avenue' } };
  function photoById(id) { return (S.wphotos || []).filter(function (p) { return String(p.id) === String(id); })[0] || null; }
  function coverOf(f) { return (f && f.cover_photo_id ? photoById(f.cover_photo_id) : null) || photoById(COVER_KIND[f && f.kind] || 26); }
  function loadPhotos168() {
    if (S.wphotos || S.wphotosBusy) return;
    S.wphotosBusy = true;
    Promise.resolve(db.from('wa_photos').select('id,key,title,alt_text,path_web,path_thumb,focal_x,focal_y,orientation,usage,scene,is_pick,taken_on').eq('usage', 'ready')).then(function (r) {
      var rows = ((r && r.data) || []).filter(function (p) { return p.path_web && p.orientation !== 'portrait'; });
      rows.sort(function (a, b) { return (b.is_pick ? 1 : 0) - (a.is_pick ? 1 : 0) || String(b.taken_on || '').localeCompare(String(a.taken_on || '')); });
      S.wphotos = rows; S.wphotosBusy = false; if (FM.f) paint();
    }).catch(function () { S.wphotos = []; S.wphotosBusy = false; });
  }
  function coverPickHtml(f) {
    loadPhotos168();
    var cur = f.cover_photo_id ? photoById(f.cover_photo_id) : null, shown = coverOf(f);
    var h = '<h4 class="w156h4">Cover photo</h4><div class="w156box w168cov">';
    if (shown) h += '<div class="w168now"><span class="im" style="background-image:url(\'' + E(PSTORE + (shown.path_thumb || shown.path_web)) + '\')"></span><div><b>' + E(shown.title || '') + '</b><span class="m">' + (cur ? 'Chosen for this form' : 'The default for ' + (f.kind === 'volunteer' ? 'a volunteer' : f.kind === 'newsletter' ? 'a newsletter' : 'a general') + ' form') + '</span>'
      + (cur ? '<button class="w152btn ghost" data-w168cov="">Use the default</button>' : '') + '</div></div>';
    if (!S.wphotos) return h + '<p class="m">Loading the Photo library\u2026</p></div>';
    return h + '<div class="w168grid" role="list">' + S.wphotos.map(function (p) {
      return '<button type="button" role="listitem" class="w168th' + (shown && p.id === shown.id ? ' on' : '') + '" data-w168cov="' + E(p.id) + '" title="' + E(p.title || '') + '" aria-label="' + E('Use ' + (p.title || 'this photo')) + '" style="background-image:url(\'' + E(PSTORE + (p.path_thumb || p.path_web)) + '\')"></button>';
    }).join('') + '</div><p class="m">From the Photo library, the photos ready to use. It sits behind the logo and the title at the top of the page.</p></div>';
  }
  var FSTAT = { draft: ['Draft', MUTED], published: ['Live', GREEN], closed: ['Closed', FLAG] };
  var SUBST = { processed: ['In the CRM', GREEN], received: ['Received', '#B9851B'], error: ['Needs a look', FLAG], spam: ['Spam', MUTED], test: ['Test', PURPLE] };
  var QTYPES = [['text', 'Short answer'], ['long_text', 'Long answer'], ['email', 'Email'], ['phone', 'Phone'], ['choice', 'One choice'], ['multi', 'Several choices'], ['yes_no', 'Yes or no'], ['date', 'Date'], ['number', 'Number'], ['serving_dates', 'Serving dates (Volunteer Manager)']];
  var FTYPE_OF = { text: 'text', long_text: 'long_text', email: 'text', phone: 'text', choice: 'choice', multi: 'multi', yes_no: 'yes_no', date: 'date', number: 'number' };
  var FTYPE_NAME = { text: 'Short answer', long_text: 'Long answer', number: 'Number', date: 'Date', choice: 'One choice', multi: 'Several choices', yes_no: 'Yes or no' };
  var CONTACT_TO = { 'contact.first_name': 'First name', 'contact.last_name': 'Last name', 'contact.email': 'Email', 'contact.phone': 'Phone', 'contact.city': 'City', 'contact.province': 'Province', 'contact.postal_code': 'Postal code', 'contact.address': 'Address', 'contact.language': 'Language (en or fr)' };
  var MONL = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
  var DAYL = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
  function longDay(d) { var p = String(d || '').split('-').map(Number); if (p.length < 3) return String(d || ''); var dt = new Date(Date.UTC(p[0], p[1] - 1, p[2], 12)); return DAYL[dt.getUTCDay()] + ' ' + p[2] + ' ' + MONL[p[1] - 1] + ' ' + p[0]; }
  function formById(id) { return (S.forms || []).filter(function (f) { return String(f.id) === String(id); })[0] || null; }
  function fstat(id) { return (S.fstats || []).filter(function (x) { return String(x.form_id) === String(id); })[0] || {}; }
  function fieldByKey(k) { return (S.cfields || []).filter(function (f) { return f.key === k; })[0] || null; }
  function slugify(s, sep) { var x = fold(s).replace(/[^a-z0-9]+/g, sep || '-').replace(new RegExp('^\\' + (sep || '-') + '+|\\' + (sep || '-') + '+$', 'g'), ''); return x.slice(0, 40) || 'q'; }
  function optsOf(q) { return (Array.isArray(q.options) ? q.options : []).map(function (o) { return typeof o === 'string' ? { v: o, l: o } : { v: String(o.v != null ? o.v : o.value || ''), l: String(o.l != null ? o.l : o.label || o.v || '') }; }).filter(function (o) { return o.v !== ''; }); }
  function optsText(q) { return optsOf(q).map(function (o) { return o.v === o.l ? o.l : o.v + ' | ' + o.l; }).join('\n'); }
  function parseOpts(text) {
    return String(text || '').split('\n').map(function (l) { return l.trim(); }).filter(Boolean).map(function (l) {
      var i = l.indexOf('|'); if (i < 0) return l;
      var v = l.slice(0, i).trim(), lab = l.slice(i + 1).trim(); return v && lab && v !== lab ? { v: v, l: lab } : (lab || v);
    });
  }
  function valueText(v, type) {
    if (v == null) return '';
    if (type === 'yes_no' || typeof v === 'boolean') return v === true || v === 'yes' ? 'Yes' : 'No';
    if (Array.isArray(v)) return v.join(', ');
    return String(v);
  }
  function toLabel(to) {
    if (!to) return 'Kept with the answer only';
    if (CONTACT_TO[to]) return 'Their ' + CONTACT_TO[to].toLowerCase().replace(' (en or fr)', '');
    if (to === 'volunteer.roles') return 'Their volunteer roles';
    if (to === 'volunteer.dates') return 'A sign-up for each date (to confirm)';
    if (to === 'note') return 'The note on their timeline';
    if (/^field:/.test(to)) { var f = fieldByKey(to.slice(6)); return 'Field: ' + (f ? f.label : to.slice(6)); }
    return to;
  }
  /* where a question of this type can be saved */
  function toChoices(q, kind) {
    var t = q.type, out = [['', 'Kept with the answer only']];
    var add = function (k) { out.push([k, toLabel(k)]); };
    if (t === 'email') add('contact.email');
    if (t === 'phone') add('contact.phone');
    if (t === 'text') ['contact.first_name', 'contact.last_name', 'contact.city', 'contact.province', 'contact.postal_code', 'contact.address', 'note'].forEach(add);
    if (t === 'long_text') ['note', 'contact.address'].forEach(add);
    if (t === 'choice') add('contact.language');
    if (t === 'multi' && kind === 'volunteer') add('volunteer.roles');
    if (t === 'serving_dates') add('volunteer.dates');
    var ft = FTYPE_OF[t];
    if (ft) (S.cfields || []).filter(function (f) { return !f.archived_at && f.type === ft; }).forEach(function (f) { add('field:' + f.key); });
    if (ft) out.push(['__new', 'A new field on the contact, named after the question']);
    if (q.to && !out.some(function (o) { return o[0] === q.to; })) out.push([q.to, toLabel(q.to)]);
    return out;
  }

  /* ---------- the list ---------- */
  function formRow(f) {
    var st = fstat(f.id), live = f.status === 'published', addr = 'hub.welfareavenue.com/f/' + f.slug;
    return '<div class="w156row" role="listitem"><div class="w156nm"><button class="w155cn" data-w156open="' + E(f.id) + '"><b>' + E(f.title) + '</b></button>' +
      '<span class="m">' + E((FKIND[f.kind] || FKIND.general)[0]) + '</span><span class="m w156lk">' + (live || f.status === 'closed' ? '<a href="' + E(FORM_HOST + f.slug) + '" target="_blank" rel="noopener">' + E(addr) + '</a>' : E(addr)) + '</span></div>' +
      '<div>' + lchip(FSTAT, f.status) + '</div>' +
      '<div class="w156meta">' + plural(Number(st.submissions) || 0, 'answer', 'answers') + (Number(st.last_7_days) ? '<span class="m"> \u00b7 ' + Number(st.last_7_days) + ' this week</span>' : '') + (Number(st.errors) ? '<span class="w156warn"> \u00b7 ' + plural(Number(st.errors), 'needs a look', 'need a look') + '</span>' : '') + '</div>' +
      '<div class="w155ra"><button class="w152btn sm ghost" data-w156open="' + E(f.id) + '">' + I('edit') + ' Open</button><button class="w152btn sm ghost" data-w156answers="' + E(f.id) + '">' + I('list') + ' Answers</button>' +
      (live ? '<button class="w152btn sm ghost" data-w152copy="' + E(FORM_HOST + f.slug) + '">' + I('copy') + ' Copy the link</button>' : '') + '</div></div>';
  }
  function fieldsCard() {
    var fs = S.cfields || [], used = {};
    (S.forms || []).forEach(function (f) { (f.questions || []).forEach(function (q) { if (/^field:/.test(q.to || '')) (used[q.to.slice(6)] = used[q.to.slice(6)] || []).push(f.title); }); });
    return '<div class="w154card"><h3>' + I('tag') + ' Custom fields <span class="w155sub">' + plural(fs.filter(function (f) { return !f.archived_at; }).length, 'field', 'fields') + '</span></h3>' +
      '<p class="m">What a contact has that the CRM has no column for. A form question saves into one; so did Keela. They show on a contact\u2019s page under More about them.</p>' +
      (fs.length ? '<div class="w156fl">' + fs.map(function (f) {
        var n = FM.counts ? (FM.counts[String(f.id)] || 0) : null;
        return '<div class="w156fr' + (f.archived_at ? ' arch' : '') + '"><span><b>' + E(f.label) + '</b><span class="m"> \u00b7 ' + E(FTYPE_NAME[f.type] || f.type) + (used[f.key] ? ' \u00b7 in ' + E(listJoin(uniq(used[f.key]))) : '') + '</span></span>' +
          '<span class="m">' + (n == null ? '' : plural(n, 'contact', 'contacts')) + '</span><button class="w152mini" data-w156arch="' + E(f.id) + '">' + (f.archived_at ? 'Bring back' : 'Archive') + '</button></div>';
      }).join('') + '</div>' : '<p class="m">No custom field yet.</p>') + '</div>';
  }
  function formsListHtml() {
    var fs = S.forms || [];
    return '<div class="w155grid"><div class="w154card"><h3>' + I('form') + ' Forms <span class="w155sub">' + plural(fs.length, 'form', 'forms') + '</span></h3>' +
      '<p class="m">A form at hub.welfareavenue.com/f/ writes straight into the CRM: the person, their volunteer record and the dates they pick, their answers, and their email permission with the words they agreed to. Drafts are only seen here.</p>' +
      (FM.msg ? '<div class="w154msg">' + E(FM.msg) + '</div>' : '') + (FM.err ? '<div class="w152err">' + E(FM.err) + '</div>' : '') +
      '<div class="w154acts"><button class="w152btn" data-w156new="1">' + I('plus') + ' New form</button></div>' +
      (fs.length ? '<div class="w155rows" role="list">' + fs.map(formRow).join('') + '</div>' : '<p class="m">No form yet.</p>') + '</div>' + fieldsCard() + '</div>';
  }

  /* ---------- the editor ---------- */
  function editCopy(f) {
    var c = JSON.parse(JSON.stringify(f));
    c.questions = (c.questions || []).map(function (q) { q._opts = optsText(q); return q; });
    c.consent = c.consent || {}; c.settings = c.settings || {};
    c._tags = (c.settings.tags || []).join(', ');
    return c;
  }
  function qHtml(q, i, n, kind) {
    var hasOpts = q.type === 'choice' || q.type === 'multi';
    var types = QTYPES.map(function (t) { return '<option value="' + t[0] + '"' + (t[0] === q.type ? ' selected' : '') + '>' + E(t[1]) + '</option>'; }).join('');
    var tos = toChoices(q, kind).map(function (o) { return '<option value="' + E(o[0]) + '"' + (o[0] === (q.to || '') ? ' selected' : '') + '>' + E(o[1]) + '</option>'; }).join('');
    return '<div class="w156q" data-w156qi="' + i + '"><div class="w156qh"><b>' + (i + 1) + '</b>' +
      '<select class="w152sel" data-w156qk="type" aria-label="Kind of answer">' + types + '</select>' +
      '<label class="w156ck"><input type="checkbox" data-w156qk="required"' + (q.required ? ' checked' : '') + '> Required</label><span class="w156sp"></span>' +
      '<button class="w152mini" data-w156qmv="-1" aria-label="Move up"' + (i ? '' : ' disabled') + '>' + I('up') + '</button><button class="w152mini" data-w156qmv="1" aria-label="Move down"' + (i < n - 1 ? '' : ' disabled') + '>' + I('down') + '</button>' +
      '<button class="w152mini" data-w156qdel="1" aria-label="Remove the question">' + I('trash') + '</button></div>' +
      '<input class="w152in" data-w156qk="label" value="' + E(q.label) + '" placeholder="The question, as people will read it" aria-label="The question">' +
      '<input class="w152in" data-w156qk="help" value="' + E(q.help || '') + '" placeholder="A line of help under it (optional)" aria-label="Help">' +
      (hasOpts ? '<textarea class="w152in" data-w156qk="_opts" rows="4" placeholder="One choice per line. To save a code instead of the words: code | words" aria-label="Choices">' + E(q._opts || '') + '</textarea>' : '') +
      (q.type === 'serving_dates' ? '<p class="m">People see the planned servings in the Volunteer Manager from today on; each date they tick becomes a sign-up on that event\u2019s roster, to be confirmed by the team.</p>' : '') +
      '<label class="w155lb">Saves to<select class="w152sel" data-w156qk="to">' + tos + '</select></label></div>';
  }
  function editorHtml156() {
    var f = FM.f, live = f.status === 'published', closed = f.status === 'closed', st = fstat(f.id);
    var kinds = Object.keys(FKIND).map(function (k) { return '<option value="' + k + '"' + (k === f.kind ? ' selected' : '') + '>' + E(FKIND[k][0]) + '</option>'; }).join('');
    var inp = function (k, label, ph, area, extra) { return '<label class="w155lb">' + E(label) + (area ? '<textarea class="w152in" data-w156k="' + k + '" rows="3" placeholder="' + E(ph || '') + '">' + E(f[k] || '') + '</textarea>' : '<input class="w152in" data-w156k="' + k + '" value="' + E(f[k] || '') + '" placeholder="' + E(ph || '') + '"' + (extra || '') + '>') + '</label>'; };
    var vol = f.kind === 'volunteer';
    return '<div class="w154card"><h3>' + I('form') + ' ' + E(f.id ? 'Edit the form' : 'New form') + ' ' + lchip(FSTAT, f.status) + '</h3>' +
      (FM.err ? '<div class="w152err">' + E(FM.err) + '</div>' : '') + (FM.msg ? '<div class="w154msg">' + E(FM.msg) + '</div>' : '') + (FM.busy ? '<div class="m">' + E(FM.busy) + '</div>' : '') +
      inp('title', 'Title', 'Volunteer with Welfare Avenue') +
      '<label class="w155lb">Web address<span class="w156url">hub.welfareavenue.com/f/<input class="w152in" data-w156k="slug" value="' + E(f.slug) + '"' + (live ? ' disabled title="Live forms keep their address; close the form to change it"' : '') + ' aria-label="The last part of the web address"></span></label>' +
      '<div class="w155two"><label class="w155lb">Kind<select class="w152sel" data-w156k="kind">' + kinds + '</select></label>' +
      '<label class="w155lb">Language<select class="w152sel" data-w156k="lang"><option value="en"' + (f.lang === 'en' ? ' selected' : '') + '>English</option><option value="fr"' + (f.lang === 'fr' ? ' selected' : '') + '>French</option></select></label></div>' +
      inp('intro', 'What it is for (under the title)', 'A sentence or two', true) + coverPickHtml(f) +
      (vol ? '<div class="w156box"><label class="w156ck"><input type="checkbox" data-w156set="volunteer_record"' + (f.settings.volunteer_record ? ' checked' : '') + '> Add them to the Volunteer Manager (a volunteer record to review, and sign-ups for the dates they pick)</label>' +
        '<div class="w155two"><label class="w155lb">City written on new contacts<input class="w152in" data-w156set="city" value="' + E(f.settings.city || '') + '" placeholder="Montreal"></label>' +
        '<label class="w155lb">Tags to add<input class="w152in" data-w156k="_tags" value="' + E(f._tags || '') + '" placeholder="toronto"></label></div></div>' :
        '<label class="w155lb">Tags to add<input class="w152in" data-w156k="_tags" value="' + E(f._tags || '') + '" placeholder="newsletter"></label>') +
      '<h4 class="w156h4">Questions</h4>' + f.questions.map(function (q, i) { return qHtml(q, i, f.questions.length, f.kind); }).join('') +
      '<div class="w154acts"><button class="w152btn ghost" data-w156qadd="text">' + I('plus') + ' Add a question</button></div>' +
      '<h4 class="w156h4">Email permission</h4><div class="w156box"><label class="w156ck"><input type="checkbox" data-w156c="ask"' + (f.consent.ask ? ' checked' : '') + '> Ask for permission to email them (a box they tick themselves)</label>' +
      (f.consent.ask ? '<label class="w156ck"><input type="checkbox" data-w156c="required"' + (f.consent.required ? ' checked' : '') + '> They must tick it to send the form (a newsletter sign-up)</label>' +
        '<label class="w155lb">The words next to the box<textarea class="w152in" data-w156c="label" rows="2">' + E(f.consent.label || '') + '</textarea></label><p class="m">A ticked box records express consent with these words and the date (CASL). The page shows Welfare Avenue\u2019s address and email beside it.</p>' : '') + '</div>' +
      inp('thank_you', 'Thank-you message (after they send it)', 'Thank you. We have your answers.', true) +
      '<div class="w154acts"><button class="w152btn" data-w156save="1">' + I('check') + ' Save</button>' +
      (f.id && !live ? '<button class="w152btn ghost" data-w156pub="1">' + I('send') + ' Put it live\u2026</button>' : '') +
      (live ? '<button class="w152btn ghost" data-w152copy="' + E(FORM_HOST + f.slug) + '">' + I('copy') + ' Copy the link</button><a class="w152btn ghost" href="' + E(FORM_HOST + f.slug) + '" target="_blank" rel="noopener">' + I('ext') + ' Open the live page</a><button class="w152btn ghost" data-w156close="1">Stop taking answers\u2026</button>' : '') +
      (f.id ? '<button class="w152btn ghost" data-w156answers="' + E(f.id) + '">' + I('list') + ' Answers (' + (Number(st.submissions) || 0) + ')</button>' : '') +
      '<button class="w152btn ghost" data-w156back="1">Back to the forms</button>' +
      (f.id && f.status === 'draft' && !Number(st.submissions) ? '<button class="w152btn ghost" data-w156del="1">' + I('trash') + ' Delete the draft</button>' : '') + '</div>' + confirmHtml(f) + '</div>';
  }
  function confirmHtml(f) {
    if (FM.confirm === 'publish') return '<div class="w155cf"><b>Put \u201c' + E(f.title) + '\u201d live?</b> Anyone with the link can fill it in at ' + E('hub.welfareavenue.com/f/' + f.slug) + ', and each answer goes straight into the CRM.' +
      '<div class="w154acts"><button class="w152btn" data-w156pubok="1">' + I('send') + ' Put it live</button><button class="w152btn ghost" data-w156no="1">Not yet</button></div></div>';
    if (FM.confirm === 'close') return '<div class="w155cf test"><b>Stop taking answers?</b> The page will say the form is closed. You can put it live again later.<div class="w154acts"><button class="w152btn" data-w156closeok="1">Close the form</button><button class="w152btn ghost" data-w156no="1">Keep it open</button></div></div>';
    if (FM.confirm === 'delete') return '<div class="w155cf test"><b>Delete this draft?</b> It has no answers.<div class="w154acts"><button class="w152btn" data-w156delok="1">' + I('trash') + ' Delete it</button><button class="w152btn ghost" data-w156no="1">Keep it</button></div></div>';
    return '';
  }
  /* ---------- the preview: the questions as people will see them ---------- */
  function bandHtml168(f) {
    var c = coverOf(f), ey = (EYEBROW[f.lang] || EYEBROW.en)[f.kind] || 'Welfare Avenue';
    var bg = c ? ' style="background-image:url(\'' + E(PSTORE + c.path_web) + '\');background-position:' + Math.round(100 * (c.focal_x == null ? 0.5 : c.focal_x)) + '% ' + Math.round(100 * (c.focal_y == null ? 0.5 : c.focal_y)) + '%"' : '';
    return '<div class="w156sheet"><div class="w156band"' + bg + '><div class="w168top"><img src="' + LOCKUP_IMG + '" alt="Welfare Avenue"><img class="w168star" src="' + PSTORE + 'brand/doodle-star-gold.png" alt=""></div>'
      + '<div class="w168ey">' + E(ey) + '</div><div class="w156t">' + E(f.title || 'Untitled form') + '</div></div>';
  }
  function previewHtml156() {
    var f = FM.f, evs = S.fevents || [];
    var one = function (q) {
      var head = '<div class="w156pl">' + E(q.label || 'Question') + (q.required ? '<span class="w156req">*</span>' : ' <span class="m">(optional)</span>') + '</div>' + (q.help ? '<div class="m">' + E(q.help) + '</div>' : '');
      if (q.type === 'long_text') return head + '<textarea class="w152in" disabled rows="2"></textarea>';
      if (q.type === 'yes_no') return head + '<div class="w156pc"><span class="w156pr">Yes</span><span class="w156pr">No</span></div>';
      if (q.type === 'choice' || q.type === 'multi') { var os = optsOf({ options: parseOpts(q._opts) }); return head + '<div class="w156pc">' + (os.length ? os.map(function (o) { return '<span class="' + (q.type === 'multi' ? 'w156pb' : 'w156pr') + '">' + E(o.l) + '</span>'; }).join('') : '<span class="m">No choices yet</span>') + '</div>'; }
      if (q.type === 'serving_dates') {
        var loc = (f.settings && f.settings.serving_location) || 'Montreal';
        var open = evs.filter(function (e) { return lower(e.kind) === 'service' && String(e.location || '') === loc; }).slice(0, 12);
        return head + '<div class="w156pc">' + (open.length ? open.map(function (e) { return '<span class="w156pb">' + E(longDay(e.event_date)) + '</span>'; }).join('') : '<span class="m">No planned serving from today on: the page says new dates are coming.</span>') + '</div>';
      }
      return head + '<input class="w152in" disabled>';
    };
    return '<div class="w154card w156pv"><h3>' + I('eye') + ' Preview</h3>' + (f.status !== 'published' ? '<p class="m">Not live yet: only the team sees this form.</p>' : '<p class="m">Live at <a href="' + E(FORM_HOST + f.slug) + '" target="_blank" rel="noopener">hub.welfareavenue.com/f/' + E(f.slug) + '</a>.</p>') +
      bandHtml168(f) + '<div class="w156page"><i class="w156rule"></i>' + (f.intro ? '<p>' + E(f.intro) + '</p>' : '') +
      f.questions.map(function (q) { return '<div class="w156pq">' + one(q) + '</div>'; }).join('') +
      (f.consent && f.consent.ask ? '<div class="w156pq w156pcons"><span class="w156pb">' + E(f.consent.label || CONSENT_DEFAULT) + (f.consent.required ? '<span class="w156req">*</span>' : '') + '</span></div>' : '') +
      '<span class="w156send">' + (f.lang === 'fr' ? 'Envoyer' : 'Send') + '</span></div></div></div>';
  }

  /* ---------- the answers ---------- */
  function subsHtml(f) {
    var all = FM.subsFor === String(f.id) ? FM.subs : null;
    if (!all) return '<div class="w154card wide">' + busy('Loading the answers\u2026') + '</div>';
    var spam = all.filter(function (s) { return s.status === 'spam'; }).length, tests = all.filter(function (s) { return s.is_test; }).length;
    var rows = all.filter(function (s) { return (FM.showSpam || s.status !== 'spam') && (FM.showTests || !s.is_test); });
    var nameOf = function (s) {
      var c = s.contact_id ? contact(s.contact_id) : null; if (c) return E(c.full_name);
      var d = s.display || [], em = d.filter(function (x) { return /mail/i.test(x.label || ''); })[0];
      return E((em && em.value) || (s.status === 'spam' ? 'A bot, most likely' : '(no name)'));
    };
    var did = function (s) {
      var r = s.result || {}, bits = [];
      if (r.created) bits.push('a new contact'); else if (r.contact_id) bits.push('added to an existing contact');
      if (r.volunteer_created) bits.push('a new volunteer record to review'); else if (r.volunteer_id) bits.push('their volunteer record updated');
      var ro = (r.roster || []).filter(function (x) { return !x.already; }); if (ro.length) bits.push('signed up for ' + ro.map(function (x) { return fmtDay(x.date); }).join(', '));
      if (r.consent) bits.push('email permission recorded');
      return bits.length ? 'The Hub: ' + bits.join('; ') + '.' : '';
    };
    return '<div class="w154card wide"><h3>' + I('list') + ' Answers to \u201c' + E(f.title) + '\u201d <span class="w155sub">' + plural(rows.length, 'answer', 'answers') + '</span></h3>' +
      '<div class="w154acts">' + (spam ? '<button class="w152btn sm ghost" data-w156spam="1">' + (FM.showSpam ? 'Hide' : 'Show') + ' spam (' + spam + ')</button>' : '') +
      (tests ? '<button class="w152btn sm ghost" data-w156tests="1">' + (FM.showTests ? 'Hide' : 'Show') + ' tests (' + tests + ')</button>' : '') +
      '<button class="w152btn sm ghost" data-w156open="' + E(f.id) + '">' + I('edit') + ' Edit the form</button><button class="w152btn sm ghost" data-w156back="1">Back to the forms</button></div>' +
      (rows.length ? '<div class="w156subs">' + rows.map(function (s) {
        var open = FM.openSub === String(s.id);
        return '<div class="w156sub"><button class="w156sh" data-w156sub="' + E(s.id) + '" aria-expanded="' + open + '"><span>' + E(fmtDay(s.created_at)) + '</span><span class="w156who">' + nameOf(s) + '</span><span>' + lchip(SUBST, s.is_test ? 'test' : s.status) + '</span></button>' +
          (open ? '<div class="w156sd">' + (s.display || []).map(function (x) { return '<div class="w154kv"><span>' + E(x.label) + '</span><span>' + E(x.value) + '</span></div>'; }).join('') +
            (s.error ? '<div class="w152err">' + E(s.status === 'spam' ? 'Held as spam: ' + s.error : 'What went wrong: ' + s.error) + '</div>' : '') + (did(s) ? '<p class="m">' + E(did(s)) + '</p>' : '') +
            (s.contact_id && contact(s.contact_id) ? '<button class="w152btn sm ghost" data-w152open="' + E(s.contact_id) + '">' + I('people') + ' Open their page</button>' : '') + '</div>' : '') + '</div>';
      }).join('') + '</div>' : '<p class="m">No answer yet.</p>') + '</div>';
  }
  function loadSubs(id) {
    FM.subsFor = String(id); FM.subs = null;
    return Promise.resolve(db.from('crm_form_submissions').select('id,status,display,consent,result,error,created_at,contact_id,is_test').eq('form_id', Number(id)).order('created_at', { ascending: false }).limit(500))
      .then(function (r) { if (FM.subsFor === String(id)) { FM.subs = (r && r.data) || []; if (S.ui.tab === 'forms') paint(); } });
  }
  function loadFieldCounts() {
    return pageAll(function (a, b) { return db.from('crm_contact_fields').select('contact_id,field_id').order('field_id', { ascending: true }).order('contact_id', { ascending: true }).range(a, b); }, function (r) { return r.contact_id + ':' + r.field_id; })
      .then(function (res) { var m = {}; ((res && res.data) || []).forEach(function (r) { m[String(r.field_id)] = (m[String(r.field_id)] || 0) + 1; }); FM.counts = m; if (S.ui.tab === 'forms') paint(); });
  }

  function paintForms(root) {
    var need = [];
    if (!S.forms) need.push(load('forms')); if (!S.fstats) need.push(load('fstats')); if (!S.cfields) need.push(load('cfields')); if (!S.fevents) need.push(load('fevents'));
    if (need.length) { root.innerHTML = statsHtml(S.contacts || []) + tabsHtml() + busy('Loading the forms\u2026'); Promise.all(need).then(function () { if (S.ui.tab === 'forms') paint(); }); return; }
    if (!FM.counts) { FM.counts = {}; loadFieldCounts(); }
    var html = statsHtml(S.contacts || []) + tabsHtml();
    if (FM.fid && !FM.f) { var k = formById(FM.fid); if (k) FM.f = editCopy(k); }
    if (FM.fid && FM.sub === 'answers') {
      var fa = formById(FM.fid);
      if (!fa) { root.innerHTML = html + '<div class="w152empty">That form is not in the CRM.</div>'; return; }
      if (FM.subsFor !== String(fa.id)) loadSubs(fa.id);
      root.innerHTML = html + '<div class="w155grid">' + subsHtml(fa) + '</div>'; return;
    }
    if (FM.fid && !FM.f) { root.innerHTML = html + '<div class="w152empty">That form is not in the CRM. <button class="w152mini" data-w156back="1">Back to the forms</button></div>'; return; }
    root.innerHTML = html + (FM.f ? '<div class="w155grid">' + editorHtml156() + previewHtml156() + '</div>' : formsListHtml());
  }
  function openForms(parts) {
    var id = parts[2] || null, sub = parts[3] || '';
    if (id !== FM.fid) { FM.f = null; FM.confirm = ''; FM.err = ''; FM.openSub = null; if (id) FM.msg = ''; }
    FM.fid = id; FM.sub = sub;
  }

  /* ---------- saving ---------- */
  function cleanQuestions(qs) {
    var seen = {};
    return qs.map(function (q) {
      var id = String(q.id || '').trim() || slugify(q.label, '_');
      id = id.replace(/[^a-z0-9_]/gi, '_').toLowerCase().slice(0, 40) || 'q';
      var base = id, n = 2; while (seen[id]) { id = base + '_' + n; n++; } seen[id] = 1;
      var out = { id: id, type: q.type, label: String(q.label || '').trim(), required: !!q.required, to: q.to || '' };
      if (String(q.help || '').trim()) out.help = String(q.help).trim();
      if (q.type === 'choice' || q.type === 'multi') out.options = parseOpts(q._opts);
      if (!out.to) delete out.to;
      return out;
    });
  }
  function newFields(f) {
    /* a question saved to "a new field": create it (key from the question), then point the question at it */
    var jobs = [], keys = {}; (S.cfields || []).forEach(function (x) { keys[x.key] = 1; });
    f.questions.forEach(function (q) {
      if (q.to !== '__new') return;
      var ft = FTYPE_OF[q.type]; if (!ft) { q.to = ''; return; }
      var key = slugify(q.label, '_').replace(/^[^a-z]+/, '').slice(0, 36) || 'field'; if (!/^[a-z]/.test(key)) key = 'f_' + key;
      var base = key, n = 2; while (keys[key]) { key = base + '_' + n; n++; } keys[key] = 1;
      var row = { key: key, label: String(q.label || key).trim().slice(0, 120), type: ft, options: (ft === 'choice' || ft === 'multi') ? parseOpts(q._opts) : [], created_by: actor(), updated_by: actor(), help: 'Made from the form \u201c' + (f.title || '') + '\u201d.' };
      jobs.push(Promise.resolve(db.from('crm_fields').insert(row).select().single()).then(function (r) {
        if (r && r.error) throw new Error('The field \u201c' + row.label + '\u201d could not be made: ' + (r.error.message || r.error));
        q.to = 'field:' + key;
      }));
    });
    return Promise.all(jobs);
  }
  function saveForm() {
    var f = FM.f; if (!f) return Promise.resolve(null);
    FM.err = '';
    if (!String(f.title || '').trim()) { FM.err = 'Give the form a title.'; paint(); return Promise.resolve(null); }
    f.slug = String(f.slug || '').trim().toLowerCase();
    if (!/^[a-z0-9][a-z0-9-]{1,60}$/.test(f.slug)) { FM.err = 'The web address takes lower-case letters, numbers and dashes (2 to 61 characters).'; paint(); return Promise.resolve(null); }
    if (f.questions.some(function (q) { return !String(q.label || '').trim(); })) { FM.err = 'Every question needs its words.'; paint(); return Promise.resolve(null); }
    if (f.questions.some(function (q) { return (q.type === 'choice' || q.type === 'multi') && !parseOpts(q._opts).length; })) { FM.err = 'A question with choices needs at least one choice.'; paint(); return Promise.resolve(null); }
    FM.busy = 'Saving\u2026'; paint();
    return newFields(f).then(function () {
      var tags = String(f._tags || '').split(',').map(function (x) { return x.trim().toLowerCase(); }).filter(Boolean);
      var row = { slug: f.slug, title: String(f.title).trim(), intro: String(f.intro || '').trim() || null, lang: f.lang === 'fr' ? 'fr' : 'en', kind: FKIND[f.kind] ? f.kind : 'general',
        questions: cleanQuestions(f.questions), consent: f.consent.ask ? { ask: true, required: !!f.consent.required, label: String(f.consent.label || '').trim() || CONSENT_DEFAULT } : { ask: false },
        thank_you: String(f.thank_you || '').trim() || null, settings: Object.assign({}, f.settings, { tags: tags }), cover_photo_id: f.cover_photo_id ? Number(f.cover_photo_id) : null, updated_by: actor() };
      if (row.kind !== 'volunteer') delete row.settings.volunteer_record;
      var q = f.id ? db.from('crm_forms').update(row).eq('id', f.id).select().single() : db.from('crm_forms').insert(Object.assign({ status: 'draft', created_by: actor() }, row)).select().single();
      return Promise.resolve(q).then(function (r) {
        FM.busy = '';
        if (r && r.error) { FM.err = /duplicate|unique|23505/i.test(String(r.error.message || r.error.code || '')) ? 'That web address is taken by another form.' : 'Not saved: ' + (r.error.message || r.error); paint(); return null; }
        var saved = (r && r.data) || null, savedId = (saved && saved.id) || f.id || null;
        return Promise.all([load('forms', true), load('cfields', true)]).then(function () {
          if (savedId) { FM.fid = String(savedId); FM.f = editCopy(formById(savedId) || Object.assign({}, row, { id: savedId, status: f.status })); try { history.replaceState(null, '', '#crm/forms/' + savedId); } catch (e) { /* fine */ } }
          return savedId;
        });
      });
    }).catch(function (e) { FM.busy = ''; FM.err = String((e && e.message) || e); paint(); return null; });
  }
  function setStatus(status) {
    var f = FM.f; if (!f || !f.id) return;
    FM.busy = status === 'published' ? 'Putting it live\u2026' : 'Closing it\u2026'; FM.confirm = ''; paint();
    saveForm().then(function (id) {
      if (!id) { FM.busy = ''; paint(); return; }
      return Promise.resolve(db.from('crm_forms').update({ status: status, updated_by: actor() }).eq('id', id).select().single()).then(function (r) {
        FM.busy = '';
        if (r && r.error) { FM.err = String(r.error.message || r.error).replace(/^.*?(A form needs|A newsletter sign-up needs)/, '$1'); paint(); return; }
        FM.msg = status === 'published' ? 'Live at hub.welfareavenue.com/f/' + f.slug + '. Copy the link to share it.' : 'Closed: the page now says it takes no more answers.';
        load('forms', true).then(function () { FM.f = editCopy(formById(id)); paint(); });
      });
    });
  }
  function newForm() {
    FM.busy = 'Making a draft\u2026'; paint();
    var n = (S.forms || []).length + 1, slug = 'new-form-' + n;
    while ((S.forms || []).some(function (f) { return f.slug === slug; })) { n++; slug = 'new-form-' + n; }
    var row = { slug: slug, title: 'New form', kind: 'general', lang: 'en', status: 'draft', created_by: actor(), updated_by: actor(),
      questions: [{ id: 'first_name', type: 'text', label: 'First name', required: true, to: 'contact.first_name' }, { id: 'last_name', type: 'text', label: 'Last name', required: false, to: 'contact.last_name' }, { id: 'email', type: 'email', label: 'Email', required: true, to: 'contact.email' }],
      consent: { ask: true, required: false, label: CONSENT_DEFAULT }, thank_you: 'Thank you. We have your answers.', settings: { tags: [] } };
    Promise.resolve(db.from('crm_forms').insert(row).select().single()).then(function (r) {
      FM.busy = '';
      if (r && r.error) { FM.err = 'The draft could not be made: ' + (r.error.message || r.error); paint(); return; }
      load('forms', true).then(function () { FM.msg = 'Draft made. Name it, pick where each answer goes, then put it live.'; go('#crm/forms/' + r.data.id); });
    });
  }
  function delForm() {
    var f = FM.f; if (!f || !f.id) return;
    Promise.resolve(db.from('crm_forms').delete().eq('id', f.id)).then(function (r) {
      FM.confirm = ''; FM.msg = r && r.error ? 'Not deleted: ' + (r.error.message || r.error) : 'Draft deleted.'; FM.f = null;
      load('forms', true).then(function () { go('#crm/forms'); paint(); });
    });
  }
  function archField(id) {
    var fd = (S.cfields || []).filter(function (x) { return String(x.id) === String(id); })[0]; if (!fd) return;
    Promise.resolve(db.from('crm_fields').update({ archived_at: fd.archived_at ? null : new Date().toISOString(), updated_by: actor(), updated_at: new Date().toISOString() }).eq('id', fd.id)).then(function (r) {
      if (r && r.error) FM.err = 'Not changed: ' + (r.error.message || r.error);
      load('cfields', true).then(function () { paint(); });
    });
  }

  /* ---------- styles ---------- */
  var css156 = document.createElement('style'); css156.id = 'w156css';
  css156.textContent = ''
    + '.w156row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:4px 12px;align-items:start;padding:12px 0;border-top:1px solid rgba(16,63,57,.08);}.w156row>.w155ra{grid-column:1/-1;justify-content:flex-start;}.w156meta{grid-column:1/-1;font-size:13.5px;}'
    + '.w156nm{display:flex;flex-direction:column;min-width:0;}.w156lk{overflow-wrap:anywhere;}.w156nm a{color:' + GREEN + ';}.w156warn{color:' + FLAG + ';font-weight:600;}'
    + '.w156fl{display:flex;flex-direction:column;}.w156fr{display:grid;grid-template-columns:minmax(0,1fr) auto auto;gap:10px;align-items:center;padding:9px 0;border-top:1px solid rgba(16,63,57,.07);font-size:13.5px;}.w156fr.arch{opacity:.55;}'
    + '.w156q{border:1px solid rgba(16,63,57,.14);border-radius:14px;padding:12px;margin:0 0 10px;background:rgba(16,63,57,.025);display:flex;flex-direction:column;gap:8px;}.w156q .w152in,.w156q .w152sel{width:100%;box-sizing:border-box;}'
    + '.w156qh{display:grid;grid-template-columns:auto minmax(0,1fr) auto auto auto auto;align-items:center;gap:6px;}.w156qh>b{font-family:' + HEAD + ';font-size:18px;color:' + GREEN + ';min-width:18px;}.w156qh .w152sel{width:100%;max-width:none;min-width:0;}.w156sp{display:none;}.w156qh .w152mini{padding:5px;}'
    + '.w156q textarea[data-w156qk],.w154card .w155lb textarea[data-w156k],.w154card .w155lb textarea[data-w156c]{min-height:72px;}'
    + '.w156ck{display:flex;align-items:center;gap:7px;font-size:13.5px;margin:0 0 8px;cursor:pointer;}.w156ck input{width:16px;height:16px;accent-color:' + GREEN + ';}.w156qh .w156ck{margin:0;}'
    + '.w156box{border:1px dashed rgba(16,63,57,.2);border-radius:12px;padding:10px 12px;margin:0 0 12px;}.w156h4{font-family:' + HEAD + ';font-size:17px;letter-spacing:.4px;text-transform:uppercase;color:' + GREEN + ';margin:18px 0 8px;}'
    + '.w156url{display:flex;align-items:center;gap:4px;font-size:14px;font-weight:500;letter-spacing:0;text-transform:none;color:var(--wa-muted,' + MUTED + ');}.w156url .w152in{flex:1;min-width:0;}'
    + '.w156sheet{border-radius:16px;overflow:hidden;border:1px solid rgba(16,63,57,.12);background:rgba(16,63,57,.05);}.w156band{position:relative;background:' + GREEN + ' center/cover no-repeat;color:' + CREAM + ';padding:12px 16px 30px;min-height:150px;display:flex;flex-direction:column;}'
    + '.w156band:before{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(16,63,57,.5),rgba(16,63,57,.92));}.w156band > *{position:relative;}'
    + '.w168top{display:flex;align-items:center;justify-content:space-between;}.w168top img{height:30px;width:auto;}.w168top .w168star{height:30px;transform:rotate(12deg);}'
    + '.w168ey{margin-top:auto;padding-top:18px;font-size:10.5px;font-weight:700;letter-spacing:1.4px;text-transform:uppercase;color:' + GOLD + ';}.w156band .w156t{color:' + CREAM + ';font-size:26px;}'
    + '.w168cov .w168now{display:flex;gap:10px;align-items:center;margin:0 0 10px;}.w168cov .w168now .im{flex:0 0 96px;height:60px;border-radius:10px;background:' + GREEN + ' center/cover;}.w168cov .w168now b{display:block;font-size:13.5px;}.w168cov .w168now .w152btn{margin-top:6px;}'
    + '.w168grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(78px,1fr));gap:6px;max-height:232px;overflow-y:auto;padding:2px;}'
    + '.w168th{aspect-ratio:3/2;border:2px solid transparent;border-radius:9px;background:' + GREEN + ' center/cover;cursor:pointer;padding:0;}.w168th:hover{border-color:' + GOLD + ';}.w168th.on{border-color:' + GOLD + ';box-shadow:0 0 0 2px ' + GREEN + ';}.w168th:focus-visible{outline:2px solid ' + GOLD + ';outline-offset:1px;}'
    + '.w156page{background:' + CREAM + ';margin:-18px 12px 12px;border-radius:14px;padding:18px;box-shadow:0 6px 18px rgba(16,63,57,.08);position:relative;}.w156t{font-family:' + HEAD + ';font-weight:700;font-size:24px;text-transform:uppercase;color:' + GREEN + ';line-height:1.05;}'
    + '.w156rule{display:block;width:44px;height:3px;border-radius:3px;background:' + GOLD + ';margin:8px 0 10px;}.w156page p{font-size:13.5px;margin:0 0 12px;color:#3d3c39;}'
    + '.w156pq{margin:0 0 12px;}.w156pl{font-weight:600;font-size:13.5px;margin-bottom:4px;}.w156req{color:' + FLAG + ';margin-left:2px;}.w156pc{display:flex;flex-wrap:wrap;gap:6px;}'
    + '.w156pr,.w156pb{border:1px solid rgba(16,63,57,.18);border-radius:10px;padding:6px 10px;font-size:13px;background:' + CREAM + ';}.w156pr:before{content:"\\25CB  ";color:' + MUTED + ';}.w156pb:before{content:"\\2610  ";color:' + MUTED + ';}'
    + '.w156pcons .w156pb{border-style:dashed;display:block;}.w156send{display:inline-block;background:' + GOLD + ';color:' + INK + ';font-weight:600;border-radius:999px;padding:8px 20px;font-size:14px;}.w156page .w152in[disabled]{background:' + CREAM + ';}'
    + '.w156subs{display:flex;flex-direction:column;}.w156sub{border-top:1px solid rgba(16,63,57,.08);}.w156sh{all:unset;box-sizing:border-box;cursor:pointer;display:grid;grid-template-columns:110px minmax(0,1fr) auto;gap:10px;align-items:center;width:100%;padding:10px 4px;font-size:14px;}'
    + '.w156sh:focus-visible{outline:2px solid ' + GOLD + ';outline-offset:2px;border-radius:8px;}.w156who{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}.w156sd{padding:4px 4px 12px;}'
    + '.w156more .w152kv{grid-template-columns:minmax(110px,42%) minmax(0,1fr);margin-bottom:4px;}.w156more .w152kv>span:first-child{color:var(--wa-muted,' + MUTED + ');}'
    + '@media (max-width:700px){.w156sh{grid-template-columns:minmax(0,1fr) auto;}.w156sh>span:first-child{grid-column:1/-1;font-size:12px;color:' + MUTED + ';}}';
  document.head.appendChild(css156);

  /* ---------- wiring ---------- */
  function qAt(el) { var box = el.closest('[data-w156qi]'); return box ? Number(box.getAttribute('data-w156qi')) : -1; }
  document.addEventListener('click', function (e) {
    var t = e.target, el; if (!t || !t.closest || !t.closest('.w152root')) return;
    var f = FM.f;
    if ((el = t.closest('[data-w156new]'))) { e.preventDefault(); newForm(); return; }
    if ((el = t.closest('[data-w156open]'))) { e.preventDefault(); FM.msg = ''; go('#crm/forms/' + el.getAttribute('data-w156open')); return; }
    if ((el = t.closest('[data-w156answers]'))) { e.preventDefault(); FM.msg = ''; go('#crm/forms/' + el.getAttribute('data-w156answers') + '/answers'); return; }
    if ((el = t.closest('[data-w156back]'))) { e.preventDefault(); FM.f = null; FM.confirm = ''; go('#crm/forms'); return; }
    if ((el = t.closest('[data-w156arch]'))) { e.preventDefault(); archField(el.getAttribute('data-w156arch')); return; }
    if ((el = t.closest('[data-w156sub]'))) { e.preventDefault(); var sid = el.getAttribute('data-w156sub'); FM.openSub = FM.openSub === sid ? null : sid; paint(); return; }
    if ((el = t.closest('[data-w156spam]'))) { e.preventDefault(); FM.showSpam = !FM.showSpam; paint(); return; }
    if ((el = t.closest('[data-w156tests]'))) { e.preventDefault(); FM.showTests = !FM.showTests; paint(); return; }
    if (!f) return;
    if ((el = t.closest('[data-w156qadd]'))) { e.preventDefault(); f.questions.push({ id: '', type: 'text', label: '', required: false, to: '', _opts: '' }); paint(); var qs = document.querySelectorAll('#crm [data-w156qi] [data-w156qk="label"]'); if (qs.length) qs[qs.length - 1].focus(); return; }
    if ((el = t.closest('[data-w156qmv]'))) { e.preventDefault(); var i = qAt(el), j = i + Number(el.getAttribute('data-w156qmv')); if (i < 0 || j < 0 || j >= f.questions.length) return; var tmp = f.questions[i]; f.questions[i] = f.questions[j]; f.questions[j] = tmp; paint(); return; }
    if ((el = t.closest('[data-w156qdel]'))) { e.preventDefault(); var k = qAt(el); if (k >= 0) f.questions.splice(k, 1); paint(); return; }
    if ((el = t.closest('[data-w168cov]'))) { e.preventDefault(); var cv = el.getAttribute('data-w168cov'); f.cover_photo_id = cv ? Number(cv) : null; paint(); return; }
    if ((el = t.closest('[data-w156save]'))) { e.preventDefault(); saveForm().then(function (id) { if (id) { FM.msg = 'Saved.'; paint(); } }); return; }
    if ((el = t.closest('[data-w156pub]'))) { e.preventDefault(); FM.confirm = 'publish'; paint(); return; }
    if ((el = t.closest('[data-w156pubok]'))) { e.preventDefault(); el.disabled = true; setStatus('published'); return; }
    if ((el = t.closest('[data-w156close]'))) { e.preventDefault(); FM.confirm = 'close'; paint(); return; }
    if ((el = t.closest('[data-w156closeok]'))) { e.preventDefault(); el.disabled = true; setStatus('closed'); return; }
    if ((el = t.closest('[data-w156del]'))) { e.preventDefault(); FM.confirm = 'delete'; paint(); return; }
    if ((el = t.closest('[data-w156delok]'))) { e.preventDefault(); delForm(); return; }
    if ((el = t.closest('[data-w156no]'))) { e.preventDefault(); FM.confirm = ''; paint(); return; }
  });
  function onForm156(e) {
    var t = e.target, f = FM.f; if (!f || !t || !t.closest || !t.closest('.w152root')) return;
    var key, i;
    if (t.hasAttribute('data-w156k')) {
      key = t.getAttribute('data-w156k'); f[key] = t.value;
      if (key === 'kind' && e.type === 'change') { if (t.value === 'volunteer' && f.settings.volunteer_record == null) f.settings.volunteer_record = true; paint(); }
      else if (key === 'lang' && e.type === 'change') paint();
      else if (key === 'title' || key === 'intro') previewSoon156();
      return;
    }
    if (t.hasAttribute('data-w156set')) { key = t.getAttribute('data-w156set'); f.settings[key] = t.type === 'checkbox' ? t.checked : t.value; return; }
    if (t.hasAttribute('data-w156c')) { key = t.getAttribute('data-w156c'); f.consent[key] = t.type === 'checkbox' ? t.checked : t.value; if (key === 'ask' && t.checked && !f.consent.label) f.consent.label = CONSENT_DEFAULT; if (t.type === 'checkbox') paint(); return; }
    if (t.hasAttribute('data-w156qk')) {
      i = qAt(t); if (i < 0) return; key = t.getAttribute('data-w156qk'); var q = f.questions[i];
      q[key] = t.type === 'checkbox' ? t.checked : t.value;
      if (key === 'type') { q.to = (toChoices(q, f.kind).filter(function (o) { return o[0] === q.to; })[0] || [''])[0]; if (q.type === 'email') q.to = 'contact.email'; if (q.type === 'phone') q.to = 'contact.phone'; if (q.type === 'serving_dates') q.to = 'volunteer.dates'; }
      if (key === 'type' || (key === 'to' && e.type === 'change') || key === 'required') paint();
      else if (key === 'label' || key === '_opts' || key === 'help') previewSoon156();
    }
  }
  var pv156 = null;
  function previewSoon156() { clearTimeout(pv156); pv156 = setTimeout(function () { var pv = document.querySelector('#crm .w156pv'); if (pv && FM.f) pv.outerHTML = previewHtml156(); }, 350); }
  document.addEventListener('input', function (e) { var t = e.target; if (t && t.tagName !== 'SELECT' && t.type !== 'checkbox') onForm156(e); });
  document.addEventListener('change', function (e) { var t = e.target; if (t && (t.tagName === 'SELECT' || t.type === 'checkbox')) onForm156(e); });
  /* ======================= Automations (wave157, 28/09/26) =======================
     Step 5 of the CRM plan: Keela's welcome series and donor follow-up, rebuilt in the Hub. An automation starts for one
     person when something happens (they fill in a form, a tag is added, a gift is recorded, a serving they signed up for
     comes near) and runs its steps: send an email, wait, wait until an email is opened (a yes and a no path), add or
     remove tags, make a task on a team's board, notify team members. The engine is in the database
     (crm_automation_tick every minute); every email goes through mail-send and the permission rule, between 8 am and
     8 pm Toronto, and while the Hub is in test mode only test addresses get one. Automations start as drafts; Try it on
     me runs one on your own contact (a day of waiting is a minute, tags, tasks and notices are only described). */
  P.bolt = '<path d="M13.5 2.5 5 13.5h6l-1 8 8.5-11h-6z"/>';
  P.pause = '<path d="M8.5 5.5v13M15.5 5.5v13"/>';
  P.play = '<path d="M7.5 5v14l11-7z"/>';
  P.bell = '<path d="M6 16.5V11a6 6 0 0 1 12 0v5.5l1.5 2h-15z"/><path d="M10 20.5a2 2 0 0 0 4 0"/>';
  var AU = { aid: null, a: null, sub: '', msg: '', err: '', busy: '', confirm: '', problems: null, runs: null, runsFor: null, openRun: null, showTests: true, prev: null, prevFor: null };
  LOADERS.autos = function () { return db.from('crm_automations').select('*').order('created_at', { ascending: true }).order('id', { ascending: true }); };
  LOADERS.astats = function () { return db.from('crm_automation_stats_v').select('*'); };
  LOADERS.depts = function () { return db.from('dept_meta').select('department,label,short_label,sort').order('sort', { ascending: true }); };
  LOADERS.tmembers = function () { return db.from('team_members').select('id,name,email,department,active').eq('active', true).order('name', { ascending: true }).limit(400); };
  var ASTAT = { draft: ['Draft', MUTED], on: ['On', GREEN], paused: ['Paused', '#B9851B'] };
  var RSTAT = { active: ['In it now', TEAL], done: ['Finished', GREEN], stopped: ['Stopped', MUTED], error: ['Needs a look', FLAG], test: ['Test run', PURPLE] };
  var ATRIG = [['form', 'Someone fills in a form'], ['tag', 'A tag is added to a contact'], ['gift', 'A gift is recorded'], ['serving', 'A serving they signed up for is coming']];
  var ASTEP = { send: ['Send an email', 'mail'], wait: ['Wait', 'clock'], wait_open: ['Wait until opened', 'eye'], tag: ['Add or remove tags', 'tag'], task: ['Make a task', 'check'], notify: ['Notify the team', 'bell'], end: ['End here', 'x'] };
  var AKIND = [['transactional', 'About something they did', 'A welcome, a thank-you or a reminder: goes to any working address.'], ['volunteer', 'Volunteer news', 'Anyone with a working address who has not unsubscribed.'],
    ['newsletter', 'Newsletter', 'People who said yes, or gave or served in the last two years.'], ['fundraising', 'Fundraising', 'The same people as a newsletter.']];
  var ASAMPLE = { form_title: 'Volunteer with Welfare Avenue', amount: '$25.00', gift_date: '28 Sep 2026', gift_date_line: ' on 28 Sep 2026', event_day: 'Sunday', event_when: 'Sunday 4 October 2026', event_title: 'the serving on Sunday 4 October', role: 'a server' };
  function autoById(id) { return (S.autos || []).filter(function (a) { return String(a.id) === String(id); })[0] || null; }
  function astat(id) { return (S.astats || []).filter(function (x) { return String(x.automation_id) === String(id); })[0] || {}; }
  function tplLabel(key) { var t = (S.templates || []).filter(function (x) { return x.key === key; })[0]; return t ? t.name : (key || 'a saved email'); }
  function deptLabel(code) { var d = (S.depts || []).filter(function (x) { return x.department === code; })[0]; return d ? (d.label || d.short_label || code) : (code || 'a team'); }
  function memberLabel(em) { var m = (S.tmembers || []).filter(function (x) { return lower(x.email) === lower(em); })[0]; return m ? m.name : em; }
  function csv(v) { return (Array.isArray(v) ? v : String(v || '').split(',')).map(function (x) { return String(x).trim(); }).filter(Boolean); }
  function trigText(t) {
    t = t || {};
    if (t.kind === 'form') { var f = t.form_id ? formById(t.form_id) : null; return t.form_id ? 'When someone fills in \u201c' + (f ? f.title : 'a form that is gone') + '\u201d' : 'When someone fills in any form'; }
    if (t.kind === 'tag') return 'When the tag \u201c' + (t.tag || '\u2026') + '\u201d is added to a contact';
    if (t.kind === 'gift') return 'When a gift' + (Number(t.min_amount) ? ' of $' + Number(t.min_amount) + ' or more' : '') + ' is recorded' + (t.first_only ? ' (a first gift only)' : '');
    if (t.kind === 'serving') return plural(Number(t.days_before) || 2, 'day', 'days') + ' before a ' + (t.location && t.location !== 'any' ? t.location + ' ' : '') + 'serving they are ' + (t.include_unconfirmed ? 'on the roster for' : 'confirmed for');
    return 'Not chosen yet';
  }
  function stepText(s) {
    if (!s) return '';
    if (s.type === 'send') return 'Email: ' + (s.email === 'template' ? tplLabel(s.template_key) : '\u201c' + (s.subject || 'no subject yet') + '\u201d');
    if (s.type === 'wait') return 'Wait ' + plural(Number(s.days) || 0, 'day', 'days');
    if (s.type === 'wait_open') return 'Wait up to ' + plural(Number(s.days) || 0, 'day', 'days') + ' for the email to be opened';
    if (s.type === 'tag') return 'Tags: ' + listJoin(csv(s.add).map(function (x) { return '+' + x; }).concat(csv(s.remove).map(function (x) { return '\u2212' + x; })));
    if (s.type === 'task') return 'A task for ' + deptLabel(s.department) + ': \u201c' + (s.title || '') + '\u201d';
    if (s.type === 'notify') return 'Notify ' + listJoin(csv(s.to).map(memberLabel));
    return 'End';
  }

  /* ---------- the list ---------- */
  function autoRow(a) {
    var st = astat(a.id), sends = (a.steps || []).filter(function (s) { return s.type === 'send'; }).length;
    return '<div class="w156row" role="listitem"><div class="w156nm"><button class="w155cn" data-w157open="' + E(a.id) + '"><b>' + E(a.name) + '</b></button>' +
      '<span class="m">' + E(trigText(a.trigger)) + '</span><span class="m">' + plural((a.steps || []).length, 'step', 'steps') + (sends ? ' \u00b7 ' + plural(sends, 'email', 'emails') : '') + '</span></div>' +
      '<div>' + lchip(ASTAT, a.status) + '</div>' +
      '<div class="w156meta">' + plural(Number(st.active) || 0, 'person in it now', 'people in it now') + '<span class="m"> \u00b7 ' + (Number(st.done) || 0) + ' finished \u00b7 ' + plural(Number(st.emails_sent) || 0, 'email sent', 'emails sent') + '</span>' +
      (Number(st.errors) ? '<span class="w156warn"> \u00b7 ' + plural(Number(st.errors), 'needs a look', 'need a look') + '</span>' : '') + '</div>' +
      '<div class="w155ra"><button class="w152btn sm ghost" data-w157open="' + E(a.id) + '">' + I('edit') + ' Open</button><button class="w152btn sm ghost" data-w157people="' + E(a.id) + '">' + I('people') + ' People</button></div></div>';
  }
  function autosListHtml() {
    var as = S.autos || [], live = !!(MAIL.st && MAIL.st.settings && MAIL.st.settings.mail_mode === 'live');
    return '<div class="w155grid"><div class="w154card wide"><h3>' + I('bolt') + ' Automations <span class="w155sub">' + plural(as.length, 'automation', 'automations') + '</span></h3>' +
      '<p class="m">An automation runs by itself for each person: when they fill in a form, get a tag or give, or before a serving they signed up for. It sends emails through the permission rule, only between 8 am and 8 pm (Toronto), and it can tag, make a task on a team\u2019s board or notify someone. New ones start as drafts; Try it on me runs one on your own contact first.</p>' +
      (!live ? '<div class="w155cf test">' + I('lock') + ' The Hub is in test mode: an automation that is on still runs, but its emails only reach the test addresses until an admin switches the mode to live in the Email tab.</div>' : '') +
      (AU.msg ? '<div class="w154msg">' + E(AU.msg) + '</div>' : '') + (AU.err ? '<div class="w152err">' + E(AU.err) + '</div>' : '') +
      '<div class="w154acts"><button class="w152btn" data-w157new="1">' + I('plus') + ' New automation</button></div>' +
      (as.length ? '<div class="w155rows" role="list">' + as.map(autoRow).join('') + '</div>' : '<p class="m">No automation yet.</p>') + '</div></div>';
  }

  /* ---------- the editor ---------- */
  function autoCopy(a) {
    var c = JSON.parse(JSON.stringify(a));
    c.trigger = c.trigger || {}; c.settings = c.settings || {};
    c.steps = (c.steps || []).map(function (s) {
      if (s.type === 'tag') { s._add = csv(s.add).join(', '); s._rem = csv(s.remove).join(', '); }
      if (s.type === 'notify') s._to = csv(s.to).join(', ');
      return s;
    });
    return c;
  }
  function nextStepId(a) { var n = 0; a.steps.forEach(function (s) { var m = /^s(\d+)$/.exec(s.id || ''); if (m) n = Math.max(n, Number(m[1])); }); return 's' + (n + 1); }
  function newStep(type, a) {
    var id = nextStepId(a);
    if (type === 'send') return { id: id, type: 'send', email: 'write', kind: 'transactional', subject: '', preheader: '', headline: '', body: 'Hi {{first_name|there}},\n\n', cta_label: '', cta_url: '', from: 'org' };
    if (type === 'wait') return { id: id, type: 'wait', days: 2 };
    if (type === 'wait_open') { var last = a.steps.filter(function (s) { return s.type === 'send'; }).slice(-1)[0]; return { id: id, type: 'wait_open', step: last ? last.id : '', days: 3, yes: 'next', no: 'next' }; }
    if (type === 'tag') return { id: id, type: 'tag', _add: '', _rem: '' };
    if (type === 'task') return { id: id, type: 'task', department: ((S.depts || [])[0] || {}).department || 'opsmtl', title: 'Follow up with {{full_name}}', note: '', due_days: 3 };
    if (type === 'notify') return { id: id, type: 'notify', _to: myEmail(), message: '{{full_name}} just joined \u201c' + (a.name || 'this automation') + '\u201d.' };
    return { id: id, type: 'end' };
  }
  function auSel(attr, list, cur, label) { return '<select class="w152sel" ' + attr + (label ? ' aria-label="' + E(label) + '"' : '') + '>' + list.map(function (o) { return '<option value="' + E(o[0]) + '"' + (String(o[0]) === String(cur == null ? '' : cur) ? ' selected' : '') + '>' + E(o[1]) + '</option>'; }).join('') + '</select>'; }
  function fld(k, label, v, ph, area, type) {
    return '<label class="w155lb">' + E(label) + (area ? '<textarea class="w152in" data-w157s="' + k + '" rows="' + (area === true ? 5 : area) + '" placeholder="' + E(ph || '') + '">' + E(v || '') + '</textarea>'
      : '<input class="w152in" data-w157s="' + k + '"' + (type ? ' type="' + type + '"' : '') + ' value="' + E(v == null ? '' : v) + '" placeholder="' + E(ph || '') + '">') + '</label>';
  }
  function pathChoices(a, i) { var out = [['next', 'Go on to the next step'], ['end', 'End here']]; a.steps.forEach(function (s, j) { if (j > i + 1) out.push([s.id, 'Jump to step ' + (j + 1) + ': ' + stepText(s)]); }); return out; }
  function stepBody(s, i, a) {
    if (s.type === 'send') {
      var tpls = [['write', 'Write it here (the Welfare Avenue layout)']].concat((S.templates || []).filter(function (t) { return t.key !== 'test' && t.key !== 'newsletter' && t.active; }).map(function (t) { return ['tpl:' + t.key, 'Saved email: ' + t.name]; }));
      var kind = AKIND.filter(function (k) { return k[0] === s.kind; })[0] || AKIND[0];
      return '<div class="w155two"><label class="w155lb">The email' + auSel('data-w157s="_email"', tpls, s.email === 'template' ? 'tpl:' + s.template_key : 'write') + '</label>' +
        '<label class="w155lb">Who can get it' + auSel('data-w157s="kind"', AKIND.map(function (k) { return [k[0], k[1]]; }), s.kind) + '</label></div><p class="m">' + E(kind[2]) + '</p>' +
        (s.email === 'template' ? '<p class="m">The saved email\u2019s own words, with this person\u2019s name' + (a.trigger && a.trigger.kind === 'gift' ? ' and the gift' : a.trigger && a.trigger.kind === 'serving' ? ' and the serving' : '') + ' filled in. Edit it in the Email tab.</p>'
          : fld('subject', 'Subject', s.subject, 'Welcome to Welfare Avenue, {{first_name|friend}}') + fld('preheader', 'Preview text (optional)', s.preheader, 'One line that shows after the subject') +
            fld('headline', 'Headline', s.headline, 'Welcome to our community') + fld('body', 'Message (a blank line starts a new paragraph)', s.body, 'Hi {{first_name|there}},', 7) +
            '<div class="w155two">' + fld('cta_label', 'Button (optional)', s.cta_label, 'See the upcoming servings') + fld('cta_url', 'Button link', s.cta_url, 'https://welfareavenue.com') + '</div>') +
        '<div class="w155two"><label class="w155lb">From' + auSel('data-w157s="from"', [['org', 'Welfare Avenue (info@welfareavenue.com)'], ['custom', 'A team member']], s.from || 'org') + '</label>' +
        (s.from === 'custom' ? '<span class="w157pair">' + fld('from_name', 'Their name', s.from_name, 'Suhaib Abdillahi') + fld('from_email', 'Their address', s.from_email, 'name@welfareavenue.com') + '</span>' : '<span></span>') + '</div>';
    }
    if (s.type === 'wait') return '<div class="w157inline">' + fld('days', 'Days', s.days, '2', false, 'number') + '<p class="m">Then the next step. Waits are counted from the step before.</p></div>';
    if (s.type === 'wait_open') {
      var sends = a.steps.slice(0, i).filter(function (x) { return x.type === 'send'; }).map(function (x) { var j = a.steps.indexOf(x); return [x.id, 'Step ' + (j + 1) + ': ' + stepText(x)]; });
      return '<label class="w155lb">Which email' + auSel('data-w157s="step"', sends.length ? sends : [['', 'Add an email before this step']], s.step) + '</label>' +
        '<div class="w157inline">' + fld('days', 'Wait up to (days)', s.days, '3', false, 'number') + '</div>' +
        '<div class="w155two"><label class="w155lb">If they open it' + auSel('data-w157s="yes"', pathChoices(a, i), s.yes || 'next') + '</label><label class="w155lb">If not' + auSel('data-w157s="no"', pathChoices(a, i), s.no || 'next') + '</label></div>' +
        '<p class="m">Opens are counted when Resend\u2019s open tracking is on for welfareavenue.com, and some mail apps open everything, so treat this as a hint.</p>';
    }
    if (s.type === 'tag') return '<div class="w155two">' + fld('_add', 'Add these tags', s._add, 'welcomed, rally 2026') + fld('_rem', 'Remove these tags', s._rem, 'applicant') + '</div>';
    if (s.type === 'task') return '<div class="w155two"><label class="w155lb">Whose board' + auSel('data-w157s="department"', (S.depts || []).map(function (d) { return [d.department, d.label || d.short_label || d.department]; }), s.department) + '</label>' +
      fld('due_days', 'Due in (days)', s.due_days, '3', false, 'number') + '</div>' + fld('title', 'The task', s.title, 'Book {{full_name}}\u2019s first serving') + fld('note', 'Details (optional)', s.note, 'Phone: {{phone|not given}}', 3) +
      '<p class="m">The task links to their page in the CRM. An email address in these words is written with \u201cat\u201d, so it never reads as a mention.</p>';
    if (s.type === 'notify') return fld('_to', 'Who (team addresses, separated by commas)', s._to, 'name@welfareavenue.com') +
      '<p class="m">' + E(csv(s._to).map(function (em) { var m = (S.tmembers || []).filter(function (x) { return lower(x.email) === lower(em); })[0]; return m ? m.name : em + ' (not on the team list)'; }).join(', ')) + '</p>' +
      fld('message', 'The message', s.message, '{{full_name}} applied to volunteer.', 3) + '<p class="m">It shows in their mentions in the Hub and reaches them on Slack, like an @mention.</p>';
    return '<p class="m">The run stops here, even if steps follow (a path can jump past it).</p>';
  }
  function stepCard(s, i, a) {
    var d = ASTEP[s.type] || [s.type, 'spark'];
    return '<div class="w157step" data-w157si="' + i + '"><div class="w157sh"><b>' + (i + 1) + '</b><span class="w157st">' + I(d[1]) + ' ' + E(d[0]) + '</span><span class="w156sp"></span>' +
      (s.type === 'send' ? '<button class="w152mini" data-w157pv="' + i + '">' + I('eye') + ' Preview</button>' : '') +
      '<button class="w152mini" data-w157mv="-1" aria-label="Move up"' + (i ? '' : ' disabled') + '>' + I('up') + '</button><button class="w152mini" data-w157mv="1" aria-label="Move down"' + (i < a.steps.length - 1 ? '' : ' disabled') + '>' + I('down') + '</button>' +
      '<button class="w152mini" data-w157del="1" aria-label="Remove the step">' + I('trash') + '</button></div>' + stepBody(s, i, a) + '</div>';
  }
  function trigHtml(a) {
    var t = a.trigger || {}, forms = (S.forms || []).map(function (f) { return [String(f.id), f.title + (f.status === 'published' ? '' : ' (' + f.status + ')')]; });
    var body = '';
    if (t.kind === 'form') body = '<label class="w155lb">Which form' + auSel('data-w157t="form_id"', [['', 'Any form']].concat(forms), t.form_id == null ? '' : String(t.form_id)) + '</label>';
    if (t.kind === 'tag') body = '<label class="w155lb">The tag<input class="w152in" data-w157t="tag" value="' + E(t.tag || '') + '" placeholder="volunteer applicant"></label>';
    if (t.kind === 'gift') body = '<div class="w155two"><label class="w155lb">From this amount (optional)<input class="w152in" type="number" data-w157t="min_amount" value="' + E(t.min_amount == null ? '' : t.min_amount) + '" placeholder="Any amount"></label>' +
      '<label class="w156ck w157ck"><input type="checkbox" data-w157t="first_only"' + (t.first_only ? ' checked' : '') + '> Their first gift only</label></div><p class="m">Only gifts dated in the last 7 days start it, so an import of older gifts sends nothing.</p>';
    if (t.kind === 'serving') body = '<div class="w155two"><label class="w155lb">Days before<input class="w152in" type="number" data-w157t="days_before" value="' + E(t.days_before || 2) + '"></label>' +
      '<label class="w155lb">Where' + auSel('data-w157t="location"', [['Montreal', 'Montreal'], ['Toronto', 'Toronto'], ['any', 'Any location']], t.location || 'Montreal') + '</label></div>' +
      '<label class="w156ck"><input type="checkbox" data-w157t="include_unconfirmed"' + (t.include_unconfirmed ? ' checked' : '') + '> Also people still to confirm (TBD, waiting for an answer)</label>';
    return '<h4 class="w156h4">When it starts</h4><div class="w156box">' + auSel('data-w157t="kind"', [['', 'Pick what starts it']].concat(ATRIG), t.kind || '', 'What starts it') + body +
      (t.kind && t.kind !== 'serving' ? '<label class="w156ck"><input type="checkbox" data-w157set="reentry"' + ((a.settings.reentry == null ? t.kind === 'gift' : a.settings.reentry) ? ' checked' : '') + '> The same person can go through it again each time' + (t.kind === 'gift' ? ' (each gift gets its thank-you)' : '') + '</label>' : '') + '</div>';
  }
  function autoConfirmHtml(a) {
    if (AU.confirm === 'problems') return '<div class="w155cf test"><b>Not ready to turn on yet:</b><ul class="w157ul">' + (AU.problems || []).map(function (p) { return '<li>' + E(p) + '</li>'; }).join('') + '</ul><div class="w154acts"><button class="w152btn ghost" data-w157no="1">Back to editing</button></div></div>';
    if (AU.confirm === 'on') {
      var live = !!(MAIL.st && MAIL.st.settings && MAIL.st.settings.mail_mode === 'live');
      return '<div class="w155cf"><b>Turn on \u201c' + E(a.name) + '\u201d?</b> From now on: ' + E(trigText(a.trigger).replace(/^When/, 'when')) + ', that person starts it. Emails go out between 8 am and 8 pm (Toronto) through the permission rule' +
        (live ? '.' : '; while the Hub is in test mode only the test addresses get them.') + ' People who met the trigger before today are not included.' +
        '<div class="w154acts"><button class="w152btn" data-w157onok="1">' + I('play') + ' Turn it on</button><button class="w152btn ghost" data-w157no="1">Not yet</button></div></div>';
    }
    if (AU.confirm === 'delete') return '<div class="w155cf test"><b>Delete this draft?</b><div class="w154acts"><button class="w152btn" data-w157delok="1">' + I('trash') + ' Delete it</button><button class="w152btn ghost" data-w157no="1">Keep it</button></div></div>';
    return '';
  }
  function autoEditorHtml() {
    var a = AU.a, st = astat(a.id);
    var adds = Object.keys(ASTEP).map(function (k) { return '<button class="w152btn sm ghost" data-w157add="' + k + '">' + I(ASTEP[k][1]) + ' ' + E(ASTEP[k][0]) + '</button>'; }).join('');
    return '<div class="w154card"><h3>' + I('bolt') + ' ' + E(a.id ? 'Edit the automation' : 'New automation') + ' ' + lchip(ASTAT, a.status) + '</h3>' +
      (AU.err ? '<div class="w152err">' + E(AU.err) + '</div>' : '') + (AU.msg ? '<div class="w154msg">' + E(AU.msg) + '</div>' : '') + (AU.busy ? '<div class="m">' + E(AU.busy) + '</div>' : '') +
      '<label class="w155lb">Name<input class="w152in" data-w157k="name" value="' + E(a.name || '') + '" placeholder="Welcome new volunteers"></label>' +
      '<label class="w155lb">What it is for (optional)<textarea class="w152in" data-w157k="description" rows="2">' + E(a.description || '') + '</textarea></label>' +
      trigHtml(a) + '<h4 class="w156h4">What happens</h4>' + (a.steps.length ? a.steps.map(function (s, i) { return stepCard(s, i, a); }).join('') : '<p class="m">No step yet: add the first one.</p>') +
      '<div class="w157adds">' + adds + '</div>' +
      '<div class="w154acts"><button class="w152btn" data-w157save="1">' + I('check') + ' Save</button>' +
      (a.id && a.status !== 'on' ? '<button class="w152btn ghost" data-w157on="1">' + I('play') + ' Turn on\u2026</button>' : '') +
      (a.status === 'on' ? '<button class="w152btn ghost" data-w157pause="1">' + I('pause') + ' Pause</button>' : '') +
      (a.id ? '<button class="w152btn ghost" data-w157try="1">' + I('spark') + ' Try it on me</button><button class="w152btn ghost" data-w157people="' + E(a.id) + '">' + I('people') + ' People (' + ((Number(st.active) || 0) + (Number(st.done) || 0) + (Number(st.stopped) || 0) + (Number(st.errors) || 0)) + ')</button>' : '') +
      '<button class="w152btn ghost" data-w157back="1">Back to the automations</button>' +
      (a.id && a.status === 'draft' ? '<button class="w152btn ghost" data-w157dela="1">' + I('trash') + ' Delete the draft</button>' : '') + '</div>' + autoConfirmHtml(a) + '</div>';
  }
  function autoSideHtml() {
    var a = AU.a, p = AU.prev;
    if (p && AU.prevFor === a.id) return '<div class="w154card"><h3>' + I('mail') + ' Preview</h3>' + (p.busy ? busy('Rendering the preview\u2026') : p.err ? '<div class="w152err">' + E(p.err) + '</div>'
      : '<div class="w154pv"><div class="m">From: ' + E(p.from || '') + '<br>Subject: <b>' + E(p.subject || '') + '</b>' + (p.preheader ? '<br>Preview text: ' + E(p.preheader) : '') + '<br>Shown with sample details; each person gets their own name.</div><iframe class="w154frame" sandbox="" title="The email as it will look" srcdoc="' + E(p.html || '') + '"></iframe></div>') +
      '<div class="w154acts"><button class="w152btn sm ghost" data-w157pvclose="1">Back to the outline</button></div></div>';
    return '<div class="w154card w157flow"><h3>' + I('list') + ' In plain words</h3><p class="w157tr">' + E(trigText(a.trigger)) + ':</p><ol class="w157ol">' +
      a.steps.map(function (s, i) {
        var extra = s.type === 'wait_open' ? ' If opened: ' + (s.yes === 'end' ? 'end' : s.yes && s.yes !== 'next' ? 'jump to step ' + (a.steps.map(function (x) { return x.id; }).indexOf(s.yes) + 1) : 'go on') + '. If not: ' + (s.no === 'end' ? 'end' : s.no && s.no !== 'next' ? 'jump to step ' + (a.steps.map(function (x) { return x.id; }).indexOf(s.no) + 1) : 'go on') + '.' : '';
        return '<li>' + E(stepText(s) + '.' + extra) + '</li>';
      }).join('') + '</ol></div>';
  }

  /* ---------- the people in it ---------- */
  function runStepText(r, a) {
    if (r.status !== 'active') return '';
    var s = (a.steps || []).filter(function (x) { return x.id === r.step_id; })[0] || (r.step_id ? null : (a.steps || [])[0]);
    return s ? 'Next: ' + stepText(s) + (r.next_at ? ' \u00b7 ' + fmtDay(r.next_at) : '') : '';
  }
  function runsHtml(a) {
    var all = AU.runsFor === String(a.id) ? AU.runs : null;
    if (!all) return '<div class="w154card wide">' + busy('Loading the people\u2026') + '</div>';
    var tests = all.filter(function (r) { return r.is_test; }).length;
    var rows = all.filter(function (r) { return AU.showTests || !r.is_test; });
    return '<div class="w154card wide"><h3>' + I('people') + ' People in \u201c' + E(a.name) + '\u201d <span class="w155sub">' + plural(rows.length, 'run', 'runs') + '</span></h3>' +
      (AU.msg ? '<div class="w154msg">' + E(AU.msg) + '</div>' : '') + (AU.err ? '<div class="w152err">' + E(AU.err) + '</div>' : '') +
      '<div class="w154acts">' + (tests ? '<button class="w152btn sm ghost" data-w157tests="1">' + (AU.showTests ? 'Hide' : 'Show') + ' test runs (' + tests + ')</button>' : '') +
      '<button class="w152btn sm ghost" data-w157open="' + E(a.id) + '">' + I('edit') + ' Edit the automation</button><button class="w152btn sm ghost" data-w157back="1">Back to the automations</button></div>' +
      (rows.length ? '<div class="w156subs">' + rows.map(function (r) {
        var c = contact(r.contact_id), open = AU.openRun === String(r.id);
        return '<div class="w156sub"><button class="w156sh" data-w157run="' + E(r.id) + '" aria-expanded="' + open + '"><span>' + E(fmtDay(r.started_at)) + '</span><span class="w156who">' + E(c ? c.full_name : 'Contact ' + r.contact_id) +
          '<span class="m w157next">' + E(runStepText(r, a)) + '</span></span><span>' + lchip(RSTAT, r.is_test ? 'test' : r.status) + '</span></button>' +
          (open ? '<div class="w156sd"><ol class="w157hist">' + (r.history || []).map(function (h) { return '<li><span class="m">' + E(fmtDay(h.at)) + '</span> ' + E(h.note || h.type) + '</li>'; }).join('') + '</ol>' +
            (r.error ? '<div class="w152err">' + E(r.error) + '</div>' : '') + '<div class="w154acts">' + (c ? '<button class="w152btn sm ghost" data-w152open="' + E(r.contact_id) + '">' + I('people') + ' Open their page</button>' : '') +
            (r.status === 'active' || r.status === 'error' ? '<button class="w152btn sm ghost" data-w157stop="' + E(r.id) + '">' + I('x') + ' Stop it for them</button>' : '') + '</div></div>' : '') + '</div>';
      }).join('') + '</div>' : '<p class="m">Nobody has started it yet.</p>') + '</div>';
  }
  /* a contact's page: the automations they are in (wave157) */
  function contactAutosHtml(d) {
    return '<div class="w156more">' + (d.runs || []).map(function (r) {
      var a = autoById(r.automation_id);
      var what = r.status === 'active' ? (a ? runStepText(r, a) : 'In it now') : r.status === 'done' ? 'Finished ' + fmtDay(r.finished_at || r.started_at) : r.status === 'stopped' ? 'Stopped' : 'Needs a look';
      return '<div class="w152kv"><span>' + (a ? '<a href="#crm/automations/' + E(a.id) + '/people">' + E(a.name) + '</a>' : 'An automation') + '</span><span>' + lchip(RSTAT, r.status) + ' <span class="m">' + E(what) + '</span></span></div>';
    }).join('') + '</div>';
  }
  function loadRuns(id) {
    AU.runsFor = String(id); AU.runs = null;
    return Promise.resolve(db.from('crm_automation_runs').select('id,contact_id,status,step_id,next_at,is_test,history,error,started_at,finished_at').eq('automation_id', Number(id)).order('started_at', { ascending: false }).limit(500))
      .then(function (r) { if (AU.runsFor === String(id)) { AU.runs = (r && r.data) || []; if (S.ui.tab === 'automations') paint(); } });
  }

  function paintAutos(root) {
    var need = [];
    ['autos', 'astats', 'forms', 'templates', 'depts', 'tmembers'].forEach(function (k) { if (!S[k]) need.push(load(k)); });
    if (!MAIL.st) need.push(mailFn('settings').then(function (r) { if (r && !r.error) MAIL.st = r; else MAIL.st = MAIL.st || { settings: {} }; }));
    if (need.length) { root.innerHTML = statsHtml(S.contacts || []) + tabsHtml() + busy('Loading the automations\u2026'); Promise.all(need).then(function () { if (S.ui.tab === 'automations') paint(); }); return; }
    var html = statsHtml(S.contacts || []) + tabsHtml();
    if (AU.aid && AU.sub === 'people') {
      var ap = autoById(AU.aid);
      if (!ap) { root.innerHTML = html + '<div class="w152empty">That automation is not in the CRM.</div>'; return; }
      if (AU.runsFor !== String(ap.id)) loadRuns(ap.id);
      root.innerHTML = html + '<div class="w155grid">' + runsHtml(ap) + '</div>'; return;
    }
    if (AU.aid && !AU.a) { var k = autoById(AU.aid); if (k) AU.a = autoCopy(k); }
    if (AU.aid && !AU.a) { root.innerHTML = html + '<div class="w152empty">That automation is not in the CRM. <button class="w152mini" data-w157back="1">Back to the automations</button></div>'; return; }
    root.innerHTML = html + (AU.a ? '<div class="w155grid">' + autoEditorHtml() + autoSideHtml() + '</div>' : autosListHtml());
  }
  function openAutos(parts) {
    var id = parts[2] || null, sub = parts[3] || '';
    if (id !== AU.aid) { AU.a = null; AU.confirm = ''; AU.err = ''; AU.openRun = null; AU.prev = null; if (id) AU.msg = ''; }
    AU.aid = id; AU.sub = sub;
  }

  /* ---------- saving ---------- */
  function cleanSteps(steps) {
    return steps.map(function (s) {
      var o = {}; Object.keys(s).forEach(function (k) { if (k.charAt(0) !== '_') o[k] = s[k]; });
      if (s.type === 'tag') { o.add = csv(s._add); o.remove = csv(s._rem); }
      if (s.type === 'notify') o.to = csv(s._to).map(lower);
      if (s.type === 'wait' || s.type === 'wait_open') o.days = Number(s.days) || 0;
      if (s.type === 'task') o.due_days = Math.max(0, Math.round(Number(s.due_days) || 0));
      if (s.type === 'send' && s.email === 'template') { ['subject', 'preheader', 'headline', 'body', 'cta_label', 'cta_url'].forEach(function (k) { delete o[k]; }); }
      if (s.type === 'send' && s.from !== 'custom') { delete o.from_name; delete o.from_email; }
      return o;
    });
  }
  function autoRowOf(a) {
    var t = Object.assign({}, a.trigger || {});
    if (t.kind === 'form') t.form_id = t.form_id ? Number(t.form_id) : null; else delete t.form_id;
    if (t.kind !== 'tag') delete t.tag;
    if (t.kind === 'gift') { t.min_amount = t.min_amount === '' || t.min_amount == null ? null : Number(t.min_amount); t.first_only = !!t.first_only; } else { delete t.min_amount; delete t.first_only; }
    if (t.kind === 'serving') { t.days_before = Number(t.days_before) || 2; t.location = t.location || 'Montreal'; t.include_unconfirmed = !!t.include_unconfirmed; } else { delete t.days_before; delete t.location; delete t.include_unconfirmed; }
    return { name: String(a.name || '').trim(), description: String(a.description || '').trim() || null, trigger: t, steps: cleanSteps(a.steps), settings: Object.assign({}, a.settings || {}), updated_by: actor() };
  }
  function saveAuto() {
    var a = AU.a; if (!a) return Promise.resolve(null);
    AU.err = '';
    if (!String(a.name || '').trim()) { AU.err = 'Give the automation a name.'; paint(); return Promise.resolve(null); }
    var row = autoRowOf(a);
    AU.busy = 'Saving\u2026'; paint();
    var q = a.id ? db.from('crm_automations').update(row).eq('id', a.id).select().single() : db.from('crm_automations').insert(Object.assign({ status: 'draft', created_by: actor() }, row)).select().single();
    return Promise.resolve(q).then(function (r) {
      AU.busy = '';
      if (r && r.error) { AU.err = 'Not saved: ' + (r.error.message || r.error); paint(); return null; }
      var saved = (r && r.data) || null, id = (saved && saved.id) || a.id || null;
      return Promise.all([load('autos', true), load('astats', true)]).then(function () {
        if (id) { AU.aid = String(id); var k = autoById(id); AU.a = autoCopy(k || Object.assign({}, row, { id: id, status: a.status })); try { history.replaceState(null, '', '#crm/automations/' + id); } catch (e) { /* fine */ } }
        return id;
      });
    }).catch(function (e) { AU.busy = ''; AU.err = String((e && e.message) || e); paint(); return null; });
  }
  function checkAndConfirm() {
    saveAuto().then(function (id) {
      if (!id) return;
      var a = AU.a;
      return Promise.resolve(db.rpc('crm_automation_problems', { p_trigger: autoRowOf(a).trigger, p_steps: autoRowOf(a).steps })).then(function (r) {
        var ps = (r && r.data) || [];
        AU.problems = ps; AU.confirm = ps.length ? 'problems' : 'on'; paint();
      });
    });
  }
  function setAutoStatus(status) {
    var a = AU.a; if (!a || !a.id) return;
    AU.busy = status === 'on' ? 'Turning it on\u2026' : 'Pausing it\u2026'; AU.confirm = ''; paint();
    Promise.resolve(db.from('crm_automations').update({ status: status, updated_by: actor() }).eq('id', a.id).select().single()).then(function (r) {
      AU.busy = '';
      if (r && r.error) { AU.err = String(r.error.message || r.error).replace(/^.*?Not ready to turn on:/, 'Not ready to turn on:'); paint(); return; }
      AU.msg = status === 'on' ? 'On: ' + trigText(a.trigger).replace(/^When/, 'when') + ', that person starts it.' : 'Paused: nobody new starts it, and the people in it wait where they are.';
      Promise.all([load('autos', true), load('astats', true)]).then(function () { AU.a = autoCopy(autoById(a.id)); paint(); });
    });
  }
  function tryAuto() {
    saveAuto().then(function (id) {
      if (!id) return;
      AU.busy = 'Starting a test run on your own contact\u2026'; paint();
      Promise.resolve(db.rpc('crm_automation_try', { p_automation_id: Number(id) })).then(function (r) {
        AU.busy = '';
        if (r && r.error) { AU.err = String(r.error.message || r.error); paint(); return; }
        AU.msg = 'A test run started on your own contact: its emails come to ' + myEmail() + ' within a few minutes, a day of waiting counts as a minute, and tags, tasks and notices are only described. Follow it under People.';
        load('astats', true).then(function () { paint(); });
      });
    });
  }
  function newAuto() {
    AU.busy = 'Making a draft\u2026'; paint();
    var row = { name: 'New automation', status: 'draft', trigger: { kind: 'form', form_id: null }, steps: [], settings: {}, created_by: actor(), updated_by: actor() };
    Promise.resolve(db.from('crm_automations').insert(row).select().single()).then(function (r) {
      AU.busy = '';
      if (r && r.error) { AU.err = 'The draft could not be made: ' + (r.error.message || r.error); paint(); return; }
      load('autos', true).then(function () { AU.msg = 'Draft made. Pick what starts it, add the steps, then try it on yourself.'; go('#crm/automations/' + r.data.id); });
    });
  }
  function delAuto() {
    var a = AU.a; if (!a || !a.id) return;
    Promise.resolve(db.from('crm_automations').delete().eq('id', a.id)).then(function (r) {
      AU.confirm = ''; AU.msg = r && r.error ? 'Not deleted: ' + (r.error.message || r.error) : 'Draft deleted.'; AU.a = null;
      load('autos', true).then(function () { go('#crm/automations'); paint(); });
    });
  }
  function stopRun(id) {
    Promise.resolve(db.rpc('crm_automation_stop', { p_run_id: Number(id) })).then(function (r) {
      AU.msg = r && r.error ? '' : 'Stopped for them.'; AU.err = r && r.error ? 'Not stopped: ' + (r.error.message || r.error) : '';
      Promise.all([loadRuns(AU.aid), load('astats', true)]).then(function () { paint(); });
    });
  }
  function previewStep(i) {
    var a = AU.a, s = a && a.steps[i]; if (!s) return;
    var vars = Object.assign({}, ASAMPLE), body = {};
    if (s.email === 'template') body = { template_key: s.template_key, kind: s.kind, vars: vars };
    else body = { template_key: 'newsletter', kind: s.kind, subject: s.subject || '(no subject yet)', preheader: s.preheader || '', vars: Object.assign(vars, { headline: String(s.headline || ''), body_text: String(s.body || ''), body_html: bodyHtml(s.body), cta_label: String(s.cta_label || '').trim() || 'Visit welfareavenue.com', cta_url: String(s.cta_url || '').trim() || 'https://welfareavenue.com' }) };
    if (s.from === 'custom') { body.from_name = s.from_name; body.from_email = s.from_email; }
    var me = (S.contacts || []).filter(function (c) { return c.emails.map(lower).indexOf(myEmail()) >= 0; })[0];
    if (me) body.contact_id = me.id;
    AU.prev = { busy: true }; AU.prevFor = a.id; paint();
    mailFn('preview', body).then(function (r) { AU.prev = r && r.error ? { err: 'The preview did not come back: ' + r.error } : r; paint(); });
  }

  /* ---------- styles ---------- */
  var css157 = document.createElement('style'); css157.id = 'w157css';
  css157.textContent = ''
    + '.w157step{border:1px solid rgba(16,63,57,.14);border-radius:14px;padding:12px;margin:0 0 10px;background:rgba(16,63,57,.025);display:flex;flex-direction:column;gap:6px;}.w157step .w152in,.w157step .w152sel{width:100%;box-sizing:border-box;max-width:none;}'
    + '.w157sh{display:grid;grid-template-columns:auto minmax(0,1fr) auto auto auto auto;align-items:center;gap:6px;}.w157sh>b{font-family:' + HEAD + ';font-size:18px;color:' + GREEN + ';min-width:18px;}.w157st{display:flex;align-items:center;gap:6px;font-weight:600;color:' + GREEN + ';min-width:0;}'
    + '.w157sh .w152mini{padding:5px 7px;}.w157step .w155lb{margin:0;}.w157step textarea{min-height:64px;}.w157step textarea[data-w157s="body"]{min-height:140px;}.w157inline{display:grid;grid-template-columns:140px minmax(0,1fr);gap:10px;align-items:end;}'
    + '.w157pair{display:grid;grid-template-columns:1fr 1fr;gap:8px;}.w157adds{display:flex;flex-wrap:wrap;gap:6px;margin:4px 0 14px;}.w157ck{align-self:end;}'
    + '.w157ul,.w157ol,.w157hist{margin:6px 0 10px 18px;padding:0;}.w157ul li,.w157ol li,.w157hist li{margin:0 0 6px;font-size:13.5px;line-height:1.45;}.w157tr{font-weight:600;color:' + GREEN + ';margin:0 0 4px;font-size:13.5px;}'
    + '.w157next{display:block;font-size:12.5px;font-weight:400;overflow:hidden;text-overflow:ellipsis;}'
    + '@media (max-width:700px){.w157sh{grid-template-columns:auto minmax(0,1fr) auto auto auto;}.w157sh .w156sp{display:none;}.w157inline,.w157pair{grid-template-columns:1fr;}}';
  document.head.appendChild(css157);

  /* ---------- wiring ---------- */
  function stepAt(el) { var box = el.closest('[data-w157si]'); return box ? Number(box.getAttribute('data-w157si')) : -1; }
  document.addEventListener('click', function (e) {
    var t = e.target, el; if (!t || !t.closest || !t.closest('.w152root')) return;
    var a = AU.a;
    if ((el = t.closest('[data-w157new]'))) { e.preventDefault(); newAuto(); return; }
    if ((el = t.closest('[data-w157open]'))) { e.preventDefault(); AU.msg = ''; AU.err = ''; go('#crm/automations/' + el.getAttribute('data-w157open')); return; }
    if ((el = t.closest('[data-w157people]'))) { e.preventDefault(); AU.err = ''; go('#crm/automations/' + el.getAttribute('data-w157people') + '/people'); return; }
    if ((el = t.closest('[data-w157back]'))) { e.preventDefault(); AU.a = null; AU.confirm = ''; AU.prev = null; go('#crm/automations'); return; }
    if ((el = t.closest('[data-w157run]'))) { e.preventDefault(); var rid = el.getAttribute('data-w157run'); AU.openRun = AU.openRun === rid ? null : rid; paint(); return; }
    if ((el = t.closest('[data-w157tests]'))) { e.preventDefault(); AU.showTests = !AU.showTests; paint(); return; }
    if ((el = t.closest('[data-w157stop]'))) { e.preventDefault(); el.disabled = true; stopRun(el.getAttribute('data-w157stop')); return; }
    if (!a) return;
    if ((el = t.closest('[data-w157add]'))) { e.preventDefault(); a.steps.push(newStep(el.getAttribute('data-w157add'), a)); paint(); var cards = document.querySelectorAll('#crm .w157step'); if (cards.length) cards[cards.length - 1].scrollIntoView({ block: 'center' }); return; }
    if ((el = t.closest('[data-w157mv]'))) { e.preventDefault(); var i = stepAt(el), j = i + Number(el.getAttribute('data-w157mv')); if (i < 0 || j < 0 || j >= a.steps.length) return; var tmp = a.steps[i]; a.steps[i] = a.steps[j]; a.steps[j] = tmp; paint(); return; }
    if ((el = t.closest('[data-w157dela]'))) { e.preventDefault(); AU.confirm = 'delete'; paint(); return; }
    if ((el = t.closest('[data-w157del]'))) { e.preventDefault(); var k = stepAt(el); if (k >= 0) a.steps.splice(k, 1); paint(); return; }
    if ((el = t.closest('[data-w157pv]'))) { e.preventDefault(); previewStep(Number(el.getAttribute('data-w157pv'))); return; }
    if ((el = t.closest('[data-w157pvclose]'))) { e.preventDefault(); AU.prev = null; paint(); return; }
    if ((el = t.closest('[data-w157save]'))) { e.preventDefault(); saveAuto().then(function (id) { if (id) { AU.msg = 'Saved.'; paint(); } }); return; }
    if ((el = t.closest('[data-w157on]'))) { e.preventDefault(); checkAndConfirm(); return; }
    if ((el = t.closest('[data-w157onok]'))) { e.preventDefault(); el.disabled = true; setAutoStatus('on'); return; }
    if ((el = t.closest('[data-w157pause]'))) { e.preventDefault(); setAutoStatus('paused'); return; }
    if ((el = t.closest('[data-w157try]'))) { e.preventDefault(); tryAuto(); return; }
    if ((el = t.closest('[data-w157delok]'))) { e.preventDefault(); delAuto(); return; }
    if ((el = t.closest('[data-w157no]'))) { e.preventDefault(); AU.confirm = ''; paint(); return; }
  });
  function onAuto157(e) {
    var t = e.target, a = AU.a; if (!a || !t || !t.closest || !t.closest('.w152root')) return;
    var key, i, s;
    if (t.hasAttribute('data-w157k')) { a[t.getAttribute('data-w157k')] = t.value; return; }
    if (t.hasAttribute('data-w157set')) { a.settings[t.getAttribute('data-w157set')] = t.type === 'checkbox' ? t.checked : t.value; return; }
    if (t.hasAttribute('data-w157t')) {
      key = t.getAttribute('data-w157t'); a.trigger[key] = t.type === 'checkbox' ? t.checked : t.value;
      if (key === 'kind' && e.type === 'change') { a.trigger = { kind: t.value }; if (t.value === 'serving') { a.trigger.days_before = 2; a.trigger.location = 'Montreal'; } paint(); }
      else if (e.type === 'change') paint();
      return;
    }
    if (t.hasAttribute('data-w157s')) {
      i = stepAt(t); if (i < 0) return; s = a.steps[i]; key = t.getAttribute('data-w157s');
      if (key === '_email') { if (t.value === 'write') { s.email = 'write'; delete s.template_key; } else { s.email = 'template'; s.template_key = t.value.slice(4); } paint(); return; }
      s[key] = t.type === 'checkbox' ? t.checked : t.value;
      if (e.type === 'change' && (t.tagName === 'SELECT')) paint();
    }
  }
  document.addEventListener('input', function (e) { var t = e.target; if (t && t.tagName !== 'SELECT' && t.type !== 'checkbox') onAuto157(e); });
  document.addEventListener('change', function (e) { var t = e.target; if (t && (t.tagName === 'SELECT' || t.type === 'checkbox')) onAuto157(e); });
  /* ======================= Gifts by hand and receipts (wave158a, 28/09/26) =======================
     The first part of step 6 (gifts and receipts). Staff record the gifts that come without a platform (cheques,
     e-transfers, cash), say what kind of money it is (a donation, a registration or a ticket with the value the person
     received, a sponsorship, a gift in kind), note a tribute, and see for every gift whether a CRA receipt is done, due
     or not possible and why (crm_gift_receipts_v). The receipt settings (the charity's name and address as on file with
     the CRA, where receipts are issued, the numbering, the signatory) are kept by admins; the Hub shows a sample receipt
     with every field the CRA requires and lists the receipts due for a tax year. Issuing official receipts (the number,
     the PDF, the email) comes in wave158b once the treasurer confirms the settings: receipt_mode stays off. */
  var GKIND = { donation: ['Donation', GREEN], registration: ['Registration', TEAL], ticket: ['Ticket', PURPLE], sponsorship: ['Sponsorship', '#B9851B'], in_kind: ['In kind', '#3A6EA5'], other: ['Other', MUTED] };
  var GMETH = [['', 'Not recorded'], ['cheque', 'Cheque'], ['etransfer', 'E-transfer'], ['cash', 'Cash'], ['card', 'Card'], ['online', 'Online'], ['other', 'Other']];
  var RSTS = { receipted: ['Receipted', GREEN], due: ['Receipt due', '#B9851B'], platform: ['Zeffy receipts it', TEAL], no: ['No receipt', MUTED] };
  var GF = { view: '', cfg: null, cfgErr: '', year: null, msg: '', err: '', sample: null };
  LOADERS.grcpt = function () { return pageAll(function (a, b) { return db.from('crm_gift_receipts_v').select('*').order('gift_id', { ascending: true }).range(a, b); }, function (r) { return String(r.gift_id); }); };
  function rcptFor(id) { return (S.grcpt || []).filter(function (r) { return String(r.gift_id) === String(id); })[0] || null; }
  function giftById(id) { return (S.gifts || []).filter(function (g) { return String(g.id) === String(id); })[0] || null; }
  /* receipts always show the cents */
  function cents(n) { var v = Number(n) || 0; try { return v.toLocaleString('en-CA', { style: 'currency', currency: 'CAD', minimumFractionDigits: 2, maximumFractionDigits: 2 }); } catch (e) { return '$' + v.toFixed(2); } }
  function eligibleOf(g) { return Math.max(0, (Number(g.amount) || 0) - (Number(g.advantage_amount) || 0)); }
  /* the same rule as crm_gift_receipts_v, for the form while it is being filled in */
  function receiptRule(g) {
    var amt = Number(g.amount) || 0, adv = Number(g.advantage_amount) || 0;
    if (g.receipt_number) return ['receipted', 'Receipt ' + g.receipt_number];
    if (!g.contact_id) return ['no', 'Pick the donor'];
    if (g.kind === 'sponsorship') return ['no', 'A sponsorship gets an invoice or a thank-you, not a tax receipt'];
    if (g.kind === 'other') return ['no', 'Not a gift'];
    if (amt <= 0) return ['no', 'No amount'];
    if (adv > 0.8 * amt) return ['no', 'What they received is worth more than 80% of the amount'];
    if (g.kind === 'in_kind' && !String(g.in_kind_desc || '').trim()) return ['no', 'Describe the gift in kind first'];
    if (lower(g.platform) === 'zeffy') return ['platform', 'Zeffy issues the receipt'];
    return ['due', 'A receipt is due for ' + cents(eligibleOf(g))];
  }
  function gchip(map, k) { var d = map[k] || [k || '?', MUTED]; return '<span class="w154chip" style="background:' + d[1] + '17;color:' + d[1] + '"><i style="background:' + d[1] + '"></i>' + E(d[0]) + '</span>'; }

  /* ---------- the gift form (a sheet) ---------- */
  function stripeSub(x) { /* wave161: an online gift from the donation page */
    var link = stripeLink(x), bits = [];
    if (x.fee != null) bits.push('Stripe kept ' + cents(x.fee) + (x.net_amount != null ? ', ' + cents(x.net_amount) + ' reached Welfare Avenue' : ''));
    if (Number(x.refunded_amount) > 0) bits.push(cents(x.refunded_amount) + ' refunded' + (x.refunded_at ? ' on ' + fmtDay(x.refunded_at) : '') + (Number(x.amount) > 0 ? ', ' + cents(x.amount) + ' kept' : ''));
    return (x.recurring ? 'A monthly payment' : 'An online gift') + ' through the Hub\u2019s donation page, paid on Stripe: the amount, the date and the donor stay as Stripe recorded them.' +
      (bits.length ? ' ' + E(bits.join('; ')) + '.' : '') + (link ? ' <a href="' + E(link) + '" target="_blank" rel="noopener">Open it in Stripe ' + I('ext') + '</a>' : '');
  }
  function giftForm(id, contactId) {
    var g = id ? giftById(id) : null, isNew = !g, hub = !g || lower(g.platform) === 'hub';
    var x = g || { contact_id: contactId || null, amount: '', donated_at: today(), kind: 'donation', method: 'cheque', campaign: '', designation: '', advantage_amount: 0, advantage_desc: '', in_kind_desc: '', appraiser: '', tribute_kind: '', tribute_name: '', notes: '', platform: 'hub' };
    var c = x.contact_id ? contact(x.contact_id) : null;
    var donor = c ? '<div class="w158donor">' + avatar(c) + '<b>' + E(c.full_name) + '</b><span class="m">' + E(c.emails[0] || '') + '</span></div>'
      : '<input data-f="donor" list="w158donors" placeholder="Type a name or an email" autocomplete="off"><datalist id="w158donors">' + (S.contacts || []).filter(function (k) { return !/^\(no name\)$/i.test(k.full_name || ''); }).slice(0, 3000).map(function (k) { return '<option value="' + E(k.full_name + (k.emails[0] ? ' \u00b7 ' + k.emails[0] : '') + ' (#' + k.id + ')') + '"></option>'; }).join('') + '</datalist>';
    var kinds = Object.keys(GKIND).map(function (k) { return [k, GKIND[k][0]]; });
    var ro = hub ? '' : ' disabled';
    var html = '<h2>' + (isNew ? 'Record a gift' : 'A gift of ' + E(money(x.amount))) + '</h2>' +
      '<div class="sub">' + (isNew ? 'A cheque, an e-transfer or cash that came in outside Zeffy and Keela. The thank-you automation starts on its own if it is on.' : hub ? 'Recorded in the Hub' + (x.created_by ? ' by ' + E(x.created_by) : '') + '.' : lower(x.platform) === 'stripe' ? stripeSub(x) : 'From ' + E(platName(x.platform)) + ': the amount, the date and the donor stay as ' + E(platName(x.platform)) + ' recorded them.') + '</div>' +
      '<div class="w152form" data-w158gift="' + E(id || 'new') + '">' +
      field('Donor', donor, true) +
      field('Amount ($)', '<input data-f="amount" type="number" step="0.01" min="0" value="' + E(x.amount) + '"' + ro + '>') + field('Date received', '<input data-f="donated_at" type="date" value="' + E(dayOf(x.donated_at) || today()) + '"' + ro + '>') +
      field('What kind of money', sel('kind', kinds, x.kind || 'donation')) + field('How it came', sel('method', GMETH, x.method || '')) +
      field('Campaign', inp('campaign', x.campaign, 'Rally Paper 2026, the Sunday meals')) + field('Designation', inp('designation', x.designation, 'Toronto, the kitchen')) +
      '<div class="full w158adv"' + (x.kind === 'registration' || x.kind === 'ticket' || x.kind === 'other' || Number(x.advantage_amount) ? '' : ' hidden') + '>' +
        field('What they received ($)', '<input data-f="advantage_amount" type="number" step="0.01" min="0" value="' + E(Number(x.advantage_amount) || 0) + '">', false, 'the meal, the ticket, playing in the tournament') +
        field('Described as', inp('advantage_desc', x.advantage_desc, 'Dinner at the gala')) + '</div>' +
      '<div class="full w158ink"' + (x.kind === 'in_kind' ? '' : ' hidden') + '>' + field('The gift in kind', inp('in_kind_desc', x.in_kind_desc, '40 winter coats'), true, 'the amount is its fair market value') +
        field('Appraised by (optional)', inp('appraiser', x.appraiser, 'Name and address')) + '</div>' +
      field('In honour or memory of', sel('tribute_kind', [['', 'No'], ['honour', 'In honour of'], ['memory', 'In memory of']], x.tribute_kind || '')) + field('Their name', inp('tribute_name', x.tribute_name, 'Their name')) +
      field('Notes', area('notes', x.notes, 'Cheque number, who dropped it off, anything the treasurer should know'), true) +
      '<div class="note full w158rule" data-w158rule>' + E(receiptRule(x)[1]) + '</div>' +
      '</div><div class="w152foot"><span class="w152err" data-w152err></span>' +
      (!isNew && hub && amAdmin() ? '<button class="w152btn ghost" data-w158del="' + E(id) + '">' + I('trash') + ' Delete</button>' : '') +
      (!isNew ? '<button class="w152btn ghost" data-w158sample="' + E(id) + '">' + I('note') + ' Sample receipt</button>' : '') +
      '<button class="w152btn ghost" data-w152close="1">Cancel</button><button class="w152btn" data-w158save="' + E(id || 'new') + '">' + I('check') + (isNew ? ' Record it' : ' Save') + '</button></div>';
    openSheet(html, 'gift:' + (id || 'new'), true);
  }
  function giftFormValues(box) {
    var v = {}; box.querySelectorAll('[data-f]').forEach(function (el) { v[el.getAttribute('data-f')] = el.value; });
    return v;
  }
  function donorFrom(v, box) {
    var id = box.getAttribute('data-w158gift'), g = id !== 'new' ? giftById(id) : null;
    if (g) return g.contact_id;
    var fixed = box.querySelector('.w158donor') ? GF.formContact : null; if (fixed) return fixed;
    var m = /\(#(\d+)\)\s*$/.exec(String(v.donor || '')); return m ? Number(m[1]) : null;
  }
  function refreshRule(box) {
    var v = giftFormValues(box), id = box.getAttribute('data-w158gift'), g = id !== 'new' ? giftById(id) : {};
    var x = Object.assign({}, g, v, { contact_id: donorFrom(v, box) || (g && g.contact_id) });
    var el = box.querySelector('[data-w158rule]'); if (el) el.textContent = receiptRule(x)[1];
    var adv = box.querySelector('.w158adv'); if (adv) adv.hidden = !(v.kind === 'registration' || v.kind === 'ticket' || v.kind === 'other' || Number(v.advantage_amount));
    var ink = box.querySelector('.w158ink'); if (ink) ink.hidden = v.kind !== 'in_kind';
  }
  function saveGift(btn) {
    var sh = document.getElementById('w152sheet'), box = sh && sh.querySelector('[data-w158gift]'); if (!box) return;
    var id = box.getAttribute('data-w158gift'), g = id !== 'new' ? giftById(id) : null, hub = !g || lower(g.platform) === 'hub';
    var v = giftFormValues(box), err = sh.querySelector('[data-w152err]');
    var say = function (m) { if (err) err.textContent = m; };
    var cid = donorFrom(v, box), amt = Number(v.amount), adv = Number(v.advantage_amount) || 0;
    if (!cid) { say('Pick the donor from the list (type a name or an email).'); return; }
    if (hub && !(amt > 0)) { say('The amount must be more than $0.'); return; }
    if (hub && (!v.donated_at || v.donated_at > today())) { say('The date received is today or earlier.'); return; }
    if (adv < 0 || (hub && adv > amt) || (!hub && adv > Number(g.amount))) { say('What they received cannot be more than the amount.'); return; }
    if (v.kind === 'in_kind' && !String(v.in_kind_desc || '').trim()) { say('Describe the gift in kind.'); return; }
    if (v.tribute_kind && !String(v.tribute_name || '').trim()) { say('Whose honour or memory is it in?'); return; }
    var row = { kind: v.kind, method: v.method || null, campaign: String(v.campaign || '').trim() || null, designation: String(v.designation || '').trim() || null,
      advantage_amount: adv, advantage_desc: String(v.advantage_desc || '').trim() || null, in_kind_desc: v.kind === 'in_kind' ? String(v.in_kind_desc || '').trim() : null,
      appraiser: v.kind === 'in_kind' ? (String(v.appraiser || '').trim() || null) : null, tribute_kind: v.tribute_kind || null, tribute_name: v.tribute_kind ? String(v.tribute_name || '').trim() : null,
      notes: String(v.notes || '').trim() || null, updated_by: actor(), updated_at: new Date().toISOString() };
    if (hub) { row.amount = Math.round(amt * 100) / 100; row.donated_at = v.donated_at + 'T12:00:00-04:00'; row.currency = 'CAD'; }
    if (btn) btn.disabled = true;
    var q = g ? db.from('crm_donations').update(row).eq('id', g.id).select().single()
      : db.from('crm_donations').insert(Object.assign({ contact_id: cid, platform: 'hub', created_by: actor(), receipt_eligible: row.kind !== 'sponsorship' && row.kind !== 'other' }, row)).select().single();
    Promise.resolve(q).then(function (r) {
      if (btn) btn.disabled = false;
      if (r && r.error) { say('Not saved: ' + (r.error.message || r.error)); return; }
      GF.msg = g ? 'Saved.' : 'Recorded: ' + cents(row.amount) + ' from ' + ((contact(cid) || {}).full_name || 'the donor') + '.';
      Promise.all([load('gifts', true), load('grcpt', true)]).then(function () { closeSheet(true); if (S.detail[String(cid)]) delete S.detail[String(cid)]; if (S.ui.tab === 'gifts') paint(); });
    });
  }
  function delGift(id) {
    Promise.resolve(db.from('crm_donations').delete().eq('id', Number(id))).then(function (r) {
      GF.msg = r && r.error ? 'Not deleted: ' + (r.error.message || r.error) : 'Deleted.';
      Promise.all([load('gifts', true), load('grcpt', true)]).then(function () { closeSheet(true); paint(); });
    });
  }

  /* ---------- a sample receipt ---------- */
  function sampleReceipt(id) {
    openSheet('<h2>Sample receipt</h2>' + busy('Putting it together\u2026'), 'rcpt:' + id);
    Promise.resolve(db.rpc('crm_receipt_sample', { p_gift_id: Number(id) })).then(function (r) {
      if (S.sheet !== 'rcpt:' + id) return;
      if (!r || r.error || !r.data) { openSheet('<h2>Sample receipt</h2><div class="w152err">' + E((r && r.error && (r.error.message || r.error)) || 'It did not come back.') + '</div>', 'rcpt:' + id); return; }
      openSheet(receiptHtml(r.data), 'rcpt:' + id);
    });
  }
  function receiptHtml(s) {
    var line = function (l, v, warn) { return '<div class="w158rl"><span>' + E(l) + '</span><b' + (warn ? ' class="w158miss"' : '') + '>' + E(v) + '</b></div>'; };
    var ws = (s.warnings || []);
    return '<h2>Sample receipt</h2><div class="sub">What the Hub\u2019s receipt for this gift would say, with every field the CRA asks for. It is not numbered, kept or sent: issuing receipts from the Hub starts once the treasurer confirms the settings.</div>' +
      (ws.length ? '<div class="w155cf test"><b>Before this could be a real receipt:</b><ul class="w157ul">' + ws.map(function (w) { return '<li>' + E(w) + '</li>'; }).join('') + '</ul></div>' : '') +
      '<div class="w158rc"><div class="w158wm" aria-hidden="true">SAMPLE</div>' +
      '<div class="w158rh"><b>' + E(s.charity_name) + '</b><span>' + E(s.charity_address || '') + '</span><span>Charitable registration number ' + E(s.charity_number || '') + '</span></div>' +
      '<div class="w158rt">Official receipt for income tax purposes</div>' +
      line('Receipt number', (s.serial || '') + ' (sample)') + line('Issued at', s.location) + line('Date issued', s.issued_date) +
      line('Received from', s.donor_name || 'no name on file', !s.donor_name) + line('Address', s.donor_address || 'no address on file', !s.donor_address) +
      line('Date the gift was received', s.gift_date) +
      (s.kind === 'in_kind' ? line('The gift', s.in_kind_desc || '') + (s.appraiser ? line('Appraised by', s.appraiser) : '') : '') +
      line(s.kind === 'in_kind' ? 'Fair market value of the gift' : 'Total amount received', cents(s.amount)) +
      line('Value of the advantage', cents(s.advantage_amount) + (s.advantage_desc ? ' (' + s.advantage_desc + ')' : '')) +
      line('Eligible amount of the gift for tax purposes', cents(s.eligible_amount)) +
      '<div class="w158sig"><span class="w158line"></span><span>' + E(s.signatory_name ? s.signatory_name + (s.signatory_title ? ', ' + s.signatory_title : '') : 'Authorized signature (no signatory yet)') + '</span></div>' +
      '<div class="w158cra">' + E(s.cra) + '</div></div>' +
      '<div class="m" data-w158bsay role="status"></div>' +
      '<div class="w152foot"><button class="w152btn ghost" data-w152close="1">Close</button><button class="w152btn ghost" data-w158bpdfsample="1">' + I('note') + ' Download the sample (PDF)</button><button class="w152btn" data-w158print="1">' + I('note') + ' Print the sample</button></div>';
  }

  /* ---------- receipts: settings, the year's receipts due ---------- */
  function loadRcfg() {
    return Promise.resolve(db.rpc('crm_receipt_config')).then(function (r) { GF.cfg = (r && r.data) || {}; GF.cfgErr = r && r.error ? String(r.error.message || r.error) : ''; }, function () { GF.cfg = {}; });
  }
  function receiptsHtml() {
    var cfg = GF.cfg || {}, admin = !!cfg.is_admin;
    var years = {}; (S.grcpt || []).forEach(function (r) { if (r.tax_year) years[r.tax_year] = 1; });
    var ys = Object.keys(years).sort().reverse(), yr = GF.year || String(new Date(today() + 'T12:00:00').getFullYear());
    if (ys.indexOf(yr) < 0) ys.unshift(yr);
    var due = (S.grcpt || []).filter(function (r) { return String(r.tax_year) === String(yr) && r.receipt_status === 'due'; });
    var by = {}; due.forEach(function (r) { var k = String(r.contact_id); (by[k] = by[k] || { id: r.contact_id, gifts: [], total: 0 }); by[k].gifts.push(r); by[k].total += Number(r.eligible_amount) || 0; });
    var donors = Object.keys(by).map(function (k) { return by[k]; }).sort(function (a, b) { return b.total - a.total; });
    var total = due.reduce(function (a, r) { return a + (Number(r.eligible_amount) || 0); }, 0);
    var done = (S.grcpt || []).filter(function (r) { return String(r.tax_year) === String(yr) && r.receipt_status === 'receipted'; }).length;
    var set = function (k, label, ph, hint) { return '<label class="w155lb">' + E(label) + (hint ? ' <span class="m">' + E(hint) + '</span>' : '') + '<input class="w152in" data-w158cfg="' + k + '" value="' + E(cfg[k] || '') + '" placeholder="' + E(ph || '') + '"' + (admin ? '' : ' disabled') + '></label>'; };
    return '<div class="w155grid"><div class="w154card"><h3>' + I('note') + ' Receipt settings</h3>' +
      '<p class="m">What every CRA receipt from the Hub will carry. Keela\u2019s 55 receipts stay the legal copies; the numbering here must not repeat Keela\u2019s KEE numbers.</p>' +
      (GF.err ? '<div class="w152err">' + E(GF.err) + '</div>' : '') + (GF.msg ? '<div class="w154msg">' + E(GF.msg) + '</div>' : '') +
      (RB.err ? '<div class="w152err">' + E(RB.err) + '</div>' : '') + (RB.msg ? '<div class="w154msg">' + E(RB.msg) + '</div>' : '') + rbStatusHtml(cfg) +
      set('receipt_charity_name', 'Charity name', 'Welfare Avenue', 'as on file with the CRA') + set('receipt_charity_address', 'Charity address', '', 'as on file with the CRA') +
      '<div class="w154kv"><span>Registration number</span><span>' + E(cfg.mail_charity_number || '') + '</span></div>' +
      set('receipt_location', 'Where receipts are issued', 'Montreal, Quebec') +
      '<div class="w155two">' + set('receipt_prefix', 'Number prefix', 'WA-2026-') + set('receipt_next_number', 'Next number', '1') + '</div>' +
      '<div class="w155two">' + set('receipt_signatory_name', 'Signed by', 'Full name') + set('receipt_signatory_title', 'Their title', 'Treasurer') + '</div>' +
      (admin ? '<div class="w154acts"><button class="w152btn" data-w158cfgsave="1">' + I('check') + ' Save the settings</button></div>' : '<p class="m">Only an admin changes these.</p>') + '</div>' +
      '<div class="w154card"><h3>' + I('heart') + ' Receipts due for ' + E(yr) + ' <select class="w152sel w158yr" data-w158year aria-label="Tax year">' + ys.map(function (y) { return '<option' + (y === yr ? ' selected' : '') + '>' + E(y) + '</option>'; }).join('') + '</select></h3>' +
      '<p class="m">Receipts follow the donor\u2019s tax year (January to December), not the fiscal year. The year-end run gives each donor one receipt for the year.</p>' +
      '<div class="w152stats"><div class="w152st"><b>' + E(cents(total)) + '</b><span>eligible, ' + plural(due.length, 'gift', 'gifts') + '</span></div><div class="w152st"><b>' + donors.length + '</b><span>' + (donors.length === 1 ? 'donor' : 'donors') + ' to receipt</span></div><div class="w152st"><b>' + done + '</b><span>already receipted</span></div></div>' +
      rbRunHtml(donors.length, yr) +
      (donors.length ? '<div class="w156fl">' + donors.map(function (d) {
        var c = contact(d.id), noAddr = c && !String(c.address || '').trim();
        return '<div class="w156fr"><span><a href="#crm/c/' + E(d.id) + '">' + E(c ? c.full_name : 'Contact ' + d.id) + '</a><span class="m"> \u00b7 ' + plural(d.gifts.length, 'gift', 'gifts') + (noAddr ? ' \u00b7 <span class="w156warn">no address on file</span>' : '') + '</span></span><span>' + E(cents(d.total)) + '</span>' +
          '<button class="w152mini" data-w158sample="' + E(d.gifts[0].gift_id) + '">Sample</button>' + rbDueActions(d, yr) + '</div>';
      }).join('') + '</div>' : '<p class="m">No receipt is due for ' + E(yr) + '.</p>') +
      '<div class="w154acts"><button class="w152btn ghost" data-w152go="#crm/gifts">Back to the gifts</button></div></div>' + rbIssuedHtml() + '</div>';
  }
  function saveRcfg() {
    var p = {}; document.querySelectorAll('#crm [data-w158cfg]').forEach(function (el) { p[el.getAttribute('data-w158cfg')] = el.value; });
    GF.err = ''; GF.msg = '';
    Promise.resolve(db.rpc('crm_receipt_config_set', { p: p })).then(function (r) {
      if (r && r.error) GF.err = 'Not saved: ' + (r.error.message || r.error); else { GF.cfg = r.data || GF.cfg; GF.msg = 'Saved.'; }
      paint();
    });
  }

  /* ---------- styles ---------- */
  var css158 = document.createElement('style'); css158.id = 'w158css';
  css158.textContent = ''
    + '.w158row .amt .m{font-weight:400;font-size:12.5px;line-height:1.35;}.w158row{cursor:pointer;}.w158row:focus-visible{outline:2px solid ' + GOLD + ';outline-offset:-2px;}'
    + '.w158donor{display:flex;align-items:center;gap:8px;min-width:0;}.w158donor .m{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}'
    + '.w158adv,.w158ink{display:grid;grid-template-columns:1fr 1fr;gap:10px 14px;}.w158adv[hidden],.w158ink[hidden]{display:none;}.w158rule{font-weight:600;}'
    + '.w158rc{position:relative;overflow:hidden;border:1px solid rgba(16,63,57,.2);border-radius:12px;padding:18px 20px;margin:12px 0;background:' + CREAM + ';color:' + INK + ';}'
    + '.w158wm{position:absolute;top:38%;left:-10%;right:-10%;text-align:center;transform:rotate(-18deg);font-family:' + HEAD + ';font-size:84px;letter-spacing:10px;color:rgba(179,64,47,.12);pointer-events:none;}'
    + '.w158rh{display:flex;flex-direction:column;gap:2px;font-size:13px;margin-bottom:10px;}.w158rh b{font-family:' + HEAD + ';font-size:22px;letter-spacing:.5px;text-transform:uppercase;color:' + GREEN + ';}'
    + '.w158rt{font-weight:700;text-transform:uppercase;letter-spacing:1px;font-size:12.5px;color:' + GREEN + ';border-top:2px solid ' + GOLD + ';padding-top:8px;margin:6px 0 8px;}'
    + '.w158rl{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.2fr);gap:10px;padding:5px 0;border-bottom:1px dashed rgba(16,63,57,.12);font-size:13.5px;}.w158rl b{font-weight:600;}.w158miss{color:' + FLAG + ';}'
    + '.w158sig{display:flex;flex-direction:column;gap:4px;margin:18px 0 6px;font-size:13px;}.w158line{display:block;width:220px;border-bottom:1px solid ' + INK + ';height:26px;}.w158cra{font-size:12px;color:' + MUTED + ';margin-top:8px;}'
    + '.w158yr{display:inline-block;width:auto;margin-left:8px;vertical-align:middle;}'
    + '@media (max-width:700px){.w158adv,.w158ink{grid-template-columns:1fr;}.w158rl{grid-template-columns:1fr;gap:2px;}}'
    + '@media print{body *{visibility:hidden !important;}#w152sheet .w158rc,#w152sheet .w158rc *{visibility:visible !important;}#w152sheet .w158rc{position:fixed;left:0;top:0;width:100%;border:none;}}';
  document.head.appendChild(css158);

  /* ---------- wiring ---------- */
  document.addEventListener('click', function (e) {
    var t = e.target, el; if (!t || !t.closest) return;
    if ((el = t.closest('[data-w158new]'))) { e.preventDefault(); GF.formContact = el.getAttribute('data-w158new') === '1' ? null : Number(el.getAttribute('data-w158new')); giftForm(null, GF.formContact); return; }
    if ((el = t.closest('[data-w158open]'))) { if (t.closest('a')) return; e.preventDefault(); GF.formContact = null; giftForm(el.getAttribute('data-w158open')); return; }
    if ((el = t.closest('[data-w158save]'))) { e.preventDefault(); saveGift(el); return; }
    if ((el = t.closest('[data-w158del]'))) { e.preventDefault(); if (el.getAttribute('data-sure') === '1') delGift(el.getAttribute('data-w158del')); else { el.setAttribute('data-sure', '1'); el.innerHTML = I('trash') + ' Delete it for good?'; } return; }
    if ((el = t.closest('[data-w158sample]'))) { e.preventDefault(); sampleReceipt(el.getAttribute('data-w158sample')); return; }
    if ((el = t.closest('[data-w158print]'))) { e.preventDefault(); try { window.print(); } catch (x) { /* fine */ } return; }
    if ((el = t.closest('[data-w158cfgsave]'))) { e.preventDefault(); saveRcfg(); return; }
  });
  document.addEventListener('keydown', function (e) { var t = e.target; if ((e.key === 'Enter' || e.key === ' ') && t && t.hasAttribute && t.hasAttribute('data-w158open')) { e.preventDefault(); GF.formContact = null; giftForm(t.getAttribute('data-w158open')); } });
  document.addEventListener('input', function (e) { var t = e.target, box = t && t.closest && t.closest('[data-w158gift]'); if (box) refreshRule(box); });
  document.addEventListener('change', function (e) {
    var t = e.target; if (!t || !t.closest) return;
    var box = t.closest('[data-w158gift]'); if (box) { refreshRule(box); return; }
    if (t.hasAttribute('data-w158year')) { GF.year = t.value; paint(); }
  });
  /* ======================= Official receipts (wave158b, 28/09/26) =======================
     The machinery for CRA receipts from the Hub, built while receipts stay off. In Receipts: whether receipts from the Hub are on,
     what is still missing (the settings and a signature image), the signature (admins upload an image; the Hub keeps it as a PNG
     in the private bucket), the switch for admins (on needs everything; the treasurer and Steel decide), Issue for a donor's due
     gifts of the tax year (one receipt: one gift, or several as the year-end run does), the year-end run (one receipt per donor),
     and the receipts issued, each with its PDF, Replace and Cancel (with the reason). A sample receipt downloads as a PDF drawn by
     receipt-pdf, marked SAMPLE. Issuing and replacing refuse in the database while receipt_mode is off.
     wave185 (30/09/26): receipts by email. Email it beside an issued receipt sends the donor one email that thanks them and carries
     the PDF (mail-send, action receipt; a test copy to a test address while the Hub's email is in test mode), and the receipt
     says when it was emailed. The switch for online gifts (admins, only while receipts are on): every paid gift through the
     donation page gets its receipt issued and emailed by itself (stripe-events). Both switches stay off until an admin decides. */
  var RB = { busy: '', msg: '', err: '', act: null, confirmOn: false, run: null, sigUrl: null, sigAt: 0 };
  LOADERS.rcpts = function () { return db.from('crm_receipts').select('id,serial,contact_id,tax_year,kind,status,gift_ids,amount,advantage_amount,eligible_amount,donor,issued_at,issued_by,replaces_id,replaced_by_id,cancelled_at,cancel_reason,pdf_path,cancelled_pdf_path,emailed_at,email_send_id').order('issued_at', { ascending: false }).order('id', { ascending: false }).limit(3000); };
  function rbMail(body) {
    if (typeof db === 'undefined' || !db || !db.functions) return Promise.resolve({ error: 'offline' });
    return Promise.resolve(db.functions.invoke('mail-send', { body: body })).then(function (r) {
      if (r && r.error) {
        var ctx = r.error.context;
        if (ctx && typeof ctx.json === 'function') return ctx.json().then(function (j) { return { error: (j && j.error) || r.error.message || 'The email function refused.' }; }, function () { return { error: r.error.message || 'The email function refused.' }; });
        return { error: r.error.message || 'The email function refused.' };
      }
      return (r && r.data) || {};
    }).catch(function (e) { return { error: String((e && e.message) || e) }; });
  }
  function rbAuto() { return !!(GF.cfg && GF.cfg.receipt_auto_online === 'on'); }
  function rbFn(body) {
    if (typeof db === 'undefined' || !db || !db.functions) return Promise.resolve({ error: 'offline' });
    return Promise.resolve(db.functions.invoke('receipt-pdf', { body: body })).then(function (r) {
      if (r && r.error) {
        var ctx = r.error.context;
        if (ctx && typeof ctx.json === 'function') return ctx.json().then(function (j) { return { error: (j && j.error) || r.error.message || 'The receipt function refused.' }; }, function () { return { error: r.error.message || 'The receipt function refused.' }; });
        return { error: r.error.message || 'The receipt function refused.' };
      }
      return (r && r.data) || {};
    }).catch(function (e) { return { error: String((e && e.message) || e) }; });
  }
  function rbOn() { return !!(GF.cfg && GF.cfg.receipt_mode === 'on'); }
  function rbAdmin() { return !!(GF.cfg && GF.cfg.is_admin); }
  function rbSave(bytes, name, type) {
    try {
      var blob = bytes instanceof Blob ? bytes : new Blob([bytes], { type: type || 'application/pdf' }), url = URL.createObjectURL(blob);
      var a = document.createElement('a'); a.href = url; a.download = name; a.rel = 'noopener'; document.body.appendChild(a); a.click(); a.remove();
      setTimeout(function () { try { URL.revokeObjectURL(url); } catch (e) { /* fine */ } }, 30000);
      return true;
    } catch (e) { return false; }
  }
  function rbB64(b64) { var s = atob(b64), u = new Uint8Array(s.length); for (var i = 0; i < s.length; i++) u[i] = s.charCodeAt(i); return u; }
  function rbRefresh() { S.at.rcpts = 0; S.at.gifts = 0; S.at.grcpt = 0; return Promise.all([load('rcpts', true), load('gifts', true), load('grcpt', true), loadRcfg()]).then(function () { if (S.ui.tab === 'gifts') paint(); }); }
  function rbSay(msg, err) { RB.msg = err ? '' : msg; RB.err = err ? msg : ''; RB.busy = ''; if (S.ui.tab === 'gifts') paint(); }

  /* ---------- the sample as a PDF ---------- */
  function rbSamplePdf(btn) {
    var m = /^rcpt:(\d+)$/.exec(S.sheet || ''); if (!m) return;
    if (btn) { btn.disabled = true; btn.textContent = 'Drawing the PDF\u2026'; }
    rbFn({ action: 'sample', gift_id: Number(m[1]) }).then(function (r) {
      if (btn) { btn.disabled = false; btn.innerHTML = I('note') + ' Download the sample (PDF)'; }
      var box = document.querySelector('#w152sheet [data-w158bsay]');
      if (r.error || !r.pdf_b64) { if (box) box.textContent = 'The PDF did not come back: ' + (r.error || 'no file'); return; }
      rbSave(rbB64(r.pdf_b64), 'sample-receipt-gift-' + m[1] + '.pdf');
      if (box) box.textContent = 'Downloaded: sample-receipt-gift-' + m[1] + '.pdf (marked SAMPLE).';
    });
  }

  /* ---------- in Receipts: the switch, the signature ---------- */
  function rbStatusHtml(cfg) {
    var on = cfg.receipt_mode === 'on', admin = !!cfg.is_admin, missing = (cfg.missing || []).slice();
    if (!cfg.signature) missing.push('a signature image');
    var sig = '<div class="w158bsig">' + (cfg.signature ? (RB.sigUrl ? '<img src="' + E(RB.sigUrl) + '" alt="The signature on receipts">' : '<span class="m">A signature image is uploaded.</span>') : '<span class="m">No signature image yet.</span>') +
      (admin ? '<label class="w152btn sm ghost w158bup">' + I('edit') + (cfg.signature ? ' Replace the signature' : ' Upload the signature') + '<input type="file" accept="image/png,image/jpeg" data-w158bsig hidden></label>' : '') + '</div>';
    return '<div class="w158bmode ' + (on ? 'on' : 'off') + '"><b>Receipts from the Hub are ' + (on ? 'on' : 'off') + '.</b> ' +
      (on ? 'Admins issue, replace and cancel them below; every receipt takes the next number.'
        : missing.length ? 'Before an admin can turn them on: ' + E(listJoin(missing)) + '.' : 'Everything is ready: an admin can turn them on once the treasurer and Steel agree.') + '</div>' +
      '<div class="w155lb">The signature on receipts <span class="m">the treasurer\u2019s, or another person the board authorizes; a PNG or JPG on a white or clear background</span></div>' + sig +
      (admin ? (RB.confirmOn ? '<div class="w155cf"><b>Turn receipts from the Hub on?</b> From then on admins can issue official receipts with the next number (' + E((cfg.receipt_prefix || '') + String(cfg.receipt_next_number || '').padStart(4, '0')) + '), and Keela stops being the only place receipts come from. The treasurer and Steel decide this.' +
          '<div class="w154acts"><button class="w152btn" data-w158bmode="on">' + I('check') + ' Turn them on</button><button class="w152btn ghost" data-w158bmodeno="1">Not yet</button></div></div>'
        : '<div class="w154acts">' + (on ? '<button class="w152btn ghost" data-w158bmode="off">' + I('lock') + ' Turn receipts off</button>' : '<button class="w152btn ghost" data-w158bask="1"' + (missing.length ? ' disabled title="' + E('Missing: ' + missing.join(', ')) + '"' : '') + '>' + I('check') + ' Turn receipts on\u2026</button>') + '</div>') : '') +
      rbAutoHtml(cfg);
  }
  /* wave185: the switch for online gifts */
  function rbAutoHtml(cfg) {
    var on = cfg.receipt_mode === 'on', auto = cfg.receipt_auto_online === 'on', admin = !!cfg.is_admin;
    return '<div class="w185auto ' + (auto && on ? 'on' : 'off') + '" data-w185auto-state="' + (auto && on ? 'on' : 'off') + '"><b>Online gifts: ' + (auto && on ? 'each paid gift through the donation page gets its receipt issued and emailed by itself.' : 'receipts are issued by hand (Issue below, then Email it).') + '</b> ' +
      (on ? 'With this on, every gift the donation page takes is receipted with the next number the moment Stripe confirms it, and the donor gets one email: the thank-you with the official receipt attached as a PDF, in the language they gave in. A gift that cannot be receipted by itself (no address, a number already used) stays in the list below for an admin.'
        : 'Receipts from the Hub must be on first.') +
      (admin ? '<div class="w154acts">' + (on ? (auto ? '<button class="w152btn ghost" data-w185auto="off">' + I('lock') + ' Stop the automatic receipts</button>' : '<button class="w152btn" data-w185auto="on">' + I('send') + ' Email receipts for online gifts automatically</button>') : '') +
        '<button class="w152btn ghost" data-w185sample="en"' + (RB.busy ? ' disabled' : '') + '>' + I('note') + ' Email me a sample</button><button class="w152btn ghost" data-w185sample="fr"' + (RB.busy ? ' disabled' : '') + '>' + I('note') + ' En fran\u00e7ais</button></div>' : '') +
      '</div>';
  }
  function rbAutoSet(mode) {
    RB.busy = 'auto';
    Promise.resolve(db.rpc('crm_receipt_auto_set', { p_on: mode })).then(function (r) {
      if (r && r.error) { rbSay('Not changed: ' + (r.error.message || r.error), true); return; }
      GF.cfg = r.data || GF.cfg; rbSay(mode === 'on' ? 'Online gifts now get their receipt by email automatically.' : 'Online gifts are receipted by hand again.');
    });
  }
  /* wave185: the receipt email with a SAMPLE receipt attached, to the admin's own test address */
  function rbSample(lang) {
    RB.busy = 'sample'; paint();
    rbMail({ action: 'receipt_sample', lang: lang }).then(function (r) {
      if (r.error || r.status !== 'sent') { rbSay('The sample was not sent: ' + (r.error || r.status || 'no answer'), true); return; }
      rbSay('A sample receipt email went to ' + r.to + ' (the attached receipt is marked SAMPLE).');
    });
  }
  /* wave185: Email it */
  function rbEmail(id) {
    RB.busy = 'mail:' + id; paint();
    rbMail({ action: 'receipt', receipt_id: Number(id) }).then(function (r) {
      if (r.error) { rbSay('Not emailed: ' + r.error, true); return; }
      if (r.status === 'suppressed') { rbSay('Not emailed: ' + (r.basis || 'the address does not work') + '. Download the PDF and send it another way.', true); return; }
      if (r.status !== 'sent') { rbSay('Not emailed: ' + (r.error || r.status || 'no answer'), true); return; }
      rbSay(r.test_copy ? 'The Hub\u2019s email is in test mode: a copy went to ' + r.to + ' instead of ' + (r.donor_email || 'the donor') + '. The receipt is not marked as emailed.' : 'Emailed to ' + r.to + ' with the PDF attached.');
      rbRefresh();
    });
  }
  function rbSigLoad() {
    if (!GF.cfg || !GF.cfg.signature || RB.sigUrl || Date.now() - RB.sigAt < 60000 || !db.storage) return;
    RB.sigAt = Date.now();
    Promise.resolve(db.storage.from('receipts').createSignedUrl('settings/signature.png', 600)).then(function (r) {
      if (r && r.data && r.data.signedUrl) { RB.sigUrl = r.data.signedUrl; if (S.ui.tab === 'gifts' && GF.view === 'receipts') paint(); }
    }, function () { /* fine */ });
  }
  function rbSigUpload(input) {
    var f = input.files && input.files[0]; if (!f) return;
    if (!/^image\/(png|jpeg)$/.test(f.type)) { rbSay('A PNG or JPG, please.', true); return; }
    RB.busy = 'sig'; RB.msg = 'Uploading the signature\u2026'; paint();
    var img = new Image(), url = URL.createObjectURL(f);
    img.onload = function () {
      /* kept as a PNG no wider than 900 px, so the PDF can use it */
      var sc = Math.min(1, 900 / img.naturalWidth), c = document.createElement('canvas');
      c.width = Math.max(1, Math.round(img.naturalWidth * sc)); c.height = Math.max(1, Math.round(img.naturalHeight * sc));
      c.getContext('2d').drawImage(img, 0, 0, c.width, c.height);
      try { URL.revokeObjectURL(url); } catch (e) { /* fine */ }
      c.toBlob(function (blob) {
        if (!blob) { rbSay('That image could not be read.', true); return; }
        Promise.resolve(db.storage.from('receipts').upload('settings/signature.png', blob, { upsert: true, contentType: 'image/png' })).then(function (r) {
          if (r && r.error) { rbSay('Not uploaded: ' + (r.error.message || r.error), true); return; }
          RB.sigUrl = null; RB.sigAt = 0;
          try { db.from('change_log').insert({ entity_type: 'receipts', entity_id: 'settings', field: 'signature', old_value: null, new_value: 'uploaded', changed_by: actor() }); } catch (e) { /* the upload is what counts */ }
          loadRcfg().then(function () { rbSay('The signature is saved.'); });
        });
      }, 'image/png');
    };
    img.onerror = function () { rbSay('That image could not be read.', true); };
    img.src = url;
  }
  function rbModeSet(mode) {
    RB.busy = 'mode'; RB.confirmOn = false;
    Promise.resolve(db.rpc('crm_receipt_mode_set', { p_mode: mode })).then(function (r) {
      if (r && r.error) { rbSay('Not changed: ' + (r.error.message || r.error), true); return; }
      GF.cfg = r.data || GF.cfg; rbSay(mode === 'on' ? 'Receipts from the Hub are on.' : 'Receipts from the Hub are off.');
    });
  }

  /* ---------- issuing ---------- */
  function rbIssue(giftIds, quiet) {
    return Promise.resolve(db.rpc('crm_receipt_issue', { p_gift_ids: giftIds.map(Number) })).then(function (r) {
      if (r && r.error) return { error: r.error.message || String(r.error) };
      var id = r && r.data; if (id && typeof id === 'object') id = id.crm_receipt_issue != null ? id.crm_receipt_issue : id.id;
      return rbFn({ action: 'render', receipt_id: Number(id) }).then(function (p) { return { id: id, pdf: p && !p.error, pdfErr: p && p.error }; });
    });
  }
  function rbIssueDonor(cid, year) {
    var gifts = (S.grcpt || []).filter(function (r) { return String(r.contact_id) === String(cid) && String(r.tax_year) === String(year) && r.receipt_status === 'due'; }).map(function (r) { return r.gift_id; });
    if (!gifts.length) return;
    RB.busy = 'issue:' + cid; paint();
    rbIssue(gifts).then(function (x) {
      if (x.error) { rbSay('Not issued: ' + x.error, true); return; }
      rbSay('Receipt issued' + (x.pdf ? ' and its PDF kept.' : '; the PDF did not come back (' + (x.pdfErr || '?') + '): Make the PDF below.'));
      rbRefresh();
    });
  }
  function rbYearRun(year) {
    var by = {};
    (S.grcpt || []).forEach(function (r) { if (String(r.tax_year) === String(year) && r.receipt_status === 'due') (by[r.contact_id] = by[r.contact_id] || []).push(r.gift_id); });
    var ids = Object.keys(by), done = 0, bad = [];
    if (!ids.length) return;
    RB.busy = 'run'; RB.run = { total: ids.length, done: 0 }; paint();
    var step = function (i) {
      if (i >= ids.length) { RB.run = null; rbSay(plural(done, 'receipt', 'receipts') + ' issued for ' + year + (bad.length ? '; not issued: ' + bad.join('; ') : '.'), !!bad.length && !done); rbRefresh(); return; }
      rbIssue(by[ids[i]]).then(function (x) {
        if (x.error) { var c = contact(ids[i]); bad.push((c ? c.full_name : 'contact ' + ids[i]) + ' (' + x.error + ')'); } else done++;
        RB.run.done = i + 1; if (S.ui.tab === 'gifts') paint();
        step(i + 1);
      });
    };
    step(0);
  }
  function rbDueActions(d, year) {
    if (!rbAdmin() || !rbOn()) return '';
    return '<button class="w152mini" data-w158bissue="' + E(d.id) + '" data-year="' + E(year) + '"' + (RB.busy ? ' disabled' : '') + '>' + (RB.busy === 'issue:' + d.id ? 'Issuing\u2026' : 'Issue') + '</button>';
  }
  function rbRunHtml(n, year) {
    if (!n) return '';
    if (RB.run) return '<div class="w154msg">Issuing ' + RB.run.done + ' of ' + RB.run.total + '\u2026</div>';
    if (!rbOn()) return '<p class="m">' + I('lock') + ' Issuing waits until receipts from the Hub are on.</p>';
    if (!rbAdmin()) return '<p class="m">An admin issues the receipts.</p>';
    return '<div class="w154acts"><button class="w152btn" data-w158brun="' + E(year) + '"' + (RB.busy ? ' disabled' : '') + '>' + I('send') + ' Issue one receipt per donor (' + n + ')</button></div>';
  }

  /* ---------- the receipts issued ---------- */
  function rbPdf(id, which) {
    var r = (S.rcpts || []).filter(function (x) { return String(x.id) === String(id); })[0]; if (!r) return;
    var path = which === 'cancelled' ? r.cancelled_pdf_path : r.pdf_path;
    if (!path || !db.storage) return;
    Promise.resolve(db.storage.from('receipts').createSignedUrl(path, 120)).then(function (s) {
      if (s && s.data && s.data.signedUrl) { try { window.open(s.data.signedUrl, '_blank', 'noopener'); } catch (e) { /* fine */ } }
      else rbSay('The PDF could not be opened' + (s && s.error ? ': ' + (s.error.message || s.error) : '.'), true);
    });
  }
  function rbMake(id) {
    RB.busy = 'pdf:' + id; paint();
    rbFn({ action: 'render', receipt_id: Number(id) }).then(function (p) {
      if (p.error) { rbSay('The PDF was not made: ' + p.error, true); return; }
      rbSay('The PDF is kept.'); rbRefresh();
    });
  }
  function rbAct(id, kind) {
    var box = document.querySelector('#crm [data-w158breason="' + id + '"]'), why = box ? String(box.value || '').trim() : '';
    if (why.length < 3) { rbSay('Say why, in a few words.', true); return; }
    RB.busy = kind + ':' + id; paint();
    var q = kind === 'replace' ? db.rpc('crm_receipt_replace', { p_id: Number(id), p_reason: why }) : db.rpc('crm_receipt_cancel', { p_id: Number(id), p_reason: why });
    Promise.resolve(q).then(function (r) {
      if (r && r.error) { rbSay((kind === 'replace' ? 'Not replaced: ' : 'Not cancelled: ') + (r.error.message || r.error), true); return; }
      RB.act = null;
      var newId = kind === 'replace' ? (r && r.data && typeof r.data === 'object' ? r.data.crm_receipt_replace : r && r.data) : null;
      /* the kept copy marked cancelled, and the replacement's own PDF */
      rbFn({ action: 'render', receipt_id: Number(id) }).then(function () {
        return newId ? rbFn({ action: 'render', receipt_id: Number(newId) }) : null;
      }).then(function () {
        rbSay(kind === 'replace' ? 'Replaced: the original is kept, marked cancelled.' : 'Cancelled: the receipt is kept, marked cancelled, and its gifts follow the receipt rule again.');
        rbRefresh();
      });
    });
  }
  function rbIssuedHtml() {
    var list = S.rcpts || [], admin = rbAdmin(), on = rbOn();
    var bySerial = {}; list.forEach(function (r) { bySerial[r.id] = r.serial; });
    var rows = list.slice(0, 200).map(function (r) {
      var c = contact(r.contact_id), who = c ? '<a href="#crm/c/' + E(c.id) + '">' + E((r.donor && r.donor.name) || c.full_name) + '</a>' : E((r.donor && r.donor.name) || 'Contact ' + r.contact_id);
      var st = r.status === 'cancelled' ? (r.replaced_by_id ? 'Replaced by ' + (bySerial[r.replaced_by_id] || 'a new receipt') : 'Cancelled') : 'Issued';
      var acts = [];
      if (r.pdf_path) acts.push('<button class="w152mini" data-w158bpdf="' + E(r.id) + '">' + I('note') + ' PDF</button>');
      else if (admin) acts.push('<button class="w152mini" data-w158bmake="' + E(r.id) + '"' + (RB.busy ? ' disabled' : '') + '>Make the PDF</button>');
      if (r.cancelled_pdf_path) acts.push('<button class="w152mini" data-w158bpdf="' + E(r.id) + '" data-which="cancelled">Cancelled copy</button>');
      if (admin && r.status === 'issued') {
        acts.push('<button class="w152mini" data-w185mail="' + E(r.id) + '"' + (RB.busy ? ' disabled' : '') + '>' + (RB.busy === 'mail:' + r.id ? 'Emailing\u2026' : I('send') + (r.emailed_at ? ' Email it again' : ' Email it')) + '</button>');
        if (on) acts.push('<button class="w152mini" data-w158bdo="replace" data-id="' + E(r.id) + '">Replace</button>');
        acts.push('<button class="w152mini" data-w158bdo="cancel" data-id="' + E(r.id) + '">Cancel</button>');
      }
      var mailed = r.status === 'issued' ? (r.emailed_at ? '<span class="w185mailed on" title="' + E('Emailed to the donor on ' + fmtDay(r.emailed_at)) + '">' + I('send') + ' Emailed ' + E(fmtDay(r.emailed_at)) + '</span>' : '<span class="w185mailed">Not emailed</span>') : '';
      var form = RB.act && String(RB.act.id) === String(r.id) ? '<div class="w158bwhy"><input class="w152in" data-w158breason="' + E(r.id) + '" placeholder="' + (RB.act.kind === 'replace' ? 'Why it is replaced (the address changed, a typo\u2026)' : 'Why it is cancelled (issued in error\u2026)') + '">' +
        '<button class="w152btn sm" data-w158bgo="' + E(RB.act.kind) + '" data-id="' + E(r.id) + '">' + (RB.act.kind === 'replace' ? 'Replace it' : 'Cancel it') + '</button><button class="w152btn sm ghost" data-w158bstop="1">Keep it</button></div>' : '';
      return '<div class="w158brow' + (r.status === 'cancelled' ? ' off' : '') + '"><span class="s"><b>' + E(r.serial) + '</b><span class="m">' + E(fmtDay(r.issued_at)) + (r.kind === 'annual' ? ' \u00b7 ' + plural((r.gift_ids || []).length, 'gift', 'gifts') + ' in ' + E(r.tax_year) : '') + '</span></span>' +
        '<span class="w">' + who + '</span><span class="a">' + E(cents(r.eligible_amount)) + '</span><span class="t">' + gchip({ issued: ['Issued', GREEN], cancelled: [st, MUTED] }, r.status) + (r.cancel_reason ? '<span class="m"> ' + E(String(r.cancel_reason).replace(/^Replaced:\s*/, '')) + '</span>' : '') + mailed + '</span>' +
        '<span class="x">' + acts.join('') + '</span>' + form + '</div>';
    }).join('');
    return '<div class="w154card wide"><h3>' + I('note') + ' Receipts issued by the Hub <span class="m">' + plural(list.length, 'receipt', 'receipts') + '</span></h3>' +
      (list.length ? '<div class="w158brows">' + rows + '</div>' : '<p class="m">None yet. Keela\u2019s 55 receipts are the legal copies until receipts from the Hub are on; then each one issued here is listed with its PDF.</p>') + '</div>';
  }

  /* ---------- styles ---------- */
  var css158b = document.createElement('style'); css158b.id = 'w158bcss';
  css158b.textContent = ''
    + '.w158bmode{border-radius:12px;padding:10px 12px;margin:10px 0 12px;font-size:13.5px;line-height:1.45;}.w158bmode.off{background:rgba(179,64,47,.07);}.w158bmode.on{background:rgba(42,140,122,.1);}'
    + '.w158bsig{display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin:4px 0 10px;}.w158bsig img{max-width:220px;max-height:70px;background:' + CREAM + ';border:1px solid rgba(16,63,57,.15);border-radius:8px;padding:4px;}'
    + '.w158bup{cursor:pointer;}.w158brows{display:flex;flex-direction:column;}'
    + '.w158brow{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.2fr) auto minmax(0,1fr) auto;gap:10px;align-items:center;padding:9px 0;border-bottom:1px dashed rgba(16,63,57,.12);font-size:13.5px;}'
    + '.w158brow.off{opacity:.72;}.w158brow .s{display:flex;flex-direction:column;min-width:0;}.w158brow .a{font-weight:600;font-variant-numeric:tabular-nums;}.w158brow .x{display:flex;flex-wrap:wrap;gap:6px;justify-content:flex-end;}'
    + '.w158brow .w a{color:inherit;font-weight:600;}.w158bwhy{grid-column:1/-1;display:flex;flex-wrap:wrap;gap:8px;align-items:center;}.w158bwhy .w152in{flex:1 1 240px;}'
    + '@media (max-width:700px){.w158brow{grid-template-columns:minmax(0,1fr) auto;}.w158brow .w,.w158brow .t{grid-column:1/-1;}.w158brow .x{grid-column:1/-1;justify-content:flex-start;}}'
    + '.w185auto{border-radius:12px;padding:10px 12px;margin:12px 0 4px;font-size:13.5px;line-height:1.45;background:rgba(111,100,171,.08);}.w185auto.on{background:rgba(42,140,122,.1);}'
    + '.w185mailed{display:inline-block;margin-left:8px;font-size:12px;color:' + MUTED + ';}.w185mailed.on{color:' + GREEN + ';font-weight:600;}';
  document.head.appendChild(css158b);

  /* ---------- wiring ---------- */
  document.addEventListener('click', function (e) {
    var t = e.target, el; if (!t || !t.closest) return;
    if (!t.closest('.w152root') && !t.closest('#w152sheet')) return;
    if ((el = t.closest('[data-w158bpdfsample]'))) { e.preventDefault(); rbSamplePdf(el); return; }
    if ((el = t.closest('[data-w158bask]'))) { e.preventDefault(); RB.confirmOn = true; RB.msg = ''; RB.err = ''; paint(); return; }
    if ((el = t.closest('[data-w158bmodeno]'))) { e.preventDefault(); RB.confirmOn = false; paint(); return; }
    if ((el = t.closest('[data-w158bmode]'))) { e.preventDefault(); rbModeSet(el.getAttribute('data-w158bmode')); return; }
    if ((el = t.closest('[data-w185auto]'))) { e.preventDefault(); rbAutoSet(el.getAttribute('data-w185auto')); return; }
    if ((el = t.closest('[data-w185mail]'))) { e.preventDefault(); rbEmail(el.getAttribute('data-w185mail')); return; }
    if ((el = t.closest('[data-w185sample]'))) { e.preventDefault(); rbSample(el.getAttribute('data-w185sample')); return; }
    if ((el = t.closest('[data-w158bissue]'))) { e.preventDefault(); rbIssueDonor(el.getAttribute('data-w158bissue'), el.getAttribute('data-year')); return; }
    if ((el = t.closest('[data-w158brun]'))) { e.preventDefault(); rbYearRun(el.getAttribute('data-w158brun')); return; }
    if ((el = t.closest('[data-w158bpdf]'))) { e.preventDefault(); rbPdf(el.getAttribute('data-w158bpdf'), el.getAttribute('data-which')); return; }
    if ((el = t.closest('[data-w158bmake]'))) { e.preventDefault(); rbMake(el.getAttribute('data-w158bmake')); return; }
    if ((el = t.closest('[data-w158bdo]'))) { e.preventDefault(); RB.act = { id: el.getAttribute('data-id'), kind: el.getAttribute('data-w158bdo') }; RB.msg = ''; RB.err = ''; paint(); var inp = document.querySelector('#crm [data-w158breason]'); if (inp) inp.focus(); return; }
    if ((el = t.closest('[data-w158bstop]'))) { e.preventDefault(); RB.act = null; paint(); return; }
    if ((el = t.closest('[data-w158bgo]'))) { e.preventDefault(); rbAct(el.getAttribute('data-id'), el.getAttribute('data-w158bgo')); return; }
  });
  document.addEventListener('change', function (e) { var t = e.target; if (t && t.hasAttribute && t.hasAttribute('data-w158bsig')) rbSigUpload(t); });
  /* ======================= Reports (wave160, 28/09/26) =======================
     The CRM's Reports tab (#crm/reports, or #crm/reports/<the year a fiscal year starts>): one fiscal year (1 October to
     30 September) from crm_report(), which runs with the reader's rights. The year in a few lines for the board (copy it or
     print the page), the headline numbers against the year before (at the same point while the year is still running), gifts
     by month, kind, campaign, source and size, donors (new, retained, recaptured, lapsed, the retention rate; who gave last
     year and not yet this year, made into a fixed list in one click; the largest donors), volunteering (servings by month, new
     and returning volunteers, retention, roles, the most servings, the application funnel, the hours and meals where they were
     recorded), email permission today, and the emails and form answers of the year. Read-only apart from Make a list. */
  P.chart = '<path d="M4 4v16h16"/><path d="M8.5 16v-4.5M12.5 16V8M16.5 16v-6"/>';
  P.print = '<path d="M7 9V4h10v5"/><rect x="4" y="9" width="16" height="7.5" rx="2"/><path d="M7 14h10v6H7z"/>';
  P.refresh = '<path d="M19.5 12a7.5 7.5 0 1 1-2.2-5.3M19.5 4.5v4h-4"/>';
  var RP = { fy: null, data: {}, busy: false, err: '', msg: '', showLapsed: false, listing: false };
  function rpGet() { return RP.data[RP.fy == null ? 'cur' : String(RP.fy)] || null; }
  function rpLabel(y) { y = Number(y); return y + '-' + String(y + 1).slice(2); }
  function rpPct(a, b) { a = Number(a) || 0; b = Number(b) || 0; return b ? Math.round(a * 100 / b) + '%' : '\u2013'; }
  function rpCap(s) { s = String(s || ''); return s.charAt(0).toUpperCase() + s.slice(1); }
  function rpNum(n) { return (Number(n) || 0).toLocaleString('en-CA'); }
  function rpMonth(m) { return MON[Number(String(m).slice(5, 7)) - 1] || ''; }
  function rpLoad(fy, force) {
    var key = fy == null ? 'cur' : String(fy);
    if (RP.data[key] && !force) return Promise.resolve(RP.data[key]);
    if (typeof db === 'undefined' || !db || !db.rpc) return Promise.resolve(null);
    RP.busy = true; RP.err = '';
    return Promise.resolve(db.rpc('crm_report', { p_fy: fy == null ? null : Number(fy) })).then(function (r) {
      RP.busy = false;
      if (r && r.error) { RP.err = String(r.error.message || r.error); return null; }
      var d = r && r.data; if (typeof d === 'string') { try { d = JSON.parse(d); } catch (e) { d = null; } }
      if (!d || d.fy == null) { RP.err = 'The report did not come back.'; return null; }
      RP.data[String(d.fy)] = d; if (fy == null) RP.data.cur = d;
      return d;
    }, function (e) { RP.busy = false; RP.err = String((e && e.message) || e); return null; });
  }
  function openReports(parts) {
    var y = parts[2] && /^\d{4}$/.test(parts[2]) ? Number(parts[2]) : null;
    if (y !== RP.fy) { RP.showLapsed = false; RP.msg = ''; }
    RP.fy = y; RP.err = '';
  }

  /* ---------- the year in a few lines (for the board) ---------- */
  function rpSpan(d) { return d.label + ' (' + fmtDay(d.from) + ' to ' + fmtDay(d.in_progress ? d.through : d.to) + ')'; }
  function rpSummary(d) {
    var g = d.gifts || {}, dn = d.donors || {}, v = d.volunteers || {}, out = [];
    var pg = (d.in_progress ? g.prev_to_date : g.prev) || {}, pv = (d.in_progress ? v.prev_to_date : v.prev) || {};
    var pwhen = d.in_progress ? 'at the same point in ' + d.prev_label : 'in ' + d.prev_label;
    if (g.count) out.push('In ' + rpSpan(d) + ', ' + plural(g.donors, 'person', 'people') + ' gave ' + money(g.total) + ' in ' + plural(g.count, 'gift', 'gifts') + ' (' + pwhen + ': ' + money(pg.total || 0) + ' from ' + plural(pg.donors || 0, 'person', 'people') + ').');
    else out.push('No gift is recorded in ' + rpSpan(d) + (pg.count ? ' (' + pwhen + ': ' + money(pg.total) + ')' : '') + '.');
    var bits = [];
    if (dn.new) bits.push(plural(dn.new, 'person', 'people') + ' gave for the first time');
    if (dn.last_year) bits.push(rpNum(dn.retained) + ' of the ' + plural(dn.last_year, 'donor', 'donors') + ' of ' + d.prev_label + ' gave again (' + rpPct(dn.retained, dn.last_year) + ' retention)');
    if (dn.recaptured) bits.push(plural(dn.recaptured, 'person', 'people') + ' came back after a year or more without giving');
    if (dn.lapsed) bits.push(rpNum(dn.lapsed) + ' who gave in ' + d.prev_label + ' have not given ' + (d.in_progress ? 'yet ' : '') + 'in ' + d.label);
    if (bits.length) out.push(rpCap(listJoin(bits)) + '.');
    if (v.servings) {
      var vb = [plural(v.people, 'volunteer', 'volunteers') + ' served ' + plural(v.servings, 'time', 'times') + ' at ' + plural(v.events, 'event', 'events') + ' (' + pwhen + ': ' + plural(pv.people || 0, 'volunteer', 'volunteers') + ', ' + plural(pv.servings || 0, 'serving', 'servings') + ').'];
      var nb = [];
      if (v.new) nb.push(plural(v.new, 'person', 'people') + ' served for the first time');
      if (v.prev && v.prev.people) nb.push(rpNum(v.retained) + ' of the ' + plural(v.prev.people, 'volunteer', 'volunteers') + ' of ' + d.prev_label + ' came back (' + rpPct(v.retained, v.prev.people) + ')');
      if (nb.length) vb.push(rpCap(listJoin(nb)) + '.');
      if (v.hours && Number(v.hours.recorded) > 0) vb.push('They gave ' + plural(Math.round(Number(v.hours.recorded)), 'hour', 'hours') + ' where hours were recorded.');
      if (v.meals && Number(v.meals.served) > 0) vb.push(plural(v.meals.served, 'meal was', 'meals were') + ' served at the events that recorded it.');
      out.push(vb.join(' '));
    } else out.push('No serving is recorded in ' + rpSpan(d) + '.');
    var ap = v.applied || {};
    if (ap.applied) out.push(plural(ap.applied, 'person', 'people') + ' applied to volunteer, and ' + rpNum(ap.served1) + ' of them ' + (ap.served1 === 1 ? 'has' : 'have') + ' served since.');
    var em = d.email || {};
    if (em.sent) out.push('The Hub sent ' + plural(em.sent, 'email', 'emails') + (em.campaigns ? ' (' + plural(em.campaigns, 'campaign', 'campaigns') + ')' : '') + '; ' + rpNum(em.opened) + ' were opened.');
    var fa = (d.forms || []).reduce(function (a, x) { return a + (Number(x.answers) || 0); }, 0);
    if (fa) out.push('The CRM\u2019s forms were answered ' + plural(fa, 'time', 'times') + '.');
    return out;
  }

  /* ---------- email permission today (the CRM's rule, from the contacts) ---------- */
  function rpPerm() {
    var o = { reach: 0, express: 0, implied: 0, ending: 0, unsub: 0, bounced: 0, none: 0, noemail: 0, total: 0 };
    (S.contacts || []).forEach(function (c) {
      o.total++;
      if (!c.emails.length) { o.noemail++; return; }
      var p = c._perm;
      if (p === 'express' || p === 'implied') { o.reach++; o[p]++; }
      else if (p === 'unsub') o.unsub++;
      else if (p === 'bounced') o.bounced++;
      else o.none++;
      if (p === 'implied') { var n = daysSince(c.implied_consent_until); if (n != null && n <= 0 && n >= -90) o.ending++; }
    });
    return o;
  }

  /* ---------- pieces ---------- */
  function rpBars(rows, cur, prev, fmt, label, labels) {
    var max = 0;
    rows.forEach(function (r) { max = Math.max(max, Number(r[cur]) || 0, prev ? Number(r[prev]) || 0 : 0); });
    var h = function (v) { return max && v ? Math.max(3, Math.round(v * 100 / max)) : 0; };
    var aria = label + ': ' + rows.map(function (r) { return rpMonth(r.month) + ' ' + fmt(Number(r[cur]) || 0); }).join(', ');
    return '<div class="w160ch" role="img" aria-label="' + E(aria) + '">' + rows.map(function (r) {
      var a = Number(r[cur]) || 0, b = prev ? Number(r[prev]) || 0 : 0, mo = rpMonth(r.month);
      return '<div class="w160col" title="' + E(mo + ' ' + String(r.month).slice(0, 4) + ': ' + fmt(a) + (prev ? ' (the year before: ' + fmt(b) + ')' : '')) + '"><div class="w160bars">' +
        (prev ? '<i class="p" style="height:' + h(b) + '%"></i>' : '') + '<i class="c" style="height:' + h(a) + '%"></i></div></div>';
    }).join('') + '</div><div class="w160ml" aria-hidden="true">' + rows.map(function (r) { return '<span>' + E(rpMonth(r.month)) + '</span>'; }).join('') + '</div>' +
      (labels ? '<div class="w160lg"><span><i class="c"></i>' + E(labels[0]) + '</span>' + (prev ? '<span><i class="p"></i>' + E(labels[1]) + '</span>' : '') + '</div>' : '');
  }
  /* rows: [label html, value text, share 0..1, extra text] */
  function rpRows(list, empty) {
    if (!list.length) return '<p class="m">' + E(empty || 'Nothing to show.') + '</p>';
    return '<div class="w160rows">' + list.map(function (x) {
      return '<div class="w160r"><span class="k">' + x[0] + (x[3] ? '<span class="m"> \u00b7 ' + E(x[3]) + '</span>' : '') + '</span>' +
        '<span class="bar" aria-hidden="true"><i style="width:' + Math.round(Math.max(0, Math.min(1, x[2] || 0)) * 100) + '%"></i></span><span class="v">' + E(x[1]) + '</span></div>';
    }).join('') + '</div>';
  }
  function rpWho(id, name) {
    var c = id != null ? contact(id) : null, n = (c && c.full_name) || name || 'Someone not in the CRM';
    return c ? '<a href="#crm/c/' + E(c.id) + '">' + E(n) + '</a>' : E(n);
  }
  function rpBox(n, label) { return '<div><b>' + E(n) + '</b><span>' + E(label) + '</span></div>'; }
  function rpMethod(m) { var x = GMETH.filter(function (o) { return o[0] === m; })[0]; return x && m ? x[1] : ''; }

  function rpGiftsHtml(d) {
    var g = d.gifts || {}, months = g.by_month || [], tot = Number(g.total) || 0;
    var best = months.reduce(function (a, r) { return Number(r.total) > Number(a.total || 0) ? r : a; }, {});
    var kinds = (g.by_kind || []).map(function (k) { var nm = (GKIND[k.kind] || [rpCap(k.kind)])[0]; return [E(nm), money(k.total), tot ? k.total / tot : 0, plural(k.count, 'gift', 'gifts')]; });
    var camps = (g.by_campaign || []).slice(0, 10).map(function (k) { return [E(k.campaign || 'No campaign'), money(k.total), tot ? k.total / tot : 0, plural(k.count, 'gift', 'gifts') + ', ' + plural(k.donors, 'donor', 'donors')]; });
    var srcs = (g.by_source || []).map(function (k) { var m = rpMethod(k.method); return [E(platName(k.platform) + (m ? ' (' + m + ')' : '')), money(k.total), tot ? k.total / tot : 0, plural(k.count, 'gift', 'gifts')]; });
    var rc = g.receipts || {}, rcl = Object.keys(RSTS).filter(function (k) { return rc[k]; }).map(function (k) { return plural(rc[k], 'gift', 'gifts') + ' ' + RSTS[k][0].toLowerCase(); });
    var allKeela = (g.by_source || []).length && (g.by_source || []).every(function (k) { return k.platform === 'keela'; });
    return '<section class="w154card wide"><h3>' + I('heart') + ' Gifts by month <span class="m">' + E(money(tot)) + ' in ' + E(d.label) + (g.prev ? ', ' + E(money(g.prev.total)) + ' in ' + E(d.prev_label) : '') + '</span></h3>' +
      rpBars(months, 'total', 'prev_total', money, 'Gifts by month in ' + d.label, [d.label, d.prev_label]) +
      (best.month && Number(best.total) > 0 ? '<p class="w160note">The best month: ' + E(rpMonth(best.month) + ' ' + best.month.slice(0, 4)) + ' (' + E(money(best.total)) + ', ' + E(plural(best.count, 'gift', 'gifts')) + ').</p>' : '') + '</section>' +
      '<section class="w154card"><h3>' + I('db') + ' Where it came from</h3>' +
      '<div class="w160h4">What kind of money</div>' + rpRows(kinds, 'No gift this year.') +
      '<div class="w160h4">Campaigns</div>' + rpRows(camps, 'No gift this year.') +
      '<div class="w160h4">How it came</div>' + rpRows(srcs, 'No gift this year.') +
      (rcl.length ? '<p class="w160note">Receipts: ' + E(listJoin(rcl)) + '. <a href="#crm/gifts/receipts">Receipts</a></p>' : '') +
      (allKeela ? '<p class="w160note">Keela\u2019s gifts came in as donations: registrations and tickets among them count as donations until someone sets their kind in Gifts.</p>' : '') + '</section>';
  }
  function rpSizesHtml(d) {
    var g = d.gifts || {}, dn = d.donors || {}, bands = g.bands || [], most = 0;
    bands.forEach(function (b) { most = Math.max(most, Number(b.count) || 0); });
    var rows = bands.map(function (b) { return [E(b.band), plural(b.count, 'gift', 'gifts'), most ? b.count / most : 0, Number(b.total) ? money(b.total) : '']; });
    var top = (dn.top || []).map(function (x, i) { return [rpWho(x.contact_id, x.name), money(x.total), dn.top[0] && Number(dn.top[0].total) ? x.total / dn.top[0].total : 0, plural(x.count, 'gift', 'gifts')]; });
    return '<section class="w154card"><h3>' + I('spark') + ' Gift sizes <span class="m">' + (g.count ? 'average ' + E(money(g.average)) + ', middle ' + E(money(g.median)) + ', largest ' + E(money(g.largest)) : '') + '</span></h3>' +
      rpRows(rows, 'No gift this year.') + '<div class="w160h4">The largest donors of ' + E(d.label) + '</div>' + rpRows(top, 'No donor this year.') + '</section>';
  }
  function rpDonorsHtml(d) {
    var dn = d.donors || {}, lap = dn.lapsed_list || [], shown = RP.showLapsed ? lap : lap.slice(0, 8);
    var rows = shown.map(function (x) { return [rpWho(x.contact_id, x.name), money(x.prev_total), 0, 'last gave ' + fmtDay(x.last_day) + ', ' + plural(x.gifts_ever, 'gift', 'gifts') + ' in all']; });
    return '<section class="w154card"><h3>' + I('people') + ' Donors <span class="m">' + E(plural(dn.this_year || 0, 'donor', 'donors')) + ' in ' + E(d.label) + '</span></h3>' +
      '<div class="w160ret">' + rpBox(rpNum(dn.new), 'gave for the first time') + rpBox(rpNum(dn.retained), 'gave again after ' + d.prev_label) +
      rpBox(rpNum(dn.recaptured), 'came back after a gap') + rpBox(rpNum(dn.lapsed), 'gave in ' + d.prev_label + ', not ' + (d.in_progress ? 'yet ' : '') + 'in ' + d.label) + '</div>' +
      '<p>Donor retention: <b>' + E(rpPct(dn.retained, dn.last_year)) + '</b> of the ' + E(plural(dn.last_year || 0, 'donor', 'donors')) + ' of ' + E(d.prev_label) + ' gave again in ' + E(d.label) + (d.in_progress ? ' so far' : '') + '.</p>' +
      (lap.length ? '<div class="w160h4">Gave in ' + E(d.prev_label) + ', not ' + (d.in_progress ? 'yet ' : '') + 'in ' + E(d.label) + '</div>' +
        '<div class="w160rows w160lap">' + rows.map(function (x) { return '<div class="w160r"><span class="k">' + x[0] + '<span class="m"> \u00b7 ' + E(x[3]) + '</span></span><span></span><span class="v">' + E(x[1]) + '</span></div>'; }).join('') + '</div>' +
        '<div class="w154acts w160noprint">' + (lap.length > shown.length ? '<button class="w152mini" data-w160lapsed="1">Show all ' + lap.length + '</button>' : '') +
        '<button class="w152btn sm" data-w160list="1"' + (RP.listing ? ' disabled' : '') + '>' + I('list') + ' Make a list of them</button></div>' : '') +
      (RP.msg ? '<div class="w154msg">' + E(RP.msg) + (/saved/.test(RP.msg) ? ' <a href="#crm/lists">Lists</a>' : '') + '</div>' : '') + '</section>';
  }
  function rpVolHtml(d) {
    var v = d.volunteers || {}, months = v.by_month || [], pv = v.prev || {};
    var roles = v.by_role || [], most = roles.reduce(function (a, r) { return Math.max(a, Number(r.servings) || 0); }, 0);
    var rrows = roles.map(function (r) { return [E(roleName(r.role)), plural(r.servings, 'serving', 'servings'), most ? r.servings / most : 0, plural(r.people, 'person', 'people')]; });
    var top = (v.top || []).map(function (x) { return [rpWho(x.contact_id, x.name), plural(x.servings, 'serving', 'servings'), v.top[0] && v.top[0].servings ? x.servings / v.top[0].servings : 0, '']; });
    var ap = v.applied || {}, steps = [['Applied in ' + d.label, ap.applied], ['Served at least once since', ap.served1], ['Twice or more', ap.served2], ['Three times or more', ap.served3]];
    var funnel = ap.applied ? rpRows(steps.map(function (s) { return [E(s[0]), rpNum(s[1]), ap.applied ? (Number(s[1]) || 0) / ap.applied : 0, '']; })) : '<p class="m">No application is dated in ' + E(d.label) + '.</p>';
    var hrs = v.hours || {}, meals = v.meals || {};
    var notes = [];
    if (Number(hrs.recorded) > 0) notes.push(plural(Math.round(Number(hrs.recorded)), 'hour', 'hours') + ' recorded for ' + plural(hrs.servings_with_hours, 'serving', 'servings') + ' (the old website).');
    else notes.push('Hours are not recorded for servings in the Hub' + (hrs.last_recorded ? '; the old website recorded them until ' + fmtDay(hrs.last_recorded) : '') + '.');
    if (Number(meals.served) > 0) notes.push(plural(meals.served, 'meal', 'meals') + ' served at ' + plural(meals.events, 'event', 'events') + ' that recorded it.');
    else notes.push('Meals served are not recorded' + (meals.last_recorded ? ' since ' + fmtDay(meals.last_recorded) + ' (the old website)' : '') + '.');
    return '<section class="w154card wide"><h3>' + I('hand') + ' Volunteering by month <span class="m">' + E(plural(v.servings || 0, 'serving', 'servings')) + ' in ' + E(d.label) + ', ' + E(plural(pv.servings || 0, 'serving', 'servings')) + ' in ' + E(d.prev_label) + '</span></h3>' +
      rpBars(months, 'servings', 'prev_servings', function (n) { return plural(n, 'serving', 'servings'); }, 'Servings by month in ' + d.label, [d.label, d.prev_label]) + '</section>' +
      '<section class="w154card"><h3>' + I('people') + ' Volunteers <span class="m">' + E(plural(v.people || 0, 'person', 'people')) + ' at ' + E(plural(v.events || 0, 'event', 'events')) + '</span></h3>' +
      '<div class="w160ret">' + rpBox(rpNum(v.people), 'served in ' + d.label) + rpBox(rpNum(v.new), 'for the first time') +
      rpBox(rpNum(v.retained), 'of ' + rpNum(pv.people) + ' from ' + d.prev_label + ' came back') + rpBox(rpPct(v.retained, pv.people), 'volunteer retention') + '</div>' +
      '<div class="w160h4">Roles</div>' + rpRows(rrows, 'No serving this year.') +
      '<div class="w160h4">The most servings</div>' + rpRows(top, 'No serving this year.') + '</section>' +
      '<section class="w154card"><h3>' + I('arrow') + ' From applying to serving</h3>' + funnel +
      '<p class="w160note">From the volunteer record: the date of someone\u2019s latest application, and the servings on or after it.</p>' +
      '<div class="w160h4">Hours and meals</div><p class="w160note">' + E(notes.join(' ')) + '</p></section>';
  }
  function rpMailHtml(d) {
    var p = rpPerm(), em = d.email || {}, forms = d.forms || [];
    var frows = forms.map(function (x) { return [E(x.title || x.slug || 'A form'), plural(x.answers, 'answer', 'answers'), 0, '']; });
    return '<section class="w154card"><h3>' + I('mail') + ' Email <span class="m">permission today</span></h3>' +
      '<div class="w160ret">' + rpBox(rpNum(p.reach), 'can get a newsletter') + rpBox(rpNum(p.express), 'said yes (express)') + rpBox(rpNum(p.implied), 'implied: gave or served') + rpBox(rpNum(p.ending), 'implied ends within 90 days') + '</div>' +
      '<p class="w160note">' + E(plural(p.unsub, 'person has', 'people have') + ' unsubscribed, ' + plural(p.bounced, 'address bounces', 'addresses bounce') + ', ' + plural(p.none, 'person has', 'people have') + ' no permission on file (confirmations only), and ' + plural(p.noemail, 'contact has', 'contacts have') + ' no email address.') + (p.ending ? ' Asking the people whose implied consent ends soon to say yes keeps them on the newsletter.' : '') + '</p>' +
      '<div class="w160h4">Sent in ' + E(d.label) + '</div>' +
      (em.sent ? rpRows([['Emails sent', rpNum(em.sent), 1, ''], ['Delivered', rpNum(em.delivered), em.delivered / em.sent, ''], ['Opened', rpNum(em.opened), em.opened / em.sent, rpPct(em.opened, em.sent)],
        ['Clicked', rpNum(em.clicked), em.clicked / em.sent, rpPct(em.clicked, em.sent)], ['Unsubscribed', rpNum(em.unsubscribed), em.unsubscribed / em.sent, '']]) +
        '<p class="w160note">' + E(plural(em.from_campaigns, 'email', 'emails') + ' from ' + plural(em.campaigns, 'campaign', 'campaigns') + ', ' + plural(em.from_automations, 'email', 'emails') + ' from automations.') + '</p>'
        : '<p class="m">No email has gone out from the Hub in ' + E(d.label) + ' (test emails are left out).</p>') +
      '<div class="w160h4">Form answers in ' + E(d.label) + '</div>' + rpRows(frows, 'No form answer yet (the CRM\u2019s forms are new in wave156).') + '</section>';
  }
  function rpNotesHtml(d) {
    return '<section class="w154card wide"><h3>' + I('note') + ' How it is counted</h3><p class="w160note">' + E([
      'A fiscal year runs from 1 October to 30 September; ' + d.label + ' began on ' + fmtDay(d.from) + '.',
      d.in_progress ? 'While a year is running, it is compared with the year before at the same date (' + fmtDay(((d.gifts || {}).prev_to_date || {}).through) + ').' : '',
      'A gift counts on the day it was received. A serving is someone confirmed on the roster of a completed event in the Volunteer Manager, the old website\u2019s events included.',
      'A first-time donor gave for the first time in the year; a retained donor gave in both years; a donor who came back after a gap last gave before the year before.',
      'Someone on two volunteer records counts twice until the records are merged in Possible duplicates.',
      'The numbers follow what the CRM holds today: a gift or a roster added later changes them.'].filter(Boolean).join(' ')) + '</p></section>';
  }

  function paintReports(root) {
    var head = statsHtml(S.contacts || []) + tabsHtml();
    var d = rpGet();
    if (!d) {
      if (RP.err) { root.innerHTML = head + '<div class="w152empty">' + I('alert') + ' The report could not be made (' + E(RP.err) + '). <button class="w152mini" data-w160reload="1">Try again</button>' + (RP.fy != null ? ' <button class="w152mini" data-w152go="#crm/reports">This year</button>' : '') + '</div>'; return; }
      root.innerHTML = head + busy('Working out the report\u2026');
      if (!RP.busy) rpLoad(RP.fy).then(function () { if (S.ui.tab === 'reports') paint(); });
      return;
    }
    var g = d.gifts || {}, dn = d.donors || {}, v = d.volunteers || {};
    var pg = (d.in_progress ? g.prev_to_date : g.prev) || {}, pv = (d.in_progress ? v.prev_to_date : v.prev) || {};
    var pwhen = d.in_progress ? d.prev_label + ' at this point' : d.prev_label;
    var years = (d.years || [d.fy]).map(Number);
    var sum = rpSummary(d);
    root.innerHTML = head +
      '<div class="w160rep" data-w160fyshown="' + E(d.fy) + '">' +
      '<div class="w152bar w160top w160noprint"><select class="w152sel" data-w160fy aria-label="Fiscal year">' + years.map(function (y) {
        return '<option value="' + y + '"' + (y === Number(d.fy) ? ' selected' : '') + '>Fiscal year ' + E(rpLabel(y)) + (y === years[0] ? ' (this year)' : '') + '</option>';
      }).join('') + '</select>' +
      '<button class="w152btn" data-w160copy="1">' + I('copy') + ' Copy the summary</button><button class="w152btn ghost" data-w160print="1">' + I('print') + ' Print</button>' +
      '<button class="w152mini" data-w160reload="1" title="Work the numbers out again">' + I('refresh') + ' Refresh</button>' +
      '<span class="w160asof">Figures as of ' + E(fmtDay(d.today)) + (d.at ? ', ' + E(new Date(d.at).toLocaleTimeString('en-CA', { hour: 'numeric', minute: '2-digit', timeZone: 'America/Toronto' })) : '') + '</span></div>' +
      '<h2 class="w160title">Fiscal year ' + E(d.label) + (d.in_progress ? ' <span>so far, to ' + E(fmtDay(d.through)) + '</span>' : '') + '</h2>' +
      '<div class="w152stats w160stats">' +
      '<div class="w152st"><b>' + E(money(g.total || 0)) + '</b><span>raised in ' + E(plural(g.count || 0, 'gift', 'gifts')) + ' (' + E(pwhen) + ': ' + E(money(pg.total || 0)) + ')</span></div>' +
      '<div class="w152st"><b>' + rpNum(dn.this_year) + '</b><span>donors, ' + rpNum(dn.new) + ' new (' + E(pwhen) + ': ' + rpNum(pg.donors) + ')</span></div>' +
      '<div class="w152st"><b>' + rpNum(v.people) + '</b><span>volunteers served, ' + rpNum(v.new) + ' for the first time (' + E(pwhen) + ': ' + rpNum(pv.people) + ')</span></div>' +
      '<div class="w152st"><b>' + rpNum(v.servings) + '</b><span>servings at ' + E(plural(v.events || 0, 'event', 'events')) + ' (' + E(pwhen) + ': ' + rpNum(pv.servings) + ')</span></div></div>' +
      '<div class="w154grid w160grid">' +
      '<section class="w154card wide w160sum"><h3>' + I('note') + ' The year in a few lines <span class="m">ready for the board</span></h3>' + sum.map(function (s) { return '<p>' + E(s) + '</p>'; }).join('') + '</section>' +
      rpGiftsHtml(d) + rpSizesHtml(d) + rpDonorsHtml(d) + rpMailHtml(d) + rpVolHtml(d) + rpNotesHtml(d) + '</div></div>';
  }
  function rpMakeList() {
    var d = rpGet(); if (!d || RP.listing) return;
    var ids = ((d.donors || {}).lapsed_list || []).map(function (x) { return Number(x.contact_id); }).filter(function (x) { return x && contact(x); });
    if (!ids.length) { RP.msg = 'Nobody to put on a list.'; paint(); return; }
    var name = 'Gave in ' + d.prev_label + ', not ' + (d.in_progress ? 'yet ' : '') + 'in ' + d.label;
    var row = { name: name, description: 'Donors who gave in ' + d.prev_label + ' and had not given in ' + d.label + ' on ' + fmtDay(d.today) + ' (made in Reports).', kind: 'static',
      filter: { groups: [] }, member_ids: ids, created_by: actor(), updated_by: actor(), updated_at: new Date().toISOString() };
    RP.listing = true; RP.msg = ''; paint();
    Promise.resolve(db.from('crm_lists').insert(row).select().single()).then(function (r) {
      RP.listing = false;
      if (r && r.error) RP.msg = 'Not saved: ' + (r.error.message || r.error);
      else { RP.msg = '\u201c' + name + '\u201d saved as a fixed list of ' + plural(ids.length, 'person', 'people') + '.'; S.at.lists = 0; }
      if (S.ui.tab === 'reports') paint();
    }, function (e) { RP.listing = false; RP.msg = 'Not saved: ' + ((e && e.message) || e); if (S.ui.tab === 'reports') paint(); });
  }

  /* ---------- styles ---------- */
  var css160 = document.createElement('style'); css160.id = 'w160css';
  css160.textContent = ''
    + '.w160top{align-items:center;}.w160top .w152sel{flex:0 1 260px;max-width:280px;}.w160asof{font-size:12.5px;color:var(--wa-muted,' + MUTED + ');margin-left:auto;}'
    + '.w160title{font-family:' + HEAD + ';font-size:30px;font-weight:600;text-transform:uppercase;letter-spacing:.4px;color:var(--wa-green,' + GREEN + ');margin:6px 0 12px;}.w160title span{font-family:' + BODY + ';font-size:14px;font-weight:500;text-transform:none;letter-spacing:0;color:var(--wa-muted,' + MUTED + ');}'
    + '.w160stats{margin-bottom:16px;}.w160stats .w152st{cursor:default;}.w160stats .w152st span{line-height:1.35;}'
    + '.w160sum p{font-size:15px;line-height:1.6;margin:0 0 8px;}'
    + '.w160ch{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:6px;align-items:end;height:150px;padding-top:6px;border-bottom:1px solid rgba(16,63,57,.18);}'
    + '.w160col{height:100%;min-width:0;display:flex;}.w160bars{flex:1;display:flex;align-items:flex-end;justify-content:center;gap:2px;}'
    + '.w160bars i{display:block;width:42%;max-width:18px;border-radius:4px 4px 0 0;}.w160bars i.c,.w160lg i.c{background:' + GREEN + ';}.w160bars i.p,.w160lg i.p{background:rgba(220,165,39,.6);}'
    + '.w160ml{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:6px;font-size:11px;color:var(--wa-muted,' + MUTED + ');text-align:center;margin-top:4px;}'
    + '.w160lg{display:flex;flex-wrap:wrap;gap:6px 16px;font-size:12.5px;color:var(--wa-muted,' + MUTED + ');margin-top:8px;}.w160lg i{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:6px;vertical-align:-1px;}'
    + '.w160ret{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin:0 0 12px;}.w160ret>div{background:rgba(16,63,57,.05);border-radius:12px;padding:10px 12px;min-width:0;}'
    + '.w160ret b{display:block;font-family:' + HEAD + ';font-size:28px;font-weight:600;color:var(--wa-green,' + GREEN + ');line-height:1.05;}.w160ret span{display:block;font-size:12.5px;line-height:1.3;color:var(--wa-muted,' + MUTED + ');}'
    + '.w160h4{font-weight:700;font-size:12.5px;text-transform:uppercase;letter-spacing:.6px;color:var(--wa-green,' + GREEN + ');margin:14px 0 4px;}'
    + '.w160rows{display:flex;flex-direction:column;}.w160r{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(40px,.8fr) auto;gap:10px;align-items:center;padding:7px 0;border-bottom:1px dashed rgba(16,63,57,.12);font-size:13.5px;}'
    + '.w160r .k{min-width:0;overflow:hidden;text-overflow:ellipsis;}.w160r .k a{color:inherit;font-weight:600;}.w160r .bar{height:8px;border-radius:4px;background:rgba(16,63,57,.08);overflow:hidden;}.w160r .bar i{display:block;height:100%;background:' + TEAL + ';border-radius:4px;}'
    + '.w160r .v{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap;font-weight:600;}.w160lap .w160r{grid-template-columns:minmax(0,1fr) 0 auto;}'
    + '.w160note{font-size:12.5px;line-height:1.55;color:var(--wa-muted,' + MUTED + ');margin:10px 0 0;}.w160note a{color:inherit;font-weight:600;}'
    + '@media (max-width:700px){.w160ret{grid-template-columns:repeat(2,minmax(0,1fr));}.w160ch{height:120px;gap:3px;}.w160ml{gap:3px;font-size:10px;}.w160asof{margin-left:0;flex:1 1 100%;}.w160title{font-size:24px;}.w160r{grid-template-columns:minmax(0,1.5fr) minmax(30px,.6fr) auto;}}'
    + '@media print{body *{visibility:hidden !important;}.w160rep,.w160rep *{visibility:visible !important;}.w160rep{position:absolute;left:0;top:0;width:100%;}.w160noprint{display:none !important;}.w160rep .w154card{box-shadow:none;border:1px solid rgba(16,63,57,.2);break-inside:avoid;}}';
  document.head.appendChild(css160);

  /* ---------- wiring ---------- */
  document.addEventListener('click', function (e) {
    var t = e.target, el; if (!t || !t.closest || !t.closest('.w160rep, .w152root')) return;
    if ((el = t.closest('[data-w160copy]'))) { e.preventDefault(); var d = rpGet(); if (d) copy('Fiscal year ' + d.label + (d.in_progress ? ', to ' + fmtDay(d.through) : '') + '\n\n' + rpSummary(d).join('\n\n')); return; }
    if ((el = t.closest('[data-w160print]'))) { e.preventDefault(); try { window.print(); } catch (x) { /* fine */ } return; }
    if ((el = t.closest('[data-w160reload]'))) { e.preventDefault(); RP.err = ''; RP.msg = ''; rpLoad(RP.fy, true).then(function () { if (S.ui.tab === 'reports') paint(); }); paint(); return; }
    if ((el = t.closest('[data-w160lapsed]'))) { e.preventDefault(); RP.showLapsed = true; paint(); return; }
    if ((el = t.closest('[data-w160list]'))) { e.preventDefault(); rpMakeList(); return; }
  });
  document.addEventListener('change', function (e) {
    var t = e.target; if (!t || !t.hasAttribute || !t.hasAttribute('data-w160fy')) return;
    var y = Number(t.value), d = rpGet(), cur = d && d.years && d.years.length ? Number(d.years[0]) : null;
    go(y === cur ? '#crm/reports' : '#crm/reports/' + y);
  });
  /* ======================= Leaving Keela (wave159a, 28/09/26) =======================
     The first part of step 7 of the plan (wave159, leaving Keela): a live checklist at the top of Sources. Each thing Keela does
     today, what the Hub has in its place, whose step is next, and the date that matters: Keela bills quarterly (the next charge in
     app_config keela_next_charge) and cancelling needs keela_notice_days of notice, so every step aims to be done a week before
     that. Read from the Hub: the contacts and gifts from Keela, the forms and automations (drafts, live, on), the email mode, the
     receipt mode and settings. The final export and import, and the donation form, are Steel's steps and read as such. */
  LOADERS.kcfg = function () { return db.from('app_config').select('key,value').in('key', ['mail_mode', 'receipt_mode', 'receipt_signatory_name', 'receipt_next_number', 'keela_next_charge', 'keela_notice_days', 'keela_quarterly_cost', 'keela_donation_form', 'donate_mode', 'donate_webhook']); };
  function kcfg(k) { var r = (S.kcfg || []).filter(function (x) { return x.key === k; })[0]; return r ? String(r.value == null ? '' : r.value) : ''; }
  function kDays(day) { var n = daysSince(day); return n == null ? null : -n; }
  function kChip(state) {
    var d = { done: ['Done', GREEN], doing: ['In progress', TEAL], waiting: ['Waiting on a decision', '#B9851B'], todo: ['To do', FLAG] }[state] || ['?', MUTED];
    return '<span class="w154chip" style="background:' + d[1] + '17;color:' + d[1] + '"><i style="background:' + d[1] + '"></i>' + E(d[0]) + '</span>';
  }
  function keelaSteps() {
    var contacts = (S.contacts || []).filter(function (c) { return c.source === 'keela' || (c.legacy_refs && c.legacy_refs.keela_contact_id); }).length;
    var kg = (S.gifts || []).filter(function (g) { return lower(g.platform) === 'keela'; });
    var lastKg = kg.map(function (g) { return dayOf(g.donated_at); }).sort().pop() || '';
    var forms = S.forms || [], live = forms.filter(function (f) { return f.status === 'live'; });
    var autos = S.autos || [], on = autos.filter(function (a) { return a.status === 'on'; });
    var paste = autos.filter(function (a) { return /\[Paste/i.test(JSON.stringify(a.steps || [])); });
    var mail = kcfg('mail_mode') || 'test', rmode = kcfg('receipt_mode') || 'off';
    var rMissing = []; if (!kcfg('receipt_signatory_name')) rMissing.push('who signs'); if (!/^\d+$/.test(kcfg('receipt_next_number'))) rMissing.push('the numbering');
    var donation = kcfg('keela_donation_form'), page = kcfg('donate_mode') === 'live', built = !!kcfg('donate_webhook');
    return [
      { t: 'Contacts and gifts', k: 'Keela holds the donors, supporters and gifts.', s: S.gifts ? 'doing' : 'doing',
        h: plural(contacts, 'contact', 'contacts') + ' and ' + plural(kg.length, 'gift', 'gifts') + ' from Keela are in the Hub' + (lastKg ? ' (the latest gift from ' + fmtDay(lastKg) + ')' : '') + '.',
        n: 'Last: a final export from Keela (contacts with their subscription status and custom fields, the transactions with the receipts, the form answers that prove consent), imported and checked against Keela\u2019s counts. Steel downloads; the assistant imports.' },
      { t: 'Forms', k: 'Keela\u2019s volunteer, Toronto and newsletter forms on the website.', s: forms.length && live.length === forms.length ? 'done' : live.length ? 'doing' : 'todo',
        h: forms.length ? plural(live.length, 'form is', 'forms are') + ' live of ' + forms.length + ' in the Hub' + (live.length < forms.length ? ' (the others are drafts)' : '') + '.' : 'No form in the Hub yet.',
        n: live.length === forms.length && forms.length ? 'Close the matching Keela forms.' : 'Steel reads the drafts and puts them live in Forms, then the website\u2019s buttons point to hub.welfareavenue.com/f/ and the Keela forms close.' },
      { t: 'Automations', k: 'Keela\u2019s welcome series, donor follow-up and rally follow-up.', s: autos.length && on.length === autos.length ? 'done' : on.length ? 'doing' : 'todo',
        h: plural(on.length, 'automation is', 'automations are') + ' on of ' + autos.length + (paste.length ? '; ' + plural(paste.length, 'draft still needs', 'drafts still need') + ' the words of Keela\u2019s emails' : '') + '.',
        n: paste.length ? 'Paste the words of Keela\u2019s welcome emails into the drafts (or have the assistant copy them from Keela), try each on yourself, then turn them on once the forms are live.' : 'Try each on yourself, then turn them on once the forms are live.' },
      { t: 'Email', k: 'Keela sends the newsletters and campaigns.', s: mail === 'live' ? 'done' : 'todo',
        h: 'The Hub\u2019s email is in ' + (mail === 'live' ? 'live mode.' : 'test mode: only the test addresses get email.'),
        n: mail === 'live' ? 'Send the next newsletter from Campaigns.' : 'Steel switches the mode to live in Email when real sends should start (Resend\u2019s free plan sends up to 100 a day).' },
      { t: 'Tax receipts', k: 'Keela issued 55 receipts (KEE numbers).', s: rmode === 'on' ? 'done' : rMissing.length ? 'waiting' : 'todo',
        h: 'Receipts from the Hub are ' + (rmode === 'on' ? 'on.' : 'off' + (rMissing.length ? ' (missing: ' + listJoin(rMissing) + ').' : ', and ready to turn on.')),
        n: rmode === 'on' ? 'Issue from Receipts; the year-end run in January.' : 'The treasurer reviews a sample PDF and fills the settings with the signature; the treasurer and Steel decide to turn them on.' },
      { t: 'Online donations', k: 'Keela\u2019s donation form on the website.', s: page || donation ? 'done' : built ? 'doing' : 'waiting',
        h: page ? 'The Hub\u2019s donation page is live (hub.welfareavenue.com/give, paid on Stripe).' : donation ? 'Donations go through ' + donation + '.' :
          built ? 'The Hub\u2019s donation page is built (Stripe: once or monthly, where it goes, tributes) and off.' : 'Not decided: Zeffy, if its embedded forms can be fully customized, or another option.',
        n: page || donation ? 'Point the website\u2019s Donate buttons at the new page and take Keela\u2019s form off the website.' :
          built ? 'Steel reads the page and puts it live in Gifts, Online giving; then the website\u2019s Donate buttons point to hub.welfareavenue.com/give.' : 'Steel\u2019s decision (Zeffy); until then Keela\u2019s form stays on the website.' }
    ];
  }
  function keelaHtml() {
    var steps = keelaSteps(), done = steps.filter(function (x) { return x.s === 'done'; }).length;
    var charge = kcfg('keela_next_charge'), notice = Number(kcfg('keela_notice_days')) || 7, cost = kcfg('keela_quarterly_cost');
    var by = charge ? (function () { var t = Date.parse(charge + 'T12:00:00Z') - notice * 86400000; return new Date(t).toISOString().slice(0, 10); })() : '';
    var aim = by ? (function () { var t = Date.parse(by + 'T12:00:00Z') - 7 * 86400000; return new Date(t).toISOString().slice(0, 10); })() : '';
    var left = by ? kDays(by) : null;
    return '<div class="w152card w159k"><h3>Leaving Keela <span>' + done + ' of ' + steps.length + ' done</span></h3>' +
      (charge ? '<p class="w159kd"><b>' + (left != null && left >= 0 ? plural(left, 'day', 'days') + ' to give notice' : 'The notice date has passed') + '</b> Keela\u2019s next charge is on ' + E(fmtDay(charge)) + (cost ? ' ($' + E(cost) + ' a quarter)' : '') +
        '; cancelling needs ' + plural(notice, 'day', 'days') + '\u2019 notice, so by ' + E(fmtDay(by)) + '. The aim is every step below done by ' + E(fmtDay(aim)) + '.</p>' : '') +
      '<div class="w159ks">' + steps.map(function (x) {
        return '<div class="w159kr"><div class="h"><b>' + E(x.t) + '</b>' + kChip(x.s) + '</div><p class="m">' + E(x.k) + '</p><p>' + E(x.h) + '</p><p class="nx">' + I('arrow') + ' ' + E(x.n) + '</p></div>';
      }).join('') + '</div></div>';
  }
  var css159 = document.createElement('style'); css159.id = 'w159css';
  css159.textContent = ''
    + '.w159k{grid-column:1/-1;}.w159kd{font-size:14px;line-height:1.5;margin:0 0 12px;}.w159kd b{color:' + GREEN + ';margin-right:6px;}'
    + '.w159ks{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;}.w159kr{background:rgba(16,63,57,.04);border-radius:12px;padding:12px 14px;min-width:0;}'
    + '.w159kr .h{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:6px;margin-bottom:4px;}.w159kr p{margin:4px 0;font-size:13px;line-height:1.45;}.w159kr .m{color:' + MUTED + ';font-size:12.5px;}'
    + '.w159kr .nx{color:' + INK + ';font-weight:500;}.w159kr .nx .w152i{width:13px;height:13px;vertical-align:-2px;color:' + TEAL + ';}'
    + '@media (max-width:980px){.w159ks{grid-template-columns:repeat(2,minmax(0,1fr));}}@media (max-width:700px){.w159ks{grid-template-columns:1fr;}}';
  document.head.appendChild(css159);

  /* ======================= Online giving (wave161, 28/09/26) =======================
     The CRM side of the Hub's donation page, hub.welfareavenue.com/give (paid on Welfare Avenue's Stripe account), at
     #crm/gifts/online (the Online giving button in Gifts):
     - The page: live or off, a link to see it (a preview that takes no gift while it is off), and what it says and offers
       (the title and words, the amounts for once and monthly, the smallest and largest gift, where gifts can go, the card-fee
       option, the news box's words, the thank-you, receipt and monthly notes). Admins save them (donate_* settings, which
       the database refuses to anyone else). Put it live asks first and goes through crm_donate_mode_set (admins, logged,
       only once Stripe is set up); Take it down stops new gifts at once.
     - This fiscal year online: the gifts, their total, what Stripe kept in fees, the monthly gifts going, and (admins) how
       many checkouts were started.
     - Monthly gifts: each with its donor, amount, state (active, payment failed, ending, stopped), where it goes, since when,
       the last and next payment, and what it has given so far, with a link to it in Stripe.
     - For admins, what Stripe told the Hub lately (crm_stripe_events): each event, what the Hub did, and any error. */
  P.card = '<rect x="3" y="5.5" width="18" height="13" rx="2.5"/><path d="M3 10h18M7 15h4"/>';
  var DG = { confirm: false, busy: '', msg: '', err: '', draft: {} }; /* draft: what an admin typed and has not saved, kept across repaints */
  var GIVE_URL = 'https://hub.welfareavenue.com/give';
  var DSET = [ /* [setting, label, hint, kind] */
    ['donate_title', 'Title', '', 'text'],
    ['donate_intro', 'The words under the title', '', 'area'],
    ['donate_amounts_once', 'Amounts to give once', 'dollars, separated by commas', 'text'],
    ['donate_amounts_monthly', 'Amounts to give monthly', 'dollars, separated by commas', 'text'],
    ['donate_min', 'The smallest gift ($)', '', 'num'],
    ['donate_max', 'The largest gift online ($)', 'above it, donors are asked to write to you', 'num'],
    ['donate_designations', 'Where gifts can go', 'one per line; the first is chosen unless the donor picks another; with one line donors are not asked', 'area'],
    ['donate_fee_cover', 'Offer to cover the card fee', '', 'onoff'],
    ['donate_consent_label', 'The news box', 'the words the donor ticks to get your emails: their express consent', 'area'],
    ['donate_thanks', 'The thank-you', 'shown after the payment', 'area'],
    ['donate_receipt_note', 'The receipt note', '{charity} becomes the charity number', 'area'],
    ['donate_monthly_note', 'The note for monthly donors', '{email} becomes your reply-to address', 'area']
  ];
  LOADERS.dcfg = function () { return db.from('app_config').select('key,value').in('key', DSET.map(function (d) { return d[0]; }).concat(['donate_mode', 'donate_product', 'donate_webhook', 'donate_fee_percent', 'donate_fee_fixed'])); };
  LOADERS.plans = function () { return db.from('crm_gift_plans').select('id,external_id,contact_id,amount,currency,status,designation,tribute_kind,tribute_name,started_at,next_payment_at,last_paid_at,last_failed_at,ends_at,cancelled_at,cancel_reason').order('started_at', { ascending: false }).limit(2000); };
  LOADERS.sevents = function () { return amAdmin() ? db.from('crm_stripe_events').select('id,type,status,received_at,attempts,result,error').order('received_at', { ascending: false }).limit(25) : Promise.resolve({ data: [] }); };
  LOADERS.dtries = function () { return amAdmin() ? db.from('crm_donate_attempts').select('id,created_at,status,frequency,amount_cents').gte('created_at', dgFyStart() + 'T04:00:00Z').order('created_at', { ascending: false }).limit(3000) : Promise.resolve({ data: [] }); };
  function dgFyStart() { var y = Number(fyOf(today())); return (y - 1) + '-10-01'; }
  function dget(k) { var r = (S.dcfg || []).filter(function (x) { return x.key === k; })[0]; return r ? String(r.value == null ? '' : r.value) : ''; }
  function dgChip(d) { return '<span class="w154chip" style="background:' + d[1] + '17;color:' + d[1] + '"><i style="background:' + d[1] + '"></i>' + E(d[0]) + '</span>'; }
  var PLAN_ST = { active: ['Active', GREEN], past_due: ['Payment failed', FLAG], paused: ['Paused', '#B9851B'], incomplete: ['Not started', MUTED], cancelled: ['Stopped', MUTED] };
  function planState(p) { return p.status === 'active' && p.ends_at ? ['Ending ' + fmtDay(p.ends_at), '#B9851B'] : PLAN_ST[p.status] || [p.status || '?', MUTED]; }
  function whyStopped(s) {
    var m = { cancellation_requested: 'they asked', payment_failed: 'payments failed', payment_disputed: 'a disputed payment', too_expensive: 'too expensive', unused: 'not using it',
      switched_service: 'gave elsewhere', low_quality: 'not happy', customer_service: 'service', too_complex: 'too complicated', missing_features: 'missing something', other: 'other' };
    return String(s || '').split(/:\s*/).filter(Boolean).map(function (x) { return m[x] || x.replace(/_/g, ' '); }).join(': ');
  }
  function stripeLink(g) {
    var x = String(g.external_id || '');
    return /^pi_/.test(x) ? 'https://dashboard.stripe.com/payments/' + x : /^in_/.test(x) ? 'https://dashboard.stripe.com/invoices/' + x : '';
  }
  function dgWhen(s) {
    if (!s) return '';
    try { return fmtDay(s) + ', ' + new Date(s).toLocaleTimeString('en-CA', { hour: 'numeric', minute: '2-digit', timeZone: 'America/Toronto' }); } catch (e) { return fmtDay(s); }
  }
  var EVT = { 'checkout.session.completed': 'A checkout finished', 'checkout.session.async_payment_succeeded': 'A bank payment cleared', 'checkout.session.async_payment_failed': 'A bank payment failed',
    'invoice.paid': 'A monthly payment', 'invoice.payment_failed': 'A monthly payment failed', 'charge.refunded': 'A refund', 'customer.subscription.created': 'A monthly gift started',
    'customer.subscription.updated': 'A monthly gift changed', 'customer.subscription.deleted': 'A monthly gift stopped' };

  function onlineHtml() {
    var live = dget('donate_mode') === 'live', admin = amAdmin(), ready = !!dget('donate_product') && !!dget('donate_webhook');
    var sum = function (a, k) { return a.reduce(function (t, g) { return t + (Number(g[k]) || 0); }, 0); };
    var gifts = (S.gifts || []).filter(function (g) { return lower(g.platform) === 'stripe' && !(Number(g.refunded_amount) > 0 && !(Number(g.amount) > 0)); }); /* a gift refunded in full counts nowhere */
    var fy = fyOf(today()), cur = gifts.filter(function (g) { return fyOf(g.donated_at) === fy; });
    var plans = S.plans || [], going = plans.filter(function (p) { return p.status === 'active' || p.status === 'past_due'; });
    var tries = (S.dtries || []).filter(function (t) { return t.status === 'session'; });
    var st = function (b, s) { return '<div class="w152st"><b>' + b + '</b><span>' + s + '</span></div>'; };

    var page = '<div class="w154card w161card"><h3>' + I('heart') + ' The donation page ' + dgChip(live ? ['Live', GREEN] : ['Off', MUTED]) + '</h3>' +
      '<p class="w161p">' + (live
        ? 'Live at <a href="' + GIVE_URL + '" target="_blank" rel="noopener">hub.welfareavenue.com/give</a>. Donors give once or monthly on Stripe\u2019s secure page, and each gift lands in Gifts on its own: the donor, where it goes, a tribute, the fee, the news box if they ticked it, and any refund.'
        : 'Off: the page tells visitors that online giving opens soon. <a href="' + GIVE_URL + '?preview=1" target="_blank" rel="noopener">See it as donors will</a> (a preview that takes no gift).') + '</p>' +
      '<ul class="w161ready"><li class="' + (ready ? 'ok' : 'no') + '">' + I(ready ? 'check' : 'alert') + '<span>' + (ready ? 'Welfare Avenue\u2019s Stripe account is connected: the gift donors see and the Hub\u2019s webhook are set up.' : 'Stripe is not set up yet (the build does it).') + '</span></li>' +
      '<li class="' + (live ? 'ok' : 'todo') + '">' + I(live ? 'check' : 'arrow') + '<span>' + (live ? 'The website\u2019s Donate buttons should point here; then Keela\u2019s donation form can close.' : 'Once it is live: point the website\u2019s Donate buttons at hub.welfareavenue.com/give, then close Keela\u2019s donation form.') + '</span></li></ul>' +
      (admin ? (DG.confirm
          ? '<div class="w155cf"><b>Put the donation page live?</b> From then on anyone with the link can give, paid into Welfare Avenue\u2019s Stripe account, and each gift is recorded here. Monthly gifts carry on until the donor or the team stops them.' +
            '<div class="w154acts"><button class="w152btn" data-w161mode="live"' + (DG.busy ? ' disabled' : '') + '>' + I('check') + ' Put it live</button><button class="w152btn ghost" data-w161no="1">Not yet</button></div></div>'
          : '<div class="w154acts">' + (live ? '<button class="w152btn ghost" data-w161mode="off"' + (DG.busy ? ' disabled' : '') + '>' + I('x') + ' Take it down</button>'
              : '<button class="w152btn" data-w161ask="1"' + (ready ? '' : ' disabled title="Stripe is not set up yet"') + '>' + I('check') + ' Put it live\u2026</button>') + '</div>')
        : '<p class="m">An admin puts the page live or takes it down.</p>') +
      (DG.msg ? '<div class="w154msg">' + E(DG.msg) + '</div>' : '') + (DG.err ? '<div class="w154msg err" role="alert">' + E(DG.err) + '</div>' : '') + '</div>';

    var stats = '<div class="w152stats w161stats">' +
      st(E(money(sum(cur, 'amount'))), 'given online this fiscal year (' + plural(cur.length, 'gift', 'gifts') + ')') +
      st(E(cents(sum(cur, 'fee'))), 'kept by Stripe in fees') +
      st(E(money(going.reduce(function (t, p) { return t + (Number(p.amount) || 0); }, 0))), 'a month from ' + plural(going.length, 'monthly gift', 'monthly gifts')) +
      (admin ? st(tries.length.toLocaleString('en-CA'), 'checkouts started this year') : '') + '</div>';

    var planRow = function (p) {
      var c = contact(p.contact_id), nm = c ? c.full_name : p.contact_id ? 'Contact ' + p.contact_id : 'Donor not known yet';
      var paid = (S.gifts || []).filter(function (g) { return String(g.plan_id) === String(p.id); });
      var note = p.status === 'cancelled' ? 'Stopped ' + fmtDay(p.cancelled_at) + (p.cancel_reason ? ' (' + whyStopped(p.cancel_reason) + ')' : '')
        : p.status === 'past_due' && p.last_failed_at ? 'Failed ' + fmtDay(p.last_failed_at) + '; Stripe tries again' : p.next_payment_at ? 'Next ' + fmtDay(p.next_payment_at) : '';
      return '<div class="w152row w161prow" role="listitem">' +
        '<span>' + (c ? '<a href="#crm/c/' + E(c.id) + '">' + E(nm) + '</a>' : E(nm)) + (c && c.emails[0] ? '<div class="m">' + E(c.emails[0]) + '</div>' : '') + '</span>' +
        '<span class="amt">' + E(cents(p.amount)) + '<small> a month</small>' + (p.tribute_kind ? '<div class="m">' + E((p.tribute_kind === 'memory' ? 'In memory of ' : 'In honour of ') + (p.tribute_name || '')) + '</div>' : '') + '</span>' +
        '<span>' + dgChip(planState(p)) + (note ? '<div class="m">' + E(note) + '</div>' : '') + '</span>' +
        '<span>' + E(p.designation || '\u2013') + '<div class="m">Since ' + E(fmtDay(p.started_at)) + '</div></span>' +
        '<span>' + E(money(sum(paid, 'amount'))) + '<div class="m">' + plural(paid.length, 'payment', 'payments') + (p.last_paid_at ? ', the last ' + E(fmtDay(p.last_paid_at)) : '') + '</div></span>' +
        '<span><a class="w152mini" href="https://dashboard.stripe.com/subscriptions/' + E(p.external_id) + '" target="_blank" rel="noopener">' + I('ext') + ' Stripe</a></span></div>';
    };
    var monthly = '<div class="w154card w161plans"><h3>' + I('refresh') + ' Monthly gifts <span class="m">' + plural(going.length, 'going', 'going') + ' of ' + plans.length + '</span></h3>' +
      (plans.length ? '<div class="w152list" role="list"><div class="w152lh" aria-hidden="true"><span>Donor</span><span>Amount</span><span>State</span><span>Where it goes</span><span>Given so far</span><span></span></div>' + plans.map(planRow).join('') + '</div>'
        : '<p class="m">No monthly gift yet. Donors start one on the page (Give monthly); each month\u2019s payment then comes in as a gift.</p>') +
      '<p class="m w161foot">A donor who wants to change or stop a monthly gift writes to you; stop or change it in Stripe (the link on the row), and the Hub follows.</p></div>';

    var evs = S.sevents || [];
    var events = admin ? '<div class="w154card w161events"><h3>' + I('bell') + ' What Stripe told the Hub lately</h3>' +
      (evs.length ? '<div class="w161evl">' + evs.map(function (x) {
          var s = { done: ['Recorded', GREEN], ignored: ['Not the page\u2019s', MUTED], error: ['Error: Stripe sends it again', FLAG], received: ['Received', TEAL] }[x.status] || [x.status, MUTED];
          var why = x.error ? x.error : x.result && x.result.ignored ? x.result.ignored : x.result && x.result.waiting ? x.result.waiting : x.result && x.result.receipt_needs_attention ? 'Refunded after receipt ' + x.result.receipt_needs_attention + ': cancel or replace it' : '';
          return '<div class="w161ev"><span>' + E(dgWhen(x.received_at)) + '</span><span>' + E(EVT[x.type] || x.type) + (x.attempts > 1 ? ' <span class="m">(' + x.attempts + ' tries)</span>' : '') + '</span><span>' + dgChip(s) + (why ? '<div class="m">' + E(why) + '</div>' : '') + '</span></div>';
        }).join('') + '</div>' : '<p class="m">Nothing yet. Each payment, monthly payment, refund and change to a monthly gift shows here as Stripe sends it.</p>') + '</div>' : '';

    var setv = function (d) {
      var k = d[0], v = Object.prototype.hasOwnProperty.call(DG.draft, k) ? DG.draft[k] : dget(k), dis = admin ? '' : ' disabled';
      var input = d[3] === 'area' ? '<textarea class="w152in" rows="' + (k === 'donate_designations' ? 3 : 2) + '" data-w161set="' + k + '"' + dis + '>' + E(v) + '</textarea>'
        : d[3] === 'onoff' ? '<select class="w152sel" data-w161set="' + k + '"' + dis + '><option value="on"' + (v !== 'off' ? ' selected' : '') + '>Yes, donors can add it</option><option value="off"' + (v === 'off' ? ' selected' : '') + '>No</option></select>'
        : '<input class="w152in"' + (d[3] === 'num' ? ' type="number" min="1" step="1"' : '') + ' data-w161set="' + k + '" value="' + E(v) + '"' + dis + '>';
      return '<label class="w155lb' + (d[3] === 'area' ? ' full' : '') + '">' + E(d[1]) + (d[2] ? ' <span class="m">' + E(d[2]) + '</span>' : '') + input + '</label>';
    };
    var settings = '<div class="w154card w161set"><h3>' + I('edit') + ' What the page says and offers</h3>' + (admin ? '' : '<p class="m">Only an admin changes these.</p>') +
      '<div class="w161grid">' + DSET.map(setv).join('') + '</div>' +
      (admin ? '<div class="w154acts"><button class="w152btn" data-w161save="1"' + (DG.busy ? ' disabled' : '') + '>' + I('check') + ' Save</button><a class="w152btn ghost" href="' + GIVE_URL + '?preview=1" target="_blank" rel="noopener">' + I('ext') + ' See the page</a></div>' : '') + '</div>';

    return '<div class="w161">' + page + stats + monthly + settings + events +
      '<div class="w154acts"><button class="w152btn ghost" data-w152go="#crm/gifts">Back to the gifts</button></div></div>';
  }

  function dgSave() {
    var rows = [];
    document.querySelectorAll('#crm [data-w161set]').forEach(function (el) { rows.push({ key: el.getAttribute('data-w161set'), value: String(el.value || '').trim() }); });
    var get = function (k) { return (rows.filter(function (r) { return r.key === k; })[0] || {}).value || ''; };
    var set = function (k, v) { rows.forEach(function (r) { if (r.key === k) r.value = v; }); };
    var nums = function (s) { return String(s).split(/[,\s]+/).filter(Boolean); };
    var bad = '';
    ['donate_amounts_once', 'donate_amounts_monthly'].forEach(function (k) {
      var n = nums(get(k));
      if (!n.length || n.length > 6 || n.some(function (x) { return !(Number(x) > 0) || Math.abs(Number(x) * 100 - Math.round(Number(x) * 100)) > 0.001; })) bad = bad || 'The amounts: up to six numbers in dollars, separated by commas.';
      else set(k, n.map(Number).join(', '));
    });
    if (!get('donate_title')) bad = 'The page needs a title.';
    else if (!(Number(get('donate_min')) >= 1)) bad = 'The smallest gift is at least $1.';
    else if (!(Number(get('donate_max')) > Number(get('donate_min')))) bad = 'The largest gift must be more than the smallest.';
    else if (!get('donate_designations').split(/\n/).map(function (x) { return x.trim(); }).filter(Boolean).length) bad = 'Where gifts can go: at least one line.';
    else if (!get('donate_consent_label')) bad = 'The news box needs its words: they are the donor\u2019s consent.';
    if (bad) { DG.err = bad; DG.msg = ''; paint(); return; }
    DG.busy = 'save'; DG.err = ''; DG.msg = ''; paint();
    var at = new Date().toISOString();
    Promise.resolve(db.from('app_config').upsert(rows.map(function (r) { return { key: r.key, value: r.value, updated_at: at }; }), { onConflict: 'key' })).then(function (r) {
      DG.busy = '';
      if (r && r.error) { DG.err = 'Not saved: ' + String(r.error.message || r.error); paint(); return; }
      DG.msg = 'Saved. The page shows it to the next visitor.'; DG.draft = {};
      load('dcfg', true).then(function () { if (S.ui.tab === 'gifts') paint(); });
    }, function (e) { DG.busy = ''; DG.err = 'Not saved: ' + String((e && e.message) || e); paint(); });
  }
  function dgMode(mode) {
    DG.confirm = false; DG.busy = 'mode'; DG.msg = ''; DG.err = ''; paint();
    Promise.resolve(db.rpc('crm_donate_mode_set', { p_mode: mode })).then(function (r) {
      DG.busy = '';
      if (r && r.error) { DG.err = String(r.error.message || r.error); paint(); return; }
      DG.msg = mode === 'live' ? 'The donation page is live.' : 'The donation page is off: it now says online giving opens soon.';
      Promise.all([load('dcfg', true), load('kcfg', true)]).then(function () { if (S.ui.tab === 'gifts') paint(); });
    }, function (e) { DG.busy = ''; DG.err = String((e && e.message) || e); paint(); });
  }
  document.addEventListener('click', function (e) {
    var t = e.target, el; if (!t || !t.closest || !t.closest('#crm')) return;
    if ((el = t.closest('[data-w161ask]'))) { e.preventDefault(); DG.confirm = true; DG.msg = ''; DG.err = ''; paint(); return; }
    if ((el = t.closest('[data-w161no]'))) { e.preventDefault(); DG.confirm = false; paint(); return; }
    if ((el = t.closest('[data-w161mode]'))) { e.preventDefault(); dgMode(el.getAttribute('data-w161mode')); return; }
    if ((el = t.closest('[data-w161save]'))) { e.preventDefault(); dgSave(); return; }
  });
  function dgKeep(e) { var t = e.target; if (t && t.hasAttribute && t.hasAttribute('data-w161set')) DG.draft[t.getAttribute('data-w161set')] = t.value; }
  document.addEventListener('input', dgKeep);
  document.addEventListener('change', dgKeep);
  var css161 = document.createElement('style'); css161.id = 'w161css';
  css161.textContent = ''
    + '.w161{display:grid;gap:14px;}.w161 .w154card h3{display:flex;align-items:center;gap:8px;flex-wrap:wrap;}.w161 .w154card h3 .m{font-weight:500;font-size:13px;}'
    + '.w161p{margin:6px 0 10px;line-height:1.5;}.w161ready{list-style:none;margin:0 0 6px;padding:0;display:grid;gap:6px;}.w161ready li{display:flex;gap:8px;align-items:flex-start;font-size:13.5px;line-height:1.45;}'
    + '.w161ready li .w152i{width:16px;height:16px;flex:none;margin-top:2px;}.w161ready li.ok .w152i{color:' + GREEN + ';}.w161ready li.no .w152i{color:' + FLAG + ';}.w161ready li.todo .w152i{color:' + TEAL + ';}'
    + '.w161stats{margin:0;}'
    + '.w161plans .w152lh,.w161plans .w161prow{grid-template-columns:minmax(0,1.5fr) minmax(0,1fr) minmax(0,1.3fr) minmax(0,1fr) minmax(0,1fr) auto;}'
    + '.w161foot{margin:10px 0 0;}'
    + '.w161grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px 14px;}.w161grid .full{grid-column:1/-1;}.w161grid textarea{resize:vertical;min-height:44px;}'
    + '.w161evl{display:grid;gap:0;}.w161ev{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.3fr) minmax(0,1.5fr);gap:10px;padding:8px 0;border-top:1px solid rgba(16,63,57,.08);font-size:13px;}'
    + '.w154msg.err{background:rgba(179,64,47,.1);color:#7e2b1f;}'
    + '.w153gifts .rfd{display:inline-block;margin-left:6px;}'
    + '@media (max-width:760px){.w161grid{grid-template-columns:1fr;}.w161plans .w152lh{display:none;}.w161plans .w161prow{grid-template-columns:1fr 1fr;}.w161ev{grid-template-columns:1fr;gap:2px;}}';
  document.head.appendChild(css161);
  /* ======================= wiring ======================= */
  function go(h) { if (location.hash === h) { try { applyHash(); } catch (e) { /* fine */ } } else location.hash = h; }
  function inOurs(t) { return t.closest && (t.closest('.w152root') || t.closest('#w152sheet')); }
  function sheetId() { var m = /^(?:c|edit|perm|org):(\d+|tmp\d+)$/.exec(S.sheet || ''); return m ? m[1] : null; }
  function openContact(id) {
    S.confirm = null;
    if (/^#crm(\/|$)/.test(location.hash)) { try { history.replaceState(null, '', '#crm/c/' + id); } catch (e) { /* fine */ } contactSheet(id); }
    else go('#crm/c/' + id);
  }
  function setFilter(o) { var u = S.ui; u.kind = o.kind || ''; u.role = o.role || ''; u.act = o.act || ''; u.perm = o.perm || ''; if (o.q !== undefined) u.q = o.q; u.show = 60; }
  function addTag(input) {
    var id = input.getAttribute('data-w152tagin'), c = contact(id); if (!c) return;
    var t = String(input.value || '').trim().toLowerCase().replace(/\s+/g, ' ').slice(0, 40);
    if (!t) return;
    if (c.tags.map(lower).indexOf(t) >= 0) { input.value = ''; return; }
    saveTags(c.id, c.tags.concat([t]));
  }
  function copy(text) {
    var done = function () { toastS('Copied'); };
    try { if (navigator.clipboard && navigator.clipboard.writeText) { navigator.clipboard.writeText(text).then(done, function () { fallback(); }); return; } } catch (e) { /* fall through */ }
    fallback();
    function fallback() { try { var ta = document.createElement('textarea'); ta.value = text; ta.style.cssText = 'position:fixed;left:-9999px;top:0'; document.body.appendChild(ta); ta.select(); document.execCommand('copy'); ta.remove(); done(); } catch (e) { toastS(text); } }
  }
  var qT = null;
  document.addEventListener('click', function (e) {
    var t = e.target; if (!t || !t.closest || !inOurs(t)) return;
    var el, v;
    if ((el = t.closest('[data-w152close]'))) { e.preventDefault(); closeSheet(); return; }
    if ((el = t.closest('[data-w152open]'))) { e.preventDefault(); openContact(el.getAttribute('data-w152open')); return; }
    if ((el = t.closest('[data-w152go]'))) {
      e.preventDefault(); v = el.getAttribute('data-w152go');
      if (S.sheet) closeSheet(true);
      go(v);
      /* wave176: from a contact, open that person's editor in the Volunteer Manager once its list has loaded */
      var vid = el.getAttribute('data-w176vid');
      if (vid) {
        var tries = 0, tick = function () {
          var list = (typeof WA_VOL_PEOPLE !== 'undefined' && WA_VOL_PEOPLE) || [];
          if (list.some(function (x) { return String(x.id) === String(vid); }) && typeof wa26PersonModal === 'function') { try { wa26PersonModal(vid); } catch (x) { /* non-fatal */ } return; }
          if (++tries < 40) setTimeout(tick, 250);
        };
        setTimeout(tick, 250);
      }
      return;
    }
    if ((el = t.closest('[data-w152set]'))) {
      v = el.getAttribute('data-w152set');
      setFilter(v === 'volunteer' ? { kind: 'volunteer' } : v === 'served' ? { act: 'served' } : v === 'donor' ? { kind: 'donor' } : { q: '' });
      paint(); return;
    }
    if ((el = t.closest('[data-w152kind]'))) { S.ui.kind = el.getAttribute('data-w152kind'); S.ui.show = 60; paint(); return; }
    if ((el = t.closest('[data-w152clear]'))) { e.preventDefault(); setFilter({ q: '' }); paint(); return; }
    if ((el = t.closest('[data-w152more]'))) { S.ui.show += 60; paint(); return; }
    if ((el = t.closest('[data-w152add]'))) { e.preventDefault(); S.confirm = null; editForm(null); return; }
    if ((el = t.closest('[data-w152edit]'))) { e.preventDefault(); editForm(el.getAttribute('data-w152edit')); return; }
    if ((el = t.closest('[data-w152back]'))) { e.preventDefault(); v = el.getAttribute('data-w152back'); S.confirm = null; if (v && contact(v)) contactSheet(v); else closeSheet(); return; }
    if ((el = t.closest('[data-w152save]'))) { e.preventDefault(); el.disabled = true; saveContact(el.getAttribute('data-w152save')).then(function () { el.disabled = false; }, function () { el.disabled = false; }); return; }
    if ((el = t.closest('[data-w152perm-edit]'))) { e.preventDefault(); permForm(el.getAttribute('data-w152perm-edit')); return; }
    if ((el = t.closest('[data-w152savep]'))) { e.preventDefault(); el.disabled = true; savePerm(el.getAttribute('data-w152savep')).then(function () { el.disabled = false; }, function () { el.disabled = false; }); return; }
    if ((el = t.closest('[data-w152linkorg]'))) { e.preventDefault(); orgForm(el.getAttribute('data-w152linkorg')); return; }
    if ((el = t.closest('[data-w152saveorg]'))) { e.preventDefault(); el.disabled = true; saveOrg(el.getAttribute('data-w152saveorg')).then(function () { el.disabled = false; }, function () { el.disabled = false; }); return; }
    if ((el = t.closest('[data-w152unlink]'))) { e.preventDefault(); unlinkOrg(el.getAttribute('data-w152unlink')); return; }
    if ((el = t.closest('[data-w152untag]'))) {
      e.preventDefault(); var cid = sheetId(), c = contact(cid); if (!c) return;
      v = el.getAttribute('data-w152untag');
      saveTags(c.id, c.tags.filter(function (x) { return x !== v; })); return;
    }
    if ((el = t.closest('[data-w152log]'))) { e.preventDefault(); el.disabled = true; saveLog(el.getAttribute('data-w152log')).then(function () { el.disabled = false; }, function () { el.disabled = false; }); return; }
    if ((el = t.closest('[data-w152delint]'))) { e.preventDefault(); deleteLog(sheetId(), el.getAttribute('data-w152delint')); return; }
    if ((el = t.closest('[data-w152copy]'))) { e.preventDefault(); copy(el.getAttribute('data-w152copy')); return; }
    if ((el = t.closest('[data-w152keep]'))) { e.preventDefault(); S.confirm = 'merge:' + el.getAttribute('data-w152keep') + ':' + el.getAttribute('data-drop'); paint(); return; }
    if ((el = t.closest('[data-w152cancel]'))) { e.preventDefault(); S.confirm = null; paint(); return; }
    if ((el = t.closest('[data-w152merge]'))) { e.preventDefault(); merge(el.getAttribute('data-w152merge'), el.getAttribute('data-drop')); return; }
    if ((el = t.closest('[data-w152notdup]'))) { e.preventDefault(); notDup(el.getAttribute('data-w152notdup')); return; }
  });
  document.addEventListener('keydown', function (e) {
    var t = e.target; if (!t || !t.getAttribute) return;
    if (t.hasAttribute('data-w152tagin') && (e.key === 'Enter' || e.key === ',')) { e.preventDefault(); addTag(t); }
  });
  document.addEventListener('input', function (e) {
    var t = e.target; if (!t || !t.getAttribute || !t.hasAttribute('data-w152q')) return;
    var v = t.value;
    clearTimeout(qT);
    qT = setTimeout(function () { S.ui.q = v; S.ui.show = 60; paint(); }, 160);
  });
  document.addEventListener('change', function (e) {
    var t = e.target; if (!t || !t.closest || !t.closest('.w152root')) return;
    if (t.hasAttribute('data-w152role')) S.ui.role = t.value;
    else if (t.hasAttribute('data-w152act')) S.ui.act = t.value;
    else if (t.hasAttribute('data-w152perm')) S.ui.perm = t.value;
    else if (t.hasAttribute('data-w152sort')) S.ui.sort = t.value;
    else return;
    S.ui.show = 60; paint();
  });
  window.addEventListener('hashchange', function () {
    if (!S.sheet) return;
    if (!/^#crm(\/|$)/.test(location.hash)) closeSheet(true);
  });

  /* ---------- the menu: People > CRM ---------- */
  function pageOk() { try { return typeof wa40Allowed !== 'function' || (wa40Allowed() || []).indexOf('crm') >= 0; } catch (e) { return true; } }
  var PAGE = { id: 'crm', label: 'CRM', group: 'people', dot: TEAL, gate: 'member', onShow: function (h) { if (pageOk()) openCrm(h); } };
  function register() {
    if (!window.WA_NAV || typeof WA_NAV.register !== 'function') return;
    if (!WA_NAV.pages.some(function (p) { return p.id === 'crm'; })) WA_NAV.register(PAGE);
  }
  if (typeof startApp === 'function') {
    var __sa152 = startApp;
    startApp = async function () {
      var out = await __sa152.apply(this, arguments);
      try {
        register();
        var root = decodeURIComponent(location.hash || '').replace(/^#/, '').split('/')[0];
        if (root === 'crm') { try { applyHash(); } catch (e) { /* fine */ } }
      } catch (e) { console.warn('wave152 boot', e); }
      return out;
    };
  }

  /* ---------- the page tour (wave122's engine; trainings row tour:crm) ---------- */
  function addTour() {
    try {
      var W = window.w122; if (!W || !W.tours || W.tours.crm) return;
      var OPT = { opt: 1 };
      var T = function (sel, t, p, o) { var x = { s: sel, t: t, p: p }; if (o) Object.keys(o).forEach(function (k) { x[k] = o[k]; }); return x; };
      W.tours.crm = { tab: 'crm', icon: 'people', hash: '#crm', steps: [
        T('#crm > .w118mast', 'CRM', 'Everyone Welfare Avenue knows in one place: volunteers, donors, partners\u2019 contacts and the team, with what each one has done with us.'),
        T('#crm .w152stats', 'At a glance', 'Everyone, the volunteers, who has served at an event, and the donors (or the duplicates to check). A number narrows the list to them.', OPT),
        T('#crm .w152tabs', 'The tabs', 'Contacts, the possible duplicates to check, Sources (where the contacts come from, and Leaving Keela: what is left before Keela can be cancelled), Gifts, Email, Lists, Campaigns, Forms, Automations and Reports.', OPT),
        T('#crm .w152chips', 'Who they are to us', 'Volunteers, donors, partners\u2019 contacts, supporters, staff and alumni. One person can be several.', OPT),
        T('#crm .w152q', 'Find anyone', 'Type a name, an email, a phone number, a school or a tag. Next to it: a volunteer role, their activity, their email permission, and the order.', OPT),
        T('#crm [data-w152add]', 'Add someone', 'A donor, a partner\u2019s contact, a supporter or a new volunteer. The CRM stops you if they are already in it.', OPT),
        T('#crm .w152list', 'Everyone, one line each', 'What they are to us, how to reach them, their volunteer roles, how often they served and when we last saw them. Click anyone to open their page.', OPT),
        { c: 1, t: 'A contact\u2019s page', p: 'Their details (a volunteer\u2019s are saved on their volunteer record too), what they did with us, their email permission, tags, organizations from Partners, and one timeline: notes, calls and emails logged here, servings, gifts and the old website\u2019s history.' },
        { c: 1, t: 'Email permission', p: 'Canada\u2019s anti-spam law (CASL): newsletters and appeals go only to people who said yes, or whose implied consent has not run out (two years after a gift or a serving). Record it on their page when they tell you.' },
        T('#crm .w152tabs [data-w152go="#crm/email"]', 'Email', 'The Email tab (wave154): sending from welfareavenue.com, the templates in the brand, who can be emailed today, and every message the Hub sent with what happened to it. A contact\u2019s page has Send an email from the Hub.', OPT),
        T('#crm .w152tabs [data-w152go="#crm/lists"]', 'Lists', 'Lists (wave155): groups of conditions (and inside a group, or between groups) over type, role, servings, gifts, tags, city, email permission and email activity. A live list follows the data; a fixed one keeps its people.', OPT),
        T('#crm .w152tabs [data-w152go="#crm/campaigns"]', 'Campaigns', 'Campaigns (wave155): one message to a list, person by person, through the consent rule, at up to 80 a day on Resend\u2019s free plan. Preview, send yourself a test, see who gets it and why others are held back, then follow the opens and clicks.', OPT),
        T('#crm .w152tabs [data-w152go="#crm/forms"]', 'Forms', 'Forms (wave156): the CRM\u2019s own forms at hub.welfareavenue.com/f/. Each question saves to a place in the CRM (name, email, phone, volunteer roles, a sign-up for each date picked, a custom field), the email permission is kept with the words people agreed to, and every answer is listed with what the Hub did with it. Each form opens on a photo from the Photo library behind our logo (wave168: pick it under Cover photo, or keep the default for its kind); the preview shows it.', OPT),
        T('#crm .w152tabs [data-w152go="#crm/gifts"]', 'Gifts', 'Gifts (wave153, recording since wave158): every gift with its donor, campaign and receipt. Record a gift that came by cheque, e-transfer or cash; say when it is a registration or a ticket and what the person received, so the receipt shows the right eligible amount. Receipts shows the settings, who is owed a receipt for the year and the receipts the Hub issued; once an admin turns receipts on (the treasurer and Steel decide), admins issue them with their PDF, one per donor at year-end, email each one to the donor with the PDF attached (Email it), and replace or cancel them with the reason; with the online-gift switch on, every gift through the donation page is receipted and emailed by itself.', OPT),
        T('#crm .w152tabs [data-w152go="#crm/automations"]', 'Automations', 'Automations (wave157): when someone fills in a form, gets a tag, gives, or has a serving coming, the Hub runs the steps for them: emails through the permission rule (8 am to 8 pm), waits, a yes and a no path on an opened email, tags, a task on a team\u2019s board, a notice. They start as drafts; Try it on me runs one on your own contact.', OPT),
        T('#crm .w152tabs [data-w152go="#crm/reports"]', 'Reports', 'Reports (wave160): a fiscal year at a glance, against the year before. Gifts by month, kind, campaign and size; donors who gave for the first time, again, or not yet this year (made into a list in one click); volunteers new and returning, by month and role; email permission today. The year in a few lines is ready to copy for the board, and the page prints.', OPT),
        { c: 1, t: 'Possible duplicates', p: 'The same email or phone on two contacts. Keep the right one and the other\u2019s history moves to it, or mark them as different people (family members share phones).' }
      ] };
    } catch (e) { /* fine */ }
  }
  addTour();

  /* ---------- test hook ---------- */
  window.w155 = { lc: function () { return LC; }, groups: groupsFromFilters, clean: cleanGroups, describe: describe };
  window.w156 = { fm: function () { return FM; }, parse: parseOpts, clean: cleanQuestions, choices: toChoices, more: moreHtml, save: saveForm };
